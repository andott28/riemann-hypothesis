    rw [Complex.sub_re, gammaExt_ofReal_re, Complex.ofReal_re]
  calc |RHLean.gammaKernel t - (rhoTrunc 240).eval t|
      = |(gammaExt (t : ℂ) - (((rhoTrunc 240).eval t : ℝ) : ℂ)).re| := by rw [hre]
    _ ≤ ‖gammaExt (t : ℂ) - (((rhoTrunc 240).eval t : ℝ) : ℂ)‖ :=
        Complex.abs_re_le_norm _
    _ ≤ Y7Chain.gammaM (14 / 5) * (2 * a / (14 / 5)) ^ 241
