lemma normSq_eq_re_im (z : ℂ) :
    ‖z‖ ^ 2 = ‖(((z.re : ℝ)) : ℂ)‖ ^ 2 + ‖(((z.im : ℝ)) : ℂ)‖ ^ 2 := by
  simp only [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, Complex.normSq_ofReal,
    Complex.ofReal_re, Complex.ofReal_im]
  ring
lemma normSq_sub_eq_re_im (z w : ℂ) :
    ‖z - w‖ ^ 2
      = ‖(((z.re : ℝ)) : ℂ) - ((((w.re : ℝ)) : ℂ))‖ ^ 2
        + ‖(((z.im : ℝ)) : ℂ) - ((((w.im : ℝ)) : ℂ))‖ ^ 2 := by
  rw [normSq_eq_re_im (z - w), Complex.sub_re, Complex.sub_im, ← Complex.ofReal_sub,
    ← Complex.ofReal_sub]
lemma mul_star_re_eq_re_im (z w : ℂ) :
    (z * star w).re
      = ((((z.re : ℝ)) : ℂ) * star ((((w.re : ℝ)) : ℂ))).re
        + ((((z.im : ℝ)) : ℂ) * star ((((w.im : ℝ)) : ℂ))).re := by
  simp only [Complex.mul_re, Complex.star_def, Complex.conj_re, Complex.conj_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.conj_ofReal, ← Complex.ofReal_mul]
  ring
lemma norm_ofReal_eq_abs (r : ℝ) : ‖(((r : ℝ)) : ℂ)‖ = |r| := by
  rw [Complex.norm_def, Complex.normSq_ofReal, show r * r = r ^ 2 by ring,
    Real.sqrt_sq_eq_abs]
lemma norm_re_le (z : ℂ) : ‖(((z.re : ℝ)) : ℂ)‖ ≤ ‖z‖ := by
  rw [norm_ofReal_eq_abs]
  exact Complex.abs_re_le_norm z
lemma norm_im_le (z : ℂ) : ‖(((z.im : ℝ)) : ℂ)‖ ≤ ‖z‖ := by
  rw [norm_ofReal_eq_abs]
  exact Complex.abs_im_le_norm z
def rePart (g : ℝ → ℂ) : ℝ → ℂ := fun x => ((g x).re : ℂ)
def imPart (g : ℝ → ℂ) : ℝ → ℂ := fun x => ((g x).im : ℂ)
lemma rePart_apply (g : ℝ → ℂ) (x : ℝ) : rePart g x = ((g x).re : ℂ) := rfl
lemma imPart_apply (g : ℝ → ℂ) (x : ℝ) : imPart g x = ((g x).im : ℂ) := rfl
lemma rePart_add_I_mul_imPart (g : ℝ → ℂ) (x : ℝ) :
    rePart g x + Complex.I * imPart g x = g x := by
  have h := Complex.re_add_im (g x)
  simpa only [rePart, imPart, mul_comm] using h
private lemma rePart_sub_eq (g : ℝ → ℂ) (x y : ℝ) :
    rePart g x - rePart g y = ((((g x - g y).re : ℝ)) : ℂ) := by
  simp only [rePart, Complex.sub_re, ← Complex.ofReal_sub]
private lemma imPart_sub_eq (g : ℝ → ℂ) (x y : ℝ) :
    imPart g x - imPart g y = ((((g x - g y).im : ℝ)) : ℂ) := by
  simp only [imPart, Complex.sub_im, ← Complex.ofReal_sub]
lemma rePart_mem_localizedCore {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    rePart g ∈ RHLean.localizedCore 1 := by
  obtain ⟨⟨hcd, -, hodd⟩, hsupp⟩ := hg
  have hsupp' : Function.support (rePart g) ⊆ Set.Ioo (-1 : ℝ) 1 := by
    intro x hx
    apply hsupp
    intro h0
    exact hx (by simp [rePart, h0])
  refine ⟨⟨?_, ?_, ?_⟩, hsupp'⟩
  · exact Complex.ofRealCLM.contDiff.comp (Complex.reCLM.contDiff.comp hcd)
  · refine HasCompactSupport.of_support_subset_isCompact
      (isCompact_Icc (a := (-1 : ℝ)) (b := 1)) ?_
    intro x hx
    have hmem := hsupp' hx
    exact ⟨le_of_lt hmem.1, le_of_lt hmem.2⟩
  · intro x
    simp only [rePart, map_neg, Complex.neg_re]
    rw [hodd]
    simp
lemma imPart_mem_localizedCore {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    imPart g ∈ RHLean.localizedCore 1 := by
  obtain ⟨⟨hcd, -, hodd⟩, hsupp⟩ := hg
  have hsupp' : Function.support (imPart g) ⊆ Set.Ioo (-1 : ℝ) 1 := by
    intro x hx
    apply hsupp
    intro h0
    exact hx (by simp [imPart, h0])
  refine ⟨⟨?_, ?_, ?_⟩, hsupp'⟩
  · exact Complex.ofRealCLM.contDiff.comp (Complex.imCLM.contDiff.comp hcd)
  · refine HasCompactSupport.of_support_subset_isCompact
      (isCompact_Icc (a := (-1 : ℝ)) (b := 1)) ?_
    intro x hx
    have hmem := hsupp' hx
    exact ⟨le_of_lt hmem.1, le_of_lt hmem.2⟩
  · intro x
    simp only [imPart, map_neg, Complex.neg_im]
    rw [hodd]
    simp
lemma core_bound {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖g x‖ ≤ B := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hcd.continuous.continuousOn
  exact ⟨B, le_trans (norm_nonneg _) (hB 0 ⟨by norm_num, by norm_num⟩), hB⟩
lemma core_lipschitz {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖g x - g y‖ ≤ C * ‖x - y‖ := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont : Continuous (deriv g) := hcd.continuous_deriv (by simp)
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hcont.continuousOn
  have C0 : 0 ≤ C := le_trans (norm_nonneg _) (hC 0 ⟨by norm_num, by norm_num⟩)
  refine ⟨C, C0, fun x hx y hy => ?_⟩
  have hdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1, DifferentiableAt ℝ g z :=
    fun z _ => (hcd.differentiable (by simp)).differentiableAt
  have h := Convex.norm_image_sub_le_of_norm_deriv_le hdiff hC (convex_Icc (-1 : ℝ) 1) hy hx
  simpa only [norm_sub_rev] using h
lemma continuous_rePart {g : ℝ → ℂ} (hg : Continuous g) : Continuous (rePart g) :=
  Complex.continuous_ofReal.comp (Complex.continuous_re.comp hg)
lemma continuous_imPart {g : ℝ → ℂ} (hg : Continuous g) : Continuous (imPart g) :=
  Complex.continuous_ofReal.comp (Complex.continuous_im.comp hg)
lemma rePart_bound {g : ℝ → ℂ} {B : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖g x‖ ≤ B) :
    ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖rePart g x‖ ≤ B := by
  intro x hx
  rw [rePart_apply, norm_ofReal_eq_abs]
  exact le_trans (Complex.abs_re_le_norm (g x)) (hB x hx)
lemma imPart_bound {g : ℝ → ℂ} {B : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖g x‖ ≤ B) :
    ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖imPart g x‖ ≤ B := by
  intro x hx
  rw [imPart_apply, norm_ofReal_eq_abs]
  exact le_trans (Complex.abs_im_le_norm (g x)) (hB x hx)
private lemma integrableOn_Ioo_of_continuous_bound {f : ℝ → ℝ} (hf : Continuous f)
    {C : ℝ} (hb : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖f x‖ ≤ C) :
    IntegrableOn f (Set.Ioo (-1 : ℝ) 1) :=
  IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
    hf.aestronglyMeasurable C
    (by filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx; exact hb x hx)
private lemma integrableOn_Ioo_of_continuous_bound_complex {f : ℝ → ℂ} (hf : Continuous f)
    {C : ℝ} (hb : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖f x‖ ≤ C) :
    IntegrableOn f (Set.Ioo (-1 : ℝ) 1) :=
  IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
    hf.aestronglyMeasurable C
    (by filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx; exact hb x hx)
theorem mass_re_im {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2)
      = (∫ x in Set.Ioo (-1 : ℝ) 1, ‖rePart g x‖ ^ 2)
        + (∫ x in Set.Ioo (-1 : ℝ) 1, ‖imPart g x‖ ^ 2) := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont_u : Continuous (rePart g) := continuous_rePart hcd.continuous
  have hcont_v : Continuous (imPart g) := continuous_imPart hcd.continuous
  have hu : IntegrableOn (fun x : ℝ => ‖rePart g x‖ ^ 2) (Set.Ioo (-1 : ℝ) 1) :=
    integrableOn_Ioo_of_continuous_bound (hcont_u.norm.pow 2) (fun x hx => by
      have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
      have h1 : ‖rePart g x‖ ≤ B := rePart_bound hB x hx'
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg (‖rePart g x‖))]
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2)
  have hv : IntegrableOn (fun x : ℝ => ‖imPart g x‖ ^ 2) (Set.Ioo (-1 : ℝ) 1) :=
    integrableOn_Ioo_of_continuous_bound (hcont_v.norm.pow 2) (fun x hx => by
      have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
      have h1 : ‖imPart g x‖ ≤ B := imPart_bound hB x hx'
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg (‖imPart g x‖))]
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2)
  rw [show (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2)
      = ∫ x in Set.Ioo (-1 : ℝ) 1, (‖rePart g x‖ ^ 2 + ‖imPart g x‖ ^ 2) from by
    apply integral_congr_ae
    filter_upwards with x
    simp only [rePart, imPart]
    exact normSq_eq_re_im (g x)]
  rw [integral_add hu hv]
lemma core_bound_all {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖g x‖ ≤ B := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  refine ⟨B, hB0, fun x => ?_⟩
  by_cases hx : x ∈ Set.Icc (-1 : ℝ) 1
  · exact hB x hx
  · have h0 : g x = 0 := by
      by_contra hne
      have hmem := hg.2 hne
      exact hx ⟨le_of_lt hmem.1, le_of_lt hmem.2⟩
    rw [h0, norm_zero]
    exact hB0
lemma rePart_bound_all {g : ℝ → ℂ} {B : ℝ} (hB : ∀ x : ℝ, ‖g x‖ ≤ B) :
    ∀ x : ℝ, ‖rePart g x‖ ≤ B := by
  intro x
  rw [rePart_apply, norm_ofReal_eq_abs]
  exact le_trans (Complex.abs_re_le_norm (g x)) (hB x)
lemma imPart_bound_all {g : ℝ → ℂ} {B : ℝ} (hB : ∀ x : ℝ, ‖g x‖ ≤ B) :
    ∀ x : ℝ, ‖imPart g x‖ ≤ B := by
  intro x
  rw [imPart_apply, norm_ofReal_eq_abs]
  exact le_trans (Complex.abs_im_le_norm (g x)) (hB x)
theorem potential_re_im {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖g x‖ ^ 2)
      = (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖rePart g x‖ ^ 2)
        + (∫ x in Set.Ioo (-1 : ℝ) 1,
            RHLean.rescaledPotential x * ‖imPart g x‖ ^ 2) := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont_u : Continuous (rePart g) := continuous_rePart hcd.continuous
  have hcont_v : Continuous (imPart g) := continuous_imPart hcd.continuous
  have hu : IntegrableOn (fun x : ℝ => RHLean.rescaledPotential x * ‖rePart g x‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    have h := (Y7Matrix.intervalIntegrable_rescaledPotential_mul_pow 0).continuousOn_mul
      (hcont_u.continuousOn.norm.pow 2)
    have h2 : (fun x : ℝ => ((fun x => ‖rePart g x‖) ^ 2) x
          * (RHLean.rescaledPotential x * x ^ 0))
        = fun x : ℝ => RHLean.rescaledPotential x * ‖rePart g x‖ ^ 2 := by
      funext x
      simp only [pow_two, Pi.mul_apply, pow_zero, mul_one]
      ring
    rw [h2] at h
    exact h.1.mono_set Set.Ioo_subset_Ioc_self
  have hv : IntegrableOn (fun x : ℝ => RHLean.rescaledPotential x * ‖imPart g x‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    have h := (Y7Matrix.intervalIntegrable_rescaledPotential_mul_pow 0).continuousOn_mul
      (hcont_v.continuousOn.norm.pow 2)
    have h2 : (fun x : ℝ => ((fun x => ‖imPart g x‖) ^ 2) x
          * (RHLean.rescaledPotential x * x ^ 0))
        = fun x : ℝ => RHLean.rescaledPotential x * ‖imPart g x‖ ^ 2 := by
      funext x
      simp only [pow_two, Pi.mul_apply, pow_zero, mul_one]
      ring
    rw [h2] at h
    exact h.1.mono_set Set.Ioo_subset_Ioc_self
  rw [show (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖g x‖ ^ 2)
      = ∫ x in Set.Ioo (-1 : ℝ) 1,
          (RHLean.rescaledPotential x * ‖rePart g x‖ ^ 2
            + RHLean.rescaledPotential x * ‖imPart g x‖ ^ 2) from by
    apply integral_congr_ae
    filter_upwards with x
    rw [normSq_eq_re_im (g x)]
    simp only [rePart, imPart]
    ring]
  rw [integral_add hu hv]
theorem arch_quot_integrable {f : ℝ → ℂ} {C : ℝ} (hC0 : 0 ≤ C) (hcont : Continuous f)
    (hC : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖f x - f y‖ ≤ C * ‖x - y‖) :
    Integrable (fun z : ℝ × ℝ => ‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  have hfin : volume (Set.Ioo (-1 : ℝ) 1) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  haveI : Fact (volume (Set.Ioo (-1 : ℝ) 1) < ⊤) := ⟨hfin⟩
  refine Integrable.of_bound ?_ (2 * C ^ 2) ?_
  · have hnum : Measurable (fun z : ℝ × ℝ => ‖f z.1 - f z.2‖ ^ 2) :=
      (((hcont.comp continuous_fst).sub (hcont.comp continuous_snd)).norm.pow 2).measurable
    exact (hnum.div ((continuous_fst.sub continuous_snd).norm.measurable)).aestronglyMeasurable
  · rw [Measure.prod_restrict]
    filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
    have hz1 : z.1 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.1.1, le_of_lt hz.1.2⟩
    have hz2 : z.2 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.2.1, le_of_lt hz.2.2⟩
    by_cases hxy : z.1 = z.2
    · rw [hxy]
      simp only [sub_self, norm_zero, div_zero, norm_zero]
      positivity
    · have hpos : 0 < ‖z.1 - z.2‖ := by
        rw [norm_pos_iff]
        exact sub_ne_zero.mpr hxy
      have hdist : ‖z.1 - z.2‖ ≤ 2 := by
        rw [Real.norm_eq_abs, abs_sub_le_iff]
        exact ⟨by linarith [hz1.2, hz2.1], by linarith [hz2.2, hz1.1]⟩
      rw [norm_div, Real.norm_of_nonneg (norm_nonneg _), Real.norm_of_nonneg (sq_nonneg _)]
      have h3 : ‖f z.1 - f z.2‖ ^ 2 ≤ (C * ‖z.1 - z.2‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (hC z.1 hz1 z.2 hz2) 2
      rw [div_le_iff₀ hpos]
      calc ‖f z.1 - f z.2‖ ^ 2 ≤ (C * ‖z.1 - z.2‖) ^ 2 := h3
        _ = C ^ 2 * ‖z.1 - z.2‖ ^ 2 := by ring
        _ ≤ C ^ 2 * (2 * ‖z.1 - z.2‖) := by
            have h4 : ‖z.1 - z.2‖ ^ 2 ≤ 2 * ‖z.1 - z.2‖ := by nlinarith
            exact mul_le_mul_of_nonneg_left h4 (sq_nonneg C)
        _ = 2 * C ^ 2 * ‖z.1 - z.2‖ := by ring
theorem arch_re_im {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    RHLean.archFormRescaled g
      = RHLean.archFormRescaled (rePart g) + RHLean.archFormRescaled (imPart g) := by
  obtain ⟨C, hC0, hCl⟩ := core_lipschitz hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hCu : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖rePart g x - rePart g y‖ ≤ C * ‖x - y‖ := by
    intro x hx y hy
    rw [rePart_sub_eq]
    exact le_trans (norm_re_le (g x - g y)) (hCl x hx y hy)
  have hCv : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖imPart g x - imPart g y‖ ≤ C * ‖x - y‖ := by
    intro x hx y hy
    rw [imPart_sub_eq]
    exact le_trans (norm_im_le (g x - g y)) (hCl x hx y hy)
  have hgint := arch_quot_integrable hC0 hcd.continuous hCl
  have huint := arch_quot_integrable hC0 (continuous_rePart hcd.continuous) hCu
  have hvint := arch_quot_integrable hC0 (continuous_imPart hcd.continuous) hCv
  unfold RHLean.archFormRescaled
  rw [← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => ‖g z.1 - g z.2‖ ^ 2 / ‖z.1 - z.2‖) hgint,
      ← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => ‖rePart g z.1 - rePart g z.2‖ ^ 2 / ‖z.1 - z.2‖) huint,
      ← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => ‖imPart g z.1 - imPart g z.2‖ ^ 2 / ‖z.1 - z.2‖) hvint]
  rw [show (∫ z, ‖g z.1 - g z.2‖ ^ 2 / ‖z.1 - z.2‖
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))))
      = ∫ z, (‖rePart g z.1 - rePart g z.2‖ ^ 2 / ‖z.1 - z.2‖
          + ‖imPart g z.1 - imPart g z.2‖ ^ 2 / ‖z.1 - z.2‖)
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) from by
    apply integral_congr_ae
    filter_upwards with z
    simp only [rePart, imPart]
    rw [normSq_sub_eq_re_im (g z.1) (g z.2)]
    simp only [Complex.sub_re, Complex.sub_im, ← Complex.ofReal_sub]
    ring]
  rw [integral_add huint hvint]
  ring
lemma measurable_gammaKernelRescaled_comp (a : ℝ) :
    Measurable (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖) := by
  unfold RHLean.gammaKernelRescaled
  exact measurable_const.mul (RHLean.GateII.Collar.measurable_gammaKernel.comp
    (((continuous_fst.sub continuous_snd).norm.const_mul a).measurable))
lemma continuous_mul_star_re {f : ℝ → ℂ} (hf : Continuous f) :
    Continuous (fun z : ℝ × ℝ => (f z.1 * star (f z.2)).re) :=
  Complex.continuous_re.comp ((hf.comp continuous_fst).mul
    (Complex.continuous_conj.comp (hf.comp continuous_snd)))
lemma gammaKernelRescaled_bound {a : ℝ} (ha : 0 ≤ a) {z : ℝ}
    (hz : z ∈ Set.Icc 0 2) :
    |RHLean.gammaKernelRescaled a z| ≤ |a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) := by
  have hpos : 0 ≤ a * z := mul_nonneg ha hz.1
  have hle : a * z ≤ 2 * a := by nlinarith [hz.2, ha]
  have hb := RHLean.GateII.Collar.gammaKernel_abs_le (M := 2 * a) (z := a * z)
    (by positivity) ⟨hpos, hle⟩
  rw [show 2 * a / 2 = a by ring] at hb
  unfold RHLean.gammaKernelRescaled
  rw [abs_mul]
  exact mul_le_mul_of_nonneg_left hb (abs_nonneg a)
theorem gamma_re_im {a : ℝ} (ha : 0 ≤ a) {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    RHLean.gammaFormRescaled a g
      = RHLean.gammaFormRescaled a (rePart g) + RHLean.gammaFormRescaled a (imPart g) := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont_u : Continuous (rePart g) := continuous_rePart hcd.continuous
  have hcont_v : Continuous (imPart g) := continuous_imPart hcd.continuous
  have hfin : volume (Set.Ioo (-1 : ℝ) 1) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  haveI : Fact (volume (Set.Ioo (-1 : ℝ) 1) < ⊤) := ⟨hfin⟩
  have hint : ∀ {f : ℝ → ℂ}, Continuous f → (∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B) →
      Integrable (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
          * (f z.1 * star (f z.2)).re)
        ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
    intro f hf hfb
    refine Integrable.of_bound ?_
      (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) * (B * B)) ?_
    · exact ((measurable_gammaKernelRescaled_comp a).mul
        (continuous_mul_star_re hf).measurable).aestronglyMeasurable
    · rw [Measure.prod_restrict]
      filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
      have hz1 : z.1 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.1.1, le_of_lt hz.1.2⟩
      have hz2 : z.2 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.2.1, le_of_lt hz.2.2⟩
      have hdist : ‖z.1 - z.2‖ ∈ Set.Icc (0 : ℝ) 2 := by
        constructor
        · positivity
        · rw [Real.norm_eq_abs, abs_sub_le_iff]
          exact ⟨by linarith [hz1.2, hz2.1], by linarith [hz2.2, hz1.1]⟩
      have hK := gammaKernelRescaled_bound ha hdist
      have hre : |(f z.1 * star (f z.2)).re| ≤ B * B := by
        calc |(f z.1 * star (f z.2)).re| ≤ ‖f z.1 * star (f z.2)‖ := Complex.abs_re_le_norm _
          _ = ‖f z.1‖ * ‖f z.2‖ := by rw [norm_mul, norm_star]
          _ ≤ B * B := mul_le_mul (hfb z.1 hz1) (hfb z.2 hz2) (norm_nonneg _) hB0
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_mul hK hre (abs_nonneg _) (mul_nonneg (abs_nonneg a) (by positivity))
  have hgint := hint hcd.continuous hB
  have huint := hint hcont_u (rePart_bound hB)
  have hvint := hint hcont_v (imPart_bound hB)
  unfold RHLean.gammaFormRescaled
  rw [← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
          * (g z.1 * star (g z.2)).re) hgint,
      ← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
          * (rePart g z.1 * star (rePart g z.2)).re) huint,
      ← MeasureTheory.integral_prod
        (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
          * (imPart g z.1 * star (imPart g z.2)).re) hvint]
  rw [show (∫ z, RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (g z.1 * star (g z.2)).re
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))))
      = ∫ z, (RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
            * (rePart g z.1 * star (rePart g z.2)).re
          + RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
            * (imPart g z.1 * star (imPart g z.2)).re)
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) from by
    apply integral_congr_ae
    filter_upwards with z
    rw [mul_star_re_eq_re_im (g z.1) (g z.2)]
    simp only [rePart, imPart]
    ring]
  rw [integral_add huint hvint]
theorem polar_re_im {a : ℝ} {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    RHLean.polarFormRescaled a g
      = RHLean.polarFormRescaled a (rePart g) + RHLean.polarFormRescaled a (imPart g) := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont_u : Continuous (rePart g) := continuous_rePart hcd.continuous
  have hcont_v : Continuous (imPart g) := continuous_imPart hcd.continuous
  obtain ⟨Cs, hCs⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    ((Real.continuous_sinh.comp ((continuous_const.mul continuous_id).div_const 2)).continuousOn)
  have hcont_s : Continuous (fun x : ℝ => star (RHLean.sRescaled a x)) :=
    Complex.continuous_conj.comp
      (Complex.continuous_ofReal.comp (Real.continuous_sinh.comp
        ((continuous_const.mul continuous_id).div_const 2)))
  have hs_int : ∀ {f : ℝ → ℂ}, Continuous f → (∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B) →
      IntegrableOn (fun x : ℝ => star (RHLean.sRescaled a x) * f x) (Set.Ioo (-1 : ℝ) 1) := by
    intro f hf hfb
    refine integrableOn_Ioo_of_continuous_bound_complex (C := Cs * B)
      (hcont_s.mul hf) (fun x hx => ?_)
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    rw [norm_mul]
    have hs : ‖star (RHLean.sRescaled a x)‖ ≤ Cs := by
      rw [norm_star]
      unfold RHLean.sRescaled
      rw [norm_ofReal_eq_abs]
      exact hCs x hx'
    exact mul_le_mul hs (hfb x hx') (norm_nonneg _) (le_trans (norm_nonneg _) hs)
  have hinner : RHLean.polarInnerRescaled a g
      = RHLean.polarInnerRescaled a (rePart g)
        + Complex.I * RHLean.polarInnerRescaled a (imPart g) := by
    unfold RHLean.polarInnerRescaled
    have hfun : (fun x : ℝ => star (RHLean.sRescaled a x) * g x)
        = fun x => star (RHLean.sRescaled a x) * rePart g x
            + Complex.I * (star (RHLean.sRescaled a x) * imPart g x) := by
      funext x
      rw [← rePart_add_I_mul_imPart g x]
      ring
    rw [hfun]
    rw [integral_add]
    · rw [MeasureTheory.integral_const_mul]
    · exact hs_int hcont_u (rePart_bound hB)
    · exact (hs_int hcont_v (imPart_bound hB)).const_mul Complex.I
  have hreal_u : RHLean.polarInnerRescaled a (rePart g)
      = (((∫ x in Set.Ioo (-1 : ℝ) 1, Real.sinh (a * x / 2) * (g x).re) : ℝ) : ℂ) := by
    unfold RHLean.polarInnerRescaled RHLean.sRescaled rePart
    rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
          star (((Real.sinh (a * x / 2) : ℝ)) : ℂ) * (((g x).re : ℝ) : ℂ))
        = ∫ x in Set.Ioo (-1 : ℝ) 1,
            (((Real.sinh (a * x / 2) * (g x).re : ℝ)) : ℂ) from by
      apply integral_congr_ae
      filter_upwards with x
      rw [show star (((Real.sinh (a * x / 2) : ℝ)) : ℂ) = (((Real.sinh (a * x / 2) : ℝ)) : ℂ)
          from Complex.conj_ofReal _,
        ← Complex.ofReal_mul]]
    exact integral_ofReal
  have hreal_v : RHLean.polarInnerRescaled a (imPart g)
      = (((∫ x in Set.Ioo (-1 : ℝ) 1, Real.sinh (a * x / 2) * (g x).im) : ℝ) : ℂ) := by
    unfold RHLean.polarInnerRescaled RHLean.sRescaled imPart
    rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
          star (((Real.sinh (a * x / 2) : ℝ)) : ℂ) * (((g x).im : ℝ) : ℂ))
        = ∫ x in Set.Ioo (-1 : ℝ) 1,
            (((Real.sinh (a * x / 2) * (g x).im : ℝ)) : ℂ) from by
      apply integral_congr_ae
      filter_upwards with x
      rw [show star (((Real.sinh (a * x / 2) : ℝ)) : ℂ) = (((Real.sinh (a * x / 2) : ℝ)) : ℂ)
          from Complex.conj_ofReal _,
        ← Complex.ofReal_mul]]
    exact integral_ofReal
  have hnorm : ∀ A B : ℝ, ‖(((A : ℝ)) : ℂ) + Complex.I * (((B : ℝ)) : ℂ)‖ ^ 2
      = ‖(((A : ℝ)) : ℂ)‖ ^ 2 + ‖(((B : ℝ)) : ℂ)‖ ^ 2 := by
    intro A B
    simp only [Complex.sq_norm, Complex.normSq_apply, Complex.add_re, Complex.add_im,
      Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im, Complex.ofReal_re,
      Complex.ofReal_im]
    ring
  unfold RHLean.polarFormRescaled
  rw [hinner, hreal_u, hreal_v, hnorm]
  ring
private lemma integral_re_of_integrableOn {f : ℝ → ℂ}
    (hf : IntegrableOn f (Set.Ioo (-1 : ℝ) 1)) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, f x).re = ∫ x in Set.Ioo (-1 : ℝ) 1, (f x).re :=
  (integral_re hf).symm
theorem shift_re_im {a : ℝ} {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    RHLean.shiftFormRescaled a g
      = RHLean.shiftFormRescaled a (rePart g) + RHLean.shiftFormRescaled a (imPart g) := by
  obtain ⟨B, hB0, hB⟩ := Y7Density.core_bound_all hg
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hg
  have hcont_u : Continuous (Y7Density.rePart g) := Y7Density.continuous_rePart hcd.continuous
  have hcont_v : Continuous (Y7Density.imPart g) := Y7Density.continuous_imPart hcd.continuous
  have integral_re_on : ∀ (c d : ℝ) {f : ℝ → ℂ}, IntegrableOn f (Set.Ioo c d) →
      (∫ x in Set.Ioo c d, f x).re = ∫ x in Set.Ioo c d, (f x).re := by
    intro c d f hf
    exact (integral_re hf).symm
  have hint : ∀ {f : ℝ → ℂ}, Continuous f → (∀ x : ℝ, ‖f x‖ ≤ B) →
      ∀ (c d : ℝ) (r : ℝ),
      IntegrableOn (fun x : ℝ => f x * star (f (x + r))) (Set.Ioo c d) := by
    intro f hf hfb c d r
    refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
      (hf.mul (Complex.continuous_conj.comp (hf.comp
        (continuous_id.add continuous_const)))).aestronglyMeasurable (B * B) ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    rw [norm_mul, norm_star]
    exact mul_le_mul (hfb x) (hfb (x + r)) (norm_nonneg _) (le_trans (norm_nonneg _) (hfb x))
  have hint_re : ∀ {f : ℝ → ℂ}, Continuous f → (∀ x : ℝ, ‖f x‖ ≤ B) →
      ∀ (c d : ℝ) (r : ℝ),
      IntegrableOn (fun x : ℝ => (f x * star (f (x + r))).re) (Set.Ioo c d) := by
    intro f hf hfb c d r
    refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
      ((Complex.continuous_re.comp (hf.mul (Complex.continuous_conj.comp (hf.comp
        (continuous_id.add continuous_const))))).aestronglyMeasurable) (B * B) ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    rw [Real.norm_eq_abs]
    calc |(f x * star (f (x + r))).re| ≤ ‖f x * star (f (x + r))‖ := Complex.abs_re_le_norm _
      _ = ‖f x‖ * ‖f (x + r)‖ := by rw [norm_mul, norm_star]
      _ ≤ B * B := mul_le_mul (hfb x) (hfb (x + r)) (norm_nonneg _) hB0
  have hinner_re : ∀ (c d : ℝ) (r : ℝ),
      (∫ x in Set.Ioo c d, g x * star (g (x + r))).re
        = (∫ x in Set.Ioo c d, Y7Density.rePart g x * star (Y7Density.rePart g (x + r))).re
          + (∫ x in Set.Ioo c d, Y7Density.imPart g x * star (Y7Density.imPart g (x + r))).re := by
    intro c d r
    rw [integral_re_on c d (hint hcd.continuous hB c d r),
      integral_re_on c d (hint hcont_u (Y7Density.rePart_bound_all hB) c d r),
      integral_re_on c d (hint hcont_v (Y7Density.imPart_bound_all hB) c d r)]
    rw [show (∫ x in Set.Ioo c d, (g x * star (g (x + r))).re)
        = ∫ x in Set.Ioo c d,
            ((Y7Density.rePart g x * star (Y7Density.rePart g (x + r))).re
              + (Y7Density.imPart g x * star (Y7Density.imPart g (x + r))).re) from by
      apply integral_congr_ae
      filter_upwards with x
      rw [Y7Density.mul_star_re_eq_re_im (g x) (g (x + r))]
      simp only [Y7Density.rePart, Y7Density.imPart]]
    rw [integral_add (hint_re hcont_u (Y7Density.rePart_bound_all hB) c d r)
      (hint_re hcont_v (Y7Density.imPart_bound_all hB) c d r)]
  have hinner_re_sub : ∀ (c d s : ℝ),
      (∫ x in Set.Ioo c d, g x * star (g (x - s))).re
        = (∫ x in Set.Ioo c d, Y7Density.rePart g x * star (Y7Density.rePart g (x - s))).re
          + (∫ x in Set.Ioo c d, Y7Density.imPart g x * star (Y7Density.imPart g (x - s))).re := by
    intro c d s
    simpa only [sub_eq_add_neg] using hinner_re c d (-s)
  unfold RHLean.shiftFormRescaled
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  rw [Complex.add_re,
    hinner_re (-1) (1 - RHLean.shiftLengthRescaled a n) (RHLean.shiftLengthRescaled a n),
    hinner_re_sub (-1 + RHLean.shiftLengthRescaled a n) 1 (RHLean.shiftLengthRescaled a n)]
  simp only [Complex.add_re]
  ring
theorem localizedFormRescaled_re_im {a : ℝ} (ha : 0 < a) {g : ℝ → ℂ}
    (hg : g ∈ RHLean.localizedCore 1) :
    RHLean.localizedFormRescaled a g
      = RHLean.localizedFormRescaled a (rePart g)
        + RHLean.localizedFormRescaled a (imPart g) := by
  simp only [RHLean.localizedFormRescaled, RHLean.potentialFormRescaled]
  rw [arch_re_im hg, mass_re_im hg, potential_re_im hg, gamma_re_im ha.le hg,
    polar_re_im hg, shift_re_im hg]
  ring
def RealPartDensity (a : ℝ) : Prop :=
  ∀ f : ℝ → ℂ, f ∈ RHLean.localizedCore 1 → (∀ x, (f x).im = 0) → ∀ ε : ℝ, 0 < ε →
    ∃ p : Polynomial ℝ, IsOddPoly p ∧
      |RHLean.localizedFormRescaled a f - polyForm a p| ≤ ε
theorem legendreDensity_of_realPartDensity {a : ℝ} (ha : 0 < a)
    (h : RealPartDensity a) : LegendreDensity a := by
  intro g hg ε hε
  obtain ⟨p, hpodd, hp⟩ := h (rePart g) (rePart_mem_localizedCore hg)
    (by intro x; simp [rePart]) (ε / 2) (by linarith)
  obtain ⟨q, hqodd, hq⟩ := h (imPart g) (imPart_mem_localizedCore hg)
    (by intro x; simp [imPart]) (ε / 2) (by linarith)
  refine ⟨p, q, hpodd, hqodd, ?_⟩
  have hsplit := localizedFormRescaled_re_im ha hg
  calc |RHLean.localizedFormRescaled a g - (polyForm a p + polyForm a q)|
      = |(RHLean.localizedFormRescaled a (rePart g) - polyForm a p)
          + (RHLean.localizedFormRescaled a (imPart g) - polyForm a q)| := by
        rw [hsplit]
        ring
    _ ≤ |RHLean.localizedFormRescaled a (rePart g) - polyForm a p|
          + |RHLean.localizedFormRescaled a (imPart g) - polyForm a q| := abs_add_le _ _
    _ ≤ ε / 2 + ε / 2 := add_le_add hp hq
    _ = ε := by ring
theorem localPSDRescaled_of_polynomialPositivity_realPartDensity {a : ℝ} (ha : 0 < a)
    (hpos : PolynomialPositivity a) (h : RealPartDensity a) :
    RHLean.LocalPSDRescaled a :=
  localPSDRescaled_of_polynomialPositivity hpos (legendreDensity_of_realPartDensity ha h)
theorem physicalTarget_of_polynomialPositivity_realPartDensity
    (hpos : PolynomialPositivity (RHLean.endpoint 7))
    (h : RealPartDensity (RHLean.endpoint 7)) : Y7Target.Y7PhysicalTarget :=
  physicalTarget_of_polynomialPositivity hpos
    (legendreDensity_of_realPartDensity (by unfold RHLean.endpoint; positivity) h)
end Y7Density
end
