section Inline_Y7_RhoIdentity
noncomputable section
open Polynomial
open scoped BigOperators
namespace Y7Density
def expTrunc (c : ℝ) (N : ℕ) : Polynomial ℝ :=
  ∑ k ∈ Finset.range N, Polynomial.C (c ^ k / ((k.factorial : ℕ) : ℝ)) * Polynomial.X ^ k
def rhoTrunc (M : ℕ) : Polynomial ℝ :=
  ∑ m ∈ Finset.range (M + 1),
    Polynomial.C ((Y7Chain.rhoCoeff m : ℚ) : ℝ) * Polynomial.X ^ m
lemma coeff_expTrunc_self {c : ℝ} {N k : ℕ} (hk : k < N) :
    (expTrunc c N).coeff k = c ^ k / ((k.factorial : ℕ) : ℝ) := by
  rw [expTrunc, Polynomial.finsetSum_coeff]
  rw [Finset.sum_eq_single k]
  · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
  · intro m hm hmk
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
  · intro hk'
    exact absurd (Finset.mem_range.mpr hk) hk'
lemma coeff_expTrunc_eq_zero {c : ℝ} {N k : ℕ} (hk : N ≤ k) :
    (expTrunc c N).coeff k = 0 := by
  rw [expTrunc, Polynomial.finsetSum_coeff]
  apply Finset.sum_eq_zero
  intro m hm
  rw [Finset.mem_range] at hm
  rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
lemma coeff_rhoTrunc_self {M m : ℕ} (hm : m ≤ M) :
    (rhoTrunc M).coeff m = ((Y7Chain.rhoCoeff m : ℚ) : ℝ) := by
  rw [rhoTrunc, Polynomial.finsetSum_coeff]
  rw [Finset.sum_eq_single m]
  · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
  · intro k hk hkm
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
  · intro hm'
    exact absurd (Finset.mem_range.mpr (by omega)) hm'
lemma coeff_rhoTrunc_eq_zero {M m : ℕ} (hm : M < m) :
    (rhoTrunc M).coeff m = 0 := by
  rw [rhoTrunc, Polynomial.finsetSum_coeff]
  apply Finset.sum_eq_zero
  intro k hk
  rw [Finset.mem_range] at hk
  rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
def rhoProduct (M : ℕ) : Polynomial ℝ :=
  (1 + Polynomial.C 2 * Polynomial.X * rhoTrunc M) * (expTrunc 2 (M + 3) - 1)
    - Polynomial.C 2 * Polynomial.X * expTrunc (3 / 2) (M + 3)
def RhoCoeffConsistency : Prop :=
  ∀ M : ℕ, ∀ n ≤ M + 2, (rhoProduct M).coeff n = 0
theorem rhoProduct_zero : rhoProduct 0 = Polynomial.C (-5 / 4) * Polynomial.X ^ 3 := by
  unfold rhoProduct rhoTrunc expTrunc
  norm_num [Finset.sum_range_succ, Y7Chain.rhoCoeff_zero]
  apply Polynomial.funext
  intro x
  simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_one, Polynomial.eval_neg]
  ring
theorem rhoProduct_zero_coeff {n : ℕ} (hn : n ≤ 2) : (rhoProduct 0).coeff n = 0 := by
  rw [rhoProduct_zero, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
    if_neg (by omega), mul_zero]
theorem rhoProduct_one :
    rhoProduct 1 = Polynomial.C (-13 / 24) * Polynomial.X ^ 4
      + Polynomial.C (-1 / 18) * Polynomial.X ^ 5 := by
  unfold rhoProduct rhoTrunc expTrunc
  norm_num [Finset.sum_range_succ, Y7Chain.rhoCoeff_zero, Y7Chain.rhoCoeff_one]
  apply Polynomial.funext
  intro x
  simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_one, Polynomial.eval_neg]
  ring
theorem rhoProduct_one_coeff {n : ℕ} (hn : n ≤ 3) : (rhoProduct 1).coeff n = 0 := by
  rw [rhoProduct_one, Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_pow, Polynomial.coeff_X_pow,
    if_neg (by omega : ¬ n = 4), if_neg (by omega : ¬ n = 5)]
  ring
theorem rhoProduct_succ (M : ℕ) :
    rhoProduct (M + 1) = rhoProduct M
      + Polynomial.X ^ (M + 2) *
          (Polynomial.C (2 * ((Y7Chain.rhoCoeff (M + 1) : ℚ) : ℝ))
              * (expTrunc 2 (M + 4) - 1)
            + (1 + Polynomial.C 2 * Polynomial.X * rhoTrunc M)
                * Polynomial.C (((2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))
                * Polynomial.X
            - Polynomial.C (2 * ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))))
                * Polynomial.X ^ 2) := by
  unfold rhoProduct
  rw [show rhoTrunc (M + 1) = rhoTrunc M
      + Polynomial.C ((Y7Chain.rhoCoeff (M + 1) : ℚ) : ℝ) * Polynomial.X ^ (M + 1) from by
    unfold rhoTrunc
    rw [Finset.sum_range_succ]]
  rw [show expTrunc 2 (M + 4) = expTrunc 2 (M + 3)
      + Polynomial.C (((2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))
        * Polynomial.X ^ (M + 3) from by
    unfold expTrunc
    rw [Finset.sum_range_succ]]
  rw [show expTrunc (3 / 2) (M + 4) = expTrunc (3 / 2) (M + 3)
      + Polynomial.C ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ)))
        * Polynomial.X ^ (M + 3) from by
    unfold expTrunc
    rw [Finset.sum_range_succ]]
  apply Polynomial.funext
  intro x
  simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow,
    Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_one, Polynomial.eval_neg]
  ring
def GammaTaylorRemainderLeaf (M : ℕ) (a ε : ℝ) : Prop :=
  ∀ t ∈ Set.Icc 0 (2 * a), |RHLean.gammaKernel t - (rhoTrunc M).eval t| ≤ ε
noncomputable def rhoQ (M : ℕ) : Polynomial ℝ :=
  Polynomial.C (2 * ((Y7Chain.rhoCoeff (M + 1) : ℚ) : ℝ)) * (expTrunc 2 (M + 4) - 1)
    + (1 + Polynomial.C 2 * Polynomial.X * rhoTrunc M)
        * Polynomial.C (((2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))
        * Polynomial.X
    - Polynomial.C (2 * ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))))
        * Polynomial.X ^ 2
theorem rhoProduct_succ' (M : ℕ) :
    rhoProduct (M + 1) = rhoProduct M + Polynomial.X ^ (M + 2) * rhoQ M :=
  rhoProduct_succ M
theorem rhoQ_coeff_zero (M : ℕ) : (rhoQ M).coeff 0 = 0 := by
  unfold rhoQ
  have hA : (Polynomial.C (2 * ((Y7Chain.rhoCoeff (M + 1) : ℚ) : ℝ))
        * (expTrunc 2 (M + 4) - 1)).coeff 0 = 0 := by
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_sub, Polynomial.coeff_one_zero,
      coeff_expTrunc_self (by omega : 0 < M + 4)]
    norm_num
  have hB : ((1 + Polynomial.C 2 * Polynomial.X * rhoTrunc M)
        * Polynomial.C (((2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))
        * Polynomial.X).coeff 0 = 0 :=
    Polynomial.coeff_mul_X_zero _
  have hC : (Polynomial.C (2 * ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))))
        * Polynomial.X ^ 2).coeff 0 = 0 := by
    rw [show Polynomial.C (2 * ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))))
          * Polynomial.X ^ 2
          = (Polynomial.C (2 * ((((3 / 2 : ℝ) ^ (M + 3)) / (((M + 3).factorial : ℕ) : ℝ))))
            * Polynomial.X) * Polynomial.X by ring,
      Polynomial.coeff_mul_X_zero]
  rw [Polynomial.coeff_sub, Polynomial.coeff_add, hA, hB, hC]
  ring
theorem rhoCoeff_recurrence (M : ℕ) :
    2 * ((Y7Chain.rhoCoeff M : ℚ) : ℝ)
        + (∑ j ∈ Finset.Icc 2 (M + 1),
            if _h : 2 ≤ j ∧ 1 ≤ M then
              ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
                * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) else 0)
      = (3 / 2 : ℝ) ^ (M + 1) / (((M + 1).factorial : ℕ) : ℝ)
        - (2 : ℝ) ^ (M + 1) / (((M + 2).factorial : ℕ) : ℝ) := by
  have h := congrArg (fun q : ℚ => (q : ℝ)) (Y7Chain.rhoCoeff.eq_1 M)
  push_cast at h
  have hS : (∑ i ∈ Finset.Icc 2 (M + 1),
        (((if _h : 2 ≤ i ∧ 1 ≤ M then
          (2 : ℚ) ^ i / ((i.factorial : ℚ)) * Y7Chain.rhoCoeff (M + 1 - i) else 0) : ℚ) : ℝ))
      = ∑ j ∈ Finset.Icc 2 (M + 1),
          if _h : 2 ≤ j ∧ 1 ≤ M then
            ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
              * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) else 0 := by
    apply Finset.sum_congr rfl
    intro i hi
    split_ifs with hh
    · push_cast
      ring
    · simp
  rw [hS] at h
  linarith [h]
theorem rhoCoeff_recurrence' (M : ℕ) :
    2 * ((Y7Chain.rhoCoeff M : ℚ) : ℝ)
        + (∑ j ∈ Finset.Icc 2 (M + 1),
            ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
              * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ))
      = (3 / 2 : ℝ) ^ (M + 1) / (((M + 1).factorial : ℕ) : ℝ)
        - (2 : ℝ) ^ (M + 1) / (((M + 2).factorial : ℕ) : ℝ) := by
  have h := rhoCoeff_recurrence M
  have hS : (∑ j ∈ Finset.Icc 2 (M + 1),
        if _h : 2 ≤ j ∧ 1 ≤ M then
          ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
            * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) else 0)
      = ∑ j ∈ Finset.Icc 2 (M + 1),
          ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
            * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) := by
    by_cases hM : 1 ≤ M
    · apply Finset.sum_congr rfl
      intro j hj
      have h2 : 2 ≤ j := (Finset.mem_Icc.mp hj).1
      split_ifs with hh
      · rfl
      · exact absurd ⟨h2, hM⟩ hh
    · have hM0 : M = 0 := by omega
      subst hM0
      apply Finset.sum_eq_zero
      intro j hj
      have h2 := (Finset.mem_Icc.mp hj).1
      have h1 := (Finset.mem_Icc.mp hj).2
      split_ifs with hh
      · exact absurd hh.2 (by omega)
      · rfl
  rw [hS] at h
  exact h
theorem rhoProduct_top (M : ℕ) : (rhoProduct M).coeff (M + 2) = 0 := by
  have hBcoeff : ∀ j : ℕ, 1 ≤ j → j ≤ M + 2 →
      (expTrunc 2 (M + 3) - 1).coeff j = (2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ) := by
    intro j hj1 hj2
    rw [Polynomial.coeff_sub, coeff_expTrunc_self (by omega : j < M + 3),
      Polynomial.coeff_one, if_neg (by omega : j ≠ 0), sub_zero]
  have hprod : (rhoTrunc M * (expTrunc 2 (M + 3) - 1)).coeff (M + 1)
      = ∑ i ∈ Finset.range (M + 1), ((Y7Chain.rhoCoeff i : ℚ) : ℝ)
          * ((2 : ℝ) ^ (M + 1 - i) / (((M + 1 - i).factorial : ℕ) : ℝ)) := by
    rw [rhoTrunc, Finset.sum_mul, Polynomial.finsetSum_coeff]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    rw [mul_assoc, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul',
      if_pos (by omega : i ≤ M + 1)]
    rw [hBcoeff (M + 1 - i) (by omega) (by omega)]
  have hsumsplit : (∑ i ∈ Finset.range (M + 1), ((Y7Chain.rhoCoeff i : ℚ) : ℝ)
        * ((2 : ℝ) ^ (M + 1 - i) / (((M + 1 - i).factorial : ℕ) : ℝ)))
      = 2 * ((Y7Chain.rhoCoeff M : ℚ) : ℝ)
        + ∑ j ∈ Finset.Icc 2 (M + 1), ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
            * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) := by
    rw [Finset.sum_range_succ]
    have hlast : ((Y7Chain.rhoCoeff M : ℚ) : ℝ)
        * ((2 : ℝ) ^ (M + 1 - M) / (((M + 1 - M).factorial : ℕ) : ℝ))
        = 2 * ((Y7Chain.rhoCoeff M : ℚ) : ℝ) := by
      rw [show M + 1 - M = 1 by omega]
      ring
    rw [hlast]
    have hcore : (∑ i ∈ Finset.range M, ((Y7Chain.rhoCoeff i : ℚ) : ℝ)
        * ((2 : ℝ) ^ (M + 1 - i) / (((M + 1 - i).factorial : ℕ) : ℝ)))
        = ∑ j ∈ Finset.Icc 2 (M + 1), ((2 : ℝ) ^ j / ((j.factorial : ℕ) : ℝ))
            * ((Y7Chain.rhoCoeff (M + 1 - j) : ℚ) : ℝ) := by
      refine Finset.sum_bij (fun i _ => M + 1 - i) ?_ ?_ ?_ ?_
      · intro i hi
        rw [Finset.mem_range] at hi
        rw [Finset.mem_Icc]
        omega
      · intro a₁ h₁ a₂ h₂ heq
        rw [Finset.mem_range] at h₁ h₂
        omega
      · intro j hj
        rw [Finset.mem_Icc] at hj
        refine ⟨M + 1 - j, ?_, ?_⟩
        · rw [Finset.mem_range]; omega
        · omega
      · intro i hi
        rw [Finset.mem_range] at hi
        rw [show M + 1 - (M + 1 - i) = i by omega]
        ring
    linarith [hcore]
  have hBtop : (expTrunc 2 (M + 3) - 1).coeff (M + 2)
      = (2 : ℝ) ^ (M + 2) / (((M + 2).factorial : ℕ) : ℝ) :=
    hBcoeff (M + 2) (by omega) (le_refl _)
  have hE32 : (Polynomial.C 2 * Polynomial.X * expTrunc (3 / 2) (M + 3)).coeff (M + 2)
      = 2 * ((3 / 2 : ℝ) ^ (M + 1) / (((M + 1).factorial : ℕ) : ℝ)) := by
    rw [show Polynomial.C 2 * Polynomial.X * expTrunc (3 / 2) (M + 3)
        = Polynomial.C 2 * (Polynomial.X ^ 1 * expTrunc (3 / 2) (M + 3)) by ring,
      Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul',
      if_pos (by omega : (1 : ℕ) ≤ M + 2),
      show M + 2 - 1 = M + 1 by omega, coeff_expTrunc_self (by omega : M + 1 < M + 3)]
  have hsplit : (rhoProduct M).coeff (M + 2)
      = (expTrunc 2 (M + 3) - 1).coeff (M + 2)
        + 2 * (rhoTrunc M * (expTrunc 2 (M + 3) - 1)).coeff (M + 1)
        - 2 * ((3 / 2 : ℝ) ^ (M + 1) / (((M + 1).factorial : ℕ) : ℝ)) := by
    unfold rhoProduct
    rw [Polynomial.coeff_sub,
      show (1 + Polynomial.C 2 * Polynomial.X * rhoTrunc M) * (expTrunc 2 (M + 3) - 1)
          = (expTrunc 2 (M + 3) - 1)
            + Polynomial.C 2
                * (Polynomial.X ^ 1 * (rhoTrunc M * (expTrunc 2 (M + 3) - 1))) by ring,
      Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul',
      if_pos (by omega : (1 : ℕ) ≤ M + 2), show M + 2 - 1 = M + 1 by omega,
      hE32]
  rw [hsplit, hBtop, hprod, hsumsplit]
  have hrec := rhoCoeff_recurrence' M
  have hfac : (2 : ℝ) ^ (M + 2) / (((M + 2).factorial : ℕ) : ℝ)
      = 2 * ((2 : ℝ) ^ (M + 1) / (((M + 2).factorial : ℕ) : ℝ)) := by
    rw [show (2 : ℝ) ^ (M + 2) = 2 * 2 ^ (M + 1) by rw [pow_succ]; ring]
    ring
  rw [hfac]
  linarith [hrec]
theorem rho_coeff_consistency : RhoCoeffConsistency := by
  intro M
  induction M with
  | zero => intro n hn; exact rhoProduct_zero_coeff hn
  | succ M ih =>
      intro n hn
      by_cases hn3 : n = M + 3
      · subst hn3
        exact rhoProduct_top (M + 1)
      · have hnle : n ≤ M + 2 := by omega
        rw [rhoProduct_succ' M, Polynomial.coeff_add, Polynomial.coeff_X_pow_mul']
        split_ifs with hle
        · have hn_eq : n = M + 2 := by omega
          subst hn_eq
          rw [Nat.sub_self, rhoQ_coeff_zero, ih (M + 2) (le_refl (M + 2))]
          ring
        · rw [ih n hnle]
          ring
end Y7Density
end
