    · rw [closure_ball (0 : ℂ) (by norm_num : (14 : ℝ) / 5 ≠ 0)]
      exact continuousOn_gammaExt_closedBall
  have hCb : ∀ z ∈ Metric.sphere 0 ((14 : ℝ) / 5),
      ‖gammaExt z‖ ≤ Y7Chain.gammaM (14 / 5) := by
    intro z hz
    have hzn : ‖z‖ = (14 : ℝ) / 5 := by
      rwa [Metric.mem_sphere, dist_zero_right] at hz
    rcases eq_or_ne z 0 with rfl | hz0
    · exact absurd hzn (by norm_num)
    · rw [gammaExt_of_ne hz0]
      exact norm_gammaFull_le hR hRpi hzn
  have hz : ‖(t : ℂ)‖ ≤ 2 * a := by
    have hnorm : ‖(t : ℂ)‖ = |t| := by
      rw [← Real.sqrt_sq (norm_nonneg (t : ℂ)), Complex.sq_norm, Complex.normSq_ofReal]
      rw [show t * t = t ^ 2 by ring, Real.sqrt_sq_eq_abs]
    rw [hnorm, abs_of_nonneg ht0]
    exact hta
  have hrem := norm_taylor_remainder_le (f := gammaExt) (R := (14 : ℝ) / 5)
    (C := Y7Chain.gammaM (14 / 5)) (r := 2 * a) hR hC hf hCb hz ha (by linarith) 241
  rw [taylorSum_gammaExt t] at hrem
  have hre : RHLean.gammaKernel t - (rhoTrunc 240).eval t
