private lemma integrableOn_ratio_mul_Ioo (f : ℝ → ℝ) (hf : Continuous f) (x : ℝ) :
    IntegrableOn (fun y : ℝ => (x - y) / ‖x - y‖ * f y) (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hf.continuousOn
  refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top) ?_ C ?_
  · exact (((measurable_const.sub measurable_id).div
      ((continuous_const.sub continuous_id).norm.measurable)).mul
        hf.measurable).aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
    have hyb : ‖f y‖ ≤ C := hC y ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hratio : ‖(x - y) / ‖x - y‖‖ ≤ 1 := by
      rw [norm_div, Real.norm_of_nonneg (norm_nonneg (x - y))]
      by_cases hxy : x = y
      · subst hxy; simp
      · have hpos : 0 < ‖x - y‖ := by
          rw [norm_pos_iff]; exact sub_ne_zero.mpr hxy
        exact (div_le_one hpos).mpr le_rfl
    rw [norm_mul]
    calc ‖(x - y) / ‖x - y‖‖ * ‖f y‖ ≤ 1 * C :=
          mul_le_mul hratio hyb (norm_nonneg _) (by norm_num)
      _ = C := one_mul C
theorem archH_eq_of_continuous (f : ℝ → ℝ) (hf : Continuous f) {x : ℝ}
    (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archH f x = 2 * (∫ y in (-1 : ℝ)..x, f y) - ∫ y in (-1 : ℝ)..1, f y := by
  set g : ℝ → ℝ := fun y => (x - y) / ‖x - y‖ * f y with hg
  have hgint : IntegrableOn g (Set.Ioo (-1 : ℝ) 1) := integrableOn_ratio_mul_Ioo f hf x
  have hx1 : (-1 : ℝ) < x := hx.1
  have hx2 : x < 1 := hx.2
  have hsub1 : Set.Ioo (-1 : ℝ) x ⊆ Set.Ioo (-1 : ℝ) 1 :=
    fun y hy => ⟨hy.1, hy.2.trans hx2⟩
  have hsub2 : Set.Ioo x (1 : ℝ) ⊆ Set.Ioo (-1 : ℝ) 1 :=
    fun y hy => ⟨hx1.trans hy.1, hy.2⟩
  have hsub3 : ({x} : Set ℝ) ⊆ Set.Ioo (-1 : ℝ) 1 := fun y hy => hy ▸ hx
  have hIoo : Set.Ioo (-1 : ℝ) 1 = Set.Ioo (-1 : ℝ) x ∪ (Set.Ioo x 1 ∪ {x}) := by
    ext y
    constructor
    · rintro ⟨h1, h2⟩
      rcases lt_trichotomy y x with h | h | h
      · exact Or.inl ⟨h1, h⟩
      · exact Or.inr (Or.inr h)
      · exact Or.inr (Or.inl ⟨h, h2⟩)
    · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩ | h)
      · exact ⟨h1, h2.trans hx2⟩
      · exact ⟨hx1.trans h1, h2⟩
      · exact h ▸ hx
  have hdisj1 : Disjoint (Set.Ioo (-1 : ℝ) x) (Set.Ioo x 1 ∪ {x}) := by
    rw [Set.disjoint_left]
    rintro y ⟨-, hyx⟩ (⟨hxy, -⟩ | hx')
    · exact absurd hyx (not_lt.mpr hxy.le)
    · rw [Set.mem_singleton_iff] at hx'
      exact absurd (hx' ▸ hyx) (lt_irrefl x)
  have hdisj2 : Disjoint (Set.Ioo x (1 : ℝ)) ({x} : Set ℝ) := by
    rw [Set.disjoint_left]
    rintro y ⟨hxy, -⟩ hx'
    rw [Set.mem_singleton_iff] at hx'
    exact absurd (hx' ▸ hxy) (lt_irrefl x)
  have hsplit : (∫ y in Set.Ioo (-1 : ℝ) 1, g y)
      = (∫ y in Set.Ioo (-1 : ℝ) x, g y) + (∫ y in Set.Ioo x 1, g y) := by
    rw [hIoo, setIntegral_union hdisj1 (measurableSet_Ioo.union (measurableSet_singleton x))
      (hgint.mono_set hsub1) ((hgint.mono_set hsub2).union (hgint.mono_set hsub3))]
    rw [setIntegral_union hdisj2 (measurableSet_singleton x) (hgint.mono_set hsub2)
      (hgint.mono_set hsub3)]
    simp
  have hcongr1 : (∫ y in Set.Ioo (-1 : ℝ) x, g y) = ∫ y in Set.Ioo (-1 : ℝ) x, f y := by
    apply setIntegral_congr_fun measurableSet_Ioo
    rintro y ⟨-, hyx⟩
    have hpos : 0 < x - y := sub_pos.mpr hyx
    show (x - y) / ‖x - y‖ * f y = f y
    rw [Real.norm_of_nonneg hpos.le, div_self hpos.ne', one_mul]
  have hcongr2 : (∫ y in Set.Ioo x (1 : ℝ), g y) = -(∫ y in Set.Ioo x (1 : ℝ), f y) := by
    rw [← integral_neg]
    apply setIntegral_congr_fun measurableSet_Ioo
    rintro y ⟨hxy, -⟩
    have hneg : x - y < 0 := sub_neg.mpr hxy
    show (x - y) / ‖x - y‖ * f y = -(f y)
    rw [Real.norm_of_nonpos hneg.le]
    have hne : x - y ≠ 0 := hneg.ne
    field_simp
  have hconv1 : (∫ y in Set.Ioo (-1 : ℝ) x, f y) = ∫ y in (-1 : ℝ)..x, f y := by
    rw [intervalIntegral.integral_of_le hx1.le, integral_Ioc_eq_integral_Ioo]
  have hconv2 : (∫ y in Set.Ioo x (1 : ℝ), f y) = ∫ y in x..1, f y := by
    rw [intervalIntegral.integral_of_le hx2.le, integral_Ioc_eq_integral_Ioo]
  have hadj : (∫ y in (-1 : ℝ)..1, f y)
      = (∫ y in (-1 : ℝ)..x, f y) + ∫ y in x..1, f y :=
    (intervalIntegral.integral_add_adjacent_intervals (hf.intervalIntegrable (-1) x)
      (hf.intervalIntegrable x 1)).symm
  have harch : archH f x = ∫ y in Set.Ioo (-1 : ℝ) 1, g y := rfl
  rw [harch, hsplit, hcongr1, hcongr2, hconv1, hconv2, hadj]
  ring
noncomputable def legPrim (n : ℕ) (x : ℝ) : ℝ :=
  ((Y7Legendre.legP (n + 1)).eval x - (Y7Legendre.legP (n - 1)).eval x) /
    (2 * (n : ℝ) + 1)
lemma legPrim_hasDerivAt (n : ℕ) (hn : 1 ≤ n) (x : ℝ) :
    HasDerivAt (legPrim n) ((Y7Legendre.legP n).eval x) x := by
  have hpoly := Y7Deriv.derivative_legP_succ_sub_pred n hn
  have h1 : HasDerivAt (fun x : ℝ => (Y7Legendre.legP (n + 1)).eval x)
      ((Polynomial.derivative (Y7Legendre.legP (n + 1))).eval x) x :=
    Polynomial.hasDerivAt (p := Y7Legendre.legP (n + 1)) x
  have h2 : HasDerivAt (fun x : ℝ => (Y7Legendre.legP (n - 1)).eval x)
      ((Polynomial.derivative (Y7Legendre.legP (n - 1))).eval x) x :=
    Polynomial.hasDerivAt (p := Y7Legendre.legP (n - 1)) x
  have hsub : HasDerivAt
      (fun x : ℝ => (Y7Legendre.legP (n + 1)).eval x - (Y7Legendre.legP (n - 1)).eval x)
      (((Polynomial.derivative (Y7Legendre.legP (n + 1))).eval x)
        - (Polynomial.derivative (Y7Legendre.legP (n - 1))).eval x) x := h1.sub h2
  rw [← Polynomial.eval_sub, hpoly, Polynomial.eval_mul, Polynomial.eval_C] at hsub
  have hd := hsub.div_const (2 * (n : ℝ) + 1)
  have hval : (2 * (n : ℝ) + 1) * (Y7Legendre.legP n).eval x / (2 * (n : ℝ) + 1)
      = (Y7Legendre.legP n).eval x :=
    mul_div_cancel_left₀ _ (by positivity)
  rw [hval] at hd
  exact hd
lemma integral_legP_eq_legPrim (n : ℕ) (hn : 1 ≤ n) (a b : ℝ) :
    (∫ y in a..b, (Y7Legendre.legP n).eval y) = legPrim n b - legPrim n a :=
  intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun x _ => legPrim_hasDerivAt n hn x)
    ((Polynomial.continuous (Y7Legendre.legP n)).intervalIntegrable a b)
lemma legPrim_one (n : ℕ) (hn : 1 ≤ n) : legPrim n 1 = 0 := by
  unfold legPrim
  rw [Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP, sub_self, zero_div]
lemma legPrim_neg_one (n : ℕ) (hn : 1 ≤ n) : legPrim n (-1) = 0 := by
  unfold legPrim
  rw [Y7Legendre.eval_legP_neg, Y7Legendre.eval_legP_neg, Y7Legendre.eval_one_legP,
    Y7Legendre.eval_one_legP]
  have hpow : (-1 : ℝ) ^ (n + 1) = (-1 : ℝ) ^ (n - 1) := by
    rw [show n + 1 = (n - 1) + 2 by omega, pow_add]
    ring
  rw [hpow, mul_one, sub_self, zero_div]
theorem archH_legP (n : ℕ) (hn : 1 ≤ n) {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archH (fun y => (Y7Legendre.legP n).eval y) x
      = 2 * (((Y7Legendre.legP (n + 1)).eval x - (Y7Legendre.legP (n - 1)).eval x)
          / (2 * (n : ℝ) + 1)) := by
  rw [archH_eq_of_continuous _ (Polynomial.continuous _) hx]
  have h1 : (∫ y in (-1 : ℝ)..x, (Y7Legendre.legP n).eval y) = legPrim n x := by
    rw [integral_legP_eq_legPrim n hn, legPrim_neg_one n hn, sub_zero]
  have h0 : (∫ y in (-1 : ℝ)..1, (Y7Legendre.legP n).eval y) = 0 := by
    have h := Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne 0 n (by omega)
    simpa [Y7Legendre.legP_zero] using h
  rw [h1, h0, sub_zero]
  rfl
theorem exists_legP_expansion (N : ℕ) (q : Polynomial ℝ) (hq : q.natDegree ≤ N) :
    ∃ c : ℕ → ℝ, q = ∑ k ∈ Finset.range (N + 1),
      Polynomial.C (c k) * Y7Legendre.legP k := by
  induction N generalizing q with
  | zero =>
      refine ⟨fun k => if k = 0 then q.coeff 0 else 0, ?_⟩
      rw [Polynomial.eq_C_of_natDegree_le_zero hq]
      simp [Y7Legendre.legP_zero]
  | succ N ih =>
      by_cases hle : q.natDegree ≤ N
      · obtain ⟨c, hc⟩ := ih q hle
        refine ⟨fun k => if k = N + 1 then 0 else c k, ?_⟩
        rw [hc]
        conv_rhs => rw [Finset.sum_range_succ]
        have hcongr : ∀ k ∈ Finset.range (N + 1),
            Polynomial.C (if k = N + 1 then 0 else c k) * Y7Legendre.legP k
              = Polynomial.C (c k) * Y7Legendre.legP k := by
          intro k hk
          rw [Finset.mem_range] at hk
          rw [if_neg (by omega)]
        rw [Finset.sum_congr rfl hcongr]
        simp
      · have hdeg : q.natDegree = N + 1 := by
          have : N < q.natDegree := Nat.lt_of_not_le hle
          omega
        set c : ℝ := q.coeff (N + 1) / (Y7Legendre.legP (N + 1)).coeff (N + 1) with hcdef
        have hcoeff : c * (Y7Legendre.legP (N + 1)).coeff (N + 1) = q.coeff (N + 1) := by
          rw [hcdef, div_mul_cancel₀]
          exact Y7Legendre.coeff_legP_self_ne_zero (N + 1)
        have hq' : (q - Polynomial.C c * Y7Legendre.legP (N + 1)).natDegree ≤ N := by
          rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro m hm
          rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul]
          rcases lt_or_eq_of_le (Nat.succ_le_of_lt hm) with hlt | heq
          · have hqm : q.coeff m = 0 := by
              apply Polynomial.coeff_eq_zero_of_natDegree_lt
              omega
            have hPm : (Y7Legendre.legP (N + 1)).coeff m = 0 := by
              apply Polynomial.coeff_eq_zero_of_natDegree_lt
              rw [Y7Legendre.natDegree_legP]
              omega
            rw [hqm, hPm, mul_zero, sub_zero]
          · rw [← heq, hcoeff, sub_self]
        obtain ⟨c', hc'⟩ := ih _ hq'
        refine ⟨fun k => if k = N + 1 then c else c' k, ?_⟩
        have hqdecomp : q = (q - Polynomial.C c * Y7Legendre.legP (N + 1))
            + Polynomial.C c * Y7Legendre.legP (N + 1) := by ring
        rw [hqdecomp, hc']
        conv_rhs => rw [Finset.sum_range_succ]
        have hcongr : ∀ k ∈ Finset.range (N + 1),
            Polynomial.C (if k = N + 1 then c else c' k) * Y7Legendre.legP k
              = Polynomial.C (c' k) * Y7Legendre.legP k := by
          intro k hk
          rw [Finset.mem_range] at hk
          rw [if_neg (by omega)]
        rw [Finset.sum_congr rfl hcongr]
        simp
theorem integral_mul_legP_of_expansion {N : ℕ} {q : Polynomial ℝ} {c : ℕ → ℝ}
    (hq : q = ∑ k ∈ Finset.range (N + 1), Polynomial.C (c k) * Y7Legendre.legP k)
    {j : ℕ} (hj : j ≤ N) :
    (∫ x in (-1 : ℝ)..1, q.eval x * (Y7Legendre.legP j).eval x)
      = c j * (2 / (2 * (j : ℝ) + 1)) := by
  subst hq
  have hpt : ∀ x : ℝ,
      (∑ k ∈ Finset.range (N + 1), Polynomial.C (c k) * Y7Legendre.legP k).eval x
        * (Y7Legendre.legP j).eval x
      = ∑ k ∈ Finset.range (N + 1),
          c k * ((Y7Legendre.legP k).eval x * (Y7Legendre.legP j).eval x) := by
    intro x
    rw [Polynomial.eval_finsetSum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k hk
    rw [Polynomial.eval_mul, Polynomial.eval_C]
    ring
  rw [intervalIntegral.integral_congr (fun x _ => hpt x)]
  rw [intervalIntegral.integral_finsetSum]
  · rw [Finset.sum_eq_single j]
    · rw [intervalIntegral.integral_const_mul, Y7Rodrigues.integral_legP_sq]
    · intro k hk hkj
      rw [intervalIntegral.integral_const_mul,
        Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne k j hkj, mul_zero]
    · intro hj'
      exact absurd (Finset.mem_range.mpr (by omega : j < N + 1)) hj'
  · intro k hk
    exact (continuous_const.mul ((Polynomial.continuous (Y7Legendre.legP k)).mul
      (Polynomial.continuous (Y7Legendre.legP j)))).intervalIntegrable (-1) 1
theorem legP_eq_zero_of_forall_integral_eq_zero (N : ℕ) (q : Polynomial ℝ) (hq : q.natDegree ≤ N)
    (h : ∀ j ≤ N, (∫ x in (-1 : ℝ)..1, q.eval x * (Y7Legendre.legP j).eval x) = 0) :
    q = 0 := by
  obtain ⟨c, hc⟩ := exists_legP_expansion N q hq
  have hc0 : ∀ k ≤ N, c k = 0 := by
    intro k hk
    have hk' : c k * (2 / (2 * (k : ℝ) + 1)) = 0 := by
      have h1 := integral_mul_legP_of_expansion (N := N) (q := q) (c := c) hc hk
      rw [h k hk] at h1
      exact h1.symm
    rcases mul_eq_zero.mp hk' with h1 | h1
    · exact h1
    · exact absurd h1 (by positivity)
  rw [hc, Finset.sum_eq_zero]
  intro k hk
  rw [Finset.mem_range] at hk
  rw [hc0 k (by omega), Polynomial.C_0, zero_mul]
theorem integral_legP_mul_eq_zero_of_natDegree_lt {n : ℕ} {r : Polynomial ℝ}
    (hr : r.natDegree < n) :
    (∫ x in (-1 : ℝ)..1, (Y7Legendre.legP n).eval x * r.eval x) = 0 := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · exact absurd (hn ▸ hr) (Nat.not_lt_zero _)
  · obtain ⟨c, hc⟩ := exists_legP_expansion (n - 1) r (by omega)
    have hpt : ∀ x : ℝ, (Y7Legendre.legP n).eval x
          * (∑ k ∈ Finset.range ((n - 1) + 1), Polynomial.C (c k) * Y7Legendre.legP k).eval x
        = ∑ k ∈ Finset.range ((n - 1) + 1),
            c k * ((Y7Legendre.legP n).eval x * (Y7Legendre.legP k).eval x) := by
      intro x
      rw [Polynomial.eval_finsetSum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      rw [Polynomial.eval_mul, Polynomial.eval_C]
      ring
    rw [hc, intervalIntegral.integral_congr (fun x _ => hpt x)]
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_eq_zero
      intro k hk
      rw [Finset.mem_range] at hk
      rw [intervalIntegral.integral_const_mul,
        Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne n k (by omega), mul_zero]
    · intro k hk
      exact (continuous_const.mul ((Polynomial.continuous (Y7Legendre.legP n)).mul
        (Polynomial.continuous (Y7Legendre.legP k)))).intervalIntegrable (-1) 1
theorem coeff_legP_succ_mul (n : ℕ) :
    ((n : ℝ) + 1) * (Y7Legendre.legP (n + 1)).coeff (n + 1)
      = (2 * (n : ℝ) + 1) * (Y7Legendre.legP n).coeff n := by
  rw [Y7Legendre.coeff_legP_self, Y7Legendre.coeff_legP_self]
  have hfac : ((2 * (n + 1)).factorial : ℝ)
      = ((2 * n + 2) * (2 * n + 1) * (2 * n).factorial : ℕ) := by
    rw [show 2 * (n + 1) = 2 * n + 2 by omega, Nat.factorial_succ (2 * n + 1),
      show 2 * n + 1 + 1 = 2 * n + 2 by omega, Nat.factorial_succ (2 * n)]
    ring
  have hfacn : ((n + 1).factorial : ℝ) = ((n + 1) * n.factorial : ℕ) := by
    rw [Nat.factorial_succ]
  rw [hfac, hfacn, pow_succ]
  push_cast
  field_simp
theorem legP_three_term (n : ℕ) (hn : 1 ≤ n) :
    Polynomial.C (2 * (n : ℝ) + 1) * (Polynomial.X * Y7Legendre.legP n)
      = Polynomial.C ((n : ℝ) + 1) * Y7Legendre.legP (n + 1)
        + Polynomial.C (n : ℝ) * Y7Legendre.legP (n - 1) := by
  set q : Polynomial ℝ :=
    Polynomial.C (2 * (n : ℝ) + 1) * (Polynomial.X * Y7Legendre.legP n)
      - (Polynomial.C ((n : ℝ) + 1) * Y7Legendre.legP (n + 1)
        + Polynomial.C (n : ℝ) * Y7Legendre.legP (n - 1)) with hqdef
  have hlead : Polynomial.X.leadingCoeff * (Y7Legendre.legP n).leadingCoeff ≠ 0 := by
    rw [Polynomial.leadingCoeff_X, one_mul]
    exact Y7Legendre.leadingCoeff_legP_ne_zero n
  have hXn : (Polynomial.X * Y7Legendre.legP n).natDegree = n + 1 := by
    rw [Polynomial.natDegree_mul' hlead, Polynomial.natDegree_X, Y7Legendre.natDegree_legP]
    omega
  have hdeg : q.natDegree ≤ n := by
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro m hm
    rw [hqdef, Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_C_mul,
      Polynomial.coeff_C_mul, Polynomial.coeff_C_mul]
    rcases lt_or_eq_of_le (Nat.succ_le_of_lt hm) with hlt | heq
    · have h1 : (Polynomial.X * Y7Legendre.legP n).coeff m = 0 := by
        apply Polynomial.coeff_eq_zero_of_natDegree_lt
        rw [hXn]; exact hlt
      have h2 : (Y7Legendre.legP (n + 1)).coeff m = 0 := by
        apply Polynomial.coeff_eq_zero_of_natDegree_lt
        rw [Y7Legendre.natDegree_legP]; omega
      have h3 : (Y7Legendre.legP (n - 1)).coeff m = 0 := by
        apply Polynomial.coeff_eq_zero_of_natDegree_lt
        rw [Y7Legendre.natDegree_legP]; omega
      rw [h1, h2, h3]
      ring
    · have h3 : (Y7Legendre.legP (n - 1)).coeff (n + 1) = 0 := by
        apply Polynomial.coeff_eq_zero_of_natDegree_lt
        rw [Y7Legendre.natDegree_legP]; omega
      rw [← heq, Polynomial.coeff_X_mul, coeff_legP_succ_mul n, h3]
      ring
  have horth : ∀ j : ℕ, j + 1 < n →
      (∫ x in (-1 : ℝ)..1, q.eval x * (Y7Legendre.legP j).eval x) = 0 := by
    intro j hj
    have hlead : Polynomial.X.leadingCoeff * (Y7Legendre.legP j).leadingCoeff ≠ 0 := by
      rw [Polynomial.leadingCoeff_X, one_mul]
      exact Y7Legendre.leadingCoeff_legP_ne_zero j
    have hXj : (Polynomial.X * Y7Legendre.legP j).natDegree = j + 1 := by
      rw [Polynomial.natDegree_mul' hlead, Polynomial.natDegree_X, Y7Legendre.natDegree_legP]
      omega
    have hA : (∫ x in (-1 : ℝ)..1, (Y7Legendre.legP n).eval x
          * (Polynomial.X * Y7Legendre.legP j).eval x) = 0 :=
      integral_legP_mul_eq_zero_of_natDegree_lt (n := n)
        (r := Polynomial.X * Y7Legendre.legP j) (by rw [hXj]; exact hj)
    have hB : (∫ x in (-1 : ℝ)..1, (Y7Legendre.legP (n + 1)).eval x
          * (Y7Legendre.legP j).eval x) = 0 :=
      Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne (n + 1) j (by omega)
    have hC : (∫ x in (-1 : ℝ)..1, (Y7Legendre.legP (n - 1)).eval x
          * (Y7Legendre.legP j).eval x) = 0 :=
      Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne (n - 1) j (by omega)
    have hpt : ∀ x : ℝ, q.eval x * (Y7Legendre.legP j).eval x
        = (2 * (n : ℝ) + 1) * ((Y7Legendre.legP n).eval x
            * (Polynomial.X * Y7Legendre.legP j).eval x)
          - (((n : ℝ) + 1) * ((Y7Legendre.legP (n + 1)).eval x
              * (Y7Legendre.legP j).eval x)
            + (n : ℝ) * ((Y7Legendre.legP (n - 1)).eval x
              * (Y7Legendre.legP j).eval x)) := by
      intro x
      rw [hqdef]
      simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_X]
      ring
    have hIA : IntervalIntegrable (fun x : ℝ => (Y7Legendre.legP n).eval x
        * (Polynomial.X * Y7Legendre.legP j).eval x) volume (-1) 1 :=
      ((Polynomial.continuous _).mul (Polynomial.continuous _)).intervalIntegrable _ _
    have hIB : IntervalIntegrable (fun x : ℝ => (Y7Legendre.legP (n + 1)).eval x
        * (Y7Legendre.legP j).eval x) volume (-1) 1 :=
      ((Polynomial.continuous _).mul (Polynomial.continuous _)).intervalIntegrable _ _
    have hIC : IntervalIntegrable (fun x : ℝ => (Y7Legendre.legP (n - 1)).eval x
        * (Y7Legendre.legP j).eval x) volume (-1) 1 :=
      ((Polynomial.continuous _).mul (Polynomial.continuous _)).intervalIntegrable _ _
    rw [intervalIntegral.integral_congr (fun x _ => hpt x),
      intervalIntegral.integral_sub (hIA.const_mul _) ((hIB.const_mul _).add (hIC.const_mul _)),
      intervalIntegral.integral_add (hIB.const_mul _) (hIC.const_mul _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul, hA, hB, hC]
    ring
  obtain ⟨c, hc⟩ := exists_legP_expansion n q hdeg
  have hc0 : ∀ k, k + 2 ≤ n → c k = 0 := by
    intro k hk
    have h1 : c k * (2 / (2 * (k : ℝ) + 1)) = 0 := by
      have h2 := integral_mul_legP_of_expansion (N := n) (q := q) (c := c) (j := k) hc
        (by omega : k ≤ n)
      have hkj : k + 1 < n := by omega
      rw [horth k hkj] at h2
      exact h2.symm
    rcases mul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h (by positivity)
  have hq_ab : q = Polynomial.C (c (n - 1)) * Y7Legendre.legP (n - 1)
      + Polynomial.C (c n) * Y7Legendre.legP n := by
    rw [hc]
    have hsum : (∑ k ∈ Finset.range (n + 1),
        Polynomial.C (c k) * Y7Legendre.legP k)
        = Polynomial.C (c (n - 1)) * Y7Legendre.legP (n - 1)
          + Polynomial.C (c n) * Y7Legendre.legP n := by
      rw [show Finset.range (n + 1) = insert n (insert (n - 1) (Finset.range (n - 1))) by
        ext k
        simp only [Finset.mem_range, Finset.mem_insert]
        omega]
      rw [Finset.sum_insert (by rw [Finset.mem_insert, Finset.mem_range]; omega),
        Finset.sum_insert (by rw [Finset.mem_range]; omega),
        Finset.sum_eq_zero (by
          intro k hk
          rw [Finset.mem_range] at hk
          rw [hc0 k (by omega), Polynomial.C_0, zero_mul])]
      ring
    rw [hsum]
  have hq1 : q.eval 1 = 0 := by
    rw [hqdef]
    simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
      Polynomial.eval_C, Polynomial.eval_X]
    rw [Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP]
    ring
  have hqm1 : q.eval (-1) = 0 := by
    rw [hqdef]
    simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
      Polynomial.eval_C, Polynomial.eval_X]
    rw [Y7Legendre.eval_legP_neg, Y7Legendre.eval_legP_neg, Y7Legendre.eval_legP_neg,
      Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP]
    have hpow : (-1 : ℝ) ^ n = -(-1 : ℝ) ^ (n - 1) := by
      have h : (-1 : ℝ) ^ n = (-1 : ℝ) ^ ((n - 1) + 1) := by
        congr 1
        omega
      rw [h, pow_succ]
      ring
    have hpow2 : (-1 : ℝ) ^ (n + 1) = (-1 : ℝ) ^ (n - 1) := by
      have h : (-1 : ℝ) ^ (n + 1) = (-1 : ℝ) ^ ((n - 1) + 2) := by
        congr 1
        omega
      rw [h, pow_add]
      ring
    rw [hpow, hpow2]
    ring
  have hab1 : c (n - 1) + c n = 0 := by
    have h1 : q.eval 1 = c (n - 1) + c n := by
      rw [hq_ab]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C]
      rw [Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP]
      ring
    rw [hq1] at h1
    linarith
  have h3 : c (n - 1) = c n := by
    have h2 : q.eval (-1) = (-1 : ℝ) ^ (n - 1) * (c (n - 1) - c n) := by
      rw [hq_ab]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C]
      rw [Y7Legendre.eval_legP_neg, Y7Legendre.eval_legP_neg,
        Y7Legendre.eval_one_legP, Y7Legendre.eval_one_legP]
      rw [mul_one, mul_one]
      have hpow : (-1 : ℝ) ^ n = -(-1 : ℝ) ^ (n - 1) := by
        have h : (-1 : ℝ) ^ n = (-1 : ℝ) ^ ((n - 1) + 1) := by
          congr 1
          omega
        rw [h, pow_succ]
        ring
      rw [hpow]
      ring
    rw [hqm1] at h2
    have h2' : (-1 : ℝ) ^ (n - 1) * (c (n - 1) - c n) = 0 := h2.symm
    rcases mul_eq_zero.mp h2' with h | h
    · exact absurd h (pow_ne_zero _ (by norm_num))
    · exact sub_eq_zero.mp h
  have hcn : c n = 0 := by linarith
  have hcnm1 : c (n - 1) = 0 := by linarith
  have hq_zero : q = 0 := by
    rw [hq_ab, hcn, hcnm1]
    simp
  have hzero' : Polynomial.C (2 * (n : ℝ) + 1) * (Polynomial.X * Y7Legendre.legP n)
      - (Polynomial.C ((n : ℝ) + 1) * Y7Legendre.legP (n + 1)
        + Polynomial.C (n : ℝ) * Y7Legendre.legP (n - 1)) = 0 := by
    simpa [hqdef] using hq_zero
  exact sub_eq_zero.mp hzero'
theorem archH_one {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archH (fun _ : ℝ => (1 : ℝ)) x = 2 * x := by
  rw [archH_eq_of_continuous _ continuous_const hx]
  rw [intervalIntegral.integral_const, intervalIntegral.integral_const]
  ring
theorem archL_legP_zero (x : ℝ) :
    archL (fun y => (Y7Legendre.legP 0).eval y) x = 0 := by
  unfold archL
  simp [Y7Legendre.legP_zero]
theorem archL_legP_one {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archL (fun y => (Y7Legendre.legP 1).eval y) x = 2 * x := by
  have hpt : (fun y : ℝ =>
        ((Y7Legendre.legP 1).eval x - (Y7Legendre.legP 1).eval y) / ‖x - y‖)
      = fun y : ℝ => (x - y) / ‖x - y‖ * (1 : ℝ) := by
    funext y
    rw [Y7Deriv.legP_one]
    simp only [Polynomial.eval_X]
    ring
  rw [show archL (fun y => (Y7Legendre.legP 1).eval y) x
      = ∫ y in Set.Ioo (-1 : ℝ) 1, (x - y) / ‖x - y‖ * (1 : ℝ) from by
    unfold archL
    rw [hpt]]
  exact archH_one hx
private lemma archL_legP_arith (k : ℕ) {A B C D x P0 P1 P2 : ℝ}
    (hL : ((k : ℝ) + 2) * A + ((k : ℝ) + 1) * B
      = (2 * (k : ℝ) + 3) * (x * C) + (2 * (k : ℝ) + 3) * D)
    (hC : C = 2 * harmonicR (k + 1) * P1)
    (hB : B = 2 * harmonicR k * P0)
    (hD : (2 * (k : ℝ) + 3) * D = 2 * (P2 - P0))
    (hrec : (2 * (k : ℝ) + 3) * (x * P1) = ((k : ℝ) + 2) * P2 + ((k : ℝ) + 1) * P0)
    (hH1 : harmonicR (k + 1) = harmonicR k + 1 / ((k : ℝ) + 1))
    (hH2 : harmonicR (k + 2) = harmonicR (k + 1) + 1 / ((k : ℝ) + 2)) :
    A = 2 * harmonicR (k + 2) * P2 := by
  have hk2 : ((k : ℝ) + 2) ≠ 0 := by positivity
  subst hC hB
  have hxC : (2 * (k : ℝ) + 3) * (x * (2 * harmonicR (k + 1) * P1))
      = 2 * harmonicR (k + 1) * (((k : ℝ) + 2) * P2 + ((k : ℝ) + 1) * P0) := by
    linear_combination (2 * harmonicR (k + 1)) * hrec
  rw [hxC, hD] at hL
  have hH1' : ((k : ℝ) + 1) * harmonicR (k + 1) = ((k : ℝ) + 1) * harmonicR k + 1 := by
    rw [hH1, mul_add, mul_one_div_cancel (by positivity)]
  have hH2' : ((k : ℝ) + 2) * harmonicR (k + 2) = ((k : ℝ) + 2) * harmonicR (k + 1) + 1 := by
    rw [hH2, mul_add, mul_one_div_cancel (by positivity)]
  have hgoal : ((k : ℝ) + 2) * A = 2 * (((k : ℝ) + 2) * harmonicR (k + 2)) * P2 := by
    rw [hH2']
    linear_combination hL + (2 * P0) * hH1'
  have hgoal' : ((k : ℝ) + 2) * A = ((k : ℝ) + 2) * (2 * harmonicR (k + 2) * P2) := by
    rw [hgoal]
    ring
  exact mul_left_cancel₀ hk2 hgoal'
theorem archL_legP (n : ℕ) :
    ∀ x : ℝ, x ∈ Set.Ioo (-1 : ℝ) 1 →
      archL (fun y => (Y7Legendre.legP n).eval y) x
        = 2 * Y7Matrix.harmonicR n * (Y7Legendre.legP n).eval x := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | _ | k
    · intro x _
      rw [Y7Legendre.legP_zero, Y7Matrix.harmonicR_zero]
      simp [archL]
    · intro x hx
      have h1 : Y7Matrix.harmonicR 1 = 1 := by
        rw [show (1 : ℕ) = 0 + 1 from rfl, Y7Matrix.harmonicR_succ, Y7Matrix.harmonicR_zero]
        norm_num
      rw [archL_legP_one hx, h1, Y7Deriv.legP_one]
      simp only [Polynomial.eval_X]
      ring
    · intro x hx
      set A : ℝ := archL (fun y => (Y7Legendre.legP (k + 2)).eval y) x with hAdef
      set B : ℝ := archL (fun y => (Y7Legendre.legP k).eval y) x with hBdef
      set C : ℝ := archL (fun y => (Y7Legendre.legP (k + 1)).eval y) x with hCdef
      set D : ℝ := archH (fun y => (Y7Legendre.legP (k + 1)).eval y) x with hDdef
      have ihC : C = 2 * harmonicR (k + 1) * (Y7Legendre.legP (k + 1)).eval x :=
        ih (k + 1) (by omega) x hx
      have ihB : B = 2 * harmonicR k * (Y7Legendre.legP k).eval x :=
        ih k (by omega) x hx
      have hrecx : (2 * (k : ℝ) + 3) * (x * (Y7Legendre.legP (k + 1)).eval x)
          = ((k : ℝ) + 2) * (Y7Legendre.legP (k + 2)).eval x
            + ((k : ℝ) + 1) * (Y7Legendre.legP k).eval x := by
        have h := congrArg (Polynomial.eval x) (legP_three_term (k + 1) (by omega))
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
          Polynomial.eval_add] at h
        push_cast at h
        ring_nf at h ⊢
        exact h
      have hrecfun : (fun y : ℝ => y * (Y7Legendre.legP (k + 1)).eval y)
          = fun y : ℝ => (((k : ℝ) + 2) / (2 * (k : ℝ) + 3))
                * (Y7Legendre.legP (k + 2)).eval y
              + (((k : ℝ) + 1) / (2 * (k : ℝ) + 3))
                * (Y7Legendre.legP k).eval y := by
        funext y
        have h := congrArg (Polynomial.eval y) (legP_three_term (k + 1) (by omega))
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
          Polynomial.eval_add] at h
        push_cast at h
        field_simp
        linear_combination h
      have hLmul : archL (fun y => y * (Y7Legendre.legP (k + 1)).eval y) x
          = ((k : ℝ) + 2) / (2 * (k : ℝ) + 3) * A
            + ((k : ℝ) + 1) / (2 * (k : ℝ) + 3) * B := by
        rw [hrecfun, Y7Arch.archL_add_smul (k + 2) k
          (((k : ℝ) + 2) / (2 * (k : ℝ) + 3))
          (((k : ℝ) + 1) / (2 * (k : ℝ) + 3)) hx,
          ← hAdef, ← hBdef]
      have hsplit : archL (fun y => y * (Y7Legendre.legP (k + 1)).eval y) x
          = x * C + D := by
        rw [hCdef, hDdef]
        exact Y7Arch.archL_mul_X_legP (k + 1) hx
      have hD := archH_legP (k + 1) (by omega) hx
      have hDc : (2 * (k : ℝ) + 3) * D
          = 2 * ((Y7Legendre.legP (k + 2)).eval x - (Y7Legendre.legP k).eval x) := by
        rw [hDdef, hD]
        push_cast
        field_simp
        ring
      have hH1 : harmonicR (k + 1) = harmonicR k + 1 / ((k : ℝ) + 1) := by
        simpa using Y7Matrix.harmonicR_succ k
      have hH2 : harmonicR (k + 2) = harmonicR (k + 1) + 1 / ((k : ℝ) + 2) := by
        have h := Y7Matrix.harmonicR_succ (k + 1)
        push_cast at h
        rw [show (↑k + 1 + 1 : ℝ) = (k : ℝ) + 2 by ring] at h
        exact h
      have hL : ((k : ℝ) + 2) * A + ((k : ℝ) + 1) * B
          = (2 * (k : ℝ) + 3) * (x * C) + (2 * (k : ℝ) + 3) * D := by
        have h := hLmul.symm.trans hsplit
        field_simp at h
        linear_combination h
      have hA := archL_legP_arith k hL ihC ihB hDc hrecx hH1 hH2
      rw [show k + 1 + 1 = k + 2 by omega]
      simpa [hAdef] using hA
private noncomputable def archQuot (p : Polynomial ℝ) (x y : ℝ) : ℝ :=
  (p.eval x - p.eval y) / ‖x - y‖
private lemma eval_sub_le_of_deriv_bound (p : Polynomial ℝ) {C : ℝ}
    (hC : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖(Polynomial.derivative p).eval x‖ ≤ C)
    {x y : ℝ} (hx : x ∈ Set.Icc (-1 : ℝ) 1) (hy : y ∈ Set.Icc (-1 : ℝ) 1) :
    ‖p.eval x - p.eval y‖ ≤ C * ‖x - y‖ := by
  have hdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
      DifferentiableAt ℝ (fun t : ℝ => p.eval t) z :=
    fun z _ => Polynomial.differentiableAt p
  have hbound : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
      ‖deriv (fun t : ℝ => p.eval t) z‖ ≤ C := by
    intro z hz
    rw [Polynomial.deriv]
    exact hC z hz
  have h := Convex.norm_image_sub_le_of_norm_deriv_le hdiff hbound
    (convex_Icc (-1 : ℝ) 1) hx hy
  simpa only [Real.norm_eq_abs, abs_sub_comm] using h
private lemma archQuot_norm_le (p : Polynomial ℝ) {C : ℝ}
    (hC : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖(Polynomial.derivative p).eval x‖ ≤ C)
    {x y : ℝ} (hx : x ∈ Set.Icc (-1 : ℝ) 1) (hy : y ∈ Set.Icc (-1 : ℝ) 1) :
    ‖archQuot p x y‖ ≤ C := by
  rcases eq_or_ne x y with rfl | hne
  · rw [archQuot, sub_self, zero_div, norm_zero]
    exact le_trans (norm_nonneg _) (hC x hx)
  · have hpos : 0 < ‖x - y‖ := by
      rw [norm_pos_iff]
      exact sub_ne_zero.mpr hne
    rw [archQuot, norm_div, Real.norm_of_nonneg (norm_nonneg _), div_le_iff₀ hpos]
    exact eval_sub_le_of_deriv_bound p hC hx hy
private lemma integrable_of_bounded_prod {f : ℝ × ℝ → ℝ} {C : ℝ}
    (hm : AEStronglyMeasurable f ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))))
    (hb : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ∀ y ∈ Set.Ioo (-1 : ℝ) 1, ‖f (x, y)‖ ≤ C) :
    Integrable f ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  have hfin : volume (Set.Ioo (-1 : ℝ) 1) ≠ ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_ne_top
  haveI : Fact (volume (Set.Ioo (-1 : ℝ) 1) < ⊤) := ⟨lt_top_iff_ne_top.mpr hfin⟩
  refine Integrable.of_bound hm C ?_
  rw [Measure.prod_restrict]
  filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
  exact hb z.1 hz.1 z.2 hz.2
private lemma integrable_arch_pair (m n : ℕ) :
    Integrable (fun z : ℝ × ℝ =>
      ((Y7Legendre.legP m).eval z.1 - (Y7Legendre.legP m).eval z.2)
        * ((Y7Legendre.legP n).eval z.1 - (Y7Legendre.legP n).eval z.2) / ‖z.1 - z.2‖)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  obtain ⟨Cm, hCm⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.legP m))).continuousOn
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.legP n))).continuousOn
  have hCm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hCm 0 ⟨by norm_num, by norm_num⟩)
  have hCn0 : 0 ≤ Cn := le_trans (norm_nonneg _) (hCn 0 ⟨by norm_num, by norm_num⟩)
  refine integrable_of_bounded_prod (C := 2 * Cm * Cn) ?_ ?_
  · have hm1 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP m).eval z.1) :=
      (Polynomial.continuous _).measurable.comp measurable_fst
    have hm2 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP m).eval z.2) :=
      (Polynomial.continuous _).measurable.comp measurable_snd
    have hn1 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP n).eval z.1) :=
      (Polynomial.continuous _).measurable.comp measurable_fst
    have hn2 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP n).eval z.2) :=
      (Polynomial.continuous _).measurable.comp measurable_snd
    exact ((((hm1.sub hm2).mul (hn1.sub hn2)).div
      ((measurable_fst.sub measurable_snd).norm))).aestronglyMeasurable
  · intro x hx y hy
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hy' : y ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hq : ‖archQuot (Y7Legendre.legP m) x y‖ ≤ Cm :=
      archQuot_norm_le _ hCm hx' hy'
    have hl : ‖(Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y‖
        ≤ Cn * ‖x - y‖ :=
      eval_sub_le_of_deriv_bound _ hCn hx' hy'
    have hdist : ‖x - y‖ ≤ 2 := by
      rw [Real.norm_eq_abs]
      exact abs_sub_le_iff.mpr ⟨by linarith [hy.1, hx.2], by linarith [hx.1, hy.2]⟩
    have hre : ((Y7Legendre.legP m).eval x - (Y7Legendre.legP m).eval y)
          * ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖
        = archQuot (Y7Legendre.legP m) x y
          * ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) := by
      rw [archQuot]
      ring
    rw [hre, norm_mul]
    calc ‖archQuot (Y7Legendre.legP m) x y‖
          * ‖(Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y‖
        ≤ Cm * (Cn * ‖x - y‖) := mul_le_mul hq hl (norm_nonneg _) hCm0
      _ ≤ Cm * (Cn * 2) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hdist hCn0) hCm0
      _ = 2 * Cm * Cn := by ring
private lemma integrable_arch_left (m n : ℕ) :
    Integrable (fun z : ℝ × ℝ =>
      (Y7Legendre.legP m).eval z.1
        * (((Y7Legendre.legP n).eval z.1 - (Y7Legendre.legP n).eval z.2) / ‖z.1 - z.2‖))
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  obtain ⟨Bm, hBm⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Y7Legendre.legP m)).continuousOn
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.legP n))).continuousOn
  have hBm0 : 0 ≤ Bm := le_trans (norm_nonneg _) (hBm 0 ⟨by norm_num, by norm_num⟩)
  refine integrable_of_bounded_prod (C := Bm * Cn) ?_ ?_
  · have hm1 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP m).eval z.1) :=
      (Polynomial.continuous _).measurable.comp measurable_fst
    have hn1 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP n).eval z.1) :=
      (Polynomial.continuous _).measurable.comp measurable_fst
    have hn2 : Measurable (fun z : ℝ × ℝ => (Y7Legendre.legP n).eval z.2) :=
      (Polynomial.continuous _).measurable.comp measurable_snd
    exact (hm1.mul ((hn1.sub hn2).div
      ((measurable_fst.sub measurable_snd).norm))).aestronglyMeasurable
  · intro x hx y hy
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hy' : y ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hm : ‖(Y7Legendre.legP m).eval x‖ ≤ Bm := hBm x hx'
    have hq : ‖archQuot (Y7Legendre.legP n) x y‖ ≤ Cn :=
      archQuot_norm_le _ hCn hx' hy'
    have hre : (Y7Legendre.legP m).eval x
          * (((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖)
        = (Y7Legendre.legP m).eval x * archQuot (Y7Legendre.legP n) x y := by
      rw [archQuot]
    rw [hre, norm_mul]
    exact mul_le_mul hm hq (norm_nonneg _) hBm0
theorem archDoubleIntegral_eq (m n : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
        ((Y7Legendre.legP m).eval x - (Y7Legendre.legP m).eval y)
          * ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖)
      = 2 * (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.legP m).eval x
            * archL (fun y => (Y7Legendre.legP n).eval y) x) := by
  set F : ℝ × ℝ → ℝ := fun z =>
      ((Y7Legendre.legP m).eval z.1 - (Y7Legendre.legP m).eval z.2)
        * ((Y7Legendre.legP n).eval z.1 - (Y7Legendre.legP n).eval z.2) / ‖z.1 - z.2‖
    with hF
  set G : ℝ × ℝ → ℝ := fun z =>
      (Y7Legendre.legP m).eval z.1
        * (((Y7Legendre.legP n).eval z.1 - (Y7Legendre.legP n).eval z.2) / ‖z.1 - z.2‖)
    with hG
  have hFint : Integrable F ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
    rw [hF]
    exact integrable_arch_pair m n
  have hGint : Integrable G ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
    rw [hG]
    exact integrable_arch_left m n
  have hGswap : Integrable (fun z : ℝ × ℝ => G z.swap)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := hGint.swap
  have hFG : ∀ z : ℝ × ℝ, F z = G z + G z.swap := by
    rintro ⟨x, y⟩
    simp only [hF, hG, Prod.swap_prod_mk]
    rw [norm_sub_rev y x]
    ring
  have hprodF : ∫ z, F z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
      = ∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F (x, y) :=
    MeasureTheory.integral_prod F hFint
  have hprodG : ∫ z, G z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
      = ∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, G (x, y) :=
    MeasureTheory.integral_prod G hGint
  have key : ∫ z, F z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
      = 2 * (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.legP m).eval x
            * archL (fun y => (Y7Legendre.legP n).eval y) x) := by
    calc ∫ z, F z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
            (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
        = ∫ z, (G z + G z.swap) ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
            (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
          apply MeasureTheory.integral_congr_ae
          filter_upwards with z
          exact hFG z
      _ = ∫ z, G z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
              (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
            + ∫ z, G z.swap ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
              (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :=
          MeasureTheory.integral_add hGint hGswap
      _ = ∫ z, G z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
              (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
            + ∫ z, G z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
              (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
          rw [MeasureTheory.integral_prod_swap G]
      _ = 2 * ∫ z, G z ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
              (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by ring
      _ = 2 * (∫ x in Set.Ioo (-1 : ℝ) 1,
            (Y7Legendre.legP m).eval x
              * archL (fun y => (Y7Legendre.legP n).eval y) x) := by
          rw [hprodG]
          congr 1
          apply MeasureTheory.integral_congr_ae
          filter_upwards with x
          have hinner : (∫ y in Set.Ioo (-1 : ℝ) 1, G (x, y))
              = (Y7Legendre.legP m).eval x
                * (∫ y in Set.Ioo (-1 : ℝ) 1,
                    ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y)
                      / ‖x - y‖) := by
            rw [hG]
            show (∫ y in Set.Ioo (-1 : ℝ) 1,
                  (Y7Legendre.legP m).eval x
                    * (((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y)
                      / ‖x - y‖))
                = (Y7Legendre.legP m).eval x
                  * (∫ y in Set.Ioo (-1 : ℝ) 1,
                      ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y)
                        / ‖x - y‖)
            rw [MeasureTheory.integral_const_mul]
          rw [hinner]
          rfl
  rw [← key, ← hprodF]
theorem archKernelMatrix_eq_factors (m n : ℕ) :
    archKernelMatrix m n
      = (1 / 4) * Real.sqrt ((2 * (m : ℝ) + 1) / 2)
          * Real.sqrt ((2 * (n : ℝ) + 1) / 2)
          * (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
              ((Y7Legendre.legP m).eval x - (Y7Legendre.legP m).eval y)
                * ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y)
                / ‖x - y‖) := by
  unfold archKernelMatrix
  simp only [Y7Legendre.phi, Polynomial.eval_mul, Polynomial.eval_C]
  rw [show (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
        (Real.sqrt ((2 * (m : ℝ) + 1) / 2) * (Y7Legendre.legP m).eval x
            - Real.sqrt ((2 * (m : ℝ) + 1) / 2) * (Y7Legendre.legP m).eval y)
          * (Real.sqrt ((2 * (n : ℝ) + 1) / 2) * (Y7Legendre.legP n).eval x
            - Real.sqrt ((2 * (n : ℝ) + 1) / 2) * (Y7Legendre.legP n).eval y)
          / ‖x - y‖)
      = ∫ x in Set.Ioo (-1 : ℝ) 1,
          Real.sqrt ((2 * (m : ℝ) + 1) / 2) * Real.sqrt ((2 * (n : ℝ) + 1) / 2)
            * (∫ y in Set.Ioo (-1 : ℝ) 1,
                ((Y7Legendre.legP m).eval x - (Y7Legendre.legP m).eval y)
                  * ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y)
                  / ‖x - y‖) from by
    apply MeasureTheory.integral_congr_ae
    filter_upwards with x
    rw [← MeasureTheory.integral_const_mul]
    apply MeasureTheory.integral_congr_ae
    filter_upwards with y
    ring]
  rw [MeasureTheory.integral_const_mul]
  ring
theorem archKernelMatrix_eq_ite (m n : ℕ) :
    archKernelMatrix m n = if m = n then Y7Matrix.harmonicR m else 0 := by
  have hint : (∫ x in (-1 : ℝ)..1,
        (Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval x)
      = if m = n then 2 / (2 * (n : ℝ) + 1) else 0 := by
    by_cases h : m = n
    · subst h
      rw [Y7Rodrigues.integral_legP_sq, if_pos rfl]
    · rw [if_neg h]
      exact Y7Rodrigues.integral_legP_mul_legP_eq_zero_of_ne m n h
  have hL : (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.legP m).eval x * archL (fun y => (Y7Legendre.legP n).eval y) x)
      = 2 * Y7Matrix.harmonicR n
          * (if m = n then 2 / (2 * (n : ℝ) + 1) else 0) := by
    rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.legP m).eval x * archL (fun y => (Y7Legendre.legP n).eval y) x)
        = ∫ x in Set.Ioo (-1 : ℝ) 1,
            (Y7Legendre.legP m).eval x
              * (2 * Y7Matrix.harmonicR n * (Y7Legendre.legP n).eval x) from by
      apply MeasureTheory.integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      rw [archL_legP n x hx]]
    rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.legP m).eval x
            * (2 * Y7Matrix.harmonicR n * (Y7Legendre.legP n).eval x))
        = 2 * Y7Matrix.harmonicR n
            * (∫ x in Set.Ioo (-1 : ℝ) 1,
                (Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval x) from by
      rw [← MeasureTheory.integral_const_mul]
      apply MeasureTheory.integral_congr_ae
      filter_upwards with x
      ring]
    rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval x)
        = ∫ x in (-1 : ℝ)..1,
            (Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval x from by
      rw [intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1),
        integral_Ioc_eq_integral_Ioo]]
    rw [hint]
  rw [archKernelMatrix_eq_factors m n, archDoubleIntegral_eq m n, hL]
  by_cases h : m = n
  · subst h
    rw [if_pos rfl, if_pos rfl]
    have hden : (2 * (m : ℝ) + 1) ≠ 0 := by positivity
    have hrewrite : (1 / 4) * Real.sqrt ((2 * (m : ℝ) + 1) / 2)
          * Real.sqrt ((2 * (m : ℝ) + 1) / 2)
          * (2 * (2 * harmonicR m * (2 / (2 * (m : ℝ) + 1))))
        = (Real.sqrt ((2 * (m : ℝ) + 1) / 2)) ^ 2
          * (harmonicR m * (2 / (2 * (m : ℝ) + 1))) := by
      ring
    rw [hrewrite, Real.sq_sqrt (by positivity)]
    field_simp
  · rw [if_neg h, if_neg h]
    ring
theorem archDiagonalRep : Y7Op.ArchDiagonalRep :=
  archDiagonalRep_of_archKernelMatrix archKernelMatrix_eq_ite
theorem formMatrixRep_seven : Y7Op.FormMatrixRep 7 :=
  Y7Op.formMatrixRep_of_parts 7 archDiagonalRep (Y7Op.gammaRep 7 (by norm_num))
