section Inline_Y7_Rescale
noncomputable section
open MeasureTheory
open scoped BigOperators
namespace Y7Rescale
noncomputable def rescaleFun (a : ℝ) (f : ℝ → ℂ) : ℝ → ℂ :=
  fun x => (Real.sqrt a : ℂ) * f (a * x)
theorem integral_Ioo_comp_mul {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (a : ℝ) (ha : 0 < a) (F : ℝ → E) :
    (∫ x in Set.Ioo (-a) a, F x) = a • ∫ u in Set.Ioo (-1 : ℝ) 1, F (a * u) := by
  have h1 : (∫ x in Set.Ioo (-a) a, F x) = ∫ x in (-a)..a, F x := by
    rw [intervalIntegral.integral_of_le (by linarith : -a ≤ a),
      integral_Ioc_eq_integral_Ioo]
  have h2 : (∫ u in Set.Ioo (-1 : ℝ) 1, F (a * u)) = ∫ u in (-1 : ℝ)..1, F (a * u) := by
    rw [intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1),
      integral_Ioc_eq_integral_Ioo]
  rw [h1, h2, intervalIntegral.integral_comp_mul_left F ha.ne']
  simp only [mul_neg, mul_one]
  rw [smul_smul, mul_inv_cancel₀ ha.ne', one_smul]
theorem integral_Ioo_integral_Ioo_comp_mul {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (a : ℝ) (ha : 0 < a) (Φ : ℝ → ℝ → E) :
    (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a, Φ x y)
      = a • (a • ∫ u in Set.Ioo (-1 : ℝ) 1,
          ∫ v in Set.Ioo (-1 : ℝ) 1, Φ (a * u) (a * v)) := by
  rw [integral_Ioo_comp_mul a ha (fun x => ∫ y in Set.Ioo (-a) a, Φ x y)]
  congr 1
  rw [← MeasureTheory.integral_smul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with u
  exact integral_Ioo_comp_mul a ha (fun y => Φ (a * u) y)
theorem rescaleFun_mem_localizedCore {a : ℝ} (ha : 0 < a) {f : ℝ → ℂ}
    (hf : f ∈ RHLean.localizedCore a) : rescaleFun a f ∈ RHLean.localizedCore 1 := by
  obtain ⟨⟨hcd, -, hodd⟩, hsupp⟩ := hf
  have hsqrt_ne : (Real.sqrt a : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.2 ha).ne'
  have hcore : ∀ x : ℝ, rescaleFun a f x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1 := by
    intro x hx
    have hfx : f (a * x) ≠ 0 := fun h0 => hx (by simp only [rescaleFun, h0, mul_zero])
    have hmem := hsupp hfx
    refine ⟨?_, ?_⟩
    · have hdiv : (a * x) / a = x := by field_simp
      rw [← hdiv]
      rw [lt_div_iff₀ ha]
      linarith [hmem.1]
    · have hdiv : (a * x) / a = x := by field_simp
      rw [← hdiv]
      rw [div_lt_iff₀ ha]
      linarith [hmem.2]
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · exact contDiff_const.mul (hcd.comp (contDiff_const.mul contDiff_id))
  · refine HasCompactSupport.of_support_subset_isCompact
      (isCompact_Icc (a := (-1 : ℝ)) (b := 1)) ?_
    intro x hx
    have := hcore x hx
    exact ⟨le_of_lt this.1, le_of_lt this.2⟩
  · intro x
    simp only [rescaleFun]
    rw [show a * (-x) = -(a * x) by ring, hodd]
    ring
  · intro x hx
    exact hcore x hx
theorem rescaleFun_mul_star (a : ℝ) (ha : 0 ≤ a) (f : ℝ → ℂ) (x y : ℝ) :
    rescaleFun a f x * star (rescaleFun a f y)
      = ((a : ℝ) : ℂ) * (f (a * x) * star (f (a * y))) := by
  simp only [rescaleFun, star_mul]
  have hs : (Real.sqrt a : ℂ) * star (Real.sqrt a : ℂ) = ((a : ℝ) : ℂ) := by
    rw [show star (Real.sqrt a : ℂ) = (Real.sqrt a : ℂ) from Complex.conj_ofReal _,
      ← Complex.ofReal_mul, Real.mul_self_sqrt ha]
  calc (Real.sqrt a : ℂ) * f (a * x) * (star (f (a * y)) * star (Real.sqrt a : ℂ))
      = ((Real.sqrt a : ℂ) * star (Real.sqrt a : ℂ))
          * (f (a * x) * star (f (a * y))) := by ring
    _ = ((a : ℝ) : ℂ) * (f (a * x) * star (f (a * y))) := by rw [hs]
lemma norm_rescaleFun_sq (a : ℝ) (ha : 0 < a) (f : ℝ → ℂ) (x : ℝ) :
    ‖rescaleFun a f x‖ ^ 2 = a * ‖f (a * x)‖ ^ 2 := by
  have hs : ‖(Real.sqrt a : ℂ)‖ ^ 2 = a := by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_ofReal, Real.mul_self_sqrt ha.le]
  simp only [rescaleFun, norm_mul, mul_pow]
  rw [hs]
theorem mass_rescale {a : ℝ} (ha : 0 < a) (f : ℝ → ℂ) :
    (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
      = ∫ x in Set.Ioo (-1 : ℝ) 1, ‖rescaleFun a f x‖ ^ 2 := by
  rw [integral_Ioo_comp_mul a ha (fun x => (‖f x‖ ^ 2 : ℝ)), smul_eq_mul,
    ← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with u
  rw [norm_rescaleFun_sq a ha f u]
theorem potentialForm_rescale {a : ℝ} (ha : 0 < a) {f : ℝ → ℂ}
    (hf : f ∈ RHLean.localizedCore a) :
    RHLean.potentialForm a f
      = RHLean.potentialFormRescaled (rescaleFun a f)
        - Real.log a * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖rescaleFun a f x‖ ^ 2) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hg_cont : Continuous (rescaleFun a f) :=
    continuous_const.mul (hcd.continuous.comp (continuous_const.mul continuous_id))
  have hVint : IntegrableOn
      (fun u : ℝ => RHLean.rescaledPotential u * ‖rescaleFun a f u‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    have h := (Y7Matrix.intervalIntegrable_rescaledPotential_mul_pow 0).continuousOn_mul
      (hg_cont.continuousOn.norm.pow 2)
    have h2 : (fun x : ℝ => ((fun x => ‖rescaleFun a f x‖) ^ 2) x
        * (RHLean.rescaledPotential x * x ^ 0))
        = fun x : ℝ => RHLean.rescaledPotential x * ‖rescaleFun a f x‖ ^ 2 := by
      funext x
      simp only [pow_two, Pi.mul_apply, pow_zero, mul_one]
      ring
    rw [h2] at h
    exact h.1.mono_set Set.Ioo_subset_Ioc_self
  have hlogint : IntegrableOn
      (fun u : ℝ => Real.log a * ‖rescaleFun a f u‖ ^ 2) (Set.Ioo (-1 : ℝ) 1) :=
    (((hg_cont.norm.pow 2).const_mul (Real.log a)).intervalIntegrable (-1) 1).1.mono_set
      Set.Ioo_subset_Ioc_self
  unfold RHLean.potentialForm RHLean.potentialFormRescaled
  rw [integral_Ioo_comp_mul a ha (fun x => RHLean.endpointPotential a x * ‖f x‖ ^ 2),
    smul_eq_mul, ← MeasureTheory.integral_const_mul]
  rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_sub hVint hlogint]
  apply MeasureTheory.integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioo] with u hu
  have hu2 : u ^ 2 < 1 := by
    have h1 := hu.1; have h2 := hu.2; nlinarith
  rw [RHLean.endpointPotential_scale a u ha hu2, norm_rescaleFun_sq a ha f u]
  ring
theorem archForm_rescale {a : ℝ} (ha : 0 < a) (f : ℝ → ℂ) :
    RHLean.archForm a f = RHLean.archFormRescaled (rescaleFun a f) := by
  have hpt : ∀ u v : ℝ, a * (a *
        (‖f (a * u) - f (a * v)‖ ^ 2 / ‖a * u - a * v‖))
      = ‖rescaleFun a f u - rescaleFun a f v‖ ^ 2 / ‖u - v‖ := by
    intro u v
    have hnum : ‖rescaleFun a f u - rescaleFun a f v‖ ^ 2
        = a * ‖f (a * u) - f (a * v)‖ ^ 2 := by
      have hdiff : rescaleFun a f u - rescaleFun a f v
          = (Real.sqrt a : ℂ) * (f (a * u) - f (a * v)) := by
        simp only [rescaleFun]
        rw [← mul_sub]
      rw [hdiff]
      simp only [norm_mul, mul_pow]
      rw [show ‖(Real.sqrt a : ℂ)‖ ^ 2 = a by
        rw [← Complex.normSq_eq_norm_sq, Complex.normSq_ofReal, Real.mul_self_sqrt ha.le]]
    have hden : ‖a * u - a * v‖ = a * ‖u - v‖ := by
      rw [show a * u - a * v = a * (u - v) by ring, norm_mul,
        Real.norm_of_nonneg ha.le]
    rw [hden, hnum]
    by_cases huv : u = v
    · subst huv; simp
    · have hnorm_ne : ‖u - v‖ ≠ 0 := by
        rw [norm_ne_zero_iff]; exact sub_ne_zero.mpr huv
      field_simp
  unfold RHLean.archForm RHLean.archFormRescaled
  rw [integral_Ioo_integral_Ioo_comp_mul a ha
    (fun x y => ‖f x - f y‖ ^ 2 / ‖x - y‖)]
  rw [smul_eq_mul, smul_eq_mul]
  have hfold : a * (a * ∫ u in Set.Ioo (-1 : ℝ) 1,
        ∫ v in Set.Ioo (-1 : ℝ) 1,
          ‖f (a * u) - f (a * v)‖ ^ 2 / ‖a * u - a * v‖)
      = ∫ u in Set.Ioo (-1 : ℝ) 1, ∫ v in Set.Ioo (-1 : ℝ) 1,
          a * (a * (‖f (a * u) - f (a * v)‖ ^ 2 / ‖a * u - a * v‖)) := by
    rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_const_mul]
    apply MeasureTheory.integral_congr_ae
    filter_upwards with u
    rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_const_mul]
  rw [hfold]
  congr 1
  apply MeasureTheory.integral_congr_ae
  filter_upwards with u
  apply MeasureTheory.integral_congr_ae
  filter_upwards with v
  exact hpt u v
theorem gammaForm_rescale {a : ℝ} (ha : 0 < a) (f : ℝ → ℂ) :
    RHLean.gammaForm a f = RHLean.gammaFormRescaled a (rescaleFun a f) := by
  have hpt : ∀ u v : ℝ, a * (a * (RHLean.gammaKernel ‖a * u - a * v‖
        * (f (a * u) * star (f (a * v))).re))
      = RHLean.gammaKernelRescaled a ‖u - v‖
        * (rescaleFun a f u * star (rescaleFun a f v)).re := by
    intro u v
    have hden : ‖a * u - a * v‖ = a * ‖u - v‖ := by
      rw [show a * u - a * v = a * (u - v) by ring, norm_mul,
        Real.norm_of_nonneg ha.le]
    rw [hden, rescaleFun_mul_star a ha.le f u v, Complex.re_ofReal_mul]
    unfold RHLean.gammaKernelRescaled
    ring
  unfold RHLean.gammaForm RHLean.gammaFormRescaled
  rw [integral_Ioo_integral_Ioo_comp_mul a ha
    (fun x y => RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)]
  rw [smul_eq_mul, smul_eq_mul]
  have hfold : a * (a * ∫ u in Set.Ioo (-1 : ℝ) 1, ∫ v in Set.Ioo (-1 : ℝ) 1,
        RHLean.gammaKernel ‖a * u - a * v‖ * (f (a * u) * star (f (a * v))).re)
      = ∫ u in Set.Ioo (-1 : ℝ) 1, ∫ v in Set.Ioo (-1 : ℝ) 1,
          a * (a * (RHLean.gammaKernel ‖a * u - a * v‖
            * (f (a * u) * star (f (a * v))).re)) := by
    rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_const_mul]
    apply MeasureTheory.integral_congr_ae
    filter_upwards with u
    rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_const_mul]
  rw [hfold]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with u
  apply MeasureTheory.integral_congr_ae
  filter_upwards with v
  exact hpt u v
theorem polarInner_rescale {a : ℝ} (ha : 0 < a) (f : ℝ → ℂ) :
    RHLean.polarInner a f
      = (Real.sqrt a : ℂ) * RHLean.polarInnerRescaled a (rescaleFun a f) := by
  have hs : (Real.sqrt a : ℂ) * (Real.sqrt a : ℂ) = ((a : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt ha.le]
  have hpt : ∀ u : ℝ, a • (star (RHLean.sph (a * u)) * f (a * u))
      = ((Real.sqrt a : ℂ)) * (star (RHLean.sRescaled a u) * rescaleFun a f u) := by
    intro u
    have h1 : star (RHLean.sph (a * u)) = star (RHLean.sRescaled a u) := by
      rw [RHLean.sph_scale]
    rw [h1]
    have h2 : a • (star (RHLean.sRescaled a u) * f (a * u))
        = ((Real.sqrt a : ℂ) * (Real.sqrt a : ℂ))
            * (star (RHLean.sRescaled a u) * f (a * u)) := by
      rw [Complex.real_smul, hs]
    rw [h2]
    simp only [rescaleFun]
    ring
  unfold RHLean.polarInner RHLean.polarInnerRescaled
  rw [integral_Ioo_comp_mul a ha (fun y => star (RHLean.sph y) * f y),
    ← MeasureTheory.integral_smul]
  rw [show (Real.sqrt a : ℂ) * (∫ x in Set.Ioo (-1 : ℝ) 1,
        star (RHLean.sRescaled a x) * rescaleFun a f x)
      = (Real.sqrt a : ℂ) • ∫ x in Set.Ioo (-1 : ℝ) 1,
        star (RHLean.sRescaled a x) * rescaleFun a f x from rfl]
  rw [← MeasureTheory.integral_smul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with u
  exact hpt u
theorem polarForm_rescale {a : ℝ} (ha : 0 < a) (f : ℝ → ℂ) :
    RHLean.polarForm a f = RHLean.polarFormRescaled a (rescaleFun a f) := by
  have hs : ‖(Real.sqrt a : ℂ)‖ ^ 2 = a := by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_ofReal, Real.mul_self_sqrt ha.le]
  unfold RHLean.polarForm RHLean.polarFormRescaled
  rw [polarInner_rescale ha f, norm_mul, mul_pow, hs]
  ring
theorem integral_Ioo_comp_mul' {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (a : ℝ) (ha : 0 < a) {c d : ℝ} (hcd : c ≤ d) (F : ℝ → E) :
    (∫ x in Set.Ioo (a * c) (a * d), F x) = a • ∫ u in Set.Ioo c d, F (a * u) := by
  have hacd : a * c ≤ a * d := by nlinarith
  have h1 : (∫ x in Set.Ioo (a * c) (a * d), F x) = ∫ x in (a * c)..(a * d), F x := by
    rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hacd]
  have h2 : (∫ u in Set.Ioo c d, F (a * u)) = ∫ u in c..d, F (a * u) := by
    rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hcd]
  rw [h1, h2]
  exact (intervalIntegral.smul_integral_comp_mul_left (a := c) (b := d) F a).symm
theorem shiftForm_rescale {a : ℝ} (ha : 0 < a) {f : ℝ → ℂ}
    (hf : f ∈ RHLean.localizedCore a) :
    RHLean.shiftForm a f = RHLean.shiftFormRescaled a (rescaleFun a f) := by
  obtain ⟨-, hsupp⟩ := hf
  have hpt : ∀ (n : ℕ) (u : ℝ), a • (f (a * u) * star (f (a * u + RHLean.shiftLength n)))
      = rescaleFun a f u *
          star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n)) := by
    intro n u
    have harg : a * (u + RHLean.shiftLengthRescaled a n)
        = a * u + RHLean.shiftLength n := by
      rw [RHLean.shiftLengthRescaled, RHLean.shiftLength]
      field_simp
    rw [Complex.real_smul,
      rescaleFun_mul_star a ha.le f u (u + RHLean.shiftLengthRescaled a n), harg]
  unfold RHLean.shiftForm RHLean.shiftFormRescaled
  apply Finset.sum_congr rfl
  intro n hn
  have hn2 : 2 ≤ n := (Finset.mem_Icc.mp (by simpa [RHLean.arithSupport] using hn)).1
  have hL0 : 0 ≤ RHLean.shiftLength n := Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ n))
  have hr : RHLean.shiftLengthRescaled a n < 2 := Y7Op.shiftLengthRescaled_lt_two hn
  have htrunc : (∫ x in Set.Ioo (-a) a, f x * star (f (x + RHLean.shiftLength n)))
      = ∫ x in Set.Ioo (-a) (a - RHLean.shiftLength n),
          f x * star (f (x + RHLean.shiftLength n)) := by
    refine MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioo ?_ ?_
    · intro x hx
      exact ⟨hx.1, lt_of_lt_of_le hx.2 (by linarith [hL0] : a - RHLean.shiftLength n ≤ a)⟩
    · intro x hx
      have hle : a - RHLean.shiftLength n ≤ x := by
        by_contra hlt
        exact hx.2 ⟨hx.1.1, lt_of_not_ge hlt⟩
      have hxa : a ≤ x + RHLean.shiftLength n := by linarith
      have hz : f (x + RHLean.shiftLength n) = 0 := by
        by_contra hne
        have hmem : x + RHLean.shiftLength n ∈ Function.support f := Function.mem_support.mpr hne
        exact absurd (hsupp hmem).2 (not_lt.mpr hxa)
      simp [hz]
  have hsubst : (∫ x in Set.Ioo (-a) (a - RHLean.shiftLength n),
        f x * star (f (x + RHLean.shiftLength n)))
      = ∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
          rescaleFun a f u *
            star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n)) := by
    have hcd : (-1 : ℝ) ≤ 1 - RHLean.shiftLengthRescaled a n := by linarith
    have h := integral_Ioo_comp_mul' a ha hcd
      (fun x => f x * star (f (x + RHLean.shiftLength n)))
    have harg : a * (1 - RHLean.shiftLengthRescaled a n) = a - RHLean.shiftLength n := by
      rw [RHLean.shiftLengthRescaled, RHLean.shiftLength]
      field_simp
    rw [mul_neg, mul_one, harg] at h
    rw [h, ← MeasureTheory.integral_smul]
    apply MeasureTheory.integral_congr_ae
    filter_upwards with u
    exact hpt n u
  have hconj : (∫ u in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
        rescaleFun a f u *
          star (rescaleFun a f (u - RHLean.shiftLengthRescaled a n)))
      = star (∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
          rescaleFun a f u *
            star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n))) := by
    have h1 : (-1 : ℝ) ≤ 1 - RHLean.shiftLengthRescaled a n := by linarith
    have h2 : (-1 + RHLean.shiftLengthRescaled a n) ≤ 1 := by linarith
    have hconvL : ∀ (F : ℝ → ℂ),
        (∫ u in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1, F u)
          = ∫ u in (-1 + RHLean.shiftLengthRescaled a n)..1, F u := by
      intro F
      rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le h2]
    have hconvR : ∀ (F : ℝ → ℂ),
        (∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n), F u)
          = ∫ u in (-1)..(1 - RHLean.shiftLengthRescaled a n), F u := by
      intro F
      rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le h1]
    have hH : ∀ u : ℝ, star (rescaleFun a f u *
          star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n)))
        = rescaleFun a f (u + RHLean.shiftLengthRescaled a n) *
            star (rescaleFun a f u) := by
      intro u
      simp only [star_mul, star_star]
    have hF : ∀ (F : ℝ → ℂ), (∫ u in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1, F u)
        = ∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
            F (u + RHLean.shiftLengthRescaled a n) := by
      intro F
      rw [hconvL F, hconvR (fun u => F (u + RHLean.shiftLengthRescaled a n))]
      simpa only [sub_add_cancel] using (intervalIntegral.integral_comp_add_right
        (a := -1) (b := 1 - RHLean.shiftLengthRescaled a n) (f := F)
        (RHLean.shiftLengthRescaled a n)).symm
    rw [hF (fun u => rescaleFun a f u *
      star (rescaleFun a f (u - RHLean.shiftLengthRescaled a n)))]
    rw [show (∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
          rescaleFun a f (u + RHLean.shiftLengthRescaled a n) *
            star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n -
              RHLean.shiftLengthRescaled a n)))
        = ∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
            star (rescaleFun a f u *
              star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n))) from by
      apply integral_congr_ae
      filter_upwards with u
      have harg : u + RHLean.shiftLengthRescaled a n - RHLean.shiftLengthRescaled a n = u := by
        ring
      rw [hH u, harg]]
    change (∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
        (starRingEnd ℂ) (rescaleFun a f u *
          star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n))))
      = (starRingEnd ℂ) (∫ u in Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n),
          rescaleFun a f u *
            star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n)))
    exact (integral_conj (f := fun u => rescaleFun a f u *
      star (rescaleFun a f (u + RHLean.shiftLengthRescaled a n)))
      (μ := volume.restrict (Set.Ioo (-1) (1 - RHLean.shiftLengthRescaled a n))))
  rw [htrunc, hsubst, hconj]
  simp only [Complex.add_re, Complex.star_def, Complex.conj_re]
  ring
theorem localizedForm_rescale {a : ℝ} (ha : 0 < a) {f : ℝ → ℂ}
    (hf : f ∈ RHLean.localizedCore a) :
    RHLean.localizedForm a f = RHLean.localizedFormRescaled a (rescaleFun a f) := by
  unfold RHLean.localizedForm RHLean.localizedFormRescaled
  rw [archForm_rescale ha f, mass_rescale ha f, potentialForm_rescale ha hf,
    gammaForm_rescale ha f, polarForm_rescale ha f, shiftForm_rescale ha hf,
    RHLean.physicalConstant_eq_c0_add_log]
  ring
theorem localPSDRescaled_implies_physical (a : ℝ) (ha : 0 < a)
    (h : RHLean.LocalPSDRescaled a) :
    ∀ f : ℝ → ℂ, f ∈ RHLean.localizedCore a → 0 ≤ RHLean.localizedForm a f := by
  intro f hf
  rw [localizedForm_rescale ha hf]
  exact h ha (rescaleFun a f) (rescaleFun_mem_localizedCore ha hf)
theorem y7PhysicalTarget_of_localPSDRescaled
    (h : RHLean.LocalPSDRescaled (RHLean.endpoint 7)) : Y7Target.Y7PhysicalTarget :=
  localPSDRescaled_implies_physical (RHLean.endpoint 7)
    (by unfold RHLean.endpoint; positivity) h
theorem base_certificate_of_localPSDRescaled
    (hbridge : Y7Target.GateIIIBridge)
    (h : RHLean.LocalPSDRescaled (RHLean.endpoint 7)) :
    RHLean.LocalPSD (RHLean.endpoint 7) :=
  Y7Target.base_certificate_of_Y7PhysicalTarget hbridge
    (y7PhysicalTarget_of_localPSDRescaled h)
end Y7Rescale
end
end Inline_Y7_Rescale
