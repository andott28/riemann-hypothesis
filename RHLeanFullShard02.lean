    rw [hder] at h
    exact h
  have hneg : HasDerivAt (fun y : ℝ => -f y) (-(deriv f x)) x := (hdiff x).neg
  have hfun : (fun y : ℝ => f (-y)) = fun y => -f y := by
    funext y
    exact hodd y
  rw [hfun] at hcomp
  have h := hcomp.unique hneg
  linarith
theorem exists_odd_poly_c1_approx {f : ℝ → ℝ}
    (hdiff : ∀ x, HasDerivAt f (deriv f x) x) (hf' : Continuous (deriv f))
    (hodd : ∀ x, f (-x) = -f x) {b : ℝ} (hb : 0 ≤ b) {ε : ℝ} (hε : 0 < ε) :
    ∃ p : Polynomial ℝ, IsOddPoly p ∧
      (∀ x ∈ Set.Icc (-b) b, |p.eval x - f x| ≤ ε) ∧
      (∀ x ∈ Set.Icc (-b) b, |(Polynomial.derivative p).eval x - deriv f x| ≤ ε) := by
  set η : ℝ := ε / (1 + b + b) with hη
  have hη0 : 0 < η := by rw [hη]; positivity
  have hηle : η ≤ ε := by
    rw [hη, div_le_iff₀ (by positivity)]
    nlinarith
  have hηvol : η * (b + b) ≤ ε := by
    rw [hη, div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
    nlinarith
  obtain ⟨q, hq⟩ := exists_poly_uniform_approx_real hf' (b := b) (ε := η) hη0
  set p0 : Polynomial ℝ := antideriv q with hp0def
  have hp0' : Polynomial.derivative p0 = q := by
    rw [hp0def]
    exact derivative_antideriv q
  set c : ℝ := f (-b) - p0.eval (-b) with hc
  set p1 : Polynomial ℝ := p0 + Polynomial.C c with hp1
  have hp1' : Polynomial.derivative p1 = q := by
    rw [hp1, Polynomial.derivative_add, Polynomial.derivative_C, add_zero, hp0']
  have hp1_sup : ∀ x ∈ Set.Icc (-b) b, |p1.eval x - f x| ≤ ε := by
    intro x hx
    have hderiv : ∀ t ∈ Set.uIcc (-b) x,
        HasDerivAt (fun y : ℝ => f y - p0.eval y) (deriv f t - q.eval t) t := by
      intro t ht
      have h := (hdiff t).sub (Polynomial.hasDerivAt (p := p0) t)
      rw [hp0'] at h
      exact h
    have hint : IntervalIntegrable (fun t : ℝ => deriv f t - q.eval t) volume (-b) x :=
      ((hf'.sub (Polynomial.continuous q))).intervalIntegrable (-b) x
    have hInt := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
    have hbound : |∫ t in (-b)..x, (deriv f t - q.eval t)| ≤ η * (b + b) := by
      have hle : ∀ t ∈ Set.uIoc (-b) x, |deriv f t - q.eval t| ≤ η := by
        intro t ht
        have ht' : t ∈ Set.Icc (-b) b := by
          rw [Set.uIoc_of_le hx.1] at ht
          exact ⟨ht.1.le, by linarith [ht.2, hx.2]⟩
        simpa [abs_sub_comm] using hq t ht'
      calc |∫ t in (-b)..x, (deriv f t - q.eval t)|
          ≤ η * |x - (-b)| := by
            simpa only [Real.norm_eq_abs] using
              intervalIntegral.norm_integral_le_of_norm_le_const
                (f := fun t : ℝ => deriv f t - q.eval t)
                (fun t ht => by simpa [Real.norm_eq_abs] using hle t ht)
        _ ≤ η * (b + b) := by
            have hxb : |x - (-b)| ≤ b + b := by
              rw [show x - (-b) = x + b by ring, abs_of_nonneg (by linarith [hx.1])]
              linarith [hx.2]
            exact mul_le_mul_of_nonneg_left hxb hη0.le
    have hp1x : p1.eval x - f x = c - (f x - p0.eval x) := by
      rw [hp1]
      simp only [Polynomial.eval_add, Polynomial.eval_C]
      ring
    rw [hp1x, hc, abs_sub_comm,
      show (f x - p0.eval x) - (f (-b) - p0.eval (-b))
        = ∫ t in (-b)..x, (deriv f t - q.eval t) from hInt.symm]
    exact le_trans hbound hηvol
  refine ⟨Polynomial.C (1 / 2) * (p1 - p1.comp (-Polynomial.X)), ?_, ?_, ?_⟩
  · unfold IsOddPoly
    apply Polynomial.funext
    intro x
    simp only [Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub]
    ring
  · intro x hx
    have hx' : -x ∈ Set.Icc (-b) b := ⟨by linarith [hx.2], by linarith [hx.1]⟩
    have h1 := hp1_sup x hx
    have h2 := hp1_sup (-x) hx'
    have hq1 : (Polynomial.C (1 / 2 : ℝ) * (p1 - p1.comp (-Polynomial.X))).eval x
        = (p1.eval x - p1.eval (-x)) / 2 := by
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub,
        Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X]
      ring
    rw [hq1]
    have h3 : f (-x) = -f x := hodd x
    have h4 : |(p1.eval x - p1.eval (-x)) / 2 - f x|
        = |((p1.eval x - f x) - (p1.eval (-x) - f (-x))) / 2| := by
      rw [h3]
      ring
    rw [h4]
    have htri : |(p1.eval x - f x) - (p1.eval (-x) - f (-x))|
        ≤ |p1.eval x - f x| + |p1.eval (-x) - f (-x)| := by
      have h := norm_add_le (p1.eval x - f x) (-(p1.eval (-x) - f (-x)))
      rw [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs, abs_neg] at h
      simpa only [sub_eq_add_neg] using h
    calc |((p1.eval x - f x) - (p1.eval (-x) - f (-x))) / 2|
        ≤ (|p1.eval x - f x| + |p1.eval (-x) - f (-x)|) / 2 := by
          rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
          exact div_le_div_of_nonneg_right htri (by norm_num)
      _ ≤ (ε + ε) / 2 := by linarith
      _ = ε := by ring
  · intro x hx
    have hx' : -x ∈ Set.Icc (-b) b := ⟨by linarith [hx.2], by linarith [hx.1]⟩
    have h1 := hq x hx
    have h2 := hq (-x) hx'
    have hderiv_odd := deriv_even_of_odd hdiff hodd x
    have hcomp : Polynomial.derivative (p1.comp (-Polynomial.X)) =
        -((Polynomial.derivative p1).comp (-Polynomial.X)) := by
      rw [Polynomial.derivative_comp]
      rw [show Polynomial.derivative (-Polynomial.X) = -1 by
        simp [Polynomial.derivative_neg, Polynomial.derivative_X, Polynomial.derivative_one]]
      rw [neg_mul, one_mul]
    have hpeval : (Polynomial.derivative
        (Polynomial.C (1 / 2) * (p1 - p1.comp (-Polynomial.X)))).eval x
        = ((Polynomial.derivative p1).eval x
            + (Polynomial.derivative p1).eval (-x)) / 2 := by
      rw [Polynomial.derivative_C_mul, Polynomial.derivative_sub, hcomp,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_neg,
        Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X]
      ring
    rw [hpeval, hp1']
    have h4 : |(q.eval x + q.eval (-x)) / 2 - deriv f x|
        = |((q.eval x - deriv f x) + (q.eval (-x) - deriv f (-x))) / 2| := by
      rw [hderiv_odd]
      ring
    rw [h4]
    have htri : |(q.eval x - deriv f x) + (q.eval (-x) - deriv f (-x))|
        ≤ |q.eval x - deriv f x| + |q.eval (-x) - deriv f (-x)| := by
      have h := norm_add_le (q.eval x - deriv f x) (q.eval (-x) - deriv f (-x))
      rwa [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs] at h
    calc |((q.eval x - deriv f x) + (q.eval (-x) - deriv f (-x))) / 2|
        ≤ (|q.eval x - deriv f x| + |q.eval (-x) - deriv f (-x)|) / 2 := by
          rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
          exact div_le_div_of_nonneg_right htri (by norm_num)
      _ ≤ (η + η) / 2 := by linarith
      _ = η := by ring
      _ ≤ ε := hηle
end Y7Density
end
