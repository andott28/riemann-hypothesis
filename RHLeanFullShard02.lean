theorem exists_poly_uniform_approx_real {f : ℝ → ℝ} (hf : Continuous f)
    {b : ℝ} {ε : ℝ} (hε : 0 < ε) :
    ∃ p : Polynomial ℝ, ∀ x ∈ Set.Icc (-b) b, |p.eval x - f x| ≤ ε := by
  haveI : CompactSpace (Set.Icc (-b : ℝ) b) :=
    isCompact_iff_compactSpace.mp (isCompact_Icc (a := -b) (b := b))
  let F : C(Set.Icc (-b : ℝ) b, ℝ) :=
    ⟨fun x => f x, hf.comp continuous_subtype_val⟩
  have htop := polynomialFunctions.topologicalClosure (Set.Icc (-b : ℝ) b)
  have hclosure : closure ((polynomialFunctions (Set.Icc (-b : ℝ) b) :
      Set C(Set.Icc (-b : ℝ) b, ℝ))) = Set.univ := by
    rw [← Subalgebra.topologicalClosure_coe, htop]
    rfl
  have hmem_cl : F ∈ closure ((polynomialFunctions (Set.Icc (-b : ℝ) b) :
      Set C(Set.Icc (-b : ℝ) b, ℝ))) := by
    rw [hclosure]
    exact Set.mem_univ F
  rw [Metric.mem_closure_iff] at hmem_cl
  obtain ⟨G, hG, hdist⟩ := hmem_cl ε hε
  rw [polynomialFunctions_coe] at hG
  obtain ⟨p, rfl⟩ := hG
  refine ⟨p, fun x hx => ?_⟩
  have h1 : dist (F ⟨x, hx⟩)
      ((Polynomial.toContinuousMapOnAlgHom (Set.Icc (-b : ℝ) b) p) ⟨x, hx⟩) < ε :=
    lt_of_le_of_lt (ContinuousMap.dist_apply_le_dist _) hdist
  have h2 : |f x - p.eval x| ≤ ε := by
    have := h1.le
    simpa [F, Polynomial.toContinuousMapOn_apply, Real.dist_eq] using this
  simpa [abs_sub_comm] using h2
theorem exists_odd_poly_uniform_approx {f : ℝ → ℝ} (hf : Continuous f)
    (hodd : ∀ x, f (-x) = -f x) {b : ℝ} {ε : ℝ} (hε : 0 < ε) :
    ∃ p : Polynomial ℝ, IsOddPoly p ∧ ∀ x ∈ Set.Icc (-b) b, |p.eval x - f x| ≤ ε := by
  obtain ⟨p, hp⟩ := exists_poly_uniform_approx_real hf (b := b) hε
  refine ⟨Polynomial.C (1 / 2) * (p - p.comp (-Polynomial.X)), ?_, ?_⟩
  · unfold IsOddPoly
    apply Polynomial.funext
    intro x
    simp only [Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub]
    ring
  · intro x hx
    have hx' : -x ∈ Set.Icc (-b) b := ⟨by linarith [hx.2], by linarith [hx.1]⟩
    have h1 := hp x hx
    have h2 := hp (-x) hx'
    have hq : (Polynomial.C (1 / 2 : ℝ) * (p - p.comp (-Polynomial.X))).eval x
        = (p.eval x - p.eval (-x)) / 2 := by
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub,
        Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X]
      ring
    rw [hq]
    have h3 : f (-x) = -f x := hodd x
    have h4 : |(p.eval x - p.eval (-x)) / 2 - f x|
        = |((p.eval x - f x) - (p.eval (-x) - f (-x))) / 2| := by
      rw [h3]
      ring
    rw [h4]
    have htri : |(p.eval x - f x) - (p.eval (-x) - f (-x))|
        ≤ |p.eval x - f x| + |p.eval (-x) - f (-x)| := by
      have h := norm_add_le (p.eval x - f x) (-(p.eval (-x) - f (-x)))
      rw [Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs, abs_neg] at h
      simpa only [sub_eq_add_neg] using h
    calc |((p.eval x - f x) - (p.eval (-x) - f (-x))) / 2|
        ≤ (|p.eval x - f x| + |p.eval (-x) - f (-x)|) / 2 := by
          rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
          exact div_le_div_of_nonneg_right htri (by norm_num)
      _ ≤ (ε + ε) / 2 := by linarith
      _ = ε := by ring
theorem exists_odd_poly_l2_approx {f : ℝ → ℝ} (hf : Continuous f)
    (hodd : ∀ x, f (-x) = -f x) {b : ℝ} (hb : 0 ≤ b) {ε : ℝ} (hε : 0 < ε) :
