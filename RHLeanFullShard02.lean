noncomputable def LogRow.u (r : LogRow) : ℚ := (r.a : ℚ) / r.b
theorem LogRow.tailW_ge (r : LogRow) (h5 : 5 ≤ r.p)
    (h : r.check = true) :
    (r.lom : ℝ) / ((10 : ℝ) ^ 18) ≤ tailW r.p := by
  obtain ⟨hb, hN, hka, hak, hcheck, hlo⟩ := r.check_sound h
  have hk : (r.k : ℚ) ≤ r.u := by
    unfold LogRow.u
    rw [le_div_iff₀ (by exact_mod_cast hb)]
    exact_mod_cast hka
  have hk1 : r.u ≤ (r.k : ℚ) + 1 := by
    unfold LogRow.u
    rw [div_le_iff₀ (by exact_mod_cast hb)]
    have : (r.a : ℚ) < ((r.k + 1) * r.b : ℕ) := by exact_mod_cast hak
    push_cast at this
    linarith
  have hx : (0 : ℚ) ≤ r.u := by
    unfold LogRow.u
    positivity
  have hx0 : (0 : ℚ) ≤ r.u - (r.k : ℚ) := by linarith
  have hsub : r.u - (r.k : ℚ) = ((r.a - r.k * r.b : ℕ) : ℚ) / (r.b : ℚ) := by
    unfold LogRow.u
    rw [Nat.cast_sub hka]
    push_cast
    field_simp [show (r.b : ℚ) ≠ 0 by exact_mod_cast ne_of_gt hb]
  have hcert2 : expHi2 r.k * taylorUB1 (r.u - (r.k : ℚ)) r.N ≤ (r.p : ℚ) := by
    rw [hsub]
    exact hcheck_of_nat hb hN hcheck
  have hTnonneg : (0 : ℚ) ≤ taylorUB1 (r.u - (r.k : ℚ)) r.N := by
    unfold taylorUB1
    apply add_nonneg
    · exact Finset.sum_nonneg fun m _ =>
        div_nonneg (pow_nonneg hx0 m) (by positivity)
    · apply div_nonneg
      · exact mul_nonneg (pow_nonneg hx0 _) (by positivity)
      · positivity
  have hcert : expHi r.k * taylorUB1 (r.u - (r.k : ℚ)) r.N ≤ (r.p : ℚ) :=
    le_trans (mul_le_mul_of_nonneg_right (expHi_le_expHi2 r.k) hTnonneg) hcert2
  have hu : (r.u : ℝ) ≤ Real.log (r.p : ℝ) :=
    log_lower_of_expHi (by omega : 0 < r.p) hk hk1 hN hcert
  have hloR : ((r.lom : ℚ) / 10 ^ 18 : ℚ) ≤ tailWLo r.p r.u :=
    hlo_of_nat hb (by omega) hlo
  calc (r.lom : ℝ) / ((10 : ℝ) ^ 18)
      = (((r.lom : ℚ) / 10 ^ 18 : ℚ) : ℝ) := by push_cast; ring
    _ ≤ (tailWLo r.p r.u : ℝ) := by exact_mod_cast hloR
    _ ≤ tailW r.p := tailWLo_le_tailW_core (by omega) (by exact_mod_cast hx) hu
structure LogRowCert where
  row : LogRow
  hp : Nat.Prime row.p
  h5 : 5 ≤ row.p
  hcheck : row.check = true
theorem Fprime_lower_of_rowCerts_aux (rows : List LogRowCert) (s : Finset ℕ)
    (hmem : ∀ r ∈ rows, r.row.p ∈ s)
    (hnd : (rows.map (fun r => r.row.p)).Nodup) :
    (rows.map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18) ≤ ∑ p ∈ s, tailW p := by
  induction rows generalizing s with
  | nil =>
      simp only [List.map_nil, List.sum_nil, zero_div]
      exact Finset.sum_nonneg (fun p _ => tailW_nonneg p)
  | cons r rest ih =>
      obtain ⟨hnotin, hnd_rest⟩ := List.nodup_cons.mp hnd
      have hmem_rest : ∀ x ∈ rest, x.row.p ∈ s.erase r.row.p := by
        intro x hx
        have h1 := hmem x (List.mem_cons_of_mem r hx)
        have h2 : x.row.p ≠ r.row.p := by
          intro h
          apply hnotin
          have hmemmap : x.row.p ∈ List.map (fun r => r.row.p) rest :=
            List.mem_map_of_mem hx
          simpa [h] using hmemmap
        exact Finset.mem_erase.mpr ⟨h2, h1⟩
      have ih' := ih (s.erase r.row.p) hmem_rest hnd_rest
      have hmem_r : r.row.p ∈ s := hmem r List.mem_cons_self
      have hsplit : ∑ p ∈ s, tailW p
          = tailW r.row.p + ∑ p ∈ s.erase r.row.p, tailW p :=
        (Finset.add_sum_erase s tailW hmem_r).symm
      have hsum_cons : ((r :: rest).map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18)
          = (r.row.lom : ℝ) / ((10 : ℝ) ^ 18)
            + (rest.map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18) := by
        rw [List.map_cons, List.sum_cons]
        ring
      have hrow : (r.row.lom : ℝ) / ((10 : ℝ) ^ 18) ≤ tailW r.row.p :=
        r.row.tailW_ge r.h5 r.hcheck
      calc ((r :: rest).map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18)
          = (r.row.lom : ℝ) / ((10 : ℝ) ^ 18)
            + (rest.map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18) := hsum_cons
        _ ≤ tailW r.row.p + ∑ p ∈ s.erase r.row.p, tailW p := add_le_add hrow ih'
        _ = ∑ p ∈ s, tailW p := hsplit.symm
theorem Fprime_lower_of_rowCerts {K : ℕ} (rows : List LogRowCert)
    (hmem : ∀ r ∈ rows, r.row.p ≤ K)
    (hnd : (rows.map (fun r => r.row.p)).Nodup) :
    (rows.map (fun r => (r.row.lom : ℝ))).sum / ((10 : ℝ) ^ 18) ≤ Fprime K :=
  Fprime_lower_of_rowCerts_aux rows ((Nat.primesLE K).filter (fun p => 5 ≤ p))
    (fun r hr => Finset.mem_filter.mpr
      ⟨Nat.mem_primesLE.mpr ⟨hmem r hr, r.hp⟩, r.h5⟩) hnd
theorem Fprime_lower_of_rows_data_aux (rows : List LogRow) (s : Finset ℕ)
    (hmem : ∀ r ∈ rows, r.p ∈ s)
    (hnd : (rows.map (fun r => r.p)).Nodup)
    (hcheck : ∀ r ∈ rows, r.check = true)
    (hprime : ∀ r ∈ rows, Nat.Prime r.p)
    (h5 : ∀ r ∈ rows, 5 ≤ r.p) :
    (rows.map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18) ≤ ∑ p ∈ s, tailW p := by
  induction rows generalizing s with
  | nil =>
      simp only [List.map_nil, List.sum_nil, zero_div]
      exact Finset.sum_nonneg (fun p _ => tailW_nonneg p)
  | cons r rest ih =>
      obtain ⟨hnotin, hnd_rest⟩ := List.nodup_cons.mp hnd
      have hmem_rest : ∀ x ∈ rest, x.p ∈ s.erase r.p := by
        intro x hx
        have h1 := hmem x (List.mem_cons_of_mem r hx)
        have h2 : x.p ≠ r.p := by
          intro h
          apply hnotin
          have hmemmap : x.p ∈ List.map (fun r => r.p) rest :=
            List.mem_map_of_mem hx
          simpa [h] using hmemmap
        exact Finset.mem_erase.mpr ⟨h2, h1⟩
      have ih' := ih (s.erase r.p) hmem_rest hnd_rest
        (fun x hx => hcheck x (List.mem_cons_of_mem r hx))
        (fun x hx => hprime x (List.mem_cons_of_mem r hx))
        (fun x hx => h5 x (List.mem_cons_of_mem r hx))
      have hmem_r : r.p ∈ s := hmem r List.mem_cons_self
      have hsplit : ∑ p ∈ s, tailW p = tailW r.p + ∑ p ∈ s.erase r.p, tailW p :=
        (Finset.add_sum_erase s tailW hmem_r).symm
      have hsum_cons : ((r :: rest).map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18)
          = (r.lom : ℝ) / ((10 : ℝ) ^ 18)
            + (rest.map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18) := by
        rw [List.map_cons, List.sum_cons]
        ring
      have hrow : (r.lom : ℝ) / ((10 : ℝ) ^ 18) ≤ tailW r.p :=
        r.tailW_ge (h5 r List.mem_cons_self) (hcheck r List.mem_cons_self)
      calc ((r :: rest).map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18)
          = (r.lom : ℝ) / ((10 : ℝ) ^ 18)
            + (rest.map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18) := hsum_cons
        _ ≤ tailW r.p + ∑ p ∈ s.erase r.p, tailW p := add_le_add hrow ih'
        _ = ∑ p ∈ s, tailW p := hsplit.symm
theorem Fprime_lower_of_rows_data {K : ℕ} (rows : List LogRow)
    (hmem : ∀ r ∈ rows, r.p ≤ K)
    (hnd : (rows.map (fun r => r.p)).Nodup)
    (hcheck : ∀ r ∈ rows, r.check = true)
    (hprime : ∀ r ∈ rows, Nat.Prime r.p)
    (h5 : ∀ r ∈ rows, 5 ≤ r.p) :
    (rows.map (fun r => (r.lom : ℝ))).sum / ((10 : ℝ) ^ 18) ≤ Fprime K :=
  Fprime_lower_of_rows_data_aux rows ((Nat.primesLE K).filter (fun p => 5 ≤ p))
    (fun r hr => Finset.mem_filter.mpr
      ⟨Nat.mem_primesLE.mpr ⟨hmem r hr, hprime r hr⟩, h5 r hr⟩) hnd hcheck hprime h5
