section Inline_Y7KernelAction
noncomputable section
open MeasureTheory Polynomial
namespace Y7KernelAction
noncomputable def polyPrim (p : Polynomial ℝ) : Polynomial ℝ :=
  ∑ i ∈ Finset.range (p.natDegree + 1),
    Polynomial.C (p.coeff i / (i + 1)) * Polynomial.X ^ (i + 1)
lemma polyPrim_derivative (p : Polynomial ℝ) : (polyPrim p).derivative = p := by
  unfold polyPrim
  rw [Polynomial.derivative_sum]
  have h : ∀ i ∈ Finset.range (p.natDegree + 1),
      (Polynomial.C (p.coeff i / (i + 1)) * Polynomial.X ^ (i + 1) : Polynomial ℝ).derivative
        = Polynomial.C (p.coeff i) * Polynomial.X ^ i := by
    intro i hi
    rw [Polynomial.derivative_C_mul, Polynomial.derivative_X_pow]
    rw [show i + 1 - 1 = i from by omega]
    rw [show (Polynomial.C (((i + 1 : ℕ) : ℝ))) = Polynomial.C ((i : ℝ) + 1) from by norm_num]
    rw [← mul_assoc, ← Polynomial.C_mul]
    congr 1
    field_simp
  rw [Finset.sum_congr rfl h]
  exact (Polynomial.as_sum_range_C_mul_X_pow p).symm
lemma polyPrim_eval_zero (p : Polynomial ℝ) : (polyPrim p).eval 0 = 0 := by
  unfold polyPrim
  simp [Polynomial.eval_finsetSum]
lemma integral_poly_eq (p : Polynomial ℝ) (a b : ℝ) :
    (∫ x in a..b, p.eval x) = (polyPrim p).eval b - (polyPrim p).eval a := by
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun x => (polyPrim p).eval x) (p.eval x) x := by
    intro x _
    have h := Polynomial.hasDerivAt (polyPrim p) x
    rwa [polyPrim_derivative] at h
  have hint : IntervalIntegrable (fun x => p.eval x) volume a b :=
    (Polynomial.continuous p).intervalIntegrable _ _
  exact intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
noncomputable def primAt (c : ℝ) (p : Polynomial ℝ) : Polynomial ℝ :=
  polyPrim p - Polynomial.C ((polyPrim p).eval c)
lemma primAt_derivative (c : ℝ) (p : Polynomial ℝ) : (primAt c p).derivative = p := by
  unfold primAt
  rw [Polynomial.derivative_sub, Polynomial.derivative_C, polyPrim_derivative, sub_zero]
lemma primAt_eval_self (c : ℝ) (p : Polynomial ℝ) : (primAt c p).eval c = 0 := by
  unfold primAt
  simp
lemma primAt_eval (c x : ℝ) (p : Polynomial ℝ) :
    (primAt c p).eval x = ∫ y in c..x, p.eval y := by
  have hderiv : ∀ t ∈ Set.uIcc c x,
      HasDerivAt (fun t => (primAt c p).eval t) (p.eval t) t := by
    intro t _
    have h := Polynomial.hasDerivAt (primAt c p) t
    rwa [primAt_derivative] at h
  have hint : IntervalIntegrable (fun t => p.eval t) volume c x :=
    (Polynomial.continuous p).intervalIntegrable _ _
  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
  rw [h, primAt_eval_self]
  ring
lemma primAt_one_eval (x : ℝ) (p : Polynomial ℝ) :
    (primAt 1 p).eval x = - ∫ y in x..1, p.eval y := by
  have h := primAt_eval 1 x p
  rw [h]
  have h2 : (∫ y in x..1, p.eval y) + (∫ y in 1..x, p.eval y) = 0 := by
    rw [intervalIntegral.integral_add_adjacent_intervals
      ((Polynomial.continuous p).intervalIntegrable _ _)
      ((Polynomial.continuous p).intervalIntegrable _ _)]
    simp
  linarith
noncomputable def kernelTerm (m : ℕ) (p : Polynomial ℝ) : Polynomial ℝ :=
  (∑ k ∈ Finset.range (m + 1),
      Polynomial.C (((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k)) * Polynomial.X ^ k *
        primAt (-1) (Polynomial.X ^ (m - k) * p))
    + (∑ k ∈ Finset.range (m + 1),
        Polynomial.C (-(((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k))) *
          Polynomial.X ^ (m - k) * primAt 1 (Polynomial.X ^ k * p))
theorem kernelTerm_spec (m : ℕ) (p : Polynomial ℝ) {x : ℝ} (hx : x ∈ Set.Icc (-1 : ℝ) 1) :
    (kernelTerm m p).eval x = ∫ y in (-1 : ℝ)..1, |x - y| ^ m * p.eval y := by
  have hsplit : (∫ y in (-1 : ℝ)..1, |x - y| ^ m * p.eval y)
      = (∫ y in (-1 : ℝ)..x, |x - y| ^ m * p.eval y)
        + (∫ y in x..1, |x - y| ^ m * p.eval y) := by
    rw [intervalIntegral.integral_add_adjacent_intervals]
    · exact (Continuous.intervalIntegrable (by fun_prop) _ _)
    · exact (Continuous.intervalIntegrable (by fun_prop) _ _)
  have hleft : (∫ y in (-1 : ℝ)..x, |x - y| ^ m * p.eval y)
      = ∫ y in (-1 : ℝ)..x, (x - y) ^ m * p.eval y := by
    apply intervalIntegral.integral_congr
    intro y hy
    beta_reduce
    rw [Set.uIcc_of_le hx.1] at hy
    rw [abs_of_nonneg (sub_nonneg.mpr hy.2)]
  have hright : (∫ y in x..1, |x - y| ^ m * p.eval y)
      = ∫ y in x..1, (y - x) ^ m * p.eval y := by
    apply intervalIntegral.integral_congr
    intro y hy
    beta_reduce
    rw [Set.uIcc_of_le hx.2] at hy
    rw [abs_of_nonpos (sub_nonpos.mpr hy.1)]
    ring
  rw [hsplit, hleft, hright]
  have hL : (∫ y in (-1 : ℝ)..x, (x - y) ^ m * p.eval y)
      = ∑ k ∈ Finset.range (m + 1),
          ((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k) * x ^ k *
            (∫ y in (-1 : ℝ)..x, y ^ (m - k) * p.eval y) := by
    have hpoint : ∀ y : ℝ, (x - y) ^ m * p.eval y
        = ∑ k ∈ Finset.range (m + 1),
            ((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k) * x ^ k *
              (y ^ (m - k) * p.eval y) := by
      intro y
      rw [show x - y = x + (-y) from by ring, add_pow]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro k hk
      rw [neg_pow]
      ring
    simp_rw [hpoint]
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro k hk
      rw [intervalIntegral.integral_const_mul]
    · intro k hk
      exact (Continuous.intervalIntegrable (by fun_prop) _ _)
  have hR : (∫ y in x..1, (y - x) ^ m * p.eval y)
      = ∑ k ∈ Finset.range (m + 1),
          ((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k) * x ^ (m - k) *
            (∫ y in x..1, y ^ k * p.eval y) := by
    have hpoint : ∀ y : ℝ, (y - x) ^ m * p.eval y
        = ∑ k ∈ Finset.range (m + 1),
            ((m.choose k : ℕ) : ℝ) * (-1) ^ (m - k) * x ^ (m - k) *
              (y ^ k * p.eval y) := by
      intro y
      rw [show y - x = y + (-x) from by ring, add_pow]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro k hk
      rw [neg_pow]
      ring
    simp_rw [hpoint]
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro k hk
      rw [intervalIntegral.integral_const_mul]
    · intro k hk
      exact (Continuous.intervalIntegrable (by fun_prop) _ _)
  rw [hL, hR]
  have hleft' : ∀ k : ℕ, (∫ y in (-1 : ℝ)..x, y ^ (m - k) * p.eval y)
      = (primAt (-1) (Polynomial.X ^ (m - k) * p)).eval x := by
    intro k
    rw [primAt_eval]
    apply intervalIntegral.integral_congr
    intro y hy
    beta_reduce
    simp [Polynomial.eval_mul, Polynomial.eval_pow]
  have hright' : ∀ k : ℕ, (∫ y in x..1, y ^ k * p.eval y)
      = - (primAt 1 (Polynomial.X ^ k * p)).eval x := by
    intro k
    rw [primAt_one_eval, neg_neg]
    apply intervalIntegral.integral_congr
    intro y hy
    beta_reduce
    simp [Polynomial.eval_mul, Polynomial.eval_pow]
  simp_rw [hleft', hright']
  unfold kernelTerm
  rw [Polynomial.eval_add, Polynomial.eval_finsetSum, Polynomial.eval_finsetSum]
  congr 1
  · apply Finset.sum_congr rfl
    intro k hk
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  · apply Finset.sum_congr rfl
    intro k hk
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    ring
noncomputable def gammaAction (M : ℕ) (a : ℝ) (p : Polynomial ℝ) : Polynomial ℝ :=
  ∑ k ∈ Finset.range (M + 1),
    Polynomial.C (((Y7Chain.rhoCoeff k : ℚ) : ℝ) * a ^ k) * kernelTerm k p
lemma rhoTrunc_eval_mul (M : ℕ) (a x : ℝ) (p : Polynomial ℝ) (y : ℝ) :
    (Y7Density.rhoTrunc M).eval (a * |x - y|) * p.eval y
      = ∑ k ∈ Finset.range (M + 1),
          (((Y7Chain.rhoCoeff k : ℚ) : ℝ) * a ^ k) * (|x - y| ^ k * p.eval y) := by
  rw [Y7Density.rhoTrunc, Polynomial.eval_finsetSum]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro k hk
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  rw [mul_pow]
  ring
theorem gammaAction_spec (M : ℕ) (a : ℝ) (p : Polynomial ℝ) {x : ℝ}
    (hx : x ∈ Set.Icc (-1 : ℝ) 1) :
    (gammaAction M a p).eval x =
      ∫ y in (-1 : ℝ)..1, (Y7Density.rhoTrunc M).eval (a * |x - y|) * p.eval y := by
  rw [show (∫ y in (-1 : ℝ)..1, (Y7Density.rhoTrunc M).eval (a * |x - y|) * p.eval y)
      = ∫ y in (-1 : ℝ)..1, ∑ k ∈ Finset.range (M + 1),
          (((Y7Chain.rhoCoeff k : ℚ) : ℝ) * a ^ k) * (|x - y| ^ k * p.eval y) from by
    apply intervalIntegral.integral_congr
    intro y hy
    beta_reduce
    exact rhoTrunc_eval_mul M a x p y]
  rw [intervalIntegral.integral_finsetSum]
  · unfold gammaAction
    rw [Polynomial.eval_finsetSum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [Polynomial.eval_mul, Polynomial.eval_C, intervalIntegral.integral_const_mul,
      ← kernelTerm_spec k p hx]
  · intro k hk
    exact (Continuous.intervalIntegrable (by fun_prop) _ _)
noncomputable def gammaModelMatrix (M : ℕ) (a : ℝ) (m n : ℕ) : ℝ :=
  ∫ x in (-1 : ℝ)..1,
    (Y7Legendre.legP m).eval x * (gammaAction M a (Y7Legendre.legP n)).eval x
theorem gammaModelMatrix_spec (M : ℕ) (a : ℝ) (m n : ℕ) :
    gammaModelMatrix M a m n =
      ∫ x in (-1 : ℝ)..1, ∫ y in (-1 : ℝ)..1,
        (Y7Density.rhoTrunc M).eval (a * |x - y|) *
          ((Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval y) := by
  unfold gammaModelMatrix
  apply intervalIntegral.integral_congr
  intro x hx
  beta_reduce
  rw [Set.uIcc_of_le (by norm_num : (-1 : ℝ) ≤ 1)] at hx
  rw [gammaAction_spec M a (Y7Legendre.legP n) hx]
  rw [show (∫ y in (-1 : ℝ)..1,
        (Y7Density.rhoTrunc M).eval (a * |x - y|) *
          ((Y7Legendre.legP m).eval x * (Y7Legendre.legP n).eval y))
      = ∫ y in (-1 : ℝ)..1,
          (Y7Legendre.legP m).eval x *
            ((Y7Density.rhoTrunc M).eval (a * |x - y|) * (Y7Legendre.legP n).eval y) from by
    apply intervalIntegral.integral_congr
    intro y hy
    ring]
  rw [intervalIntegral.integral_const_mul]
end Y7KernelAction
end
