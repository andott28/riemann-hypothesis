theorem hcheck_of_nat {p k N xnum b : ℕ} (hb : 0 < b) (hN : 0 < N)
    (h : expHiN k * taylorN xnum b N
      ≤ p * (expHiD k * taylorD b N)) :
    expHi2 k * taylorUB1 ((xnum : ℚ) / b) N ≤ (p : ℚ) := by
  rw [taylorUB1_div_eq xnum b N hb hN]
  unfold expHi2 expHiN expHiD
  unfold expHiN expHiD at h
  have hbD : (0 : ℚ) < (taylorD b N : ℚ) := by
    have : 0 < taylorD b N := by unfold taylorD; positivity
    exact_mod_cast this
  rw [div_mul_div_comm]
  rw [div_le_iff₀ (mul_pos (by positivity) hbD)]
  exact_mod_cast h
theorem hlo_of_nat {p a b lom : ℕ} (hb : 0 < b) (hp : 0 < p)
    (h : lom * b * p * (a * 10 ^ 10 + 11931471808 * b) ≤ a ^ 2 * 10 ^ 28) :
    ((lom : ℚ) / 10 ^ 18) ≤ tailWLo p ((a : ℚ) / b) := by
  have hbQ : (0 : ℚ) < b := by exact_mod_cast hb
  have hpQ : (0 : ℚ) < p := by exact_mod_cast hp
  have hkey : tailWLo p ((a : ℚ) / b)
      = (a ^ 2 * 10 ^ 10 : ℚ)
          / (b * p * (a * 10 ^ 10 + 11931471808 * b)) := by
    unfold tailWLo
    field_simp [hbQ.ne', hpQ.ne']
  have hden : (0 : ℚ) < b * p * (a * 10 ^ 10 + 11931471808 * b) := by positivity
  rw [hkey, le_div_iff₀ hden, div_mul_eq_mul_div, div_le_iff₀ (by norm_num : (0 : ℚ) < 10 ^ 18)]
  have hQ : ((lom * b * p * (a * 10 ^ 10 + 11931471808 * b) : ℕ) : ℚ)
      ≤ ((a ^ 2 * 10 ^ 28 : ℕ) : ℚ) := by exact_mod_cast h
  push_cast at hQ
  nlinarith [hQ]
structure LogRow where
  p : ℕ
  a : ℕ
  b : ℕ
  k : ℕ
  N : ℕ
