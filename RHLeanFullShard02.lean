private lemma shift_term_abs_le (s : Finset ℕ) (x : ℕ → ℝ) {r : ℝ}
    (hrp : 0 < r) (hrl : r < 2) :
    |2 * ∫ y in Set.Ioo (-1) (1 - r), U s x y * U s x (y + r)|
      ≤ (∫ y in Set.Ioo (-1) (1 - r), U s x y ^ 2)
        + ∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2 := by
  have hUc : Continuous (U s x) := continuous_U s x
  have hcont1 : Continuous (fun y : ℝ => U s x y * U s x (y + r)) := by fun_prop
  have hcont2 : Continuous (fun y : ℝ => U s x y ^ 2) := by fun_prop
  have hcont3 : Continuous (fun y : ℝ => U s x (y + r) ^ 2) := by fun_prop
  have hIntA : ∀ (F : ℝ → ℝ), Continuous F → IntegrableOn F (Set.Ioo (-1) (1 - r)) :=
    fun F hF => (integrableOn_Icc_iff_integrableOn_Ioo).mp hF.integrableOn_Icc
  have hIntB : ∀ (F : ℝ → ℝ), Continuous F → IntegrableOn F (Set.Ioo (-1 + r) 1) :=
    fun F hF => (integrableOn_Icc_iff_integrableOn_Ioo).mp hF.integrableOn_Icc
  have hshiftInt : (∫ y in Set.Ioo (-1) (1 - r), U s x (y + r) ^ 2)
      = ∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2 := by
    have h := integral_Ioo_shift (F := fun y => U s x (y + r) ^ 2)
      (c := -1) (d := 1 - r) (r := r) (by linarith)
    simpa only [sub_add_cancel] using h.symm
  have hsumA : (∫ y in Set.Ioo (-1) (1 - r), U s x y ^ 2)
        + (∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2)
      = ∫ y in Set.Ioo (-1) (1 - r), (U s x y ^ 2 + U s x (y + r) ^ 2) := by
    rw [← hshiftInt]
    exact (MeasureTheory.integral_add (hIntA _ hcont2) (hIntA _ hcont3)).symm
  have hupper : 2 * ∫ y in Set.Ioo (-1) (1 - r), U s x y * U s x (y + r)
      ≤ (∫ y in Set.Ioo (-1) (1 - r), U s x y ^ 2)
        + ∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2 := by
    rw [← MeasureTheory.integral_const_mul]
    calc
      (∫ y in Set.Ioo (-1) (1 - r), 2 * (U s x y * U s x (y + r)))
          ≤ ∫ y in Set.Ioo (-1) (1 - r), (U s x y ^ 2 + U s x (y + r) ^ 2) := by
            apply MeasureTheory.integral_mono (hIntA _ (by fun_prop)) (hIntA _ (by fun_prop))
            intro y
            nlinarith [sq_nonneg (U s x y - U s x (y + r))]
      _ = (∫ y in Set.Ioo (-1) (1 - r), U s x y ^ 2)
          + ∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2 := by
            rw [MeasureTheory.integral_add (hIntA _ hcont2) (hIntA _ hcont3), hshiftInt]
  have hlower : -((∫ y in Set.Ioo (-1) (1 - r), U s x y ^ 2)
        + ∫ y in Set.Ioo (-1 + r) 1, U s x y ^ 2)
      ≤ 2 * ∫ y in Set.Ioo (-1) (1 - r), U s x y * U s x (y + r) := by
    rw [hsumA, ← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_neg]
    apply MeasureTheory.integral_mono (hIntA _ (by fun_prop)) (hIntA _ (by fun_prop))
    intro y
    nlinarith [sq_nonneg (U s x y + U s x (y + r))]
  exact abs_le.mpr ⟨hlower, hupper⟩
private lemma shift_budget_terms (r c : ℕ → ℝ) (y : ℝ)
    (hy1 : -1 < y) (hy2 : y < 1)
    (hr2 : r 2 < 1) (hr3 : 1 < r 3) (hr4 : 1 < r 4) (hr5 : 1 < r 5) (hr6 : 1 < r 6)
    (hr24 : 2 < r 2 + r 4) (hr25 : 2 < r 2 + r 5) (hr26 : 2 < r 2 + r 6)
    (hc2 : c 2 ≤ c 4 + c 5) (hc6 : c 6 = 0)
    (hc20 : 0 ≤ c 2) (hc30 : 0 ≤ c 3) (hc40 : 0 ≤ c 4) (hc50 : 0 ≤ c 5) :
    c 2 * ((if y ∈ Set.Ioo (-1 : ℝ) (1 - r 2) then (1 : ℝ) else 0)
        + (if y ∈ Set.Ioo (-1 + r 2) 1 then (1 : ℝ) else 0))
      + c 3 * ((if y ∈ Set.Ioo (-1 : ℝ) (1 - r 3) then (1 : ℝ) else 0)
        + (if y ∈ Set.Ioo (-1 + r 3) 1 then (1 : ℝ) else 0))
      + c 4 * ((if y ∈ Set.Ioo (-1 : ℝ) (1 - r 4) then (1 : ℝ) else 0)
        + (if y ∈ Set.Ioo (-1 + r 4) 1 then (1 : ℝ) else 0))
      + c 5 * ((if y ∈ Set.Ioo (-1 : ℝ) (1 - r 5) then (1 : ℝ) else 0)
        + (if y ∈ Set.Ioo (-1 + r 5) 1 then (1 : ℝ) else 0))
      + c 6 * ((if y ∈ Set.Ioo (-1 : ℝ) (1 - r 6) then (1 : ℝ) else 0)
        + (if y ∈ Set.Ioo (-1 + r 6) 1 then (1 : ℝ) else 0))
      ≤ c 2 + c 3 + c 4 + c 5 := by
  have hA : ∀ k : ℕ, (y ∈ Set.Ioo (-1 : ℝ) (1 - r k)) ↔ y < 1 - r k := by
    intro k
    exact ⟨fun h => h.2, fun h => ⟨hy1, h⟩⟩
  have hB : ∀ k : ℕ, (y ∈ Set.Ioo (-1 + r k) 1) ↔ -1 + r k < y := by
    intro k
    exact ⟨fun h => h.1, fun h => ⟨h, hy2⟩⟩
  simp only [hA, hB]
  split_ifs with h2a h2b h3a h3b h4a h4b h5a h5b h6a h6b <;>
    linarith [hc2, hc6, hc20, hc30, hc40, hc50]
private lemma shift_sum_eq_integral (s : Finset ℕ) (x : ℕ → ℝ) (r c : ℕ → ℝ)
    (hrp : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), 0 < r k)
    (hrl : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), r k < 2) :
    (∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ),
        c k * ((∫ y in Set.Ioo (-1) (1 - r k), U s x y ^ 2)
          + (∫ y in Set.Ioo (-1 + r k) 1, U s x y ^ 2)))
      = ∫ y in Set.Ioo (-1 : ℝ) 1,
          ∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ),
            c k * ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
              + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)) := by
  have hUc : Continuous (U s x) := continuous_U s x
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hUc.continuousOn
  set B' : ℝ := max B 0 with hB'def
  have hB'0 : 0 ≤ B' := le_max_right _ _
  have hBb : ∀ y ∈ Set.Ioo (-1 : ℝ) 1, ‖U s x y‖ ≤ B' := fun y hy =>
    le_trans (hB y ⟨le_of_lt hy.1, le_of_lt hy.2⟩) (le_max_left _ _)
  have hU2 : ∀ y ∈ Set.Ioo (-1 : ℝ) 1, U s x y ^ 2 ≤ B' ^ 2 := by
    intro y hy
    have h1 : |U s x y| ≤ B' := by
      simpa only [Real.norm_eq_abs] using hBb y hy
    have h2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
    simpa only [sq_abs] using h2
  have hInd : ∀ (c0 d0 : ℝ), -1 ≤ c0 → d0 ≤ 1 →
      (∫ y in Set.Ioo c0 d0, U s x y ^ 2)
        = ∫ y in Set.Ioo (-1 : ℝ) 1,
            (if y ∈ Set.Ioo c0 d0 then U s x y ^ 2 else 0) := by
    intro c0 d0 hc0 hd0
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
      (s := Set.Ioo c0 d0) (t := Set.Ioo (-1 : ℝ) 1)
      (f := fun y => if y ∈ Set.Ioo c0 d0 then U s x y ^ 2 else 0) measurableSet_Ioo
      (fun y hy => ⟨by linarith [hy.1, hc0], lt_of_lt_of_le hy.2 hd0⟩) ?_]
    · apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
      rw [if_pos hy]
    · intro y hy
      rw [if_neg hy.2]
  have hIind : ∀ (c0 d0 : ℝ), -1 ≤ c0 → d0 ≤ 1 →
      IntegrableOn (fun y => if y ∈ Set.Ioo c0 d0 then U s x y ^ 2 else 0)
        (Set.Ioo (-1 : ℝ) 1) := by
    intro c0 d0 hc0 hd0
    refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
      ?_ (B' ^ 2) ?_
    · refine Measurable.aestronglyMeasurable ?_
      exact Measurable.ite measurableSet_Ioo (hUc.measurable.pow_const 2) measurable_const
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
      rw [Real.norm_eq_abs]
      by_cases h : y ∈ Set.Ioo c0 d0
      · rw [if_pos h, abs_of_nonneg (sq_nonneg _)]
        exact hU2 y hy
      · rw [if_neg h, abs_zero]
        exact sq_nonneg _
  have hIk : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), IntegrableOn (fun y : ℝ =>
      c k * ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
        + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)))
      (Set.Ioo (-1 : ℝ) 1) := by
    intro k hk
    have hrpk := hrp k hk
    have hrlk := hrl k hk
    have h1 := hIind (-1) (1 - r k) (by norm_num) (by linarith)
    have h2 := hIind (-1 + r k) 1 (by linarith) (by norm_num)
    exact (h1.add h2).const_mul (c k)
  have hstep : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ),
      c k * ((∫ y in Set.Ioo (-1) (1 - r k), U s x y ^ 2)
        + (∫ y in Set.Ioo (-1 + r k) 1, U s x y ^ 2))
      = ∫ y in Set.Ioo (-1 : ℝ) 1,
          c k * ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
            + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)) := by
    intro k hk
    have hrpk := hrp k hk
    have hrlk := hrl k hk
    rw [hInd (-1) (1 - r k) (by norm_num) (by linarith),
      hInd (-1 + r k) 1 (by linarith) (by norm_num)]
    rw [← MeasureTheory.integral_add
        (hIind (-1) (1 - r k) (by norm_num) (by linarith))
        (hIind (-1 + r k) 1 (by linarith) (by norm_num)),
      ← MeasureTheory.integral_const_mul]
  rw [Finset.sum_congr rfl hstep]
  rw [← MeasureTheory.integral_finsetSum (s := ({2, 3, 4, 5, 6} : Finset ℕ))
    (f := fun k y => c k * ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
      + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)))
    (fun k hk => hIk k hk)]
theorem shiftZ_legSum_abs_le (s : Finset ℕ) (x : ℕ → ℝ) :
    |shiftZ (RHLean.endpoint 7) (Y7Op.legSum x s)|
      ≤ (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
          + RHLean.arithCoeff 5) * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) := by
  set a : ℝ := RHLean.endpoint 7 with ha
  set r : ℕ → ℝ := fun k => RHLean.shiftLengthRescaled a k with hrdef
  have r_apply : ∀ k : ℕ, r k = RHLean.shiftLengthRescaled a k := by
    intro k
    rw [hrdef]
  have hS : RHLean.arithSupport a = ({2, 3, 4, 5, 6} : Finset ℕ) := by
    rw [ha]
    unfold RHLean.arithSupport RHLean.endpoint
    rw [show 2 * (Real.log ((7 : ℕ) : ℝ) / 2) = Real.log ((7 : ℕ) : ℝ) by ring,
      Real.exp_log (by norm_num), Nat.ceil_natCast]
    decide
  have hlog7 : 0 < Real.log 7 := Real.log_pos (by norm_num)
  have hr_eq : ∀ k : ℕ, r k = 2 * Real.log k / Real.log 7 := by
    intro k
    rw [r_apply k, ha, RHLean.shiftLengthRescaled, RHLean.endpoint]
    field_simp
    norm_num
  have hr_lt_one : ∀ k : ℕ, 0 < k → (k : ℝ) ^ 2 < 7 → r k < 1 := by
    intro k hk0 hk
    rw [hr_eq k, div_lt_one hlog7]
    have hlog : 2 * Real.log (k : ℝ) = Real.log ((k : ℝ) ^ 2) := by
      rw [Real.log_pow]
      norm_num
    rw [hlog]
    exact Real.log_lt_log (by positivity) hk
  have hr_gt_one : ∀ k : ℕ, 0 < k → 7 < (k : ℝ) ^ 2 → 1 < r k := by
    intro k hk0 hk
    rw [hr_eq k, lt_div_iff₀ hlog7, one_mul]
    have hlog : 2 * Real.log (k : ℝ) = Real.log ((k : ℝ) ^ 2) := by
      rw [Real.log_pow]
      norm_num
    rw [hlog]
    exact Real.log_lt_log (by norm_num) hk
  have hr_sum : ∀ k : ℕ, 0 < k → 7 < 2 * (k : ℝ) → 2 < r 2 + r k := by
    intro k hk0 hk
    rw [hr_eq 2, hr_eq k, ← add_div, lt_div_iff₀ hlog7]
    have hlog : 2 * Real.log 2 + 2 * Real.log (k : ℝ) = 2 * Real.log (2 * (k : ℝ)) := by
      rw [show Real.log (2 * (k : ℝ)) = Real.log 2 + Real.log (k : ℝ) from by
        rw [Real.log_mul (by norm_num) (by positivity)]]
      ring
    simp only [Nat.cast_ofNat]
    rw [hlog]
    have h : Real.log 7 < Real.log (2 * (k : ℝ)) := Real.log_lt_log (by norm_num) hk
    linarith
  have hr2 : r 2 < 1 := hr_lt_one 2 (by norm_num) (by norm_num)
  have hr3 : 1 < r 3 := hr_gt_one 3 (by norm_num) (by norm_num)
  have hr4 : 1 < r 4 := hr_gt_one 4 (by norm_num) (by norm_num)
  have hr5 : 1 < r 5 := hr_gt_one 5 (by norm_num) (by norm_num)
  have hr6 : 1 < r 6 := hr_gt_one 6 (by norm_num) (by norm_num)
  have hr24 : 2 < r 2 + r 4 := hr_sum 4 (by norm_num) (by norm_num)
  have hr25 : 2 < r 2 + r 5 := hr_sum 5 (by norm_num) (by norm_num)
  have hr26 : 2 < r 2 + r 6 := hr_sum 6 (by norm_num) (by norm_num)
  have hmem : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), k ∈ RHLean.arithSupport a := by
    intro k hk
    rw [hS]
    exact hk
  have hrp : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), 0 < r k := by
    intro k hk
    rw [r_apply k]
    exact Y7Op.shiftLengthRescaled_pos (hmem k hk)
  have hrl : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), r k < 2 := by
    intro k hk
    rw [r_apply k]
    exact Y7Op.shiftLengthRescaled_lt_two (hmem k hk)
  have hc_nn : ∀ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), 0 ≤ RHLean.arithCoeff k := by
    intro k hk
    unfold RHLean.arithCoeff
    exact div_nonneg (by positivity) (Real.sqrt_nonneg k)
  have hc6 : RHLean.arithCoeff 6 = 0 := by
    unfold RHLean.arithCoeff
    rw [show (ArithmeticFunction.vonMangoldt 6 : ℝ) = 0 from by
      rw [ArithmeticFunction.vonMangoldt_apply]
      simp [show ¬ IsPrimePow 6 by decide]]
    simp
  have hc2 : RHLean.arithCoeff 2 ≤ RHLean.arithCoeff 4 + RHLean.arithCoeff 5 := by
    have b := Y7Chain.tailBoxes
    have h2 := b.c2.le_hi
    have h4 := b.c4.lo_le
    have h5 := b.c5.lo_le
    norm_num at h2 h4 h5
    linarith
  have hZsum : shiftZ a (Y7Op.legSum x s)
      = ∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
          ((∫ y in Set.Ioo (-1) (1 - r k),
              Y7Op.legSum x s y * star (Y7Op.legSum x s (y + r k)))
            + (∫ y in Set.Ioo (-1 + r k) 1,
              Y7Op.legSum x s y * star (Y7Op.legSum x s (y - r k)))).re := by
    unfold shiftZ
    simp_rw [← r_apply]
  have hc_nn' : ∀ k ∈ RHLean.arithSupport a, 0 ≤ RHLean.arithCoeff k := by
    intro k hk
    exact hc_nn k (by rwa [hS] at hk)
  have hterm_eq : ∀ k ∈ RHLean.arithSupport a,
      ((∫ y in Set.Ioo (-1) (1 - r k),
          Y7Op.legSum x s y * star (Y7Op.legSum x s (y + r k)))
        + (∫ y in Set.Ioo (-1 + r k) 1,
          Y7Op.legSum x s y * star (Y7Op.legSum x s (y - r k)))).re
      = 2 * ∫ y in Set.Ioo (-1) (1 - r k), U s x y * U s x (y + r k) := by
    intro k hk
    have hk' : k ∈ ({2, 3, 4, 5, 6} : Finset ℕ) := by rwa [hS] at hk
    exact shift_term_eq s x (hrp k hk') (hrl k hk')
  have hterm_le : ∀ k ∈ RHLean.arithSupport a,
      |2 * ∫ y in Set.Ioo (-1) (1 - r k), U s x y * U s x (y + r k)|
      ≤ (∫ y in Set.Ioo (-1) (1 - r k), U s x y ^ 2)
        + ∫ y in Set.Ioo (-1 + r k) 1, U s x y ^ 2 := by
    intro k hk
    have hk' : k ∈ ({2, 3, 4, 5, 6} : Finset ℕ) := by rwa [hS] at hk
    exact shift_term_abs_le s x (hrp k hk') (hrl k hk')
  calc
    |shiftZ a (Y7Op.legSum x s)|
        = |∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
            ((∫ y in Set.Ioo (-1) (1 - r k),
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y + r k)))
              + (∫ y in Set.Ioo (-1 + r k) 1,
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y - r k)))).re| := by rw [hZsum]
      _ ≤ ∑ k ∈ RHLean.arithSupport a, |RHLean.arithCoeff k *
            ((∫ y in Set.Ioo (-1) (1 - r k),
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y + r k)))
              + (∫ y in Set.Ioo (-1 + r k) 1,
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y - r k)))).re| :=
            Finset.abs_sum_le_sum_abs _ _
      _ = ∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
            |((∫ y in Set.Ioo (-1) (1 - r k),
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y + r k)))
              + (∫ y in Set.Ioo (-1 + r k) 1,
                Y7Op.legSum x s y * star (Y7Op.legSum x s (y - r k)))).re| := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [abs_mul, abs_of_nonneg (hc_nn' k hk)]
      _ = ∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
            |2 * ∫ y in Set.Ioo (-1) (1 - r k), U s x y * U s x (y + r k)| := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [hterm_eq k hk]
      _ ≤ ∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
            ((∫ y in Set.Ioo (-1) (1 - r k), U s x y ^ 2)
              + ∫ y in Set.Ioo (-1 + r k) 1, U s x y ^ 2) := by
            apply Finset.sum_le_sum
            intro k hk
            exact mul_le_mul_of_nonneg_left (hterm_le k hk) (hc_nn' k hk)
      _ = ∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
            ((∫ y in Set.Ioo (-1) (1 - r k), U s x y ^ 2)
              + ∫ y in Set.Ioo (-1 + r k) 1, U s x y ^ 2) := by rw [hS]
      _ = ∫ y in Set.Ioo (-1 : ℝ) 1,
            ∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
              ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
                + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)) :=
            shift_sum_eq_integral s x r RHLean.arithCoeff hrp hrl
      _ ≤ ∫ y in Set.Ioo (-1 : ℝ) 1,
            (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
              + RHLean.arithCoeff 5) * U s x y ^ 2 := by
            refine integral_mono_ae ?_ ?_ ?_
            · have hUc : Continuous (U s x) := continuous_U s x
              obtain ⟨B, hB⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1))
                |>.exists_bound_of_continuousOn hUc.continuousOn
              set B' : ℝ := max B 0 with hB'def
              have hB'0 : 0 ≤ B' := le_max_right _ _
              have hBb : ∀ y ∈ Set.Ioo (-1 : ℝ) 1, ‖U s x y‖ ≤ B' := fun y hy =>
                le_trans (hB y ⟨le_of_lt hy.1, le_of_lt hy.2⟩) (le_max_left _ _)
              have hU2 : ∀ y ∈ Set.Ioo (-1 : ℝ) 1, U s x y ^ 2 ≤ B' ^ 2 := by
                intro y hy
                have h1 : |U s x y| ≤ B' := by
                  simpa only [Real.norm_eq_abs] using hBb y hy
                have h2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
                simpa only [sq_abs] using h2
              refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
                ?_ ((∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), |RHLean.arithCoeff k| * (2 * B' ^ 2))) ?_
              · refine Measurable.aestronglyMeasurable ?_
                apply Finset.measurable_sum
                intro k hk
                apply Measurable.mul measurable_const
                exact (Measurable.ite measurableSet_Ioo (hUc.measurable.pow_const 2)
                    measurable_const).add
                  (Measurable.ite measurableSet_Ioo (hUc.measurable.pow_const 2)
                    measurable_const)
              · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
                rw [Real.norm_eq_abs]
                calc |∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
                      ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
                        + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0))|
                    ≤ ∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), |RHLean.arithCoeff k *
                      ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
                        + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0))| :=
                      Finset.abs_sum_le_sum_abs _ _
                  _ ≤ ∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), |RHLean.arithCoeff k| * (2 * B' ^ 2) := by
                      apply Finset.sum_le_sum
                      intro k hk
                      rw [abs_mul]
                      apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
                      have hgad : |(if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
                            + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)|
                          ≤ 2 * B' ^ 2 := by
                        by_cases h1 : y ∈ Set.Ioo (-1) (1 - r k)
                        · by_cases h2 : y ∈ Set.Ioo (-1 + r k) 1
                          · rw [if_pos h1, if_pos h2, abs_of_nonneg (by positivity)]
                            nlinarith [hU2 y hy]
                          · rw [if_pos h1, if_neg h2, add_zero, abs_of_nonneg (sq_nonneg _)]
                            nlinarith [hU2 y hy]
                        · by_cases h2 : y ∈ Set.Ioo (-1 + r k) 1
                          · rw [if_neg h1, if_pos h2, zero_add, abs_of_nonneg (sq_nonneg _)]
                            nlinarith [hU2 y hy]
                          · rw [if_neg h1, if_neg h2, add_zero, abs_zero]
                            positivity
                      exact hgad
            · have hUc : Continuous (U s x) := continuous_U s x
              exact ((hUc.pow 2).const_mul _).integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
            · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
              have hbud := shift_budget_terms r RHLean.arithCoeff y hy.1 hy.2
                hr2 hr3 hr4 hr5 hr6 hr24 hr25 hr26 hc2 hc6
                (hc_nn 2 (by norm_num)) (hc_nn 3 (by norm_num))
                (hc_nn 4 (by norm_num)) (hc_nn 5 (by norm_num))
              have hfact : (∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
                    ((if y ∈ Set.Ioo (-1) (1 - r k) then U s x y ^ 2 else 0)
                      + (if y ∈ Set.Ioo (-1 + r k) 1 then U s x y ^ 2 else 0)))
                  = (∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
                    ((if y ∈ Set.Ioo (-1) (1 - r k) then (1 : ℝ) else 0)
                      + (if y ∈ Set.Ioo (-1 + r k) 1 then (1 : ℝ) else 0)))
                    * U s x y ^ 2 := by
                rw [Finset.sum_mul]
                apply Finset.sum_congr rfl
                intro k hk
                split_ifs <;> ring
              have hbud' : (∑ k ∈ ({2, 3, 4, 5, 6} : Finset ℕ), RHLean.arithCoeff k *
                    ((if y ∈ Set.Ioo (-1) (1 - r k) then (1 : ℝ) else 0)
                      + (if y ∈ Set.Ioo (-1 + r k) 1 then (1 : ℝ) else 0)))
                  ≤ RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
                    + RHLean.arithCoeff 5 := by
                simpa [Finset.sum_insert, Finset.sum_singleton, add_assoc] using hbud
              rw [hfact]
              exact mul_le_mul_of_nonneg_right hbud' (sq_nonneg (U s x y))
      _ = (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
            + RHLean.arithCoeff 5) * (∫ y in Set.Ioo (-1 : ℝ) 1, U s x y ^ 2) := by
            rw [integral_const_mul]
      _ = (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
            + RHLean.arithCoeff 5) * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) := by
            congr 1
            apply integral_congr_ae
            filter_upwards with y
            rw [legSum_eq_ofReal s x y, Complex.sq_norm, Complex.normSq_ofReal]
            ring
noncomputable def localizedFormRescaledZ (a : ℝ) (g : ℝ → ℂ) : ℝ :=
  RHLean.archFormRescaled g + RHLean.c0 a * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2)
    + RHLean.potentialFormRescaled g - RHLean.gammaFormRescaled a g
    - RHLean.polarFormRescaled a g - shiftZ a g
private lemma memLp_two_of_legSum (s : Finset ℕ) (x : ℕ → ℝ) :
    MemLp (Y7Op.legSum x s) 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := by
  have hcont : Continuous (Y7Op.legSum x s) := by
    unfold Y7Op.legSum
    apply continuous_finsetSum
    intro n hn
    exact continuous_const.mul (Complex.continuous_ofReal.comp (Y7Legendre.phi n).continuous)
  have h2 : Continuous (fun y : ℝ => ‖Y7Op.legSum x s y‖ ^ 2) := hcont.norm.pow 2
  have hint : IntegrableOn (fun y : ℝ => ‖Y7Op.legSum x s y‖ ^ 2) (Set.Icc (-1 : ℝ) 1) :=
    h2.integrableOn_Icc
  exact (memLp_two_iff_integrable_sq_norm hcont.measurable.aestronglyMeasurable).mpr
    (hint.mono_set Set.Ioo_subset_Icc_self)
theorem localizedFormRescaledZ_legSum_tail_floor (j : ℕ) (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, 2 * j + 1 ≤ m) :
    Y7Matrix.tailFloor 0 j * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
      ≤ localizedFormRescaledZ (RHLean.endpoint 7) (Y7Op.legSum x s) := by
  set a : ℝ := RHLean.endpoint 7 with ha
  set M : ℝ := ∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2 with hM
  have ha0 : 0 ≤ a := by
    rw [ha]
    unfold RHLean.endpoint
    have h := (Y7Chain.tailBoxes.log7).lo_le
    norm_num at h
    linarith
  have ha1 : a ≤ 1 := by
    rw [ha]
    unfold RHLean.endpoint
    have h := (Y7Chain.tailBoxes.log7).le_hi
    norm_num at h
    linarith
  have hcont : Continuous (Y7Op.legSum x s) := by
    unfold Y7Op.legSum
    apply continuous_finsetSum
    intro n hn
    exact continuous_const.mul (Complex.continuous_ofReal.comp (Y7Legendre.phi n).continuous)
  have hmass : M = ∑ m ∈ s, x m ^ 2 := by
    rw [hM]
    exact Y7Tail.mass_legSum s x
  have harch := Y7Tail.archFormRescaled_legSum_tail_ge (2 * j + 1) s x hs
  have hpot := Y7Tail.potentialFormRescaled_nonneg (Y7Op.legSum x s)
  have hgam := (abs_le.mp (Y7A2.gammaFormRescaled_abs_le_mass ha0 ha1 hcont)).2
  have hpol := Y7Tail.polarFormRescaled_le_mass a ha0 (Y7Op.legSum x s)
    (memLp_two_of_legSum s x)
  have hshift := (abs_le.mp (Y7A2.shiftZ_legSum_abs_le s x)).2
  unfold Y7Matrix.tailFloor localizedFormRescaledZ
  rw [← hM]
  linarith
theorem localizedFormRescaledZ_eq (a : ℝ) (g : ℝ → ℂ) :
    localizedFormRescaledZ a g = RHLean.localizedFormRescaled a g := rfl
lemma diag_sum (s : Finset ℕ) (x : ℕ → ℝ) (f : ℕ → ℝ) :
    (∑ m ∈ s, ∑ n ∈ s, x m * x n * (if m = n then f m else 0))
      = ∑ m ∈ s, f m * x m ^ 2 := by
  apply Finset.sum_congr rfl
  intro m hm
  rw [Finset.sum_eq_single m]
  · simp only [if_true]
    ring
  · intro n hn hnm
    rw [if_neg (Ne.symm hnm), mul_zero]
  · intro hm'
    exact absurd hm hm'
lemma two_mul_div_two_add_one {m : ℕ} (hm : Odd m) : 2 * ((m - 1) / 2) + 1 = m := by
  obtain ⟨k, rfl⟩ := hm
  have h : 2 * k + 1 - 1 = 2 * k := by omega
  rw [h, Nat.mul_div_right k (by norm_num)]
theorem localizedFormRescaledZ_legSum_floor (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) :
    (∑ m ∈ s, Y7Matrix.tailFloor 0 ((m - 1) / 2) * x m ^ 2)
      ≤ localizedFormRescaledZ (RHLean.endpoint 7) (Y7Op.legSum x s) := by
  have ha0 : 0 ≤ RHLean.endpoint 7 := by
    unfold RHLean.endpoint
    have h := (Y7Chain.tailBoxes.log7).lo_le
    norm_num at h
    linarith
  have ha1 : RHLean.endpoint 7 ≤ 1 := by
    unfold RHLean.endpoint
    have h := (Y7Chain.tailBoxes.log7).le_hi
    norm_num at h
    linarith
  have hcont : Continuous (Y7Op.legSum x s) := by
    unfold Y7Op.legSum
    apply continuous_finsetSum
    intro n hn
    exact continuous_const.mul (Complex.continuous_ofReal.comp (Y7Legendre.phi n).continuous)
  have hmass : (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
      = ∑ m ∈ s, x m ^ 2 := Y7Tail.mass_legSum s x
  have harch := Y7Arch.archDiagonalRep s x
  have hc0 := Y7Op.c0Rep (RHLean.endpoint 7) s x
  have hc0diag : (∑ m ∈ s, ∑ n ∈ s,
        x m * x n * (RHLean.c0 (RHLean.endpoint 7) *
          (if m = n then (1 : ℝ) else 0)))
      = ∑ m ∈ s, RHLean.c0 (RHLean.endpoint 7) * x m ^ 2 := by
    rw [show (∑ m ∈ s, ∑ n ∈ s,
        x m * x n * (RHLean.c0 (RHLean.endpoint 7) *
          (if m = n then (1 : ℝ) else 0)))
        = ∑ m ∈ s, ∑ n ∈ s,
          x m * x n * (if m = n then RHLean.c0 (RHLean.endpoint 7) else 0) from by
      apply Finset.sum_congr rfl
      intro m hm
      apply Finset.sum_congr rfl
      intro n hn
      by_cases h : m = n <;> simp [h]]
    exact diag_sum s x (fun _ => RHLean.c0 (RHLean.endpoint 7))
  have hV := Y7Tail.potentialFormRescaled_nonneg (Y7Op.legSum x s)
  have hG := (abs_le.mp
    (Y7A2.gammaFormRescaled_abs_le_mass ha0 ha1 hcont)).2
  have hP := Y7Tail.polarFormRescaled_le_mass (RHLean.endpoint 7) ha0
    (Y7Op.legSum x s) (memLp_two_of_legSum s x)
  have hS := (abs_le.mp (Y7A2.shiftZ_legSum_abs_le s x)).2
  have hST : (∑ m ∈ s, Y7Matrix.tailFloor 0 ((m - 1) / 2) * x m ^ 2)
      = (∑ m ∈ s, Y7Matrix.harmonicR m * x m ^ 2)
        + (∑ m ∈ s, RHLean.c0 (RHLean.endpoint 7) * x m ^ 2)
        - (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
            + RHLean.arithCoeff 5 + RHLean.endpoint 7 / 2
            + 2 * (Real.sinh (RHLean.endpoint 7) - RHLean.endpoint 7))
          * (∑ m ∈ s, x m ^ 2) := by
    rw [Finset.mul_sum]
    have h1 : (∑ m ∈ s, Y7Matrix.harmonicR m * x m ^ 2)
        + (∑ m ∈ s, RHLean.c0 (RHLean.endpoint 7) * x m ^ 2)
        = ∑ m ∈ s, (Y7Matrix.harmonicR m * x m ^ 2
            + RHLean.c0 (RHLean.endpoint 7) * x m ^ 2) := by
      rw [Finset.sum_add_distrib]
    rw [h1, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro m hm
    unfold Y7Matrix.tailFloor
    rw [two_mul_div_two_add_one (hs m hm)]
    ring
  have hb : RHLean.gammaFormRescaled (RHLean.endpoint 7) (Y7Op.legSum x s)
      + RHLean.polarFormRescaled (RHLean.endpoint 7) (Y7Op.legSum x s)
      + Y7A2.shiftZ (RHLean.endpoint 7) (Y7Op.legSum x s)
      ≤ (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
          + RHLean.arithCoeff 5 + RHLean.endpoint 7 / 2
          + 2 * (Real.sinh (RHLean.endpoint 7) - RHLean.endpoint 7))
        * (∑ m ∈ s, x m ^ 2) := by
    have h1 : RHLean.gammaFormRescaled (RHLean.endpoint 7) (Y7Op.legSum x s)
        + RHLean.polarFormRescaled (RHLean.endpoint 7) (Y7Op.legSum x s)
        + Y7A2.shiftZ (RHLean.endpoint 7) (Y7Op.legSum x s)
        ≤ (RHLean.endpoint 7 / 2) * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
          + 2 * (Real.sinh (RHLean.endpoint 7) - RHLean.endpoint 7)
              * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
          + (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
              + RHLean.arithCoeff 5)
              * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) := by
      linarith [hG, hP, hS]
    have h2 : (RHLean.endpoint 7 / 2)
          * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
          + 2 * (Real.sinh (RHLean.endpoint 7) - RHLean.endpoint 7)
              * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
          + (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
              + RHLean.arithCoeff 5)
              * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
        = (RHLean.arithCoeff 2 + RHLean.arithCoeff 3 + RHLean.arithCoeff 4
            + RHLean.arithCoeff 5 + RHLean.endpoint 7 / 2
            + 2 * (Real.sinh (RHLean.endpoint 7) - RHLean.endpoint 7))
          * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) := by ring
    rw [h2] at h1
    rwa [hmass] at h1
  unfold localizedFormRescaledZ
  rw [harch, hc0, diag_sum s x (fun m => Y7Matrix.harmonicR m), hc0diag, hST]
  linarith [hb, hV]
theorem rescaledOperatorM_block_nonneg_of_tail (j : ℕ)
    (hj : 0 ≤ Y7Matrix.tailFloor 0 j)
    (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
    (hs' : ∀ m ∈ s, 2 * j + 1 ≤ m) :
    0 ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n *
      Y7Op.rescaledOperatorM (RHLean.endpoint 7) m n := by
  rw [← Y7Density.formMatrixRep_endpoint_seven s x]
  rw [← localizedFormRescaledZ_eq]
  have hfloor := localizedFormRescaledZ_legSum_floor s x hs
  have hnn : 0 ≤ ∑ m ∈ s, Y7Matrix.tailFloor 0 ((m - 1) / 2) * x m ^ 2 := by
    apply Finset.sum_nonneg
    intro m hm
    have hle : j ≤ (m - 1) / 2 := by
      rw [Nat.le_div_iff_mul_le (by norm_num : 0 < 2)]
      have hm2 := hs' m hm
      omega
    have h1 : Y7Matrix.tailFloor 0 j ≤ Y7Matrix.tailFloor 0 ((m - 1) / 2) :=
      Y7Chain.tailFloor_mono 0 hle
    exact mul_nonneg (le_trans hj h1) (sq_nonneg _)
  linarith
end Y7A2
end
end Inline_Y7_A2
section Inline_Y7_A3
noncomputable section
