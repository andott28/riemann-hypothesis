import RHLeanFullShard01
set_option maxHeartbeats 2000000
set_option maxHeartbeats 800000
section Inline_Y7_Arch
noncomputable section
set_option maxHeartbeats 1000000
open MeasureTheory
open scoped BigOperators
namespace Y7Arch
open Y7Op
open Y7Matrix
noncomputable def archKernelMatrix (m n : ℕ) : ℝ :=
  (1 / 4) * ∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
    (((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y) *
      ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y)) / ‖x - y‖
theorem archKernelMatrix_symm (m n : ℕ) :
    archKernelMatrix m n = archKernelMatrix n m := by
  unfold archKernelMatrix
  congr 1
  apply MeasureTheory.integral_congr_ae
  filter_upwards with x
  apply MeasureTheory.integral_congr_ae
  filter_upwards with y
  ring
theorem archKernelMatrix_zero_left (n : ℕ) : archKernelMatrix 0 n = 0 := by
  have hphi0 : ∀ y : ℝ, (Y7Legendre.phi 0).eval y = (Y7Legendre.phi 0).eval 0 := by
    unfold Y7Legendre.phi
    rw [Y7Legendre.legP_zero, mul_one]
    intro y
    simp
  unfold archKernelMatrix
  have hzero : ∀ x y : ℝ,
      (((Y7Legendre.phi 0).eval x - (Y7Legendre.phi 0).eval y) *
        ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y)) / ‖x - y‖ = 0 := by
    intro x y
    rw [hphi0 x, hphi0 y, sub_self, zero_mul, zero_div]
  simp_rw [hzero]
  simp
theorem archKernelMatrix_zero_right (m : ℕ) : archKernelMatrix m 0 = 0 := by
  rw [archKernelMatrix_symm m 0, archKernelMatrix_zero_left m]
theorem archKernelMatrix_zero_matches (n : ℕ) :
    archKernelMatrix 0 n =
      (if 0 = n then Y7Matrix.harmonicR 0 else 0) := by
  rw [archKernelMatrix_zero_left]
  by_cases h : 0 = n
  · subst h
    simp [Y7Matrix.harmonicR_zero]
  · simp [h]
private lemma abs_phi_sub_le_of_bound {m : ℕ} {C : ℝ}
    (hC : ∀ x ∈ Set.Icc (-1 : ℝ) 1,
      ‖(Polynomial.derivative (Y7Legendre.phi m)).eval x‖ ≤ C)
    {x y : ℝ} (hx : x ∈ Set.Icc (-1 : ℝ) 1) (hy : y ∈ Set.Icc (-1 : ℝ) 1) :
    |(Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y| ≤ C * |x - y| := by
  have hdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
      DifferentiableAt ℝ (fun t : ℝ => (Y7Legendre.phi m).eval t) z :=
    fun z hz => Polynomial.differentiableAt (Y7Legendre.phi m)
  have hbound : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
      ‖deriv (fun t : ℝ => (Y7Legendre.phi m).eval t) z‖ ≤ C := by
    intro z hz
    rw [Polynomial.deriv]
    exact hC z hz
  have h := Convex.norm_image_sub_le_of_norm_deriv_le hdiff hbound
    (convex_Icc (-1 : ℝ) 1) hx hy
  simpa only [Real.norm_eq_abs, abs_sub_comm] using h
private lemma integrableOn_arch_quotient (m n : ℕ) {u : ℝ}
    (hu : u ∈ Set.Ioo (-1 : ℝ) 1) :
    IntegrableOn (fun y : ℝ =>
      ((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y) *
        ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y) / ‖u - y‖)
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨Cm, hCm⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.phi m))).continuousOn
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.phi n))).continuousOn
  have Cm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hCm 0 ⟨by norm_num, by norm_num⟩)
  have Cn0 : 0 ≤ Cn := le_trans (norm_nonneg _) (hCn 0 ⟨by norm_num, by norm_num⟩)
  refine IntegrableOn.of_bound ?hfin ?hmeas (2 * Cm * Cn) ?hbound
  · rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  · have hm : Measurable (fun y : ℝ => (Y7Legendre.phi m).eval y) :=
      (Polynomial.continuous (Y7Legendre.phi m)).measurable
    have hn : Measurable (fun y : ℝ => (Y7Legendre.phi n).eval y) :=
      (Polynomial.continuous (Y7Legendre.phi n)).measurable
    exact (((measurable_const.sub hm).mul (measurable_const.sub hn)).div
      ((continuous_const.sub continuous_id).norm.measurable)).aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
    have hxl : u ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hu.1, le_of_lt hu.2⟩
    have hyl : y ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hm := abs_phi_sub_le_of_bound hCm hxl hyl
    have hn := abs_phi_sub_le_of_bound hCn hxl hyl
    have hdist : ‖u - y‖ ≤ 2 := by
      have hu1 : |u| ≤ 1 := by
        rw [abs_le]
        exact ⟨le_of_lt hu.1, le_of_lt hu.2⟩
      have hy1 : |y| ≤ 1 := by
        rw [abs_le]
        exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      calc ‖u - y‖ ≤ ‖u‖ + ‖y‖ := norm_sub_le _ _
        _ = |u| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ 2 := by linarith
    by_cases huy : u = y
    · subst huy
      have hzero : (((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval u) *
          ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval u)) / ‖u - u‖ = 0 := by
        simp
      rw [hzero, norm_zero]
      exact mul_nonneg (mul_nonneg (by norm_num) Cm0) Cn0
    · have hc : 0 < ‖u - y‖ := by
        rw [norm_pos_iff]
        exact sub_ne_zero.mpr huy
      rw [norm_div, norm_mul, Real.norm_of_nonneg (norm_nonneg (u - y)), div_le_iff₀ hc]
      have hm' : ‖(Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y‖
          ≤ Cm * ‖u - y‖ := by
        simpa only [Real.norm_eq_abs] using hm
      have hn' : ‖(Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y‖
          ≤ Cn * ‖u - y‖ := by
        simpa only [Real.norm_eq_abs] using hn
      calc ‖(Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y‖ *
            ‖(Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y‖
          ≤ (Cm * ‖u - y‖) * (Cn * ‖u - y‖) :=
            mul_le_mul hm' hn' (norm_nonneg _) (mul_nonneg Cm0 (norm_nonneg _))
        _ = Cm * Cn * ‖u - y‖ * ‖u - y‖ := by ring
        _ ≤ Cm * Cn * ‖u - y‖ * 2 :=
            mul_le_mul_of_nonneg_left hdist
              (mul_nonneg (mul_nonneg Cm0 Cn0) (norm_nonneg _))
        _ = 2 * Cm * Cn * ‖u - y‖ := by ring
private lemma integrableOn_arch_quotient_integral (m n : ℕ) :
    IntegrableOn (fun u : ℝ => ∫ y in Set.Ioo (-1 : ℝ) 1,
      ((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y) *
        ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y) / ‖u - y‖)
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨Cm, hCm⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.phi m))).continuousOn
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.phi n))).continuousOn
  have Cm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hCm 0 ⟨by norm_num, by norm_num⟩)
  have Cn0 : 0 ≤ Cn := le_trans (norm_nonneg _) (hCn 0 ⟨by norm_num, by norm_num⟩)
  have hfin : volume (Set.Ioo (-1 : ℝ) 1) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  refine IntegrableOn.of_bound hfin ?hmeas (2 * Cm * Cn * 2) ?hbound
  · have hmeas : Measurable (fun p : ℝ × ℝ =>
        ((Y7Legendre.phi m).eval p.1 - (Y7Legendre.phi m).eval p.2) *
          ((Y7Legendre.phi n).eval p.1 - (Y7Legendre.phi n).eval p.2) /
          ‖p.1 - p.2‖) := by
      have hm1 : Measurable (fun p : ℝ × ℝ => (Y7Legendre.phi m).eval p.1) :=
        ((Polynomial.continuous (Y7Legendre.phi m)).comp continuous_fst).measurable
      have hm2 : Measurable (fun p : ℝ × ℝ => (Y7Legendre.phi m).eval p.2) :=
        ((Polynomial.continuous (Y7Legendre.phi m)).comp continuous_snd).measurable
      have hn1 : Measurable (fun p : ℝ × ℝ => (Y7Legendre.phi n).eval p.1) :=
        ((Polynomial.continuous (Y7Legendre.phi n)).comp continuous_fst).measurable
      have hn2 : Measurable (fun p : ℝ × ℝ => (Y7Legendre.phi n).eval p.2) :=
        ((Polynomial.continuous (Y7Legendre.phi n)).comp continuous_snd).measurable
      exact ((hm1.sub hm2).mul (hn1.sub hn2)).div
        ((continuous_fst.sub continuous_snd).norm.measurable)
    have hf : AEStronglyMeasurable (fun p : ℝ × ℝ =>
        ((Y7Legendre.phi m).eval p.1 - (Y7Legendre.phi m).eval p.2) *
          ((Y7Legendre.phi n).eval p.1 - (Y7Legendre.phi n).eval p.2) /
          ‖p.1 - p.2‖) (volume.prod (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :=
      hmeas.aestronglyMeasurable
    simpa only using (hf.integral_prod_right').mono_measure Measure.restrict_le_self
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with u hu
    have hul : u ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hu.1, le_of_lt hu.2⟩
    have hC : ∀ y ∈ Set.Ioo (-1 : ℝ) 1,
        ‖((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y) *
          ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y) / ‖u - y‖‖
          ≤ 2 * Cm * Cn := by
      intro y hy
      have hyl : y ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      have hm := abs_phi_sub_le_of_bound hCm hul hyl
      have hn := abs_phi_sub_le_of_bound hCn hul hyl
      have hdist : ‖u - y‖ ≤ 2 := by
        have hu1 : |u| ≤ 1 := by
          rw [abs_le]
          exact ⟨le_of_lt hu.1, le_of_lt hu.2⟩
        have hy1 : |y| ≤ 1 := by
          rw [abs_le]
          exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
        calc ‖u - y‖ ≤ ‖u‖ + ‖y‖ := norm_sub_le _ _
          _ = |u| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ 2 := by linarith
      by_cases huy : u = y
      · subst huy
        have hzero : (((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval u) *
            ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval u)) / ‖u - u‖ = 0 := by
          simp
        rw [hzero, norm_zero]
        exact mul_nonneg (mul_nonneg (by norm_num) Cm0) Cn0
      · have hc : 0 < ‖u - y‖ := by
          rw [norm_pos_iff]
          exact sub_ne_zero.mpr huy
        rw [norm_div, norm_mul, Real.norm_of_nonneg (norm_nonneg (u - y)), div_le_iff₀ hc]
        have hm' : ‖(Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y‖
            ≤ Cm * ‖u - y‖ := by
          simpa only [Real.norm_eq_abs] using hm
        have hn' : ‖(Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y‖
            ≤ Cn * ‖u - y‖ := by
          simpa only [Real.norm_eq_abs] using hn
        calc ‖(Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval y‖ *
              ‖(Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval y‖
            ≤ (Cm * ‖u - y‖) * (Cn * ‖u - y‖) :=
              mul_le_mul hm' hn' (norm_nonneg _) (mul_nonneg Cm0 (norm_nonneg _))
          _ = Cm * Cn * ‖u - y‖ * ‖u - y‖ := by ring
          _ ≤ Cm * Cn * ‖u - y‖ * 2 :=
              mul_le_mul_of_nonneg_left hdist
                (mul_nonneg (mul_nonneg Cm0 Cn0) (norm_nonneg _))
          _ = 2 * Cm * Cn * ‖u - y‖ := by ring
    have hb := norm_setIntegral_le_of_norm_le_const (μ := volume) hfin hC
    have hvol : (volume (Set.Ioo (-1 : ℝ) 1)).toReal = 2 := by
      rw [Real.volume_Ioo,
        ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - (-1))]
      norm_num
    rw [measureReal_def, hvol] at hb
    simpa only [mul_assoc] using hb
theorem archFormRescaled_legSum (s : Finset ℕ) (x : ℕ → ℝ) :
    RHLean.archFormRescaled (legSum x s) =
      ∑ m ∈ s, ∑ n ∈ s, x m * x n * archKernelMatrix m n := by
  have hpt : ∀ u v : ℝ, ‖legSum x s u - legSum x s v‖ ^ 2 =
      ∑ m ∈ s, ∑ n ∈ s, x m * x n *
        (((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval v) *
          ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval v)) := by
    intro u v
    have hcast : legSum x s u - legSum x s v =
        ((∑ m ∈ s, x m *
          ((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval v) : ℝ) : ℂ) := by
      rw [show legSum x s u =
            ((∑ m ∈ s, x m * (Y7Legendre.phi m).eval u : ℝ) : ℂ) from by
          simp only [legSum, phiC, Complex.ofReal_sum, Complex.ofReal_mul],
        show legSum x s v =
            ((∑ m ∈ s, x m * (Y7Legendre.phi m).eval v : ℝ) : ℂ) from by
          simp only [legSum, phiC, Complex.ofReal_sum, Complex.ofReal_mul]]
      rw [← Complex.ofReal_sub]
      congr 1
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro m hm
      ring
    rw [hcast, Complex.sq_norm, Complex.normSq_ofReal, Finset.sum_mul_sum]
    apply Finset.sum_congr rfl
    intro m hm
    apply Finset.sum_congr rfl
    intro n hn
    ring
  have hinner : ∀ u ∈ Set.Ioo (-1 : ℝ) 1,
      (∫ v in Set.Ioo (-1 : ℝ) 1,
          ‖legSum x s u - legSum x s v‖ ^ 2 / ‖u - v‖) =
        ∑ m ∈ s, ∑ n ∈ s, x m * x n *
          (∫ v in Set.Ioo (-1 : ℝ) 1,
            (((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval v) *
              ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval v)) / ‖u - v‖) := by
    intro u hu
    have hpt' : (fun v : ℝ => ‖legSum x s u - legSum x s v‖ ^ 2 / ‖u - v‖) =
        fun v => ∑ m ∈ s, ∑ n ∈ s, x m * x n *
          ((((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval v) *
            ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval v)) / ‖u - v‖) := by
      funext v
      rw [hpt u v, Finset.sum_div]
      apply Finset.sum_congr rfl
      intro m hm
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    rw [hpt']
    rw [MeasureTheory.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro m hm
      rw [MeasureTheory.integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro n hn
        rw [← MeasureTheory.integral_const_mul]
      · intro n hn
        exact Integrable.const_mul (integrableOn_arch_quotient m n hu) (x m * x n)
    · intro m hm
      apply integrable_finsetSum
      intro n hn
      exact Integrable.const_mul (integrableOn_arch_quotient m n hu) (x m * x n)
  have houter :
      (∫ u in Set.Ioo (-1 : ℝ) 1,
          ∫ v in Set.Ioo (-1 : ℝ) 1,
            ‖legSum x s u - legSum x s v‖ ^ 2 / ‖u - v‖) =
        ∫ u in Set.Ioo (-1 : ℝ) 1,
          ∑ m ∈ s, ∑ n ∈ s, x m * x n *
            (∫ v in Set.Ioo (-1 : ℝ) 1,
              (((Y7Legendre.phi m).eval u - (Y7Legendre.phi m).eval v) *
                ((Y7Legendre.phi n).eval u - (Y7Legendre.phi n).eval v)) / ‖u - v‖) := by
    apply MeasureTheory.integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with u hu
    exact hinner u hu
  unfold RHLean.archFormRescaled archKernelMatrix
  rw [houter]
  rw [MeasureTheory.integral_finsetSum]
  · rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m hm
    rw [MeasureTheory.integral_finsetSum]
    · rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      rw [MeasureTheory.integral_const_mul]
      ring
    · intro n hn
      exact Integrable.const_mul (integrableOn_arch_quotient_integral m n) (x m * x n)
  · intro m hm
    apply integrable_finsetSum
    intro n hn
    exact Integrable.const_mul (integrableOn_arch_quotient_integral m n) (x m * x n)
theorem archDiagonalRep_of_archKernelMatrix
    (h : ∀ m n : ℕ,
      archKernelMatrix m n = if m = n then Y7Matrix.harmonicR m else 0) :
    Y7Op.ArchDiagonalRep := by
  intro s x
  rw [archFormRescaled_legSum s x]
  apply Finset.sum_congr rfl
  intro m hm
  apply Finset.sum_congr rfl
  intro n hn
  rw [h m n]
private lemma phi_eval_neg (m : ℕ) (x : ℝ) :
    (Y7Legendre.phi m).eval (-x) = (-1 : ℝ) ^ m * (Y7Legendre.phi m).eval x := by
  have h := congr_arg (fun p : Polynomial ℝ => p.eval x) (Y7Legendre.phi_comp_neg_X m)
  simpa only [Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X,
    Polynomial.eval_smul, smul_eq_mul] using h
private lemma setIntegral_Ioo_comp_neg {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℝ → E) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, f (-x)) = ∫ x in Set.Ioo (-1 : ℝ) 1, f x := by
  have hneg : -Set.Ioo (-1 : ℝ) 1 = Set.Ioo (-1 : ℝ) 1 := by
    rw [Set.neg_Ioo]
    norm_num
  have hfun : (Set.Ioo (-1 : ℝ) 1).indicator (fun x => f (-x))
      = fun x => (Set.Ioo (-1 : ℝ) 1).indicator f (-x) := by
    funext x
    rw [Set.indicator_apply, Set.indicator_apply]
    by_cases hx : x ∈ Set.Ioo (-1 : ℝ) 1
    · have hnx : -x ∈ Set.Ioo (-1 : ℝ) 1 := by
        rw [← hneg, Set.mem_neg]
        simpa using hx
      simp [hx, hnx]
    · have hnx : -x ∉ Set.Ioo (-1 : ℝ) 1 := by
        intro h
        apply hx
        rw [← hneg, Set.mem_neg] at h
        simpa using h
      simp [hx, hnx]
  calc (∫ x in Set.Ioo (-1 : ℝ) 1, f (-x))
      = ∫ x, (Set.Ioo (-1 : ℝ) 1).indicator (fun x => f (-x)) x := by
        rw [integral_indicator measurableSet_Ioo]
    _ = ∫ x, (Set.Ioo (-1 : ℝ) 1).indicator f (-x) := by rw [hfun]
    _ = ∫ x, (Set.Ioo (-1 : ℝ) 1).indicator f x := integral_neg_eq_self _ volume
    _ = ∫ x in Set.Ioo (-1 : ℝ) 1, f x := by
        rw [integral_indicator measurableSet_Ioo]
private lemma archKernelMatrix_integrand_neg (m n : ℕ) (x y : ℝ) :
    (((Y7Legendre.phi m).eval (-x) - (Y7Legendre.phi m).eval (-y)) *
        ((Y7Legendre.phi n).eval (-x) - (Y7Legendre.phi n).eval (-y))) /
        ‖(-x) - (-y)‖
      = (-1 : ℝ) ^ (m + n) *
        ((((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y) *
          ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y)) / ‖x - y‖) := by
  rw [phi_eval_neg m x, phi_eval_neg m y, phi_eval_neg n x, phi_eval_neg n y,
    neg_sub_neg, norm_sub_rev]
  rw [show (-1 : ℝ) ^ m * (Y7Legendre.phi m).eval x -
        (-1 : ℝ) ^ m * (Y7Legendre.phi m).eval y
      = (-1 : ℝ) ^ m *
        ((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y) by ring]
  rw [show (-1 : ℝ) ^ n * (Y7Legendre.phi n).eval x -
        (-1 : ℝ) ^ n * (Y7Legendre.phi n).eval y
      = (-1 : ℝ) ^ n *
        ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y) by ring]
  rw [show ((-1 : ℝ) ^ m *
          ((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y)) *
        ((-1 : ℝ) ^ n *
          ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y))
      = (-1 : ℝ) ^ (m + n) *
        (((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y) *
          ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y)) by
    rw [pow_add]
    ring]
  ring
theorem archKernelMatrix_parity (m n : ℕ) (hmn : Odd (m + n)) :
    archKernelMatrix m n = 0 := by
  let F : ℝ → ℝ → ℝ := fun x y =>
    (((Y7Legendre.phi m).eval x - (Y7Legendre.phi m).eval y) *
      ((Y7Legendre.phi n).eval x - (Y7Legendre.phi n).eval y)) / ‖x - y‖
  have hF : ∀ x y : ℝ, F (-x) (-y) = (-1 : ℝ) ^ (m + n) * F x y := by
    intro x y
    dsimp only [F]
    exact archKernelMatrix_integrand_neg m n x y
  have h1 : (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x y)
      = (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x (-y)) := by
    apply MeasureTheory.integral_congr_ae
    filter_upwards with x
    exact (setIntegral_Ioo_comp_neg (f := fun y => F x y)).symm
  have h2 : (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x (-y))
      = (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F (-x) (-y)) := by
    exact (setIntegral_Ioo_comp_neg
      (f := fun x => ∫ y in Set.Ioo (-1 : ℝ) 1, F x (-y))).symm
  have hInt : (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x y)
      = (-1 : ℝ) ^ (m + n) *
        (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x y) := by
    calc (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x y)
        = (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x (-y)) := h1
      _ = (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F (-x) (-y)) := h2
      _ = (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
            (-1 : ℝ) ^ (m + n) * F x y) := by
          apply MeasureTheory.integral_congr_ae
          filter_upwards with x
          apply MeasureTheory.integral_congr_ae
          filter_upwards with y
          exact hF x y
      _ = (-1 : ℝ) ^ (m + n) *
            (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1, F x y) := by
          simp_rw [MeasureTheory.integral_const_mul]
  have hneg : archKernelMatrix m n = (-1 : ℝ) ^ (m + n) * archKernelMatrix m n := by
    unfold archKernelMatrix
    exact (congrArg (fun t : ℝ => (1 / 4) * t) hInt).trans (by ring)
  have h2' : archKernelMatrix m n = -archKernelMatrix m n :=
    calc archKernelMatrix m n = (-1 : ℝ) ^ (m + n) * archKernelMatrix m n := hneg
      _ = -archKernelMatrix m n := by rw [hmn.neg_one_pow, neg_one_mul]
  linarith
noncomputable def archL (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∫ y in Set.Ioo (-1 : ℝ) 1, (f x - f y) / ‖x - y‖
noncomputable def archH (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∫ y in Set.Ioo (-1 : ℝ) 1, (x - y) / ‖x - y‖ * f y
private lemma integrableOn_archL_legP (n : ℕ) {x : ℝ}
    (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    IntegrableOn (fun y : ℝ =>
        ((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖)
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Polynomial.derivative (Y7Legendre.legP n))).continuousOn
  have C0 : 0 ≤ C := le_trans (norm_nonneg _) (hC 0 ⟨by norm_num, by norm_num⟩)
  refine IntegrableOn.of_bound ?hfin ?hmeas C ?hbound
  · rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  · have hm : Measurable (fun y : ℝ => (Y7Legendre.legP n).eval y) :=
      (Polynomial.continuous (Y7Legendre.legP n)).measurable
    exact ((measurable_const.sub hm).div
      ((continuous_const.sub continuous_id).norm.measurable)).aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
    have hxl : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hyl : y ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
        DifferentiableAt ℝ (fun t : ℝ => (Y7Legendre.legP n).eval t) z :=
      fun z hz => Polynomial.differentiableAt (Y7Legendre.legP n)
    have hbound : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
        ‖deriv (fun t : ℝ => (Y7Legendre.legP n).eval t) z‖ ≤ C := by
      intro z hz
      rw [Polynomial.deriv]
      exact hC z hz
    have h := Convex.norm_image_sub_le_of_norm_deriv_le hdiff hbound
      (convex_Icc (-1 : ℝ) 1) hxl hyl
    have h' : ‖(Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y‖
        ≤ C * ‖x - y‖ := by
      simpa only [norm_sub_rev] using h
    rw [norm_div, Real.norm_of_nonneg (norm_nonneg (x - y))]
    by_cases hxy : x = y
    · subst hxy
      simp only [sub_self, norm_zero, div_zero]
      exact C0
    · have hpos : 0 < ‖x - y‖ := by
        rw [norm_pos_iff]
        exact sub_ne_zero.mpr hxy
      rw [div_le_iff₀ hpos]
      exact h'
private lemma integrableOn_archH_legP (n : ℕ) (x : ℝ) :
    IntegrableOn (fun y : ℝ => (x - y) / ‖x - y‖ * (Y7Legendre.legP n).eval y)
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Polynomial.continuous (Y7Legendre.legP n)).continuousOn
  have Cn0 : 0 ≤ Cn := le_trans (norm_nonneg _) (hCn 0 ⟨by norm_num, by norm_num⟩)
  refine IntegrableOn.of_bound ?hfin ?hmeas Cn ?hbound
  · rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  · have hm : Measurable (fun y : ℝ => (Y7Legendre.legP n).eval y) :=
      (Polynomial.continuous (Y7Legendre.legP n)).measurable
    exact (((measurable_const.sub measurable_id).div
      ((continuous_const.sub continuous_id).norm.measurable)).mul hm).aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
    have hyb : ‖(Y7Legendre.legP n).eval y‖ ≤ Cn :=
      hCn y ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hratio : ‖(x - y) / ‖x - y‖‖ ≤ 1 := by
      rw [norm_div, Real.norm_of_nonneg (norm_nonneg (x - y))]
      by_cases hxy : x = y
      · subst hxy
        simp
      · have hpos : 0 < ‖x - y‖ := by
          rw [norm_pos_iff]
          exact sub_ne_zero.mpr hxy
        exact (div_le_one hpos).mpr le_rfl
    rw [norm_mul]
    calc ‖(x - y) / ‖x - y‖‖ * ‖(Y7Legendre.legP n).eval y‖
        ≤ 1 * Cn := mul_le_mul hratio hyb (norm_nonneg _) (by norm_num)
      _ = Cn := one_mul Cn
theorem archL_mul_X_legP (n : ℕ) {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archL (fun y => y * (Y7Legendre.legP n).eval y) x
      = x * archL (fun y => (Y7Legendre.legP n).eval y) x
        + archH (fun y => (Y7Legendre.legP n).eval y) x := by
  unfold archL archH
  have hpt : (fun y : ℝ =>
        (x * (Y7Legendre.legP n).eval x - y * (Y7Legendre.legP n).eval y) / ‖x - y‖)
      = fun y : ℝ =>
          x * (((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖)
          + (x - y) / ‖x - y‖ * (Y7Legendre.legP n).eval y := by
    funext y
    ring
  rw [hpt]
  rw [MeasureTheory.integral_add]
  · rw [MeasureTheory.integral_const_mul]
  · exact (integrableOn_archL_legP n hx).const_mul x
  · exact integrableOn_archH_legP n x
theorem archL_add_smul (n m : ℕ) (a b : ℝ) {x : ℝ}
    (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    archL (fun y => a * (Y7Legendre.legP n).eval y + b * (Y7Legendre.legP m).eval y) x
      = a * archL (fun y => (Y7Legendre.legP n).eval y) x
        + b * archL (fun y => (Y7Legendre.legP m).eval y) x := by
  unfold archL
  have hpt : (fun y : ℝ =>
        (a * (Y7Legendre.legP n).eval x + b * (Y7Legendre.legP m).eval x
          - (a * (Y7Legendre.legP n).eval y + b * (Y7Legendre.legP m).eval y)) / ‖x - y‖)
      = fun y : ℝ =>
          a * (((Y7Legendre.legP n).eval x - (Y7Legendre.legP n).eval y) / ‖x - y‖)
          + b * (((Y7Legendre.legP m).eval x - (Y7Legendre.legP m).eval y) / ‖x - y‖) := by
    funext y
    ring
  rw [hpt]
  rw [MeasureTheory.integral_add]
  · rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
  · exact (integrableOn_archL_legP n hx).const_mul a
  · exact (integrableOn_archL_legP m hx).const_mul b
end Y7Arch
