lemma iteratedDeriv_gammaExt_eq (n : ℕ) :
    iteratedDeriv n gammaExt 0
      = (((n.factorial : ℕ) : ℂ)) * ((Y7Chain.rhoCoeff n : ℚ) : ℂ) := by
  have h := taylorCoeff_gammaExt_eq_rhoCoeff n
  unfold taylorCoeff at h
  have hnf : (((n.factorial : ℕ) : ℂ)) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero n
  have h' := congrArg (fun x : ℂ => (((n.factorial : ℕ) : ℂ)) * x) h
  rw [← mul_assoc, mul_inv_cancel₀ hnf, one_mul] at h'
  exact h'
lemma taylorSum_gammaExt (t : ℝ) :
    (∑ n ∈ Finset.range (241),
        (((n.factorial : ℕ) : ℂ))⁻¹ * ((t : ℂ) ^ n * iteratedDeriv n gammaExt 0))
      = (((rhoTrunc 240).eval t : ℝ) : ℂ) := by
  have hrho : (((rhoTrunc 240).eval t : ℝ) : ℂ)
      = ∑ n ∈ Finset.range (241),
          ((Y7Chain.rhoCoeff n : ℚ) : ℂ) * (t : ℂ) ^ n := by
    rw [rhoTrunc, Polynomial.eval_finsetSum]
    push_cast
    apply Finset.sum_congr rfl
    intro n hn
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    push_cast
    ring
  rw [hrho]
  apply Finset.sum_congr rfl
  intro n hn
  rw [iteratedDeriv_gammaExt_eq]
  have hnf : (((n.factorial : ℕ) : ℂ)) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero n
  field_simp
lemma gammaM_nonneg : 0 ≤ Y7Chain.gammaM (14 / 5) := by
  unfold Y7Chain.gammaM
  have hR : (0 : ℝ) < 14 / 5 := by norm_num
  have hRpi : (14 : ℝ) / 5 < Real.pi := by
    have h3 := Real.pi_gt_three
    norm_num at h3 ⊢
    linarith
  have hs : 0 < Real.sin (14 / 5) := Real.sin_pos_of_pos_of_lt_pi hR hRpi
  have h1 : 0 < Real.exp (14 / 5 / 2) / (2 * Real.sin (14 / 5)) :=
    div_pos (Real.exp_pos _) (mul_pos two_pos hs)
  have h2 : 0 < 1 / (2 * ((14 : ℝ) / 5)) := by positivity
  exact le_of_lt (add_pos h1 h2)
theorem gammaTaylorRemainderLeaf_240 {a : ℝ} (ha0 : 0 ≤ a)
    (ha : 2 * a < (14 : ℝ) / 5) :
    GammaTaylorRemainderLeaf 240 a
      (Y7Chain.gammaM (14 / 5) * (2 * a / (14 / 5)) ^ 241
        / (1 - 2 * a / (14 / 5))) := by
  intro t ht
  rw [Set.mem_Icc] at ht
  obtain ⟨ht0, hta⟩ := ht
  have hR : (0 : ℝ) < 14 / 5 := by norm_num
  have hRpi : (14 : ℝ) / 5 < Real.pi := by
    have h3 := Real.pi_gt_three
    norm_num at h3 ⊢
    linarith
  have hC : 0 ≤ Y7Chain.gammaM (14 / 5) := gammaM_nonneg
  have hf : DiffContOnCl ℂ gammaExt (Metric.ball 0 ((14 : ℝ) / 5)) := by
    refine ⟨?_, ?_⟩
    · intro z hz
      rw [Metric.mem_ball, dist_zero_right] at hz
      rcases eq_or_ne z 0 with rfl | hz0
      · exact analyticAt_gammaExt_zero.differentiableAt.differentiableWithinAt
