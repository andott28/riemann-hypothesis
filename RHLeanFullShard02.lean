section Inline_Y7_TaylorRemainder
noncomputable section
open Complex
open scoped BigOperators Topology
namespace Y7Density
theorem norm_taylor_remainder_le {f : ℂ → ℂ} {R C r : ℝ} (hR : 0 < R) (hC : 0 ≤ C)
    (hf : DiffContOnCl ℂ f (Metric.ball 0 R))
    (hCb : ∀ z ∈ Metric.sphere 0 R, ‖f z‖ ≤ C)
    {z : ℂ} (hz : ‖z‖ ≤ r) (hr : r < R) (hr0 : 0 ≤ r) (N : ℕ) :
    ‖f z - ∑ n ∈ Finset.range N,
        (n.factorial : ℂ)⁻¹ * (z ^ n * iteratedDeriv n f 0)‖
      ≤ C * (r / R) ^ N / (1 - r / R) := by
  have hq0 : 0 ≤ r / R := div_nonneg hr0 hR.le
  have hq1 : r / R < 1 := (div_lt_one hR).2 hr
  have hball : z ∈ Metric.ball 0 R := by
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_of_le_of_lt hz hr
  have hsum := Complex.hasSum_taylorSeries_on_ball (f := f) (c := 0) (r := R)
    hf.differentiableOn hball
  have hsum' : HasSum
      (fun n : ℕ => (n.factorial : ℂ)⁻¹ * (z ^ n * iteratedDeriv n f 0)) (f z) := by
    simpa only [sub_zero, smul_eq_mul] using hsum
  have htail := (hasSum_nat_add_iff' N).2 hsum'
  have hcau : ∀ n : ℕ,
      ‖(n.factorial : ℂ)⁻¹ * (z ^ n * iteratedDeriv n f 0)‖
        ≤ C * (r / R) ^ n := by
    intro n
    have hder := Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le
      n hR hf hCb
    have hzpow : ‖z‖ ^ n ≤ r ^ n :=
      pow_le_pow_left₀ (norm_nonneg z) hz n
    have hnorm : ‖(n.factorial : ℂ)⁻¹ * (z ^ n * iteratedDeriv n f 0)‖
        = (((n.factorial : ℕ) : ℝ))⁻¹ * (‖z‖ ^ n * ‖iteratedDeriv n f 0‖) := by
      simp only [norm_mul, norm_pow, norm_inv, Complex.norm_natCast]
    rw [hnorm]
    calc (((n.factorial : ℕ) : ℝ))⁻¹ * (‖z‖ ^ n * ‖iteratedDeriv n f 0‖)
        ≤ (((n.factorial : ℕ) : ℝ))⁻¹
            * (r ^ n * (((n.factorial : ℕ) : ℝ) * C / R ^ n)) := by
          gcongr
      _ = C * (r / R) ^ n := by
          rw [div_pow]
          field_simp
  have hsumm_geom : Summable (fun n : ℕ => C * (r / R) ^ (n + N)) := by
    have hg := (summable_geometric_of_lt_one hq0 hq1).mul_left (C * (r / R) ^ N)
    refine hg.congr (fun n => ?_)
    rw [pow_add]
    ring
  have hsumm_norm : Summable
      (fun n : ℕ => ‖((n + N).factorial : ℂ)⁻¹
        * (z ^ (n + N) * iteratedDeriv (n + N) f 0)‖) :=
    Summable.of_nonneg_of_le (fun n => norm_nonneg _)
      (fun n => hcau (n + N)) hsumm_geom
  calc ‖f z - ∑ n ∈ Finset.range N,
        (n.factorial : ℂ)⁻¹ * (z ^ n * iteratedDeriv n f 0)‖
      = ‖∑' n : ℕ, ((n + N).factorial : ℂ)⁻¹
          * (z ^ (n + N) * iteratedDeriv (n + N) f 0)‖ := by
        rw [← htail.tsum_eq]
    _ ≤ ∑' n : ℕ, ‖((n + N).factorial : ℂ)⁻¹
          * (z ^ (n + N) * iteratedDeriv (n + N) f 0)‖ :=
        norm_tsum_le_tsum_norm hsumm_norm
    _ ≤ ∑' n : ℕ, C * (r / R) ^ (n + N) :=
        hsumm_norm.tsum_le_tsum (fun n => hcau (n + N)) hsumm_geom
    _ = C * (r / R) ^ N / (1 - r / R) := by
        rw [show (∑' n : ℕ, C * (r / R) ^ (n + N))
            = (C * (r / R) ^ N) * ∑' n : ℕ, (r / R) ^ n from by
          rw [← tsum_mul_left]
          apply tsum_congr
          intro n
          rw [pow_add]
          ring]
        rw [tsum_geometric_of_lt_one hq0 hq1]
        rw [div_eq_mul_inv]
        ring
end Y7Density
namespace Y7Density
private lemma sin_sq_sub_sq_antitone {R : ℝ} (hR0 : 0 ≤ R) :
    ∀ y ∈ Set.Icc 0 R, Real.sin R ^ 2 ≤ R ^ 2 - y ^ 2 + Real.sin y ^ 2 := by
  have hanti : AntitoneOn (fun y : ℝ => R ^ 2 - y ^ 2 + Real.sin y ^ 2)
      (Set.Icc 0 R) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc 0 R) (by fun_prop) (by fun_prop) ?_
    intro y hy
    rw [interior_Icc] at hy
    have hderiv : deriv (fun y : ℝ => R ^ 2 - y ^ 2 + Real.sin y ^ 2) y
        = -2 * y + Real.sin (2 * y) := by
      have h1 : HasDerivAt (fun y : ℝ => R ^ 2 - y ^ 2) (-(2 * y)) y := by
        have h := (hasDerivAt_pow 2 y).const_sub (R ^ 2)
        simpa using h
      have h2 : HasDerivAt (fun y : ℝ => Real.sin y ^ 2) (Real.sin (2 * y)) y := by
        have h := (Real.hasDerivAt_sin y).pow 2
        convert h using 1
        rw [Real.sin_two_mul]
        ring
      have hd := (h1.add h2).deriv
      have hfun : ((fun y : ℝ => R ^ 2 - y ^ 2) + fun y : ℝ => Real.sin y ^ 2)
          = fun y : ℝ => R ^ 2 - y ^ 2 + Real.sin y ^ 2 := by
        funext y
        rfl
      rw [hfun] at hd
      linarith
    rw [hderiv]
    have hy0 : 0 ≤ 2 * y := by linarith [hy.1]
    have := Real.sin_le hy0
    linarith
  intro y hy
  have h := hanti hy ⟨hR0, le_rfl⟩ hy.2
  simp only at h
  linarith
lemma sinh_re (z : ℂ) :
    (Complex.sinh z).re = Real.sinh z.re * Real.cos z.im := by
  have h : (2 : ℂ) * Complex.sinh z = Complex.exp z - Complex.exp (-z) :=
    Complex.two_sinh z
  have h2 := congrArg Complex.re h
  simp only [Complex.mul_re, Complex.sub_re, Complex.exp_re, Complex.neg_re, Complex.neg_im,
    Real.cos_neg] at h2
  norm_num at h2
  rw [← sub_mul] at h2
  have hsinh : Real.sinh z.re = (Real.exp z.re - Real.exp (-z.re)) / 2 := Real.sinh_eq z.re
  have hE : Real.exp z.re - Real.exp (-z.re) = 2 * Real.sinh z.re := by linarith
  rw [hE] at h2
  ring_nf at h2
  linarith
lemma sinh_im (z : ℂ) :
    (Complex.sinh z).im = Real.cosh z.re * Real.sin z.im := by
  have h : (2 : ℂ) * Complex.sinh z = Complex.exp z - Complex.exp (-z) :=
    Complex.two_sinh z
  have h2 := congrArg Complex.im h
  simp only [Complex.mul_im, Complex.sub_im, Complex.exp_im, Complex.neg_re, Complex.neg_im,
    Real.sin_neg] at h2
  norm_num at h2
  rw [← add_mul] at h2
  have hcosh : Real.cosh z.re = (Real.exp z.re + Real.exp (-z.re)) / 2 := Real.cosh_eq z.re
  have hE : Real.exp z.re + Real.exp (-z.re) = 2 * Real.cosh z.re := by linarith
  rw [hE] at h2
  ring_nf at h2
  linarith
lemma normSq_sinh (z : ℂ) :
    Complex.normSq (Complex.sinh z) = Real.sinh z.re ^ 2 + Real.sin z.im ^ 2 := by
  rw [Complex.normSq_apply, sinh_re z, sinh_im z]
  nlinarith [Real.cosh_sq z.re, Real.sin_sq_add_cos_sq z.im]
theorem sin_le_norm_sinh {R : ℝ} (hR0 : 0 ≤ R) (hR : R < Real.pi) {z : ℂ}
    (hz : ‖z‖ = R) : Real.sin R ≤ ‖Complex.sinh z‖ := by
  have hnormSq : z.re ^ 2 + z.im ^ 2 = R ^ 2 := by
    have h := Complex.sq_norm z
    rw [hz, Complex.normSq_apply] at h
    linarith
  have him_le : |z.im| ≤ R := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg z.re, sq_nonneg z.im, hnormSq]
  have hbound := sin_sq_sub_sq_antitone hR0 |z.im| ⟨abs_nonneg _, him_le⟩
  have hsin_abs : Real.sin |z.im| ^ 2 = Real.sin z.im ^ 2 := by
    have hπ : |z.im| ≤ Real.pi := by linarith [him_le, hR]
    have h1 : |Real.sin z.im| = Real.sin |z.im| :=
      Real.abs_sin_eq_sin_abs_of_abs_le_pi hπ
    rw [← h1, sq_abs]
  have h1 : R ^ 2 - |z.im| ^ 2 + Real.sin |z.im| ^ 2
      = z.re ^ 2 + Real.sin z.im ^ 2 := by
    rw [sq_abs, hsin_abs]
    linarith
  rw [h1] at hbound
  have hsq : Real.sin R ^ 2 ≤ Complex.normSq (Complex.sinh z) := by
    calc Real.sin R ^ 2 ≤ z.re ^ 2 + Real.sin z.im ^ 2 := hbound
      _ ≤ Real.sinh z.re ^ 2 + Real.sin z.im ^ 2 := by
          have hx : z.re ^ 2 ≤ Real.sinh z.re ^ 2 := by
            have h1 : |z.re| ≤ |Real.sinh z.re| := by
              have h2 := Real.self_le_sinh_iff.mpr (abs_nonneg z.re)
              rwa [← Real.abs_sinh z.re] at h2
            exact sq_le_sq.mpr h1
          linarith
      _ = Complex.normSq (Complex.sinh z) := (normSq_sinh z).symm
  have hsq' : Real.sin R ^ 2 ≤ ‖Complex.sinh z‖ ^ 2 := by
    rwa [Complex.normSq_eq_norm_sq] at hsq
  have := (sq_le_sq.mp hsq')
  rwa [abs_of_nonneg (Real.sin_nonneg_of_nonneg_of_le_pi hR0 hR.le),
    abs_of_nonneg (norm_nonneg _)] at this
theorem norm_gammaFull_le {R : ℝ} (hR0 : 0 < R) (hR : R < Real.pi) {z : ℂ}
    (hz : ‖z‖ = R) :
    ‖gammaFull z‖ ≤ Real.exp (R / 2) / (2 * Real.sin R) + 1 / (2 * R) := by
  have hsin : Real.sin R ≤ ‖Complex.sinh z‖ :=
    sin_le_norm_sinh hR0.le hR hz
  have hsinpos : 0 < Real.sin R := Real.sin_pos_of_pos_of_lt_pi hR0 hR
  have hexp : ‖Complex.exp (z / 2)‖ ≤ Real.exp (R / 2) := by
    calc ‖Complex.exp (z / 2)‖ ≤ Real.exp ‖z / 2‖ := Complex.norm_exp_le_exp_norm _
      _ = Real.exp (R / 2) := by
          rw [norm_div, hz, Complex.norm_two]
  unfold gammaFull
  calc ‖Complex.exp (z / 2) / (2 * Complex.sinh z) - 1 / (2 * z)‖
      ≤ ‖Complex.exp (z / 2) / (2 * Complex.sinh z)‖ + ‖1 / (2 * z)‖ :=
        norm_sub_le _ _
    _ = ‖Complex.exp (z / 2)‖ / (2 * ‖Complex.sinh z‖) + 1 / (2 * R) := by
        rw [norm_div, norm_div, norm_mul, norm_mul, Complex.norm_two, hz]
        norm_num
    _ ≤ Real.exp (R / 2) / (2 * Real.sin R) + 1 / (2 * R) := by
        have hden : 2 * Real.sin R ≤ 2 * ‖Complex.sinh z‖ := by linarith
        have h1 : ‖Complex.exp (z / 2)‖ / (2 * ‖Complex.sinh z‖)
            ≤ Real.exp (R / 2) / (2 * Real.sin R) := by
          calc ‖Complex.exp (z / 2)‖ / (2 * ‖Complex.sinh z‖)
              ≤ Real.exp (R / 2) / (2 * ‖Complex.sinh z‖) :=
                div_le_div_of_nonneg_right hexp (by positivity)
            _ ≤ Real.exp (R / 2) / (2 * Real.sin R) :=
                div_le_div_of_nonneg_left (Real.exp_pos _).le (by linarith) hden
        exact add_le_add h1 le_rfl
end Y7Density
end
