      simpa only [hμ] using hF_int
    simp only [hμ]
    exact (MeasureTheory.integral_prod
      (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
      (fun p : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖p.1 - p.2‖ *
        (g p.1 * star (g p.2)).re) hF_int_eta)
  have hmemg : MemLp g 2 μ := memLp_two_of_continuous' hg
  have hmem1 : MemLp (fun _ : ℝ => (1 : ℂ)) 2 μ :=
    memLp_two_of_continuous' continuous_const
  have hcs := l2_integral_mul_le' hmemg hmem1
  have hInt1 : (∫ x in Set.Ioo (-1 : ℝ) 1, ‖(1 : ℂ)‖ ^ 2) = 2 := by
    have hc : (∫ x in Set.Ioo (-1 : ℝ) 1, (1 : ℝ)) = 2 := by
      rw [integral_const]
      simp only [smul_eq_mul, mul_one, Measure.real]
      rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
