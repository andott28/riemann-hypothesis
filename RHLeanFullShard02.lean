theorem posSemidef_finset_quadform_nonneg {ι : Type*} [Fintype ι] [DecidableEq ι]
    (M : Matrix ι ι ℝ) (h : M.PosSemidef) (t : Finset ι) (v : ι → ℝ) :
    0 ≤ ∑ i ∈ t, ∑ j ∈ t, v i * v j * M i j := by
  classical
  have h' : (M.submatrix (fun i : {x // x ∈ t} => i.1)
      (fun j : {x // x ∈ t} => j.1)).PosSemidef := h.submatrix _
  have hnil := h'.dotProduct_mulVec_nonneg (fun i : {x // x ∈ t} => v i.1)
  simp only [star_trivial, dotProduct, mulVec, Finset.univ_eq_attach] at hnil
  rw [show (∑ i ∈ t, ∑ j ∈ t, v i * v j * M i j)
      = ∑ i ∈ t.attach, ∑ j ∈ t.attach, v ↑i * v ↑j * M ↑i ↑j from by
        rw [← Finset.sum_attach]
        apply Finset.sum_congr rfl
        intro i hi
        rw [← Finset.sum_attach]]
  simpa only [Finset.mul_sum, Matrix.submatrix_apply, mul_assoc, mul_left_comm, mul_comm] using hnil
theorem finalMatrix_quadform_nonneg {n : Type*} [Fintype n] [DecidableEq n]
    (AU WL Scrit Corr : Matrix (Fin 7) (Fin 7) ℝ) (θ : ℝ)
    (hAUsym : AU.IsSymm) (hWLsym : WL.IsSymm)
    (hScritsym : Scrit.IsSymm) (hCorrsym : Corr.IsSymm)
    (hAU : Y7AssemblyBox.InBox Y7AssemblyBox.AUlo Y7AssemblyBox.AUhi AU)
    (hWL : Y7AssemblyBox.InBox Y7AssemblyBox.WLlo Y7AssemblyBox.WLhi WL)
    (hScrit : Y7AssemblyBox.InBox Y7AssemblyBox.Scrit_lo Y7AssemblyBox.Scrit_hi Scrit)
    (hCorr : Y7AssemblyBox.InBox Y7AssemblyBox.Corrlo Y7AssemblyBox.Corrhi Corr)
    (hθ : θ = 1 / 5)
    (A : Matrix (Fin 7) (Fin 7) ℝ) (B : Matrix (Fin 7) n ℝ) (d : n → ℝ)
    (hd : ∀ j, 0 < d j)
    (hSc : (A - B * (Matrix.diagonal d)⁻¹ * B.conjTranspose
      - Y7Assembly.finalMatrix AU WL Scrit Corr θ).PosSemidef)
    (t : Finset (Fin 7 ⊕ n)) (v : Fin 7 ⊕ n → ℝ) :
    0 ≤ ∑ i ∈ t, ∑ j ∈ t, v i * v j *
      (Matrix.fromBlocks A B B.conjTranspose (Matrix.diagonal d)) i j :=
  posSemidef_finset_quadform_nonneg _
    (Y7Density.finalMatrix_block_posSemidef AU WL Scrit Corr θ hAUsym hWLsym
      hScritsym hCorrsym hAU hWL hScrit hCorr hθ A B d hd hSc) t v
end Y7A3
end
