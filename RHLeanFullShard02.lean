section Inline_Y7_GammaCoeff
noncomputable section
open Complex
open scoped BigOperators Topology
namespace Y7Density
noncomputable def taylorCoeff (f : ℂ → ℂ) (n : ℕ) : ℂ :=
  (((n.factorial : ℕ) : ℂ))⁻¹ * iteratedDeriv n f 0
noncomputable def gammaCoeff (n : ℕ) : ℂ := taylorCoeff gammaExt n
theorem gammaExt_functional_identity :
    (fun z : ℂ => (1 + 2 * z * gammaExt z) * (Complex.exp (2 * z) - 1))
      =ᶠ[𝓝 (0 : ℂ)] (fun z : ℂ => 2 * z * Complex.exp (3 * z / 2)) := by
  have h14 : (14 : ℝ) / 5 < Real.pi := by
    have h3 := Real.pi_gt_three
    norm_num at h3 ⊢
    linarith
  filter_upwards [Metric.ball_mem_nhds (0 : ℂ)
    (show (0 : ℝ) < 14 / 5 by norm_num)] with z hz
  rcases eq_or_ne z 0 with rfl | hz0
  · simp [gammaExt]
  · have hnorm : ‖z‖ < (14 : ℝ) / 5 := by
      simpa [Metric.mem_ball, dist_zero_right] using hz
    have hsinh : Complex.sinh z ≠ 0 :=
      sinh_ne_zero_of_norm_lt_pi (norm_pos_iff.mpr hz0) (lt_trans hnorm h14)
    rw [gammaExt_of_ne hz0]
    exact gammaFull_functional_identity hz0 hsinh
theorem analyticAt_gammaExt_zero : AnalyticAt ℂ gammaExt 0 :=
  hasFPowerSeriesOnBall_gammaExt.analyticAt
theorem contDiffAt_gammaExt_zero (n : WithTop ℕ∞) : ContDiffAt ℂ n gammaExt 0 :=
  analyticAt_gammaExt_zero.contDiffAt
theorem iteratedDeriv_functional_identity (n : ℕ) :
    iteratedDeriv n (fun z : ℂ => (1 + 2 * z * gammaExt z) * (Complex.exp (2 * z) - 1)) 0
      = iteratedDeriv n (fun z : ℂ => 2 * z * Complex.exp (3 * z / 2)) 0 :=
  Filter.EventuallyEq.iteratedDeriv_eq n gammaExt_functional_identity
lemma taylorCoeff_zero (f : ℂ → ℂ) : taylorCoeff f 0 = f 0 := by
  unfold taylorCoeff
  simp
lemma taylorCoeff_add {f g : ℂ → ℂ} {n : ℕ}
    (hf : ContDiffAt ℂ n f 0) (hg : ContDiffAt ℂ n g 0) :
    taylorCoeff (f + g) n = taylorCoeff f n + taylorCoeff g n := by
  unfold taylorCoeff
  rw [iteratedDeriv_add hf hg]
  ring
lemma taylorCoeff_sub {f g : ℂ → ℂ} {n : ℕ}
    (hf : ContDiffAt ℂ n f 0) (hg : ContDiffAt ℂ n g 0) :
    taylorCoeff (f - g) n = taylorCoeff f n - taylorCoeff g n := by
  unfold taylorCoeff
  rw [iteratedDeriv_sub hf hg]
  ring
lemma taylorCoeff_const_mul (c : ℂ) (f : ℂ → ℂ) (n : ℕ) :
    taylorCoeff (fun z => c * f z) n = c * taylorCoeff f n := by
  unfold taylorCoeff
  rw [iteratedDeriv_const_mul_field]
  ring
lemma taylorCoeff_const (c : ℂ) (n : ℕ) :
    taylorCoeff (fun _ : ℂ => c) n = if n = 0 then c else 0 := by
  unfold taylorCoeff
  rw [iteratedDeriv_const]
  by_cases hn : n = 0 <;> simp [hn]
lemma taylorCoeff_id (n : ℕ) : taylorCoeff id n = if n = 1 then 1 else 0 := by
  unfold taylorCoeff
  rw [iteratedDeriv_id]
  by_cases h0 : n = 0
  · simp [h0]
  · by_cases h1 : n = 1 <;> simp [h0, h1]
lemma iteratedDeriv_exp_eq (n : ℕ) : iteratedDeriv n Complex.exp = Complex.exp := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [iteratedDeriv_succ, ih]
      funext z
      exact (Complex.hasDerivAt_exp z).deriv
lemma taylorCoeff_exp (c : ℂ) (n : ℕ) :
    taylorCoeff (fun z : ℂ => Complex.exp (c * z)) n =
      c ^ n / (((n.factorial : ℕ) : ℂ)) := by
  unfold taylorCoeff
  rw [iteratedDeriv_comp_const_mul (f := Complex.exp)
    (by fun_prop : ContDiff ℂ n Complex.exp) c]
  simp only [mul_zero, iteratedDeriv_exp_eq, Complex.exp_zero, mul_one]
  rw [div_eq_inv_mul]
lemma taylorCoeff_mul {f g : ℂ → ℂ} {n : ℕ}
    (hf : ContDiffAt ℂ n f 0) (hg : ContDiffAt ℂ n g 0) :
    taylorCoeff (f * g) n
      = ∑ i ∈ Finset.range (n + 1), taylorCoeff f i * taylorCoeff g (n - i) := by
  unfold taylorCoeff
  rw [iteratedDeriv_mul hf hg]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  have hile : i ≤ n := by omega
  have hfac : ((n.choose i : ℕ) : ℂ) * ((i.factorial : ℕ) : ℂ)
      * (((n - i).factorial : ℕ) : ℂ) = ((n.factorial : ℕ) : ℂ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial hile
  have hch : ((n.choose i : ℕ) : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hile).ne'
  have hif : ((i.factorial : ℕ) : ℂ) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero i
  have hnif : (((n - i).factorial : ℕ) : ℂ) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero (n - i)
  rw [← hfac]
  field_simp
lemma taylorCoeff_gammaPoly (n : ℕ) :
    taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) n
      = if n = 0 then 1 else 2 * gammaCoeff (n - 1) := by
  rcases eq_or_ne n 0 with rfl | hn
  · rw [taylorCoeff_zero]
    norm_num
  · have h1 : taylorCoeff (fun _ : ℂ => (1 : ℂ)) n = 0 := by
      rw [taylorCoeff_const]
      simp [hn]
    have h2 : taylorCoeff (fun z : ℂ => 2 * z * gammaExt z) n
        = 2 * taylorCoeff (fun z : ℂ => z * gammaExt z) n := by
      simpa [mul_assoc] using taylorCoeff_const_mul (2 : ℂ) (fun z : ℂ => z * gammaExt z) n
    have h3 : taylorCoeff (fun z : ℂ => z * gammaExt z) n = gammaCoeff (n - 1) := by
      change taylorCoeff (id * gammaExt) n = gammaCoeff (n - 1)
      rw [taylorCoeff_mul contDiffAt_id (contDiffAt_gammaExt_zero n)]
      rw [Finset.sum_eq_single 1]
      · rw [taylorCoeff_id]
        simp [gammaCoeff]
      · intro i hi hi1
        rw [taylorCoeff_id]
        simp [hi1]
      · intro hmem
        exact absurd (Finset.mem_range.mpr (by omega)) hmem
    have hadd : taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) n
        = taylorCoeff (fun _ : ℂ => (1 : ℂ)) n
          + taylorCoeff (fun z : ℂ => 2 * z * gammaExt z) n := by
      change taylorCoeff ((fun _ : ℂ => (1 : ℂ)) + (fun z : ℂ => 2 * z * gammaExt z)) n
        = taylorCoeff (fun _ : ℂ => (1 : ℂ)) n
          + taylorCoeff (fun z : ℂ => 2 * z * gammaExt z) n
      rw [taylorCoeff_add (f := fun _ : ℂ => (1 : ℂ))
        (g := fun z : ℂ => 2 * z * gammaExt z) contDiffAt_const
        ((contDiffAt_const.mul contDiffAt_id).mul (contDiffAt_gammaExt_zero n))]
    rw [hadd, h1, h2, h3]
    simp [hn]
lemma taylorCoeff_expTwoSubOne (n : ℕ) :
    taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) n
      = if n = 0 then 0 else (2 : ℂ) ^ n / (((n.factorial : ℕ) : ℂ)) := by
  rcases eq_or_ne n 0 with rfl | hn
  · simp [taylorCoeff_zero]
  · have hsub : taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) n
        = taylorCoeff (fun z : ℂ => Complex.exp (2 * z)) n
          - taylorCoeff (fun _ : ℂ => (1 : ℂ)) n := by
      change taylorCoeff ((fun z : ℂ => Complex.exp (2 * z)) - (fun _ : ℂ => (1 : ℂ))) n
        = taylorCoeff (fun z : ℂ => Complex.exp (2 * z)) n
          - taylorCoeff (fun _ : ℂ => (1 : ℂ)) n
      rw [taylorCoeff_sub (f := fun z : ℂ => Complex.exp (2 * z))
        (g := fun _ : ℂ => (1 : ℂ))
        (ContDiffAt.comp (x := (0 : ℂ)) Complex.contDiff_exp.contDiffAt
          (contDiffAt_const.mul contDiffAt_id))
        contDiffAt_const]
    rw [hsub, taylorCoeff_exp, taylorCoeff_const]
    simp [hn]
lemma taylorCoeff_gammaPoly_succ (j : ℕ) :
    taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) (j + 1) = 2 * gammaCoeff j := by
  rw [taylorCoeff_gammaPoly]
  simp
lemma taylorCoeff_expTwoSubOne_succ (k : ℕ) :
    taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) (k + 1)
      = (2 : ℂ) ^ (k + 1) / (((k + 1).factorial : ℕ) : ℂ) := by
  rw [taylorCoeff_expTwoSubOne]
  simp
theorem taylorCoeff_functional_identity (n : ℕ) :
    taylorCoeff (fun z : ℂ => (1 + 2 * z * gammaExt z) * (Complex.exp (2 * z) - 1)) n
      = taylorCoeff (fun z : ℂ => 2 * z * Complex.exp (3 * z / 2)) n := by
  unfold taylorCoeff
  rw [iteratedDeriv_functional_identity]
lemma taylorCoeff_two_mul_id (n : ℕ) :
    taylorCoeff (fun z : ℂ => 2 * z) n = if n = 1 then 2 else 0 := by
  have h : taylorCoeff (fun z : ℂ => 2 * z) n = 2 * taylorCoeff id n := by
    simpa using taylorCoeff_const_mul (2 : ℂ) id n
  rw [h, taylorCoeff_id]
  by_cases hn : n = 1 <;> simp [hn]
lemma taylorCoeff_gammaLHS (m : ℕ) :
    taylorCoeff (fun z : ℂ => (1 + 2 * z * gammaExt z) * (Complex.exp (2 * z) - 1)) (m + 2)
      = (2 : ℂ) ^ (m + 2) / (((m + 2).factorial : ℕ) : ℂ)
        + 2 * ∑ j ∈ Finset.range (m + 1),
            gammaCoeff j * ((2 : ℂ) ^ (m + 1 - j) / (((m + 1 - j).factorial : ℕ) : ℂ)) := by
  change taylorCoeff ((fun z : ℂ => 1 + 2 * z * gammaExt z)
      * (fun z : ℂ => Complex.exp (2 * z) - 1)) (m + 2) = _
  have hmul := taylorCoeff_mul (f := fun z : ℂ => 1 + 2 * z * gammaExt z)
    (g := fun z : ℂ => Complex.exp (2 * z) - 1)
    (contDiffAt_const.add ((contDiffAt_const.mul contDiffAt_id).mul
      (contDiffAt_gammaExt_zero (m + 2))))
    ((ContDiffAt.comp (x := (0 : ℂ)) Complex.contDiff_exp.contDiffAt
      (contDiffAt_const.mul contDiffAt_id)).sub contDiffAt_const)
  rw [hmul]
  rw [Finset.sum_range_succ']
  rw [Finset.sum_range_succ]
  simp only [Nat.sub_zero, show m + 1 + 1 = m + 2 by omega, Nat.sub_self]
  have hF0 : taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) 0 *
      taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) (m + 2)
      = (2 : ℂ) ^ (m + 2) / (((m + 2).factorial : ℕ) : ℂ) := by
    simp [taylorCoeff_gammaPoly, taylorCoeff_expTwoSubOne]
  have hFlast : taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) (m + 2) *
      taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) 0 = 0 := by
    simp [taylorCoeff_expTwoSubOne]
  have hFj : ∀ j ∈ Finset.range (m + 1),
      taylorCoeff (fun z : ℂ => 1 + 2 * z * gammaExt z) (j + 1) *
        taylorCoeff (fun z : ℂ => Complex.exp (2 * z) - 1) (m + 2 - (j + 1))
      = 2 * (gammaCoeff j
          * ((2 : ℂ) ^ (m + 1 - j) / (((m + 1 - j).factorial : ℕ) : ℂ))) := by
    intro j hj
    rw [Finset.mem_range] at hj
    rw [taylorCoeff_gammaPoly_succ, taylorCoeff_expTwoSubOne,
      show m + 2 - (j + 1) = m + 1 - j by omega]
    rw [ite_eq_right (by omega : ¬ m + 1 - j = 0)]
    ring
  rw [hF0, hFlast, Finset.sum_congr rfl hFj, ← Finset.mul_sum]
  ring
lemma taylorCoeff_gammaRHS (m : ℕ) :
    taylorCoeff (fun z : ℂ => 2 * z * Complex.exp (3 * z / 2)) (m + 2)
      = 2 * (3 / 2 : ℂ) ^ (m + 1) / (((m + 1).factorial : ℕ) : ℂ) := by
  change taylorCoeff ((fun z : ℂ => 2 * z)
      * (fun z : ℂ => Complex.exp (3 * z / 2))) (m + 2) = _
  have hmul := taylorCoeff_mul (f := fun z : ℂ => 2 * z)
    (g := fun z : ℂ => Complex.exp (3 * z / 2)) (n := m + 2)
    (contDiffAt_const.mul contDiffAt_id)
    (ContDiffAt.comp (x := (0 : ℂ)) Complex.contDiff_exp.contDiffAt
      ((contDiffAt_const.mul contDiffAt_id).div_const 2))
  rw [hmul]
  rw [Finset.sum_eq_single 1]
  · rw [show m + 2 - 1 = m + 1 by omega]
    have hexp : taylorCoeff (fun z : ℂ => Complex.exp (3 * z / 2)) (m + 1)
        = (3 / 2 : ℂ) ^ (m + 1) / (((m + 1).factorial : ℕ) : ℂ) := by
      rw [show (fun z : ℂ => Complex.exp (3 * z / 2))
          = fun z : ℂ => Complex.exp ((3 / 2 : ℂ) * z) by
        funext z
        ring_nf]
      exact taylorCoeff_exp (3 / 2) (m + 1)
    rw [hexp]
    simp [taylorCoeff_two_mul_id]
    ring
  · intro i hi hi1
    rw [taylorCoeff_two_mul_id]
    simp [hi1]
  · intro hmem
    exact absurd (Finset.mem_range.mpr (by omega)) hmem
theorem gammaCoeff_raw (m : ℕ) :
    (2 : ℂ) ^ (m + 2) / (((m + 2).factorial : ℕ) : ℂ)
      + 2 * ∑ j ∈ Finset.range (m + 1),
          gammaCoeff j * ((2 : ℂ) ^ (m + 1 - j) / (((m + 1 - j).factorial : ℕ) : ℂ))
      = 2 * (3 / 2 : ℂ) ^ (m + 1) / (((m + 1).factorial : ℕ) : ℂ) := by
  rw [← taylorCoeff_gammaLHS m, taylorCoeff_functional_identity, taylorCoeff_gammaRHS]
theorem gammaCoeff_recurrence (m : ℕ) :
    2 * gammaCoeff m
      + ∑ j ∈ Finset.Icc 2 (m + 1),
          ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ))) * gammaCoeff (m + 1 - j)
      = (3 / 2 : ℂ) ^ (m + 1) / (((m + 1).factorial : ℕ) : ℂ)
        - (2 : ℂ) ^ (m + 1) / (((m + 2).factorial : ℕ) : ℂ) := by
  have h := gammaCoeff_raw m
  have hsplit : (∑ j ∈ Finset.range (m + 1),
        gammaCoeff j * ((2 : ℂ) ^ (m + 1 - j) / (((m + 1 - j).factorial : ℕ) : ℂ)))
      = 2 * gammaCoeff m
        + ∑ j ∈ Finset.Icc 2 (m + 1),
            ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ))) * gammaCoeff (m + 1 - j) := by
    rw [Finset.sum_range_succ]
    have htop : gammaCoeff m
        * ((2 : ℂ) ^ (m + 1 - m) / (((m + 1 - m).factorial : ℕ) : ℂ))
        = 2 * gammaCoeff m := by
      rw [show m + 1 - m = 1 by omega]
      ring
    have hbij : (∑ j ∈ Finset.range m,
          gammaCoeff j * ((2 : ℂ) ^ (m + 1 - j) / (((m + 1 - j).factorial : ℕ) : ℂ)))
        = ∑ j ∈ Finset.Icc 2 (m + 1),
            ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ))) * gammaCoeff (m + 1 - j) := by
      refine Finset.sum_bij (fun j _ => m + 1 - j) ?_ ?_ ?_ ?_
      · intro j hj
        rw [Finset.mem_range] at hj
        rw [Finset.mem_Icc]
        omega
      · intro j₁ h₁ j₂ h₂ heq
        rw [Finset.mem_range] at h₁ h₂
        omega
      · intro k hk
        rw [Finset.mem_Icc] at hk
        refine ⟨m + 1 - k, ?_, ?_⟩
        · rw [Finset.mem_range]; omega
        · omega
      · intro j hj
        rw [Finset.mem_range] at hj
        rw [show m + 1 - (m + 1 - j) = j by omega]
        ring
    rw [htop, hbij]
    ring
  rw [hsplit] at h
  have hA : (2 : ℂ) ^ (m + 2) / (((m + 2).factorial : ℕ) : ℂ)
      = 2 * ((2 : ℂ) ^ (m + 1) / (((m + 2).factorial : ℕ) : ℂ)) := by
    rw [show m + 2 = m + 1 + 1 by omega, pow_succ]
    ring
  rw [hA] at h
  linear_combination (1 / 2 : ℂ) * h
theorem taylorCoeff_gammaExt_eq_rhoCoeff (m : ℕ) :
    taylorCoeff gammaExt m = ((Y7Chain.rhoCoeff m : ℚ) : ℂ) := by
  change gammaCoeff m = ((Y7Chain.rhoCoeff m : ℚ) : ℂ)
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    have hγ := gammaCoeff_recurrence m
    have hρℝ := rhoCoeff_recurrence' m
    have hρ : 2 * ((Y7Chain.rhoCoeff m : ℚ) : ℂ)
        + ∑ j ∈ Finset.Icc 2 (m + 1),
            ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ)))
              * ((Y7Chain.rhoCoeff (m + 1 - j) : ℚ) : ℂ)
        = (3 / 2 : ℂ) ^ (m + 1) / (((m + 1).factorial : ℕ) : ℂ)
          - (2 : ℂ) ^ (m + 1) / (((m + 2).factorial : ℕ) : ℂ) := by
      have h := congrArg (fun x : ℝ => (x : ℂ)) hρℝ
      push_cast at h ⊢
      exact h
    have hsum : (∑ j ∈ Finset.Icc 2 (m + 1),
          ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ))) * gammaCoeff (m + 1 - j))
        = ∑ j ∈ Finset.Icc 2 (m + 1),
            ((2 : ℂ) ^ j / (((j.factorial : ℕ) : ℂ)))
              * ((Y7Chain.rhoCoeff (m + 1 - j) : ℚ) : ℂ) := by
      apply Finset.sum_congr rfl
      intro j hj
      have hj2 : 2 ≤ j := (Finset.mem_Icc.mp hj).1
      have hjle : j ≤ m + 1 := (Finset.mem_Icc.mp hj).2
      have hlt : m + 1 - j < m := by omega
      rw [ih (m + 1 - j) hlt]
    have h1 : 2 * gammaCoeff m = 2 * ((Y7Chain.rhoCoeff m : ℚ) : ℂ) :=
      add_right_cancel (hγ.trans (by rw [← hsum] at hρ; exact hρ.symm))
    exact mul_left_cancel₀ (by norm_num : (2 : ℂ) ≠ 0) h1
theorem taylorCoeff_gammaFull_eq_rhoCoeff (n : ℕ) :
    taylorCoeff gammaExt n = ((Y7Chain.rhoCoeff n : ℚ) : ℂ) :=
  taylorCoeff_gammaExt_eq_rhoCoeff n
lemma gammaExt_ofReal_re (t : ℝ) :
    (gammaExt (t : ℂ)).re = RHLean.gammaKernel t := by
  rcases eq_or_ne t 0 with rfl | ht
