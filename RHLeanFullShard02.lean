section Inline_Y7_Approx
noncomputable section
set_option maxHeartbeats 2000000
open MeasureTheory
open scoped BigOperators
namespace Y7Approx
noncomputable def sinhTerm (t : ℝ) (n : ℕ) : ℝ :=
  t ^ (2 * n + 1) / (((2 * n + 1).factorial : ℕ) : ℝ)
lemma sinhTerm_nonneg (t : ℝ) (ht : 0 ≤ t) (n : ℕ) : 0 ≤ sinhTerm t n := by
  unfold sinhTerm
  exact div_nonneg (pow_nonneg ht _) (Nat.cast_nonneg _)
lemma sinhTerm_succ (t : ℝ) (n : ℕ) :
    sinhTerm t (n + 1) = sinhTerm t n *
      (t ^ 2 / (((2 * n + 2) * (2 * n + 3) : ℕ) : ℝ)) := by
  unfold sinhTerm
  have hpow : t ^ (2 * n + 3) = t ^ (2 * n + 1) * t ^ 2 := by
    rw [show 2 * n + 3 = 2 * n + 1 + 2 by ring, pow_add]
  have hfact : (((2 * n + 3).factorial : ℕ) : ℝ)
      = (((2 * n + 1).factorial : ℕ) : ℝ) * (((2 * n + 2) * (2 * n + 3) : ℕ) : ℝ) := by
    rw [show 2 * n + 3 = 2 * n + 1 + 2 by ring]
    rw [show 2 * n + 1 + 2 = (2 * n + 1 + 1) + 1 by ring, Nat.factorial_succ]
    rw [show 2 * n + 1 + 1 = (2 * n + 1) + 1 by ring, Nat.factorial_succ]
    push_cast
    ring
  rw [show 2 * (n + 1) + 1 = 2 * n + 3 by ring, hfact, hpow]
  field_simp
lemma sinhTerm_tail_le (t : ℝ) (ht : 0 ≤ t) (n : ℕ) :
    sinhTerm t (n + 100) ≤
      (t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
        (t ^ 2 / (202 * 203 : ℝ)) ^ n := by
  induction n with
  | zero =>
      simp only [pow_zero, mul_one]
      unfold sinhTerm
      norm_num
  | succ n ih =>
      have hA : 0 ≤ t ^ 201 / (((201).factorial : ℕ) : ℝ) :=
        div_nonneg (pow_nonneg ht _) (Nat.cast_nonneg _)
      have hq : 0 ≤ t ^ 2 / (202 * 203 : ℝ) :=
        div_nonneg (sq_nonneg t) (by norm_num)
      have hratio : t ^ 2 / (((2 * (n + 100) + 2) * (2 * (n + 100) + 3) : ℕ) : ℝ)
          ≤ t ^ 2 / (202 * 203 : ℝ) := by
        apply div_le_div_of_nonneg_left (sq_nonneg t)
        · norm_num
        · push_cast
          nlinarith
      have h1 : sinhTerm t (n + 100) *
            (t ^ 2 / (((2 * (n + 100) + 2) * (2 * (n + 100) + 3) : ℕ) : ℝ))
          ≤ ((t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
                (t ^ 2 / (202 * 203 : ℝ)) ^ n) *
              (t ^ 2 / (202 * 203 : ℝ)) :=
        mul_le_mul ih hratio
          (div_nonneg (sq_nonneg t) (Nat.cast_nonneg _))
          (mul_nonneg hA (pow_nonneg hq n))
      have h2 : ((t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
                (t ^ 2 / (202 * 203 : ℝ)) ^ n) *
              (t ^ 2 / (202 * 203 : ℝ))
          = (t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
              (t ^ 2 / (202 * 203 : ℝ)) ^ (n + 1) := by
        rw [pow_succ]
        ring
      refine le_trans (le_of_eq ?_) (le_trans h1 (le_of_eq h2))
      rw [show n + 1 + 100 = (n + 100) + 1 by ring, sinhTerm_succ]
theorem sinh_sub_partial_le (t : ℝ) (ht0 : 0 ≤ t) (ht : t ≤ 1 / 2) :
    Real.sinh t - ∑ d ∈ Finset.range 100, sinhTerm t d
      ≤ t ^ 201 / (((201).factorial : ℕ) : ℝ)
          / (1 - t ^ 2 / (202 * 203 : ℝ)) := by
  have hsum : HasSum (sinhTerm t) (Real.sinh t) := Real.hasSum_sinh t
  have hsummable : Summable (sinhTerm t) := hsum.summable
  rw [← hsum.tsum_eq, ← hsummable.sum_add_tsum_nat_add 100]
  rw [add_sub_cancel_left]
  have hq0 : 0 ≤ t ^ 2 / (202 * 203 : ℝ) := div_nonneg (sq_nonneg t) (by norm_num)
  have hq1 : t ^ 2 / (202 * 203 : ℝ) < 1 := by
    rw [div_lt_one (by norm_num : (0 : ℝ) < 202 * 203)]
    nlinarith [ht0, ht]
  have hgeom : HasSum (fun i => (t ^ 2 / (202 * 203 : ℝ)) ^ i)
      (1 - t ^ 2 / (202 * 203 : ℝ))⁻¹ :=
    hasSum_geometric_of_norm_lt_one (by rwa [Real.norm_eq_abs, abs_of_nonneg hq0])
  have htail : ∑' i, sinhTerm t (i + 100) ≤
      t ^ 201 / (((201).factorial : ℕ) : ℝ)
        / (1 - t ^ 2 / (202 * 203 : ℝ)) := by
    have hg : HasSum (fun i => (t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
        (t ^ 2 / (202 * 203 : ℝ)) ^ i)
        ((t ^ 201 / (((201).factorial : ℕ) : ℝ)) *
          (1 - t ^ 2 / (202 * 203 : ℝ))⁻¹) :=
      hgeom.mul_left _
    have h := ((summable_nat_add_iff 100).mpr hsummable).tsum_le_tsum
      (fun i => sinhTerm_tail_le t ht0 i) hg.summable
    rw [hg.tsum_eq] at h
    simpa only [div_eq_mul_inv] using h
  exact htail
theorem sinh_remainder_bound (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    Real.sinh (a / 2) - Y7Chain.sinhTaylorFun a 1 100 ≤ Y7Chain.sinhRemainder a := by
  have h := sinh_sub_partial_le (a / 2) (by linarith) (by linarith)
  have hbridge : (∑ d ∈ Finset.range 100, sinhTerm (a / 2) d)
      = Y7Chain.sinhTaylorFun a 1 100 := by
    unfold Y7Chain.sinhTaylorFun sinhTerm
    apply Finset.sum_congr rfl
    intro d hd
    rw [show a * 1 / 2 = a / 2 by ring]
  rw [hbridge] at h
  simpa only [Y7Chain.sinhRemainder] using h
lemma sinhTerm_neg (t : ℝ) (d : ℕ) : sinhTerm (-t) d = -sinhTerm t d := by
  unfold sinhTerm
  rw [Odd.neg_pow (show Odd (2 * d + 1) from ⟨d, by ring⟩)]
  ring
lemma sinh_sub_partial_nonneg (t : ℝ) (ht0 : 0 ≤ t) :
    0 ≤ Real.sinh t - ∑ d ∈ Finset.range 100, sinhTerm t d := by
  have hsum : HasSum (sinhTerm t) (Real.sinh t) := Real.hasSum_sinh t
  have h := hsum.summable.sum_le_tsum (Finset.range 100)
    (fun d _ => sinhTerm_nonneg t ht0 d)
  rw [hsum.tsum_eq] at h
  exact sub_nonneg.mpr h
lemma sinhRemainder_mono (a t : ℝ) (ht0 : 0 ≤ t) (hta : t ≤ a / 2) (ha1 : a ≤ 1) :
    t ^ 201 / (((201).factorial : ℕ) : ℝ) / (1 - t ^ 2 / (202 * 203 : ℝ))
      ≤ (a / 2) ^ 201 / (((201).factorial : ℕ) : ℝ)
          / (1 - (a / 2) ^ 2 / (202 * 203 : ℝ)) := by
  have ha0 : 0 ≤ a / 2 := le_trans ht0 hta
  have ht2 : t ^ 2 ≤ (a / 2) ^ 2 := by
    simpa only [sq] using mul_self_le_mul_self ht0 hta
  have hnum : t ^ 201 / (((201).factorial : ℕ) : ℝ)
      ≤ (a / 2) ^ 201 / (((201).factorial : ℕ) : ℝ) :=
    div_le_div_of_nonneg_right (pow_le_pow_left₀ ht0 hta 201) (Nat.cast_nonneg _)
  have hden_pos : 0 < 1 - (a / 2) ^ 2 / (202 * 203 : ℝ) := by
    have : (a / 2) ^ 2 / (202 * 203 : ℝ) < 1 := by
      rw [div_lt_one (by norm_num : (0 : ℝ) < 202 * 203)]
      nlinarith [ha0, ha1]
    linarith
  have hden_le : 1 - (a / 2) ^ 2 / (202 * 203 : ℝ)
      ≤ 1 - t ^ 2 / (202 * 203 : ℝ) := by
    have : t ^ 2 / (202 * 203 : ℝ) ≤ (a / 2) ^ 2 / (202 * 203 : ℝ) :=
      div_le_div_of_nonneg_right ht2 (by norm_num)
    linarith
  have hB0 : 0 ≤ (a / 2) ^ 201 / (((201).factorial : ℕ) : ℝ) :=
    div_nonneg (pow_nonneg ha0 _) (Nat.cast_nonneg _)
  calc t ^ 201 / (((201).factorial : ℕ) : ℝ) / (1 - t ^ 2 / (202 * 203 : ℝ))
      ≤ (a / 2) ^ 201 / (((201).factorial : ℕ) : ℝ)
          / (1 - t ^ 2 / (202 * 203 : ℝ)) :=
        div_le_div_of_nonneg_right hnum (by linarith [hden_le, hden_pos])
    _ ≤ (a / 2) ^ 201 / (((201).factorial : ℕ) : ℝ)
          / (1 - (a / 2) ^ 2 / (202 * 203 : ℝ)) :=
        div_le_div_of_nonneg_left hB0 hden_pos hden_le
theorem abs_sinh_sub_partial_le (a t : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ht : |t| ≤ a / 2) :
    |Real.sinh t - ∑ d ∈ Finset.range 100, sinhTerm t d| ≤ Y7Chain.sinhRemainder a := by
  have ht_le : t ≤ a / 2 := (abs_le.mp ht).2
  by_cases ht0 : 0 ≤ t
  · have hle := sinh_sub_partial_le t ht0 (by linarith [ha1, ht_le])
    rw [abs_of_nonneg (sinh_sub_partial_nonneg t ht0)]
    refine le_trans hle ?_
    simpa only [Y7Chain.sinhRemainder] using sinhRemainder_mono a t ht0 ht_le ha1
  · have ht0' : t < 0 := lt_of_not_ge ht0
    have hs0 : 0 ≤ -t := by linarith
    have hsa : -t ≤ a / 2 := by linarith [(abs_le.mp ht).1]
    have hle := sinh_sub_partial_le (-t) hs0 (by linarith [ha1, hsa])
    have hbound : |Real.sinh (-t) - ∑ d ∈ Finset.range 100, sinhTerm (-t) d|
        ≤ Y7Chain.sinhRemainder a := by
      rw [abs_of_nonneg (sinh_sub_partial_nonneg (-t) hs0)]
      refine le_trans hle ?_
      simpa only [Y7Chain.sinhRemainder] using sinhRemainder_mono a (-t) hs0 hsa ha1
    have hodd : Real.sinh t - ∑ d ∈ Finset.range 100, sinhTerm t d
        = -(Real.sinh (-t) - ∑ d ∈ Finset.range 100, sinhTerm (-t) d) := by
      rw [Real.sinh_neg]
      simp only [sinhTerm_neg]
      rw [Finset.sum_neg_distrib]
      ring
    rw [hodd, abs_neg]
    exact hbound
theorem sinh_uniform_error_sq_le (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (x : ℝ)
    (hx : |x| ≤ 1) :
    ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2
      ≤ (Y7Chain.sinhRemainder a) ^ 2 := by
  have ht : |a * x / 2| ≤ a / 2 := by
    rw [abs_div, abs_mul, abs_of_nonneg ha0,
      abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    apply div_le_div_of_nonneg_right _ (by norm_num : (0 : ℝ) ≤ 2)
    have := mul_le_mul_of_nonneg_left hx ha0
    simpa using this
  have h := abs_sinh_sub_partial_le a (a * x / 2) ha0 ha1 ht
  have hbridge : Y7Chain.sinhTaylorFun a x 100 =
      ∑ d ∈ Finset.range 100, sinhTerm (a * x / 2) d := by
    unfold Y7Chain.sinhTaylorFun sinhTerm
    apply Finset.sum_congr rfl
    intro d _
    ring
  have hcast : (RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)
      = (((Real.sinh (a * x / 2) -
          ∑ d ∈ Finset.range 100, sinhTerm (a * x / 2) d : ℝ)) : ℂ) := by
    rw [hbridge]
    simp only [RHLean.sRescaled]
    push_cast
    ring
  rw [hcast]
  have hnorm : ‖(((Real.sinh (a * x / 2) -
        ∑ d ∈ Finset.range 100, sinhTerm (a * x / 2) d : ℝ)) : ℂ)‖ ^ 2
      = (Real.sinh (a * x / 2) -
          ∑ d ∈ Finset.range 100, sinhTerm (a * x / 2) d) ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_ofReal]
    ring
  rw [hnorm]
  have h' := pow_le_pow_left₀ (abs_nonneg _) h 2
  rwa [sq_abs] at h'
theorem sinh_l2_error_le (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    (∫ x in Set.Ioo (-1 : ℝ) 1,
        ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2)
      ≤ 2 * (Y7Chain.sinhRemainder a) ^ 2 := by
  have hpoint : ∀ x ∈ Set.Ioo (-1 : ℝ) 1,
      ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2
        ≤ (Y7Chain.sinhRemainder a) ^ 2 := by
    intro x hx
    apply sinh_uniform_error_sq_le a ha0 ha1 x
    rw [abs_le]
    exact ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  have hInt1 : IntegrableOn (fun x : ℝ =>
      ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    have hcont : Continuous (fun x : ℝ =>
        ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2) := by
      unfold RHLean.sRescaled Y7Chain.sinhTaylorFun
      fun_prop
    exact (integrableOn_Icc_iff_integrableOn_Ioo).mp hcont.integrableOn_Icc
  have hInt2 : IntegrableOn (fun _ : ℝ => (Y7Chain.sinhRemainder a) ^ 2)
      (Set.Ioo (-1 : ℝ) 1) :=
    integrableOn_const (C := (Y7Chain.sinhRemainder a) ^ 2) (s := Set.Ioo (-1 : ℝ) 1)
      (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top)
  calc ∫ x in Set.Ioo (-1 : ℝ) 1,
        ‖(RHLean.sRescaled a x) - ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)‖ ^ 2
      ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, (Y7Chain.sinhRemainder a) ^ 2 :=
        setIntegral_mono_on (hf := hInt1) (hg := hInt2) measurableSet_Ioo hpoint
    _ = 2 * (Y7Chain.sinhRemainder a) ^ 2 := by
        rw [setIntegral_const]
        simp only [smul_eq_mul]
        change (volume (Set.Ioo (-1 : ℝ) 1)).toReal * (Y7Chain.sinhRemainder a) ^ 2
            = 2 * (Y7Chain.sinhRemainder a) ^ 2
        rw [Real.volume_Ioo,
          ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - (-1))]
        ring
lemma abs_normSq_sub_le (u v : ℂ) :
    |‖u‖ ^ 2 - ‖v‖ ^ 2| ≤ (2 * ‖u‖ + ‖u - v‖) * ‖u - v‖ := by
  have h1 : ‖v‖ ≤ ‖u‖ + ‖u - v‖ := by
    simpa using norm_sub_le u (u - v)
  have hsum : ‖u‖ + ‖v‖ ≤ 2 * ‖u‖ + ‖u - v‖ := by linarith
  have hrev : |‖u‖ - ‖v‖| ≤ ‖u - v‖ := abs_norm_sub_norm_le u v
  have hsq : ‖u‖ ^ 2 - ‖v‖ ^ 2 = (‖u‖ - ‖v‖) * (‖u‖ + ‖v‖) := by ring
  rw [hsq, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖u‖ + ‖v‖)]
  calc |‖u‖ - ‖v‖| * (‖u‖ + ‖v‖)
      ≤ ‖u - v‖ * (2 * ‖u‖ + ‖u - v‖) :=
        mul_le_mul hrev hsum (by positivity) (norm_nonneg _)
    _ = (2 * ‖u‖ + ‖u - v‖) * ‖u - v‖ := by ring
lemma abs_two_mul_abs_normSq_sub_le (a : ℝ) (ha : 0 ≤ a) (u v : ℂ) :
    |2 * a * (‖u‖ ^ 2 - ‖v‖ ^ 2)|
      ≤ 2 * a * ((2 * ‖u‖ + ‖u - v‖) * ‖u - v‖) := by
  rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 * a)]
  exact mul_le_mul_of_nonneg_left (abs_normSq_sub_le u v) (by positivity)
lemma normSq_sRescaled (a x : ℝ) :
    ‖RHLean.sRescaled a x‖ ^ 2 = (Real.cosh (a * x) - 1) / 2 := by
  have h2 : a * x = 2 * (a * x / 2) := by ring
  have hcs := Real.cosh_sq_sub_sinh_sq (a * x / 2)
  simp only [RHLean.sRescaled, Complex.sq_norm, Complex.normSq_ofReal]
  conv_rhs => rw [h2, Real.cosh_two_mul]
  nlinarith [hcs]
theorem integral_cosh_sub_one (a : ℝ) (ha : a ≠ 0) :
    (∫ x in (-1 : ℝ)..1, (Real.cosh (a * x) - 1) / 2) = Real.sinh a / a - 1 := by
  have hderiv : ∀ x ∈ Set.uIcc (-1 : ℝ) 1,
      HasDerivAt (fun y : ℝ => Real.sinh (a * y) / (2 * a) - y / 2)
        ((Real.cosh (a * x) - 1) / 2) x := by
    intro x _
    have h1 : HasDerivAt (fun y : ℝ => Real.sinh (a * y) / (2 * a))
        (Real.cosh (a * x) * a / (2 * a)) x := by
      simpa using ((Real.hasDerivAt_sinh (a * x)).comp x
        ((hasDerivAt_const x a).mul (hasDerivAt_id x))).div_const (2 * a)
    have h2 : HasDerivAt (fun y : ℝ => y / 2) (1 / 2) x :=
      (hasDerivAt_id x).div_const 2
    have hsub := h1.sub h2
    have hval : Real.cosh (a * x) * a / (2 * a) - 1 / 2
        = (Real.cosh (a * x) - 1) / 2 := by
      field_simp [ha]
    rwa [hval] at hsub
  have hint : IntervalIntegrable (fun x : ℝ => (Real.cosh (a * x) - 1) / 2) volume (-1) 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
  have hcalc : Real.sinh (a * 1) / (2 * a) - 1 / 2
      - (Real.sinh (a * (-1)) / (2 * a) - (-1) / 2) = Real.sinh a / a - 1 := by
    rw [mul_one, mul_neg, mul_one, Real.sinh_neg]
    field_simp [ha]
    ring
  rw [hcalc]
theorem norm_sq_sRescaled_integral (a : ℝ) (ha : a ≠ 0) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2) = Real.sinh a / a - 1 := by
  simp_rw [normSq_sRescaled a]
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  exact integral_cosh_sub_one a ha
lemma sqrt_two_mul_sq (R : ℝ) (hR : 0 ≤ R) :
    Real.sqrt (2 * R ^ 2) = Real.sqrt 2 * R := by
  rw [show (2 : ℝ) * R ^ 2 = (Real.sqrt 2 * R) ^ 2 by
    rw [mul_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]]
  exact Real.sqrt_sq (mul_nonneg (Real.sqrt_nonneg _) hR)
noncomputable def sTrunc (a x : ℝ) : ℂ :=
  ((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)
noncomputable def polarInnerApprox (a : ℝ) (g : ℝ → ℂ) : ℂ :=
  ∫ x in Set.Ioo (-1 : ℝ) 1, star (sTrunc a x) * g x
private lemma memLp_two_of_continuous {f : ℝ → ℂ} (hf : Continuous f) :
    MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := by
  have hcont : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := hf.norm.pow 2
  have hint : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2) (Set.Icc (-1 : ℝ) 1) volume :=
    hcont.integrableOn_Icc
  exact (memLp_two_iff_integrable_sq_norm hf.measurable.aestronglyMeasurable).mpr
    (hint.mono_set Set.Ioo_subset_Icc_self)
private lemma l2_integral_mul_le {f g : ℝ → ℂ}
    (hf : MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ * ‖g x‖)
      ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have h := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (f := f) (g := g) (p := (2 : ℝ)) (q := (2 : ℝ))
    Real.HolderConjugate.two_two (by simpa using hf) (by simpa using hg)
  simp_rw [Real.rpow_two] at h
  rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at h
  simpa using h
theorem norm_polarInnerRescaled_le (a : ℝ) (g : ℝ → ℂ)
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    ‖RHLean.polarInnerRescaled a g‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have hf : MemLp (RHLean.sRescaled a) 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) :=
    memLp_two_of_continuous (by unfold RHLean.sRescaled; fun_prop)
  calc ‖RHLean.polarInnerRescaled a g‖
      = ‖∫ x in Set.Ioo (-1 : ℝ) 1, star (RHLean.sRescaled a x) * g x‖ := by
        rw [RHLean.polarInnerRescaled]
    _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖star (RHLean.sRescaled a x) * g x‖ :=
        norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1)) _
    _ = ∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ * ‖g x‖ := by
        apply integral_congr_ae
        filter_upwards with x
        rw [norm_mul, norm_star]
    _ ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) :=
        l2_integral_mul_le hf hg
lemma sinhRemainder_nonneg (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) :
    0 ≤ Y7Chain.sinhRemainder a := by
  unfold Y7Chain.sinhRemainder
  apply div_nonneg
  · exact div_nonneg (pow_nonneg (by linarith : (0 : ℝ) ≤ a / 2) 201)
      (Nat.cast_nonneg _)
  · have hlt : (a / 2) ^ 2 / (202 * 203 : ℝ) < 1 := by
      rw [div_lt_one (by norm_num : (0 : ℝ) < 202 * 203)]
      nlinarith [ha0, ha1]
    linarith
private instance enNRealHolderTriple_two_two :
    ENNReal.HolderTriple (2 : ENNReal) (2 : ENNReal) 1 := by
  simpa using Real.HolderConjugate.two_two.ennrealOfReal
theorem norm_polarInner_sub_approx_le_raw (a : ℝ) (g : ℝ → ℂ)
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    ‖RHLean.polarInnerRescaled a g - polarInnerApprox a g‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1,
            ‖RHLean.sRescaled a x - sTrunc a x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have hf1 : MemLp (RHLean.sRescaled a) 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) :=
    memLp_two_of_continuous (by unfold RHLean.sRescaled; fun_prop)
  have hf2 : MemLp (sTrunc a) 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) :=
    memLp_two_of_continuous (by unfold sTrunc Y7Chain.sinhTaylorFun; fun_prop)
  have hf : MemLp (fun x => RHLean.sRescaled a x - sTrunc a x) 2
      (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := hf1.sub hf2
  have hint1 : Integrable (fun x => star (RHLean.sRescaled a x) * g x)
      (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := hf1.star.integrable_mul hg
  have hint2 : Integrable (fun x => star (sTrunc a x) * g x)
      (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := hf2.star.integrable_mul hg
  have hdecomp : RHLean.polarInnerRescaled a g - polarInnerApprox a g
      = ∫ x in Set.Ioo (-1 : ℝ) 1,
          (star (RHLean.sRescaled a x) - star (sTrunc a x)) * g x := by
    rw [RHLean.polarInnerRescaled, polarInnerApprox]
    rw [← integral_sub hint1 hint2]
    apply integral_congr_ae
    filter_upwards with x
    ring
  rw [hdecomp]
  calc ‖∫ x in Set.Ioo (-1 : ℝ) 1,
        (star (RHLean.sRescaled a x) - star (sTrunc a x)) * g x‖
      ≤ ∫ x in Set.Ioo (-1 : ℝ) 1,
          ‖(star (RHLean.sRescaled a x) - star (sTrunc a x)) * g x‖ :=
        norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1)) _
    _ = ∫ x in Set.Ioo (-1 : ℝ) 1,
          ‖RHLean.sRescaled a x - sTrunc a x‖ * ‖g x‖ := by
        apply integral_congr_ae
        filter_upwards with x
        simp only [norm_mul, ← star_sub, norm_star]
    _ ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1,
          ‖RHLean.sRescaled a x - sTrunc a x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) :=
        l2_integral_mul_le hf hg
theorem norm_polarInner_sub_approx_le (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (g : ℝ → ℂ) (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    ‖RHLean.polarInnerRescaled a g - polarInnerApprox a g‖
      ≤ Real.sqrt 2 * Y7Chain.sinhRemainder a
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have h := norm_polarInner_sub_approx_le_raw a g hg
  have hsqrt : Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1,
        ‖RHLean.sRescaled a x - sTrunc a x‖ ^ 2)
      ≤ Real.sqrt 2 * Y7Chain.sinhRemainder a := by
    have he := sinh_l2_error_le a ha0 ha1
    have he' : (∫ x in Set.Ioo (-1 : ℝ) 1,
        ‖RHLean.sRescaled a x - sTrunc a x‖ ^ 2)
        ≤ 2 * (Y7Chain.sinhRemainder a) ^ 2 := by
      simpa only [sTrunc] using he
    calc Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1,
          ‖RHLean.sRescaled a x - sTrunc a x‖ ^ 2)
        ≤ Real.sqrt (2 * Y7Chain.sinhRemainder a ^ 2) := Real.sqrt_le_sqrt he'
      _ = Real.sqrt 2 * Y7Chain.sinhRemainder a :=
          sqrt_two_mul_sq _ (sinhRemainder_nonneg a ha0 ha1)
  exact h.trans (mul_le_mul_of_nonneg_right hsqrt (Real.sqrt_nonneg _))
private lemma abs_rankOne_sub_le (a S M r : ℝ) (u v : ℂ)
    (ha0 : 0 ≤ a) (hM : 0 ≤ M) (hr : 0 ≤ r)
    (hu : ‖u‖ ≤ Real.sqrt S * Real.sqrt M)
    (huv : ‖u - v‖ ≤ Real.sqrt 2 * r * Real.sqrt M) :
    |2 * a * ‖u‖ ^ 2 - 2 * a * ‖v‖ ^ 2|
      ≤ 2 * a * (2 * Real.sqrt S * Real.sqrt 2 * r + 2 * r ^ 2) * M := by
  calc |2 * a * ‖u‖ ^ 2 - 2 * a * ‖v‖ ^ 2|
      = |2 * a * (‖u‖ ^ 2 - ‖v‖ ^ 2)| := by
        congr 1
        ring
    _ ≤ 2 * a * ((2 * ‖u‖ + ‖u - v‖) * ‖u - v‖) :=
        abs_two_mul_abs_normSq_sub_le a ha0 u v
    _ ≤ 2 * a * ((2 * (Real.sqrt S * Real.sqrt M)
          + Real.sqrt 2 * r * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M)) := by
        apply mul_le_mul_of_nonneg_left _ (mul_nonneg (by norm_num) ha0)
        have hsum : 2 * ‖u‖ + ‖u - v‖
            ≤ 2 * (Real.sqrt S * Real.sqrt M) + Real.sqrt 2 * r * Real.sqrt M := by
          linarith
        have hb : 0 ≤ 2 * (Real.sqrt S * Real.sqrt M)
            + Real.sqrt 2 * r * Real.sqrt M :=
          add_nonneg
            (mul_nonneg (by norm_num)
              (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)))
            (mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) hr) (Real.sqrt_nonneg _))
        exact mul_le_mul hsum huv (norm_nonneg _) hb
    _ = 2 * a * (2 * Real.sqrt S * Real.sqrt 2 * r + 2 * r ^ 2) * M := by
        have h2 : (Real.sqrt 2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
        have hMs : (Real.sqrt M) ^ 2 = M := Real.sq_sqrt hM
        have hsq : (Real.sqrt 2 * r * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M)
            = 2 * r ^ 2 * M := by
          calc (Real.sqrt 2 * r * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M)
              = (Real.sqrt 2) ^ 2 * r ^ 2 * (Real.sqrt M) ^ 2 := by ring
            _ = 2 * r ^ 2 * M := by rw [h2, hMs]
        rw [show (2 * (Real.sqrt S * Real.sqrt M) + Real.sqrt 2 * r * Real.sqrt M)
              * (Real.sqrt 2 * r * Real.sqrt M)
            = 2 * (Real.sqrt S * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M)
              + (Real.sqrt 2 * r * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M) by ring,
          hsq]
        rw [show 2 * (Real.sqrt S * Real.sqrt M) * (Real.sqrt 2 * r * Real.sqrt M)
            = 2 * Real.sqrt S * Real.sqrt 2 * r * ((Real.sqrt M) * (Real.sqrt M)) by ring,
          show (Real.sqrt M) * (Real.sqrt M) = M by
            rw [show (Real.sqrt M) * (Real.sqrt M) = (Real.sqrt M) ^ 2 by ring, hMs]]
        ring
theorem abs_polarFormRescaled_sub_approx_le (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (g : ℝ → ℂ) (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    |RHLean.polarFormRescaled a g - 2 * a * ‖polarInnerApprox a g‖ ^ 2|
      ≤ Y7Chain.epsilonPolar a * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  by_cases ha : a = 0
  · subst a
    simp [RHLean.polarFormRescaled, Y7Chain.epsilonPolar]
  · have hCS1 := norm_polarInnerRescaled_le a g hg
    have hCS2 := norm_polarInner_sub_approx_le a ha0 ha1 g hg
    have hM : 0 ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2 :=
      integral_nonneg (fun x => sq_nonneg _)
    have hS : (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2)
        = Real.sinh a / a - 1 := norm_sq_sRescaled_integral a ha
    rw [hS] at hCS1
    have h := abs_rankOne_sub_le a (Real.sinh a / a - 1)
      (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) (Y7Chain.sinhRemainder a)
      (RHLean.polarInnerRescaled a g) (polarInnerApprox a g)
      ha0 hM (sinhRemainder_nonneg a ha0 ha1) hCS1 hCS2
    unfold RHLean.polarFormRescaled Y7Chain.epsilonPolar
    exact h
end Y7Approx
end
end Inline_Y7_Approx
section Inline_Y7_TailBounds
noncomputable section
open MeasureTheory
open scoped BigOperators
namespace Y7Tail
private lemma memLp_two_of_continuous {f : ℝ → ℂ} (hf : Continuous f) :
    MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := by
  have hcont : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := hf.norm.pow 2
  have hint : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2) (Set.Icc (-1 : ℝ) 1) volume :=
    hcont.integrableOn_Icc
  exact (memLp_two_iff_integrable_sq_norm hf.measurable.aestronglyMeasurable).mpr
    (hint.mono_set Set.Ioo_subset_Icc_self)
private lemma l2_integral_mul_le {f g : ℝ → ℂ}
    (hf : MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ * ‖g x‖)
      ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have h := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (f := f) (g := g) (p := (2 : ℝ)) (q := (2 : ℝ))
    Real.HolderConjugate.two_two (by simpa using hf) (by simpa using hg)
  simp_rw [Real.rpow_two] at h
  rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at h
  simpa using h
private lemma integral_phi_mul_phi_Ioo (m n : ℕ) :
    (∫ y in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi m).eval y * (Y7Legendre.phi n).eval y) =
      if m = n then 1 else 0 := by
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  exact Y7Rodrigues.integral_phi_mul_phi_eq_ite m n
lemma mass_legSum (s : Finset ℕ) (x : ℕ → ℝ) :
    (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) = ∑ m ∈ s, x m ^ 2 := by
  rw [Y7Op.integral_normSq_legSum]
  simp_rw [integral_phi_mul_phi_Ioo]
  apply Finset.sum_congr rfl
  intro m hm
  rw [Finset.sum_eq_single m]
  · simp
    ring
  · intro n _ hnm
    rw [if_neg (Ne.symm hnm)]
    ring
  · intro hm'
    exact absurd hm hm'
lemma normSq_sRescaled (a x : ℝ) :
    ‖RHLean.sRescaled a x‖ ^ 2 = (Real.cosh (a * x) - 1) / 2 := by
  have h2 : a * x = 2 * (a * x / 2) := by ring
  have hcs := Real.cosh_sq_sub_sinh_sq (a * x / 2)
  simp only [RHLean.sRescaled, Complex.sq_norm, Complex.normSq_ofReal]
  conv_rhs => rw [h2, Real.cosh_two_mul]
  nlinarith [hcs]
lemma integral_cosh_sub_one (a : ℝ) (ha : a ≠ 0) :
    (∫ x in (-1 : ℝ)..1, (Real.cosh (a * x) - 1) / 2) = Real.sinh a / a - 1 := by
  have hderiv : ∀ x ∈ Set.uIcc (-1 : ℝ) 1,
      HasDerivAt (fun y : ℝ => Real.sinh (a * y) / (2 * a) - y / 2)
        ((Real.cosh (a * x) - 1) / 2) x := by
    intro x _
    have h1 : HasDerivAt (fun y : ℝ => Real.sinh (a * y) / (2 * a))
        (Real.cosh (a * x) * a / (2 * a)) x := by
      simpa using ((Real.hasDerivAt_sinh (a * x)).comp x
        ((hasDerivAt_const x a).mul (hasDerivAt_id x))).div_const (2 * a)
    have h2 : HasDerivAt (fun y : ℝ => y / 2) (1 / 2) x :=
      (hasDerivAt_id x).div_const 2
    have hsub := h1.sub h2
    have hval : Real.cosh (a * x) * a / (2 * a) - 1 / 2
        = (Real.cosh (a * x) - 1) / 2 := by
      field_simp [ha]
    rwa [hval] at hsub
  have hint : IntervalIntegrable (fun x : ℝ => (Real.cosh (a * x) - 1) / 2)
      volume (-1) 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
  have hcalc : Real.sinh (a * 1) / (2 * a) - 1 / 2
      - (Real.sinh (a * (-1)) / (2 * a) - (-1) / 2) = Real.sinh a / a - 1 := by
    rw [mul_one, mul_neg, mul_one, Real.sinh_neg]
    field_simp [ha]
    ring
  rw [hcalc]
lemma norm_sq_sRescaled_integral (a : ℝ) (ha : a ≠ 0) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2) = Real.sinh a / a - 1 := by
  simp_rw [normSq_sRescaled a]
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  exact integral_cosh_sub_one a ha
theorem polarFormRescaled_le_mass (a : ℝ) (ha0 : 0 ≤ a) (g : ℝ → ℂ)
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    RHLean.polarFormRescaled a g
      ≤ 2 * (Real.sinh a - a) * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  rcases eq_or_lt_of_le ha0 with rfl | ha
  · simp [RHLean.polarFormRescaled]
  have ha' : a ≠ 0 := ne_of_gt ha
  have hsinh : a ≤ Real.sinh a := Real.self_le_sinh_iff.mpr ha0
  have hS0 : 0 ≤ Real.sinh a / a - 1 := by
    rw [sub_nonneg, one_le_div ha]
    exact hsinh
  set M : ℝ := ∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2 with hM
  have hM0 : 0 ≤ M := integral_nonneg fun x => sq_nonneg _
  have hsf : MemLp (RHLean.sRescaled a) 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) :=
    memLp_two_of_continuous (by unfold RHLean.sRescaled; fun_prop)
  have hcs := l2_integral_mul_le hsf hg
  have hinner : ‖RHLean.polarInnerRescaled a g‖
      ≤ Real.sqrt (Real.sinh a / a - 1) * Real.sqrt M := by
    calc ‖RHLean.polarInnerRescaled a g‖
        = ‖∫ x in Set.Ioo (-1 : ℝ) 1,
            star (RHLean.sRescaled a x) * g x‖ := by
          rw [RHLean.polarInnerRescaled]
      _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖star (RHLean.sRescaled a x) * g x‖ :=
          norm_integral_le_integral_norm _
      _ = ∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ * ‖g x‖ := by
          apply integral_congr_ae
          filter_upwards with x
          rw [norm_mul, norm_star]
      _ ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ^ 2)
            * Real.sqrt M := hcs
      _ = Real.sqrt (Real.sinh a / a - 1) * Real.sqrt M := by
          rw [norm_sq_sRescaled_integral a ha']
  have hsq : ‖RHLean.polarInnerRescaled a g‖ ^ 2 ≤ (Real.sinh a / a - 1) * M := by
    have h := pow_le_pow_left₀ (norm_nonneg _) hinner 2
    rwa [mul_pow, Real.sq_sqrt hS0, Real.sq_sqrt hM0] at h
  calc RHLean.polarFormRescaled a g
      = 2 * a * ‖RHLean.polarInnerRescaled a g‖ ^ 2 := rfl
    _ ≤ 2 * a * ((Real.sinh a / a - 1) * M) :=
        mul_le_mul_of_nonneg_left hsq (by positivity)
    _ = 2 * (Real.sinh a - a) * M := by
        field_simp [ha']
theorem archFormRescaled_legSum_tail_ge (N : ℕ) (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, N ≤ m) :
    Y7Matrix.harmonicR N * (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
      ≤ RHLean.archFormRescaled (Y7Op.legSum x s) := by
  rw [Y7Arch.archDiagonalRep s x, mass_legSum s x]
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro m hm
  have hNm : N ≤ m := hs m hm
  have hH : Y7Matrix.harmonicR N ≤ Y7Matrix.harmonicR m := Y7Chain.harmonicR_mono hNm
  have hx2 : 0 ≤ x m ^ 2 := sq_nonneg _
  calc Y7Matrix.harmonicR N * x m ^ 2 = x m ^ 2 * Y7Matrix.harmonicR N := by ring
    _ ≤ x m ^ 2 * Y7Matrix.harmonicR m := mul_le_mul_of_nonneg_left hH hx2
    _ = (∑ n ∈ s, x m * x n * (if m = n then Y7Matrix.harmonicR m else 0)) := by
        rw [Finset.sum_eq_single m]
        · rw [if_pos rfl]
          ring
        · intro n _ hnm
          rw [if_neg (Ne.symm hnm)]
          ring
        · intro hm'
          exact absurd hm hm'
theorem potentialFormRescaled_nonneg (g : ℝ → ℂ) :
    0 ≤ RHLean.potentialFormRescaled g := by
  unfold RHLean.potentialFormRescaled
  apply integral_nonneg_of_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
  exact mul_nonneg (Y7Density.rescaledPotential_nonneg hx) (sq_nonneg _)
lemma four_mul_gammaKernel {z : ℝ} (hz0 : 0 < z) :
    4 * (z / 2) * RHLean.gammaKernel z
      = (z / 2) / Real.sinh (z / 2) + (z / 2) / Real.cosh (z / 2) - 1 := by
  have hz : z ≠ 0 := ne_of_gt hz0
  have hs : Real.sinh z = 2 * Real.sinh (z / 2) * Real.cosh (z / 2) := by
    have h := Real.sinh_two_mul (z / 2)
    rwa [show 2 * (z / 2) = z by ring] at h
  have he : Real.exp (z / 2) = Real.cosh (z / 2) + Real.sinh (z / 2) :=
    (Real.cosh_add_sinh (z / 2)).symm
  have hu0 : 0 < z / 2 := by positivity
  have hsinh : Real.sinh (z / 2) ≠ 0 := (Real.sinh_pos_iff.mpr hu0).ne'
  have hcosh : Real.cosh (z / 2) ≠ 0 := (Real.cosh_pos (z / 2)).ne'
  rw [RHLean.gammaKernel, if_neg hz, hs, he]
  field_simp [hz, hsinh, hcosh]
  ring
private lemma one_add_three_mul_sub_exp_nonneg {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ 1 + 3 * t - Real.exp t := by
  have hderiv : ∀ u : ℝ,
      HasDerivAt (fun u : ℝ => 1 + 3 * u - Real.exp u) (3 - Real.exp u) u := by
    intro u
    have h1 : HasDerivAt (fun x : ℝ => 1 + 3 * x) 3 u := by
      have h := (hasDerivAt_const u 1).add ((hasDerivAt_id u).const_mul 3)
      have hfun : ((fun _ : ℝ => (1 : ℝ)) + fun y : ℝ => 3 * id y)
          = fun x : ℝ => 1 + 3 * x := by
        funext x
        simp only [Pi.add_apply, id_eq]
      rw [hfun] at h
      convert h using 1
      ring
    exact h1.sub (Real.hasDerivAt_exp u)
  have hmono : MonotoneOn (fun u : ℝ => 1 + 3 * u - Real.exp u) (Set.Icc 0 1) := by
    apply monotoneOn_of_deriv_nonneg (convex_Icc (0 : ℝ) 1)
    · fun_prop
    · intro u hu
      exact (hderiv u).differentiableAt.differentiableWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      rw [(hderiv u).deriv]
      have h3 : Real.exp u < 3 := lt_of_le_of_lt (Real.exp_le_exp.mpr (le_of_lt hu.2))
        Real.exp_one_lt_three
      linarith
  have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, by norm_num⟩
  have ht : t ∈ Set.Icc (0 : ℝ) 1 := ⟨ht0, ht1⟩
  have := hmono h0 ht ht0
  simpa using this
private lemma gammaBoundAux_mono :
    MonotoneOn (fun t : ℝ => 4 * t * Real.exp (3 * t) - Real.exp (4 * t) + 1)
      (Set.Icc 0 1) := by
  have hderiv : ∀ t : ℝ,
      HasDerivAt (fun t : ℝ => 4 * t * Real.exp (3 * t) - Real.exp (4 * t) + 1)
        (4 * Real.exp (3 * t) * (1 + 3 * t - Real.exp t)) t := by
    intro t
    have h1 : HasDerivAt (fun t : ℝ => 4 * t * Real.exp (3 * t))
        (4 * Real.exp (3 * t) + 4 * t * (3 * Real.exp (3 * t))) t := by
      have hlin : HasDerivAt (fun t : ℝ => (4 : ℝ) * t) 4 t := by
        simpa using (hasDerivAt_id t).const_mul (4 : ℝ)
      have hexp : HasDerivAt (fun t : ℝ => Real.exp (3 * t))
          (3 * Real.exp (3 * t)) t := by
        have h := (Real.hasDerivAt_exp (3 * t)).comp t ((hasDerivAt_id t).const_mul 3)
        simpa [Function.comp_def, mul_comm, mul_assoc] using h
      exact hlin.mul hexp
    have h2 : HasDerivAt (fun t : ℝ => Real.exp (4 * t))
        (4 * Real.exp (4 * t)) t := by
      have h := (Real.hasDerivAt_exp (4 * t)).comp t ((hasDerivAt_id t).const_mul 4)
      simpa [Function.comp_def, mul_comm, mul_assoc] using h
    have h3 : HasDerivAt (fun _ : ℝ => (1 : ℝ)) 0 t := hasDerivAt_const t 1
    have h := (h1.sub h2).add h3
    convert h using 1
    have he4 : Real.exp (4 * t) = Real.exp (3 * t) * Real.exp t := by
      rw [← Real.exp_add]
      ring_nf
    rw [he4]
    ring
  apply monotoneOn_of_deriv_nonneg (convex_Icc (0 : ℝ) 1)
  · fun_prop
  · intro t ht
    exact (hderiv t).differentiableAt.differentiableWithinAt
  · intro t ht
    rw [interior_Icc] at ht
    rw [(hderiv t).deriv]
    apply mul_nonneg (by positivity)
    have ht1 : t ≤ 1 := le_of_lt ht.2
    have := one_add_three_mul_sub_exp_nonneg (le_of_lt ht.1) ht1
    linarith
private lemma exp_one_div_sinh_add_cosh {E : ℝ} (hE : 1 < E) :
    1 / ((E - E⁻¹) / 2) + 1 / ((E + E⁻¹) / 2) = 4 * E ^ 3 / (E ^ 4 - 1) := by
  have hE0 : E ≠ 0 := ne_of_gt (lt_trans zero_lt_one hE)
  have h2 : E ^ 2 - 1 ≠ 0 := by nlinarith
  have h4 : E ^ 4 - 1 ≠ 0 := by
    have h2gt : 1 < E ^ 2 := by nlinarith
    have hfac : E ^ 4 - 1 = (E ^ 2 - 1) * (E ^ 2 + 1) := by ring
    have h1 : 0 < E ^ 2 - 1 := by linarith
    have : 0 < E ^ 4 - 1 := by rw [hfac]; positivity
    linarith
  field_simp [hE0, h2, h4]
  ring
theorem gammaKernel_nonneg_le_quarter {z : ℝ} (hz0 : 0 < z) (hz2 : z ≤ 2) :
    0 ≤ RHLean.gammaKernel z ∧ RHLean.gammaKernel z ≤ 1 / 4 := by
  set u : ℝ := z / 2 with hu
  have hu0 : 0 < u := by positivity
  have hu1 : u ≤ 1 := by linarith
  have hid := four_mul_gammaKernel hz0
  rw [← hu] at hid
  have hsinh_pos : 0 < Real.sinh u := Real.sinh_pos_iff.mpr hu0
  have hcosh_pos : 0 < Real.cosh u := Real.cosh_pos u
  have hf : 0 ≤ 4 * u * Real.exp (3 * u) - Real.exp (4 * u) + 1 := by
    have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, by norm_num⟩
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_lt hu0, hu1⟩
    have := gammaBoundAux_mono h0 hu' (le_of_lt hu0)
    simpa using this
  have hlow : 1 ≤ u / Real.sinh u + u / Real.cosh u := by
    have hden : 0 < Real.exp (4 * u) - 1 := by
      have := Real.one_lt_exp_iff.mpr (by positivity : (0 : ℝ) < 4 * u)
      linarith
    have halg : u / Real.sinh u + u / Real.cosh u
        = 4 * u * Real.exp (3 * u) / (Real.exp (4 * u) - 1) := by
      have hbase := exp_one_div_sinh_add_cosh (E := Real.exp u)
        (Real.one_lt_exp_iff.mpr hu0)
      rw [Real.sinh_eq, Real.cosh_eq, Real.exp_neg]
      rw [show Real.exp (3 * u) = Real.exp u ^ 3 by
