lemma integrableOn_Ioo_of_bound' {g : ℝ → ℂ} (hg : Continuous g)
    {C : ℝ} (hb : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖g x‖ ≤ C) :
    IntegrableOn g (Set.Ioo (-1 : ℝ) 1) :=
  IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
    hg.aestronglyMeasurable C
    (by filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx; exact hb x hx)
lemma integrableOn_Ioo_of_bound_real {g : ℝ → ℝ} (hg : Continuous g)
    {C : ℝ} (hb : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖g x‖ ≤ C) :
    IntegrableOn g (Set.Ioo (-1 : ℝ) 1) :=
  IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
    hg.aestronglyMeasurable C
    (by filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx; exact hb x hx)
lemma norm_le_of_close {f p : ℝ → ℂ} {B δ : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ) :
    ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x‖ ≤ B + δ := by
  intro x hx
  have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  calc ‖p x‖ ≤ ‖f x‖ + ‖p x - f x‖ := by
        have h := norm_add_le (f x) (p x - f x)
        simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using h
    _ ≤ B + δ := add_le_add (hB x hx') (hδ x hx)
lemma normSq_sub_le {f p : ℝ → ℂ} {B δ : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ)
    {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    |‖f x‖ ^ 2 - ‖p x‖ ^ 2| ≤ δ * (2 * B + δ) := by
  have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  have h1 : |‖f x‖ - ‖p x‖| ≤ δ := by
    have h := hδ x hx
    rw [norm_sub_rev] at h
    exact (abs_norm_sub_norm_le (f x) (p x)).trans h
  have h2 : ‖f x‖ + ‖p x‖ ≤ 2 * B + δ := by
    have hpB := norm_le_of_close hB hδ x hx
    have hfB := hB x hx'
    linarith
  have h2' : 0 ≤ ‖f x‖ + ‖p x‖ := by positivity
  rw [show ‖f x‖ ^ 2 - ‖p x‖ ^ 2
      = (‖f x‖ - ‖p x‖) * (‖f x‖ + ‖p x‖) by ring]
  rw [abs_mul, abs_of_nonneg h2']
  exact mul_le_mul h1 h2 h2' hδ0
theorem mass_sub_le {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ) :
    |(∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2) - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)|
      ≤ δ * (2 * B + δ) * 2 := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hBp := norm_le_of_close hB hδ
  have hIf : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2) (Set.Ioo (-1 : ℝ) 1) :=
    integrableOn_Ioo_of_bound_real (g := fun x : ℝ => ‖f x‖ ^ 2) (hfc.norm.pow 2)
      (C := B ^ 2) (fun x hx => by
        rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) 2)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩) 2)
  have hIp : IntegrableOn (fun x : ℝ => ‖p x‖ ^ 2) (Set.Ioo (-1 : ℝ) 1) :=
    integrableOn_Ioo_of_bound_real (g := fun x : ℝ => ‖p x‖ ^ 2) (hp.norm.pow 2)
      (C := (B + δ) ^ 2) (fun x hx => by
        rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) 2)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hBp x hx) 2)
  have hsub : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2 - ‖p x‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := hIf.sub hIp
  have h0 : 0 ≤ δ * (2 * B + δ) := by
    have h2B : 0 ≤ 2 * B + δ := by
      have hBnn : 0 ≤ B := le_trans (norm_nonneg _) (hB 0 ⟨by norm_num, by norm_num⟩)
      linarith
    positivity
  calc |(∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)|
      = |∫ x in Set.Ioo (-1 : ℝ) 1, (‖f x‖ ^ 2 - ‖p x‖ ^ 2)| := by
        rw [integral_sub hIf hIp]
    _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, |‖f x‖ ^ 2 - ‖p x‖ ^ 2| := by
        simpa only [Real.norm_eq_abs] using
          norm_integral_le_integral_norm
            (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
            (fun x : ℝ => ‖f x‖ ^ 2 - ‖p x‖ ^ 2)
    _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, δ * (2 * B + δ) := by
        refine integral_mono_ae hsub.abs
          (integrableOn_const (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top))
          ?_
        filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
        exact normSq_sub_le hB hδ0 hδ hx
    _ = δ * (2 * B + δ) * 2 := by
        rw [integral_const, smul_eq_mul]
        have hvol : (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ = 2 := by
          show (volume.restrict (Set.Ioo (-1 : ℝ) 1) Set.univ).toReal = 2
          rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
            Real.volume_Ioo, ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - -1)]
          norm_num
        rw [hvol]
        ring
lemma rescaledPotential_nonneg {x : ℝ} (hx : x ∈ Set.Ioo (-1 : ℝ) 1) :
    0 ≤ RHLean.rescaledPotential x := by
  unfold RHLean.rescaledPotential
  have h1 : 0 < 1 - x ^ 2 := by nlinarith [hx.1, hx.2]
  have h2 : 1 - x ^ 2 ≤ 1 := by nlinarith [sq_nonneg x]
  have h3 : Real.log (1 - x ^ 2) ≤ 0 := Real.log_nonpos (le_of_lt h1) h2
  linarith
lemma integrableOn_rescaledPotential :
    IntegrableOn (fun x : ℝ => RHLean.rescaledPotential x) (Set.Ioo (-1 : ℝ) 1) := by
  have h : IntervalIntegrable (fun x : ℝ => RHLean.rescaledPotential x) volume (-1) 1 :=
    by simpa using Y7Matrix.intervalIntegrable_rescaledPotential_mul_pow 0
  exact (intervalIntegrable_iff_integrableOn_Ioo_of_le (show (-1 : ℝ) ≤ 1 by norm_num)
    (by simp [RHLean.rescaledPotential]) (by simp [RHLean.rescaledPotential])).mp h
theorem potential_sub_le {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ : ℝ}
    (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ) :
    |(∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖f x‖ ^ 2)
      - (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖p x‖ ^ 2)|
      ≤ δ * (2 * B + δ) * (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hV := integrableOn_rescaledPotential
  have hVnn : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, 0 ≤ RHLean.rescaledPotential x :=
    fun x hx => rescaledPotential_nonneg hx
  have hmeasV : Measurable (fun x : ℝ => RHLean.rescaledPotential x) := by
    unfold RHLean.rescaledPotential
    fun_prop
  have hBnn : 0 ≤ B := le_trans (norm_nonneg _) (hB 0 ⟨by norm_num, by norm_num⟩)
  have hc0 : 0 ≤ δ * (2 * B + δ) := by
    have : 0 ≤ 2 * B + δ := by linarith
    positivity
  have hbound_f : ∀ x ∈ Set.Ioo (-1 : ℝ) 1,
      ‖RHLean.rescaledPotential x * ‖f x‖ ^ 2‖ ≤ B ^ 2 * RHLean.rescaledPotential x := by
    intro x hx
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hVnn x hx),
      abs_of_nonneg (pow_nonneg (norm_nonneg _) 2)]
    have := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (hB x hx') 2) (hVnn x hx)
    simpa [mul_comm] using this
  have hbound_p : ∀ x ∈ Set.Ioo (-1 : ℝ) 1,
      ‖RHLean.rescaledPotential x * ‖p x‖ ^ 2‖ ≤ (B + δ) ^ 2 * RHLean.rescaledPotential x := by
    intro x hx
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hVnn x hx),
      abs_of_nonneg (pow_nonneg (norm_nonneg _) 2)]
    have := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (norm_le_of_close hB hδ x hx) 2) (hVnn x hx)
    simpa [mul_comm] using this
  have hVf : IntegrableOn (fun x : ℝ => RHLean.rescaledPotential x * ‖f x‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    refine Integrable.mono' (hV.const_mul (B ^ 2)) ?_ ?_
    · exact (hmeasV.mul ((hfc.norm.pow 2).measurable)).aestronglyMeasurable
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      exact hbound_f x hx
  have hVp : IntegrableOn (fun x : ℝ => RHLean.rescaledPotential x * ‖p x‖ ^ 2)
      (Set.Ioo (-1 : ℝ) 1) := by
    refine Integrable.mono' (hV.const_mul ((B + δ) ^ 2)) ?_ ?_
    · exact (hmeasV.mul ((hp.norm.pow 2).measurable)).aestronglyMeasurable
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      exact hbound_p x hx
  have hkey : ∀ x ∈ Set.Ioo (-1 : ℝ) 1,
      |RHLean.rescaledPotential x * ‖f x‖ ^ 2 - RHLean.rescaledPotential x * ‖p x‖ ^ 2|
        ≤ δ * (2 * B + δ) * RHLean.rescaledPotential x := by
    intro x hx
    rw [← mul_sub, abs_mul, abs_of_nonneg (hVnn x hx)]
    have := mul_le_mul_of_nonneg_left (normSq_sub_le hB hδ0 hδ hx) (hVnn x hx)
    simpa [mul_comm] using this
  calc |(∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖p x‖ ^ 2)|
      = |∫ x in Set.Ioo (-1 : ℝ) 1,
          (RHLean.rescaledPotential x * ‖f x‖ ^ 2 - RHLean.rescaledPotential x * ‖p x‖ ^ 2)| := by
        rw [integral_sub hVf hVp]
    _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1,
          |RHLean.rescaledPotential x * ‖f x‖ ^ 2 - RHLean.rescaledPotential x * ‖p x‖ ^ 2| := by
        simpa only [Real.norm_eq_abs] using
          norm_integral_le_integral_norm
            (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
            (fun x : ℝ =>
              RHLean.rescaledPotential x * ‖f x‖ ^ 2 - RHLean.rescaledPotential x * ‖p x‖ ^ 2)
    _ ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, δ * (2 * B + δ) * RHLean.rescaledPotential x := by
        refine integral_mono_ae (hVf.sub hVp).abs (hV.const_mul _) ?_
        filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
        exact hkey x hx
    _ = δ * (2 * B + δ) * (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x) := by
        rw [integral_const_mul]
theorem gamma_sub_le {a : ℝ} (ha : 0 ≤ a) {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ : ℝ}
    (hB0 : 0 ≤ B) (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ) :
    |RHLean.gammaFormRescaled a f - RHLean.gammaFormRescaled a p|
      ≤ δ * (2 * B + δ) * (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) * 4) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hBp : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x‖ ≤ B + δ := norm_le_of_close hB hδ
  have hKa0 : 0 ≤ |a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) :=
    mul_nonneg (abs_nonneg a) (by positivity)
  have hμ : (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ = 2 := by
    show (volume.restrict (Set.Ioo (-1 : ℝ) 1) Set.univ).toReal = 2
    rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
      ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - -1)]
    norm_num
  have hμfin : ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))).real Set.univ = 4 := by
    rw [show (Set.univ : Set (ℝ × ℝ)) = Set.univ ×ˢ Set.univ from
        Set.univ_prod_univ.symm,
      MeasureTheory.measureReal_prod_prod, hμ]
    norm_num
  have hIf : Integrable (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
      * (f z.1 * star (f z.2)).re)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
    refine Integrable.of_bound ?_
      (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) * (B * B)) ?_
    · exact ((measurable_gammaKernelRescaled_comp a).mul
        (continuous_mul_star_re hfc).measurable).aestronglyMeasurable
    · rw [Measure.prod_restrict]
      filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
      have hz1 : z.1 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.1.1, le_of_lt hz.1.2⟩
      have hz2 : z.2 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.2.1, le_of_lt hz.2.2⟩
      have hdist : ‖z.1 - z.2‖ ∈ Set.Icc (0 : ℝ) 2 := by
        constructor
        · positivity
        · rw [Real.norm_eq_abs, abs_sub_le_iff]
          exact ⟨by linarith [hz1.2, hz2.1], by linarith [hz2.2, hz1.1]⟩
      have hK := gammaKernelRescaled_bound ha hdist
      have hre : |(f z.1 * star (f z.2)).re| ≤ B * B := by
        calc |(f z.1 * star (f z.2)).re| ≤ ‖f z.1 * star (f z.2)‖ :=
              Complex.abs_re_le_norm _
          _ = ‖f z.1‖ * ‖f z.2‖ := by rw [norm_mul, norm_star]
          _ ≤ B * B := mul_le_mul (hB z.1 hz1) (hB z.2 hz2) (norm_nonneg _) hB0
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_mul hK hre (abs_nonneg _)
        (mul_nonneg (abs_nonneg a) (by positivity))
  have hIp : Integrable (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
      * (p z.1 * star (p z.2)).re)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
    refine Integrable.of_bound ?_
      (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) * ((B + δ) * (B + δ))) ?_
    · exact ((measurable_gammaKernelRescaled_comp a).mul
        (continuous_mul_star_re hp).measurable).aestronglyMeasurable
    · rw [Measure.prod_restrict]
      filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
      have hdist : ‖z.1 - z.2‖ ∈ Set.Icc (0 : ℝ) 2 := by
        constructor
        · positivity
        · rw [Real.norm_eq_abs, abs_sub_le_iff]
          exact ⟨by linarith [(hz.1).2, (hz.2).1], by linarith [(hz.2).2, (hz.1).1]⟩
      have hK := gammaKernelRescaled_bound ha hdist
      have hre : |(p z.1 * star (p z.2)).re| ≤ (B + δ) * (B + δ) := by
        calc |(p z.1 * star (p z.2)).re| ≤ ‖p z.1 * star (p z.2)‖ :=
              Complex.abs_re_le_norm _
          _ = ‖p z.1‖ * ‖p z.2‖ := by rw [norm_mul, norm_star]
          _ ≤ (B + δ) * (B + δ) := mul_le_mul (hBp z.1 hz.1) (hBp z.2 hz.2)
              (norm_nonneg _) (by positivity)
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_mul hK hre (abs_nonneg _)
        (mul_nonneg (abs_nonneg a) (by positivity))
  have hdiff : Integrable (fun z : ℝ × ℝ =>
      RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (f z.1 * star (f z.2)).re
        - RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (p z.1 * star (p z.2)).re)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :=
    hIf.sub hIp
  have hbracket : ∀ z ∈ Set.Ioo (-1 : ℝ) 1 ×ˢ Set.Ioo (-1 : ℝ) 1,
      |(f z.1 * star (f z.2)).re - (p z.1 * star (p z.2)).re| ≤ δ * (2 * B + δ) := by
    intro z hz
    have hz1 : z.1 ∈ Set.Ioo (-1 : ℝ) 1 := hz.1
    have hz2 : z.2 ∈ Set.Ioo (-1 : ℝ) 1 := hz.2
    have hz2' : z.2 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz2.1, le_of_lt hz2.2⟩
    have hdecomp : (f z.1 * star (f z.2)).re - (p z.1 * star (p z.2)).re
        = ((f z.1 - p z.1) * star (f z.2)).re
          + (p z.1 * star (f z.2 - p z.2)).re := by
      simp only [sub_mul, star_sub, mul_sub, Complex.sub_re, Complex.add_re]
      ring
    rw [hdecomp]
    have h1 : |((f z.1 - p z.1) * star (f z.2)).re| ≤ δ * B := by
      calc |((f z.1 - p z.1) * star (f z.2)).re|
            ≤ ‖(f z.1 - p z.1) * star (f z.2)‖ := Complex.abs_re_le_norm _
        _ = ‖f z.1 - p z.1‖ * ‖f z.2‖ := by rw [norm_mul, norm_star]
        _ ≤ δ * B := mul_le_mul (by
              have h := hδ z.1 hz1
              rwa [norm_sub_rev] at h) (hB z.2 hz2') (norm_nonneg _) hδ0
    have h2 : |(p z.1 * star (f z.2 - p z.2)).re| ≤ (B + δ) * δ := by
      calc |(p z.1 * star (f z.2 - p z.2)).re|
            ≤ ‖p z.1 * star (f z.2 - p z.2)‖ := Complex.abs_re_le_norm _
        _ = ‖p z.1‖ * ‖f z.2 - p z.2‖ := by rw [norm_mul, norm_star]
        _ ≤ (B + δ) * δ := mul_le_mul (hBp z.1 hz1) (by
              have h := hδ z.2 hz2
              rwa [norm_sub_rev] at h) (norm_nonneg _) (by linarith [hB0, hδ0])
    calc |((f z.1 - p z.1) * star (f z.2)).re
          + (p z.1 * star (f z.2 - p z.2)).re|
        ≤ |((f z.1 - p z.1) * star (f z.2)).re|
          + |(p z.1 * star (f z.2 - p z.2)).re| := abs_add_le _ _
      _ ≤ δ * B + (B + δ) * δ := add_le_add h1 h2
      _ = δ * (2 * B + δ) := by ring
  calc |RHLean.gammaFormRescaled a f - RHLean.gammaFormRescaled a p|
      = |∫ z, (RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (f z.1 * star (f z.2)).re
          - RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (p z.1 * star (p z.2)).re)
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1)))| := by
        unfold RHLean.gammaFormRescaled
        rw [← MeasureTheory.integral_prod
            (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
              * (f z.1 * star (f z.2)).re) hIf,
          ← MeasureTheory.integral_prod
            (fun z : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖z.1 - z.2‖
              * (p z.1 * star (p z.2)).re) hIp,
          integral_sub hIf hIp]
    _ ≤ ∫ z, |RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (f z.1 * star (f z.2)).re
          - RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (p z.1 * star (p z.2)).re|
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
        simpa only [Real.norm_eq_abs] using
          norm_integral_le_integral_norm
            (fun z : ℝ × ℝ =>
              RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (f z.1 * star (f z.2)).re
                - RHLean.gammaKernelRescaled a ‖z.1 - z.2‖ * (p z.1 * star (p z.2)).re)
    _ ≤ ∫ _z, δ * (2 * B + δ) * (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4))
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
        refine integral_mono_ae hdiff.abs (integrable_const _) ?_
        rw [Measure.prod_restrict]
        filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
        have hdist : ‖z.1 - z.2‖ ∈ Set.Icc (0 : ℝ) 2 := by
          constructor
          · positivity
          · rw [Real.norm_eq_abs, abs_sub_le_iff]
            exact ⟨by linarith [(hz.1).2, (hz.2).1],
              by linarith [(hz.2).2, (hz.1).1]⟩
        have hK := gammaKernelRescaled_bound ha hdist
        have hb := hbracket z hz
        rw [← mul_sub, abs_mul]
        calc |RHLean.gammaKernelRescaled a ‖z.1 - z.2‖|
              * |(f z.1 * star (f z.2)).re - (p z.1 * star (p z.2)).re|
            ≤ (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4)) * (δ * (2 * B + δ)) :=
              mul_le_mul hK hb (abs_nonneg _) hKa0
          _ = δ * (2 * B + δ) * (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4)) := by ring
    _ = δ * (2 * B + δ) * (|a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) * 4) := by
        rw [integral_const, smul_eq_mul, hμfin]
        ring
theorem polar_sub_le {a : ℝ} (ha : 0 ≤ a) {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ Ms : ℝ}
    (hB0 : 0 ≤ B) (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ)
    (hMs0 : 0 ≤ Ms) (hsinh : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ≤ Ms) :
    |RHLean.polarFormRescaled a f - RHLean.polarFormRescaled a p|
      ≤ 2 * a * (2 * Ms * δ) * (2 * Ms * (2 * B + δ)) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hBp : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x‖ ≤ B + δ := norm_le_of_close hB hδ
  have hsinh_cont : Continuous (fun x : ℝ => RHLean.sRescaled a x) := by
    unfold RHLean.sRescaled
    fun_prop
  have hIf : IntegrableOn (fun x : ℝ => star (RHLean.sRescaled a x) * f x)
      (Set.Ioo (-1 : ℝ) 1) := by
    refine integrableOn_Ioo_of_bound' (hsinh_cont.star.mul hfc) (C := Ms * B) ?_
    intro x hx
    rw [norm_mul, norm_star]
    exact mul_le_mul (hsinh x hx) (hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩) (norm_nonneg _) hMs0
  have hIp : IntegrableOn (fun x : ℝ => star (RHLean.sRescaled a x) * p x)
      (Set.Ioo (-1 : ℝ) 1) := by
    refine integrableOn_Ioo_of_bound' (hsinh_cont.star.mul hp) (C := Ms * (B + δ)) ?_
    intro x hx
    rw [norm_mul, norm_star]
    exact mul_le_mul (hsinh x hx) (hBp x hx) (norm_nonneg _) hMs0
  have hIm : IntegrableOn (fun x : ℝ => star (RHLean.sRescaled a x) * (f x - p x))
      (Set.Ioo (-1 : ℝ) 1) := by
    refine integrableOn_Ioo_of_bound' (hsinh_cont.star.mul (hfc.sub hp)) (C := Ms * δ) ?_
    intro x hx
    rw [norm_mul, norm_star]
    exact mul_le_mul (hsinh x hx) (by
      have h := hδ x hx
      rwa [norm_sub_rev] at h) (norm_nonneg _) hMs0
  have hvol : (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ = 2 := by
    show (volume.restrict (Set.Ioo (-1 : ℝ) 1) Set.univ).toReal = 2
    rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
      ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - -1)]
    norm_num
  have hSf : ‖RHLean.polarInnerRescaled a f‖ ≤ Ms * B * 2 := by
    unfold RHLean.polarInnerRescaled
    calc ‖∫ x in Set.Ioo (-1 : ℝ) 1, star (RHLean.sRescaled a x) * f x‖
        ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖star (RHLean.sRescaled a x) * f x‖ :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ _x in Set.Ioo (-1 : ℝ) 1, Ms * B := by
          refine integral_mono_ae hIf.norm
            (integrableOn_const (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top)) ?_
          filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
          rw [norm_mul, norm_star]
          exact mul_le_mul (hsinh x hx) (hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩) (norm_nonneg _) hMs0
      _ = Ms * B * 2 := by
          rw [integral_const, smul_eq_mul, hvol]
          ring
  have hSp : ‖RHLean.polarInnerRescaled a p‖ ≤ Ms * (B + δ) * 2 := by
    unfold RHLean.polarInnerRescaled
    calc ‖∫ x in Set.Ioo (-1 : ℝ) 1, star (RHLean.sRescaled a x) * p x‖
        ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖star (RHLean.sRescaled a x) * p x‖ :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ _x in Set.Ioo (-1 : ℝ) 1, Ms * (B + δ) := by
          refine integral_mono_ae hIp.norm
            (integrableOn_const (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top)) ?_
          filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
          rw [norm_mul, norm_star]
          exact mul_le_mul (hsinh x hx) (hBp x hx) (norm_nonneg _) hMs0
      _ = Ms * (B + δ) * 2 := by
          rw [integral_const, smul_eq_mul, hvol]
          ring
  have hSm : ‖RHLean.polarInnerRescaled a f - RHLean.polarInnerRescaled a p‖ ≤ Ms * δ * 2 := by
    have hlin : RHLean.polarInnerRescaled a f - RHLean.polarInnerRescaled a p
        = RHLean.polarInnerRescaled a (fun x => f x - p x) := by
      unfold RHLean.polarInnerRescaled
      rw [← integral_sub hIf hIp]
      apply integral_congr_ae
      filter_upwards with x
      ring
    rw [hlin]
    unfold RHLean.polarInnerRescaled
    calc ‖∫ x in Set.Ioo (-1 : ℝ) 1, star (RHLean.sRescaled a x) * (f x - p x)‖
        ≤ ∫ x in Set.Ioo (-1 : ℝ) 1, ‖star (RHLean.sRescaled a x) * (f x - p x)‖ :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ _x in Set.Ioo (-1 : ℝ) 1, Ms * δ := by
          refine integral_mono_ae hIm.norm
            (integrableOn_const (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top)) ?_
          filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
          rw [norm_mul, norm_star]
          exact mul_le_mul (hsinh x hx) (by
            have h := hδ x hx
            rwa [norm_sub_rev] at h) (norm_nonneg _) hMs0
      _ = Ms * δ * 2 := by
          rw [integral_const, smul_eq_mul, hvol]
          ring
  have hsq : |‖RHLean.polarInnerRescaled a f‖ ^ 2 - ‖RHLean.polarInnerRescaled a p‖ ^ 2|
      ≤ (2 * Ms * δ) * (2 * Ms * (2 * B + δ)) := by
    have h1 : |‖RHLean.polarInnerRescaled a f‖ - ‖RHLean.polarInnerRescaled a p‖|
        ≤ 2 * Ms * δ := by
      have h := abs_norm_sub_norm_le (RHLean.polarInnerRescaled a f)
        (RHLean.polarInnerRescaled a p)
      linarith
    have h2 : ‖RHLean.polarInnerRescaled a f‖ + ‖RHLean.polarInnerRescaled a p‖
        ≤ 2 * Ms * (2 * B + δ) := by
      linarith
    rw [show ‖RHLean.polarInnerRescaled a f‖ ^ 2 - ‖RHLean.polarInnerRescaled a p‖ ^ 2
        = (‖RHLean.polarInnerRescaled a f‖ - ‖RHLean.polarInnerRescaled a p‖)
          * (‖RHLean.polarInnerRescaled a f‖ + ‖RHLean.polarInnerRescaled a p‖) by ring]
    rw [abs_mul,
      abs_of_nonneg (by positivity : (0:ℝ) ≤ ‖RHLean.polarInnerRescaled a f‖
        + ‖RHLean.polarInnerRescaled a p‖)]
    exact mul_le_mul h1 h2 (by positivity) (by positivity)
  unfold RHLean.polarFormRescaled
  rw [← mul_sub, abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ 2 * a)]
  calc (2 * a) * |‖RHLean.polarInnerRescaled a f‖ ^ 2 - ‖RHLean.polarInnerRescaled a p‖ ^ 2|
      ≤ (2 * a) * ((2 * Ms * δ) * (2 * Ms * (2 * B + δ))) :=
        mul_le_mul_of_nonneg_left hsq (by linarith)
    _ = 2 * a * (2 * Ms * δ) * (2 * Ms * (2 * B + δ)) := by ring
theorem arch_sub_le {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ η Cf Cp : ℝ}
    (hB0 : 0 ≤ B) (hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ δ)
    (hCf0 : 0 ≤ Cf) (hlip_f : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖f x - f y‖ ≤ Cf * ‖x - y‖)
    (hCp0 : 0 ≤ Cp) (hlip_p : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖p x - p y‖ ≤ Cp * ‖x - y‖)
    (hη0 : 0 ≤ η) (hlip_m : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖(f x - p x) - (f y - p y)‖ ≤ η * ‖x - y‖) :
    |RHLean.archFormRescaled f - RHLean.archFormRescaled p|
      ≤ η * (2 * B + 2 * (B + δ)) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hBp : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x‖ ≤ B + δ := norm_le_of_close hB hδ
  have hIf := arch_quot_integrable hCf0 hfc hlip_f
  have hIp := arch_quot_integrable hCp0 hp hlip_p
  have hdiff := hIf.sub hIp
  have hμ : (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ = 2 := by
    show (volume.restrict (Set.Ioo (-1 : ℝ) 1) Set.univ).toReal = 2
    rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
      ENNReal.toReal_ofReal (by norm_num : (0 : ℝ) ≤ 1 - -1)]
    norm_num
  have hμfin : ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
      (volume.restrict (Set.Ioo (-1 : ℝ) 1))).real Set.univ = 4 := by
    rw [show (Set.univ : Set (ℝ × ℝ)) = Set.univ ×ˢ Set.univ from
        Set.univ_prod_univ.symm,
      MeasureTheory.measureReal_prod_prod, hμ]
    norm_num
  have hkey : ∀ z ∈ Set.Ioo (-1 : ℝ) 1 ×ˢ Set.Ioo (-1 : ℝ) 1,
      |‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖ - ‖p z.1 - p z.2‖ ^ 2 / ‖z.1 - z.2‖|
        ≤ η * (2 * B + 2 * (B + δ)) := by
    intro z hz
    have hz1 : z.1 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.1.1, le_of_lt hz.1.2⟩
    have hz2 : z.2 ∈ Set.Icc (-1 : ℝ) 1 := ⟨le_of_lt hz.2.1, le_of_lt hz.2.2⟩
    by_cases hxy : z.1 = z.2
    · rw [hxy]
      simp only [sub_self, norm_zero, sq, mul_zero, div_zero, abs_zero]
      exact mul_nonneg hη0 (by linarith [hB0, hδ0])
    · have hpos : 0 < ‖z.1 - z.2‖ :=
        norm_pos_iff.mpr (sub_ne_zero.mpr hxy)
      have hd : |‖f z.1 - f z.2‖ - ‖p z.1 - p z.2‖| ≤ η * ‖z.1 - z.2‖ := by
        calc |‖f z.1 - f z.2‖ - ‖p z.1 - p z.2‖|
            ≤ ‖(f z.1 - f z.2) - (p z.1 - p z.2)‖ := abs_norm_sub_norm_le _ _
          _ = ‖(f z.1 - p z.1) - (f z.2 - p z.2)‖ := by
              rw [show (f z.1 - f z.2) - (p z.1 - p z.2)
                  = (f z.1 - p z.1) - (f z.2 - p z.2) by ring]
          _ ≤ η * ‖z.1 - z.2‖ := hlip_m z.1 hz1 z.2 hz2
      have hb : ‖f z.1 - f z.2‖ + ‖p z.1 - p z.2‖ ≤ 2 * B + 2 * (B + δ) := by
        have h1 : ‖f z.1 - f z.2‖ ≤ 2 * B := by
          calc ‖f z.1 - f z.2‖ ≤ ‖f z.1‖ + ‖f z.2‖ := norm_sub_le _ _
            _ ≤ B + B := add_le_add (hB z.1 hz1) (hB z.2 hz2)
            _ = 2 * B := by ring
        have h2 : ‖p z.1 - p z.2‖ ≤ 2 * (B + δ) := by
          calc ‖p z.1 - p z.2‖ ≤ ‖p z.1‖ + ‖p z.2‖ := norm_sub_le _ _
            _ ≤ (B + δ) + (B + δ) := add_le_add (hBp z.1 hz.1) (hBp z.2 hz.2)
            _ = 2 * (B + δ) := by ring
        linarith
      have hnm : 0 ≤ ‖f z.1 - f z.2‖ + ‖p z.1 - p z.2‖ := by positivity
      rw [← sub_div, abs_div, abs_of_nonneg (norm_nonneg _), div_le_iff₀ hpos,
        show ‖f z.1 - f z.2‖ ^ 2 - ‖p z.1 - p z.2‖ ^ 2
            = (‖f z.1 - f z.2‖ - ‖p z.1 - p z.2‖)
              * (‖f z.1 - f z.2‖ + ‖p z.1 - p z.2‖) by ring,
        abs_mul, abs_of_nonneg hnm]
      calc |‖f z.1 - f z.2‖ - ‖p z.1 - p z.2‖|
            * (‖f z.1 - f z.2‖ + ‖p z.1 - p z.2‖)
          ≤ (η * ‖z.1 - z.2‖) * (2 * B + 2 * (B + δ)) :=
            mul_le_mul hd hb hnm (mul_nonneg hη0 (norm_nonneg _))
        _ = η * (2 * B + 2 * (B + δ)) * ‖z.1 - z.2‖ := by ring
  calc |RHLean.archFormRescaled f - RHLean.archFormRescaled p|
      = (1 / 4) * |∫ z, (‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖
          - ‖p z.1 - p z.2‖ ^ 2 / ‖z.1 - z.2‖)
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1)))| := by
        unfold RHLean.archFormRescaled
        rw [← MeasureTheory.integral_prod
            (fun z : ℝ × ℝ => ‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖) hIf,
          ← MeasureTheory.integral_prod
            (fun z : ℝ × ℝ => ‖p z.1 - p z.2‖ ^ 2 / ‖z.1 - z.2‖) hIp,
          ← mul_sub, ← integral_sub hIf hIp,
          abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 4)]
    _ ≤ (1 / 4) * ∫ z, |‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖
          - ‖p z.1 - p z.2‖ ^ 2 / ‖z.1 - z.2‖|
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
        simpa only [Real.norm_eq_abs] using
          norm_integral_le_integral_norm
            (fun z : ℝ × ℝ => ‖f z.1 - f z.2‖ ^ 2 / ‖z.1 - z.2‖
              - ‖p z.1 - p z.2‖ ^ 2 / ‖z.1 - z.2‖)
    _ ≤ (1 / 4) * ∫ _z, η * (2 * B + 2 * (B + δ))
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
        refine integral_mono_ae hdiff.abs (integrable_const _) ?_
        rw [Measure.prod_restrict]
        filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with z hz
        exact hkey z hz
    _ = (1 / 4) * (η * (2 * B + 2 * (B + δ)) * 4) := by
        rw [integral_const, smul_eq_mul, hμfin]
        ring
    _ = η * (2 * B + 2 * (B + δ)) := by ring
theorem shift_sub_le {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore 1)
    {p : ℝ → ℂ} (hp : Continuous p) {B δ b : ℝ}
    (hB0 : 0 ≤ B) (hB : ∀ x : ℝ, ‖f x‖ ≤ B)
    (hδ0 : 0 ≤ δ) (hb1 : 1 ≤ b) (hδ : ∀ x ∈ Set.Ioo (-b) b, ‖p x - f x‖ ≤ δ)
    (hr : ∀ n ∈ RHLean.arithSupport a, |RHLean.shiftLengthRescaled a n| ≤ b - 1) :
    |RHLean.shiftFormRescaled a f - RHLean.shiftFormRescaled a p|
      ≤ δ * (2 * B + δ) * (∑ n ∈ RHLean.arithSupport a,
          |RHLean.arithCoeff n| * 2 * 2) := by
  obtain ⟨⟨hcd, -, -⟩, -⟩ := hf
  have hfc : Continuous f := hcd.continuous
  have hxwide : ∀ {x : ℝ}, x ∈ Set.Ioo (-1 : ℝ) 1 → x ∈ Set.Ioo (-b) b :=
    fun hx => ⟨by linarith [hx.1, hb1], by linarith [hx.2, hb1]⟩
  have hp_bound : ∀ x ∈ Set.Ioo (-b) b, ‖p x‖ ≤ B + δ := by
    intro x hx
    calc ‖p x‖ ≤ ‖f x‖ + ‖p x - f x‖ := by
          have h := norm_add_le (f x) (p x - f x)
          simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using h
      _ ≤ B + δ := add_le_add (hB x) (hδ x hx)
  have hxr : ∀ {x : ℝ}, x ∈ Set.Ioo (-1 : ℝ) 1 → ∀ {r : ℝ}, |r| ≤ b - 1 →
      x + r ∈ Set.Ioo (-b) b := by
    intro x hx r hr
    have hxabs : |x| < 1 := by rw [abs_lt]; exact ⟨by linarith [hx.1], hx.2⟩
    have hlt : |x + r| < b :=
      lt_of_le_of_lt (abs_add_le _ _) (by linarith)
    exact ⟨(abs_lt.mp hlt).1, (abs_lt.mp hlt).2⟩
  have hterm : ∀ (r : ℝ), |r| ≤ b - 1 → ∀ c d : ℝ, -1 ≤ c → d ≤ 1 → c ≤ d → d - c ≤ 2 →
      |(∫ x in Set.Ioo c d, f x * star (f (x + r))).re
        - (∫ x in Set.Ioo c d, p x * star (p (x + r))).re| ≤ δ * (2 * B + δ) * 2 := by
    intro r hr c d hc hd hcd hlen
    have hIf : IntegrableOn (fun x : ℝ => f x * star (f (x + r))) (Set.Ioo c d) := by
      refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
        (hfc.mul (hfc.comp (by continuity)).star).aestronglyMeasurable (B * B) ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      rw [norm_mul, norm_star]
      exact mul_le_mul (hB x) (hB _) (norm_nonneg _) hB0
    have hIp : IntegrableOn (fun x : ℝ => p x * star (p (x + r))) (Set.Ioo c d) := by
      refine IntegrableOn.of_bound (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
        (hp.mul (hp.comp (by continuity)).star).aestronglyMeasurable ((B + δ) * (B + δ)) ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      rw [norm_mul, norm_star]
      have hx1 : x ∈ Set.Ioo (-1 : ℝ) 1 :=
        ⟨by linarith [hx.1, hc], by linarith [hx.2, hd]⟩
      have h1 : ‖p x‖ ≤ B + δ := hp_bound x (hxwide hx1)
      have h2 : ‖p (x + r)‖ ≤ B + δ := hp_bound _ (hxr hx1 hr)
      exact mul_le_mul h1 h2 (norm_nonneg _) (by linarith [hB0, hδ0])
    have hlin : (∫ x in Set.Ioo c d, f x * star (f (x + r)))
        - (∫ x in Set.Ioo c d, p x * star (p (x + r)))
        = ∫ x in Set.Ioo c d,
          (f x * star (f (x + r)) - p x * star (p (x + r))) := by
      rw [← integral_sub hIf hIp]
    rw [show (∫ x in Set.Ioo c d, f x * star (f (x + r))).re
          - (∫ x in Set.Ioo c d, p x * star (p (x + r))).re
          = ((∫ x in Set.Ioo c d, f x * star (f (x + r)))
          - (∫ x in Set.Ioo c d, p x * star (p (x + r)))).re from rfl, hlin]
    calc |(∫ x in Set.Ioo c d,
          (f x * star (f (x + r)) - p x * star (p (x + r)))).re|
        ≤ ‖∫ x in Set.Ioo c d,
          (f x * star (f (x + r)) - p x * star (p (x + r)))‖ := Complex.abs_re_le_norm _
      _ ≤ ∫ x in Set.Ioo c d,
          ‖f x * star (f (x + r)) - p x * star (p (x + r))‖ :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ _x in Set.Ioo c d, δ * (2 * B + δ) := by
          refine integral_mono_ae (hIf.sub hIp).norm
            (integrableOn_const (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_ne_top)) ?_
          filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
          have hx1 : x ∈ Set.Ioo (-1 : ℝ) 1 :=
            ⟨by linarith [hx.1, hc], by linarith [hx.2, hd]⟩
          have h1 : ‖f x - p x‖ ≤ δ := by
            have h := hδ x (hxwide hx1); rwa [norm_sub_rev] at h
          have h3 : ‖p x‖ ≤ B + δ := hp_bound x (hxwide hx1)
          have h4 : ‖f (x + r) - p (x + r)‖ ≤ δ := by
            have h := hδ (x + r) (hxr hx1 hr); rwa [norm_sub_rev] at h
          calc ‖f x * star (f (x + r)) - p x * star (p (x + r))‖
              = ‖(f x - p x) * star (f (x + r))
                  + p x * star (f (x + r) - p (x + r))‖ := by
                rw [show f x * star (f (x + r)) - p x * star (p (x + r))
                    = (f x - p x) * star (f (x + r))
                      + p x * star (f (x + r) - p (x + r)) by
                      rw [star_sub]; ring]
            _ ≤ ‖(f x - p x) * star (f (x + r))‖
                  + ‖p x * star (f (x + r) - p (x + r))‖ := norm_add_le _ _
            _ = ‖f x - p x‖ * ‖f (x + r)‖
                  + ‖p x‖ * ‖f (x + r) - p (x + r)‖ := by
                rw [norm_mul, norm_star, norm_mul, norm_star]
            _ ≤ δ * B + (B + δ) * δ :=
                add_le_add (mul_le_mul h1 (hB _) (norm_nonneg _) hδ0)
                  (mul_le_mul h3 h4 (norm_nonneg _) (by linarith [hB0, hδ0]))
            _ = δ * (2 * B + δ) := by ring
      _ = δ * (2 * B + δ) * (d - c) := by
          have hvolcd : (volume.restrict (Set.Ioo c d)).real Set.univ = d - c := by
            show (volume.restrict (Set.Ioo c d) Set.univ).toReal = d - c
            rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
              ENNReal.toReal_ofReal (by linarith)]
          rw [integral_const, smul_eq_mul, hvolcd]
          ring
      _ ≤ δ * (2 * B + δ) * 2 := by
          have h0 : 0 ≤ δ * (2 * B + δ) := by nlinarith [hB0, hδ0]
          nlinarith
  have hpair : ∀ n ∈ RHLean.arithSupport a,
      |((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
            f x * star (f (x + RHLean.shiftLengthRescaled a n)))
          + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
            f x * star (f (x - RHLean.shiftLengthRescaled a n)))).re
        - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
            p x * star (p (x + RHLean.shiftLengthRescaled a n)))
          + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
            p x * star (p (x - RHLean.shiftLengthRescaled a n)))).re|
      ≤ δ * (2 * B + δ) * 2 + δ * (2 * B + δ) * 2 := by
    intro n hn
    have hrp := Y7Op.shiftLengthRescaled_pos hn
    have hr2 := Y7Op.shiftLengthRescaled_lt_two hn
    have hrn := hr n hn
    have h1 := hterm (RHLean.shiftLengthRescaled a n) hrn (-1)
      (1 - RHLean.shiftLengthRescaled a n) (by norm_num) (by linarith)
      (by linarith) (by linarith)
    have h2 := hterm (-(RHLean.shiftLengthRescaled a n)) (by simpa using hrn)
      (-1 + RHLean.shiftLengthRescaled a n) 1 (by linarith) (by norm_num)
      (by linarith) (by linarith)
    have h2' : |(∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
            f x * star (f (x - RHLean.shiftLengthRescaled a n))).re
        - (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
            p x * star (p (x - RHLean.shiftLengthRescaled a n))).re|
        ≤ δ * (2 * B + δ) * 2 := by
      simpa only [sub_eq_add_neg] using h2
    rw [Complex.add_re, Complex.add_re]
    calc |((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              f x * star (f (x + RHLean.shiftLengthRescaled a n))).re
            + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              f x * star (f (x - RHLean.shiftLengthRescaled a n))).re)
          - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              p x * star (p (x + RHLean.shiftLengthRescaled a n))).re
            + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              p x * star (p (x - RHLean.shiftLengthRescaled a n))).re)|
        = |((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              f x * star (f (x + RHLean.shiftLengthRescaled a n))).re
            - (∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              p x * star (p (x + RHLean.shiftLengthRescaled a n))).re)
          + ((∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              f x * star (f (x - RHLean.shiftLengthRescaled a n))).re
            - (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              p x * star (p (x - RHLean.shiftLengthRescaled a n))).re)| := by
          ring_nf
      _ ≤ |(∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              f x * star (f (x + RHLean.shiftLengthRescaled a n))).re
            - (∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
              p x * star (p (x + RHLean.shiftLengthRescaled a n))).re|
          + |(∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              f x * star (f (x - RHLean.shiftLengthRescaled a n))).re
            - (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
              p x * star (p (x - RHLean.shiftLengthRescaled a n))).re| := abs_add_le _ _
      _ ≤ δ * (2 * B + δ) * 2 + δ * (2 * B + δ) * 2 := add_le_add h1 h2'
  have hform : |RHLean.shiftFormRescaled a f - RHLean.shiftFormRescaled a p|
      = |∑ n ∈ RHLean.arithSupport a, RHLean.arithCoeff n *
          (((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                f x * star (f (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                f x * star (f (x - RHLean.shiftLengthRescaled a n)))).re
            - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                p x * star (p (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                p x * star (p (x - RHLean.shiftLengthRescaled a n)))).re)| := by
    congr 1
    unfold RHLean.shiftFormRescaled
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro n hn
    ring
  calc |RHLean.shiftFormRescaled a f - RHLean.shiftFormRescaled a p|
      = |∑ n ∈ RHLean.arithSupport a, RHLean.arithCoeff n *
          (((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                f x * star (f (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                f x * star (f (x - RHLean.shiftLengthRescaled a n)))).re
            - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                p x * star (p (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                p x * star (p (x - RHLean.shiftLengthRescaled a n)))).re)| := hform
    _ ≤ ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n *
          (((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                f x * star (f (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                f x * star (f (x - RHLean.shiftLengthRescaled a n)))).re
            - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                p x * star (p (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                p x * star (p (x - RHLean.shiftLengthRescaled a n)))).re)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ = ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n| *
          |((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                f x * star (f (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                f x * star (f (x - RHLean.shiftLengthRescaled a n)))).re
            - ((∫ x in Set.Ioo (-1 : ℝ) (1 - RHLean.shiftLengthRescaled a n),
                p x * star (p (x + RHLean.shiftLengthRescaled a n)))
              + (∫ x in Set.Ioo (-1 + RHLean.shiftLengthRescaled a n) 1,
                p x * star (p (x - RHLean.shiftLengthRescaled a n)))).re| := by
        simp only [abs_mul]
    _ ≤ ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n| *
          (δ * (2 * B + δ) * 2 + δ * (2 * B + δ) * 2) := by
        apply Finset.sum_le_sum
        intro n hn
        exact mul_le_mul_of_nonneg_left (hpair n hn) (abs_nonneg _)
    _ = δ * (2 * B + δ) * (∑ n ∈ RHLean.arithSupport a,
          |RHLean.arithCoeff n| * 2 * 2) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro n hn
        ring
lemma core_bound_global {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖g x‖ ≤ B := by
  obtain ⟨B, hB0, hB⟩ := core_bound hg
  refine ⟨B, hB0, fun x => ?_⟩
  by_cases hx : x ∈ Set.Ioo (-1 : ℝ) 1
  · exact hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  · have hz : g x = 0 := by
      by_contra h
      exact hx (hg.2 h)
    rw [hz, norm_zero]
    exact hB0
lemma norm_ofReal' (r : ℝ) : ‖((r : ℝ) : ℂ)‖ = |r| := by
  rw [Complex.norm_def, Complex.normSq_ofReal, ← sq, Real.sqrt_sq_eq_abs]
lemma norm_sRescaled_le (a x : ℝ) (hx : |x| ≤ 1) :
    ‖RHLean.sRescaled a x‖ ≤ Real.sinh (|a| / 2) := by
  have h1 : |a * x / 2| ≤ |a| / 2 := by
    rw [abs_div, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    have h2 : |a| * |x| ≤ |a| * 1 := mul_le_mul_of_nonneg_left hx (abs_nonneg a)
    calc |a| * |x| / 2 ≤ |a| * 1 / 2 := by linarith
      _ = |a| / 2 := by ring
  have h3 : Real.sinh |a * x / 2| ≤ Real.sinh (|a| / 2) := Real.sinh_le_sinh.mpr h1
  unfold RHLean.sRescaled
  rw [norm_ofReal', Real.abs_sinh]
  exact h3
lemma poly_lipschitz (P : Polynomial ℝ) :
    ∃ Cp : ℝ, 0 ≤ Cp ∧ ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖(((P.eval x : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ)‖ ≤ Cp * ‖x - y‖ := by
  obtain ⟨Cp, hCp⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    ((Polynomial.continuous (Polynomial.derivative P)).continuousOn)
  have Cp0 : 0 ≤ Cp := le_trans (norm_nonneg _) (hCp 0 ⟨by norm_num, by norm_num⟩)
  refine ⟨Cp, Cp0, fun x hx y hy => ?_⟩
  have hdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1, DifferentiableAt ℝ (fun z => P.eval z) z :=
    fun z _ => (Polynomial.differentiable (p := P)).differentiableAt
  have hbound : ∀ z ∈ Set.Icc (-1 : ℝ) 1, ‖deriv (fun z => P.eval z) z‖ ≤ Cp := by
    intro z hz
    rw [(Polynomial.hasDerivAt (p := P) z).deriv]
    exact hCp z hz
  have h := Convex.norm_image_sub_le_of_norm_deriv_le hdiff hbound
    (convex_Icc (-1 : ℝ) 1) hy hx
  have h' : |P.eval x - P.eval y| ≤ Cp * ‖x - y‖ := by
    simpa only [Real.norm_eq_abs] using h
  have hcast : ‖(((P.eval x : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ)‖
      = |P.eval x - P.eval y| := by
    rw [show (((P.eval x : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ)
        = (((P.eval x - P.eval y : ℝ)) : ℂ) by simp, norm_ofReal']
  rw [hcast]
  exact h'
lemma sub_lipschitz_of_c1 {F : ℝ → ℝ} {P : Polynomial ℝ} {η : ℝ}
    (hF : ∀ x, HasDerivAt F (deriv F x) x)
    (hη0 : 0 ≤ η)
    (hder : ∀ x ∈ Set.Icc (-1 : ℝ) 1,
      |(Polynomial.derivative P).eval x - deriv F x| ≤ η) :
    ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖((((F x : ℝ)) : ℂ) - (((P.eval x : ℝ)) : ℂ))
        - ((((F y : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ))‖ ≤ η * ‖x - y‖ := by
  intro x hx y hy
  have hGdiff : ∀ z ∈ Set.Icc (-1 : ℝ) 1,
      DifferentiableAt ℝ (fun z => F z - P.eval z) z :=
    fun z hz => ((hF z).differentiableAt.sub ((Polynomial.differentiable (p := P)).differentiableAt))
  have hGbound : ∀ z ∈ Set.Icc (-1 : ℝ) 1, ‖deriv (fun z => F z - P.eval z) z‖ ≤ η := by
    intro z hz
    have h1 : deriv (fun z => F z - P.eval z) z
        = deriv F z - (Polynomial.derivative P).eval z := by
      change deriv (F - fun z => P.eval z) z
        = deriv F z - (Polynomial.derivative P).eval z
      rw [deriv_sub (hF z).differentiableAt
          ((Polynomial.differentiable (p := P)).differentiableAt),
        (hF z).deriv, (Polynomial.hasDerivAt (p := P) z).deriv]
    rw [h1, Real.norm_eq_abs, abs_sub_comm]
    exact hder z hz
  have h := Convex.norm_image_sub_le_of_norm_deriv_le hGdiff hGbound
    (convex_Icc (-1 : ℝ) 1) hy hx
  have h' : |(F x - P.eval x) - (F y - P.eval y)| ≤ η * ‖x - y‖ := by
    simpa only [Real.norm_eq_abs] using h
  have hcast : ‖((((F x : ℝ)) : ℂ) - (((P.eval x : ℝ)) : ℂ))
        - ((((F y : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ))‖
      = |(F x - P.eval x) - (F y - P.eval y)| := by
    rw [show (((F x : ℝ)) : ℂ) - (((P.eval x : ℝ)) : ℂ)
          - ((((F y : ℝ)) : ℂ) - (((P.eval y : ℝ)) : ℂ))
        = (((F x - P.eval x) - (F y - P.eval y) : ℝ) : ℂ) by
      push_cast
      ring, norm_ofReal']
  rw [hcast]
  exact h'
lemma rePart_c1_data {g : ℝ → ℂ} (hg : g ∈ RHLean.localizedCore 1)
    (hreal : ∀ x, (g x).im = 0) :
    (∀ x, HasDerivAt (fun x => (g x).re) (deriv (fun x => (g x).re) x) x) ∧
    Continuous (deriv (fun x => (g x).re)) ∧
    (∀ x, (g (-x)).re = -((g x).re)) := by
  have hcd := hg.1.1
  have hdiff : ∀ x, HasDerivAt (fun x => (g x).re) (deriv (fun x => (g x).re) x) x := by
    intro x
    have hd : DifferentiableAt ℝ g x := (hcd.differentiable (by simp)).differentiableAt
    exact ((Complex.reCLM.differentiableAt).comp x hd).hasDerivAt
  refine ⟨hdiff, ?_, ?_⟩
  · have hFderiv : ∀ x, deriv (fun x => (g x).re) x = (deriv g x).re := by
      intro x
      have h2 := HasDerivAt.ofReal_comp (hdiff x)
      have hfun : (fun y : ℝ => (((fun z => (g z).re) y : ℝ) : ℂ)) = g := by
        funext y
        apply Complex.ext
        · simp
        · simp [hreal y]
      rw [hfun] at h2
      rw [h2.deriv, Complex.ofReal_re]
    rw [show deriv (fun x => (g x).re) = fun x => (deriv g x).re from funext hFderiv]
    exact Complex.continuous_re.comp (hcd.continuous_deriv (by simp))
  · intro x
    rw [hg.1.2.2 x]
    simp
lemma abs_sum_six_le (x1 x2 x3 x4 x5 x6 : ℝ) :
    |x1 + x2 + x3 + x4 + x5 + x6|
      ≤ |x1| + |x2| + |x3| + |x4| + |x5| + |x6| := by
  have h1 := abs_add_le (x1 + x2 + x3 + x4 + x5) x6
  have h2 := abs_add_le (x1 + x2 + x3 + x4) x5
  have h3 := abs_add_le (x1 + x2 + x3) x4
  have h4 := abs_add_le (x1 + x2) x3
  have h5 := abs_add_le x1 x2
  linarith
theorem realPartDensity_of_c1 (a : ℝ) (ha : 0 ≤ a) : RealPartDensity a := by
  intro f hf hreal ε hε
  obtain ⟨B, hB0, hBglob⟩ := core_bound_global hf
  have hB : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖f x‖ ≤ B := fun x _ => hBglob x
  obtain ⟨Cf, hCf0, hlipf⟩ := core_lipschitz hf
  set b : ℝ := 1 + ∑ n ∈ RHLean.arithSupport a, |RHLean.shiftLengthRescaled a n| with hb_def
  have hb1 : 1 ≤ b := by
    rw [hb_def]
    have h := Finset.sum_nonneg
      (fun n (_ : n ∈ RHLean.arithSupport a) => abs_nonneg (RHLean.shiftLengthRescaled a n))
    linarith
  have hb0 : 0 ≤ b := le_trans zero_le_one hb1
  have hr : ∀ n ∈ RHLean.arithSupport a, |RHLean.shiftLengthRescaled a n| ≤ b - 1 := by
    intro n hn
    have hle : |RHLean.shiftLengthRescaled a n| ≤
        ∑ m ∈ RHLean.arithSupport a, |RHLean.shiftLengthRescaled a m| :=
      Finset.single_le_sum (f := fun m => |RHLean.shiftLengthRescaled a m|)
        (fun m _ => abs_nonneg _) hn
    rw [hb_def]; linarith
  set Ms : ℝ := Real.sinh (|a| / 2) with hMs_def
  have hMs0 : 0 ≤ Ms := by
    rw [hMs_def]; exact Real.sinh_nonneg_iff.mpr (by positivity)
  have hsinh : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖RHLean.sRescaled a x‖ ≤ Ms := by
    intro x hx
    rw [hMs_def]
    exact norm_sRescaled_le a x (le_of_lt (abs_lt.mpr ⟨hx.1, hx.2⟩))
  set Vint : ℝ := ∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x with hV_def
  have hVnn : 0 ≤ Vint := by
    rw [hV_def]
    exact setIntegral_nonneg_of_ae_restrict (by
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      exact rescaledPotential_nonneg hx)
  set Csum : ℝ := ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n| * 2 * 2 with hCsum_def
  have hCsum0 : 0 ≤ Csum := by
    rw [hCsum_def]; exact Finset.sum_nonneg (fun n _ => by positivity)
  set Ka : ℝ := |a| * (Real.exp (2 * a) / 2 + Real.exp a / 4) with hKa_def
  have hKa0 : 0 ≤ Ka := by rw [hKa_def]; positivity
  set M0 : ℝ := max 1 |RHLean.c0 a| with hM0_def
  have hM00 : 0 ≤ M0 := le_trans zero_le_one (le_max_left _ _)
  set K : ℝ := M0 * ((2 * B + 1) * 2) + (2 * B + 1) * Vint + (2 * B + 1) * (Ka * 4)
      + (2 * a) * (2 * Ms) * (2 * Ms * (2 * B + 1)) + 2 * (2 * B + 1)
      + (2 * B + 1) * Csum with hK_def
  have hK0 : 0 ≤ K := by
    rw [hK_def]
    have h2B1 : 0 ≤ 2 * B + 1 := by linarith
    have h2a : 0 ≤ 2 * a := by linarith
    have h2Ms : 0 ≤ 2 * Ms := by linarith
    have t1 : 0 ≤ M0 * ((2 * B + 1) * 2) := mul_nonneg hM00 (by positivity)
    have t2 : 0 ≤ (2 * B + 1) * Vint := mul_nonneg h2B1 hVnn
    have t3 : 0 ≤ (2 * B + 1) * (Ka * 4) := mul_nonneg h2B1 (by linarith [hKa0])
    have t4 : 0 ≤ 2 * a * (2 * Ms) * (2 * Ms * (2 * B + 1)) :=
      mul_nonneg (mul_nonneg h2a h2Ms) (mul_nonneg h2Ms h2B1)
    have t5 : 0 ≤ 2 * (2 * B + 1) := by linarith
    have t6 : 0 ≤ (2 * B + 1) * Csum := mul_nonneg h2B1 hCsum0
    linarith [t1, t2, t3, t4, t5, t6]
  set eps : ℝ := min 1 (ε / (K + 1)) with heps_def
  have hK1pos : 0 < K + 1 := by linarith
  have heps0 : 0 < eps := by
    rw [heps_def]; exact lt_min (by norm_num) (div_pos hε hK1pos)
  have heps1 : eps ≤ 1 := by rw [heps_def]; exact min_le_left _ _
  have hepsK : eps * K ≤ ε := by
    have hle : eps ≤ ε / (K + 1) := by rw [heps_def]; exact min_le_right _ _
    have h1 : eps * K ≤ (ε / (K + 1)) * K := mul_le_mul_of_nonneg_right hle hK0
    have h2 : (ε / (K + 1)) * (K + 1) = ε := by field_simp
    have h3 : (ε / (K + 1)) * K ≤ (ε / (K + 1)) * (K + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (div_nonneg hε.le hK1pos.le)
    rw [h2] at h3
    linarith
  obtain ⟨hc1, hc1cont, hc1odd⟩ := rePart_c1_data hf hreal
  obtain ⟨P, hPodd, hPsup, hPder⟩ :=
    exists_odd_poly_c1_approx (f := fun x => (f x).re) hc1 hc1cont hc1odd (b := b) hb0
      (ε := eps) heps0
  set p : ℝ → ℂ := fun x => (((P.eval x : ℝ)) : ℂ) with hp_def
  have hp_cont : Continuous p := Complex.continuous_ofReal.comp (Polynomial.continuous P)
  have hδwide : ∀ x ∈ Set.Ioo (-b) b, ‖p x - f x‖ ≤ eps := by
    intro x hx
    have h1 : p x - f x = (((P.eval x - (f x).re : ℝ)) : ℂ) := by
      rw [hp_def]; apply Complex.ext <;> simp [hreal x]
    rw [h1, norm_ofReal']
    exact hPsup x ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  have hδ : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖p x - f x‖ ≤ eps :=
    fun x hx => hδwide x ⟨by linarith [hx.1, hb1], by linarith [hx.2, hb1]⟩
  have hder1 : ∀ x ∈ Set.Icc (-1 : ℝ) 1,
      |(Polynomial.derivative P).eval x - deriv (fun x => (f x).re) x| ≤ eps :=
    fun x hx => hPder x ⟨by linarith [hx.1, hb1], by linarith [hx.2, hb1]⟩
  have hsub_lip := sub_lipschitz_of_c1 (F := fun x => (f x).re) (P := P) (η := eps)
    hc1 heps0.le hder1
  have hm_eq : ∀ x : ℝ, f x - p x = ((((fun x => (f x).re) x) - P.eval x : ℝ) : ℂ) := by
    intro x
    rw [hp_def]
    apply Complex.ext <;> simp [hreal x]
  have hlip_m : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖(f x - p x) - (f y - p y)‖ ≤ eps * ‖x - y‖ := by
    intro x hx y hy
    simpa only [hm_eq x, hm_eq y, Complex.ofReal_sub] using hsub_lip x hx y hy
  obtain ⟨Cp, hCp0, hCplip⟩ := poly_lipschitz P
  have hplip : ∀ x ∈ Set.Icc (-1 : ℝ) 1, ∀ y ∈ Set.Icc (-1 : ℝ) 1,
      ‖p x - p y‖ ≤ Cp * ‖x - y‖ := by
    intro x hx y hy
    rw [hp_def]
    exact hCplip x hx y hy
  have hmass := mass_sub_le (f := f) hf (p := p) hp_cont hB heps0.le hδ
  have hpot := potential_sub_le (f := f) hf (p := p) hp_cont hB heps0.le hδ
  have hgamma := gamma_sub_le (a := a) ha (f := f) hf (p := p) hp_cont hB0 hB heps0.le hδ
  have hpolar := polar_sub_le (a := a) ha (f := f) hf (p := p) hp_cont hB0 hB heps0.le
    hδ hMs0 hsinh
  have harch := arch_sub_le (f := f) hf (p := p) hp_cont hB0 hB heps0.le hδ
    hCf0 hlipf hCp0 hplip heps0.le hlip_m
  have hshift := shift_sub_le (a := a) (f := f) hf (p := p) hp_cont hB0 hBglob
    heps0.le hb1 hδwide hr
  have h2B : 2 * B + eps ≤ 2 * B + 1 := by linarith
  have hmass_bd : |(∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)| ≤ eps * ((2 * B + 1) * 2) := by
    refine hmass.trans ?_
    calc eps * (2 * B + eps) * 2 = eps * ((2 * B + eps) * 2) := by ring
      _ ≤ eps * ((2 * B + 1) * 2) := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right h2B (by norm_num)) heps0.le
  have hmass_c0 : |RHLean.c0 a * ((∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2))|
      ≤ eps * (M0 * ((2 * B + 1) * 2)) := by
    rw [abs_mul]
    calc |RHLean.c0 a| * |(∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
          - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)|
        ≤ M0 * (eps * ((2 * B + 1) * 2)) :=
          mul_le_mul (le_max_right _ _) hmass_bd (abs_nonneg _) hM00
      _ = eps * (M0 * ((2 * B + 1) * 2)) := by ring
  have hpot_bd : |(∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, RHLean.rescaledPotential x * ‖p x‖ ^ 2)|
      ≤ eps * ((2 * B + 1) * Vint) := by
    refine hpot.trans ?_
    calc eps * (2 * B + eps) * Vint = eps * ((2 * B + eps) * Vint) := by ring
      _ ≤ eps * ((2 * B + 1) * Vint) := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right h2B hVnn) heps0.le
  have hgamma_bd : |RHLean.gammaFormRescaled a f - RHLean.gammaFormRescaled a p|
      ≤ eps * ((2 * B + 1) * (Ka * 4)) := by
    refine hgamma.trans ?_
    calc eps * (2 * B + eps) * (Ka * 4) = eps * ((2 * B + eps) * (Ka * 4)) := by ring
      _ ≤ eps * ((2 * B + 1) * (Ka * 4)) := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right h2B (by linarith [hKa0])) heps0.le
  have hpolar_bd : |RHLean.polarFormRescaled a f - RHLean.polarFormRescaled a p|
      ≤ eps * ((2 * a) * (2 * Ms) * (2 * Ms * (2 * B + 1))) := by
    refine hpolar.trans ?_
    have h2Ms : 0 ≤ 2 * Ms := by linarith
    have hfac : 0 ≤ 2 * a * (2 * Ms * eps) :=
      mul_nonneg (by linarith) (mul_nonneg h2Ms heps0.le)
    calc 2 * a * (2 * Ms * eps) * (2 * Ms * (2 * B + eps))
        ≤ 2 * a * (2 * Ms * eps) * (2 * Ms * (2 * B + 1)) := by
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left h2B h2Ms) hfac
      _ = eps * ((2 * a) * (2 * Ms) * (2 * Ms * (2 * B + 1))) := by ring
  have harch_bd : |RHLean.archFormRescaled f - RHLean.archFormRescaled p|
      ≤ eps * (2 * (2 * B + 1)) := by
    refine harch.trans ?_
    have h1 : 2 * B + 2 * (B + eps) ≤ 2 * (2 * B + 1) := by linarith
    exact mul_le_mul_of_nonneg_left h1 heps0.le
  have hshift_bd : |RHLean.shiftFormRescaled a f - RHLean.shiftFormRescaled a p|
      ≤ eps * ((2 * B + 1) * Csum) := by
    refine hshift.trans ?_
    calc eps * (2 * B + eps) * Csum = eps * ((2 * B + eps) * Csum) := by ring
      _ ≤ eps * ((2 * B + 1) * Csum) := mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right h2B hCsum0) heps0.le
  set Ad : ℝ := RHLean.archFormRescaled f - RHLean.archFormRescaled p with hAd_def
  set Pd : ℝ := RHLean.potentialFormRescaled f - RHLean.potentialFormRescaled p with hPd_def
  set Gd : ℝ := RHLean.gammaFormRescaled a f - RHLean.gammaFormRescaled a p with hGd_def
  set Qd : ℝ := RHLean.polarFormRescaled a f - RHLean.polarFormRescaled a p with hQd_def
  set Sd : ℝ := RHLean.shiftFormRescaled a f - RHLean.shiftFormRescaled a p with hSd_def
  have hdecomp : RHLean.localizedFormRescaled a f - polyForm a P
      = Ad + RHLean.c0 a * ((∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
            - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)) + Pd - Gd - Qd - Sd := by
    unfold polyForm RHLean.localizedFormRescaled
    rw [hAd_def, hPd_def, hGd_def, hQd_def, hSd_def]
    ring
  have hfinal : |RHLean.localizedFormRescaled a f - polyForm a P| ≤ eps * K := by
    have habs := abs_sum_six_le Ad
      (RHLean.c0 a * ((∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2))) Pd (-Gd) (-Qd) (-Sd)
    rw [hdecomp]
    have h1' : |Ad| ≤ eps * (2 * (2 * B + 1)) := by
      rw [hAd_def]; exact harch_bd
    have h2' := hmass_c0
    have h3' : |Pd| ≤ eps * ((2 * B + 1) * Vint) := by
      rw [hPd_def]; exact hpot_bd
    have h4' : |(-Gd)| ≤ eps * ((2 * B + 1) * (Ka * 4)) := by
      rw [abs_neg]; exact hgamma_bd
    have h5' : |(-Qd)| ≤ eps * ((2 * a) * (2 * Ms) * (2 * Ms * (2 * B + 1))) := by
      rw [abs_neg]; exact hpolar_bd
    have h6' : |(-Sd)| ≤ eps * ((2 * B + 1) * Csum) := by
      rw [abs_neg]; exact hshift_bd
    have hKsum : eps * (2 * (2 * B + 1)) + eps * (M0 * ((2 * B + 1) * 2))
          + eps * ((2 * B + 1) * Vint) + eps * ((2 * B + 1) * (Ka * 4))
          + eps * ((2 * a) * (2 * Ms) * (2 * Ms * (2 * B + 1)))
          + eps * ((2 * B + 1) * Csum) = eps * K := by
      rw [hK_def]; ring
    change |Ad + RHLean.c0 a * ((∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
          - (∫ x in Set.Ioo (-1 : ℝ) 1, ‖p x‖ ^ 2)) + Pd + (-Gd) + (-Qd) + (-Sd)|
      ≤ eps * K
    linarith [habs, h1', h2', h3', h4', h5', h6', hKsum]
  exact ⟨P, hPodd, hfinal.trans hepsK⟩
theorem realPartDensity_endpoint_seven : RealPartDensity (RHLean.endpoint 7) :=
  realPartDensity_of_c1 (RHLean.endpoint 7) (by unfold RHLean.endpoint; positivity)
theorem y7PhysicalTarget_of_polynomialPositivity
    (hpos : PolynomialPositivity (RHLean.endpoint 7)) : Y7Target.Y7PhysicalTarget :=
  physicalTarget_of_polynomialPositivity_realPartDensity hpos realPartDensity_endpoint_seven
end Y7Density
