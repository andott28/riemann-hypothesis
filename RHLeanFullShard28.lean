private theorem lipschitz_on_Icc_of_deriv_bound {a Lu : ℝ} (ur : ℝ → ℝ)
    (ha : 0 < a)
    (hud : ∀ t : ℝ, HasDerivAt ur (deriv ur t) t)
    (huL : ∀ t ∈ Set.Icc (-a) a, |deriv ur t| ≤ Lu) :
    ∀ x ∈ Set.Icc (-a) a, ∀ y ∈ Set.Icc (-a) a,
      |ur x - ur y| ≤ Lu * |x - y| := by
  intro x hx y hy
  rcases le_total x y with hxy | hyx
  · have h := norm_image_sub_le_of_norm_deriv_le_segment' (a := x) (b := y)
      (f := ur) (f' := deriv ur) (C := Lu)
      (fun t _ => (hud t).hasDerivWithinAt)
      (fun t ht => huL t (by
        constructor
        · linarith [(Set.mem_Ico.mp ht).1, (Set.mem_Icc.mp hx).1]
        · linarith [(Set.mem_Ico.mp ht).2, (Set.mem_Icc.mp hy).2]))
    have h2 := h y ⟨hxy, le_rfl⟩
    calc |ur x - ur y| = |ur y - ur x| := by
          rw [show ur x - ur y = -(ur y - ur x) from by ring, abs_neg]
      _ ≤ Lu * (y - x) := h2
      _ = Lu * |x - y| := by
          rw [show |x - y| = y - x from by
            rw [abs_of_nonpos (by linarith)]
            ring]
  · have h := norm_image_sub_le_of_norm_deriv_le_segment' (a := y) (b := x)
      (f := ur) (f' := deriv ur) (C := Lu)
      (fun t _ => (hud t).hasDerivWithinAt)
      (fun t ht => huL t (by
        constructor
        · linarith [(Set.mem_Ico.mp ht).1, (Set.mem_Icc.mp hy).1]
        · linarith [(Set.mem_Ico.mp ht).2, (Set.mem_Icc.mp hx).2]))
    have h2 := h x ⟨hyx, le_rfl⟩
    calc |ur x - ur y| ≤ Lu * (x - y) := h2
      _ = Lu * |x - y| := by
          rw [show |x - y| = x - y from by
            rw [abs_of_nonneg (by linarith)]]
private theorem truncBasis_eq_zero_of_notMem {a₀ a : ℝ} (ha₀ : 0 < a₀)
    (ha₀a : a₀ < a) (N : ℕ) (i : Fin N ⊕ (Fin N ⊕ Fin N)) {x : ℝ}
    (hx : x ∉ Set.Ioo (-a) a) :
    truncBasis a₀ a N i x = 0 := by
  rcases i with i | i
  · exact oldBasis_eq_zero_of_notMem i (fun hmem => hx (by
      constructor <;> linarith [(Set.mem_Ioo.mp hmem).1,
        (Set.mem_Ioo.mp hmem).2, ha₀.le, ha₀a]))
  · rcases i with i | i
    · exact collarBasisRight_eq_zero_of_notMem i
        (fun hmem => hx (by
          constructor <;> linarith [(Set.mem_Ioo.mp hmem).1,
            (Set.mem_Ioo.mp hmem).2]))
    · exact collarBasisLeft_eq_zero_of_notMem i
        (fun hmem => hx (by
          constructor <;> linarith [(Set.mem_Ioo.mp hmem).1,
            (Set.mem_Ioo.mp hmem).2]))
private theorem span_zero_of_notMem {a₀ a : ℝ} (ha₀ : 0 < a₀) (ha₀a : a₀ < a)
    {N : ℕ} {g : ℝ → ℂ}
    (hg : g ∈ Submodule.span ℝ (Set.range (truncBasis a₀ a N)))
    {x : ℝ} (hx : x ∉ Set.Ioo (-a) a) : g x = 0 := by
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hg
  rw [← hc]
  simp only [Finsupp.sum, Finset.sum_apply]
  refine Finset.sum_eq_zero (fun i hi => ?_)
  rw [Pi.smul_apply, truncBasis_eq_zero_of_notMem ha₀ ha₀a N i hx,
    smul_zero]
private theorem measurable_of_mem_span {a₀ a : ℝ} {N : ℕ} {g : ℝ → ℂ}
    (hg : g ∈ Submodule.span ℝ (Set.range (truncBasis a₀ a N))) :
    Measurable g := by
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hg
  rw [← hc]
  simp only [Finsupp.sum, Finset.sum_apply]
  have hmeasT : ∀ i : Fin N ⊕ (Fin N ⊕ Fin N), Measurable
      (truncBasis a₀ a N i) := by
    intro i
    rcases i with i | i
    · exact measurable_oldBasis a₀ i
    · rcases i with i | i
      · exact measurable_collarBasisRight a₀ a i
      · exact measurable_collarBasisLeft a₀ a i
  induction c.support using Finset.cons_induction with
  | empty => rw [Finset.sum_empty]; exact measurable_const
  | @cons i s hi ih =>
      rw [Finset.sum_cons hi]
      have hφi : Measurable (fun x => c i • truncBasis a₀ a N i x) := by
        have h1 : (fun x => c i • truncBasis a₀ a N i x)
            = fun x => ((c i : ℝ) : ℂ) * truncBasis a₀ a N i x := by
          funext x
          exact RCLike.real_smul_eq_coe_mul _ _
        rw [h1]
        exact measurable_const.mul (hmeasT i)
      exact hφi.add ih
private theorem integrableOn_re_mul_bound {a Bf Bg : ℝ} (ha : 0 < a)
    {f g : ℝ → ℂ} (hf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hg : ∀ x : ℝ, ‖g x‖ ≤ Bg)
    (hfm : Measurable f) (hgm : Measurable g) :
    MeasureTheory.IntegrableOn (fun t => (f t * star (g t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hmeas : MeasureTheory.AEStronglyMeasurable
      (fun t => (f t * star (g t)).re)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    (Complex.continuous_re.measurable.comp
      (hfm.mul (continuous_star.measurable.comp hgm))).aestronglyMeasurable
  refine MeasureTheory.IntegrableOn.of_bound hfin hmeas (Bf * Bg) ?_
  filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
  calc ‖(f t * star (g t)).re‖
      = |(f t * star (g t)).re| := Real.norm_eq_abs _
    _ ≤ ‖f t * star (g t)‖ := Complex.abs_re_le_norm _
    _ = ‖f t‖ * ‖g t‖ := by rw [norm_mul, norm_star]
    _ ≤ Bf * Bg := mul_le_mul (hf t) (hg t) (norm_nonneg _)
        (le_trans (norm_nonneg _) (hf 0))
private theorem integrableOn_pot_mul_bound {a Bf Bg : ℝ} (ha : 0 < a)
    {f g : ℝ → ℂ} (hf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hg : ∀ x : ℝ, ‖g x‖ ≤ Bg)
    (hfm : Measurable f) (hgm : Measurable g)
    (hVm : Measurable (fun x : ℝ => RHLean.endpointPotential a x)) :
    MeasureTheory.IntegrableOn
      (fun t => RHLean.endpointPotential a t * (f t * star (g t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
  have hintV := Y7Epsilon.integrableOn_endpointPotential_abs ha
  have hintD : MeasureTheory.IntegrableOn
      (fun t => (Bf * Bg) * |RHLean.endpointPotential a t|)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hintV.const_mul (Bf * Bg)
  have hmeas : MeasureTheory.AEStronglyMeasurable
      (fun t => RHLean.endpointPotential a t * (f t * star (g t)).re)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    (hVm.mul (Complex.continuous_re.measurable.comp
      (hfm.mul (continuous_star.measurable.comp hgm)))).aestronglyMeasurable
  have hBf0 : (0 : ℝ) ≤ Bf := le_trans (norm_nonneg (f 0)) (hf 0)
  have hBg0 : (0 : ℝ) ≤ Bg := le_trans (norm_nonneg (g 0)) (hg 0)
  refine MeasureTheory.Integrable.mono
      (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a))
      (g := fun t => (Bf * Bg) * |RHLean.endpointPotential a t|) hintD hmeas ?_
  filter_upwards with t
  have hre : |(f t * star (g t)).re| ≤ ‖f t‖ * ‖g t‖ :=
    le_trans (Complex.abs_re_le_norm _) (le_of_eq (by rw [norm_mul, norm_star]))
  have hfB : ‖f t‖ * ‖g t‖ ≤ Bf * Bg :=
    mul_le_mul (hf t) (hg t) (norm_nonneg _) hBf0
  calc ‖RHLean.endpointPotential a t * (f t * star (g t)).re‖
      ≤ |RHLean.endpointPotential a t * (f t * star (g t)).re| :=
        le_of_eq (Real.norm_eq_abs _)
    _ ≤ |RHLean.endpointPotential a t| * |(f t * star (g t)).re| := by
        rw [abs_mul]
    _ ≤ |RHLean.endpointPotential a t| * (Bf * Bg) := by
        refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
        exact le_trans hre hfB
    _ ≤ (Bf * Bg) * |RHLean.endpointPotential a t| := by
        exact le_of_eq (by ring)
    _ = ‖(Bf * Bg) * |RHLean.endpointPotential a t|‖ := by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
          (mul_nonneg hBf0 hBg0) (abs_nonneg _))]
private theorem integrableOn_sph_mul_bound {a Bf : ℝ} (ha : 0 < a)
    {f : ℝ → ℂ} (hf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hfm : Measurable f) :
    MeasureTheory.IntegrableOn (fun t => star (RHLean.sph t) * f t)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
  have hsphC : Continuous (fun x : ℝ => RHLean.sph x) := by
    unfold RHLean.sph
    exact Complex.continuous_ofReal.comp
      (Real.continuous_sinh.comp (by fun_prop))
  have hintD : MeasureTheory.IntegrableOn
      (fun t => ‖RHLean.sph t‖ * Bf) (Set.Ioo (-a) a) MeasureTheory.volume :=
    (hsphC.norm.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self).mul_const Bf
  have hmeas : MeasureTheory.AEStronglyMeasurable
      (fun t => star (RHLean.sph t) * f t)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    have h1 : Measurable (fun t => star (RHLean.sph t) * f t) :=
      (continuous_star.measurable.comp hsphC.measurable).mul hfm
    exact h1.aestronglyMeasurable
  refine MeasureTheory.Integrable.mono
      (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a))
      (g := fun t => ‖RHLean.sph t‖ * Bf) hintD hmeas ?_
  have hBf0 : (0 : ℝ) ≤ Bf := le_trans (norm_nonneg (f 0)) (hf 0)
  filter_upwards with t
  calc ‖star (RHLean.sph t) * f t‖
      = ‖RHLean.sph t‖ * ‖f t‖ := by rw [norm_mul, norm_star]
    _ ≤ ‖RHLean.sph t‖ * Bf := mul_le_mul_of_nonneg_left (hf t)
        (norm_nonneg _)
    _ = ‖(‖RHLean.sph t‖ * Bf : ℝ)‖ := by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
          (norm_nonneg (RHLean.sph t)) hBf0)]
private theorem integrableOn_shift_mul_bound {a Bf Bg : ℝ} (ha : 0 < a)
    {f g : ℝ → ℂ} (hf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hg : ∀ x : ℝ, ‖g x‖ ≤ Bg)
    (hfm : Measurable f) (hgm : Measurable g) (n : ℕ) :
    MeasureTheory.IntegrableOn
      (fun t => f t * star (g (t + RHLean.shiftLength n)))
      (Set.Ioo (-a) a) MeasureTheory.volume := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hmeas : MeasureTheory.AEStronglyMeasurable
      (fun t => f t * star (g (t + RHLean.shiftLength n)))
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    have h1 : Measurable (fun t => f t * star (g (t + RHLean.shiftLength n))) :=
      hfm.mul (continuous_star.measurable.comp
        (hgm.comp (measurable_id.add measurable_const)))
    exact h1.aestronglyMeasurable
  refine MeasureTheory.IntegrableOn.of_bound hfin hmeas (Bf * Bg) ?_
  filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
  calc ‖f t * star (g (t + RHLean.shiftLength n))‖
      ≤ ‖f t‖ * ‖g (t + RHLean.shiftLength n)‖ :=
        le_of_eq (by rw [norm_mul, norm_star])
    _ ≤ Bf * Bg := mul_le_mul (hf t) (hg (t + RHLean.shiftLength n))
        (norm_nonneg _) (le_trans (norm_nonneg _) (hf 0))
private theorem integrableOn_archBilinKernel_bound {a L Bf s₁ s₂ : ℝ}
    (ha : 0 < a) (hL0 : 0 ≤ L)
    {f g : ℝ → ℂ} (hf : ∀ x : ℝ, ‖f x‖ ≤ Bf)
    (hfm : Measurable f) (hgm : Measurable g)
    (hgL : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      ∀ y ∈ Set.Ioo (-a) a, y ≠ s₁ → y ≠ s₂ →
        ‖g x - g y‖ ≤ L * |x - y|) :
    MeasureTheory.IntegrableOn (archBilinKernel f g)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hvol : (MeasureTheory.volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hru : (MeasureTheory.volume.restrict (Set.Ioo (-a) a)).real
      Set.univ = 2 * a := by
    show ENNReal.toReal ((MeasureTheory.volume.restrict (Set.Ioo (-a) a))
        Set.univ) = 2 * a
    rw [MeasureTheory.Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  have haeSeam : ∀ c : ℝ, {x : ℝ | x ≠ c} ∈
      MeasureTheory.ae (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    intro c
    have hnull : (MeasureTheory.volume.restrict (Set.Ioo (-a) a))
        ({c} : Set ℝ) = 0 := by
      rw [MeasureTheory.Measure.restrict_apply (MeasurableSet.singleton c)]
      exact MeasureTheory.measure_mono_null (fun y hy => hy.1)
        Real.volume_singleton
    have hset : {x : ℝ | x ≠ c} = ({c} : Set ℝ)ᶜ := by
      ext y
      simp
    rw [hset]
    exact MeasureTheory.compl_mem_ae_iff.mpr hnull
  have hKm : Measurable (archBilinKernel f g) := by
    have hre : Measurable (fun p : ℝ × ℝ =>
        ((f p.1 - f p.2) * star (g p.1 - g p.2)).re) :=
      Complex.continuous_re.measurable.comp
        (((hfm.comp measurable_fst).sub (hfm.comp measurable_snd)).mul
          (continuous_star.measurable.comp
            ((hgm.comp measurable_fst).sub (hgm.comp measurable_snd))))
    exact hre.div ((continuous_fst.sub continuous_snd).norm.measurable)
  have hKB : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      ∀ y ∈ Set.Ioo (-a) a, y ≠ s₁ → y ≠ s₂ →
        ‖archBilinKernel f g (x, y)‖ ≤ 2 * L * Bf := by
    intro x hx hxs1 hxs2 y hy hys1 hys2
    rcases eq_or_ne y x with rfl | hne
    · have hBf0 : (0 : ℝ) ≤ Bf := le_trans (norm_nonneg (f 0)) (hf 0)
      have h0 : archBilinKernel f g (y, y) = 0 := by
        unfold archBilinKernel
        simp
      rw [h0, norm_zero]
      have h2LB : (0 : ℝ) ≤ 2 * L * Bf :=
        mul_nonneg (mul_nonneg (by norm_num) hL0) hBf0
      exact h2LB
    · have hpos : 0 < |x - y| := by
        rw [abs_pos]
        exact sub_ne_zero.mpr (Ne.symm hne)
      have hgd : ‖g x - g y‖ ≤ L * |x - y| :=
        hgL x hx hxs1 hxs2 y hy hys1 hys2
      unfold archBilinKernel
      rw [Real.norm_eq_abs, abs_div, Real.norm_eq_abs, abs_abs]
      rw [div_le_iff₀ hpos]
      have hnum : |((f x - f y) * star (g x - g y)).re|
          ≤ ‖f x - f y‖ * ‖g x - g y‖ := by
        calc |((f x - f y) * star (g x - g y)).re|
            ≤ ‖(f x - f y) * star (g x - g y)‖ := Complex.abs_re_le_norm _
          _ = ‖f x - f y‖ * ‖g x - g y‖ := by rw [norm_mul, norm_star]
      calc |((f x - f y) * star (g x - g y)).re|
          ≤ ‖f x - f y‖ * (L * |x - y|) := by
            refine le_trans hnum ?_
            exact mul_le_mul_of_nonneg_left hgd (norm_nonneg _)
        _ ≤ (‖f x‖ + ‖f y‖) * (L * |x - y|) := by
            refine mul_le_mul_of_nonneg_right (norm_sub_le _ _) ?_
            exact mul_nonneg hL0 (abs_nonneg (x - y))
        _ ≤ (2 * Bf) * (L * |x - y|) := by
            refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg hL0
              (abs_nonneg (x - y)))
            have h1 := add_le_add (hf x) (hf y)
            linarith
        _ = 2 * L * Bf * |x - y| := by ring
  have hintSliceFor : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      MeasureTheory.IntegrableOn (fun y => archBilinKernel f g (x, y))
        (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro x hx hxs1 hxs2
    have hmeasSlice : MeasureTheory.AEStronglyMeasurable
        (fun y => archBilinKernel f g (x, y))
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
      (hKm.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable
    refine MeasureTheory.IntegrableOn.of_bound hfin hmeasSlice
        (2 * L * Bf) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        haeSeam s₁, haeSeam s₂] with y hy hys1 hys2
    exact hKB x hx hxs1 hxs2 y hy hys1 hys2
  rw [show MeasureTheory.IntegrableOn (archBilinKernel f g)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)
      = MeasureTheory.Integrable (archBilinKernel f g)
        ((MeasureTheory.volume.prod MeasureTheory.volume).restrict
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)) from rfl]
  rw [show (MeasureTheory.volume.prod MeasureTheory.volume).restrict
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      = (MeasureTheory.volume.restrict (Set.Ioo (-a) a)).prod
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) from
      (MeasureTheory.Measure.prod_restrict _ _).symm]
  have hKmA : MeasureTheory.AEStronglyMeasurable (archBilinKernel f g)
      ((MeasureTheory.volume.restrict (Set.Ioo (-a) a)).prod
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a))) :=
    hKm.aestronglyMeasurable
  refine (MeasureTheory.integrable_prod_iff hKmA).mpr ⟨?_, ?_⟩
  · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        haeSeam s₁, haeSeam s₂] with x hx hxs1 hxs2
    exact hintSliceFor x hx hxs1 hxs2
  ·
    have hmeasOuter : MeasureTheory.AEStronglyMeasurable
        (fun x => ∫ y, ‖archBilinKernel f g (x, y)‖
          ∂(MeasureTheory.volume.restrict (Set.Ioo (-a) a)))
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
      have hKmNorm : MeasureTheory.AEStronglyMeasurable
          (fun p : ℝ × ℝ => ‖archBilinKernel f g p‖)
          (MeasureTheory.volume.prod
            (MeasureTheory.volume.restrict (Set.Ioo (-a) a))) :=
        hKm.norm.aestronglyMeasurable
      simpa only using (hKmNorm.integral_prod_right').mono_measure
        MeasureTheory.Measure.restrict_le_self
    refine MeasureTheory.IntegrableOn.of_bound hfin hmeasOuter
        (2 * L * Bf * (2 * a)) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        haeSeam s₁, haeSeam s₂] with x hx hxs1 hxs2
    rw [Real.norm_eq_abs, abs_of_nonneg
      (integral_nonneg (fun y => norm_nonneg (archBilinKernel f g (x, y))))]
    have hintSliceX := (hintSliceFor x hx hxs1 hxs2).norm
    have h2LB0 : (0 : ℝ) ≤ 2 * L * Bf :=
      mul_nonneg (mul_nonneg (by norm_num) hL0)
        (le_trans (norm_nonneg (f 0)) (hf 0))
    have hintConstY : MeasureTheory.IntegrableOn
        (fun _ : ℝ => 2 * L * Bf) (Set.Ioo (-a) a) MeasureTheory.volume :=
      MeasureTheory.IntegrableOn.of_bound hfin
        measurable_const.aestronglyMeasurable (2 * L * Bf)
        (by filter_upwards with y
            rw [Real.norm_eq_abs, abs_of_nonneg h2LB0])
    calc ∫ y in Set.Ioo (-a) a, ‖archBilinKernel f g (x, y)‖
        ≤ ∫ y in Set.Ioo (-a) a, (2 * L * Bf) :=
          MeasureTheory.setIntegral_mono_ae_restrict
            (f := fun y => ‖archBilinKernel f g (x, y)‖)
            (g := fun _ : ℝ => 2 * L * Bf)
            (hf := hintSliceX) (hg := hintConstY)
            (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
                haeSeam s₁, haeSeam s₂] with y hy hys1 hys2
                exact hKB x hx hxs1 hxs2 y hy hys1 hys2)
      _ = 2 * L * Bf * (2 * a) := by
          rw [integral_const (c := 2 * L * Bf)
            (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)), smul_eq_mul,
            hru]
          ring
theorem localizedForm_nonneg_of_real_core {a a₀ Lu Bu : ℝ} (ur : ℝ → ℝ)
    (ha : 0 < a) (ha₀ : 0 < a₀) (ha₀a : a₀ < a)
    (hud : ∀ t : ℝ, HasDerivAt ur (deriv ur t) t)
    (hduc : Continuous (deriv ur))
    (huL : ∀ t ∈ Set.Icc (-a) a, |deriv ur t| ≤ Lu)
    (huA : ur (-a) = 0)
    (hBu : ∀ x ∈ Set.Icc (-a) a, |ur x| ≤ Bu)
    (huBg : ∀ x : ℝ, |ur x| ≤ Bu)
    (huZero : ∀ x : ℝ, x ∉ Set.Ioo (-a) a → ur x = 0)
    (hVm : Measurable (fun x : ℝ => RHLean.endpointPotential a x))
    (hGram : ∀ N : ℕ, Matrix.PosSemidef
      (RHLean.GateII.Reduction.gramMatrix a
        (RHLean.GateII.Reduction.truncBasis a₀ a N))) :
    0 ≤ RHLean.localizedForm a (fun x : ℝ => ((ur x : ℝ) : ℂ)) := by
  set uℂ : ℝ → ℂ := fun x => ((ur x : ℝ) : ℂ) with huℂd
  suffices main : ∀ ε : ℝ, 0 < ε →
      RHLean.localizedForm a uℂ ≥ -ε by
    by_contra hcon
    push_neg at hcon
    have h := main (-(RHLean.localizedForm a uℂ) / 2) (by linarith)
    linarith
  intro ε hεpos
  set M := Real.exp (2 * a) / 2 + Real.exp a / 4 with hMd
  have hMbound : ∀ z : ℝ, 0 ≤ z → z ≤ 2 * a → |RHLean.gammaKernel z| ≤ M := by
    intro z hz1 hz2
    have h1 := RHLean.GateII.Collar.gammaKernel_abs_le
      (show (0 : ℝ) ≤ 2 * a by linarith) ⟨hz1, hz2⟩
    rw [hMd]
    rw [show 2 * a / 2 = a from by ring] at h1
    exact h1
  have hM0 : 0 ≤ M := by rw [hMd]; positivity
  have hLu0 : 0 ≤ Lu := le_trans (abs_nonneg _) (huL 0 (by constructor <;> linarith))
  have hBu0 : 0 ≤ Bu := le_trans (abs_nonneg _) (huBg 0)
  have hV2 : (0 : ℝ) ≤ ∫ x in Set.Ioo (-a) a,
      (RHLean.endpointPotential a x) ^ 2 :=
    integral_nonneg (fun x => sq_nonneg _)
  have hSp : (0 : ℝ) ≤ ∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ :=
    integral_nonneg (fun x => norm_nonneg _)
  have hSp2 : (0 : ℝ) ≤ ∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2 :=
    integral_nonneg (fun x => sq_nonneg _)
  have hSum0 : (0 : ℝ) ≤ ∑ n ∈ RHLean.arithSupport a,
      |RHLean.arithCoeff n| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hpc0 : 0 ≤ |RHLean.physicalConstant| := abs_nonneg _
  set Cu := (Lu * a * Real.sqrt (2 * a)
    + |RHLean.physicalConstant| * Bu * Real.sqrt (2 * a)
    + Bu * Real.sqrt (∫ x in Set.Ioo (-a) a,
        (RHLean.endpointPotential a x) ^ 2)
    + M * Bu * (2 * a) * Real.sqrt (2 * a)
    + 2 * Bu * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
    + (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
      * (2 * Bu * Real.sqrt (2 * a))) with hCud
  set Cg := (Lu + 1) * a * Real.sqrt (2 * a)
    + |RHLean.physicalConstant| * (Bu + 2 * a) * Real.sqrt (2 * a)
    + (Bu + 2 * a) * Real.sqrt (∫ x in Set.Ioo (-a) a,
        (RHLean.endpointPotential a x) ^ 2)
    + M * (Bu + 2 * a) * (2 * a) * Real.sqrt (2 * a)
    + 2 * (Bu + 2 * a) * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
    + (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
      * (2 * (Bu + 2 * a) * Real.sqrt (2 * a)) with hCgd
  set K := 2 * a * Real.sqrt (2 * a) with hKd
  have hK0 : 0 ≤ K := by
    rw [hKd]
    exact mul_nonneg (mul_nonneg (by norm_num) ha.le) (Real.sqrt_nonneg _)
  set S := (|Cu| + |Cg|) * K with hSd
  have hS0 : 0 ≤ S := by
    rw [hSd]
    exact mul_nonneg (add_nonneg (abs_nonneg _) (abs_nonneg _)) hK0
  set η := min 1 (ε / (S + 1)) with hηd
  have hη1 : η ≤ 1 := min_le_left _ _
  have hηle : η ≤ ε / (S + 1) := min_le_right _ _
  have hηpos : 0 < η := by
    rw [hηd]
    exact lt_min (by norm_num) (div_pos hεpos (by
      have : (0 : ℝ) ≤ S + 1 := by linarith
      linarith))
  obtain ⟨N₂, g, hmem, hgbound, hglip, hl2⟩ :=
    Y7Epsilon.exists_span_c1_approx ha ha₀ ha₀a ur hud hduc huL huA hBu hηpos
  set hfun : ℝ → ℂ := fun x => uℂ x - g x with hhfund
  have huEq : hfun + g = uℂ := by
    funext x
    rw [hhfund]
    simp only [Pi.add_apply]
    ring
  have huC : Continuous uℂ := by
    rw [huℂd]
