theorem arch_slice_bound (a : ℝ) (f : ℝ → ℂ) (Lf : ℝ) (ha : 0 < a)
    (hf : Continuous f) (hLf : ∀ x y : ℝ, ‖f x - f y‖ ≤ Lf * ‖x - y‖)
    (x : ℝ) (hx : x ∈ Set.Ioo (-a) a) (y : ℝ) (hy : y ∈ Set.Ioo (-a) a) :
    ‖(‖f x - f y‖ ^ 2 / ‖x - y‖ : ℝ)‖ ≤ Lf * Lf * (2 * a) := by
  have hxa : |x| ≤ a := by
    rw [abs_le]
    exact ⟨by linarith [Set.mem_Ioo.mp hx], by linarith [Set.mem_Ioo.mp hx]⟩
  have hya : |y| ≤ a := by
    rw [abs_le]
    exact ⟨by linarith [Set.mem_Ioo.mp hy], by linarith [Set.mem_Ioo.mp hy]⟩
  have hLf0 : 0 ≤ Lf :=
    le_trans (norm_nonneg (f 0 - f 1)) (by
      have h := hLf 0 1
      rw [show ‖((0:ℝ) - 1)‖ = 1 from by norm_num, mul_one] at h
      exact h)
  have hdist : ‖x - y‖ ≤ 2 * a := by
    calc ‖x - y‖ ≤ ‖x‖ + ‖y‖ := norm_sub_le x y
      _ = |x| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
      _ ≤ 2 * a := by linarith
  rcases eq_or_ne y x with rfl | hne
  · rw [sub_self, sub_self]
    simp
    exact mul_nonneg (mul_self_nonneg Lf) (by linarith)
  · have hdpos : 0 < ‖x - y‖ := by
      rw [Real.norm_eq_abs, abs_pos]
      exact sub_ne_zero.mpr (Ne.symm hne)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [div_le_iff₀ hdpos]
    have hsq : ‖f x - f y‖ ≤ Lf * ‖x - y‖ := hLf x y
    calc ‖f x - f y‖ ^ 2 ≤ (Lf * ‖x - y‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) hsq 2
      _ = Lf * Lf * ‖x - y‖ ^ 2 := by ring
      _ ≤ Lf * Lf * (2 * a) * ‖x - y‖ := by
          have hc : 0 ≤ Lf * Lf * ‖x - y‖ :=
            mul_nonneg (mul_nonneg hLf0 hLf0) (norm_nonneg (x - y))
          calc Lf * Lf * ‖x - y‖ ^ 2
              = Lf * Lf * ‖x - y‖ * ‖x - y‖ := by ring
            _ ≤ Lf * Lf * ‖x - y‖ * (2 * a) :=
                mul_le_mul_of_nonneg_left hdist hc
            _ = Lf * Lf * (2 * a) * ‖x - y‖ := by ring
theorem archForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (Lf Lg : ℝ) (ha : 0 < a)
    (hf : Continuous f) (hg : Continuous g)
    (hLf : ∀ x y : ℝ, ‖f x - f y‖ ≤ Lf * ‖x - y‖)
    (hLg : ∀ x y : ℝ, ‖g x - g y‖ ≤ Lg * ‖x - y‖) :
    |RHLean.archForm a f - RHLean.archForm a g|
      ≤ (Lf + Lg) * a * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by
  have ha2 : 0 ≤ a := ha.le
  have hC0 : 0 ≤ Lf + Lg := by
    have hLf0 : 0 ≤ Lf :=
      le_trans (norm_nonneg (f 0 - f 1)) (by
        have h := hLf 0 1
        rw [show ‖((0:ℝ) - 1)‖ = 1 from by norm_num, mul_one] at h
        exact h)
    have hLg0 : 0 ≤ Lg :=
      le_trans (norm_nonneg (g 0 - g 1)) (by
        have h := hLg 0 1
        rw [show ‖((0:ℝ) - 1)‖ = 1 from by norm_num, mul_one] at h
        exact h)
    linarith
  have h14pos : (0:ℝ) < 1 / 4 := by norm_num
  have hHcont : Continuous (fun x : ℝ => f x - g x) := hf.sub hg
  have hfin : volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hvol : (volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hru : (volume.restrict (Set.Ioo (-a) a)).real Set.univ = 2 * a := by
    show ENNReal.toReal ((volume.restrict (Set.Ioo (-a) a)) Set.univ) = 2 * a
    rw [Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  have hintQf : ∀ x ∈ Set.Ioo (-a) a, IntegrableOn (fun y : ℝ =>
      ‖f x - f y‖ ^ 2 / ‖x - y‖) (Set.Ioo (-a) a) volume := by
    intro x hx
    refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ (Lf * Lf * (2 * a)) ?_
    · have hnum : Measurable (fun y : ℝ => ‖f x - f y‖ ^ 2) := by fun_prop
      have hden : Measurable (fun y : ℝ => ‖x - y‖) :=
        ((continuous_const.sub continuous_id).norm.measurable)
      exact (hnum.div hden).aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy
      exact arch_slice_bound a f Lf ha hf hLf x hx y hy
  have hintQg : ∀ x ∈ Set.Ioo (-a) a, IntegrableOn (fun y : ℝ =>
      ‖g x - g y‖ ^ 2 / ‖x - y‖) (Set.Ioo (-a) a) volume := by
    intro x hx
    refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ (Lg * Lg * (2 * a)) ?_
    · have hnum : Measurable (fun y : ℝ => ‖g x - g y‖ ^ 2) := by fun_prop
      have hden : Measurable (fun y : ℝ => ‖x - y‖) :=
        ((continuous_const.sub continuous_id).norm.measurable)
      exact (hnum.div hden).aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy
      exact arch_slice_bound a g Lg ha hg hLg x hx y hy
  have hintF : IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
      ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume) (Set.Ioo (-a) a) volume := by
    refine IntegrableOn.of_bound hfin ?_ ((Lf * Lf * (2 * a)) * (2 * a)) ?_
    · have hmeas : Measurable (fun p : ℝ × ℝ =>
          ‖f p.1 - f p.2‖ ^ 2 / ‖p.1 - p.2‖) := by
        refine Measurable.div ?_ ?_
        · fun_prop
        · exact ((continuous_fst.sub continuous_snd).norm.measurable)
      have hfm : AEStronglyMeasurable (fun p : ℝ × ℝ =>
          ‖f p.1 - f p.2‖ ^ 2 / ‖p.1 - p.2‖)
          (volume.prod (volume.restrict (Set.Ioo (-a) a))) :=
        hmeas.aestronglyMeasurable
      simpa only using (hfm.integral_prod_right').mono_measure
        Measure.restrict_le_self
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
      have hintConst : IntegrableOn (fun _ : ℝ => Lf * Lf * (2 * a))
          (Set.Ioo (-a) a) volume := by
        have hc : Continuous (fun _ : ℝ => Lf * Lf * (2 * a)) := by fun_prop
        exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
      have habs : ‖∫ y in Set.Ioo (-a) a,
          ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume‖
          ≤ ∫ y in Set.Ioo (-a) a,
              ‖(‖f x - f y‖ ^ 2 / ‖x - y‖ : ℝ)‖ ∂volume :=
        norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-a) a))
          (fun y : ℝ => ‖f x - f y‖ ^ 2 / ‖x - y‖)
      have hmono : ∫ y in Set.Ioo (-a) a,
          ‖(‖f x - f y‖ ^ 2 / ‖x - y‖ : ℝ)‖ ∂volume
          ≤ ∫ y in Set.Ioo (-a) a, (Lf * Lf * (2 * a)) ∂volume :=
        setIntegral_mono_ae_restrict (f := fun y : ℝ =>
            ‖(‖f x - f y‖ ^ 2 / ‖x - y‖ : ℝ)‖)
          (g := fun _ : ℝ => Lf * Lf * (2 * a))
          (hf := (hintQf x hx).abs) (hg := hintConst)
          (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy; exact arch_slice_bound a f Lf ha hf hLf x hx y hy)
      have hfold : ∫ y in Set.Ioo (-a) a, (Lf * Lf * (2 * a)) ∂volume
          = Lf * Lf * (2 * a) * (2 * a) := by
        rw [integral_const (c := Lf * Lf * (2 * a))
          (μ := volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
        linarith
      exact habs.trans (hmono.trans_eq hfold)
  have hintG : IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
      ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume) (Set.Ioo (-a) a) volume := by
    refine IntegrableOn.of_bound hfin ?_ ((Lg * Lg * (2 * a)) * (2 * a)) ?_
    · have hmeas : Measurable (fun p : ℝ × ℝ =>
          ‖g p.1 - g p.2‖ ^ 2 / ‖p.1 - p.2‖) := by
        refine Measurable.div ?_ ?_
        · fun_prop
        · exact ((continuous_fst.sub continuous_snd).norm.measurable)
      have hfm : AEStronglyMeasurable (fun p : ℝ × ℝ =>
          ‖g p.1 - g p.2‖ ^ 2 / ‖p.1 - p.2‖)
          (volume.prod (volume.restrict (Set.Ioo (-a) a))) :=
        hmeas.aestronglyMeasurable
      simpa only using (hfm.integral_prod_right').mono_measure
        Measure.restrict_le_self
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
      have hintConst : IntegrableOn (fun _ : ℝ => Lg * Lg * (2 * a))
          (Set.Ioo (-a) a) volume := by
        have hc : Continuous (fun _ : ℝ => Lg * Lg * (2 * a)) := by fun_prop
        exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
      have habs : ‖∫ y in Set.Ioo (-a) a,
          ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume‖
          ≤ ∫ y in Set.Ioo (-a) a,
              ‖(‖g x - g y‖ ^ 2 / ‖x - y‖ : ℝ)‖ ∂volume :=
        norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-a) a))
          (fun y : ℝ => ‖g x - g y‖ ^ 2 / ‖x - y‖)
      have hmono : ∫ y in Set.Ioo (-a) a,
          ‖(‖g x - g y‖ ^ 2 / ‖x - y‖ : ℝ)‖ ∂volume
          ≤ ∫ y in Set.Ioo (-a) a, (Lg * Lg * (2 * a)) ∂volume :=
        setIntegral_mono_ae_restrict (f := fun y : ℝ =>
            ‖(‖g x - g y‖ ^ 2 / ‖x - y‖ : ℝ)‖)
          (g := fun _ : ℝ => Lg * Lg * (2 * a))
          (hf := (hintQg x hx).abs) (hg := hintConst)
          (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy; exact arch_slice_bound a g Lg ha hg hLg x hx y hy)
      have hfold : ∫ y in Set.Ioo (-a) a, (Lg * Lg * (2 * a)) ∂volume
          = Lg * Lg * (2 * a) * (2 * a) := by
        rw [integral_const (c := Lg * Lg * (2 * a))
          (μ := volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
        linarith
      exact habs.trans (hmono.trans_eq hfold)
  have hintH : IntegrableOn (fun y : ℝ => ‖f y - g y‖)
      (Set.Ioo (-a) a) volume := by
    have hc : Continuous (fun y : ℝ => ‖f y - g y‖) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hpt : ∀ x : ℝ, ∀ y : ℝ,
      |‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖|
      ≤ (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖) := by
    intro x y
    rcases eq_or_ne y x with rfl | hne
    · rw [sub_self, sub_self, sub_self]
      simp
      nlinarith [hC0, norm_nonneg (f y - g y)]
    · have hdpos : 0 < |x - y| := by
        rw [abs_pos]
        exact sub_ne_zero.mpr (Ne.symm hne)
      rw [div_sub_div_same, abs_div, Real.norm_eq_abs, abs_abs, div_le_iff₀ hdpos]
      have hpt2 : |‖f x - f y‖ ^ 2 - ‖g x - g y‖ ^ 2|
          ≤ ‖(f x - f y) - (g x - g y)‖ * (‖f x - f y‖ + ‖g x - g y‖) := by
        rw [sq_sub_sq, abs_mul,
          abs_of_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _)), mul_comm]
        exact mul_le_mul (abs_norm_sub_norm_le _ _) (le_refl _)
          (add_nonneg (norm_nonneg _) (norm_nonneg _)) (norm_nonneg _)
      refine le_trans hpt2 ?_
      have h1 : ‖(f x - f y) - (g x - g y)‖
          ≤ ‖f x - g x‖ + ‖f y - g y‖ := by
        have heq : (f x - f y) - (g x - g y)
            = (f x - g x) - (f y - g y) := by ring
        rw [heq]
        exact norm_sub_le (f x - g x) (f y - g y)
      have h2 : ‖f x - f y‖ + ‖g x - g y‖
          ≤ (Lf + Lg) * ‖x - y‖ := by
        calc ‖f x - f y‖ + ‖g x - g y‖
            ≤ Lf * ‖x - y‖ + Lg * ‖x - y‖ := add_le_add (hLf x y) (hLg x y)
          _ = (Lf + Lg) * ‖x - y‖ := by ring
      calc ‖(f x - f y) - (g x - g y)‖ * (‖f x - f y‖ + ‖g x - g y‖)
          ≤ (‖f x - g x‖ + ‖f y - g y‖) * (‖f x - f y‖ + ‖g x - g y‖) :=
            mul_le_mul_of_nonneg_right h1 (add_nonneg (norm_nonneg _) (norm_nonneg _))
        _ ≤ (‖f x - g x‖ + ‖f y - g y‖) * ((Lf + Lg) * ‖x - y‖) :=
            mul_le_mul_of_nonneg_left h2 (add_nonneg (norm_nonneg _) (norm_nonneg _))
        _ = (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖) * ‖x - y‖ := by ring
  have hinner : ∀ x ∈ Set.Ioo (-a) a,
      |(∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
        - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume)|
      ≤ (Lf + Lg) * ((2 * a) * ‖f x - g x‖
          + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖) := by
    intro x hx
    rw [← integral_sub (hintQf x hx) (hintQg x hx)]
    have habs : |∫ y in Set.Ioo (-a) a,
        (‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖)| ≤
        ∫ y in Set.Ioo (-a) a,
        |‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖| := by
      have h := norm_integral_le_integral_norm
        (μ := volume.restrict (Set.Ioo (-a) a))
        (fun y : ℝ => ‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖)
      rw [Real.norm_eq_abs] at h
      exact h
    refine le_trans habs ?_
    have hintDG : IntegrableOn (fun y : ℝ => ‖f x - f y‖ ^ 2 / ‖x - y‖
        - ‖g x - g y‖ ^ 2 / ‖x - y‖) (Set.Ioo (-a) a) volume :=
      (hintQf x hx).sub (hintQg x hx)
    have hintDA : IntegrableOn (fun y : ℝ =>
        |‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖|)
        (Set.Ioo (-a) a) volume := hintDG.abs
    have hintA : IntegrableOn (fun _ : ℝ => (Lf + Lg) * ‖f x - g x‖)
        (Set.Ioo (-a) a) volume := by
      have hc : Continuous (fun _ : ℝ => (Lf + Lg) * ‖f x - g x‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hintB : IntegrableOn (fun y : ℝ => (Lf + Lg) * ‖f y - g y‖)
        (Set.Ioo (-a) a) volume := hintH.const_mul (Lf + Lg)
    have hintMaj : IntegrableOn (fun y : ℝ =>
        (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖)) (Set.Ioo (-a) a) volume := by
      have hsplit : (fun y : ℝ => (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖))
          = fun y : ℝ => (Lf + Lg) * ‖f x - g x‖
            + (Lf + Lg) * ‖f y - g y‖ := by
        funext y
        ring
      rw [hsplit]
      exact hintA.add hintB
    have hmonoY : ∫ y in Set.Ioo (-a) a,
        |‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖| ≤
        ∫ y in Set.Ioo (-a) a,
            (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖) :=
      setIntegral_mono_ae_restrict (f := fun y : ℝ =>
          |‖f x - f y‖ ^ 2 / ‖x - y‖ - ‖g x - g y‖ ^ 2 / ‖x - y‖|)
        (g := fun y : ℝ => (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖))
        (hf := hintDA) (hg := hintMaj)
        (by filter_upwards [] with y; exact hpt x y)
    refine le_trans hmonoY ?_
    have hfoldY : ∫ y in Set.Ioo (-a) a,
        (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖)
        = (Lf + Lg) * ((2 * a) * ‖f x - g x‖
            + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖) := by
      have hB : ∫ y in Set.Ioo (-a) a, (Lf + Lg) * ‖f y - g y‖
          = (Lf + Lg) * (∫ y in Set.Ioo (-a) a, ‖f y - g y‖) :=
        integral_const_mul _ _
      have hsplit : (fun y : ℝ => (Lf + Lg) * (‖f x - g x‖ + ‖f y - g y‖))
          = fun y : ℝ => (Lf + Lg) * ‖f x - g x‖
            + (Lf + Lg) * ‖f y - g y‖ := by
        funext y
        ring
      rw [hsplit, integral_add hintA hintB, hB]
      rw [integral_const (c := (Lf + Lg) * ‖f x - g x‖)
        (μ := volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
      ring
    exact le_of_eq hfoldY
  have hintFG : IntegrableOn (fun x : ℝ =>
      (∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
        - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume))
      (Set.Ioo (-a) a) volume := hintF.sub hintG
  have hintFGA : IntegrableOn (fun x : ℝ =>
      |(∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
        - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume)|)
      (Set.Ioo (-a) a) volume := hintFG.abs
  have hint1 : IntegrableOn (fun x : ℝ =>
      (Lf + Lg) * ((2 * a) * ‖f x - g x‖)) (Set.Ioo (-a) a) volume := by
    have hc : Continuous (fun x : ℝ =>
        (Lf + Lg) * ((2 * a) * ‖f x - g x‖)) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hint2 : IntegrableOn (fun _ : ℝ =>
      (Lf + Lg) * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume)
      (Set.Ioo (-a) a) volume := by
    have hc : Continuous (fun _ : ℝ =>
        (Lf + Lg) * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintMajX : IntegrableOn (fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖
      + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume))
      (Set.Ioo (-a) a) volume := by
    have hsplit : (fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖
        + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume))
        = fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖)
          + (Lf + Lg) * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume := by
      funext x
      ring
    rw [hsplit]
    exact hint1.add hint2
  have hfoldX : ∫ x in Set.Ioo (-a) a, (Lf + Lg) * ((2 * a) * ‖f x - g x‖
      + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume)
      = (Lf + Lg) * (4 * a) * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖) := by
    have hsplit : (fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖
        + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume))
        = fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖)
          + (Lf + Lg) * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume := by
      funext x
      ring
    have hA1 : ∫ x in Set.Ioo (-a) a, (2 * a) * ‖f x - g x‖
        = (2 * a) * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖) := integral_const_mul _ _
    have hA2 : ∫ x in Set.Ioo (-a) a, (Lf + Lg) * ((2 * a) * ‖f x - g x‖)
        = (Lf + Lg) * (∫ x in Set.Ioo (-a) a, (2 * a) * ‖f x - g x‖) :=
      integral_const_mul _ _
    rw [hsplit, integral_add hint1 hint2, hA2, hA1]
    rw [integral_const (c := (Lf + Lg) * ∫ y in Set.Ioo (-a) a,
        ‖f y - g y‖ ∂volume)
      (μ := volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
    ring
  have hsub : RHLean.archForm a f - RHLean.archForm a g
      = (1 / 4) * ∫ x in Set.Ioo (-a) a,
          ((∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
            - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume)) := by
    unfold RHLean.archForm
    have hring : ((1:ℝ)/4) * (∫ x in Set.Ioo (-a) a, (∫ y in Set.Ioo (-a) a,
            ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume) ∂volume)
          - (1:ℝ)/4 * (∫ x in Set.Ioo (-a) a, (∫ y in Set.Ioo (-a) a,
            ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume) ∂volume)
          = (1:ℝ)/4 * ((∫ x in Set.Ioo (-a) a, (∫ y in Set.Ioo (-a) a,
            ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume) ∂volume)
            - (∫ x in Set.Ioo (-a) a, (∫ y in Set.Ioo (-a) a,
            ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume) ∂volume)) := by ring
    rw [hring, ← integral_sub hintF hintG]
  calc |RHLean.archForm a f - RHLean.archForm a g|
      = (1 / 4) * |∫ x in Set.Ioo (-a) a,
          ((∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
            - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume))| := by
        rw [hsub, abs_mul, abs_of_pos h14pos]
    _ ≤ (1 / 4) * ∫ x in Set.Ioo (-a) a,
          |(∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
            - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume)| := by
        refine mul_le_mul_of_nonneg_left ?_ (le_of_lt h14pos)
        have h := norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-a) a))
          (fun x : ℝ => (∫ y in Set.Ioo (-a) a,
              ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
            - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume))
        rw [Real.norm_eq_abs] at h
        exact h
    _ ≤ (1 / 4) * ∫ x in Set.Ioo (-a) a, (Lf + Lg) * ((2 * a) * ‖f x - g x‖
        + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume) := by
        refine mul_le_mul_of_nonneg_left ?_ (le_of_lt h14pos)
        exact setIntegral_mono_ae_restrict (f := fun x : ℝ =>
            |(∫ y in Set.Ioo (-a) a, ‖f x - f y‖ ^ 2 / ‖x - y‖ ∂volume)
            - (∫ y in Set.Ioo (-a) a, ‖g x - g y‖ ^ 2 / ‖x - y‖ ∂volume)|)
          (g := fun x : ℝ => (Lf + Lg) * ((2 * a) * ‖f x - g x‖
            + ∫ y in Set.Ioo (-a) a, ‖f y - g y‖ ∂volume))
          (hf := hintFGA) (hg := hintMajX)
          (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx; exact hinner x hx)
    _ = (Lf + Lg) * a * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖) := by
        rw [hfoldX]
        ring
    _ ≤ (Lf + Lg) * a * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) := by
        refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg hC0 ha2)
        exact l1_le_sqrt_measure_l2 a (fun x => f x - g x) ha2 hHcont
    _ = (Lf + Lg) * a * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by ring
end Y7GateIIAdd
namespace Y7GateIIAdd
theorem localizedForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (Bf Bg Lf Lg S M : ℝ)
    (ha : 0 < a) (hf : Continuous f) (hg : Continuous g)
    (hbf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hbg : ∀ x : ℝ, ‖g x‖ ≤ Bg)
    (hLf : ∀ x y : ℝ, ‖f x - f y‖ ≤ Lf * ‖x - y‖)
    (hLg : ∀ x y : ℝ, ‖g x - g y‖ ≤ Lg * ‖x - y‖)
    (hM : ∀ z : ℝ, 0 ≤ z → |RHLean.gammaKernel z| ≤ M)
    (hSf : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2) ≤ S)
    (hSg : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) ≤ S) :
    |RHLean.localizedForm a f - RHLean.localizedForm a g|
      ≤ ((Lf + Lg) * a * Real.sqrt (2 * a)
        + |RHLean.physicalConstant| * (2 * S)
        + (Bf + Bg) * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
        + 2 * M * a * Real.sqrt (2 * a) * (Bf + Bg)
        + 2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)) ^ 2 * (2 * S)
        + (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
            * (2 * Real.sqrt (2 * a) * (Bf + Bg)))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
  have ha2 : 0 ≤ a := ha.le
  have harch := archForm_L2_bound a f g Lf Lg ha hf hg hLf hLg
  have hmass := massIntegral_L2_bound a f g S ha hf hg hSf hSg
  have hpot := potentialForm_L2_bound a f g Bf Bg ha hf hg hbf hbg
  have hgam := gammaForm_L2_bound a f g M Bf Bg ha hM hbf hbg hf hg
  have hpol := polarForm_L2_bound a f g Bf Bg ha hf hg hbf hbg
  have hshi := shiftForm_L2_bound a f g Bf Bg ha hf hg hbf hbg
  have hLf0 : 0 ≤ Lf :=
    le_trans (norm_nonneg (f 0 - f 1)) (by
      have h := hLf 0 1
      rw [show ‖((0:ℝ) - 1)‖ = 1 from by norm_num, mul_one] at h
      exact h)
  have hLg0 : 0 ≤ Lg :=
    le_trans (norm_nonneg (g 0 - g 1)) (by
      have h := hLg 0 1
      rw [show ‖((0:ℝ) - 1)‖ = 1 from by norm_num, mul_one] at h
      exact h)
  have hL0 : 0 ≤ (Lf + Lg) * a * Real.sqrt (2 * a) :=
    mul_nonneg (mul_nonneg (by linarith) ha2) (Real.sqrt_nonneg _)
  have hS0 : 0 ≤ S := le_trans (Real.sqrt_nonneg _) hSf
  have hB0 : 0 ≤ Bf + Bg := by
    have h1 : 0 ≤ Bf := le_trans (norm_nonneg _) (hbf 0)
    have h2 : 0 ≤ Bg := le_trans (norm_nonneg _) (hbg 0)
    linarith
  have hM0 : 0 ≤ M := le_trans (abs_nonneg _) (hM 0 (by norm_num))
  have hFat : IntegrableOn (fun x : ℝ => ‖f x - g x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) volume := by
    have hc : Continuous (fun x : ℝ => ‖f x - g x‖ ^ 2) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
  have hLF : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)
      ≤ Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
    refine Real.sqrt_le_sqrt ?_
    exact setIntegral_mono_set hFat
      (MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖f x - g x‖)))
      (MeasureTheory.ae_of_all _ (fun x hx => (Set.Subset.trans Set.Ioo_subset_Ioc_self
        (Set.Ioc_subset_Ioc (by linarith : -(3 * a) ≤ -a)
          (by linarith : a ≤ 3 * a))) hx))
  have habs6 : ∀ x1 x2 x3 x4 x5 x6 : ℝ,
      |x1 + x2 + x3 + x4 + x5 + x6|
        ≤ |x1| + |x2| + |x3| + |x4| + |x5| + |x6| := by
    intro x1 x2 x3 x4 x5 x6
    calc |x1 + x2 + x3 + x4 + x5 + x6|
        ≤ |x1 + x2 + x3 + x4 + x5| + |x6| := abs_add_le _ _
      _ ≤ (|x1 + x2 + x3 + x4| + |x5|) + |x6| :=
          add_le_add (abs_add_le _ _) (le_refl _)
      _ ≤ ((|x1 + x2 + x3| + |x4|) + |x5|) + |x6| :=
          add_le_add (add_le_add (abs_add_le _ _) (le_refl _)) (le_refl _)
      _ ≤ (((|x1 + x2| + |x3|) + |x4|) + |x5|) + |x6| :=
          add_le_add (add_le_add (add_le_add (abs_add_le _ _) (le_refl _))
            (le_refl _)) (le_refl _)
      _ ≤ ((((|x1| + |x2|) + |x3|) + |x4|) + |x5|) + |x6| :=
          add_le_add (add_le_add (add_le_add (add_le_add (abs_add_le _ _)
            (le_refl _)) (le_refl _)) (le_refl _)) (le_refl _)
      _ = |x1| + |x2| + |x3| + |x4| + |x5| + |x6| := by ring
  rw [show RHLean.localizedForm a f - RHLean.localizedForm a g
      = (RHLean.archForm a f - RHLean.archForm a g)
        + RHLean.physicalConstant * ((∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 ∂volume)
          - (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2 ∂volume))
        + (RHLean.potentialForm a f - RHLean.potentialForm a g)
        + (RHLean.gammaForm a g - RHLean.gammaForm a f)
        + (RHLean.polarForm a g - RHLean.polarForm a f)
        + (RHLean.shiftForm a g - RHLean.shiftForm a f) from by
      unfold RHLean.localizedForm
      ring]
  refine le_trans (habs6 _ _ _ _ _ _) ?_
  have hp1 : |RHLean.archForm a f - RHLean.archForm a g|
      ≤ ((Lf + Lg) * a * Real.sqrt (2 * a))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) :=
    harch.trans (mul_le_mul_of_nonneg_left hLF hL0)
  have hp2 : |RHLean.physicalConstant * ((∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 ∂volume)
        - (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2 ∂volume))|
      ≤ (|RHLean.physicalConstant| * (2 * S))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
    rw [abs_mul]
    have hinner := hmass.trans
      (mul_le_mul_of_nonneg_left hLF (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hS0))
    calc |RHLean.physicalConstant|
        * |(∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 ∂volume)
          - (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2 ∂volume)|
        ≤ |RHLean.physicalConstant|
          * ((2 * S) * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)) :=
            mul_le_mul_of_nonneg_left hinner (abs_nonneg _)
      _ = (|RHLean.physicalConstant| * (2 * S))
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by ring
  have hp3 : |RHLean.potentialForm a f - RHLean.potentialForm a g|
      ≤ ((Bf + Bg) * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) :=
    hpot.trans (mul_le_mul_of_nonneg_left hLF (mul_nonneg hB0 (Real.sqrt_nonneg _)))
  have hp4 : |RHLean.gammaForm a g - RHLean.gammaForm a f|
      ≤ (2 * M * a * Real.sqrt (2 * a) * (Bf + Bg))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
    rw [abs_sub_comm]
    exact hgam.trans (mul_le_mul_of_nonneg_left hLF
      (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hM0)
        ha2) (Real.sqrt_nonneg _)) hB0))
  have hp5 : |RHLean.polarForm a g - RHLean.polarForm a f|
      ≤ (2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)) ^ 2 * (2 * S))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
    rw [abs_sub_comm]
    refine le_trans hpol ?_
    have hAB : (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
        + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)) ≤ 2 * S := by linarith
    calc 2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))
        * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
          * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
            + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)))
        = (2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)) ^ 2
            * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
              + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)))
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by ring
      _ ≤ (2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)) ^ 2 * (2 * S))
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hAB (by positivity)) (by positivity)
      _ ≤ (2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)) ^ 2 * (2 * S))
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) :=
          mul_le_mul_of_nonneg_left hLF (by positivity)
  have hp6 : |RHLean.shiftForm a g - RHLean.shiftForm a f|
      ≤ ((∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
          * (2 * Real.sqrt (2 * a) * (Bf + Bg)))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
    rw [abs_sub_comm]
    exact hshi
  exact le_trans (add_le_add (add_le_add (add_le_add (add_le_add
    (add_le_add hp1 hp2) hp3) hp4) hp5) hp6) (le_of_eq (by ring))
end Y7GateIIAdd
