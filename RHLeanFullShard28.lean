section Inline_A1_LineBound
noncomputable section
open Complex Filter Topology Set MeasureTheory
open scoped Real Topology BigOperators
namespace RHLean.ExplicitFormula
theorem riemannXi_ne_zero_of_one_le_re_all {s : ℂ} (hs : 1 ≤ s.re) :
    riemannXi s ≠ 0 := by
  rcases eq_or_ne s 1 with rfl | h1
  · simpa using riemannXi_one_ne_zero
  · exact riemannXi_ne_zero_of_one_le_re hs h1
theorem norm_m3eRegularPart_le {s : ℂ} (h1 : 1 ≤ s.re) (h2 : s.re ≤ 2) :
    ‖m3eRegularPart s‖
      ≤ (8 * (∑' m : ℕ, 1 / ((m : ℝ) + 1) ^ 2)
          + |Real.eulerMascheroniConstant| + Real.log Real.pi + 2)
        * (1 + |s.im|) := by
  set S : ℝ := ∑' m : ℕ, 1 / ((m : ℝ) + 1) ^ 2 with hS
  have hS0 : 0 ≤ S := by rw [hS]; exact tsum_nonneg fun m => by positivity
  have hzre : (1 / 4 : ℝ) ≤ (s / 2).re := by
    rw [show (s / 2).re = s.re / 2 by simp]
    linarith
  have hzne : ∀ n : ℕ, s / 2 ≠ -(n : ℂ) := by
    intro n h
    have hr := congrArg Complex.re h
    rw [show (s / 2).re = s.re / 2 by simp] at hr
    simp at hr
    have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    linarith
  have hdig := norm_digamma_add_gamma_le hzne hzre
  have hpsi : ‖Complex.digamma (s / 2)‖
      ≤ 4 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant| := by
    calc ‖Complex.digamma (s / 2)‖
        = ‖(Complex.digamma (s / 2) + (Real.eulerMascheroniConstant : ℂ))
            - (Real.eulerMascheroniConstant : ℂ)‖ := by rw [add_sub_cancel_right]
      _ ≤ ‖Complex.digamma (s / 2) + (Real.eulerMascheroniConstant : ℂ)‖
            + ‖(Real.eulerMascheroniConstant : ℂ)‖ := norm_sub_le _ _
      _ = ‖Complex.digamma (s / 2) + (Real.eulerMascheroniConstant : ℂ)‖
            + |Real.eulerMascheroniConstant| := by rw [norm_ofReal_complex]
      _ ≤ 4 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant| := by
          simpa [hS] using add_le_add_right hdig (|Real.eulerMascheroniConstant|)
  have hnorm_s : ‖s‖ ≤ 2 + |s.im| := by
    calc ‖s‖ ≤ |s.re| + |s.im| := Complex.norm_le_abs_re_add_abs_im s
      _ ≤ 2 + |s.im| := by
          rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ s.re)]
          linarith
  have hnorm_half : ‖s / 2‖ + 1 ≤ 2 * (1 + |s.im|) := by
    have h2' : ‖s / 2‖ = ‖s‖ / 2 := by simp [norm_div]
    rw [h2']
    nlinarith [abs_nonneg s.im, norm_nonneg s]
  have h1s : ‖(1 : ℂ) / s‖ ≤ 1 := by
    rw [norm_div, norm_one, one_div]
    refine inv_le_one_of_one_le₀ ?_
    have hre0 : (0 : ℝ) ≤ s.re := by linarith
    calc (1 : ℝ) ≤ s.re := h1
      _ = |s.re| := (abs_of_nonneg hre0).symm
      _ ≤ ‖s‖ := Complex.abs_re_le_norm s
  have hlogpi : ‖(1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖
      ≤ Real.log Real.pi + 1 := by
    rw [norm_mul]
    have hhalf : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
    rw [hhalf]
    have hlog : ‖Complex.log ((Real.pi : ℝ) : ℂ)‖ = Real.log Real.pi := by
      rw [← Complex.ofReal_log (by positivity : (0 : ℝ) ≤ Real.pi), norm_ofReal_complex,
        abs_of_nonneg (Real.log_nonneg (by linarith [Real.pi_gt_three]))]
    rw [hlog]
    have h0 : 0 ≤ Real.log Real.pi := Real.log_nonneg (by linarith [Real.pi_gt_three])
    nlinarith
  have hdig2 : ‖(1 / 2 : ℂ) * Complex.digamma (s / 2)‖
      ≤ (8 * S + |Real.eulerMascheroniConstant|) * (1 + |s.im|) := by
    rw [norm_mul]
    have hhalf : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
    rw [hhalf]
    have h2 : (1 / 2) * ‖Complex.digamma (s / 2)‖
        ≤ (1 / 2) * (4 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant|) := by
      linarith
    have h3 : (1 / 2) * (4 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant|)
        ≤ (8 * S + |Real.eulerMascheroniConstant|) * (1 + |s.im|) := by
      have h1i : (1 : ℝ) ≤ 1 + |s.im| := le_add_of_nonneg_right (abs_nonneg s.im)
      calc (1 / 2) * (4 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant|)
          = 2 * (‖s / 2‖ + 1) * S + |Real.eulerMascheroniConstant| / 2 := by ring
        _ ≤ 2 * (2 * (1 + |s.im|)) * S + |Real.eulerMascheroniConstant| / 2 := by
            nlinarith [hS0, hnorm_half, abs_nonneg Real.eulerMascheroniConstant]
        _ ≤ 8 * (1 + |s.im|) * S
              + |Real.eulerMascheroniConstant| * (1 + |s.im|) := by
            nlinarith [h1i, abs_nonneg Real.eulerMascheroniConstant, hS0]
        _ = (8 * S + |Real.eulerMascheroniConstant|) * (1 + |s.im|) := by ring
    linarith
  calc ‖m3eRegularPart s‖
      = ‖(1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2)
          - (1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖ := by
        simp [m3eRegularPart]
    _ ≤ ‖(1 : ℂ) / s‖ + ‖(1 / 2 : ℂ) * Complex.digamma (s / 2)‖
          + ‖(1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖ := by
        have h := norm_add_le ((1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2))
          (-((1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)))
        have h1 : ‖(1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2)
            - (1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖
            ≤ ‖(1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2)‖
              + ‖(1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖ := by
          simpa [sub_eq_add_neg] using h
        have h2 : ‖(1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2)‖
            ≤ ‖(1 : ℂ) / s‖ + ‖(1 / 2 : ℂ) * Complex.digamma (s / 2)‖ :=
          norm_add_le _ _
        calc ‖(1 : ℂ) / s + (1 / 2 : ℂ) * Complex.digamma (s / 2)
              - (1 / 2 : ℂ) * Complex.log ((Real.pi : ℝ) : ℂ)‖
