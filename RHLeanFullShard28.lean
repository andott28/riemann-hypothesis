open scoped InnerProductSpace
theorem master_posDef_of_components_symm {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (e : E) (he : e ≠ 0) (g : ℝ) (hg : 0 < g)
    (hground : g * ‖e‖ ^ 2 ≤ ⟪e, T e⟫_ℝ)
    (hplace : ∀ f : E, 0 ≤ groundCoord e f * ⟪e, T (transversePart e f)⟫_ℝ)
    (hres : ∀ w : E, ⟪e, w⟫_ℝ = 0 → w ≠ 0 → 0 < ⟪w, T w⟫_ℝ) :
    ∀ f : E, f ≠ 0 → 0 < ⟪f, T f⟫_ℝ := by
  intro f hf
  set w := transversePart e f with hwdef
  set γ := groundCoord e f with hγdef
  have hw : ⟪e, w⟫_ℝ = 0 := inner_transversePart e f he
  have hfd : f = γ • e + w := by
    simp only [hwdef, hγdef, transversePart]
    abel
  have hww : 0 ≤ ⟪w, T w⟫_ℝ := by
    by_cases hw0 : w = 0
    · simp [hw0]
    · exact (hres w hw hw0).le
  have hcross : 0 ≤ 2 * γ * ⟪e, T w⟫_ℝ := by
    have := hplace f
    by_cases hγ : 0 ≤ γ
    · nlinarith
    · have hγ' : γ ≤ 0 := le_of_not_ge hγ
      nlinarith
  have hdecomp : ⟪γ • e + w, T (γ • e + w)⟫_ℝ
      = γ ^ 2 * ⟪e, T e⟫_ℝ + 2 * γ * ⟪e, T w⟫_ℝ + ⟪w, T w⟫_ℝ := by
    simp only [map_add, map_smul, inner_add_left, inner_add_right,
      real_inner_smul_left, real_inner_smul_right]
    rw [real_inner_comm (T e) w, hT e w]
    ring
  rw [hfd, hdecomp]
  have hgnd : γ ^ 2 * (g * ‖e‖ ^ 2) ≤ γ ^ 2 * ⟪e, T e⟫_ℝ :=
    mul_le_mul_of_nonneg_left hground (sq_nonneg γ)
  rcases eq_or_ne γ 0 with hγ0 | hγne
  · rw [hγ0] at hcross hgnd ⊢
    have hwne : w ≠ 0 := by
      intro hw0
      apply hf
      rw [hfd, hγ0, hw0]
      simp
    linarith [hres w hw hwne]
  · have hγ2 : 0 < γ ^ 2 := sq_pos_of_ne_zero hγne
    have hnorm : 0 < ‖e‖ ^ 2 := pow_pos (norm_pos_iff.mpr he) 2
    have hgroundpos : 0 < γ ^ 2 * (g * ‖e‖ ^ 2) := by positivity
    linarith
end RHLean.GateII.Harmonic
