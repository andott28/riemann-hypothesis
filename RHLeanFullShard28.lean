theorem admissible_potential_field (a : ℝ) (h g : ℝ → ℂ) (B : ℝ)
    (ha : 0 < a) (ch : Continuous h) (cg : Continuous g)
    (bh : ∀ x ∈ Set.Ioo (-a) a, ‖h x‖ ≤ B)
    (bg : ∀ x ∈ Set.Ioo (-a) a, ‖g x‖ ≤ B) :
    IntegrableOn (fun x : ℝ =>
        RHLean.endpointPotential a x * (h x * star (g x)).re)
      (Set.Ioo (-a) a) volume := by
  have hR : ∀ x ∈ Set.Ioo (-a) a, |(h x * star (g x)).re| ≤ B * B := fun x hx => by
    calc |(h x * star (g x)).re| ≤ ‖h x * star (g x)‖ := Complex.abs_re_le_norm _
      _ = ‖h x‖ * ‖g x‖ := by rw [norm_mul, norm_star]
      _ ≤ B * B := by
        nlinarith [bh x hx, bg x hx, norm_nonneg (h x), norm_nonneg (g x)]
  have hint1 : IntegrableOn (fun x : ℝ => Real.log (a - x)) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le
      (by linarith : -a ≤ a)).mp RHLean.ExplicitFormula.intervalIntegrable_log_sub).mono_set
      Set.Ioo_subset_Ioc_self
  have hint2 : IntegrableOn (fun x : ℝ => Real.log (a + x)) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le
      (by linarith : -a ≤ a)).mp RHLean.ExplicitFormula.intervalIntegrable_log_add).mono_set
      Set.Ioo_subset_Ioc_self
  have hmaj1 : IntegrableOn (fun x : ℝ => (B * B) * |Real.log (a - x)|)
      (Set.Ioo (-a) a) volume := hint1.abs.const_mul (B * B)
  have hmaj2 : IntegrableOn (fun x : ℝ => (B * B) * |Real.log (a + x)|)
      (Set.Ioo (-a) a) volume := hint2.abs.const_mul (B * B)
  have hp1 : IntegrableOn (fun x : ℝ => Real.log (a - x) * (h x * star (g x)).re)
      (Set.Ioo (-a) a) volume := by
    refine hmaj1.mono' ?_ ?_
    · have hlogm : Measurable (fun x : ℝ => Real.log (a - x)) :=
        ((continuous_const : Continuous fun _ : ℝ => a).sub continuous_id).measurable.log
      have hRm : Measurable (fun x : ℝ => (h x * star (g x)).re) := by fun_prop
      exact (hlogm.mul hRm).aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
