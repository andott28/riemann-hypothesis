theorem massIntegral_L2_bound (a : ℝ) (f g : ℝ → ℂ) (S : ℝ) (ha : 0 < a)
    (hf : Continuous f) (hg : Continuous g)
    (hF : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2) ≤ S)
    (hG : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) ≤ S) :
    |(∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2) - (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)|
      ≤ 2 * S * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by
  have hsum : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
      + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) ≤ 2 * S := by linarith
  have hC0 : 0 ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) :=
    Real.sqrt_nonneg _
  have hpt : ∀ x : ℝ, |‖f x‖ ^ 2 - ‖g x‖ ^ 2|
      ≤ ‖f x - g x‖ * (‖f x‖ + ‖g x‖) := by
    intro x
    rw [sq_sub_sq, abs_mul,
      abs_of_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _)), mul_comm]
    exact mul_le_mul (abs_norm_sub_norm_le _ _) (le_refl _)
      (add_nonneg (norm_nonneg _) (norm_nonneg _)) (norm_nonneg _)
  have hcF : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := by fun_prop
  have hcG : Continuous (fun x : ℝ => ‖g x‖ ^ 2) := by fun_prop
  have hcA : Continuous (fun x : ℝ => |‖f x‖ ^ 2 - ‖g x‖ ^ 2|) := by fun_prop
  have hc1 : Continuous (fun x : ℝ => ‖f x - g x‖ * ‖f x‖) := by fun_prop
  have hc2 : Continuous (fun x : ℝ => ‖f x - g x‖ * ‖g x‖) := by fun_prop
  have hcK : Continuous (fun x : ℝ =>
      ‖f x - g x‖ * (‖f x‖ + ‖g x‖)) := by fun_prop
  have hintF : IntegrableOn (fun x => ‖f x‖ ^ 2) (Set.Ioo (-a) a) volume :=
    hcF.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintG : IntegrableOn (fun x => ‖g x‖ ^ 2) (Set.Ioo (-a) a) volume :=
    hcG.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintAbs : IntegrableOn (fun x => |‖f x‖ ^ 2 - ‖g x‖ ^ 2|)
      (Set.Ioo (-a) a) volume := hcA.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hint1 : IntegrableOn (fun x => ‖f x - g x‖ * ‖f x‖)
      (Set.Ioo (-a) a) volume := hc1.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hint2 : IntegrableOn (fun x => ‖f x - g x‖ * ‖g x‖)
      (Set.Ioo (-a) a) volume := hc2.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintK : IntegrableOn (fun x => ‖f x - g x‖ * (‖f x‖ + ‖g x‖))
      (Set.Ioo (-a) a) volume := hcK.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hsub : (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
      - (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)
      = ∫ x in Set.Ioo (-a) a, (‖f x‖ ^ 2 - ‖g x‖ ^ 2) :=
    (integral_sub hintF hintG).symm
  rw [hsub]
  have habs : |∫ x in Set.Ioo (-a) a, (‖f x‖ ^ 2 - ‖g x‖ ^ 2)|
      ≤ ∫ x in Set.Ioo (-a) a, |‖f x‖ ^ 2 - ‖g x‖ ^ 2| := by
    have h := norm_integral_le_integral_norm
      (μ := volume.restrict (Set.Ioo (-a) a))
      (fun x => ‖f x‖ ^ 2 - ‖g x‖ ^ 2)
    simpa only [Real.norm_eq_abs] using h
  refine le_trans habs ?_
  have hmono : ∫ x in Set.Ioo (-a) a, |‖f x‖ ^ 2 - ‖g x‖ ^ 2|
      ≤ ∫ x in Set.Ioo (-a) a, ‖f x - g x‖ * (‖f x‖ + ‖g x‖) :=
    setIntegral_mono_ae (f := fun x => |‖f x‖ ^ 2 - ‖g x‖ ^ 2|)
      (g := fun x => ‖f x - g x‖ * (‖f x‖ + ‖g x‖))
      (hf := hintAbs) (hg := hintK) (by filter_upwards [] with x; exact hpt x)
  refine le_trans hmono ?_
  have hsplit : (fun x : ℝ => ‖f x - g x‖ * (‖f x‖ + ‖g x‖))
      = fun x => ‖f x - g x‖ * ‖f x‖ + ‖f x - g x‖ * ‖g x‖ := by
    funext x; ring
  rw [hsplit, integral_add hint1 hint2]
  have hm1 : MemLp (fun x => f x - g x) 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen (hf.sub hg) _ Set.Ioo_subset_Icc_self
  have hm2 : MemLp f 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hf _ Set.Ioo_subset_Icc_self
  have hm3 : MemLp g 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hg _ Set.Ioo_subset_Icc_self
  have hcs1 : ∫ x in Set.Ioo (-a) a, ‖(fun y => f y - g y) x‖ * ‖f x‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖(fun y => f y - g y) x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2) :=
    l2_integral_mul_le_gen (Set.Ioo (-a) a) hm1 hm2
  have hcs2 : ∫ x in Set.Ioo (-a) a, ‖(fun y => f y - g y) x‖ * ‖g x‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖(fun y => f y - g y) x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) :=
    l2_integral_mul_le_gen (Set.Ioo (-a) a) hm1 hm3
  simp only at hcs1 hcs2
  nlinarith [hcs1, hcs2, hsum, hC0]
end Y7GateIIAdd
namespace Y7GateIIAdd
theorem l1_le_sqrt_measure_l2 (a : ℝ) (h : ℝ → ℂ) (ha : 0 ≤ a)
    (hh : Continuous h) :
    ∫ x in Set.Ioo (-a) a, ‖h x‖
      ≤ Real.sqrt (2 * a) * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2) := by
  have hcont1 : Continuous (fun _ : ℝ => (1:ℂ)) := continuous_const
  have hm1 : MemLp (fun _ => (1:ℂ)) 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hcont1 _ Set.Ioo_subset_Icc_self
  have hmh : MemLp h 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hh _ Set.Ioo_subset_Icc_self
  have hcs : ∫ x in Set.Ioo (-a) a, ‖h x‖ * ‖(fun _ => (1:ℂ)) x‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖(fun _ => (1:ℂ)) x‖ ^ 2) :=
    l2_integral_mul_le_gen _ hmh hm1
  simp only [norm_one, mul_one] at hcs
  have hvol : (volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hone : ∫ x in Set.Ioo (-a) a, 1 ^ 2 = 2 * a := by
    rw [pow_two, one_mul]
    have hi := integral_const (μ := volume.restrict (Set.Ioo (-a) a)) (c := (1:ℝ))
    rw [hi, smul_eq_mul, mul_one]
    show ENNReal.toReal ((volume.restrict (Set.Ioo (-a) a)) Set.univ) = 2 * a
    rw [Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  rw [hone] at hcs
  rwa [mul_comm] at hcs
end Y7GateIIAdd
