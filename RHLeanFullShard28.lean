      < 1 / ((n : ℝ) + 1) := by
    intro n
    exact hN n (T n) (by dsimp [T]; exact le_max_left _ _)
  have hfinite : Tendsto (fun n : ℕ =>
      (∑ q ∈ arithSupport a, primeSideTerm f (ε n) q))
