theorem exists_lipschitz_localizedCore {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x y : ℝ, ‖f x - f y‖ ≤ C * |x - y| := by
  have hsupp : HasCompactSupport (deriv f) := hf.1.2.1.deriv
  obtain ⟨K, hK⟩ := hsupp.isCompact.exists_bound_of_continuousOn
    (hf.1.1.continuous_deriv (by norm_num)).continuousOn
  have hderiv : ∀ t : ℝ, HasDerivAt f (deriv f t) t :=
    fun t => (hf.1.1.differentiable (by simp) t).hasDerivAt
  have hbound : ∀ t : ℝ, ‖deriv f t‖ ≤ max K 0 := fun t => by
    by_cases hx : t ∈ tsupport (deriv f)
    · exact le_trans (hK t hx) (le_max_left _ _)
    · have hz : deriv f t = 0 := by
        by_contra h
        exact hx (subset_tsupport (deriv f) (Function.mem_support.mpr h))
      rw [hz]
      simp
  refine ⟨max K 0, le_max_right _ _, fun x y => ?_⟩
  rcases le_total x y with hxy | hyx
  · have h := norm_image_sub_le_of_norm_deriv_le_segment' (a := x) (b := y)
      (f := f) (f' := deriv f) (C := max K 0)
      (fun t _ => (hderiv t).hasDerivWithinAt)
      (fun t _ => hbound t)
    have h2 := h y ⟨hxy, le_rfl⟩
    rw [norm_sub_rev] at h2
    have h3 : |x - y| = y - x := by
      rw [abs_of_nonpos (sub_nonpos.mpr hxy)]
      ring
    rw [h3]
    exact h2
  · have h := norm_image_sub_le_of_norm_deriv_le_segment' (a := y) (b := x)
      (f := f) (f' := deriv f) (C := max K 0)
      (fun t _ => (hderiv t).hasDerivWithinAt)
      (fun t _ => hbound t)
    have h2 := h x ⟨hyx, le_rfl⟩
    rw [abs_of_nonneg (sub_nonneg.mpr hyx)]
    exact h2
theorem core_re_lipschitz {a b : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore b) :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ x y : ℝ,
      ‖((f x).re : ℂ) - ((f y).re : ℂ)‖ ≤ L * |x - y| := by
  obtain ⟨C, hC0, hC⟩ := exists_lipschitz_localizedCore hf
  refine ⟨C, hC0, fun x y => ?_⟩
  have hre : ((f x).re : ℂ) - ((f y).re : ℂ) = (((f x).re - (f y).re : ℝ) : ℂ) := by
    rw [← Complex.ofReal_sub]
  rw [hre]
  have hn : ‖((((f x).re - (f y).re : ℝ)) : ℂ)‖ = |(f x).re - (f y).re| :=
    RCLike.norm_ofReal _
  rw [hn, ← Complex.sub_re]
  calc |(f x - f y).re| ≤ ‖f x - f y‖ := Complex.abs_re_le_norm _
    _ ≤ C * |x - y| := hC x y
theorem core_im_lipschitz {a b : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore b) :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ x y : ℝ,
      ‖((f x).im : ℂ) - ((f y).im : ℂ)‖ ≤ L * |x - y| := by
  obtain ⟨C, hC0, hC⟩ := exists_lipschitz_localizedCore hf
  refine ⟨C, hC0, fun x y => ?_⟩
  have him : ((f x).im : ℂ) - ((f y).im : ℂ) = (((f x).im - (f y).im : ℝ) : ℂ) := by
    rw [← Complex.ofReal_sub]
  rw [him]
  have hn : ‖((((f x).im - (f y).im : ℝ)) : ℂ)‖ = |(f x).im - (f y).im| :=
    RCLike.norm_ofReal _
  rw [hn, ← Complex.sub_im]
  calc |(f x - f y).im| ≤ ‖f x - f y‖ := Complex.abs_im_le_norm _
    _ ≤ C * |x - y| := hC x y
theorem core_re_bounded {a b : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore b) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖((f x).re : ℂ)‖ ≤ B := by
  obtain ⟨B, hB0, hB⟩ := RHLean.ExplicitFormula.exists_norm_le_of_localizedCore hf
  refine ⟨B, hB0, fun x => ?_⟩
  have hn : ‖((f x).re : ℂ)‖ = |(f x).re| := RCLike.norm_ofReal _
  rw [hn]
  exact le_trans (Complex.abs_re_le_norm (f x)) (hB x)
theorem core_im_bounded {a b : ℝ} {f : ℝ → ℂ} (hf : f ∈ RHLean.localizedCore b) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖((f x).im : ℂ)‖ ≤ B := by
  obtain ⟨B, hB0, hB⟩ := RHLean.ExplicitFormula.exists_norm_le_of_localizedCore hf
  refine ⟨B, hB0, fun x => ?_⟩
  have hn : ‖((f x).im : ℂ)‖ = |(f x).im| := RCLike.norm_ofReal _
  rw [hn]
  exact le_trans (Complex.abs_im_le_norm (f x)) (hB x)
