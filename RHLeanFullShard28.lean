def QextOldHi (m : ℕ) (i : Fin 7) : ℝ :=
  if m < 200 then QHi ⟨(m - 1) / 2 % 100, Nat.mod_lt _ (by norm_num)⟩ i else 0
noncomputable def coordOldHi (s : Finset ℕ) (x : ℕ → ℝ) : Fin 7 → ℝ :=
  fun i => ∑ m ∈ s, x m * QextOldHi m i
def GramFloorFHi (a : ℝ) : Prop :=
  ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) →
    (coordOldHi s x) ⬝ᵥ (Y7A3GramFloor.F *ᵥ coordOldHi s x)
      ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM a m n
theorem matrixBlocksPos_of_gramFloorFHi {a : ℝ} (h : GramFloorFHi a) :
    Y7Density.MatrixBlocksPos a := by
  intro s x hs
  have hle := h s x hs
  have hnn : 0 ≤ (coordOldHi s x) ⬝ᵥ
      (Y7A3GramFloor.F *ᵥ coordOldHi s x) := by
    simpa only [star_trivial] using
      Y7A3GramFloor.F_posDef.posSemidef.dotProduct_mulVec_nonneg
        (coordOldHi s x)
  exact le_trans hnn hle
def MarginAtCenterHi (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ) : Prop :=
  (coordOldHi s x) ⬝ᵥ (Y7A3GramFloor.F *ᵥ coordOldHi s x)
    + (Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a) *
        (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
    ≤ Y7W5Kernel.modelFormRescaled a (Y7Op.legSum x s)
theorem gramFloorFHi_of_margin_hi {a : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (ha : 2 * a < 14 / 5) (h2a1 : 1 ≤ 2 * a)
    (hrep : Y7Op.FormMatrixRep a)
    (hmargin : ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) → MarginAtCenterHi a s x) :
    GramFloorFHi a := by
  intro s x hs
  have hcont : Continuous (Y7Op.legSum x s) := by
    unfold Y7Op.legSum Y7Matrix.phiC
    fun_prop
  have hbound :=
    Y7W5Kernel.abs_localizedFormRescaled_sub_model_le ha0 ha1 ha h2a1 hcont
  have hmodel_le : Y7W5Kernel.modelFormRescaled a (Y7Op.legSum x s)
      ≤ RHLean.localizedFormRescaled a (Y7Op.legSum x s)
        + (Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a) *
          (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2) := by
    have h := (abs_le.mp hbound).1
    linarith
  have hm := hmargin s x hs
  unfold MarginAtCenterHi at hm
  have hF : (coordOldHi s x) ⬝ᵥ
      (Y7A3GramFloor.F *ᵥ coordOldHi s x)
      ≤ RHLean.localizedFormRescaled a (Y7Op.legSum x s) := by
    linarith
  rw [hrep s x] at hF
  exact hF
theorem gramFloorFHi_endpoint_seven_of_margin_hi
    (hmargin : ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) →
      MarginAtCenterHi (RHLean.endpoint 7) s x) :
    GramFloorFHi (RHLean.endpoint 7) := by
  have h2a : 2 * RHLean.endpoint 7 = Real.log 7 := by
    unfold RHLean.endpoint
    ring
  have hlog_lo : ((121619384315957 / 62500000000000 : ℚ) : ℝ) ≤ Real.log 7 :=
    Y7Chain.log_seven_box.lo_le
  have hlog_hi : Real.log 7 ≤ ((389182029811063 / 200000000000000 : ℚ) : ℝ) :=
    Y7Chain.log_seven_box.le_hi
  have hlo : (1 : ℝ) ≤ 2 * RHLean.endpoint 7 := by
    rw [h2a]
    nlinarith
  have hhi : 2 * RHLean.endpoint 7 < 14 / 5 := by
    rw [h2a]
    nlinarith
  have ha0 : 0 ≤ RHLean.endpoint 7 := by
    unfold RHLean.endpoint
    positivity
  have ha1 : RHLean.endpoint 7 ≤ 1 := by
    nlinarith
  exact gramFloorFHi_of_margin_hi ha0 ha1 hhi hlo
    Y7Density.formMatrixRep_endpoint_seven hmargin
theorem matrixBlocksPos_endpoint_seven_of_margin_hi
    (hmargin : ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) →
      MarginAtCenterHi (RHLean.endpoint 7) s x) :
    Y7Density.MatrixBlocksPos (RHLean.endpoint 7) :=
  matrixBlocksPos_of_gramFloorFHi
    (gramFloorFHi_endpoint_seven_of_margin_hi hmargin)
theorem marginAtCenterHi_tail_endpoint_seven
    (hε : Y7Chain.epsilonGamma (RHLean.endpoint 7)
        + Y7Chain.epsilonPolar (RHLean.endpoint 7) ≤ 1 / 8)
    (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
    (hs' : ∀ m ∈ s, 200 ≤ m) :
    MarginAtCenterHi (RHLean.endpoint 7) s x := by
  have hcoord : coordOldHi s x = 0 := by
