    ∀ n ∈ RHLean.arithSupport a, IntegrableOn
      (fun x : ℝ => g x * star (h (x + RHLean.shiftLength n)))
      (Set.Ioo (-a) a) volume := by
  intro n hn
  apply integrableOn_bound_Ioo_clm a _ (Bg * Bh)
  · fun_prop
  · intro x hx
    calc ‖g x * star (h (x + RHLean.shiftLength n))‖
        = ‖g x‖ * ‖h (x + RHLean.shiftLength n)‖ := by rw [norm_mul, norm_star]
      _ ≤ Bg * Bh := by
        nlinarith [bg x, bh (x + RHLean.shiftLength n), norm_nonneg (g x),
          norm_nonneg (h (x + RHLean.shiftLength n))]
theorem admissible_polar_field (a : ℝ) (h : ℝ → ℂ) (B : ℝ)
    (ha : 0 ≤ a) (ch : Continuous h)
    (bh : ∀ x ∈ Set.Ioo (-a) a, ‖h x‖ ≤ B) :
    IntegrableOn (fun x : ℝ => star (RHLean.sph x) * h x)
      (Set.Ioo (-a) a) volume := by
  set S := Real.sinh (a / 2) with hSdef
  have hS0 : 0 ≤ S := by
    rw [hSdef, ← Real.sinh_zero]
    exact Real.sinh_le_sinh.mpr (by positivity)
  apply integrableOn_bound_Ioo_clm a _ (S * B)
  · have hsph : Continuous (fun x : ℝ => RHLean.sph x) := by
      unfold RHLean.sph
      fun_prop
    exact (continuous_star.comp hsph).mul ch
  · intro x hx
    have hxa : |x| ≤ a := by
      rw [abs_le]
      exact ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hhalf : |x / 2| ≤ a / 2 := by
      rw [abs_div, abs_two]
      exact div_le_div_of_nonneg_right hxa (by norm_num)
    have hn : ‖(Real.sinh (x / 2) : ℂ)‖ = |Real.sinh (x / 2)| :=
      RCLike.norm_ofReal _
    have hs : ‖RHLean.sph x‖ ≤ S := by
      rw [RHLean.sph, hSdef, hn, Real.abs_sinh]
      exact Real.sinh_le_sinh.mpr hhalf
    calc ‖star (RHLean.sph x) * h x‖
        = ‖RHLean.sph x‖ * ‖h x‖ := by rw [norm_mul, norm_star]
      _ ≤ S * ‖h x‖ := mul_le_mul_of_nonneg_right hs (norm_nonneg _)
      _ ≤ S * B := mul_le_mul_of_nonneg_left (bh x hx) hS0
end Y7GateIIAdd
