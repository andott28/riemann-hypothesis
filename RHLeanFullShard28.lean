theorem polarForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (F G : ℝ)
    (ha : 0 < a) (hf : Continuous f) (hg : Continuous g)
    (hF : ∀ x, ‖f x‖ ≤ F) (hG : ∀ x, ‖g x‖ ≤ G) :
    |RHLean.polarForm a f - RHLean.polarForm a g|
      ≤ 2 * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))
          * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
            * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
              + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2))) := by
  set S := Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
  have hfm : MemLp f 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hf _ Set.Ioo_subset_Icc_self
  have hgm : MemLp g 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen hg _ Set.Ioo_subset_Icc_self
  have hfgm : MemLp (f - g) 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen (hf.sub hg) _ Set.Ioo_subset_Icc_self
  have hintf : IntegrableOn (fun x => star (RHLean.sph x) * f x)
      (Set.Ioo (-a) a) volume := by
    have hc : Continuous (fun x : ℝ => star (RHLean.sph x) * f x) := by
      unfold RHLean.sph; fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintg : IntegrableOn (fun x => star (RHLean.sph x) * g x)
      (Set.Ioo (-a) a) volume := by
    have hc : Continuous (fun x : ℝ => star (RHLean.sph x) * g x) := by
      unfold RHLean.sph; fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hsub := polarInner_sub a f g hintf hintg
  have hPf : ‖RHLean.polarInner a f‖
      ≤ S * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2) :=
    norm_polarInner_le a f hfm
  have hPg : ‖RHLean.polarInner a g‖
      ≤ S * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) :=
    norm_polarInner_le a g hgm
  have hPfg : ‖RHLean.polarInner a (f - g)‖
      ≤ S * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) :=
    norm_polarInner_le a (f - g) hfgm
  rw [hsub] at hPfg
  have hnorm : |‖RHLean.polarInner a f‖ - ‖RHLean.polarInner a g‖|
      ≤ ‖RHLean.polarInner a f - RHLean.polarInner a g‖ :=
    abs_norm_sub_norm_le _ _
  unfold RHLean.polarForm
  have htot : ‖RHLean.polarInner a f‖ + ‖RHLean.polarInner a g‖
      ≤ S * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2)
        + Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2)) := by
    nlinarith [hPf, hPg]
  have hsum0 : 0 ≤ ‖RHLean.polarInner a f‖ + ‖RHLean.polarInner a g‖ :=
    add_nonneg (norm_nonneg _) (norm_nonneg _)
  have hstep : |2 * ‖RHLean.polarInner a f‖ ^ 2
      - 2 * ‖RHLean.polarInner a g‖ ^ 2|
      ≤ 2 * |‖RHLean.polarInner a f‖ - ‖RHLean.polarInner a g‖|
        * |‖RHLean.polarInner a f‖ + ‖RHLean.polarInner a g‖| := by
    have h0 : 2 * ‖RHLean.polarInner a f‖ ^ 2 - 2 * ‖RHLean.polarInner a g‖ ^ 2
        = 2 * (‖RHLean.polarInner a f‖ - ‖RHLean.polarInner a g‖)
            * (‖RHLean.polarInner a f‖ + ‖RHLean.polarInner a g‖) := by ring
    rw [h0, abs_mul, abs_mul, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
  rw [abs_of_nonneg hsum0] at hstep
  have hA : 2 * |‖RHLean.polarInner a f‖ - ‖RHLean.polarInner a g‖|
      ≤ 2 * (S * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) := by
    nlinarith [hnorm, hPfg]
  refine le_trans hstep ?_
  exact mul_le_mul hA htot hsum0 (by positivity)
end Y7GateIIAdd
