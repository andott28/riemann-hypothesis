open Real
namespace RHLean.EpsBound
theorem endpoint7_eq : RHLean.endpoint 7 = Real.log 7 / 2 := rfl
theorem log7_gt : (1.94 : ℝ) < Real.log 7 := by
  have h := Y7Chain.log_seven_box.lo_le
  have h' : (1.94 : ℝ) ≤ ((121619384315957 / 62500000000000 : ℚ) : ℝ) := by norm_num
  linarith
theorem log7_lt : Real.log 7 < 1.95 := by
  have h := Y7Chain.log_seven_box.le_hi
  have h' : ((389182029811063 / 200000000000000 : ℚ) : ℝ) < 1.95 := by norm_num
  linarith
theorem a_pos : 0 < RHLean.endpoint 7 := by
  rw [endpoint7_eq]; linarith [log7_gt]
theorem a_gt : (0.97 : ℝ) < RHLean.endpoint 7 := by
  rw [endpoint7_eq]; linarith [log7_gt]
theorem a_lt : RHLean.endpoint 7 < 0.975 := by
  rw [endpoint7_eq]; linarith [log7_lt]
theorem a_le_one : RHLean.endpoint 7 ≤ 1 := by linarith [a_lt]
theorem ratio_le : 2 * RHLean.endpoint 7 / (14 / 5) ≤ 5 / 7 := by
  rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 14 / 5)]
  nlinarith [a_lt]
theorem ratio_pos : 0 ≤ 2 * RHLean.endpoint 7 / (14 / 5) := by
  have := a_pos; positivity
theorem one_sub_ratio : (2 / 7 : ℝ) ≤ 1 - 2 * RHLean.endpoint 7 / (14 / 5) := by
  linarith [ratio_le]
theorem sin_14_5_ge : (0.33 : ℝ) ≤ Real.sin (14 / 5) := by
  have hx0 : (0 : ℝ) ≤ Real.pi - 14 / 5 := by linarith [Real.pi_gt_d4]
  have hx1 : Real.pi - 14 / 5 ≤ 0.3416 := by linarith [Real.pi_lt_d4]
  have hx0' : (0.3415 : ℝ) ≤ Real.pi - 14 / 5 := by linarith [Real.pi_gt_d4]
  have hcube : (Real.pi - 14 / 5) ^ 3 ≤ 0.3416 ^ 3 := by
    have h := pow_le_pow_left₀ hx0 hx1 3
    simpa using h
  have hsub := Real.sin_ge_sub_cube hx0
  have hval : (14 / 5 : ℝ) = Real.pi - (Real.pi - 14 / 5) := by ring
  rw [hval, Real.sin_pi_sub]
  nlinarith [hsub, hcube]
theorem sin_14_5_pos : 0 < Real.sin (14 / 5) := by linarith [sin_14_5_ge]
theorem gammaM_le : Y7Chain.gammaM (14 / 5) ≤ 20 := by
  unfold Y7Chain.gammaM
  have hexp1 : Real.exp (14 / 5 / 2) ≤ Real.exp 2 :=
    Real.exp_le_exp.mpr (by norm_num)
  have hexp2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by
    rw [← Real.exp_add]; norm_num
  have hexp3 : Real.exp 1 ≤ 2.7182818286 := le_of_lt Real.exp_one_lt_d9
  have hexp_pos : 0 < Real.exp 1 := Real.exp_pos 1
  have hexp_le : Real.exp (14 / 5 / 2) ≤ 7.39 := by
    rw [hexp2] at hexp1
    nlinarith
  have hden : 0 < 2 * Real.sin (14 / 5) := by linarith [sin_14_5_pos]
  have hfrac : Real.exp (14 / 5 / 2) / (2 * Real.sin (14 / 5)) ≤ 7.39 / (2 * 0.33) := by
    rw [div_le_iff₀ hden]
    have h2 : (7.39 / (2 * 0.33)) * (2 * (0.33 : ℝ)) ≤ (7.39 / (2 * 0.33)) * (2 * Real.sin (14 / 5)) := by
      nlinarith [sin_14_5_ge, hden]
    have h3 : (7.39 / (2 * 0.33)) * (2 * (0.33 : ℝ)) = 7.39 := by norm_num
    nlinarith [hexp_le, h2, h3]
  have hsecond : (1 : ℝ) / (2 * (14 / 5)) ≤ 1 := by
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2 * (14 / 5))]
    norm_num
  linarith
theorem sinh_le_exp : Real.sinh (RHLean.endpoint 7) ≤ Real.exp (RHLean.endpoint 7) := by
  rw [Real.sinh_eq]
  have h1 := Real.exp_pos (RHLean.endpoint 7)
  have h2 := Real.exp_pos (-RHLean.endpoint 7)
  linarith
theorem exp_le : Real.exp (RHLean.endpoint 7) ≤ 2.72 := by
  have h1 : Real.exp (RHLean.endpoint 7) ≤ Real.exp 1 :=
    Real.exp_le_exp.mpr (by linarith [a_lt])
  have h2 : Real.exp 1 ≤ 2.7182818286 := le_of_lt Real.exp_one_lt_d9
  linarith
theorem sqrt_le_two : Real.sqrt (Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 - 1) ≤ 2 := by
  rw [Real.sqrt_le_iff]
  refine ⟨by norm_num, ?_⟩
  have h : Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 ≤ 3 := by
    rw [div_le_iff₀ a_pos]
    nlinarith [sinh_le_exp, exp_le, a_gt]
  nlinarith
theorem sinhRem_le : Y7Chain.sinhRemainder (RHLean.endpoint 7) ≤ 1 / 10 ^ 60 := by
  unfold Y7Chain.sinhRemainder
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hfac : (1 : ℝ) ≤ ((201).factorial : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero 201)
  have hpow : (RHLean.endpoint 7 / 2) ^ 201 ≤ (1 / 2 : ℝ) ^ 201 := by
    apply pow_le_pow_left₀ (by positivity)
    linarith
  have hden : (1 / 2 : ℝ) ≤ 1 - (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) := by
    have hsq : (RHLean.endpoint 7 / 2) ^ 2 ≤ 1 / 4 := by nlinarith [ha0, ha1]
    have hd : (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) ≤ 1 / 2 := by
      rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 202 * 203)]
      nlinarith
    linarith
  have hfacpos : (0 : ℝ) < ((201).factorial : ℝ) := by linarith
  have hstep1 : (RHLean.endpoint 7 / 2) ^ 201 / ((201).factorial : ℝ) ≤ (1 / 2 : ℝ) ^ 201 := by
    refine (div_le_iff₀ hfacpos).mpr ?_
    have hpos : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ 201 := by positivity
    nlinarith [hpow, hfac]
  have hdpos : (0 : ℝ) < 1 - (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) := by linarith
  have hpow200 : (1 / 2 : ℝ) ^ 201 ≤ 1 / 10 ^ 60 * (1 / 2) := by norm_num
  refine (div_le_iff₀ hdpos).mpr ?_
  nlinarith [hstep1, hden, hpow200]
theorem epsilonGamma_le : Y7Chain.epsilonGamma (RHLean.endpoint 7) ≤ 1 / 16 := by
  unfold Y7Chain.epsilonGamma
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hr0 := ratio_pos
  have hr1 := ratio_le
  have hden := one_sub_ratio
  have hden_pos : 0 < 1 - 2 * RHLean.endpoint 7 / (14 / 5) := by linarith
  have h40 : (5 / 7 : ℝ) ^ 40 ≤ 1 / 100000 := by norm_num
  have h240 : ((5 / 7 : ℝ) ^ 40) ^ 6 ≤ ((1 / 100000 : ℝ)) ^ 6 :=
    pow_le_pow_left₀ (by norm_num) h40 6
  have hsplit : ((5 / 7 : ℝ) ^ 40) ^ 6 = (5 / 7 : ℝ) ^ 240 := by
    rw [← pow_mul]
  have hle240 : (5 / 7 : ℝ) ^ 241 ≤ (5 / 7 : ℝ) ^ 240 := by
    have hnn : (0 : ℝ) ≤ (5 / 7 : ℝ) ^ 240 := by positivity
    have h1 : (5 / 7 : ℝ) ≤ 1 := by norm_num
    calc (5 / 7 : ℝ) ^ 241 = (5 / 7 : ℝ) ^ 240 * (5 / 7) := by
          rw [show 241 = 240 + 1 by norm_num, pow_succ]
        _ ≤ (5 / 7 : ℝ) ^ 240 * 1 := by
          exact mul_le_mul_of_nonneg_left h1 hnn
        _ = (5 / 7 : ℝ) ^ 240 := mul_one _
  have hr_mono : (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ (5 / 7 : ℝ) ^ 241 :=
    pow_le_pow_left₀ hr0 hr1 241
  have h6 : ((1 / 100000 : ℝ)) ^ 6 = 1 / 10 ^ 30 := by norm_num
  have hrpow : (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ 1 / 10 ^ 30 := by
    linarith [hr_mono, hle240, h240, hsplit, h6]
  have hγ := gammaM_le
  have hγpos : 0 ≤ Y7Chain.gammaM (14 / 5) := by
    unfold Y7Chain.gammaM
    have hA : 0 < Real.exp (14 / 5 / 2) / (2 * Real.sin (14 / 5)) :=
      div_pos (Real.exp_pos _) (by linarith [sin_14_5_pos])
    have hB : 0 < (1 : ℝ) / (2 * (14 / 5)) := by positivity
    linarith
  have hrp : 0 ≤ (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 := pow_nonneg hr0 241
  have hstep1 : RHLean.endpoint 7 * Y7Chain.gammaM (14 / 5) ≤ 1 * 20 := by
    nlinarith [ha0, ha1, hγ, hγpos]
  have hstep2 : RHLean.endpoint 7 * Y7Chain.gammaM (14 / 5)
      * (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ (1 * 20) * (1 / 10 ^ 30) :=
    mul_le_mul hstep1 hrpow hrp (by norm_num)
  refine (div_le_iff₀ hden_pos).mpr ?_
  nlinarith [hstep2, hden, hden_pos]
theorem sinhRem_nonneg : 0 ≤ Y7Chain.sinhRemainder (RHLean.endpoint 7) := by
  unfold Y7Chain.sinhRemainder
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hsq : (RHLean.endpoint 7 / 2) ^ 2 ≤ 1 / 4 := by nlinarith [ha0, ha1]
  have hd : (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) ≤ 1 / 2 := by
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 202 * 203)]
    nlinarith
  have hpos : (0 : ℝ) < 1 - (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) := by linarith
  positivity
theorem epsilonPolar_le : Y7Chain.epsilonPolar (RHLean.endpoint 7) ≤ 1 / 16 := by
  unfold Y7Chain.epsilonPolar
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hs := sinhRem_le
  have hs0 := sinhRem_nonneg
  have hs1 : Y7Chain.sinhRemainder (RHLean.endpoint 7) ≤ 1 := by
    linarith [hs]
  have hs2 : Y7Chain.sinhRemainder (RHLean.endpoint 7) ^ 2 ≤ 1 / 10 ^ 60 := by
    nlinarith [hs, hs0, hs1, sq_nonneg (Y7Chain.sinhRemainder (RHLean.endpoint 7) - 1)]
  have h1 := sqrt_le_two
  have h1pos : 0 ≤ Real.sqrt (Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 - 1) :=
    Real.sqrt_nonneg _
  have h2 : Real.sqrt 2 ≤ 2 := by
    have := Real.sqrt_two_lt_three_halves
    linarith
  have h2pos : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg _
  have hterm : 2 * Real.sqrt (Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 - 1)
      * Real.sqrt 2 * Y7Chain.sinhRemainder (RHLean.endpoint 7) ≤ 8 / 10 ^ 60 := by
    nlinarith [h1, h2, hs, h1pos, h2pos, hs0,
      mul_nonneg h1pos h2pos, mul_nonneg (mul_nonneg h1pos h2pos) hs0]
  nlinarith [hterm, hs2, ha0, ha1]
theorem epsilonTotal_endpoint_seven_le :
    Y7Chain.epsilonGamma (RHLean.endpoint 7) + Y7Chain.epsilonPolar (RHLean.endpoint 7) ≤ 1 / 8 := by
  have h1 := epsilonGamma_le
  have h2 := epsilonPolar_le
  linarith
end RHLean.EpsBound
