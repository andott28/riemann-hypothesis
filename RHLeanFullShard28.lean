namespace Y7W5GammaModel
lemma gammaModelKernel_integral_eq (a : ℝ) (m n : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ∫ y in Set.Ioo (-1 : ℝ) 1,
      Y7W5Kernel.gammaModelKernel a ‖x - y‖ *
        ((Y7Legendre.phi m).eval x * (Y7Legendre.phi n).eval y))
      = a * Y7KPP.gammaModelM a m n := by
  rw [Y7KPP.gammaModelM_spec]
  unfold Y7W5Kernel.gammaModelKernel
  simp_rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  simp only [Real.norm_eq_abs, mul_assoc]
  simp_rw [intervalIntegral.integral_const_mul]
lemma integrableOn_gammaModelKernel_phi (a : ℝ) (m n : ℕ) {x' : ℝ}
    (hx' : x' ∈ Set.Ioo (-1 : ℝ) 1) :
    IntegrableOn (fun y : ℝ => Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
      ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y))
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Y7Legendre.phi n).continuous.continuousOn
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 2)).exists_bound_of_continuousOn
    (by
      fun_prop : ContinuousOn (fun z : ℝ => a * (Y7Density.rhoTrunc 240).eval (a * z))
        (Set.Icc (0 : ℝ) 2))
  have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0 ⟨by norm_num, by norm_num⟩)
  refine IntegrableOn.of_bound ?hfin ?hmeas (|(Y7Legendre.phi m).eval x'| * K * Cn) ?hbound
  · rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  · have hcont : Continuous (fun y : ℝ =>
        Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)) := by
      unfold Y7W5Kernel.gammaModelKernel
      fun_prop
    exact hcont.aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
    have hx1 : |x'| ≤ 1 := by
      rw [abs_le]
      exact ⟨le_of_lt hx'.1, le_of_lt hx'.2⟩
    have hy1 : |y| ≤ 1 := by
      rw [abs_le]
      exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hdist : ‖x' - y‖ ≤ 2 := by
      calc ‖x' - y‖ ≤ ‖x'‖ + ‖y‖ := norm_sub_le _ _
        _ = |x'| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ 2 := by linarith
    have hkb : ‖Y7W5Kernel.gammaModelKernel a ‖x' - y‖‖ ≤ K := by
      rw [Real.norm_eq_abs]
      exact hK ‖x' - y‖ ⟨norm_nonneg _, hdist⟩
    have hyb : ‖(Y7Legendre.phi n).eval y‖ ≤ Cn :=
      hCn y ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    rw [Real.norm_eq_abs, abs_mul, abs_mul]
    calc |Y7W5Kernel.gammaModelKernel a ‖x' - y‖| *
          (|(Y7Legendre.phi m).eval x'| * |(Y7Legendre.phi n).eval y|)
        ≤ K * (|(Y7Legendre.phi m).eval x'| * Cn) :=
          mul_le_mul hkb
            (mul_le_mul_of_nonneg_left (by simpa [Real.norm_eq_abs] using hyb)
              (abs_nonneg _))
            (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hK0
      _ = |(Y7Legendre.phi m).eval x'| * K * Cn := by ring
lemma integrableOn_gammaModelKernel_phi_integral (a : ℝ) (m n : ℕ) :
    IntegrableOn (fun x' : ℝ => ∫ y in Set.Ioo (-1 : ℝ) 1,
      Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
        ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y))
      (Set.Ioo (-1 : ℝ) 1) := by
  obtain ⟨Cm, hCm⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Y7Legendre.phi m).continuous.continuousOn
  obtain ⟨Cn, hCn⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    (Y7Legendre.phi n).continuous.continuousOn
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 2)).exists_bound_of_continuousOn
    (by
      fun_prop : ContinuousOn (fun z : ℝ => a * (Y7Density.rhoTrunc 240).eval (a * z))
        (Set.Icc (0 : ℝ) 2))
  have Cm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hCm 0 ⟨by norm_num, by norm_num⟩)
  have Cn0 : 0 ≤ Cn := le_trans (norm_nonneg _) (hCn 0 ⟨by norm_num, by norm_num⟩)
  have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0 ⟨by norm_num, by norm_num⟩)
  refine IntegrableOn.of_bound ?hfin ?hmeas (K * Cm * Cn * 2) ?hbound
  · rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  · have hmeas : Measurable (fun p : ℝ × ℝ =>
        Y7W5Kernel.gammaModelKernel a ‖p.1 - p.2‖ *
          ((Y7Legendre.phi m).eval p.1 * (Y7Legendre.phi n).eval p.2)) := by
      have hcont : Continuous (fun p : ℝ × ℝ =>
          Y7W5Kernel.gammaModelKernel a ‖p.1 - p.2‖ *
            ((Y7Legendre.phi m).eval p.1 * (Y7Legendre.phi n).eval p.2)) := by
        unfold Y7W5Kernel.gammaModelKernel
        fun_prop
      exact hcont.measurable
    exact hmeas.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x' hx'
    have hbound : ∀ y ∈ Set.Ioo (-1 : ℝ) 1,
        ‖Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)‖
          ≤ K * Cm * Cn := by
      intro y hy
      have hy1 : |y| ≤ 1 := by
        rw [abs_le]
        exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      have hx1 : |x'| ≤ 1 := by
        rw [abs_le]
        exact ⟨le_of_lt hx'.1, le_of_lt hx'.2⟩
      have hdist : ‖x' - y‖ ≤ 2 := by
        calc ‖x' - y‖ ≤ ‖x'‖ + ‖y‖ := norm_sub_le _ _
          _ = |x'| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ 2 := by linarith
      have hkb : ‖Y7W5Kernel.gammaModelKernel a ‖x' - y‖‖ ≤ K := by
        rw [Real.norm_eq_abs]
        exact hK ‖x' - y‖ ⟨norm_nonneg _, hdist⟩
      have hmb : ‖(Y7Legendre.phi m).eval x'‖ ≤ Cm :=
        hCm x' ⟨le_of_lt hx'.1, le_of_lt hx'.2⟩
      have hnb : ‖(Y7Legendre.phi n).eval y‖ ≤ Cn :=
        hCn y ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      rw [Real.norm_eq_abs, abs_mul, abs_mul]
      calc |Y7W5Kernel.gammaModelKernel a ‖x' - y‖| *
            (|(Y7Legendre.phi m).eval x'| * |(Y7Legendre.phi n).eval y|)
          ≤ K * (Cm * Cn) :=
            mul_le_mul hkb (mul_le_mul hmb hnb (abs_nonneg _) Cm0)
              (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hK0
        _ = K * Cm * Cn := by ring
    have hbound_ae : ∀ᵐ y ∂(volume.restrict (Set.Ioo (-1 : ℝ) 1)),
        ‖Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)‖
          ≤ K * Cm * Cn := by
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with y hy
      exact hbound y hy
    calc ‖∫ y in Set.Ioo (-1 : ℝ) 1,
          Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
            ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)‖
        ≤ (K * Cm * Cn) * (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ :=
          norm_integral_le_of_norm_le_const hbound_ae
      _ = K * Cm * Cn * 2 := by
          have hvol : (volume.restrict (Set.Ioo (-1 : ℝ) 1)).real Set.univ = 2 := by
            simp [Measure.real, Real.volume_Ioo]
            norm_num
          rw [hvol]
theorem gammaModelForm_legSum (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ) :
    Y7W5Kernel.gammaModelForm a (Y7Op.legSum x s)
      = a * ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7KPP.gammaModelM a m n := by
  have hpt : ∀ x' y : ℝ,
      (Y7Op.legSum x s x' * star (Y7Op.legSum x s y)).re =
        ∑ m ∈ s, ∑ n ∈ s, x m * x n *
          ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y) := by
    intro x' y
    have h1 : Y7Op.legSum x s x' =
        ((∑ m ∈ s, x m * (Y7Legendre.phi m).eval x' : ℝ) : ℂ) := by
      simp only [Y7Op.legSum, Y7Matrix.phiC, Complex.ofReal_sum, Complex.ofReal_mul]
    have h2 : star (Y7Op.legSum x s y) =
        ((∑ n ∈ s, x n * (Y7Legendre.phi n).eval y : ℝ) : ℂ) := by
      rw [show Y7Op.legSum x s y =
          ((∑ n ∈ s, x n * (Y7Legendre.phi n).eval y : ℝ) : ℂ) from by
        simp only [Y7Op.legSum, Y7Matrix.phiC, Complex.ofReal_sum, Complex.ofReal_mul]]
      simp only [Complex.star_def, Complex.conj_ofReal]
    rw [h1, h2, ← Complex.ofReal_mul, Complex.ofReal_re, Finset.sum_mul_sum]
    apply Finset.sum_congr rfl
    intro m hm
    apply Finset.sum_congr rfl
    intro n hn
    ring
  have hinner : ∀ x' ∈ Set.Ioo (-1 : ℝ) 1,
      (∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
        (Y7Op.legSum x s x' * star (Y7Op.legSum x s y)).re) =
      ∑ m ∈ s, ∑ n ∈ s, x m * x n *
        (∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)) := by
    intro x' hx'
    have hpt' : (fun y : ℝ => Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          (Y7Op.legSum x s x' * star (Y7Op.legSum x s y)).re) =
        fun y => ∑ m ∈ s, ∑ n ∈ s, x m * x n *
          (Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
            ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)) := by
      funext y
      rw [hpt x' y, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m hm
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    rw [hpt']
    rw [MeasureTheory.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro m hm
      rw [MeasureTheory.integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro n hn
        rw [← MeasureTheory.integral_const_mul]
      · intro n hn
        exact Integrable.const_mul (integrableOn_gammaModelKernel_phi a m n hx')
          (x m * x n)
    · intro m hm
      apply integrable_finsetSum
      intro n hn
      exact Integrable.const_mul (integrableOn_gammaModelKernel_phi a m n hx')
        (x m * x n)
  unfold Y7W5Kernel.gammaModelForm
  have houter : (∫ x' in Set.Ioo (-1 : ℝ) 1,
        ∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
          (Y7Op.legSum x s x' * star (Y7Op.legSum x s y)).re) =
      ∫ x' in Set.Ioo (-1 : ℝ) 1,
        ∑ m ∈ s, ∑ n ∈ s, x m * x n *
          (∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
            ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)) := by
    apply MeasureTheory.integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with x' hx'
    exact hinner x' hx'
  rw [houter]
  rw [MeasureTheory.integral_finsetSum]
  · rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m hm
    rw [MeasureTheory.integral_finsetSum]
    · rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      have hconst : (∫ x' in Set.Ioo (-1 : ℝ) 1,
          x m * x n *
            (∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
              ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)))
          = (x m * x n) *
            (∫ x' in Set.Ioo (-1 : ℝ) 1,
              ∫ y in Set.Ioo (-1 : ℝ) 1, Y7W5Kernel.gammaModelKernel a ‖x' - y‖ *
                ((Y7Legendre.phi m).eval x' * (Y7Legendre.phi n).eval y)) := by
        rw [MeasureTheory.integral_const_mul]
      rw [hconst, gammaModelKernel_integral_eq]
      ring
    · intro n hn
      exact Integrable.const_mul (integrableOn_gammaModelKernel_phi_integral a m n)
        (x m * x n)
  · intro m hm
    apply integrable_finsetSum
    intro n hn
    exact Integrable.const_mul (integrableOn_gammaModelKernel_phi_integral a m n)
      (x m * x n)
end Y7W5GammaModel
