            _ = ‖g x‖ + |ur x| := by
              rw [show ‖((ur x : ℝ) : ℂ)‖ = |ur x| from RCLike.norm_ofReal _]
            _ ≤ (Bu + 2 * a * η) + Bu := add_le_add h1 h2
