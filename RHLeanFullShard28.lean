      _ = M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖) * (2 * a) := hfold
      _ = M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖ := by ring
  have hp1 : |(1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re)|
      ≤ (1 / 2) * (M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖) := by
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    exact mul_le_mul_of_nonneg_left hA1 (by norm_num)
  have hA2 : |∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re|
      ≤ M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖ := by
    have hmono : ∫ x in Set.Ioo (-a) a, |∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re|
      ≤ ∫ x in Set.Ioo (-a) a, M * Bw * (2 * a) * ‖h x‖ :=
      MeasureTheory.setIntegral_mono_ae_restrict
        (f := fun x : ℝ => |∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re|)
        (g := fun x : ℝ => M * Bw * (2 * a) * ‖h x‖)
        (hf := hintA2.norm) (hg := hintDom2)
        (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo]
            with x hx
            exact hval2 x hx)
    have hfold : ∫ x in Set.Ioo (-a) a, M * Bw * (2 * a) * ‖h x‖
        = M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖ :=
      integral_const_mul _ _
    have habs2 : |∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re|
      ≤ ∫ x in Set.Ioo (-a) a, |∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re| := by
      have h1 : ‖∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re‖
          ≤ ∫ x in Set.Ioo (-a) a, ‖∫ y in Set.Ioo (-a) a,
              RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re‖ :=
        MeasureTheory.norm_integral_le_integral_norm
          (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
      simpa [Real.norm_eq_abs] using h1
    calc |∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re|
        ≤ ∫ x in Set.Ioo (-a) a, |∫ y in Set.Ioo (-a) a,
            RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re| := habs2
      _ ≤ ∫ x in Set.Ioo (-a) a, M * Bw * (2 * a) * ‖h x‖ := hmono
      _ = M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖ := hfold
  have hp2 : |(1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re)|
      ≤ (1 / 2) * (M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖) := by
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    exact mul_le_mul_of_nonneg_left hA2 (by norm_num)
  rw [show RHLean.GateII.Reduction.gammaBilin a w h
      = (1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re)
        + (1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re) from rfl]
  calc |(1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re)
        + (1 / 2) * (∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re)|
      ≤ (1 / 2) * (M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖)
        + (1 / 2) * (M * Bw * (2 * a) * ∫ x in Set.Ioo (-a) a, ‖h x‖) :=
        le_trans (abs_add_le _ _) (add_le_add hp1 hp2)
    _ = M * Bw * (2 * a) * (∫ x in Set.Ioo (-a) a, ‖h x‖) := by ring
    _ = (∫ x in Set.Ioo (-a) a, ‖h x‖) * (M * Bw * (2 * a)) := by ring
    _ ≤ (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))
        * (M * Bw * (2 * a)) :=
        mul_le_mul_of_nonneg_right hH2
          (mul_nonneg (mul_nonneg hM0 hBw0) (by linarith))
    _ = M * Bw * (2 * a) * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by ring
private theorem polarBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (Bw : ℝ)
    (ha : 0 < a)
    (hwm : Measurable w) (hhm : Measurable h)
    (hwB : ∀ x : ℝ, ‖w x‖ ≤ Bw)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.polarBilin a w h|
      ≤ 2 * Bw * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hsphC : Continuous (fun x : ℝ => RHLean.sph x) := by
    unfold RHLean.sph
    exact Complex.continuous_ofReal.comp
      (Real.continuous_sinh.comp (by fun_prop))
  have hintSq : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hmh : MeasureTheory.MemLp h 2
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    (MeasureTheory.memLp_two_iff_integrable_sq_norm
      (hhm.aestronglyMeasurable)).mpr hintSq
  have hintSph1 : MeasureTheory.IntegrableOn
      (fun x : ℝ => ‖RHLean.sph x‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
    hsphC.norm.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintSphDom : MeasureTheory.IntegrableOn
      (fun x : ℝ => Bw * ‖RHLean.sph x‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
    hintSph1.const_mul Bw
  have hBw0 : 0 ≤ Bw := le_trans (norm_nonneg _) (hwB 0)
  have hmeasW : MeasureTheory.AEStronglyMeasurable
      (fun y : ℝ => star (RHLean.sph y) * w y)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    (continuous_star.measurable.comp hsphC.measurable).mul hwm |>.aestronglyMeasurable
  have hintW : MeasureTheory.IntegrableOn
      (fun y : ℝ => star (RHLean.sph y) * w y) (Set.Ioo (-a) a)
      MeasureTheory.volume :=
    MeasureTheory.Integrable.mono
      (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a))
      (g := fun y : ℝ => Bw * ‖RHLean.sph y‖) hintSphDom hmeasW
      (by filter_upwards with y
          calc ‖star (RHLean.sph y) * w y‖
              = ‖RHLean.sph y‖ * ‖w y‖ := by rw [norm_mul, norm_star]
            _ ≤ ‖RHLean.sph y‖ * Bw :=
                mul_le_mul_of_nonneg_left (hwB y) (norm_nonneg _)
            _ = ‖Bw * ‖RHLean.sph y‖‖ := by
                have hnn : 0 ≤ Bw * ‖RHLean.sph y‖ :=
                  mul_nonneg hBw0 (norm_nonneg _)
                rw [Real.norm_eq_abs (Bw * ‖RHLean.sph y‖),
                  abs_of_nonneg hnn]
                ring)
  have hW : ‖RHLean.polarInner a w‖ ≤ Bw * ∫ x in Set.Ioo (-a) a,
      ‖RHLean.sph x‖ := by
    rw [show RHLean.polarInner a w = ∫ y in Set.Ioo (-a) a,
        star (RHLean.sph y) * w y from rfl]
    have hmono : ∫ y in Set.Ioo (-a) a,
        ‖star (RHLean.sph y) * w y‖
        ≤ ∫ y in Set.Ioo (-a) a, Bw * ‖RHLean.sph y‖ :=
      MeasureTheory.setIntegral_mono_ae_restrict
        (f := fun y : ℝ => ‖star (RHLean.sph y) * w y‖)
        (g := fun y : ℝ => Bw * ‖RHLean.sph y‖)
        (hf := hintW.norm) (hg := hintSphDom)
        (by filter_upwards with y
            calc ‖star (RHLean.sph y) * w y‖
                = ‖RHLean.sph y‖ * ‖w y‖ := by rw [norm_mul, norm_star]
              _ ≤ ‖RHLean.sph y‖ * Bw :=
                  mul_le_mul_of_nonneg_left (hwB y) (norm_nonneg _)
              _ = Bw * ‖RHLean.sph y‖ := by ring)
    calc ‖∫ y in Set.Ioo (-a) a, star (RHLean.sph y) * w y‖
        ≤ ∫ y in Set.Ioo (-a) a, ‖star (RHLean.sph y) * w y‖ :=
          MeasureTheory.norm_integral_le_integral_norm
            (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
      _ ≤ ∫ y in Set.Ioo (-a) a, Bw * ‖RHLean.sph y‖ := hmono
      _ = Bw * ∫ y in Set.Ioo (-a) a, ‖RHLean.sph y‖ := integral_const_mul _ _
  have hH2 := Y7GateIIAdd.norm_polarInner_le a h hmh
  have hinSq : ∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2
      ≤ ∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2 :=
    MeasureTheory.setIntegral_mono_set hhint
      (MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖h x‖)))
      (MeasureTheory.ae_of_all _ (fun x hx => by
        constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2]))
  rw [show RHLean.GateII.Reduction.polarBilin a w h
      = 2 * (RHLean.polarInner a w * star (RHLean.polarInner a h)).re from rfl]
  calc |2 * (RHLean.polarInner a w * star (RHLean.polarInner a h)).re|
      = 2 * |(RHLean.polarInner a w * star (RHLean.polarInner a h)).re| := by
        rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    _ ≤ 2 * (‖RHLean.polarInner a w‖ * ‖RHLean.polarInner a h‖) := by
        refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
        calc |(RHLean.polarInner a w * star (RHLean.polarInner a h)).re|
            ≤ ‖RHLean.polarInner a w * star (RHLean.polarInner a h)‖ :=
              Complex.abs_re_le_norm _
          _ = ‖RHLean.polarInner a w‖ * ‖RHLean.polarInner a h‖ := by
              rw [norm_mul, norm_star]
    _ ≤ 2 * ((Bw * ∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
        * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
        exact mul_le_mul hW hH2 (norm_nonneg (RHLean.polarInner a h))
          (mul_nonneg hBw0
            (integral_nonneg (fun x => norm_nonneg (RHLean.sph x))))
    _ ≤ 2 * ((Bw * ∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
        * (Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
        refine mul_le_mul_of_nonneg_left ?_
          (mul_nonneg hBw0
            (integral_nonneg (fun x => norm_nonneg (RHLean.sph x))))
        exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hinSq)
          (Real.sqrt_nonneg _)
    _ = 2 * Bw * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by ring
private theorem shiftBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (Bw Bh : ℝ)
    (ha : 0 < a)
    (hwm : Measurable w) (hhm : Measurable h)
    (hwB : ∀ x : ℝ, ‖w x‖ ≤ Bw) (hhB : ∀ x : ℝ, ‖h x‖ ≤ Bh)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.shiftBilin a w h|
      ≤ (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
        * (2 * Bw * Real.sqrt (2 * a))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hfinIoc : MeasureTheory.volume (Set.Ioc (-a) a) < ⊤ := by
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hintSq : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hintNorm : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    integrableOn_norm_of_sq hhm hintSq hfin
  have hH2 := l1_Ioo_le_fat a h ha hhm hhint
  have hBw0 : 0 ≤ Bw := le_trans (norm_nonneg _) (hwB 0)
  have hterm : ∀ n ∈ RHLean.arithSupport a,
      |(RHLean.arithCoeff n * ((∫ x in Set.Ioo (-a) a,
          w x * star (h (x + RHLean.shiftLength n))).re
        + (∫ x in Set.Ioo (-a) a,
          h x * star (w (x + RHLean.shiftLength n))).re))|
      ≤ |RHLean.arithCoeff n| * ((Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))
          + (Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))) := by
    intro n hn
    have hℓ := Y7GateIIAdd.shiftLength_bounds a ha n hn
    have hmeashl : Measurable
        (fun x : ℝ => h (x + RHLean.shiftLength n)) :=
      hhm.comp (measurable_id.add measurable_const)
    have hintF1 : MeasureTheory.IntegrableOn
        (fun x : ℝ => w x * star (h (x + RHLean.shiftLength n)))
        (Set.Ioo (-a) a) MeasureTheory.volume := by
      refine MeasureTheory.IntegrableOn.of_bound hfin
        (hwm.mul (continuous_star.measurable.comp hmeashl)).aestronglyMeasurable
        (Bw * Bh) ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo]
          with x hx
      calc ‖w x * star (h (x + RHLean.shiftLength n))‖
          ≤ ‖w x‖ * ‖h (x + RHLean.shiftLength n)‖ :=
            le_of_eq (by rw [norm_mul, norm_star])
        _ ≤ Bw * Bh := mul_le_mul (hwB x)
            (hhB (x + RHLean.shiftLength n)) (norm_nonneg _) hBw0
    have hintF2 : MeasureTheory.IntegrableOn
        (fun x : ℝ => h x * star (w (x + RHLean.shiftLength n)))
        (Set.Ioo (-a) a) MeasureTheory.volume := by
      refine MeasureTheory.IntegrableOn.of_bound hfin
        (hhm.mul (continuous_star.measurable.comp
          (hwm.comp (measurable_id.add measurable_const)))).aestronglyMeasurable
        (Bh * Bw) ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo]
          with x hx
      calc ‖h x * star (w (x + RHLean.shiftLength n))‖
          ≤ ‖h x‖ * ‖w (x + RHLean.shiftLength n)‖ :=
            le_of_eq (by rw [norm_mul, norm_star])
        _ ≤ Bh * Bw := mul_le_mul (hhB x)
            (hwB (x + RHLean.shiftLength n)) (norm_nonneg _)
            (le_trans (norm_nonneg _) (hhB 0))
    have hintTr : MeasureTheory.IntegrableOn
        (fun x : ℝ => Bw * ‖h (x + RHLean.shiftLength n)‖)
        (Set.Ioc (-a) a) MeasureTheory.volume := by
      have hmeasT : MeasureTheory.AEStronglyMeasurable
          (fun x : ℝ => Bw * ‖h (x + RHLean.shiftLength n)‖)
          (MeasureTheory.volume.restrict (Set.Ioc (-a) a)) :=
        ((hhm.comp (measurable_id.add measurable_const)).norm.const_mul Bw
          |>.aestronglyMeasurable)
      refine MeasureTheory.IntegrableOn.of_bound hfinIoc hmeasT (Bw * Bh) ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc]
          with x hx
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hBw0
        (norm_nonneg _))]
      exact mul_le_mul_of_nonneg_left (hhB (x + RHLean.shiftLength n)) hBw0
    have hval1 : |(∫ x in Set.Ioo (-a) a,
        w x * star (h (x + RHLean.shiftLength n))).re|
        ≤ Bw * Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
      have hintSqT : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
          (Set.Ioc (-a + RHLean.shiftLength n)
            (a + RHLean.shiftLength n)) MeasureTheory.volume :=
        hhint.mono_set (by
          intro x hx
          constructor
          · linarith [(Set.mem_Ioc.mp hx).1, hℓ.1]
          · linarith [(Set.mem_Ioc.mp hx).2, hℓ.2])
      have hmono0 : ∫ x in Set.Ioo (-a) a, Bw * ‖h (x
          + RHLean.shiftLength n)‖
          ≤ ∫ x in Set.Ioc (-a) a, Bw * ‖h (x
          + RHLean.shiftLength n)‖ :=
        MeasureTheory.setIntegral_mono_set (t := Set.Ioc (-a) a) hintTr
          (MeasureTheory.ae_of_all _
            (fun x => mul_nonneg hBw0 (norm_nonneg _)))
          (MeasureTheory.ae_of_all _ (fun x hx => by
            constructor <;> linarith [(Set.mem_Ioo.mp hx).1,
              (Set.mem_Ioo.mp hx).2]))
      have htr := Y7GateIIAdd.setIntegral_translate_Ioc
        (RHLean.shiftLength n)
        (fun x : ℝ => Bw * ‖h x‖) (-a) a (by linarith)
      have hcs := l1_le_sqrt_measure_l2_meas
        (-a + RHLean.shiftLength n) (a + RHLean.shiftLength n) h
        (by linarith) hhm hintSqT
      rw [show (a + RHLean.shiftLength n)
          - (-a + RHLean.shiftLength n) = 2 * a from by ring] at hcs
      have hinSq : ∫ x in Set.Ioc (-a + RHLean.shiftLength n)
          (a + RHLean.shiftLength n), ‖h x‖ ^ 2
          ≤ ∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2 :=
        MeasureTheory.setIntegral_mono_set hhint
          (MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖h x‖)))
          (MeasureTheory.ae_of_all _ (fun x hx => by
            constructor
            · linarith [(Set.mem_Ioc.mp hx).1, hℓ.1]
            · linarith [(Set.mem_Ioc.mp hx).2, hℓ.2]))
      have hintTrThin : MeasureTheory.IntegrableOn
          (fun x : ℝ => Bw * ‖h (x + RHLean.shiftLength n)‖)
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        hintTr.mono_set (by
          intro x hx
          constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
      have hintNormT : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
          (Set.Ioc (-a + RHLean.shiftLength n)
            (a + RHLean.shiftLength n)) MeasureTheory.volume :=
        integrableOn_norm_of_sq hhm hintSqT (by
          rw [Real.volume_Ioc]
          exact ENNReal.ofReal_lt_top)
      calc |(∫ x in Set.Ioo (-a) a,
            w x * star (h (x + RHLean.shiftLength n))).re|
          ≤ ‖∫ x in Set.Ioo (-a) a,
              w x * star (h (x + RHLean.shiftLength n))‖ :=
            Complex.abs_re_le_norm _
        _ ≤ ∫ x in Set.Ioo (-a) a, ‖w x * star (h (x
            + RHLean.shiftLength n))‖ :=
            MeasureTheory.norm_integral_le_integral_norm
              (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
        _ ≤ ∫ x in Set.Ioo (-a) a, Bw * ‖h (x
            + RHLean.shiftLength n)‖ :=
            MeasureTheory.setIntegral_mono_ae_restrict
              (f := fun x : ℝ => ‖w x * star (h (x
                + RHLean.shiftLength n))‖)
              (g := fun x : ℝ => Bw * ‖h (x + RHLean.shiftLength n)‖)
              (hf := hintF1.norm) (hg := hintTrThin)
              (by filter_upwards [] with x
                  calc ‖w x * star (h (x + RHLean.shiftLength n))‖
                      ≤ ‖w x‖ * ‖h (x + RHLean.shiftLength n)‖ :=
                        le_of_eq (by rw [norm_mul, norm_star])
                    _ ≤ Bw * ‖h (x + RHLean.shiftLength n)‖ :=
                        mul_le_mul_of_nonneg_right (hwB x) (norm_nonneg _))
        _ ≤ ∫ x in Set.Ioc (-a) a, Bw * ‖h (x
            + RHLean.shiftLength n)‖ := hmono0
        _ = ∫ x in Set.Ioc (-a + RHLean.shiftLength n)
            (a + RHLean.shiftLength n), Bw * ‖h x‖ := htr
        _ = Bw * ∫ x in Set.Ioc (-a + RHLean.shiftLength n)
            (a + RHLean.shiftLength n), ‖h x‖ :=
            integral_const_mul _ _
        _ ≤ Bw * (Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-a + RHLean.shiftLength n)
              (a + RHLean.shiftLength n), ‖h x‖ ^ 2)) :=
            mul_le_mul_of_nonneg_left hcs hBw0
        _ ≤ Bw * (Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
              ‖h x‖ ^ 2)) := by
            refine mul_le_mul_of_nonneg_left ?_ hBw0
            refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
            exact Real.sqrt_le_sqrt hinSq
        _ = Bw * Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
              ‖h x‖ ^ 2) := by ring
    have hval2 : |(∫ x in Set.Ioo (-a) a,
        h x * star (w (x + RHLean.shiftLength n))).re|
        ≤ Bw * Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
      have hintDom : MeasureTheory.IntegrableOn
          (fun x : ℝ => Bw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
        hintNorm.const_mul Bw
      calc |(∫ x in Set.Ioo (-a) a,
            h x * star (w (x + RHLean.shiftLength n))).re|
          ≤ ‖∫ x in Set.Ioo (-a) a,
              h x * star (w (x + RHLean.shiftLength n))‖ :=
            Complex.abs_re_le_norm _
        _ ≤ ∫ x in Set.Ioo (-a) a, ‖h x * star (w (x
            + RHLean.shiftLength n))‖ :=
            MeasureTheory.norm_integral_le_integral_norm
              (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
        _ ≤ ∫ x in Set.Ioo (-a) a, Bw * ‖h x‖ :=
            MeasureTheory.setIntegral_mono_ae_restrict
              (f := fun x : ℝ => ‖h x * star (w (x
                + RHLean.shiftLength n))‖)
              (g := fun x : ℝ => Bw * ‖h x‖)
              (hf := hintF2.norm) (hg := hintDom)
              (by filter_upwards [] with x
                  calc ‖h x * star (w (x + RHLean.shiftLength n))‖
                      ≤ ‖h x‖ * ‖w (x + RHLean.shiftLength n)‖ :=
                        le_of_eq (by rw [norm_mul, norm_star])
                    _ ≤ ‖h x‖ * Bw :=
                        mul_le_mul_of_nonneg_left (hwB (x
                          + RHLean.shiftLength n)) (norm_nonneg _)
                    _ = Bw * ‖h x‖ := by ring)
        _ = Bw * ∫ x in Set.Ioo (-a) a, ‖h x‖ := integral_const_mul _ _
        _ = (∫ x in Set.Ioo (-a) a, ‖h x‖) * Bw := by ring
        _ ≤ (Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
              ‖h x‖ ^ 2)) * Bw :=
            mul_le_mul_of_nonneg_right hH2 hBw0
        _ = Bw * Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
              ‖h x‖ ^ 2) := by ring
    rw [abs_mul]
    have hsplit : |((∫ x in Set.Ioo (-a) a,
          w x * star (h (x + RHLean.shiftLength n))).re)
        + ((∫ x in Set.Ioo (-a) a,
          h x * star (w (x + RHLean.shiftLength n))).re)|
        ≤ (Bw * Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))
          + (Bw * Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)) :=
      le_trans (abs_add_le _ _) (add_le_add hval1 hval2)
    exact mul_le_mul_of_nonneg_left hsplit (abs_nonneg _)
  rw [show RHLean.GateII.Reduction.shiftBilin a w h
      = ∑ n ∈ RHLean.arithSupport a, RHLean.arithCoeff n
          * ((∫ x in Set.Ioo (-a) a,
            w x * star (h (x + RHLean.shiftLength n))).re
          + (∫ x in Set.Ioo (-a) a,
            h x * star (w (x + RHLean.shiftLength n))).re) from rfl]
  calc |∑ n ∈ RHLean.arithSupport a, RHLean.arithCoeff n
        * ((∫ x in Set.Ioo (-a) a,
          w x * star (h (x + RHLean.shiftLength n))).re
        + (∫ x in Set.Ioo (-a) a,
          h x * star (w (x + RHLean.shiftLength n))).re)|
      ≤ ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n
        * ((∫ x in Set.Ioo (-a) a,
          w x * star (h (x + RHLean.shiftLength n))).re
        + (∫ x in Set.Ioo (-a) a,
          h x * star (w (x + RHLean.shiftLength n))).re)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|
        * ((Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))
          + (Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))) :=
        Finset.sum_le_sum (fun n hn => hterm n hn)
    _ = (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
        * (2 * Bw * Real.sqrt (2 * a))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
        rw [← Finset.sum_mul]
        ring
theorem localizedBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (s₁ s₂ Lw Bw Bh M : ℝ)
    (ha : 0 < a) (hLw0 : 0 ≤ Lw)
    (hwm : Measurable w) (hhm : Measurable h)
    (hwB : ∀ x : ℝ, ‖w x‖ ≤ Bw) (hhB : ∀ x : ℝ, ‖h x‖ ≤ Bh)
    (hwL : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      ∀ y ∈ Set.Ioo (-a) a, y ≠ s₁ → y ≠ s₂ →
        ‖w x - w y‖ ≤ Lw * |x - y|)
    (hVm : Measurable
      (fun x : ℝ => RHLean.endpointPotential a x))
    (hM : ∀ z : ℝ, 0 ≤ z → z ≤ 2 * a → |RHLean.gammaKernel z| ≤ M)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.localizedBilin a w h|
      ≤ (Lw * a * Real.sqrt (2 * a)
        + |RHLean.physicalConstant| * Bw * Real.sqrt (2 * a)
        + Bw * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
        + M * Bw * (2 * a) * Real.sqrt (2 * a)
        + 2 * Bw * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        + (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
            * (2 * Bw * Real.sqrt (2 * a)))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have harch := archBilin_half_cont w h s₁ s₂ Lw Bh ha hLw0 hwm hhm hhB hwL hhint
  have hmass0 := massBilin_half_cont w h Bw Bh ha hwm hhm hwB hhB hhint
  have hpot := potentialBilin_half_cont w h Bw Bh ha hwm hhm hVm hwB hhB hhint
  have hmass : |RHLean.physicalConstant
      * RHLean.GateII.Reduction.massBilin a w h|
      ≤ |RHLean.physicalConstant| * (Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)) := by
    rw [show |RHLean.physicalConstant
        * RHLean.GateII.Reduction.massBilin a w h|
        = |RHLean.physicalConstant|
          * |RHLean.GateII.Reduction.massBilin a w h| from abs_mul _ _]
    exact mul_le_mul_of_nonneg_left hmass0 (abs_nonneg _)
  have hgam := gammaBilin_half_cont w h Bw Bh M ha hwm hhm hwB hhB hM hhint
  have hpol := polarBilin_half_cont w h Bw ha hwm hhm hwB hhint
  have hshi := shiftBilin_half_cont w h Bw Bh ha hwm hhm hwB hhB hhint
  rw [show RHLean.GateII.Reduction.localizedBilin a w h
      = (RHLean.GateII.Reduction.archBilin a w h
          + RHLean.physicalConstant
            * RHLean.GateII.Reduction.massBilin a w h
          + RHLean.GateII.Reduction.potentialBilin a w h)
        - (RHLean.GateII.Reduction.gammaBilin a w h
          + RHLean.GateII.Reduction.polarBilin a w h
          + RHLean.GateII.Reduction.shiftBilin a w h) from by
        unfold RHLean.GateII.Reduction.localizedBilin
        ring]
  have htri : |(RHLean.GateII.Reduction.archBilin a w h
      + RHLean.physicalConstant * RHLean.GateII.Reduction.massBilin a w h
      + RHLean.GateII.Reduction.potentialBilin a w h)
      - (RHLean.GateII.Reduction.gammaBilin a w h
      + RHLean.GateII.Reduction.polarBilin a w h
      + RHLean.GateII.Reduction.shiftBilin a w h)|
      ≤ |RHLean.GateII.Reduction.archBilin a w h|
        + |RHLean.physicalConstant
          * RHLean.GateII.Reduction.massBilin a w h|
        + |RHLean.GateII.Reduction.potentialBilin a w h|
        + |RHLean.GateII.Reduction.gammaBilin a w h|
        + |RHLean.GateII.Reduction.polarBilin a w h|
        + |RHLean.GateII.Reduction.shiftBilin a w h| := by
    have hstep1 : |(RHLean.GateII.Reduction.archBilin a w h
        + RHLean.physicalConstant
          * RHLean.GateII.Reduction.massBilin a w h
        + RHLean.GateII.Reduction.potentialBilin a w h)
        - (RHLean.GateII.Reduction.gammaBilin a w h
        + RHLean.GateII.Reduction.polarBilin a w h
        + RHLean.GateII.Reduction.shiftBilin a w h)|
        ≤ |(RHLean.GateII.Reduction.archBilin a w h
          + RHLean.physicalConstant
            * RHLean.GateII.Reduction.massBilin a w h
          + RHLean.GateII.Reduction.potentialBilin a w h)|
          + |-(RHLean.GateII.Reduction.gammaBilin a w h
          + RHLean.GateII.Reduction.polarBilin a w h
          + RHLean.GateII.Reduction.shiftBilin a w h)| := by
        have hX : ((RHLean.GateII.Reduction.archBilin a w h
            + RHLean.physicalConstant
              * RHLean.GateII.Reduction.massBilin a w h
            + RHLean.GateII.Reduction.potentialBilin a w h)
            + (-(RHLean.GateII.Reduction.gammaBilin a w h
            + RHLean.GateII.Reduction.polarBilin a w h
            + RHLean.GateII.Reduction.shiftBilin a w h)))
            = ((RHLean.GateII.Reduction.archBilin a w h
            + RHLean.physicalConstant
              * RHLean.GateII.Reduction.massBilin a w h
            + RHLean.GateII.Reduction.potentialBilin a w h)
            - (RHLean.GateII.Reduction.gammaBilin a w h
            + RHLean.GateII.Reduction.polarBilin a w h
            + RHLean.GateII.Reduction.shiftBilin a w h)) := rfl
        rw [← hX]
        exact abs_add_le _ _
    rw [abs_neg] at hstep1
    have htri1 : |(RHLean.GateII.Reduction.archBilin a w h
        + RHLean.physicalConstant
          * RHLean.GateII.Reduction.massBilin a w h
        + RHLean.GateII.Reduction.potentialBilin a w h)|
        ≤ |RHLean.GateII.Reduction.archBilin a w h|
          + |RHLean.physicalConstant
            * RHLean.GateII.Reduction.massBilin a w h|
          + |RHLean.GateII.Reduction.potentialBilin a w h| := by
        have hA : |(RHLean.GateII.Reduction.archBilin a w h
                + RHLean.physicalConstant
                  * RHLean.GateII.Reduction.massBilin a w h)
              + RHLean.GateII.Reduction.potentialBilin a w h|
            ≤ |RHLean.GateII.Reduction.archBilin a w h
                + RHLean.physicalConstant
                  * RHLean.GateII.Reduction.massBilin a w h|
              + |RHLean.GateII.Reduction.potentialBilin a w h| :=
              abs_add_le _ _
        have hB : |RHLean.GateII.Reduction.archBilin a w h
                + RHLean.physicalConstant
                  * RHLean.GateII.Reduction.massBilin a w h|
            ≤ |RHLean.GateII.Reduction.archBilin a w h|
              + |RHLean.physicalConstant
                * RHLean.GateII.Reduction.massBilin a w h| :=
              abs_add_le _ _
        calc |RHLean.GateII.Reduction.archBilin a w h
            + RHLean.physicalConstant
              * RHLean.GateII.Reduction.massBilin a w h
            + RHLean.GateII.Reduction.potentialBilin a w h|
            ≤ |RHLean.GateII.Reduction.archBilin a w h
                + RHLean.physicalConstant
                  * RHLean.GateII.Reduction.massBilin a w h|
              + |RHLean.GateII.Reduction.potentialBilin a w h| := hA
          _ ≤ (|RHLean.GateII.Reduction.archBilin a w h|
                + |RHLean.physicalConstant
                  * RHLean.GateII.Reduction.massBilin a w h|)
              + |RHLean.GateII.Reduction.potentialBilin a w h|
            := add_le_add hB (le_refl _)
          _ = |RHLean.GateII.Reduction.archBilin a w h|
              + |RHLean.physicalConstant
                * RHLean.GateII.Reduction.massBilin a w h|
              + |RHLean.GateII.Reduction.potentialBilin a w h| := by ring
    have htri2 : |(RHLean.GateII.Reduction.gammaBilin a w h
        + RHLean.GateII.Reduction.polarBilin a w h
        + RHLean.GateII.Reduction.shiftBilin a w h)|
        ≤ |RHLean.GateII.Reduction.gammaBilin a w h|
          + |RHLean.GateII.Reduction.polarBilin a w h|
          + |RHLean.GateII.Reduction.shiftBilin a w h| := by
        have hA : |(RHLean.GateII.Reduction.gammaBilin a w h
                + RHLean.GateII.Reduction.polarBilin a w h)
              + RHLean.GateII.Reduction.shiftBilin a w h|
            ≤ |RHLean.GateII.Reduction.gammaBilin a w h
                + RHLean.GateII.Reduction.polarBilin a w h|
              + |RHLean.GateII.Reduction.shiftBilin a w h| :=
              abs_add_le _ _
        have hB : |RHLean.GateII.Reduction.gammaBilin a w h
                + RHLean.GateII.Reduction.polarBilin a w h|
            ≤ |RHLean.GateII.Reduction.gammaBilin a w h|
              + |RHLean.GateII.Reduction.polarBilin a w h| :=
              abs_add_le _ _
        calc |RHLean.GateII.Reduction.gammaBilin a w h
            + RHLean.GateII.Reduction.polarBilin a w h
            + RHLean.GateII.Reduction.shiftBilin a w h|
            ≤ |RHLean.GateII.Reduction.gammaBilin a w h
                + RHLean.GateII.Reduction.polarBilin a w h|
              + |RHLean.GateII.Reduction.shiftBilin a w h| := hA
          _ ≤ (|RHLean.GateII.Reduction.gammaBilin a w h|
                + |RHLean.GateII.Reduction.polarBilin a w h|)
              + |RHLean.GateII.Reduction.shiftBilin a w h|
            := add_le_add hB (le_refl _)
          _ = |RHLean.GateII.Reduction.gammaBilin a w h|
              + |RHLean.GateII.Reduction.polarBilin a w h|
              + |RHLean.GateII.Reduction.shiftBilin a w h| := by ring
    linarith [hstep1, htri1, htri2]
  calc |(RHLean.GateII.Reduction.archBilin a w h
        + RHLean.physicalConstant
          * RHLean.GateII.Reduction.massBilin a w h
        + RHLean.GateII.Reduction.potentialBilin a w h)
        - (RHLean.GateII.Reduction.gammaBilin a w h
        + RHLean.GateII.Reduction.polarBilin a w h
        + RHLean.GateII.Reduction.shiftBilin a w h)|
      ≤ |RHLean.GateII.Reduction.archBilin a w h|
        + |RHLean.physicalConstant
          * RHLean.GateII.Reduction.massBilin a w h|
        + |RHLean.GateII.Reduction.potentialBilin a w h|
        + |RHLean.GateII.Reduction.gammaBilin a w h|
        + |RHLean.GateII.Reduction.polarBilin a w h|
        + |RHLean.GateII.Reduction.shiftBilin a w h| := htri
    _ ≤ (Lw * a * Real.sqrt (2 * a))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)
        + |RHLean.physicalConstant| * (Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2))
        + (Bw * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)
        + (M * Bw * (2 * a) * Real.sqrt (2 * a))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)
        + (2 * Bw * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)
        + ((∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
          * (2 * Bw * Real.sqrt (2 * a)))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
        exact add_le_add (add_le_add (add_le_add (add_le_add
          (add_le_add harch hmass) hpot) hgam) hpol) hshi
    _ = (Lw * a * Real.sqrt (2 * a)
        + |RHLean.physicalConstant| * Bw * Real.sqrt (2 * a)
        + Bw * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
        + M * Bw * (2 * a) * Real.sqrt (2 * a)
        + 2 * Bw * (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        + (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
            * (2 * Bw * Real.sqrt (2 * a)))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by ring
