def nums : Array Int :=
  (data.splitOn ",").map (fun s => (s.trim.toInt?).getD 0) |>.toArray
def getAPP (i j : Nat) : Int := nums[i * 100 + j]!
def getQ (i j : Nat) : Int := nums[10000 + i * 7 + j]!
def getF (i j : Nat) : Int := nums[10000 + 700 + i * 7 + j]!
def S : Int := 10 ^ 80
def S2 : Int := S * S
def delta : Int := 32573370082284023951097117249384078507105002
def eps : Int := 10 ^ 54
def G : Array (Array Int) := Id.run do
  let n := 100
  let mut G : Array (Array Int) := Array.replicate n (Array.replicate n 0)
  for i in [0:n] do
    for j in [0:n] do
      let mut qfq : Int := 0
      for k in [0:7] do
        for l in [0:7] do
          qfq := qfq + Int.fdiv (getQ i k * getF k l * getQ j l) S2
      let v := getAPP i j - (if i = j then delta + eps else 0) - qfq
      G := G.set! i ((G[i]!).set! j v)
  return G
def get (A : Array (Array Int)) (i j : Nat) : Int := (A[i]!)[j]!
end Y7W5AppFixed
