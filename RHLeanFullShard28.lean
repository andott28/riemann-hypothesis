theorem integral_im_eq_zero_of_forall (s : Set ℝ) (f : ℝ → ℂ)
    (h : ∀ x, (f x).im = 0) :
    ((∫ x in s, f x ∂volume).im = 0) := by
  have key : f = fun x => ((f x).re : ℂ) := funext fun x => by
    rw [← Complex.re_add_im (f x)]
    simp [h x]
  rw [key]
  simp [integral_complex_ofReal, Complex.ofReal_im]
theorem integral_re_eq_zero_of_forall (s : Set ℝ) (f : ℝ → ℂ)
    (h : ∀ x, (f x).re = 0) :
    ((∫ x in s, f x ∂volume).re = 0) := by
  have key : f = fun x => ((f x).im : ℂ) * Complex.I := funext fun x => by
    rw [← Complex.re_add_im (f x)]
    simp [h x]
  rw [key]
  simp only [integral_mul_const, integral_complex_ofReal]
  simp [Complex.mul_re, Complex.I_re, Complex.I_im, Complex.ofReal_im]
theorem polarBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.polarBilin a u v = 0 := by
  have hsph : ∀ y : ℝ, (RHLean.sph y).im = 0 := fun y => by
    simp only [RHLean.sph, Complex.ofReal_im]
  have hUim : ∀ y : ℝ, (star (RHLean.sph y) * u y).im = 0 := fun y => by
    simp only [Complex.mul_im, Y7GateIIAdd.re_star, Y7GateIIAdd.im_star, hu, hsph,
      mul_zero, zero_mul, neg_zero, zero_add]
  have hVre : ∀ y : ℝ, (star (RHLean.sph y) * v y).re = 0 := fun y => by
    simp only [Complex.mul_re, Y7GateIIAdd.re_star, Y7GateIIAdd.im_star, hv, hsph,
      mul_zero, zero_mul, neg_zero, zero_sub]
  have hpu : (RHLean.polarInner a u).im = 0 := by
    unfold RHLean.polarInner
    exact integral_im_eq_zero_of_forall _ _ hUim
  have hpv : (RHLean.polarInner a v).re = 0 := by
    unfold RHLean.polarInner
    exact integral_re_eq_zero_of_forall _ _ hVre
  unfold RHLean.GateII.Reduction.polarBilin
  simp only [mul_star_re_zero₁ _ _ hpu hpv, mul_zero]
theorem shiftBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.shiftBilin a u v = 0 := by
  unfold RHLean.GateII.Reduction.shiftBilin
  refine Finset.sum_eq_zero (fun n _ => ?_)
  have h1 : ∀ x : ℝ, (u x * star (v (x + RHLean.shiftLength n))).re = 0 :=
    fun x => mul_star_re_zero₁ _ _ (hu x) (hv _)
  have h2 : ∀ x : ℝ, (v x * star (u (x + RHLean.shiftLength n))).re = 0 :=
    fun x => mul_star_re_zero₂ _ _ (hv x) (hu _)
  have i1 : ((∫ x in Set.Ioo (-a) a, u x * star (v (x + RHLean.shiftLength n))
      ∂volume).re = 0) := integral_re_eq_zero_of_forall _ _ h1
  have i2 : ((∫ x in Set.Ioo (-a) a, v x * star (u (x + RHLean.shiftLength n))
      ∂volume).re = 0) := integral_re_eq_zero_of_forall _ _ h2
  rw [i1, i2]
  ring
end Y7GateIIAdd
