theorem l2_abs_mul_le (s : Set ℝ) (w : ℝ → ℝ) (h : ℝ → ℂ)
    (hw : MemLp w 2 (volume.restrict s))
    (hh : MemLp (fun x => ‖h x‖) 2 (volume.restrict s)) :
    (∫ x in s, |w x| * ‖h x‖)
      ≤ Real.sqrt (∫ x in s, w x ^ 2) * Real.sqrt (∫ x in s, ‖h x‖ ^ 2) := by
  have h2 := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
    (μ := volume.restrict s) (f := w) (g := fun x => ‖h x‖) (p := (2 : ℝ)) (q := (2 : ℝ))
    Real.HolderConjugate.two_two (by simpa using hw) (by simpa using hh)
  simp_rw [Real.rpow_two] at h2
  rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at h2
  calc (∫ x in s, |w x| * ‖h x‖)
      = ∫ x in s, ‖w x‖ * ‖‖h x‖‖ := by
        apply integral_congr_ae
        filter_upwards with x
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg (h x))]
    _ ≤ Real.sqrt (∫ x in s, ‖w x‖ ^ 2) * Real.sqrt (∫ x in s, ‖‖h x‖‖ ^ 2) := h2
    _ = Real.sqrt (∫ x in s, w x ^ 2) * Real.sqrt (∫ x in s, ‖h x‖ ^ 2) := by
        have e1 : (∫ x in s, ‖w x‖ ^ 2) = ∫ x in s, w x ^ 2 := by
          apply integral_congr_ae
          filter_upwards with x
          rw [pow_two, Real.norm_eq_abs, pow_two, ← abs_mul]
          have h0 : 0 ≤ w x * w x := mul_self_nonneg (w x)
          rw [abs_of_nonneg h0]
        have e2 : (∫ x in s, ‖‖h x‖‖ ^ 2) = ∫ x in s, ‖h x‖ ^ 2 := by
          apply integral_congr_ae
          filter_upwards with x
          rw [pow_two, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg (h x)), pow_two]
        rw [e1, e2]
theorem potentialForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (Bf Bg : ℝ) (ha : 0 < a)
    (hf : Continuous f) (hg : Continuous g)
    (hbf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hbg : ∀ x : ℝ, ‖g x‖ ≤ Bg) :
    |RHLean.potentialForm a f - RHLean.potentialForm a g|
      ≤ (Bf + Bg) * Real.sqrt (∫ x in Set.Ioo (-a) a, (RHLean.endpointPotential a x) ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by
  have hBf0 : 0 ≤ Bf := le_trans (norm_nonneg _) (hbf 0)
  have hBg0 : 0 ≤ Bg := le_trans (norm_nonneg _) (hbg 0)
  have hC0 : 0 ≤ Bf + Bg := by linarith
  have hwm : Measurable (fun x : ℝ => RHLean.endpointPotential a x) := by
    unfold RHLean.endpointPotential
    fun_prop
  have hint1 : IntegrableOn (fun x : ℝ => Real.log (a - x)) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith : -a ≤ a)).mp
      RHLean.ExplicitFormula.intervalIntegrable_log_sub).mono_set Set.Ioo_subset_Ioc_self
  have hint2 : IntegrableOn (fun x : ℝ => Real.log (a + x)) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith : -a ≤ a)).mp
      RHLean.ExplicitFormula.intervalIntegrable_log_add).mono_set Set.Ioo_subset_Ioc_self
  have hintW1 : IntegrableOn (fun x : ℝ => |RHLean.endpointPotential a x|)
      (Set.Ioo (-a) a) volume := by
    have hmaj : IntegrableOn
        (fun x : ℝ => (1 / 2) * (|Real.log (a - x)| + |Real.log (a + x)|))
        (Set.Ioo (-a) a) volume :=
      (hint1.abs.add hint2.abs).const_mul (1 / 2)
    refine hmaj.mono' ?_ ?_
    · exact hwm.abs.aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
      have hxa : -a < x := hx.1
      have hxb : x < a := hx.2
      have hx1 : 0 < a - x := by linarith
      have hx2 : 0 < a + x := by linarith
      rw [Real.norm_eq_abs, abs_abs, RHLean.ExplicitFormula.endpointPotential_eq,
        show a ^ 2 - x ^ 2 = (a - x) * (a + x) by ring,
        Real.log_mul (ne_of_gt hx1) (ne_of_gt hx2),
        abs_mul, abs_neg, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
      exact mul_le_mul_of_nonneg_left (abs_add_le _ _) (by norm_num)
  have hintF : IntegrableOn (fun x : ℝ => RHLean.endpointPotential a x * ‖f x‖ ^ 2)
      (Set.Ioo (-a) a) volume := by
    have hmaj : IntegrableOn (fun x : ℝ => Bf ^ 2 * |RHLean.endpointPotential a x|)
        (Set.Ioo (-a) a) volume := hintW1.const_mul (Bf ^ 2)
    refine hmaj.mono' ?_ ?_
    · have hc : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := by fun_prop
      exact (hwm.mul hc.measurable).aestronglyMeasurable
    · filter_upwards [] with x
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg (‖f x‖)),
        mul_comm (Bf ^ 2) (|RHLean.endpointPotential a x|)]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hbf x) 2)
        (abs_nonneg _)
  have hintG : IntegrableOn (fun x : ℝ => RHLean.endpointPotential a x * ‖g x‖ ^ 2)
      (Set.Ioo (-a) a) volume := by
    have hmaj : IntegrableOn (fun x : ℝ => Bg ^ 2 * |RHLean.endpointPotential a x|)
        (Set.Ioo (-a) a) volume := hintW1.const_mul (Bg ^ 2)
    refine hmaj.mono' ?_ ?_
    · have hc : Continuous (fun x : ℝ => ‖g x‖ ^ 2) := by fun_prop
      exact (hwm.mul hc.measurable).aestronglyMeasurable
    · filter_upwards [] with x
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg (‖g x‖)),
        mul_comm (Bg ^ 2) (|RHLean.endpointPotential a x|)]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hbg x) 2)
        (abs_nonneg _)
  have hintM : IntegrableOn
      (fun x : ℝ => (Bf + Bg) * (|RHLean.endpointPotential a x| * ‖f x - g x‖))
      (Set.Ioo (-a) a) volume := by
    have hmaj2 : IntegrableOn
        (fun x : ℝ => (Bf + Bg) * ((Bf + Bg) * |RHLean.endpointPotential a x|))
        (Set.Ioo (-a) a) volume := (hintW1.const_mul (Bf + Bg)).const_mul (Bf + Bg)
    refine hmaj2.mono' ?_ ?_
    · have hc : Continuous (fun x : ℝ => ‖f x - g x‖) := by fun_prop
      exact (measurable_const.mul (hwm.abs.mul hc.measurable)).aestronglyMeasurable
    · filter_upwards [] with x
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_abs, abs_of_nonneg hC0,
        abs_of_nonneg (norm_nonneg (f x - g x)),
        mul_comm (Bf + Bg) (|RHLean.endpointPotential a x|)]
      have htri : ‖f x - g x‖ ≤ Bf + Bg :=
        (norm_sub_le (f x) (g x)).trans (add_le_add (hbf x) (hbg x))
      have hinner : |RHLean.endpointPotential a x| * ‖f x - g x‖
          ≤ |RHLean.endpointPotential a x| * (Bf + Bg) :=
        mul_le_mul_of_nonneg_left htri (abs_nonneg _)
      exact mul_le_mul_of_nonneg_left hinner hC0
  have hpt : ∀ x : ℝ, |RHLean.endpointPotential a x * ‖f x‖ ^ 2
      - RHLean.endpointPotential a x * ‖g x‖ ^ 2|
      ≤ (Bf + Bg) * (|RHLean.endpointPotential a x| * ‖f x - g x‖) := by
    intro x
    rw [← mul_sub, abs_mul]
    have hsq : |‖f x‖ ^ 2 - ‖g x‖ ^ 2| ≤ ‖f x - g x‖ * (‖f x‖ + ‖g x‖) := by
      rw [sq_sub_sq, abs_mul,
        abs_of_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _)), mul_comm]
      exact mul_le_mul (abs_norm_sub_norm_le _ _) (le_refl _)
        (add_nonneg (norm_nonneg _) (norm_nonneg _)) (norm_nonneg _)
    have hbound : ‖f x‖ + ‖g x‖ ≤ Bf + Bg := add_le_add (hbf x) (hbg x)
    have hnn : 0 ≤ |RHLean.endpointPotential a x| := abs_nonneg _
    calc |RHLean.endpointPotential a x| * |‖f x‖ ^ 2 - ‖g x‖ ^ 2|
        ≤ |RHLean.endpointPotential a x| * (‖f x - g x‖ * (‖f x‖ + ‖g x‖)) :=
          mul_le_mul_of_nonneg_left hsq hnn
      _ ≤ |RHLean.endpointPotential a x| * (‖f x - g x‖ * (Bf + Bg)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hbound (norm_nonneg _)) hnn
      _ = (Bf + Bg) * (|RHLean.endpointPotential a x| * ‖f x - g x‖) := by ring
  have hintAbs : IntegrableOn
      (fun x : ℝ => |RHLean.endpointPotential a x * ‖f x‖ ^ 2
        - RHLean.endpointPotential a x * ‖g x‖ ^ 2|) (Set.Ioo (-a) a) volume := by
    refine hintM.mono' ?_ ?_
    · have hmeas1 : Measurable (fun x : ℝ => RHLean.endpointPotential a x * ‖f x‖ ^ 2) :=
        hwm.mul (by fun_prop : Continuous (fun x : ℝ => ‖f x‖ ^ 2)).measurable
      have hmeas2 : Measurable (fun x : ℝ => RHLean.endpointPotential a x * ‖g x‖ ^ 2) :=
        hwm.mul (by fun_prop : Continuous (fun x : ℝ => ‖g x‖ ^ 2)).measurable
      exact (hmeas1.sub hmeas2).abs.aestronglyMeasurable
    · filter_upwards [] with x
      rw [Real.norm_eq_abs, abs_abs]
      exact hpt x
  have hsub : RHLean.potentialForm a f - RHLean.potentialForm a g
      = ∫ x in Set.Ioo (-a) a, (RHLean.endpointPotential a x * ‖f x‖ ^ 2
          - RHLean.endpointPotential a x * ‖g x‖ ^ 2) := by
    unfold RHLean.potentialForm
    rw [integral_sub hintF hintG]
  have habs : |∫ x in Set.Ioo (-a) a, (RHLean.endpointPotential a x * ‖f x‖ ^ 2
      - RHLean.endpointPotential a x * ‖g x‖ ^ 2)|
      ≤ ∫ x in Set.Ioo (-a) a, |RHLean.endpointPotential a x * ‖f x‖ ^ 2
          - RHLean.endpointPotential a x * ‖g x‖ ^ 2| := by
    have h := norm_integral_le_integral_norm
      (μ := volume.restrict (Set.Ioo (-a) a))
      (fun x => RHLean.endpointPotential a x * ‖f x‖ ^ 2
        - RHLean.endpointPotential a x * ‖g x‖ ^ 2)
    simpa only [Real.norm_eq_abs] using h
  have hmono : ∫ x in Set.Ioo (-a) a, |RHLean.endpointPotential a x * ‖f x‖ ^ 2
      - RHLean.endpointPotential a x * ‖g x‖ ^ 2|
      ≤ ∫ x in Set.Ioo (-a) a, (Bf + Bg)
          * (|RHLean.endpointPotential a x| * ‖f x - g x‖) :=
    setIntegral_mono_ae (f := fun x => |RHLean.endpointPotential a x * ‖f x‖ ^ 2
        - RHLean.endpointPotential a x * ‖g x‖ ^ 2|)
      (g := fun x => (Bf + Bg) * (|RHLean.endpointPotential a x| * ‖f x - g x‖))
      (hf := hintAbs) (hg := hintM) (by filter_upwards [] with x; exact hpt x)
  have hfold : ∫ x in Set.Ioo (-a) a, (Bf + Bg)
      * (|RHLean.endpointPotential a x| * ‖f x - g x‖)
      = (Bf + Bg) * ∫ x in Set.Ioo (-a) a,
          |RHLean.endpointPotential a x| * ‖f x - g x‖ :=
    integral_const_mul _ _
  have hwLp : MemLp (fun x : ℝ => RHLean.endpointPotential a x) 2
      (volume.restrict (Set.Ioo (-a) a)) := by
    have hintw2 : Integrable (fun x : ℝ => (RHLean.endpointPotential a x) ^ 2)
        (volume.restrict (Set.Ioo (-a) a)) :=
      (endpointPotential_sq_integrable a ha).integrable
    exact (memLp_two_iff_integrable_sq hwm.aestronglyMeasurable).mpr hintw2
  have hLp2 : MemLp (fun x : ℝ => ‖f x - g x‖) 2
      (volume.restrict (Set.Ioo (-a) a)) := by
    have hc : Continuous (fun x : ℝ => ‖f x - g x‖ ^ 2) := by fun_prop
    have hint : IntegrableOn (fun x : ℝ => ‖f x - g x‖ ^ 2)
        (Set.Ioo (-a) a) volume :=
      hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hintI : Integrable (fun x : ℝ => ‖f x - g x‖ ^ 2)
        (volume.restrict (Set.Ioo (-a) a)) := hint.integrable
    have hmeas : AEStronglyMeasurable (fun x : ℝ => ‖f x - g x‖)
        (volume.restrict (Set.Ioo (-a) a)) := by
      have hc2 : Continuous (fun x : ℝ => ‖f x - g x‖) := by fun_prop
      exact hc2.measurable.aestronglyMeasurable
    exact (memLp_two_iff_integrable_sq hmeas).mpr hintI
  have hcs := l2_abs_mul_le (Set.Ioo (-a) a)
    (fun x => RHLean.endpointPotential a x) (fun x => f x - g x) hwLp hLp2
  calc |RHLean.potentialForm a f - RHLean.potentialForm a g|
      = |∫ x in Set.Ioo (-a) a, (RHLean.endpointPotential a x * ‖f x‖ ^ 2
          - RHLean.endpointPotential a x * ‖g x‖ ^ 2)| := by rw [hsub]
    _ ≤ (Bf + Bg) * ∫ x in Set.Ioo (-a) a,
          |RHLean.endpointPotential a x| * ‖f x - g x‖ :=
          habs.trans (hmono.trans_eq hfold)
    _ ≤ (Bf + Bg) * (Real.sqrt (∫ x in Set.Ioo (-a) a,
          (RHLean.endpointPotential a x) ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) :=
          mul_le_mul_of_nonneg_left hcs hC0
    _ = (Bf + Bg) * Real.sqrt (∫ x in Set.Ioo (-a) a,
          (RHLean.endpointPotential a x) ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by ring
end Y7GateIIAdd
