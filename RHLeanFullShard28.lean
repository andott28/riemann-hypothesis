    obtain ⟨Neps, hNeps⟩ := Metric.tendsto_atTop.1 hlim (δ / 2) hhalf
    refine ⟨Neps, fun n hn => ?_⟩
    have hpos : 0 < 1 / ((n : ℝ) + 1) := by positivity
    have := hNeps n hn
    rwa [Real.dist_eq, sub_zero, abs_of_pos hpos] at this
  refine ⟨max Nfin Neps, fun n hn => ?_⟩
  have hnfin : n ≥ Nfin := le_trans (le_max_left _ _) hn
  have hneps : n ≥ Neps := le_trans (le_max_right _ _) hn
  have htri : dist (∫ y in (-(T n))..(T n),
        bridgeLine f y * LSeries vonMangoldtComplex (bridgeSpectralArgument (ε n) y))
      ((primeSideComb f a : ℝ) : ℂ)
