      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖ * (f₂ p.1 * star (g p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam₂₁ : MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖ * (g p.1 * star (f₁ p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam₂₂ : MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖ * (g p.1 * star (f₂ p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)) :
    RHLean.GateII.Reduction.localizedBilin a (f₁ + f₂) g
      = RHLean.GateII.Reduction.localizedBilin a f₁ g
        + RHLean.GateII.Reduction.localizedBilin a f₂ g := by
  unfold RHLean.GateII.Reduction.localizedBilin
  rw [Y7GateIIAdd.massBilin_add_left a f₁ f₂ g hmass₁ hmass₂,
    Y7GateIIAdd.potentialBilin_add_left a f₁ f₂ g hpot₁ hpot₂,
    Y7GateIIAdd.polarBilin_add_left a f₁ f₂ g hpolar₁ hpolar₂,
    Y7GateIIAdd.shiftBilin_add_left a f₁ f₂ g hshift₁₁ hshift₁₂ hshift₂₁ hshift₂₂,
    archBilin_add_left_prod (a := a) f₁ f₂ g harch₁ harch₂,
    gammaBilin_add_left_prod (a := a) f₁ f₂ g hgam₁₁ hgam₁₂ hgam₂₁ hgam₂₂]
  ring
theorem localizedBilinFinsetSumLeft {ι : Type*} [DecidableEq ι] {a : ℝ}
    (s : Finset ι) (c : ι → ℝ) (φ : ι → ℝ → ℂ) (g : ℝ → ℂ)
    (hmass : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun t => (φ i t * star (g t)).re) (Set.Ioo (-a) a) MeasureTheory.volume)
    (hpot : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun t => RHLean.endpointPotential a t * (φ i t * star (g t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hpolar : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun t => star (RHLean.sph t) * φ i t) (Set.Ioo (-a) a) MeasureTheory.volume)
    (hshift1 : ∀ i ∈ s, ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
      (fun t => φ i t * star (g (t + RHLean.shiftLength n)))
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hshift2 : ∀ i ∈ s, ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
      (fun t => g t * star (φ i (t + RHLean.shiftLength n)))
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (harch : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (RHLean.GateII.Reduction.archBilinKernel (φ i) g)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam1 : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ =>
        RHLean.gammaKernel ‖p.1 - p.2‖ * (φ i p.1 * star (g p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam2 : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ =>
        RHLean.gammaKernel ‖p.1 - p.2‖ * (g p.1 * star (φ i p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)) :
    RHLean.GateII.Reduction.localizedBilin a
        (Finset.sum s (fun i => c i • φ i)) g
      = Finset.sum s (fun i => c i * RHLean.GateII.Reduction.localizedBilin a (φ i) g) := by
  classical
  revert hmass hpot hpolar hshift1 hshift2 harch hgam1 hgam2
  induction s using Finset.induction_on with
  | empty =>
      intro hmass hpot hpolar hshift1 hshift2 harch hgam1 hgam2
      simp only [Finset.sum_empty]
      exact localizedBilin_zero_left a g
  | insert i s hi ih =>
      intro hmass hpot hpolar hshift1 hshift2 harch hgam1 hgam2
      have ihs := ih (fun k hk => hmass k (Finset.mem_insert_of_mem hk))
        (fun k hk => hpot k (Finset.mem_insert_of_mem hk))
        (fun k hk => hpolar k (Finset.mem_insert_of_mem hk))
        (fun k hk n hn => hshift1 k (Finset.mem_insert_of_mem hk) n hn)
        (fun k hk n hn => hshift2 k (Finset.mem_insert_of_mem hk) n hn)
        (fun k hk => harch k (Finset.mem_insert_of_mem hk))
        (fun k hk => hgam1 k (Finset.mem_insert_of_mem hk))
        (fun k hk => hgam2 k (Finset.mem_insert_of_mem hk))
      have hsumins : Finset.sum (insert i s) (fun k => c k • φ k)
          = (c i • φ i) + Finset.sum s (fun k => c k • φ k) := by
        rw [Finset.sum_insert hi]
      have hmassp : MeasureTheory.IntegrableOn
          (fun t => ((c i • φ i) t * star (g t)).re)
          (Set.Ioo (-a) a) MeasureTheory.volume := by
        have hbase := (hmass i (Finset.mem_insert_self i s)).const_mul (c i)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun t => by
          show c i * (φ i t * star (g t)).re
              = ((c i • φ i) t * star (g t)).re
          rw [smul_mass_integrand]))
      have hmasssum : MeasureTheory.IntegrableOn
          (fun t => ((Finset.sum s (fun k => c k • φ k)) t * star (g t)).re)
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        integrable_mass_sum s c φ g
          (fun k hk => hmass k (Finset.mem_insert_of_mem hk))
      have hpotp : MeasureTheory.IntegrableOn
          (fun t => RHLean.endpointPotential a t * ((c i • φ i) t * star (g t)).re)
          (Set.Ioo (-a) a) MeasureTheory.volume := by
        have hbase := (hpot i (Finset.mem_insert_self i s)).const_mul (c i)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun t => by
          show c i * (RHLean.endpointPotential a t * (φ i t * star (g t)).re)
              = RHLean.endpointPotential a t * ((c i • φ i) t * star (g t)).re
          rw [smul_mass_integrand]
          ring))
      have hpotsum : MeasureTheory.IntegrableOn
          (fun t => RHLean.endpointPotential a t
            * ((Finset.sum s (fun k => c k • φ k)) t * star (g t)).re)
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        integrable_pot_sum s c φ g
          (fun k hk => hpot k (Finset.mem_insert_of_mem hk))
      have hpolp : MeasureTheory.IntegrableOn
          (fun t => star (RHLean.sph t) * (c i • φ i) t)
          (Set.Ioo (-a) a) MeasureTheory.volume := by
        have hbase := (hpolar i (Finset.mem_insert_self i s)).const_mul
          ((c i : ℝ) : ℂ)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun t => by
          show ((c i : ℝ) : ℂ) * (star (RHLean.sph t) * φ i t)
              = star (RHLean.sph t) * (c i • φ i) t
          rw [Pi.smul_apply, smul_eq_ofReal_mul]
          ring))
      have hpolsum : MeasureTheory.IntegrableOn
          (fun t => star (RHLean.sph t) * (Finset.sum s (fun k => c k • φ k)) t)
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        integrable_polar_sum s c φ
          (fun k hk => hpolar k (Finset.mem_insert_of_mem hk))
      have hsh1p : ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
          (fun t => (c i • φ i) t * star (g (t + RHLean.shiftLength n)))
          (Set.Ioo (-a) a) MeasureTheory.volume := by
        intro n hn
        have hbase := (hshift1 i (Finset.mem_insert_self i s) n hn).const_mul
          ((c i : ℝ) : ℂ)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun t => by
          show ((c i : ℝ) : ℂ) * (φ i t * star (g (t + RHLean.shiftLength n)))
              = (c i • φ i) t * star (g (t + RHLean.shiftLength n))
          rw [Pi.smul_apply, smul_eq_ofReal_mul]
          ring))
      have hsh1sum : ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
          (fun t => (Finset.sum s (fun k => c k • φ k)) t
            * star (g (t + RHLean.shiftLength n)))
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        fun n hn => integrable_cmass_sum s c φ
          (fun u => g (u + RHLean.shiftLength n))
          (fun k hk => hshift1 k (Finset.mem_insert_of_mem hk) n hn)
      have hsh2p : ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
          (fun t => g t * star ((c i • φ i) (t + RHLean.shiftLength n)))
          (Set.Ioo (-a) a) MeasureTheory.volume := by
        intro n hn
        have hbase := (hshift2 i (Finset.mem_insert_self i s) n hn).const_mul
          ((c i : ℝ) : ℂ)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun t => by
          show ((c i : ℝ) : ℂ) * (g t * star (φ i (t + RHLean.shiftLength n)))
              = g t * star ((c i • φ i) (t + RHLean.shiftLength n))
          rw [Pi.smul_apply, star_smul]
          ring))
      have hsh2sum : ∀ n ∈ RHLean.arithSupport a, MeasureTheory.IntegrableOn
          (fun t => g t * star ((Finset.sum s (fun k => c k • φ k))
            (t + RHLean.shiftLength n)))
          (Set.Ioo (-a) a) MeasureTheory.volume :=
        fun n hn => integrable_cshift2_sum s c φ g n
          (fun k hk => hshift2 k (Finset.mem_insert_of_mem hk) n hn)
      have harchp : MeasureTheory.IntegrableOn
          (RHLean.GateII.Reduction.archBilinKernel (c i • φ i) g)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) := by
        have hbase := (harch i (Finset.mem_insert_self i s)).const_mul (c i)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun p => by
          show c i * RHLean.GateII.Reduction.archBilinKernel (φ i) g p
            = RHLean.GateII.Reduction.archBilinKernel (c i • φ i) g p
          rw [smul_arch_integrand]))
      have harchsum : MeasureTheory.IntegrableOn
          (RHLean.GateII.Reduction.archBilinKernel
            (Finset.sum s (fun k => c k • φ k)) g)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) :=
        integrable_arch_sum s c φ g
          (fun k hk => harch k (Finset.mem_insert_of_mem hk))
      have hgam1p : MeasureTheory.IntegrableOn
          (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
            * ((c i • φ i) p.1 * star (g p.2)).re)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) := by
        have hbase := (hgam1 i (Finset.mem_insert_self i s)).const_mul (c i)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun p => by
          show c i
              * (RHLean.gammaKernel ‖p.1 - p.2‖ * (φ i p.1 * star (g p.2)).re)
            = RHLean.gammaKernel ‖p.1 - p.2‖
              * ((c i • φ i) p.1 * star (g p.2)).re
          rw [smul_mass_integrand]
          ring))
      have hgam1sum : MeasureTheory.IntegrableOn
          (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
            * ((Finset.sum s (fun k => c k • φ k)) p.1 * star (g p.2)).re)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) :=
        integrable_gamma1_sum s c φ g
          (fun k hk => hgam1 k (Finset.mem_insert_of_mem hk))
      have hgam2p : MeasureTheory.IntegrableOn
          (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
            * (g p.1 * star ((c i • φ i) p.2)).re)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) := by
        have hbase := (hgam2 i (Finset.mem_insert_self i s)).const_mul (c i)
        exact hbase.congr (MeasureTheory.ae_of_all _ (fun p => by
          show c i
              * (RHLean.gammaKernel ‖p.1 - p.2‖ * (g p.1 * star (φ i p.2)).re)
            = RHLean.gammaKernel ‖p.1 - p.2‖
              * (g p.1 * star ((c i • φ i) p.2)).re
          rw [Pi.smul_apply, star_smul,
            show g p.1 * (((c i : ℝ) : ℂ) * star (φ i p.2))
              = ((c i : ℝ) : ℂ) * (g p.1 * star (φ i p.2)) from by ring,
            Y7GateIIAdd.re_cmul]
          ring))
      have hgam2sum : MeasureTheory.IntegrableOn
          (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
            * (g p.1 * star ((Finset.sum s (fun k => c k • φ k)) p.2)).re)
          (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
          (MeasureTheory.volume.prod MeasureTheory.volume) :=
        integrable_gamma2_sum s c φ g
          (fun k hk => hgam2 k (Finset.mem_insert_of_mem hk))
      rw [hsumins]
      rw [localizedBilin_add_left_prod (c i • φ i)
          (Finset.sum s (fun k => c k • φ k)) g
          hmassp hmasssum hpotp hpotsum hpolp hpolsum
          hsh1p hsh1sum hsh2p hsh2sum harchp harchsum
          hgam1p hgam1sum hgam2p hgam2sum]
      rw [Y7GateIIAdd.localizedBilin_smul_left a (c i) (φ i) g, ihs,
        Finset.sum_insert hi]
