    have hLint : MeasureTheory.IntegrableOn
        (fun x => ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2)
        (Set.Ioo (-a) a) MeasureTheory.volume := by
      have hmeas : MeasureTheory.AEStronglyMeasurable
          (fun x => ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2)
          (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
        have hur : Measurable (fun x => ((ur x : ℝ) : ℂ)) := by
          have hdiff : Differentiable ℝ ur := fun t => (hud t).differentiableAt
          have hduc' : Continuous ur := hdiff.continuous
          have hcoeur : Continuous (Complex.ofReal ∘ ur) :=
            Complex.continuous_ofReal.comp hduc'
          exact hcoeur.measurable
        have hd : Measurable (fun x => g x - ((ur x : ℝ) : ℂ)) :=
          hmeas_g.sub hur
        have hfull : Measurable
            (fun x => ‖g x - ((ur x : ℝ) : ℂ)‖ * ‖g x - ((ur x : ℝ) : ℂ)‖) :=
          hd.norm.mul hd.norm
        have heq : (fun x => ‖g x - ((ur x : ℝ) : ℂ)‖ * ‖g x - ((ur x : ℝ) : ℂ)‖)
