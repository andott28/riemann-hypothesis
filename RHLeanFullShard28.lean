    refine MeasureTheory.IntegrableOn.of_bound hfin hA1m
        (M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖)) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
