def BlocksPSD (a : ℝ) : Prop :=
  ∀ (s : Finset ℕ), (∀ m ∈ s, Odd m) →
    (Matrix.of (fun i j : s => Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ))).PosSemidef
theorem sum_subtype_eq (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ) :
    (∑ i : s, ∑ j : s,
        x (i : ℕ) * x (j : ℕ) * Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ))
      = ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM a m n := by
  rw [Finset.sum_coe_sort s
    (fun m => ∑ j : s, x m * x (j : ℕ) * Y7Op.rescaledOperatorM a m (j : ℕ))]
  refine Finset.sum_congr rfl ?_
  intro m _
  exact Finset.sum_coe_sort s (fun n => x m * x n * Y7Op.rescaledOperatorM a m n)
theorem matrixBlocksPos_of_blocksPSD {a : ℝ} (h : BlocksPSD a) :
    Y7Density.MatrixBlocksPos a := by
  intro s x hs
  have hnn : 0 ≤ ∑ i : s, ∑ j : s,
      x (i : ℕ) * x (j : ℕ) * Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ) := by
    have h1 := Y7A3.posSemidef_finset_quadform_nonneg
      (Matrix.of (fun i j : s => Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ)))
      (h s hs) (Finset.univ : Finset s) (fun i : s => x (i : ℕ))
    simpa only [Matrix.of_apply, Finset.mem_univ] using h1
  rw [sum_subtype_eq a s x] at hnn
  exact hnn
theorem localPSD_of_blocksPSD {a : ℝ} (ha : 0 < a) (h : BlocksPSD a) :
    RHLean.LocalPSD a :=
  localPSD_of_matrixBlocksPos ha (matrixBlocksPos_of_blocksPSD h)
theorem matrixBlocksPos_single {a : ℝ} (h : Y7Density.MatrixBlocksPos a)
    {m : ℕ} (hm : Odd m) :
    0 ≤ Y7Op.rescaledOperatorM a m m := by
  have h1 : 0 ≤ ∑ k ∈ ({m} : Finset ℕ), ∑ l ∈ ({m} : Finset ℕ),
      (1 : ℝ) * 1 * Y7Op.rescaledOperatorM a k l :=
    h {m} (fun _ => 1) (by
      intro k hk
      rw [Finset.mem_singleton] at hk
      exact hk ▸ hm)
  simpa using h1
theorem polarMatrix_diag (a : ℝ) (n : ℕ) :
    Y7Op.polarMatrix a n n = 2 * a * ‖Y7Matrix.polarMoment a n‖ ^ 2 := by
  have hleg : Y7Op.legSum (fun _ => (1 : ℝ)) {n} = Y7Matrix.phiC n := by
    funext y
    simp [Y7Op.legSum]
  have h := Y7Op.polarFormRescaled_legSum (a := a) (s := {n}) (x := fun _ => (1 : ℝ))
  rw [hleg, Y7Matrix.polarFormRescaled_phiC] at h
  simpa using h.symm
theorem polarMatrix_one_one (a : ℝ) :
    Y7Op.polarMatrix a 1 1 = 2 * a * ‖Y7Matrix.polarMoment a 1‖ ^ 2 :=
  polarMatrix_diag a 1
def BaseBlocks : Prop := Y7Density.MatrixBlocksPos (RHLean.endpoint 7)
