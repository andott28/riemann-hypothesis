    0 ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM (RHLean.endpoint 7) m n := by
  refine Y7A2.rescaledOperatorM_block_nonneg_of_tail (j := 100) ?_ s x hs ?_
  · have h := Y7Chain.tailFloor_ge_100_gt 0 (by norm_num) (le_refl 100)
    linarith
  · intro m hm
    have := hs' m hm
    omega
theorem diagonal_nonneg_of_ge_201 {k : ℕ} (hk : Odd k) (h201 : 201 ≤ k) :
    0 ≤ Y7Op.rescaledOperatorM (RHLean.endpoint 7) k k := by
  have h := tail_block_nonneg ({k} : Finset ℕ) (fun n => if n = k then (1 : ℝ) else 0)
    (by
      intro m hm
      rw [Finset.mem_singleton] at hm
      subst hm
      exact hk)
    (by
      intro m hm
      rw [Finset.mem_singleton] at hm
      subst hm
      exact h201)
  simpa using h
