      ((p.eval ((2 * x - (a + b)) / (b - a)) : ℝ) : ℂ)
      = ∑ k ∈ Finset.range (p.natDegree + 1),
          (((c k * (Y7Legendre.legP k).eval ((2 * x - (a + b)) / (b - a))) : ℝ) : ℂ) := by
    intro x
