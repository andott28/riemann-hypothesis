      + dist (∑ q ∈ arithSupport a, primeSideTerm f (ε n) q)
        ((primeSideComb f a : ℝ) : ℂ) :=
    dist_triangle _ _ _
  linarith [hclose n, hNfin n hnfin, hNeps n hneps, htri]
