private theorem massBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (Bw Bh : ℝ)
    (ha : 0 < a)
    (hwm : Measurable w) (hhm : Measurable h)
    (hwB : ∀ x : ℝ, ‖w x‖ ≤ Bw) (hhB : ∀ x : ℝ, ‖h x‖ ≤ Bh)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.massBilin a w h|
      ≤ Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hintSq : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hintNorm : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    integrableOn_norm_of_sq hhm hintSq hfin
  have hintDom : MeasureTheory.IntegrableOn
      (fun x : ℝ => Bw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
    hintNorm.const_mul Bw
  have hmeasI : MeasureTheory.AEStronglyMeasurable
      (fun x : ℝ => (w x * star (h x)).re)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    (Complex.continuous_re.measurable.comp
      (hwm.mul (continuous_star.measurable.comp hhm))).aestronglyMeasurable
  have hintI : MeasureTheory.IntegrableOn
      (fun x : ℝ => (w x * star (h x)).re) (Set.Ioo (-a) a)
      MeasureTheory.volume := by
    refine MeasureTheory.IntegrableOn.of_bound hfin hmeasI (Bw * Bh) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
    calc ‖(w x * star (h x)).re‖
        = |(w x * star (h x)).re| := Real.norm_eq_abs _
      _ ≤ ‖w x * star (h x)‖ := Complex.abs_re_le_norm _
      _ = ‖w x‖ * ‖h x‖ := by rw [norm_mul, norm_star]
      _ ≤ Bw * Bh := mul_le_mul (hwB x) (hhB x) (norm_nonneg _)
          (le_trans (norm_nonneg _) (hwB 0))
  have hH2 := l1_Ioo_le_fat a h ha hhm hhint
  rw [show RHLean.GateII.Reduction.massBilin a w h
      = ∫ x in Set.Ioo (-a) a, (w x * star (h x)).re from rfl]
  have habsI : |∫ x in Set.Ioo (-a) a, (w x * star (h x)).re|
      ≤ ∫ x in Set.Ioo (-a) a, |(w x * star (h x)).re| := by
    have h1 : ‖∫ x in Set.Ioo (-a) a, (w x * star (h x)).re‖
        ≤ ∫ x in Set.Ioo (-a) a, ‖(w x * star (h x)).re‖ :=
      MeasureTheory.norm_integral_le_integral_norm
        (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
    simpa [Real.norm_eq_abs] using h1
  have hmono : ∫ x in Set.Ioo (-a) a, |(w x * star (h x)).re|
      ≤ ∫ x in Set.Ioo (-a) a, Bw * ‖h x‖ :=
    MeasureTheory.setIntegral_mono_ae_restrict
      (f := fun x : ℝ => |(w x * star (h x)).re|)
      (g := fun x : ℝ => Bw * ‖h x‖)
      (hf := hintI.abs) (hg := hintDom)
      (by filter_upwards [] with x
          calc |(w x * star (h x)).re|
              ≤ ‖w x * star (h x)‖ := Complex.abs_re_le_norm _
            _ = ‖w x‖ * ‖h x‖ := by rw [norm_mul, norm_star]
            _ ≤ Bw * ‖h x‖ :=
                mul_le_mul_of_nonneg_right (hwB x) (norm_nonneg _))
  calc |∫ x in Set.Ioo (-a) a, (w x * star (h x)).re|
      ≤ ∫ x in Set.Ioo (-a) a, |(w x * star (h x)).re| := habsI
    _ ≤ ∫ x in Set.Ioo (-a) a, Bw * ‖h x‖ := hmono
    _ = Bw * ∫ x in Set.Ioo (-a) a, ‖h x‖ := integral_const_mul _ _
    _ = (∫ x in Set.Ioo (-a) a, ‖h x‖) * Bw := by ring
    _ ≤ (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)) * Bw :=
        mul_le_mul_of_nonneg_right hH2
          (le_trans (norm_nonneg _) (hwB 0))
    _ = Bw * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by ring
