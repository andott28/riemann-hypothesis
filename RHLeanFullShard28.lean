    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hintVsq := Y7GateIIAdd.endpointPotential_sq_integrable a ha
