        rw [Real.norm_eq_abs,
          abs_of_nonneg (sq_nonneg ‖g x - ((ur x : ℝ) : ℂ)‖)]
        calc ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2
            = ‖g x - ((ur x : ℝ) : ℂ)‖ * ‖g x - ((ur x : ℝ) : ℂ)‖ := by ring
          _ ≤ (2 * Bu + 2 * a * η) * ‖g x - ((ur x : ℝ) : ℂ)‖ :=
              mul_le_mul_of_nonneg_right hle hn0
          _ ≤ (2 * Bu + 2 * a * η) * (2 * Bu + 2 * a * η) :=
              mul_le_mul_of_nonneg_left hle hC
          _ = (2 * Bu + 2 * a * η) ^ 2 := by ring
    have hRint : MeasureTheory.IntegrableOn
        (fun _ : ℝ => (2 * a * η) ^ 2)
        (Set.Ioo (-a) a) MeasureTheory.volume := by
      refine MeasureTheory.IntegrableOn.of_bound ?_ ?_ ((2 * a * η) ^ 2) ?_
      · rw [Real.volume_Ioo]
        exact ENNReal.ofReal_lt_top
      · exact MeasureTheory.aestronglyMeasurable_const
      · filter_upwards [] with x
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg (2 * a * η))]
    have hae : (fun x : ℝ => ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2)
        ≤ᵐ[MeasureTheory.volume.restrict (Set.Ioo (-a) a)]
        (fun _ : ℝ => (2 * a * η) ^ 2) := by
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        hae0 a₀, hae0 (-a₀)] with x hxW hxa hxma
      rw [hptw x hxW hxa hxma,
        show ((P.eval x : ℝ) : ℂ) - ((ur x : ℝ) : ℂ)
