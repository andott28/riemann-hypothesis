    calc ∫ x in Set.Ioo (-a) a, ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2
        ≤ ∫ x in Set.Ioo (-a) a, (2 * a * η) ^ 2 :=
          setIntegral_mono_ae_restrict hLint hRint hae
