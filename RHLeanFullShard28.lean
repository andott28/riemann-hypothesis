      _ ≤ |RHLean.endpointPotential a x| * (Bw * ‖h x‖) := by
          refine mul_le_mul (le_refl _) ?_
            (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (abs_nonneg _)
