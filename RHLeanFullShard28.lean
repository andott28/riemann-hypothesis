theorem integrableOn_bound_Ioo (a : ℝ) (f : ℝ → ℝ) (C : ℝ)
    (hc : Continuous f) (hb : ∀ x ∈ Set.Ioo (-a) a, ‖f x‖ ≤ C) :
    IntegrableOn f (Set.Ioo (-a) a) volume := by
  refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ C ?_
  · exact (Continuous.measurable hc).aestronglyMeasurable
  · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
    exact hb x hx
theorem admissible_mass_field (a : ℝ) (h g : ℝ → ℂ) (B : ℝ)
    (ch : Continuous h) (cg : Continuous g)
    (bh : ∀ x ∈ Set.Ioo (-a) a, ‖h x‖ ≤ B)
    (bg : ∀ x ∈ Set.Ioo (-a) a, ‖g x‖ ≤ B) :
    IntegrableOn (fun x => (h x * star (g x)).re) (Set.Ioo (-a) a) volume := by
  apply integrableOn_bound_Ioo a _ (B * B)
  · continuity
  · intro x hx
    calc ‖(h x * star (g x)).re‖
        ≤ ‖h x * star (g x)‖ := Complex.abs_re_le_norm _
      _ = ‖h x‖ * ‖star (g x)‖ := (norm_mul ..)
      _ = ‖h x‖ * ‖g x‖ := by rw [norm_star]
      _ ≤ B * B := by
        nlinarith [bh x hx, bg x hx, norm_nonneg (h x), norm_nonneg (g x)]
end Y7GateIIAdd
