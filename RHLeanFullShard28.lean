    truncBasisSmooth a b N (Sum.inl i) = oldBasisCut a (2 * (i : ℕ) + 1) := rfl
@[simp] theorem truncBasisSmooth_inr (a b : ℝ) (N : ℕ) (i : Fin N) :
    truncBasisSmooth a b N (Sum.inr i) = collarOdd a b (2 * (i : ℕ) + 1) := rfl
theorem truncOldBasisSmooth_mem_localizedCore {a : ℝ} (ha : 0 < a) (N : ℕ)
    (i : Fin N) :
    truncOldBasisSmooth a N i ∈ RHLean.localizedCore a :=
  oldBasisCut_mem_localizedCore ha (n := 2 * (i : ℕ) + 1) ⟨i, rfl⟩
theorem cutChart_eq_zero_of_notMem {lo hi x : ℝ} (hlo : lo < hi)
    (hx : x ∉ Set.Ioo lo hi) : cutChart lo hi x = 0 := by
  have hd : 0 < hi - lo := by linarith
  have hchart : chart lo hi x ≤ -1 ∨ 1 ≤ chart lo hi x := by
    rw [Set.mem_Ioo, not_and_or] at hx
    rcases hx with hx | hx
    · left
      have hxle : x ≤ lo := le_of_not_gt hx
      unfold chart
      rw [div_le_iff₀ hd]
      linarith
    · right
      have hxge : hi ≤ x := le_of_not_gt hx
      unfold chart
      rw [le_div_iff₀ hd]
      linarith
  unfold cutChart
  apply Real.smoothTransition.zero_of_nonpos
  rcases hchart with hc | hc
  · have h1 : (1 : ℝ) ≤ -chart lo hi x := by linarith
    have hsq : (1 : ℝ) ≤ (-chart lo hi x) ^ 2 := by
      nlinarith [sq_nonneg (-chart lo hi x - 1)]
    nlinarith
  · have hsq : (1 : ℝ) ≤ (chart lo hi x) ^ 2 := by
      nlinarith [sq_nonneg (chart lo hi x - 1)]
    nlinarith
theorem chart_reflect {a b x : ℝ} (_hab : a < b) :
    chart (-b) (-a) x = - chart a b (-x) := by
  unfold chart
  field_simp
  ring
theorem cutChart_reflect {a b x : ℝ} (hab : a < b) :
    cutChart (-b) (-a) x = cutChart a b (-x) := by
  unfold cutChart
  rw [chart_reflect hab, neg_sq]
theorem collarOdd_left_eq_right {a b : ℝ} (hab : a < b) {n : ℕ} (hn : Odd n) :
    collarOdd (-b) (-a) n = collarOdd a b n := by
  funext x
  unfold collarOdd
  rw [cutChart_reflect hab (x := x), cutChart_reflect hab (x := -x),
    chart_reflect hab (x := x), chart_reflect hab (x := -x)]
  simp only [neg_neg]
  rw [phiC_neg n (chart a b (-x)), phiC_neg n (chart a b x)]
  have hsign : ((((-1 : ℝ) ^ n : ℝ)) : ℂ) = -1 := by
    obtain ⟨k, rfl⟩ := hn
    push_cast
    rw [pow_succ, pow_mul]
    norm_num
  rw [hsign]
  ring
theorem truncCollarBasisSmooth_left_eq_right (a b : ℝ) (hab : a < b) (N : ℕ)
    (i : Fin N) :
    collarOdd (-b) (-a) (2 * (i : ℕ) + 1) = collarOdd a b (2 * (i : ℕ) + 1) :=
  collarOdd_left_eq_right hab ⟨i, rfl⟩
theorem collarOdd_support {a b : ℝ} (ha : 0 < a) (hab : a < b) (n : ℕ) :
    Function.support (collarOdd a b n) ⊆ {x : ℝ | a < |x| ∧ |x| < b} := by
  intro x hx
  have hx' : collarOdd a b n x ≠ 0 := hx
  unfold collarOdd at hx'
  have h1 : cutChart a b x ≠ 0 ∨ cutChart a b (-x) ≠ 0 := by
    by_contra h
    push Not at h
    exact hx' (by simp [h.1, h.2])
  rcases h1 with h1 | h1
  · have hmem : x ∈ Set.Ioo a b := by
      by_contra hxnot
      exact h1 (cutChart_eq_zero_of_notMem hab hxnot)
    change a < |x| ∧ |x| < b
    rw [abs_of_pos (by linarith [hmem.1])]
    exact hmem
  · have hmem : -x ∈ Set.Ioo a b := by
      by_contra hxnot
      exact h1 (cutChart_eq_zero_of_notMem hab hxnot)
    have hxneg : x < 0 := by linarith [hmem.1]
    change a < |x| ∧ |x| < b
    rw [abs_of_neg hxneg]
    constructor <;> linarith [hmem.1, hmem.2]
theorem truncCollarBasisSmooth_mem_localizedCore {a b : ℝ} (ha : 0 < a)
    (hab : a < b) (N : ℕ) (i : Fin N) :
    truncCollarBasisSmooth a b N i ∈ RHLean.localizedCore b := by
  refine mem_localizedCore_of (collarOdd_contDiff a b _)
    ?_ (collarOdd_neg a b _)
  intro x hx
  have h := collarOdd_support ha hab (2 * (i : ℕ) + 1) hx
  constructor
  · have := neg_abs_le x; linarith [h.2]
  · have := le_abs_self x; linarith [h.2]
theorem truncBasisSmooth_mem_localizedCore {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (N : ℕ) (i : Fin N ⊕ Fin N) :
    truncBasisSmooth a b N i ∈ RHLean.localizedCore b := by
  rcases i with i | i
  · exact mem_localizedCore_of (oldBasisCut_contDiff a _)
      (fun x hx => by
        have h := oldBasisCut_support ha _ hx
        exact ⟨by linarith [h.1], by linarith [h.2]⟩)
      (oldBasisCut_odd ⟨i, rfl⟩)
  · exact truncCollarBasisSmooth_mem_localizedCore ha hab N i
theorem twoSidedCollar_not_linearIndependent {a b : ℝ} (hab : a < b) {N : ℕ}
    (hN : 0 < N) :
    ¬ LinearIndependent ℝ (fun i : Fin N ⊕ Fin N =>
      match i with
      | Sum.inl j => collarOdd a b (2 * (j : ℕ) + 1)
      | Sum.inr j => collarOdd (-b) (-a) (2 * (j : ℕ) + 1)) := by
  intro hlin
  let j0 : Fin N := ⟨0, hN⟩
  have heq : collarOdd a b (2 * (j0 : ℕ) + 1)
      = collarOdd (-b) (-a) (2 * (j0 : ℕ) + 1) :=
    (collarOdd_left_eq_right hab ⟨j0, rfl⟩).symm
  have hsame : (Sum.inl j0 : Fin N ⊕ Fin N) = Sum.inr j0 :=
    hlin.injective heq
  exact Sum.inl_ne_inr hsame
theorem gramMatrix_truncBasisSmooth_eq_oldNewBlock (a b : ℝ) (N : ℕ) :
    gramMatrix b (truncBasisSmooth a b N)
      = oldNewBlock
          (oldOldBlock b (truncOldBasisSmooth a N))
          (oldCollarBlock b (truncOldBasisSmooth a N) (truncCollarBasisSmooth a b N))
          (collarCollarBlock b (truncCollarBasisSmooth a b N)) :=
  gramMatrix_sum_eq_oldNewBlock b (truncOldBasisSmooth a N)
    (truncCollarBasisSmooth a b N)
theorem disjoint_support_oldBasisCut_collarOdd {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (m n : ℕ) :
    Disjoint (Function.support (oldBasisCut a m))
      (Function.support (collarOdd a b n)) := by
  rw [Set.disjoint_left]
  intro x hx1 hx2
  have h1 := oldBasisCut_support ha m hx1
  have h2 := collarOdd_support ha hab n hx2
  have hxabs : |x| < a := abs_lt.mpr h1
  linarith [h2.1]
theorem massBilin_smooth_cross_eq_zero {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (m n : ℕ) :
    massBilin b (oldBasisCut a m) (collarOdd a b n) = 0 :=
  massBilin_eq_zero_of_disjoint_support
    (disjoint_support_oldBasisCut_collarOdd ha hab m n)
theorem potentialBilin_smooth_cross_eq_zero {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (m n : ℕ) :
    potentialBilin b (oldBasisCut a m) (collarOdd a b n) = 0 :=
  potentialBilin_eq_zero_of_disjoint_support
    (disjoint_support_oldBasisCut_collarOdd ha hab m n)
theorem localizedBilin_smooth_cross_eq {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (m n : ℕ) :
    localizedBilin b (oldBasisCut a m) (collarOdd a b n)
      = archBilin b (oldBasisCut a m) (collarOdd a b n)
        - gammaBilin b (oldBasisCut a m) (collarOdd a b n)
        - polarBilin b (oldBasisCut a m) (collarOdd a b n)
        - shiftBilin b (oldBasisCut a m) (collarOdd a b n) := by
  unfold localizedBilin
  rw [massBilin_smooth_cross_eq_zero ha hab,
    potentialBilin_smooth_cross_eq_zero ha hab]
  ring
noncomputable def truncOldBlockSmooth (a b : ℝ) (N : ℕ) : Matrix (Fin N) (Fin N) ℝ :=
  oldOldBlock b (truncOldBasisSmooth a N)
noncomputable def truncCrossBlockSmooth (a b : ℝ) (N : ℕ) :
    Matrix (Fin N) (Fin N) ℝ :=
  oldCollarBlock b (truncOldBasisSmooth a N) (truncCollarBasisSmooth a b N)
noncomputable def truncCollarBlockSmooth (a b : ℝ) (N : ℕ) :
    Matrix (Fin N) (Fin N) ℝ :=
  collarCollarBlock b (truncCollarBasisSmooth a b N)
noncomputable def truncHarmonicFormSmooth (a b : ℝ) (N : ℕ)
    [Invertible (truncCollarBlockSmooth a b N)] : Matrix (Fin N) (Fin N) ℝ :=
  harmonicForm (truncOldBlockSmooth a b N) (truncCrossBlockSmooth a b N)
