          ≤ Real.log (Real.log (1 + T) / c) := by
  obtain ⟨c, hc0, hc⟩ := h
  refine ⟨c, hc0, fun T hT havoid p => ?_⟩
  have hlog : 0 < Real.log (1 + T) := Real.log_pos (by linarith)
  have hbound := hc T hT havoid p
  have hpos : 0 < |T - (|(centeredZero p).im|)| := by
    rw [abs_pos]
    intro hzero
    exact havoid p (by linarith [hzero])
  rw [one_div]
  refine Real.log_le_log ?_ ?_
  · positivity
  · rw [inv_le_comm₀ (by positivity) (div_pos hlog hc0)]
    rw [inv_div]
    exact hbound
theorem digamma_conj (z : ℂ) : Complex.digamma (conj z) = conj (Complex.digamma z) := by
  have hF : (conj ∘ Complex.Gamma ∘ conj : ℂ → ℂ) = Complex.Gamma := by
    funext w
    simp only [Function.comp_apply]
    rw [Complex.Gamma_conj w, conj_conj]
  have hderiv : deriv Complex.Gamma z = conj (deriv Complex.Gamma (conj z)) :=
    calc deriv Complex.Gamma z = deriv (conj ∘ Complex.Gamma ∘ conj) z := by rw [hF]
      _ = conj (deriv Complex.Gamma (conj z)) := by
          rw [deriv_conj_conj]
          rfl
  have h2 : conj (deriv Complex.Gamma z) = deriv Complex.Gamma (conj z) := by
    rw [hderiv, conj_conj]
  have hlog : logDeriv Complex.Gamma (conj z) = conj (logDeriv Complex.Gamma z) := by
    rw [logDeriv_apply, logDeriv_apply, div_eq_mul_inv, div_eq_mul_inv, map_mul, map_inv₀,
      Complex.Gamma_conj z, h2]
  simpa only [Complex.digamma_def] using hlog
theorem digamma_quarter_add_I_mul_half_re (r : ℝ) :
    (Complex.digamma ((1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)).re =
      (Complex.digamma ((1 / 2 : ℂ) + (r : ℂ) * I)).re - Real.log 2
        - (1 / 2) * ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) *
            ((1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I))).re := by
  set s : ℂ := (1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I with hs
  have hdup_side : ∀ m : ℕ, 2 * s ≠ -(m : ℂ) := by
    intro m h
    have hre := congrArg Complex.re h
    rw [hs] at hre
    simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im] at hre
    have hm : (0 : ℝ) ≤ (m : ℝ) := by positivity
    linarith
  have hdup := Complex.digamma_two_mul (s := s) hdup_side
  rw [show 2 * s = (1 / 2 : ℂ) + (r : ℂ) * I by rw [hs]; push_cast; ring,
    show s + 1 / 2 = (3 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I by rw [hs]; ring] at hdup
  have href_side : ∀ n : ℤ, s ≠ (n : ℂ) := by
    intro n h
    have him := congrArg Complex.im h
    rw [hs] at him
    simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im] at him
    have hr : r = 0 := by linarith
    subst hr
    have hre := congrArg Complex.re h
    rw [hs] at hre
    simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im] at hre
    have h4 : (4 : ℤ) * n = 1 := by
      have : (4 : ℝ) * (n : ℝ) = 1 := by rw [← hre]; norm_num
      exact_mod_cast this
    omega
  have href := Complex.digamma_one_sub (s := s) href_side
  rw [show 1 - s = (3 / 4 : ℂ) - ((r / 2 : ℝ) : ℂ) * I by rw [hs]; ring] at href
  have hconj : Complex.digamma ((3 / 4 : ℂ) - ((r / 2 : ℝ) : ℂ) * I)
      = conj (Complex.digamma ((3 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)) := by
    have hc : conj ((3 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)
        = (3 / 4 : ℂ) - ((r / 2 : ℝ) : ℂ) * I := by
      have h34 : (3 / 4 : ℂ) = ((3 / 4 : ℝ) : ℂ) := by norm_num
      rw [h34, map_add, map_mul, Complex.conj_ofReal, Complex.conj_I]
      rw [Complex.conj_ofReal]
      ring
    have := digamma_conj ((3 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)
    rwa [hc] at this
  have hiii : Complex.digamma ((3 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)
      = conj (Complex.digamma s)
        + conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)) := by
    have h1 := congrArg conj href
    rw [hconj] at h1
    rw [conj_conj, map_add] at h1
    exact h1
  have hmain : ((Complex.digamma s).re : ℂ)
      = Complex.digamma ((1 / 2 : ℂ) + (r : ℂ) * I) - Complex.log 2
        - (((1 / 2 : ℝ) : ℂ)) * conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)) := by
    have h := hdup
    rw [hiii] at h
    have h2 : ((1 / 2 : ℂ) * (Complex.digamma s
          + (conj (Complex.digamma s)
            + conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)))))
        = ((Complex.digamma s).re : ℂ)
          + (((1 / 2 : ℝ) : ℂ)) * conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)) := by
      rw [show Complex.digamma s
            + (conj (Complex.digamma s)
              + conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)))
          = (Complex.digamma s + conj (Complex.digamma s))
            + conj ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * s)) by ring,
        Complex.add_conj]
      push_cast
      ring
    rw [h2] at h
    linear_combination -h
  have hlog2 : (Complex.log (2 : ℂ)).re = Real.log 2 := by
    simpa using Complex.log_ofReal_re 2
  have hre := congrArg Complex.re hmain
  simp only [Complex.ofReal_re, Complex.sub_re, Complex.mul_re, Complex.ofReal_im,
    zero_mul, sub_zero, Complex.conj_re, Complex.conj_im] at hre
  rw [hlog2] at hre
  rw [hs] at hre ⊢
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero] at hre ⊢
  exact hre
theorem archDensity_eq (r : ℝ) :
    archDensity r =
      (Complex.digamma ((1 / 2 : ℂ) + (r : ℂ) * I)).re - Real.log 2 - Real.log Real.pi
        - (1 / 2) * ((Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) *
            ((1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I))).re := by
  rw [archDensity, digamma_quarter_add_I_mul_half_re]
  ring
