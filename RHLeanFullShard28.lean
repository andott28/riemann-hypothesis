theorem log_sq_le_aux {a u : ℝ} (ha : 0 < a) (hu : 0 < u) (hu2 : u ≤ 2 * a) :
    (Real.log u) ^ 2 ≤ 16 * u ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1) := by
  rcases le_or_gt 1 u with h | h
  · have hlogu : 0 ≤ Real.log u := Real.log_nonneg h
    have hle : Real.log u ≤ Real.log (2 * a) :=
      (Real.log_le_log_iff hu (by linarith : (0 : ℝ) < 2 * a)).mpr (by linarith)
    have h2 : (Real.log u) ^ 2 ≤ (Real.log (2 * a)) ^ 2 := pow_le_pow_left₀ hlogu hle 2
    have hnn : 0 ≤ 16 * u ^ (-(1 / 2 : ℝ)) :=
      mul_nonneg (by norm_num) (Real.rpow_nonneg (le_of_lt hu) _)
    have h1 : (Real.log u) ^ 2 ≤ (Real.log (2 * a)) ^ 2 + 1 :=
      h2.trans (le_add_of_nonneg_right (by norm_num))
    exact h1.trans (le_add_of_nonneg_left hnn)
  · have hu1 : u ≤ 1 := le_of_lt h
    have hb : -Real.log u ≤ 4 * u ^ (-(1 / 4 : ℝ)) := by
      have h := Real.log_le_rpow_div (x := u⁻¹) (inv_nonneg.mpr hu.le)
        (by norm_num : (0 : ℝ) < 1 / 4)
      rw [Real.log_inv] at h
      have h1 : (u⁻¹) ^ ((1 : ℝ) / 4) = u ^ (-(1 / 4 : ℝ)) := by
        rw [Real.inv_rpow hu.le, Real.rpow_neg hu.le]
      rw [h1] at h
      have h2 : u ^ (-(1 / 4 : ℝ)) / (1 / 4) = 4 * u ^ (-(1 / 4 : ℝ)) := by ring
      rwa [h2] at h
    have hlog : Real.log u ≤ 0 := Real.log_nonpos hu.le hu1
    have hsq := pow_le_pow_left₀ (neg_nonneg.mpr hlog) hb 2
    have h16 : (4 * u ^ (-(1 / 4 : ℝ))) ^ 2 = 16 * u ^ (-(1 / 2 : ℝ)) := by
      rw [mul_pow]
      have hp : (u ^ (-(1 / 4 : ℝ))) ^ (2 : ℕ) = u ^ (-(1 / 2 : ℝ)) := by
        rw [← Real.rpow_natCast (u ^ (-(1 / 4 : ℝ))) 2, ← Real.rpow_mul hu.le]
        norm_num
      rw [hp]
      ring
    calc (Real.log u) ^ 2 = (-Real.log u) ^ 2 := by rw [neg_sq]
      _ ≤ (4 * u ^ (-(1 / 4 : ℝ))) ^ 2 := hsq
      _ = 16 * u ^ (-(1 / 2 : ℝ)) := h16
      _ ≤ 16 * u ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1) :=
          le_add_of_nonneg_right (by positivity)
theorem intervalIntegrable_log_sq_sub (a : ℝ) (ha : 0 < a) :
    IntervalIntegrable (fun x : ℝ => Real.log (a - x) ^ 2) volume (-a) a := by
  have hF : IntervalIntegrable
      (fun u : ℝ => 16 * u ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1)) volume 0 (2 * a) := by
    have hpow : IntervalIntegrable (fun u : ℝ => u ^ (-(1 / 2 : ℝ))) volume 0 (2 * a) :=
      intervalIntegral.intervalIntegrable_rpow' (by norm_num : (-1 : ℝ) < -(1 / 2))
    have h1 : IntervalIntegrable (fun u : ℝ => 16 * u ^ (-(1 / 2 : ℝ))) volume 0 (2 * a) :=
      hpow.const_mul 16
    have h0 : IntervalIntegrable (fun u : ℝ => u ^ (0 : ℝ)) volume 0 (2 * a) :=
      intervalIntegral.intervalIntegrable_rpow' (by norm_num : (-1 : ℝ) < 0)
    have h2 : IntervalIntegrable (fun _ : ℝ => (Real.log (2 * a)) ^ 2 + 1) volume 0 (2 * a) := by
      have h2' : IntervalIntegrable
          (fun u : ℝ => ((Real.log (2 * a)) ^ 2 + 1) * u ^ (0 : ℝ)) volume 0 (2 * a) :=
        h0.const_mul ((Real.log (2 * a)) ^ 2 + 1)
      have hfe : (fun u : ℝ => ((Real.log (2 * a)) ^ 2 + 1) * u ^ (0 : ℝ))
          = fun _ : ℝ => (Real.log (2 * a)) ^ 2 + 1 := by
        funext u
        rw [Real.rpow_zero]
        ring
      rw [hfe] at h2'
      exact h2'
    exact h1.add h2
  have h := (hF.comp_sub_left a).symm
  have e1 : a - 2 * a = -a := by ring
  have e2 : a - 0 = a := by ring
  rw [e1, e2] at h
  refine h.mono_fun' ?_ ?_
  · have hm : Measurable (fun x : ℝ => Real.log (a - x)) :=
      ((continuous_const : Continuous fun _ : ℝ => a).sub continuous_id).measurable.log
    exact (hm.pow_const 2).aestronglyMeasurable
  · filter_upwards [self_mem_ae_restrict measurableSet_uIoc] with x hx
    rw [Set.uIoc_of_le (by linarith : (-a : ℝ) ≤ a)] at hx
    have hnorm : ‖Real.log (a - x) ^ 2‖ = Real.log (a - x) ^ 2 :=
      Real.norm_of_nonneg (sq_nonneg _)
    rw [hnorm]
    have hx1 : -a < x := hx.1
    rcases lt_or_eq_of_le hx.2 with hxa | rfl
    · exact log_sq_le_aux ha (by linarith) (by linarith)
    · rw [sub_self, Real.log_zero, Real.zero_rpow (by norm_num : (-(1 / 2 : ℝ)) ≠ 0)]
      norm_num
      positivity
theorem intervalIntegrable_log_sq_add (a : ℝ) (ha : 0 < a) :
    IntervalIntegrable (fun x : ℝ => Real.log (a + x) ^ 2) volume (-a) a := by
  have hF : IntervalIntegrable
      (fun u : ℝ => 16 * u ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1)) volume 0 (2 * a) := by
    have hpow : IntervalIntegrable (fun u : ℝ => u ^ (-(1 / 2 : ℝ))) volume 0 (2 * a) :=
      intervalIntegral.intervalIntegrable_rpow' (by norm_num : (-1 : ℝ) < -(1 / 2))
    have h1 : IntervalIntegrable (fun u : ℝ => 16 * u ^ (-(1 / 2 : ℝ))) volume 0 (2 * a) :=
      hpow.const_mul 16
    have h0 : IntervalIntegrable (fun u : ℝ => u ^ (0 : ℝ)) volume 0 (2 * a) :=
      intervalIntegral.intervalIntegrable_rpow' (by norm_num : (-1 : ℝ) < 0)
    have h2 : IntervalIntegrable (fun _ : ℝ => (Real.log (2 * a)) ^ 2 + 1) volume 0 (2 * a) := by
      have h2' : IntervalIntegrable
          (fun u : ℝ => ((Real.log (2 * a)) ^ 2 + 1) * u ^ (0 : ℝ)) volume 0 (2 * a) :=
        h0.const_mul ((Real.log (2 * a)) ^ 2 + 1)
      have hfe : (fun u : ℝ => ((Real.log (2 * a)) ^ 2 + 1) * u ^ (0 : ℝ))
          = fun _ : ℝ => (Real.log (2 * a)) ^ 2 + 1 := by
        funext u
        rw [Real.rpow_zero]
        ring
      rw [hfe] at h2'
      exact h2'
    exact h1.add h2
  have h := hF.comp_sub_right (-a)
  have e1 : (fun x : ℝ => 16 * (x - -a) ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1))
      = fun x : ℝ => 16 * (a + x) ^ (-(1 / 2 : ℝ)) + ((Real.log (2 * a)) ^ 2 + 1) := by
    funext x
    rw [sub_neg_eq_add]
    ring
  have e2 : (0 : ℝ) + -a = -a := by ring
  have e3 : 2 * a + -a = a := by ring
  rw [e1, e2, e3] at h
  refine h.mono_fun' ?_ ?_
  · have hm : Measurable (fun x : ℝ => Real.log (a + x)) :=
      ((continuous_const : Continuous fun _ : ℝ => a).add continuous_id).measurable.log
    exact (hm.pow_const 2).aestronglyMeasurable
  · filter_upwards [self_mem_ae_restrict measurableSet_uIoc] with x hx
    rw [Set.uIoc_of_le (by linarith : (-a : ℝ) ≤ a)] at hx
    have hnorm : ‖Real.log (a + x) ^ 2‖ = Real.log (a + x) ^ 2 :=
      Real.norm_of_nonneg (sq_nonneg _)
    rw [hnorm]
    have hx1 : -a < x := hx.1
    have hx2 : x ≤ a := hx.2
    exact log_sq_le_aux ha (by linarith) (by linarith)
theorem endpointPotential_sq_integrable (a : ℝ) (ha : 0 < a) :
    IntegrableOn (fun x : ℝ => (RHLean.endpointPotential a x) ^ 2)
      (Set.Ioo (-a) a) volume := by
  have hint1 : IntegrableOn (fun x : ℝ => Real.log (a - x) ^ 2) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith : -a ≤ a)).mp
      (intervalIntegrable_log_sq_sub a ha)).mono_set Set.Ioo_subset_Ioc_self
  have hint2 : IntegrableOn (fun x : ℝ => Real.log (a + x) ^ 2) (Set.Ioo (-a) a) volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith : -a ≤ a)).mp
      (intervalIntegrable_log_sq_add a ha)).mono_set Set.Ioo_subset_Ioc_self
  have hmaj : IntegrableOn (fun x : ℝ => Real.log (a - x) ^ 2 + Real.log (a + x) ^ 2)
      (Set.Ioo (-a) a) volume := hint1.add hint2
  have hwm : Measurable (fun x : ℝ => RHLean.endpointPotential a x) := by
    unfold RHLean.endpointPotential
    fun_prop
  have hmeas : AEStronglyMeasurable (fun x : ℝ => (RHLean.endpointPotential a x) ^ 2)
      (volume.restrict (Set.Ioo (-a) a)) := (hwm.pow_const 2).aestronglyMeasurable
  have hbound : ∀ᵐ x ∂(volume.restrict (Set.Ioo (-a) a)),
      ‖(RHLean.endpointPotential a x) ^ 2‖
        ≤ Real.log (a - x) ^ 2 + Real.log (a + x) ^ 2 := by
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    have hx1 : 0 < a - x := by linarith [(Set.mem_Ioo.mp hx).2]
    have hx2 : 0 < a + x := by linarith [(Set.mem_Ioo.mp hx).1]
    have hsplit : RHLean.endpointPotential a x
        = -(1 / 2) * (Real.log (a - x) + Real.log (a + x)) := by
      rw [RHLean.ExplicitFormula.endpointPotential_eq,
        show a ^ 2 - x ^ 2 = (a - x) * (a + x) by ring,
        Real.log_mul (ne_of_gt hx1) (ne_of_gt hx2)]
    rw [hsplit]
    have hs : (Real.log (a - x) + Real.log (a + x)) ^ 2
        ≤ 2 * Real.log (a - x) ^ 2 + 2 * Real.log (a + x) ^ 2 := by
      nlinarith [sq_nonneg (Real.log (a - x) - Real.log (a + x))]
    have hq : (-(1 / 2 : ℝ) * (Real.log (a - x) + Real.log (a + x))) ^ 2
        = (1 / 4) * (Real.log (a - x) + Real.log (a + x)) ^ 2 := by ring
    rw [hq]
    nlinarith [hs, sq_nonneg (Real.log (a - x)), sq_nonneg (Real.log (a + x))]
  exact hmaj.mono' hmeas hbound
end Y7GateIIAdd
