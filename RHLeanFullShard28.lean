def LineLogDerivBound : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∃ N : ℕ, ∀ ε ∈ Set.Icc (0 : ℝ) 1, ∀ y : ℝ,
    ‖logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
      ≤ C * (1 + |y|) ^ N
theorem lineLogDerivBound_of_pos
    (h : ∃ C : ℝ, 0 ≤ C ∧ ∃ N : ℕ, ∀ ε ∈ Set.Ioc (0 : ℝ) 1, ∀ y : ℝ,
      ‖logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
        ≤ C * (1 + |y|) ^ N) :
    LineLogDerivBound := by
  obtain ⟨C, hC0, N, hN⟩ := h
  refine ⟨C, hC0, N, fun ε hε y => ?_⟩
  rcases lt_or_eq_of_le hε.1 with hpos | hzero
  · exact hN ε ⟨hpos, hε.2⟩ y
  · have hε0 : ε = 0 := hzero.symm
    subst hε0
    have hlt1 : ∀ᶠ (e : ℝ) in 𝓝[>] (0 : ℝ), e ≤ 1 := by
      have : ∀ᶠ (e : ℝ) in 𝓝[>] (0 : ℝ), e < 1 :=
        (eventually_lt_nhds (by norm_num : (0 : ℝ) < 1)).filter_mono
          nhdsWithin_le_nhds
      exact this.mono (fun e he => le_of_lt he)
    have hbound : ∀ᶠ (e : ℝ) in 𝓝[>] (0 : ℝ),
        ‖logDeriv riemannXi (((1 + e : ℝ) : ℂ) + (y : ℂ) * I)‖
          ≤ C * (1 + |y|) ^ N := by
      filter_upwards [self_mem_nhdsWithin, hlt1] with e hepos he1
      exact hN e ⟨hepos, he1⟩ y
    have hnorm := (tendsto_logDeriv_riemannXi_vertical y).norm
    have hle : ‖logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I)‖
        ≤ C * (1 + |y|) ^ N :=
      le_of_tendsto hnorm hbound
    simpa using hle
def VerticalLineValue : Prop :=
  ∀ a : ℝ, ∀ f : ℝ → ℂ, f ∈ localizedCore a →
    (∫ y : ℝ, bridgeLine f y *
        logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I)).re
      = Real.pi * (archimedeanBlock f + poleBlock f) - primeSideComb f a
theorem bridgeLine_polyDecay {f : ℝ → ℂ} (hf : f ∈ oddCore) (N : ℕ) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ y : ℝ, ‖bridgeLine f y‖ ≤ D / (1 + |y|) ^ N := by
  obtain ⟨D, hD0, hD⟩ := exists_transf_autocorr_superPolyDecay hf N
  refine ⟨D, hD0, fun y => ?_⟩
  have hzre : |((1 / 2 : ℂ) + (y : ℂ) * I).re| ≤ 1 / 2 := by simp
  have hmain : ‖transf (autocorr f) ((1 / 2 : ℂ) + (y : ℂ) * I)‖
      ≤ D / (1 + ‖(1 / 2 : ℂ) + (y : ℂ) * I‖) ^ N := hD _ hzre
  have him : |y| ≤ ‖(1 / 2 : ℂ) + (y : ℂ) * I‖ := by
    have h := Complex.abs_im_le_norm ((1 / 2 : ℂ) + (y : ℂ) * I)
    simpa using h
  have hmono : (1 + |y|) ^ N ≤ (1 + ‖(1 / 2 : ℂ) + (y : ℂ) * I‖) ^ N :=
    pow_le_pow_left₀ (by positivity) (by linarith) N
  have hb : (0 : ℝ) < (1 + |y|) ^ N := by positivity
  have hb' : (0 : ℝ) < (1 + ‖(1 / 2 : ℂ) + (y : ℂ) * I‖) ^ N := by positivity
  rw [bridgeLine]
  calc ‖transf (autocorr f) ((1 / 2 : ℂ) + (y : ℂ) * I)‖
        ≤ D / (1 + ‖(1 / 2 : ℂ) + (y : ℂ) * I‖) ^ N := hmain
    _ ≤ D / (1 + |y|) ^ N :=
        div_le_div_of_nonneg_left hD0 hb (by linarith)
theorem integrable_polyMajorant (D C : ℝ) :
    Integrable (fun y : ℝ => D * C * (1 + y ^ 2)⁻¹) volume :=
  integrable_inv_one_add_sq.const_mul (D * C)
theorem bridgeLine_mul_logDeriv_le {f : ℝ → ℂ} {C D : ℝ} {N : ℕ}
    (hD : ∀ y : ℝ, ‖bridgeLine f y‖ ≤ D / (1 + |y|) ^ (N + 2))
    (hN : ∀ ε ∈ Set.Icc (0 : ℝ) 1, ∀ y : ℝ,
      ‖logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
        ≤ C * (1 + |y|) ^ N)
    {ε : ℝ} (hε : ε ∈ Set.Icc (0 : ℝ) 1) (y : ℝ) :
    ‖bridgeLine f y *
        logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
      ≤ D * C * (1 + y ^ 2)⁻¹ := by
  rw [norm_mul]
  have hD0 : 0 ≤ D := by
    have hd := hD 0
    have h1 : (1 + |(0 : ℝ)| : ℝ) ^ (N + 2) = 1 := by norm_num
    rw [h1, div_one] at hd
    exact le_trans (norm_nonneg _) hd
  have hC0 : 0 ≤ C := by
    have hc := hN 0 ⟨le_rfl, by norm_num⟩ 0
    have h1 : (1 + |(0 : ℝ)| : ℝ) ^ N = 1 := by norm_num
    rw [h1, mul_one] at hc
    exact le_trans (norm_nonneg _) hc
  have hprod :
      ‖bridgeLine f y‖ *
          ‖logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
        ≤ (D / (1 + |y|) ^ (N + 2)) * (C * (1 + |y|) ^ N) :=
    mul_le_mul (hD y) (hN ε hε y) (norm_nonneg _) (by positivity)
  refine le_trans hprod ?_
  have hy : (0 : ℝ) < 1 + |y| := by positivity
  have hkey : (D / (1 + |y|) ^ (N + 2)) * (C * (1 + |y|) ^ N)
      = D * C * ((1 + |y|) ^ 2)⁻¹ := by
    rw [pow_add]
    field_simp
  rw [hkey]
  have hsq : (1 + y ^ 2) ≤ (1 + |y|) ^ 2 := by
    nlinarith [sq_abs y, abs_nonneg y]
  have hinv : ((1 + |y|) ^ 2)⁻¹ ≤ ((1 + y ^ 2)⁻¹ : ℝ) := by
    rw [← one_div, ← one_div]
    exact one_div_le_one_div_of_le (by positivity) hsq
  exact mul_le_mul_of_nonneg_left hinv (mul_nonneg hD0 hC0)
theorem integrable_bridgeLine_mul_logDeriv (h : LineLogDerivBound)
    {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    Integrable (fun y : ℝ =>
      bridgeLine f y * logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I)) volume := by
  obtain ⟨C, hC0, N, hN⟩ := h
  have hodd : f ∈ oddCore := localizedCore_subset_oddCore a hf
  obtain ⟨D, hD0, hD⟩ := bridgeLine_polyDecay hodd (N + 2)
  have hlog : Continuous (fun y : ℝ =>
      logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I)) := by
    rw [continuous_iff_continuousAt]
    intro y
    have hpath : ContinuousAt (fun y : ℝ => (1 : ℂ) + (y : ℂ) * I) y := by fun_prop
    have hg : ContinuousAt (logDeriv riemannXi) ((1 : ℂ) + (y : ℂ) * I) :=
      continuousAt_logDeriv_riemannXi (riemannXi_ne_zero_of_one_le_re' y)
    exact ContinuousAt.comp
      (f := fun t : ℝ => ((1 : ℂ) + (t : ℂ) * I)) (x := y) hg hpath
  have hmeas : AEStronglyMeasurable (fun y : ℝ =>
      bridgeLine f y * logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I)) volume :=
    ((continuous_bridgeLine hodd).mul hlog).aestronglyMeasurable
  refine Integrable.mono' (integrable_polyMajorant D C) hmeas ?_
  filter_upwards with y
  have hε : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, by norm_num⟩
  simpa using bridgeLine_mul_logDeriv_le (N := N) hD hN hε y
theorem tendsto_integral_logDeriv (h : LineLogDerivBound)
    {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    Tendsto (fun ε : ℝ => ∫ y : ℝ,
        bridgeLine f y * logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I))
      (𝓝[>] (0 : ℝ))
      (𝓝 (∫ y : ℝ,
        bridgeLine f y * logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I))) := by
  obtain ⟨C, hC0, N, hN⟩ := h
  have hodd : f ∈ oddCore := localizedCore_subset_oddCore a hf
  obtain ⟨D, hD0, hD⟩ := bridgeLine_polyDecay hodd (N + 2)
  have hlt1 : ∀ᶠ (ε : ℝ) in 𝓝[>] (0 : ℝ), ε < 1 :=
    (eventually_lt_nhds (by norm_num : (0 : ℝ) < 1)).filter_mono
      nhdsWithin_le_nhds
  have hbound : ∀ᶠ (ε : ℝ) in 𝓝[>] (0 : ℝ),
      ∀ᵐ y ∂(volume : Measure ℝ),
        ‖bridgeLine f y *
          logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)‖
          ≤ D * C * (1 + y ^ 2)⁻¹ := by
    filter_upwards [self_mem_nhdsWithin, hlt1] with ε hεpos hε1
    refine Filter.Eventually.of_forall fun y => ?_
    exact bridgeLine_mul_logDeriv_le (N := N) hD hN
      ⟨le_of_lt hεpos, le_of_lt hε1⟩ y
  have hmeas : ∀ᶠ (ε : ℝ) in 𝓝[>] (0 : ℝ),
      AEStronglyMeasurable (fun y : ℝ =>
        bridgeLine f y *
          logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)) volume := by
    filter_upwards [self_mem_nhdsWithin] with ε hεpos
    have hcont : Continuous (fun y : ℝ =>
        logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)) := by
      rw [continuous_iff_continuousAt]
      intro y
      have hpath : ContinuousAt (fun y : ℝ =>
          ((1 + ε : ℝ) : ℂ) + (y : ℂ) * I) y := by fun_prop
      have hne : riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I) ≠ 0 := by
        have hε0 : (0 : ℝ) < ε := hεpos
        refine riemannXi_ne_zero_of_one_le_re ?_ ?_
        · have hre : (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I).re = 1 + ε := by simp
          rw [hre]; linarith
        · intro h
          have hre := congrArg Complex.re h
          have him := congrArg Complex.im h
          simp at hre him
          linarith
      exact ContinuousAt.comp
        (f := fun t : ℝ => ((1 + ε : ℝ) : ℂ) + (t : ℂ) * I)
        (x := y) (continuousAt_logDeriv_riemannXi hne) hpath
    exact ((continuous_bridgeLine hodd).mul hcont).aestronglyMeasurable
  have hlim : ∀ᵐ y ∂(volume : Measure ℝ),
      Tendsto (fun ε : ℝ => bridgeLine f y *
          logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I))
        (𝓝[>] (0 : ℝ))
        (𝓝 (bridgeLine f y *
          logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I))) :=
    Filter.Eventually.of_forall fun y => by
      have hshift : Tendsto (fun ε : ℝ => ((1 + ε : ℝ) : ℂ) + (y : ℂ) * I)
          (𝓝[>] (0 : ℝ)) (𝓝 ((1 : ℂ) + (y : ℂ) * I)) := by
        have hc : Continuous (fun ε : ℝ => ((1 + ε : ℝ) : ℂ) + (y : ℂ) * I) := by
          fun_prop
        have hmono := (hc.tendsto (0 : ℝ)).mono_left
          (nhdsWithin_le_nhds : 𝓝[>] (0 : ℝ) ≤ 𝓝 (0 : ℝ))
        simpa using hmono
      have hld : Tendsto (fun ε : ℝ =>
          logDeriv riemannXi (((1 + ε : ℝ) : ℂ) + (y : ℂ) * I))
          (𝓝[>] (0 : ℝ))
          (𝓝 (logDeriv riemannXi ((1 : ℂ) + (y : ℂ) * I))) :=
        (continuousAt_logDeriv_riemannXi
          (riemannXi_ne_zero_of_one_le_re' y)).tendsto.comp hshift
      exact tendsto_const_nhds.mul hld
  exact MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (fun y : ℝ => D * C * (1 + y ^ 2)⁻¹) hmeas hbound
    (integrable_polyMajorant D C) hlim
theorem verticalIntegralEvalFull_of (h1 : LineLogDerivBound)
    (h2 : VerticalLineValue) :
    ∀ a : ℝ, VerticalIntegralEvalFull a := by
  intro a
  exact fun f hf =>
    ⟨integrable_bridgeLine_mul_logDeriv h1 hf, h2 a f hf⟩
theorem verticalIntegralEvalAt_of (h1 : LineLogDerivBound)
    (h2 : VerticalLineValue) :
    ∀ a : ℝ, VerticalIntegralEvalAt a :=
  fun a => verticalIntegralEvalAt_of_full (verticalIntegralEvalFull_of h1 h2 a)
theorem weilBridge_of (h1 : LineLogDerivBound) (h2 : VerticalLineValue) :
    RHLean.WeilBridge :=
  RHLean.WP.weilBridge_of_verticalEvalFull_closed
    (verticalIntegralEvalFull_of h1 h2)
end RHLean.ExplicitFormula
