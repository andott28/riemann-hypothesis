theorem localizedBilin_cross_zero (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.localizedBilin a u v = 0 := by
  unfold RHLean.GateII.Reduction.localizedBilin
  rw [archBilin_real_imag a u v hu hv, massBilin_real_imag a u v hu hv,
