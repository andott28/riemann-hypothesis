    (hpot : ∀ i ∈ s, ∀ j ∈ s, MeasureTheory.IntegrableOn
      (fun t => RHLean.endpointPotential a t * (φ i t * star (φ j t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hpolar : ∀ i ∈ s, MeasureTheory.IntegrableOn
      (fun t => star (RHLean.sph t) * φ i t)
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hshift : ∀ i ∈ s, ∀ j ∈ s, ∀ n ∈ RHLean.arithSupport a,
      MeasureTheory.IntegrableOn
        (fun t => φ i t * star (φ j (t + RHLean.shiftLength n)))
        (Set.Ioo (-a) a) MeasureTheory.volume)
    (harch : ∀ i ∈ s, ∀ j ∈ s, MeasureTheory.IntegrableOn
      (RHLean.GateII.Reduction.archBilinKernel (φ i) (φ j))
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam1 : ∀ i ∈ s, ∀ j ∈ s, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ i p.1 * star (φ j p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam2 : ∀ i ∈ s, ∀ j ∈ s, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ j p.1 * star (φ i p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)) :
    RHLean.GateII.Reduction.localizedBilin a
        (Finset.sum s (fun i => c i • φ i)) (Finset.sum s (fun j => c j • φ j))
      = Finset.sum s (fun i => Finset.sum s (fun j =>
          c i * c j * RHLean.GateII.Reduction.gramMatrix a φ i j)) := by
  have houter : RHLean.GateII.Reduction.localizedBilin a
      (Finset.sum s (fun i => c i • φ i)) (Finset.sum s (fun j => c j • φ j))
      = Finset.sum s (fun i => c i * RHLean.GateII.Reduction.localizedBilin a
          (φ i) (Finset.sum s (fun j => c j • φ j))) := by
    refine localizedBilinFinsetSumLeft s c φ
      (Finset.sum s (fun j => c j • φ j)) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · exact fun i hi => integrable_massR1 s c φ (φ i)
        (fun j hj => hmass i hi j hj)
    · exact fun i hi => integrable_potR1 s c φ (φ i)
        (fun j hj => hpot i hi j hj)
    · exact fun i hi => hpolar i hi
    · exact fun i hi n hn => integrable_cshiftR1 s c φ (φ i) n
        (fun j hj => hshift i hi j hj n hn)
    · exact fun i hi n hn => integrable_cmass_sum s c φ
        (fun u => φ i (u + RHLean.shiftLength n))
        (fun j hj => hshift j hj i hi n hn)
    · exact fun i hi => integrable_archR s c φ (φ i)
        (fun j hj => harch j hj i hi)
    · exact fun i hi => integrable_gamma1R s c φ (φ i)
        (fun j hj => hgam1 i hi j hj)
    · exact fun i hi => integrable_gamma2R1 s c φ (φ i)
        (fun j hj => hgam2 i hi j hj)
  rw [houter]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  have hinner := localizedBilinFinsetSumRight s c φ (φ i)
    (fun j hj => hmass j hj i hi) (fun j hj => hpot j hj i hi)
    (fun j hj => hpolar j hj)
    (fun j hj n hn => hshift j hj i hi n hn)
    (fun j hj n hn => hshift i hi j hj n hn)
    (fun j hj => harch j hj i hi)
    (fun j hj => hgam2 i hi j hj)
    (fun j hj => hgam1 i hi j hj)
  rw [hinner, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  rw [mul_assoc,
    show RHLean.GateII.Reduction.gramMatrix a φ i j
        = RHLean.GateII.Reduction.localizedBilin a (φ i) (φ j) from rfl]
theorem localizedBilin_nonneg_of_posSemidef_prod
    {ι : Type*} [Fintype ι] [DecidableEq ι] {a : ℝ} {φ : ι → ℝ → ℂ}
    (hM : Matrix.PosSemidef (RHLean.GateII.Reduction.gramMatrix a φ))
    (x : ι →₀ ℝ)
    (hmass : ∀ i ∈ x.support, ∀ j ∈ x.support, MeasureTheory.IntegrableOn
      (fun t => (φ i t * star (φ j t)).re) (Set.Ioo (-a) a) MeasureTheory.volume)
    (hpot : ∀ i ∈ x.support, ∀ j ∈ x.support, MeasureTheory.IntegrableOn
      (fun t => RHLean.endpointPotential a t * (φ i t * star (φ j t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hpolar : ∀ i ∈ x.support, MeasureTheory.IntegrableOn
      (fun t => star (RHLean.sph t) * φ i t)
      (Set.Ioo (-a) a) MeasureTheory.volume)
    (hshift : ∀ i ∈ x.support, ∀ j ∈ x.support, ∀ n ∈ RHLean.arithSupport a,
      MeasureTheory.IntegrableOn
        (fun t => φ i t * star (φ j (t + RHLean.shiftLength n)))
        (Set.Ioo (-a) a) MeasureTheory.volume)
    (harch : ∀ i ∈ x.support, ∀ j ∈ x.support, MeasureTheory.IntegrableOn
      (RHLean.GateII.Reduction.archBilinKernel (φ i) (φ j))
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam1 : ∀ i ∈ x.support, ∀ j ∈ x.support, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ i p.1 * star (φ j p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    (hgam2 : ∀ i ∈ x.support, ∀ j ∈ x.support, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ j p.1 * star (φ i p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)) :
    0 ≤ RHLean.GateII.Reduction.localizedBilin a
        (Finset.sum x.support (fun i => x i • φ i))
        (Finset.sum x.support (fun i => x i • φ i)) := by
  rw [localizedBilinFinsetQuad x.support x φ hmass hpot hpolar hshift harch
    hgam1 hgam2]
  have hq := hM.2 x
  rw [Y7GateIIAdd.finsupp_sum_star_support x
      (RHLean.GateII.Reduction.gramMatrix a φ)] at hq
  simp only [Y7GateIIAdd.star_real_eq] at hq
  refine le_trans hq (le_of_eq ?_)
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
  ring
end Y7Epsilon
namespace Y7Epsilon
open scoped BigOperators
open RHLean.GateII.Reduction
private lemma re_mul_star_sym' (z w : ℂ) : (z * star w).re = (w * star z).re := by
  rw [Complex.mul_re, Complex.mul_re, Y7GateIIAdd.re_star, Y7GateIIAdd.re_star,
    Y7GateIIAdd.im_star, Y7GateIIAdd.im_star]
  ring
private lemma abs_re_mul_star_le (z w : ℂ) : |(z * star w).re| ≤ ‖z‖ * ‖w‖ := by
  have h : |(z * star w).re| ≤ ‖z‖ * ‖star w‖ := by
    calc |(z * star w).re| ≤ ‖z * star w‖ := Complex.abs_re_le_norm (z * star w)
      _ = ‖z‖ * ‖star w‖ := Complex.norm_mul z (star w)
  rw [norm_star] at h
  exact h
private lemma norm_mul_star_le (z w : ℂ) : ‖z * star w‖ ≤ ‖z‖ * ‖w‖ := by
  have h : ‖z * star w‖ = ‖z‖ * ‖w‖ := by
    rw [Complex.norm_mul, norm_star]
  rw [h]
private lemma archBilinKernel_sym (f g : ℝ → ℂ) (p : ℝ × ℝ) :
    archBilinKernel f g p = archBilinKernel g f p := by
  unfold archBilinKernel
  rw [re_mul_star_sym']
private lemma exists_bound_sph {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Set.Ioo (-a) a, ‖RHLean.sph x‖ ≤ C := by
  have hcont : ContinuousOn (fun x => RHLean.sph x) (Set.Icc (-a) a) := by
    have hsp : Continuous (fun x : ℝ => RHLean.sph x) := by
      unfold RHLean.sph
      exact Complex.continuous_ofReal.comp
        (Real.continuous_sinh.comp (by fun_prop))
    exact hsp.continuousOn
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn hcont
  exact ⟨C, le_trans (norm_nonneg _) (hC 0 (Set.mem_Icc.mpr ⟨by linarith, by linarith⟩)),
    fun x hx => hC x (Set.mem_Icc.mpr ⟨le_of_lt hx.1, le_of_lt hx.2⟩)⟩
private lemma measurable_endpointPotential (a : ℝ) :
    Measurable (fun x => RHLean.endpointPotential a x) := by
  have hm1 : Measurable (fun x : ℝ => a ^ 2 - x ^ 2) := by fun_prop
  have heq : (fun x : ℝ => RHLean.endpointPotential a x)
      = fun x => (-(1 / 2) : ℝ) * Real.log (a ^ 2 - x ^ 2) := by
    funext x
    rw [RHLean.ExplicitFormula.endpointPotential_eq]
  rw [heq]
  exact hm1.log.const_mul (-(1 / 2))
theorem integrableOn_endpointPotential_abs {a : ℝ} (ha : 0 < a) :
    MeasureTheory.IntegrableOn (fun x => |RHLean.endpointPotential a x|)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
  have hintsub : MeasureTheory.IntegrableOn
      (fun x => |Real.log (a - x)|) (Set.Ioo (-a) a) MeasureTheory.volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le
      (by linarith : (-a : ℝ) ≤ a)).mp
      RHLean.ExplicitFormula.intervalIntegrable_log_sub).mono_set
      Set.Ioo_subset_Ioc_self |>.abs
  have hintadd : MeasureTheory.IntegrableOn
      (fun x => |Real.log (a + x)|) (Set.Ioo (-a) a) MeasureTheory.volume :=
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le
      (by linarith : (-a : ℝ) ≤ a)).mp
      RHLean.ExplicitFormula.intervalIntegrable_log_add).mono_set
      Set.Ioo_subset_Ioc_self |>.abs
  have hmaj : MeasureTheory.IntegrableOn
      (fun x => (1 / 2) * (|Real.log (a - x)| + |Real.log (a + x)|))
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    (hintsub.add hintadd).const_mul (1 / 2)
  have hmeas : MeasureTheory.AEStronglyMeasurable
      (fun x => |RHLean.endpointPotential a x|)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
    ((measurable_endpointPotential a).abs).aestronglyMeasurable.mono_measure
      MeasureTheory.Measure.restrict_le_self
  refine hmaj.mono' hmeas ?_
  filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
  have hxa : |x| < a := by
    rw [abs_lt]
    constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2]
  have hsum := RHLean.ExplicitFormula.endpointPotential_neg_eq_logSum hxa
  have h2 : RHLean.endpointPotential a x
      = -(1 / 2 * (Real.log (a - x) + Real.log (a + x))) := by
    rw [← hsum]
    ring
  have hkey : ‖|RHLean.endpointPotential a x|‖
      ≤ (1 / 2) * (|Real.log (a - x)| + |Real.log (a + x)|) := by
    rw [Real.norm_eq_abs, abs_abs, h2, abs_neg, abs_mul,
      abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    exact mul_le_mul_of_nonneg_left (abs_add_le _ _) (by norm_num)
  exact hkey
theorem localizedForm_nonneg_of_mem_span_gen {ι : Type*} [Fintype ι] [DecidableEq ι]
    {a : ℝ} (ha : 0 < a) {φ : ι → ℝ → ℂ}
    (hM : Matrix.PosSemidef (gramMatrix a φ))
    (hbound : ∀ i : ι, ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖φ i x‖ ≤ B)
    (hmeas : ∀ i : ι, Measurable (φ i))
    (harch : ∀ i : ι, ∀ j : ι, MeasureTheory.IntegrableOn
      (archBilinKernel (φ i) (φ j))
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume))
    {g : ℝ → ℂ} (hg : g ∈ Submodule.span ℝ (Set.range φ)) :
    0 ≤ RHLean.localizedForm a g := by
  classical
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hg
  have hc' : Finset.sum c.support (fun i => c i • φ i) = g := hc
  rw [← localizedBilin_self, ← hc']
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hmass : ∀ i ∈ c.support, ∀ j ∈ c.support, MeasureTheory.IntegrableOn
      (fun t => (φ i t * star (φ j t)).re) (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro i hi j hj
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨Bj, hBj0, hBj⟩ := hbound j
    have hme : Measurable (fun t => (φ i t * star (φ j t)).re) :=
      Complex.continuous_re.measurable.comp
        ((hmeas i).mul (continuous_star.measurable.comp (hmeas j)))
    refine MeasureTheory.IntegrableOn.of_bound hfin
      (hme.aestronglyMeasurable.mono_measure
        MeasureTheory.Measure.restrict_le_self)
      (Bi * Bj) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
    show |(φ i t * star (φ j t)).re| ≤ Bi * Bj
    calc |(φ i t * star (φ j t)).re| ≤ ‖φ i t‖ * ‖φ j t‖ :=
          abs_re_mul_star_le _ _
      _ ≤ Bi * Bj := mul_le_mul (hBi t) (hBj t) (norm_nonneg _) hBi0
  have hpot : ∀ i ∈ c.support, ∀ j ∈ c.support, MeasureTheory.IntegrableOn
      (fun t => RHLean.endpointPotential a t * (φ i t * star (φ j t)).re)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro i hi j hj
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨Bj, hBj0, hBj⟩ := hbound j
    have hg : MeasureTheory.IntegrableOn
        (fun t => Bi * Bj * |RHLean.endpointPotential a t|)
        (Set.Ioo (-a) a) MeasureTheory.volume :=
      (integrableOn_endpointPotential_abs ha).const_mul (Bi * Bj)
    have hmeas2 : MeasureTheory.AEStronglyMeasurable
        (fun t => RHLean.endpointPotential a t * (φ i t * star (φ j t)).re)
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
      have hme : Measurable (fun t => (φ i t * star (φ j t)).re) :=
        Complex.continuous_re.measurable.comp
          ((hmeas i).mul (continuous_star.measurable.comp (hmeas j)))
      have hfull : Measurable
          (fun t => RHLean.endpointPotential a t * (φ i t * star (φ j t)).re) :=
        (measurable_endpointPotential a).mul hme
      exact hfull.aestronglyMeasurable.mono_measure
        MeasureTheory.Measure.restrict_le_self
    refine hg.mono' hmeas2 ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
    have h1 : ‖(fun t => RHLean.endpointPotential a t
        * (φ i t * star (φ j t)).re) t‖
        = |RHLean.endpointPotential a t| * |(φ i t * star (φ j t)).re| := by
      show |RHLean.endpointPotential a t * (φ i t * star (φ j t)).re|
        = |RHLean.endpointPotential a t| * |(φ i t * star (φ j t)).re|
      rw [abs_mul]
    rw [h1]
    calc |RHLean.endpointPotential a t| * |(φ i t * star (φ j t)).re|
        ≤ |RHLean.endpointPotential a t| * (‖φ i t‖ * ‖φ j t‖) :=
          mul_le_mul_of_nonneg_left (abs_re_mul_star_le _ _) (abs_nonneg _)
      _ ≤ |RHLean.endpointPotential a t| * (Bi * Bj) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul (hBi t) (hBj t) (norm_nonneg _) hBi0)
            (abs_nonneg _)
      _ = Bi * Bj * |RHLean.endpointPotential a t| := by ring
  have hpolar : ∀ i ∈ c.support, MeasureTheory.IntegrableOn
      (fun t => star (RHLean.sph t) * φ i t)
      (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro i hi
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨C, hC0, hC⟩ := exists_bound_sph ha
    have hsp : Measurable (fun x => RHLean.sph x) := by
      have hcon : Continuous (fun x : ℝ => RHLean.sph x) := by
        unfold RHLean.sph
        exact Complex.continuous_ofReal.comp
          (Real.continuous_sinh.comp (by fun_prop))
      exact hcon.measurable
    have hme : Measurable (fun t => star (RHLean.sph t) * φ i t) :=
      (continuous_star.measurable.comp hsp).mul (hmeas i)
    refine MeasureTheory.IntegrableOn.of_bound hfin
      (hme.aestronglyMeasurable.mono_measure
        MeasureTheory.Measure.restrict_le_self)
      (C * Bi) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
    calc ‖star (RHLean.sph t) * φ i t‖
        ≤ ‖star (RHLean.sph t)‖ * ‖φ i t‖ := le_of_eq (Complex.norm_mul _ _)
      _ = ‖RHLean.sph t‖ * ‖φ i t‖ := by rw [norm_star]
      _ ≤ C * Bi := mul_le_mul (hC t ht) (hBi t) (norm_nonneg _) hC0
  have hshift : ∀ i ∈ c.support, ∀ j ∈ c.support, ∀ n ∈ RHLean.arithSupport a,
      MeasureTheory.IntegrableOn
        (fun t => φ i t * star (φ j (t + RHLean.shiftLength n)))
        (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro i hi j hj n hn
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨Bj, hBj0, hBj⟩ := hbound j
    have hmeasj : Measurable (fun t => φ j (t + RHLean.shiftLength n)) :=
      (hmeas j).comp (measurable_id.add measurable_const)
    have hme : Measurable
        (fun t => φ i t * star (φ j (t + RHLean.shiftLength n))) :=
      (hmeas i).mul (continuous_star.measurable.comp hmeasj)
    refine MeasureTheory.IntegrableOn.of_bound hfin
      (hme.aestronglyMeasurable.mono_measure
        MeasureTheory.Measure.restrict_le_self)
      (Bi * Bj) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with t ht
    calc ‖φ i t * star (φ j (t + RHLean.shiftLength n))‖
        ≤ ‖φ i t‖ * ‖φ j (t + RHLean.shiftLength n)‖ := norm_mul_star_le _ _
      _ ≤ Bi * Bj :=
          mul_le_mul (hBi t) (hBj (t + RHLean.shiftLength n)) (norm_nonneg _)
            hBi0
  have harch' : ∀ i ∈ c.support, ∀ j ∈ c.support, MeasureTheory.IntegrableOn
      (archBilinKernel (φ i) (φ j))
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume) := fun i hi j hj => harch i j
  have hgam1 : ∀ i ∈ c.support, ∀ j ∈ c.support, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ i p.1 * star (φ j p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume) := by
    intro i hi j hj
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨Bj, hBj0, hBj⟩ := hbound j
    exact integrableOn_gammaBilinKernel_of_bound
      (show 0 ≤ max Bi Bj by exact le_trans hBi0 (le_max_left _ _))
      (fun x => le_trans (hBi x) (le_max_left _ _))
      (fun x => le_trans (hBj x) (le_max_right _ _)) (hmeas i) (hmeas j)
  have hgam2 : ∀ i ∈ c.support, ∀ j ∈ c.support, MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
        * (φ j p.1 * star (φ i p.2)).re)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume) := by
    intro i hi j hj
    obtain ⟨Bi, hBi0, hBi⟩ := hbound i
    obtain ⟨Bj, hBj0, hBj⟩ := hbound j
    exact integrableOn_gammaBilinKernel_of_bound
      (show 0 ≤ max Bj Bi by exact le_trans hBj0 (le_max_left _ _))
      (fun x => le_trans (hBj x) (le_max_left _ _))
      (fun x => le_trans (hBi x) (le_max_right _ _)) (hmeas j) (hmeas i)
  exact localizedBilin_nonneg_of_posSemidef_prod hM c hmass hpot hpolar hshift
    harch' hgam1 hgam2
theorem localizedForm_nonneg_of_mem_span_trunc {a a₀ : ℝ} (ha : 0 < a)
    (ha₀ : 0 < a₀) (ha₀a : a₀ < a) {N : ℕ}
    (hM : Matrix.PosSemidef (gramMatrix a (truncBasis a₀ a N)))
    {g : ℝ → ℂ}
    (hg : g ∈ Submodule.span ℝ (Set.range (truncBasis a₀ a N))) :
    0 ≤ RHLean.localizedForm a g := by
  have hboundT : ∀ i : Fin N ⊕ (Fin N ⊕ Fin N), ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ,
      ‖truncBasis a₀ a N i x‖ ≤ B := by
    intro i
    rcases i with i | i
    · exact exists_bound_oldBasis ha₀ i
    · rcases i with i | i
      · exact exists_bound_collarBasisRight ha₀a i
      · exact exists_bound_collarBasisLeft ha₀a i
  have hmeasT : ∀ i : Fin N ⊕ (Fin N ⊕ Fin N),
      Measurable (truncBasis a₀ a N i) := by
    intro i
    rcases i with i | i
    · exact measurable_oldBasis a₀ i
    · rcases i with i | i
      · exact measurable_collarBasisRight a₀ a i
      · exact measurable_collarBasisLeft a₀ a i
  have harchT : ∀ i : Fin N ⊕ (Fin N ⊕ Fin N), ∀ j : Fin N ⊕ (Fin N ⊕ Fin N),
      MeasureTheory.IntegrableOn
      (archBilinKernel (truncBasis a₀ a N i) (truncBasis a₀ a N j))
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume) := by
    intro i j
    rcases i with i | i
    · rcases j with j | j
      · exact integrableOn_archBilinKernel_full_oldBasis ha₀ ha₀a i j
      · rcases j with j | j
        · exact integrableOn_archBilinKernel_full_oldBasis_collarBasisRight
            ha₀ ha₀a i j
