        MeasureTheory.norm_integral_le_integral_norm
          (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
      simpa [Real.norm_eq_abs] using h1
    calc |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (h x * star (w y)).re|
        ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
            * (h x * star (w y)).re‖ := habsA
      _ ≤ ∫ y in Set.Ioo (-a) a, M * Bw * ‖h x‖ := hmono
      _ = (2 * a) * (M * Bw * ‖h x‖) := hfold
      _ = M * Bw * (2 * a) * ‖h x‖ := by ring
  have hker : Measurable (fun p : ℝ × ℝ =>
      RHLean.gammaKernel ‖p.1 - p.2‖) :=
    RHLean.GateII.Collar.measurable_gammaKernel.comp
      ((continuous_fst.sub continuous_snd).norm.measurable)
  have hprod1 : Measurable (fun p : ℝ × ℝ =>
      (w p.1 * star (h p.2)).re) :=
    Complex.continuous_re.measurable.comp
      ((hwm.comp measurable_fst).mul
        (continuous_star.measurable.comp (hhm.comp measurable_snd)))
  have hprod2 : Measurable (fun p : ℝ × ℝ =>
      (h p.1 * star (w p.2)).re) :=
    Complex.continuous_re.measurable.comp
      ((hhm.comp measurable_fst).mul
        (continuous_star.measurable.comp (hwm.comp measurable_snd)))
  have hA1m : MeasureTheory.AEStronglyMeasurable
      (fun x : ℝ => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (w x * star (h y)).re)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    have hfm : MeasureTheory.AEStronglyMeasurable
        (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
          * (w p.1 * star (h p.2)).re)
        (MeasureTheory.volume.prod
          (MeasureTheory.volume.restrict (Set.Ioo (-a) a))) :=
      (hker.mul hprod1).aestronglyMeasurable
    simpa only using (hfm.integral_prod_right').mono_measure
      MeasureTheory.Measure.restrict_le_self
  have hA2m : MeasureTheory.AEStronglyMeasurable
      (fun x : ℝ => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (h x * star (w y)).re)
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    have hfm : MeasureTheory.AEStronglyMeasurable
        (fun p : ℝ × ℝ => RHLean.gammaKernel ‖p.1 - p.2‖
          * (h p.1 * star (w p.2)).re)
        (MeasureTheory.volume.prod
          (MeasureTheory.volume.restrict (Set.Ioo (-a) a))) :=
      (hker.mul hprod2).aestronglyMeasurable
    simpa only using (hfm.integral_prod_right').mono_measure
      MeasureTheory.Measure.restrict_le_self
  have hintConst : MeasureTheory.IntegrableOn
      (fun _ : ℝ => M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖))
      (Set.Ioo (-a) a) MeasureTheory.volume := by
    have hc : Continuous
        (fun _ : ℝ => M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖)) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintDom2 : MeasureTheory.IntegrableOn
      (fun x : ℝ => M * Bw * (2 * a) * ‖h x‖) (Set.Ioo (-a) a)
      MeasureTheory.volume := by
    have hL := hintDom.const_mul (2 * a)
    have hEq : (fun x : ℝ => M * Bw * (2 * a) * ‖h x‖)
