theorem admissible_arch_inner_field (a : ℝ) (h g : ℝ → ℂ) (Lh Lg : ℝ)
    (ha : 0 ≤ a) (ch : Continuous h) (cg : Continuous g)
    (hLh : ∀ x y : ℝ, ‖h x - h y‖ ≤ |Lh| * ‖x - y‖)
    (hLg : ∀ x y : ℝ, ‖g x - g y‖ ≤ |Lg| * ‖x - y‖) :
    ∀ x : ℝ, IntegrableOn (fun y : ℝ =>
        ((h x - h y) * star (g x - g y)).re / ‖x - y‖)
      (Set.Ioo (-a) a) volume := by
  intro x
  set C := |Lh| * |Lg| * (|x| + a) with hCdef
  have hC0 : 0 ≤ C := by positivity
  refine IntegrableOn.of_bound measure_Ioo_lt_top ?hmeas C ?hbound
  · have hnum : Measurable (fun y : ℝ => ((h x - h y) * star (g x - g y)).re) := by fun_prop
    have hden : Measurable (fun y : ℝ => ‖x - y‖) :=
      ((continuous_const.sub continuous_id).norm.measurable)
    exact (hnum.div hden).aestronglyMeasurable
  · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy
    have hyn : ‖y‖ ≤ a := by
      rw [Real.norm_eq_abs, abs_le]
      exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hdist : ‖x - y‖ ≤ |x| + a := by
      calc ‖x - y‖ ≤ ‖x‖ + ‖y‖ := norm_sub_le x y
        _ = |x| + ‖y‖ := by rw [Real.norm_eq_abs]
        _ ≤ |x| + a := add_le_add (le_refl |x|) hyn
    have hnum : |((h x - h y) * star (g x - g y)).re| ≤
        |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ := by
      calc |((h x - h y) * star (g x - g y)).re| ≤ ‖(h x - h y) * star (g x - g y)‖ :=
            Complex.abs_re_le_norm _
        _ = ‖h x - h y‖ * ‖star (g x - g y)‖ := norm_mul ..
        _ = ‖h x - h y‖ * ‖g x - g y‖ := by rw [norm_star]
        _ ≤ (|Lh| * ‖x - y‖) * (|Lg| * ‖x - y‖) :=
            mul_le_mul (hLh x y) (hLg x y) (norm_nonneg _)
              (mul_nonneg (abs_nonneg _) (norm_nonneg _))
        _ = |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ := by ring
    rw [Real.norm_eq_abs, abs_div]
    by_cases hd : ‖x - y‖ = 0
    · rw [hd, abs_zero, div_zero]
      positivity
    · have hd0 : 0 < |‖x - y‖| := by positivity
      rw [div_le_iff₀ hd0, hCdef, abs_of_nonneg (norm_nonneg _)]
      have h1 : |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ ≤
          |Lh| * |Lg| * (|x| + a) * ‖x - y‖ := by
        have hB : 0 ≤ |Lh| * |Lg| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
        exact mul_le_mul (mul_le_mul_of_nonneg_left hdist hB) (le_refl _) (norm_nonneg _)
          (mul_nonneg hB (by positivity))
      nlinarith [hnum, h1]
theorem admissible_arch_outer_field (a : ℝ) (h g : ℝ → ℂ) (Lh Lg : ℝ)
    (ha : 0 ≤ a) (ch : Continuous h) (cg : Continuous g)
    (hLh : ∀ x y : ℝ, ‖h x - h y‖ ≤ |Lh| * ‖x - y‖)
    (hLg : ∀ x y : ℝ, ‖g x - g y‖ ≤ |Lg| * ‖x - y‖) :
    IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
        ((h x - h y) * star (g x - g y)).re / ‖x - y‖)
      (Set.Ioo (-a) a) volume := by
  set C := |Lh| * |Lg| * (2 * a) with hCdef
  have hC0 : 0 ≤ C := by positivity
  have hfin : volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hvol : (volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  refine IntegrableOn.of_bound hfin ?hmeas (C * (2 * a)) ?hbound
  · have hmeas : Measurable (fun p : ℝ × ℝ =>
        ((h p.1 - h p.2) * star (g p.1 - g p.2)).re / ‖p.1 - p.2‖) := by
      refine Measurable.div ?_ ?_
      · fun_prop
      · exact ((continuous_fst.sub continuous_snd).norm.measurable)
    have hf : AEStronglyMeasurable (fun p : ℝ × ℝ =>
        ((h p.1 - h p.2) * star (g p.1 - g p.2)).re / ‖p.1 - p.2‖)
        (volume.prod (volume.restrict (Set.Ioo (-a) a))) := hmeas.aestronglyMeasurable
    simpa only using (hf.integral_prod_right').mono_measure Measure.restrict_le_self
  · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
    have hxa : |x| ≤ a := by
      rw [abs_le]
      exact ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hC : ∀ y ∈ Set.Ioo (-a) a,
        ‖((h x - h y) * star (g x - g y)).re / ‖x - y‖‖ ≤ C := by
      intro y hy
      have hyn : |y| ≤ a := by
        rw [abs_le]
        exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      have hdist : ‖x - y‖ ≤ 2 * a := by
        calc ‖x - y‖ ≤ ‖x‖ + ‖y‖ := norm_sub_le x y
          _ = |x| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ 2 * a := by linarith
      have hnum : |((h x - h y) * star (g x - g y)).re| ≤
          |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ := by
        calc |((h x - h y) * star (g x - g y)).re| ≤ ‖(h x - h y) * star (g x - g y)‖ :=
              Complex.abs_re_le_norm _
          _ = ‖h x - h y‖ * ‖star (g x - g y)‖ := norm_mul ..
          _ = ‖h x - h y‖ * ‖g x - g y‖ := by rw [norm_star]
          _ ≤ (|Lh| * ‖x - y‖) * (|Lg| * ‖x - y‖) :=
              mul_le_mul (hLh x y) (hLg x y) (norm_nonneg _)
                (mul_nonneg (abs_nonneg _) (norm_nonneg _))
          _ = |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ := by ring
      rw [Real.norm_eq_abs, abs_div]
      by_cases hd : ‖x - y‖ = 0
      · rw [hd, abs_zero, div_zero]
        positivity
      · have hd0 : 0 < |‖x - y‖| := by positivity
        rw [div_le_iff₀ hd0, hCdef, abs_of_nonneg (norm_nonneg _)]
        have h1 : |Lh| * |Lg| * ‖x - y‖ * ‖x - y‖ ≤ |Lh| * |Lg| * (2 * a) * ‖x - y‖ := by
          have hB : 0 ≤ |Lh| * |Lg| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
          exact mul_le_mul (mul_le_mul_of_nonneg_left hdist hB) (le_refl _) (norm_nonneg _)
            (mul_nonneg hB (by positivity))
        nlinarith [hnum, h1]
    have hb := norm_setIntegral_le_of_norm_le_const (μ := volume) hfin hC
    rw [measureReal_def, hvol] at hb
    simpa only [mul_assoc] using hb
theorem admissible_of_bdd_lipschitz (a : ℝ) (h g : ℝ → ℂ) (B Lh Lg : ℝ)
    (ha : 0 < a) (ch : Continuous h) (cg : Continuous g)
    (bh : ∀ y : ℝ, ‖h y‖ ≤ B) (bg : ∀ y : ℝ, ‖g y‖ ≤ B)
    (hLh : ∀ x y : ℝ, ‖h x - h y‖ ≤ |Lh| * ‖x - y‖)
    (hLg : ∀ x y : ℝ, ‖g x - g y‖ ≤ |Lg| * ‖x - y‖) :
    Y7GateIIAdd.Admissible a h g := by
  have h0 : 0 ≤ a := le_of_lt ha
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact admissible_arch_inner_field a h g Lh Lg h0 ch cg hLh hLg
  · exact admissible_arch_outer_field a h g Lh Lg h0 ch cg hLh hLg
  · exact admissible_mass_field a h g B ch cg (fun x _ => bh x) (fun x _ => bg x)
  · exact admissible_potential_field a h g B ha ch cg (fun x _ => bh x) (fun x _ => bg x)
  · exact admissible_gamma_inner_field a h g B h0 cg (fun y _ => bg y)
  · exact admissible_gamma_outer_field a h g B h0 ch cg (fun x _ => bh x) (fun y _ => bg y)
  · exact admissible_gammaK_inner_field a h g B h0 ch (fun y _ => bh y)
  · exact admissible_gammaK_outer_field a h g B h0 ch cg (fun x _ => bh x) (fun y _ => bg y)
  · exact admissible_polar_field a h B h0 ch (fun x _ => bh x)
  · exact admissible_shift_first_field a h g B B ch cg bh bg
  · exact admissible_shift_second_field a h g B B ch cg bh bg
end Y7GateIIAdd
