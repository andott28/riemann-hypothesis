                  = |RHLean.endpointPotential a x| := RCLike.norm_ofReal _
              rw [h1]))
    _ ≤ Bw * (Real.sqrt (∫ x in Set.Ioo (-a) a,
            ‖((RHLean.endpointPotential a x : ℝ) : ℂ)‖ ^ 2)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2)) :=
        mul_le_mul_of_nonneg_left hcs hBw0
    _ = Bw * (Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖h x‖ ^ 2)) := by
          have hintcongr : ∫ x in Set.Ioo (-a) a,
              ‖((RHLean.endpointPotential a x : ℝ) : ℂ)‖ ^ 2
            = ∫ x in Set.Ioo (-a) a,
              (RHLean.endpointPotential a x) ^ 2 :=
            MeasureTheory.setIntegral_congr_ae measurableSet_Ioo
              (MeasureTheory.ae_of_all _ (fun x _ => by
                have h1 : ‖((RHLean.endpointPotential a x : ℝ) : ℂ)‖
                    = |RHLean.endpointPotential a x| := RCLike.norm_ofReal _
                rw [h1, sq_abs]))
          rw [hintcongr]
    _ ≤ Bw * (Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2)) := by
          refine mul_le_mul_of_nonneg_left ?_ hBw0
          refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
          refine Real.sqrt_le_sqrt ?_
          exact MeasureTheory.setIntegral_mono_set hhint
            (MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖h x‖)))
            (MeasureTheory.ae_of_all _ (fun x hx => by
              constructor <;> linarith [(Set.mem_Ioo.mp hx).1,
                (Set.mem_Ioo.mp hx).2]))
    _ = Bw * Real.sqrt (∫ x in Set.Ioo (-a) a,
            (RHLean.endpointPotential a x) ^ 2)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by ring
private theorem gammaBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (Bw Bh M : ℝ)
    (ha : 0 < a)
    (hwm : Measurable w) (hhm : Measurable h)
    (hwB : ∀ x : ℝ, ‖w x‖ ≤ Bw) (hhB : ∀ x : ℝ, ‖h x‖ ≤ Bh)
    (hM : ∀ z : ℝ, 0 ≤ z → z ≤ 2 * a → |RHLean.gammaKernel z| ≤ M)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.gammaBilin a w h|
      ≤ M * Bw * (2 * a) * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hintSq : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hintNorm : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    integrableOn_norm_of_sq hhm hintSq hfin
  have hintDom : MeasureTheory.IntegrableOn
      (fun x : ℝ => M * Bw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
    hintNorm.const_mul (M * Bw)
  have hH2 := l1_Ioo_le_fat a h ha hhm hhint
  have hvol : (MeasureTheory.volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hru : (MeasureTheory.volume.restrict (Set.Ioo (-a) a)).real
      Set.univ = 2 * a := by
    show ENNReal.toReal ((MeasureTheory.volume.restrict (Set.Ioo (-a) a))
        Set.univ) = 2 * a
    rw [MeasureTheory.Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  have hM0 : 0 ≤ M := by
    have h1 : |RHLean.gammaKernel 0| = 1 / 4 := by
      rw [RHLean.gammaKernel_zero]
      exact abs_of_nonneg (by norm_num)
    have h2 := hM 0 (by norm_num) (by linarith)
    rw [h1] at h2
    exact le_trans (by norm_num : (0 : ℝ) ≤ 1 / 4) h2
  have hBw0 : 0 ≤ Bw := le_trans (norm_nonneg _) (hwB 0)
  have hMB : ∀ p : ℝ × ℝ, p ∈ Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a →
      |RHLean.gammaKernel ‖p.1 - p.2‖| ≤ M := by
    intro p hp
    have hp1 : |p.1| < a := by
      rw [abs_lt]
      constructor <;> linarith [(Set.mem_Ioo.mp hp.1).1, (Set.mem_Ioo.mp hp.1).2]
    have hp2 : |p.2| < a := by
      rw [abs_lt]
      constructor <;> linarith [(Set.mem_Ioo.mp hp.2).1, (Set.mem_Ioo.mp hp.2).2]
    have hdist : ‖p.1 - p.2‖ ≤ 2 * a := by
      calc ‖p.1 - p.2‖ ≤ ‖p.1‖ + ‖p.2‖ := norm_sub_le _ _
        _ = |p.1| + |p.2| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ 2 * a := by linarith
    exact hM ‖p.1 - p.2‖ (norm_nonneg _) hdist
  have hpt1 : ∀ x : ℝ, ∀ y : ℝ, x ∈ Set.Ioo (-a) a → y ∈ Set.Ioo (-a) a →
      ‖RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re‖
        ≤ M * Bw * ‖h y‖ := by
    intro x y hx hy
    have hkerB := hMB (x, y) ⟨hx, hy⟩
    rw [Real.norm_eq_abs, abs_mul]
    calc |RHLean.gammaKernel ‖x - y‖| * |(w x * star (h y)).re|
        ≤ |RHLean.gammaKernel ‖x - y‖| * (‖w x‖ * ‖h y‖) := by
          refine mul_le_mul (le_refl _) ?_ (abs_nonneg _) (abs_nonneg _)
          exact le_trans (Complex.abs_re_le_norm _)
            (le_of_eq (by rw [norm_mul, norm_star]))
      _ ≤ M * (Bw * ‖h y‖) := by
          refine mul_le_mul hkerB ?_ (mul_nonneg (norm_nonneg _)
            (norm_nonneg _)) hM0
          exact mul_le_mul_of_nonneg_right (hwB x) (norm_nonneg _)
      _ = M * Bw * ‖h y‖ := by ring
  have hpt2 : ∀ x : ℝ, ∀ y : ℝ, x ∈ Set.Ioo (-a) a → y ∈ Set.Ioo (-a) a →
      ‖RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re‖
        ≤ M * Bw * ‖h x‖ := by
    intro x y hx hy
    have hkerB := hMB (x, y) ⟨hx, hy⟩
    rw [Real.norm_eq_abs, abs_mul]
    calc |RHLean.gammaKernel ‖x - y‖| * |(h x * star (w y)).re|
        ≤ |RHLean.gammaKernel ‖x - y‖| * (‖h x‖ * ‖w y‖) := by
          refine mul_le_mul (le_refl _) ?_ (abs_nonneg _) (abs_nonneg _)
          exact le_trans (Complex.abs_re_le_norm _)
            (le_of_eq (by rw [norm_mul, norm_star]))
      _ ≤ M * (‖h x‖ * Bw) := by
          refine mul_le_mul hkerB ?_ (mul_nonneg (norm_nonneg _)
            (norm_nonneg _)) hM0
          exact mul_le_mul_of_nonneg_left (hwB y) (norm_nonneg _)
      _ = M * Bw * ‖h x‖ := by ring
  have hintInner1 : ∀ x ∈ Set.Ioo (-a) a,
      MeasureTheory.IntegrableOn
        (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re)
        (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro x hx
    have hmeas : MeasureTheory.AEStronglyMeasurable
        (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re)
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
      ((RHLean.GateII.Collar.measurable_gammaKernel.comp
        ((continuous_const.sub continuous_id).norm.measurable)).mul
        (Complex.continuous_re.measurable.comp
          ((measurable_const).mul
            (continuous_star.measurable.comp hhm)))).aestronglyMeasurable
    refine MeasureTheory.IntegrableOn.of_bound hfin hmeas (M * Bw * Bh) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy
    have hstep : ‖RHLean.gammaKernel ‖x - y‖
        * (w x * star (h y)).re‖ ≤ M * Bw * Bh :=
      le_trans (hpt1 x y hx hy)
        (mul_le_mul (le_refl _) (hhB y) (norm_nonneg _)
          (mul_nonneg hM0 hBw0))
    exact hstep
  have hintInner2 : ∀ x ∈ Set.Ioo (-a) a,
      MeasureTheory.IntegrableOn
        (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re)
        (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro x hx
    have hmeas : MeasureTheory.AEStronglyMeasurable
        (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re)
        (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) :=
      ((RHLean.GateII.Collar.measurable_gammaKernel.comp
        ((continuous_const.sub continuous_id).norm.measurable)).mul
        (Complex.continuous_re.measurable.comp
          ((measurable_const).mul
            (continuous_star.measurable.comp hwm)))).aestronglyMeasurable
    refine MeasureTheory.IntegrableOn.of_bound hfin hmeas (M * Bw * Bh) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with y hy
    have hstep : ‖RHLean.gammaKernel ‖x - y‖
        * (h x * star (w y)).re‖ ≤ M * Bw * Bh :=
      le_trans (hpt2 x y hx hy)
        (mul_le_mul (le_refl _) (hhB x) (norm_nonneg _)
          (mul_nonneg hM0 hBw0))
    exact hstep
  have hval1 : ∀ x ∈ Set.Ioo (-a) a,
      |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (w x * star (h y)).re|
      ≤ M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖) := by
    intro x hx
    have hmono : ∫ y in Set.Ioo (-a) a,
        ‖RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re‖
        ≤ ∫ y in Set.Ioo (-a) a, M * Bw * ‖h y‖ :=
      MeasureTheory.setIntegral_mono_ae_restrict
        (f := fun y : ℝ => ‖RHLean.gammaKernel ‖x - y‖
          * (w x * star (h y)).re‖)
        (g := fun y : ℝ => M * Bw * ‖h y‖)
        (hf := (hintInner1 x hx).abs) (hg := hintDom)
        (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo]
            with y hy
            exact hpt1 x y hx hy)
    have hfold : ∫ y in Set.Ioo (-a) a, M * Bw * ‖h y‖
        = M * Bw * ∫ y in Set.Ioo (-a) a, ‖h y‖ := integral_const_mul _ _
    have habsA : |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (w x * star (h y)).re|
        ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
            * (w x * star (h y)).re‖ := by
      have h1 : ‖∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (w x * star (h y)).re‖
          ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
              * (w x * star (h y)).re‖ :=
        MeasureTheory.norm_integral_le_integral_norm
          (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
      simpa [Real.norm_eq_abs] using h1
    calc |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (w x * star (h y)).re|
        ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
            * (w x * star (h y)).re‖ := habsA
      _ ≤ M * Bw * ∫ y in Set.Ioo (-a) a, ‖h y‖ := by
          rw [← hfold]
          exact hmono
  have hval2 : ∀ x ∈ Set.Ioo (-a) a,
      |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (h x * star (w y)).re|
      ≤ M * Bw * (2 * a) * ‖h x‖ := by
    intro x hx
    have hintConst : MeasureTheory.IntegrableOn
        (fun _ : ℝ => M * Bw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume := by
      have hc : Continuous (fun _ : ℝ => M * Bw * ‖h x‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hmono : ∫ y in Set.Ioo (-a) a,
        ‖RHLean.gammaKernel ‖x - y‖ * (h x * star (w y)).re‖
        ≤ ∫ y in Set.Ioo (-a) a, M * Bw * ‖h x‖ :=
      MeasureTheory.setIntegral_mono_ae_restrict
        (f := fun y : ℝ => ‖RHLean.gammaKernel ‖x - y‖
          * (h x * star (w y)).re‖)
        (g := fun _ : ℝ => M * Bw * ‖h x‖)
        (hf := (hintInner2 x hx).abs) (hg := hintConst)
        (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo]
            with y hy
            exact hpt2 x y hx hy)
    have hfold : ∫ y in Set.Ioo (-a) a, M * Bw * ‖h x‖
        = (2 * a) * (M * Bw * ‖h x‖) := by
      rw [integral_const (c := M * Bw * ‖h x‖)
        (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
    have habsA : |∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
        * (h x * star (w y)).re|
        ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
            * (h x * star (w y)).re‖ := by
      have h1 : ‖∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (h x * star (w y)).re‖
          ≤ ∫ y in Set.Ioo (-a) a, ‖RHLean.gammaKernel ‖x - y‖
