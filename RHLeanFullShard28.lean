  have hL : RHLean.GateII.Reduction.archBilin a f g
      = (1 / 4) * ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.GateII.Reduction.archBilinKernel f g (x, y) := rfl
  rw [hL,
    show ∫ p in Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a,
        RHLean.GateII.Reduction.archBilinKernel f g p
        ∂(MeasureTheory.volume.prod MeasureTheory.volume)
      = ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.GateII.Reduction.archBilinKernel f g (x, y)
      from MeasureTheory.setIntegral_prod _ hK]
