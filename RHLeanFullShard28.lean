theorem NsetTerm_div2_le (k : ℕ) (hk : X0 ≤ k) :
    NsetTerm k (k / 2) ≤ 2 / (k : ℝ) ^ 2 := by
  have hX0pos : (0 : ℝ) < (X0 : ℝ) := by norm_num [X0]
  have hkX : (X0 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hkpos : (0 : ℝ) < (k : ℝ) := lt_of_lt_of_le hX0pos hkX
  have hX0one : (1 : ℝ) < (X0 : ℝ) := by norm_num [X0]
  have hk1 : (1 : ℝ) < (k : ℝ) := lt_of_lt_of_le hX0one hkX
  have hmpos_nat : 0 < k / 2 := by
    have : 2 ≤ k := by
      have : 2 ≤ X0 := by norm_num [X0]
      omega
    omega
  have hmpos : (0 : ℝ) < ((k / 2 : ℕ) : ℝ) := by exact_mod_cast hmpos_nat
  have hm3 : k / 3 < k / 2 := by
    have : 6 ≤ k := by
      have : 6 ≤ X0 := by norm_num [X0]
      omega
    omega
  set S : Finset ℕ := (Nset k (k / 2)).filter (fun n => Nat.Prime n) with hS
  have hsub : S ⊆ ({2} : Finset ℕ) := by
    simpa [hS] using RHLean.GateII.Tail.Nset_prime_tail_subset_two (k := k) (m := k / 2) hm3
  set f : ℕ → ℝ := fun n =>
    (Lambda n - cBin k (k / 2) * (n : ℝ)) ^ 2 / (n : ℝ) with hf
  set r : ℝ := (k : ℝ) / ((k / 2 : ℕ) : ℝ) with hr
  have hr2 : (2 : ℝ) ≤ r := by
    rw [hr, le_div_iff₀ hmpos]
    have hmle : ((k / 2 : ℕ) : ℝ) ≤ (k : ℝ) / 2 := Nat.cast_div_le
    nlinarith
  have hrpos : (0 : ℝ) < r := lt_of_lt_of_le (by norm_num) hr2
  have hk_le_two_m_add_one : k ≤ 2 * (k / 2) + 1 := by omega
  have hkR_le : (k : ℝ) ≤ 2 * ((k / 2 : ℕ) : ℝ) + 1 := by
    exact_mod_cast hk_le_two_m_add_one
  have hr_upper : r ≤ 2 + 2 / ((k : ℝ) - 1) := by
    have hk1pos : (0 : ℝ) < (k : ℝ) - 1 := by linarith
    have hdiv : (k : ℝ) / ((k / 2 : ℕ) : ℝ)
        ≤ (2 * ((k / 2 : ℕ) : ℝ) + 1) / ((k / 2 : ℕ) : ℝ) := by
      exact div_le_div_of_nonneg_right hkR_le hmpos.le
    have hone : (1 : ℝ) / ((k / 2 : ℕ) : ℝ) ≤ 2 / ((k : ℝ) - 1) := by
      rw [div_le_div_iff₀ hmpos hk1pos]
      nlinarith [hk_le_two_m_add_one, hmpos]
    have heq : (2 * ((k / 2 : ℕ) : ℝ) + 1) / ((k / 2 : ℕ) : ℝ)
        = 2 + 1 / ((k / 2 : ℕ) : ℝ) := by
      field_simp
    calc r = (k : ℝ) / ((k / 2 : ℕ) : ℝ) := rfl
      _ ≤ (2 * ((k / 2 : ℕ) : ℝ) + 1) / ((k / 2 : ℕ) : ℝ) := hdiv
      _ = 2 + 1 / ((k / 2 : ℕ) : ℝ) := heq
      _ ≤ 2 + 2 / ((k : ℝ) - 1) := by linarith
  set d : ℝ := r - 2 with hd
  have hd0 : 0 ≤ d := by rw [hd]; linarith
  have hd_le : d ≤ 2 / ((k : ℝ) - 1) := by rw [hd]; linarith
  set g : ℝ := Real.log 2 - cBin k (k / 2) * 2 with hg
  have hcbin : cBin k (k / 2) * 2 = (2 / r) * Real.log r := by
    unfold cBin Lb
    rw [hr]
    field_simp
  have hlogr : Real.log r = Real.log 2 + Real.log (r / 2) := by
    have hr_eq : r = 2 * (r / 2) := by field_simp
    rw [hr_eq, Real.log_mul (by norm_num) (by positivity)]
    congr 1
    field_simp
  have hg_eq : g = Real.log 2 * (1 - 2 / r) - (2 / r) * Real.log (r / 2) := by
    rw [hg, hcbin, hlogr]
    ring
  have h1 : |1 - 2 / r| ≤ d / 2 := by
    have hnonneg : 0 ≤ 1 - 2 / r := by
      rw [sub_nonneg]
      rw [div_le_one hrpos]
      linarith
    rw [abs_of_nonneg hnonneg]
    have heq : 1 - 2 / r = d / r := by
      rw [hd]
      field_simp
    rw [heq]
    exact div_le_div_of_nonneg_left hd0 (by norm_num : (0 : ℝ) < 2) hr2
  have h2 : |Real.log (r / 2)| ≤ d / 2 := by
    have hr2pos : (0 : ℝ) < r / 2 := by positivity
    have hge1 : (1 : ℝ) ≤ r / 2 := by linarith
    rw [abs_of_nonneg (Real.log_nonneg hge1)]
    have hlog_le : Real.log (r / 2) ≤ r / 2 - 1 := Real.log_le_sub_one_of_pos hr2pos
    have heq : r / 2 - 1 = d / 2 := by rw [hd]; ring
    linarith
  have hlog2nonneg : (0 : ℝ) ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hg_abs : |g| ≤ 2 / (k : ℝ) := by
    have htri : |g| ≤ Real.log 2 * |1 - 2 / r| + (2 / r) * |Real.log (r / 2)| := by
      rw [hg_eq]
      calc |Real.log 2 * (1 - 2 / r) - (2 / r) * Real.log (r / 2)|
          ≤ |Real.log 2 * (1 - 2 / r)| + |(2 / r) * Real.log (r / 2)| := abs_sub _ _
        _ = Real.log 2 * |1 - 2 / r| + (2 / r) * |Real.log (r / 2)| := by
            rw [abs_mul, abs_mul, abs_of_nonneg hlog2nonneg,
              abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 / r)]
    have h2r_le_one : 2 / r ≤ 1 := by
      rw [div_le_one hrpos]
      linarith
    have hstep : Real.log 2 * |1 - 2 / r| + (2 / r) * |Real.log (r / 2)|
        ≤ Real.log 2 * (d / 2) + 1 * (d / 2) := by
      gcongr
    have hconst : Real.log 2 * (d / 2) + 1 * (d / 2) ≤ 0.85 * d := by
      nlinarith [Real.log_two_lt_d9]
    have hd_bound : 0.85 * d ≤ 1.7 / ((k : ℝ) - 1) := by
      calc 0.85 * d ≤ 0.85 * (2 / ((k : ℝ) - 1)) := by
            exact mul_le_mul_of_nonneg_left hd_le (by norm_num)
        _ = 1.7 / ((k : ℝ) - 1) := by ring
    have hk1pos : (0 : ℝ) < (k : ℝ) - 1 := by linarith
    have hfinal : 1.7 / ((k : ℝ) - 1) ≤ 2 / (k : ℝ) := by
      rw [div_le_div_iff₀ hk1pos hkpos]
      have hX0seven : (20 : ℝ) ≤ (X0 : ℝ) := by norm_num [X0]
      nlinarith [hkX, hX0seven]
    linarith
  rw [NsetTerm]
  change (∑ n ∈ S, (Lambda n - cBin k (k / 2) * (n : ℝ)) ^ 2 / (n : ℝ))
      ≤ 2 / (k : ℝ) ^ 2
  by_cases h2S : 2 ∈ S
  · have hsum : (∑ n ∈ S, (Lambda n - cBin k (k / 2) * (n : ℝ)) ^ 2 / (n : ℝ))
        = (Lambda 2 - cBin k (k / 2) * (2 : ℝ)) ^ 2 / (2 : ℝ) := by
      refine Finset.sum_eq_single 2 ?_ ?_
      · intro b hb hb2
        exact absurd (by simpa using hsub hb) hb2
      · intro hnot
        exact absurd h2S hnot
    rw [hsum]
    have hΛ2 : Lambda 2 = Real.log 2 := by
      rw [Lambda, ArithmeticFunction.vonMangoldt_apply_prime (by norm_num : Nat.Prime 2)]
      norm_num
    rw [hΛ2]
    norm_num
    have hgsq : g ^ 2 ≤ (2 / (k : ℝ)) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg g) hg_abs 2
    have hgterm : (Real.log 2 - cBin k (k / 2) * (2 : ℝ)) ^ 2 / 2
        = g ^ 2 / 2 := by
      rw [hg]
    rw [hgterm]
    calc g ^ 2 / 2 ≤ (2 / (k : ℝ)) ^ 2 / 2 := by
          exact div_le_div_of_nonneg_right hgsq (by norm_num)
      _ = 2 / (k : ℝ) ^ 2 := by
          field_simp
  · have hSempty : S = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro n hn
      have h2n : n = 2 := by simpa using hsub hn
      exact h2S (h2n ▸ hn)
    rw [hSempty, Finset.sum_empty]
    positivity
end RHLean.GateII.BClosure
