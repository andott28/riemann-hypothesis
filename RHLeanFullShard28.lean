      (Matrix.of (fun i j : oddInit k =>
        Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ))).PosSemidef →
      (Matrix.of (fun i j : oddInit (k + 1) =>
        Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ))).PosSemidef) :
    Y7Density.MatrixBlocksPos a := by
  refine matrixBlocksPos_of_nested_posSemidef (fun N => ?_)
  by_cases hN : N ≤ N₀
  · have hsub : oddInit N ⊆ oddInit N₀ := by
      intro m hm
      simp only [oddInit, Finset.mem_filter, Finset.mem_range] at hm ⊢
      exact ⟨by omega, hm.2⟩
