private lemma memLp_two_of_continuous' {f : ℝ → ℂ} (hf : Continuous f) :
    MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) := by
  have hcont : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := hf.norm.pow 2
  have hint : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2) (Set.Icc (-1 : ℝ) 1) volume :=
    hcont.integrableOn_Icc
  exact (memLp_two_iff_integrable_sq_norm hf.measurable.aestronglyMeasurable).mpr
    (hint.mono_set Set.Ioo_subset_Icc_self)
private lemma l2_integral_mul_le' {f g : ℝ → ℂ}
    (hf : MemLp f 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)))
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1))) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ * ‖g x‖)
      ≤ Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖f x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have h := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (f := f) (g := g) (p := (2 : ℝ)) (q := (2 : ℝ))
    Real.HolderConjugate.two_two (by simpa using hf) (by simpa using hg)
  simp_rw [Real.rpow_two] at h
  rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at h
  simpa using h
theorem abs_kernelForm_le {K : ℝ → ℝ} (hK : Measurable K) {C : ℝ} (hC0 : 0 ≤ C)
    (hKbound : ∀ z ∈ Set.Icc (0 : ℝ) 2, |K z| ≤ C)
    {g : ℝ → ℂ} (hg : Continuous g) :
    |∫ x in Set.Ioo (-1 : ℝ) 1, (∫ y in Set.Ioo (-1 : ℝ) 1,
        K ‖x - y‖ * (g x * star (g y)).re ∂volume) ∂volume|
      ≤ (2 * C) * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  set μ : Measure ℝ := volume.restrict (Set.Ioo (-1 : ℝ) 1) with hμ
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hg.continuousOn
  set B' : ℝ := max B 0 with hB'def
  have hB'0 : 0 ≤ B' := le_max_right _ _
  have hB'ub : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖g x‖ ≤ B' := fun x hx =>
    le_trans (hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩) (le_max_left _ _)
  have hdist : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ∀ y ∈ Set.Ioo (-1 : ℝ) 1, ‖x - y‖ ≤ 2 := by
    intro x hx y hy
    rw [Real.norm_eq_abs, abs_sub_le_iff]
    exact ⟨by linarith [hx.2, hy.1], by linarith [hy.2, hx.1]⟩
  have hKpt : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ∀ y ∈ Set.Ioo (-1 : ℝ) 1,
      ‖K ‖x - y‖ * (g x * star (g y)).re‖
        ≤ C * (‖g x‖ * ‖g y‖) := by
    intro x hx y hy
    have hk : |K ‖x - y‖| ≤ C := by
      rw [← Real.norm_eq_abs]
      exact hKbound ‖x - y‖ ⟨norm_nonneg _, hdist x hx y hy⟩
    have hr : |(g x * star (g y)).re| ≤ ‖g x‖ * ‖g y‖ := by
      calc
        |(g x * star (g y)).re| ≤ ‖g x * star (g y)‖ := Complex.abs_re_le_norm _
        _ = ‖g x‖ * ‖g y‖ := by rw [norm_mul, norm_star]
    calc
      ‖K ‖x - y‖ * (g x * star (g y)).re‖
          = |K ‖x - y‖| * |(g x * star (g y)).re| := by
              simp only [norm_mul, Real.norm_eq_abs]
      _ ≤ C * (‖g x‖ * ‖g y‖) := mul_le_mul hk hr (abs_nonneg _) hC0
  have hKpt_uniform : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ∀ y ∈ Set.Ioo (-1 : ℝ) 1,
      ‖K ‖x - y‖ * (g x * star (g y)).re‖ ≤ C * (B' * B') := by
    intro x hx y hy
    refine le_trans (hKpt x hx y hy) ?_
    exact mul_le_mul_of_nonneg_left
      (mul_le_mul (hB'ub x hx) (hB'ub y hy) (norm_nonneg _) hB'0) hC0
  have hvolμ : μ Set.univ = ENNReal.ofReal 2 := by
    show (volume.restrict (Set.Ioo (-1 : ℝ) 1)) Set.univ = ENNReal.ofReal 2
    rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo]
    congr 1
    norm_num
  haveI hμfin : IsFiniteMeasure μ :=
    ⟨by rw [hvolμ]; exact ENNReal.ofReal_lt_top⟩
  haveI hprod : IsFiniteMeasure (μ.prod μ) := inferInstance
  have hmeas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re) (μ.prod μ) := by
    refine Measurable.aestronglyMeasurable ?_
    exact (hK.comp (continuous_abs.measurable.comp
        (measurable_fst.sub measurable_snd))).mul
      (Complex.measurable_re.comp
        (((hg.measurable.comp measurable_fst).mul
          (continuous_star.measurable.comp (hg.measurable.comp measurable_snd)))))
  have hF_int : Integrable (fun p : ℝ × ℝ =>
      K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re) (μ.prod μ) := by
    refine Integrable.of_bound hmeas (C * (B' * B')) ?_
    rw [Measure.prod_restrict]
    filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with p hp
    exact hKpt_uniform p.1 hp.1 p.2 hp.2
  have hbnd_meas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      C * (‖g p.1‖ * ‖g p.2‖)) (μ.prod μ) := by
    refine Measurable.aestronglyMeasurable ?_
    exact measurable_const.mul
      (((hg.measurable.comp measurable_fst).norm).mul
        ((hg.measurable.comp measurable_snd).norm))
  have hbnd_int : Integrable (fun p : ℝ × ℝ =>
      C * (‖g p.1‖ * ‖g p.2‖)) (μ.prod μ) := by
    refine Integrable.of_bound hbnd_meas (C * (B' * B')) ?_
    rw [Measure.prod_restrict]
    filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with p hp
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left
      (mul_le_mul (hB'ub p.1 hp.1) (hB'ub p.2 hp.2) (norm_nonneg _) hB'0)
      hC0
  have hbnd_raw_meas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      ‖g p.1‖ * ‖g p.2‖) (μ.prod μ) := by
    refine Measurable.aestronglyMeasurable ?_
    exact ((hg.measurable.comp measurable_fst).norm).mul
      ((hg.measurable.comp measurable_snd).norm)
  have hbnd_raw_int : Integrable (fun p : ℝ × ℝ => ‖g p.1‖ * ‖g p.2‖) (μ.prod μ) := by
    refine Integrable.of_bound hbnd_raw_meas (B' * B') ?_
    rw [Measure.prod_restrict]
    filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with p hp
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul (hB'ub p.1 hp.1) (hB'ub p.2 hp.2) (norm_nonneg _) hB'0
  have hint_eq : (∫ p, K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re ∂(μ.prod μ))
      = ∫ x in Set.Ioo (-1 : ℝ) 1, (∫ y in Set.Ioo (-1 : ℝ) 1,
          K ‖x - y‖ * (g x * star (g y)).re ∂volume) ∂volume := by
    simp only [hμ]
    exact (MeasureTheory.integral_prod
      (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
      (fun p : ℝ × ℝ => K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re) hF_int)
  have hmemg : MemLp g 2 μ := memLp_two_of_continuous' hg
  have hmem1 : MemLp (fun _ : ℝ => (1 : ℂ)) 2 μ :=
    memLp_two_of_continuous' continuous_const
  have hcs := l2_integral_mul_le' hmemg hmem1
  have hInt1 : (∫ x in Set.Ioo (-1 : ℝ) 1, ‖(1 : ℂ)‖ ^ 2) = 2 := by
    have hc : (∫ x in Set.Ioo (-1 : ℝ) 1, (1 : ℝ)) = 2 := by
      rw [integral_const]
      simp only [smul_eq_mul, mul_one, Measure.real]
      rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioo,
        ENNReal.toReal_ofReal (by norm_num)]
      norm_num
    simpa using hc
  have hcs_eta : (∫ x, ‖g x‖ ∂μ)
      ≤ Real.sqrt (∫ x, ‖g x‖ ^ 2 ∂μ) * Real.sqrt 2 := by
    have h := hcs
    simp only [hμ] at h ⊢
    rw [hInt1] at h
    simpa only [norm_one, mul_one] using h
  have hL2 : (∫ x, ‖g x‖ ∂μ) ^ 2 ≤ 2 * (∫ x, ‖g x‖ ^ 2 ∂μ) := by
    have hL0 : 0 ≤ ∫ x, ‖g x‖ ∂μ := integral_nonneg (fun x => norm_nonneg _)
    have hmass0 : 0 ≤ ∫ x, ‖g x‖ ^ 2 ∂μ := integral_nonneg (fun x => sq_nonneg _)
    have hpow := pow_le_pow_left₀ hL0 hcs_eta 2
    rw [mul_pow, Real.sq_sqrt hmass0, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)] at hpow
    linarith
  have hmain : |∫ p, K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re ∂(μ.prod μ)|
      ≤ (2 * C) * (∫ x, ‖g x‖ ^ 2 ∂μ) := by
    calc
      |∫ p, K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re ∂(μ.prod μ)|
        ≤ ∫ p, ‖K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re‖ ∂(μ.prod μ) := by
          simpa only [Real.norm_eq_abs] using
            MeasureTheory.norm_integral_le_integral_norm
              (fun p : ℝ × ℝ => K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re)
      _ ≤ ∫ p, C * (‖g p.1‖ * ‖g p.2‖) ∂(μ.prod μ) := by
          refine integral_mono_ae hF_int.norm hbnd_int ?_
          rw [Measure.prod_restrict]
          filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with p hp
          exact hKpt p.1 hp.1 p.2 hp.2
      _ = C * ((∫ x, ‖g x‖ ∂μ) * (∫ x, ‖g x‖ ∂μ)) := by
          rw [MeasureTheory.integral_const_mul]
          congr 1
          calc
            (∫ p, ‖g p.1‖ * ‖g p.2‖ ∂(μ.prod μ))
              = ∫ x, ∫ y, ‖g x‖ * ‖g y‖ ∂μ ∂μ :=
                MeasureTheory.integral_prod (fun p : ℝ × ℝ => ‖g p.1‖ * ‖g p.2‖) hbnd_raw_int
            _ = ∫ x, ‖g x‖ * (∫ y, ‖g y‖ ∂μ) ∂μ := by
                apply integral_congr_ae
                filter_upwards with x
                rw [MeasureTheory.integral_const_mul]
            _ = (∫ x, ‖g x‖ ∂μ) * (∫ y, ‖g y‖ ∂μ) := by
                rw [MeasureTheory.integral_mul_const]
      _ = C * (∫ x, ‖g x‖ ∂μ) ^ 2 := by ring
      _ ≤ C * (2 * (∫ x, ‖g x‖ ^ 2 ∂μ)) :=
          mul_le_mul_of_nonneg_left hL2 hC0
      _ = (2 * C) * (∫ x, ‖g x‖ ^ 2 ∂μ) := by ring
  calc
    |∫ x in Set.Ioo (-1 : ℝ) 1, (∫ y in Set.Ioo (-1 : ℝ) 1,
        K ‖x - y‖ * (g x * star (g y)).re ∂volume) ∂volume|
      = |∫ p, K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re ∂(μ.prod μ)| := by
          rw [hint_eq]
    _ ≤ (2 * C) * (∫ x, ‖g x‖ ^ 2 ∂μ) := hmain
    _ = (2 * C) * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by rw [hμ]
noncomputable def gammaModelKernel (a z : ℝ) : ℝ :=
  a * (Y7Density.rhoTrunc 240).eval (a * z)
noncomputable def gammaErrorKernel (a z : ℝ) : ℝ :=
  RHLean.gammaKernelRescaled a z - gammaModelKernel a z
lemma gammaErrorKernel_eq (a z : ℝ) :
    gammaErrorKernel a z =
      a * (RHLean.gammaKernel (a * z) -
        (Y7Density.rhoTrunc 240).eval (a * z)) := by
  unfold gammaErrorKernel gammaModelKernel RHLean.gammaKernelRescaled
  ring
lemma abs_gammaErrorKernel_le {a : ℝ} (ha0 : 0 ≤ a)
    (ha : 2 * a < (14 : ℝ) / 5)
    {z : ℝ} (hz : z ∈ Set.Icc (0 : ℝ) 2) :
    |gammaErrorKernel a z| ≤ Y7Chain.epsilonGamma a / 2 := by
  have hz' : a * z ∈ Set.Icc (0 : ℝ) (2 * a) := by
    constructor
    · exact mul_nonneg ha0 hz.1
    · nlinarith [hz.2, ha0]
  have h := (Y7Density.gammaTaylorRemainderLeaf_240 ha0 ha) (a * z) hz'
  rw [gammaErrorKernel_eq, abs_mul, abs_of_nonneg ha0]
  calc
    a * |RHLean.gammaKernel (a * z) - (Y7Density.rhoTrunc 240).eval (a * z)|
        ≤ a * (Y7Chain.gammaM (14 / 5) * (2 * a / (14 / 5)) ^ 241
            / (1 - 2 * a / (14 / 5))) :=
          mul_le_mul_of_nonneg_left h ha0
    _ = Y7Chain.epsilonGamma a / 2 := by
          unfold Y7Chain.epsilonGamma
          ring
private lemma integrable_kernel_prod {K : ℝ → ℝ} (hK : Measurable K)
    {C : ℝ} (hC0 : 0 ≤ C)
    (hKbound : ∀ z ∈ Set.Icc (0 : ℝ) 2, |K z| ≤ C)
    {g : ℝ → ℂ} (hg : Continuous g) :
    Integrable (fun p : ℝ × ℝ =>
        K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re)
      ((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
        (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  set μ : Measure ℝ := volume.restrict (Set.Ioo (-1 : ℝ) 1) with hμ
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hg.continuousOn
  set B' : ℝ := max B 0 with hB'def
  have hB'0 : 0 ≤ B' := le_max_right _ _
  have hB'ub : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖g x‖ ≤ B' := fun x hx =>
    le_trans (hB x ⟨le_of_lt hx.1, le_of_lt hx.2⟩) (le_max_left _ _)
  have hdist : ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ∀ y ∈ Set.Ioo (-1 : ℝ) 1, ‖x - y‖ ≤ 2 := by
    intro x hx y hy
    rw [Real.norm_eq_abs, abs_sub_le_iff]
    exact ⟨by linarith [hx.2, hy.1], by linarith [hy.2, hx.1]⟩
  have hmeas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re) (μ.prod μ) := by
    refine Measurable.aestronglyMeasurable ?_
    exact (hK.comp (continuous_abs.measurable.comp
        (measurable_fst.sub measurable_snd))).mul
      (Complex.measurable_re.comp
        (((hg.measurable.comp measurable_fst).mul
          (continuous_star.measurable.comp (hg.measurable.comp measurable_snd)))))
  refine Integrable.of_bound hmeas (C * (B' * B')) ?_
  rw [Measure.prod_restrict]
  filter_upwards [ae_restrict_mem (measurableSet_Ioo.prod measurableSet_Ioo)] with p hp
  have hk : |K ‖p.1 - p.2‖| ≤ C := by
    rw [← Real.norm_eq_abs]
    exact hKbound ‖p.1 - p.2‖ ⟨norm_nonneg _, hdist p.1 hp.1 p.2 hp.2⟩
  have hr : |(g p.1 * star (g p.2)).re| ≤ B' * B' := by
    calc
      |(g p.1 * star (g p.2)).re| ≤ ‖g p.1 * star (g p.2)‖ :=
        Complex.abs_re_le_norm _
      _ = ‖g p.1‖ * ‖g p.2‖ := by rw [norm_mul, norm_star]
      _ ≤ B' * B' := mul_le_mul (hB'ub p.1 hp.1) (hB'ub p.2 hp.2) (norm_nonneg _) hB'0
  calc
    ‖K ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re‖
        = |K ‖p.1 - p.2‖| * |(g p.1 * star (g p.2)).re| := by
            simp only [norm_mul, Real.norm_eq_abs]
    _ ≤ C * (B' * B') := mul_le_mul hk hr (abs_nonneg _) hC0
noncomputable def gammaModelForm (a : ℝ) (g : ℝ → ℂ) : ℝ :=
  ∫ x in Set.Ioo (-1 : ℝ) 1, (∫ y in Set.Ioo (-1 : ℝ) 1,
    gammaModelKernel a ‖x - y‖ * (g x * star (g y)).re ∂volume) ∂volume
lemma measurable_gammaModelKernel (a : ℝ) : Measurable (gammaModelKernel a) := by
  unfold gammaModelKernel
  exact measurable_const.mul
    ((Y7Density.rhoTrunc 240).continuous.comp
      (continuous_const.mul continuous_id)).measurable
lemma measurable_gammaErrorKernel (a : ℝ) : Measurable (gammaErrorKernel a) := by
  unfold gammaErrorKernel
  exact (measurable_const.mul
    (RHLean.GateII.Collar.measurable_gammaKernel.comp
      (measurable_const.mul measurable_id))).sub (measurable_gammaModelKernel a)
lemma measurable_gammaRescaledKernel (a : ℝ) :
    Measurable (fun z : ℝ => RHLean.gammaKernelRescaled a z) := by
  unfold RHLean.gammaKernelRescaled
  exact measurable_const.mul
    (RHLean.GateII.Collar.measurable_gammaKernel.comp
      (measurable_const.mul measurable_id))
lemma abs_gammaModelKernel_le {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ha : 2 * a < (14 : ℝ) / 5) (h2a1 : 1 ≤ 2 * a)
    {z : ℝ} (hz : z ∈ Set.Icc (0 : ℝ) 2) :
    |gammaModelKernel a z| ≤ a * (1 / 4 + Y7Chain.epsilonGamma a) := by
  have hz' : a * z ∈ Set.Icc (0 : ℝ) (2 * a) := by
    constructor
    · exact mul_nonneg ha0 hz.1
    · have hle : a * z ≤ 1 * z := mul_le_mul_of_nonneg_right ha1 hz.1
      nlinarith [hle, hz.2]
  have hrem := (Y7Density.gammaTaylorRemainderLeaf_240_epsilonGamma ha0 ha h2a1)
    (a * z) hz'
  have hkern : |RHLean.gammaKernel (a * z)| ≤ 1 / 4 := by
    have h := Y7A2.gammaKernelRescaled_mem_Icc (a := (1 : ℝ)) (z := a * z)
      (by norm_num) (by norm_num) hz'.1 (by linarith [hz'.2])
    have h' : 0 ≤ RHLean.gammaKernel (a * z) ∧ RHLean.gammaKernel (a * z) ≤ 1 / 4 := by
      simpa [RHLean.gammaKernelRescaled] using h
    rw [abs_of_nonneg h'.1]
    exact h'.2
  have habs : |(Y7Density.rhoTrunc 240).eval (a * z)|
      ≤ 1 / 4 + Y7Chain.epsilonGamma a := by
    calc
      |(Y7Density.rhoTrunc 240).eval (a * z)|
          = |((Y7Density.rhoTrunc 240).eval (a * z) - RHLean.gammaKernel (a * z))
              + RHLean.gammaKernel (a * z)| := by ring_nf
      _ ≤ |(Y7Density.rhoTrunc 240).eval (a * z) - RHLean.gammaKernel (a * z)|
            + |RHLean.gammaKernel (a * z)| := abs_add_le _ _
      _ ≤ Y7Chain.epsilonGamma a + 1 / 4 :=
          add_le_add (by simpa [abs_sub_comm] using hrem) hkern
      _ = 1 / 4 + Y7Chain.epsilonGamma a := by ring
  unfold gammaModelKernel
  rw [abs_mul, abs_of_nonneg ha0]
  exact mul_le_mul_of_nonneg_left habs ha0
lemma epsilonGamma_nonneg {a : ℝ} (ha0 : 0 ≤ a) (ha : 2 * a < (14 : ℝ) / 5) :
    0 ≤ Y7Chain.epsilonGamma a := by
  unfold Y7Chain.epsilonGamma
  have h1 : 0 ≤ Y7Chain.gammaM (14 / 5) := Y7Density.gammaM_nonneg
  have hq : 0 ≤ (2 * a / (14 / 5)) ^ 241 :=
    pow_nonneg (div_nonneg (by linarith) (by norm_num)) _
  have hden : 0 ≤ 1 - 2 * a / (14 / 5) := by
    rw [sub_nonneg, div_le_one (by norm_num : (0 : ℝ) < 14 / 5)]
    linarith
  exact div_nonneg (mul_nonneg (mul_nonneg (by positivity) h1) hq) hden
lemma gammaFormRescaled_eq_prod {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    {g : ℝ → ℂ} (hg : Continuous g) :
    RHLean.gammaFormRescaled a g =
      ∫ p : ℝ × ℝ, RHLean.gammaKernelRescaled a ‖p.1 - p.2‖ *
        (g p.1 * star (g p.2)).re
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  rw [RHLean.gammaFormRescaled]
  exact (MeasureTheory.integral_prod
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (fun p : ℝ × ℝ => RHLean.gammaKernelRescaled a ‖p.1 - p.2‖ *
      (g p.1 * star (g p.2)).re)
    (integrable_kernel_prod (C := a) (measurable_gammaRescaledKernel a) ha0
      (fun z hz => by
        have h := Y7A2.gammaKernelRescaled_mem_Icc ha0 ha1 hz.1 hz.2
        rw [abs_of_nonneg h.1]
        exact le_trans h.2 (by linarith [ha0])) hg)).symm
lemma gammaModelForm_eq_prod {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ha : 2 * a < (14 : ℝ) / 5) (h2a1 : 1 ≤ 2 * a)
    {g : ℝ → ℂ} (hg : Continuous g) :
    gammaModelForm a g =
      ∫ p : ℝ × ℝ, gammaModelKernel a ‖p.1 - p.2‖ *
        (g p.1 * star (g p.2)).re
        ∂((volume.restrict (Set.Ioo (-1 : ℝ) 1)).prod
          (volume.restrict (Set.Ioo (-1 : ℝ) 1))) := by
  rw [gammaModelForm]
  exact (MeasureTheory.integral_prod
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (fun p : ℝ × ℝ => gammaModelKernel a ‖p.1 - p.2‖ *
      (g p.1 * star (g p.2)).re)
    (integrable_kernel_prod (C := a * (1 / 4 + Y7Chain.epsilonGamma a))
      (measurable_gammaModelKernel a)
      (mul_nonneg ha0 (by linarith [epsilonGamma_nonneg ha0 ha]))
      (fun z hz => abs_gammaModelKernel_le ha0 ha1 ha h2a1 hz) hg)).symm
lemma gammaFormRescaled_sub_model_eq_errorForm
    {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ha : 2 * a < (14 : ℝ) / 5) (h2a1 : 1 ≤ 2 * a)
    {g : ℝ → ℂ} (hg : Continuous g) :
    RHLean.gammaFormRescaled a g - gammaModelForm a g =
      ∫ x in Set.Ioo (-1 : ℝ) 1, (∫ y in Set.Ioo (-1 : ℝ) 1,
        gammaErrorKernel a ‖x - y‖ * (g x * star (g y)).re ∂volume) ∂volume := by
  rw [gammaFormRescaled_eq_prod ha0 ha1 hg,
    gammaModelForm_eq_prod ha0 ha1 ha h2a1 hg]
  rw [← integral_sub
    (integrable_kernel_prod (C := a) (measurable_gammaRescaledKernel a) ha0
      (fun z hz => by
        have h := Y7A2.gammaKernelRescaled_mem_Icc ha0 ha1 hz.1 hz.2
        rw [abs_of_nonneg h.1]
        exact le_trans h.2 (by linarith [ha0])) hg)
    (integrable_kernel_prod (C := a * (1 / 4 + Y7Chain.epsilonGamma a))
      (measurable_gammaModelKernel a)
      (mul_nonneg ha0 (by linarith [epsilonGamma_nonneg ha0 ha]))
      (fun z hz => abs_gammaModelKernel_le ha0 ha1 ha h2a1 hz) hg)]
  rw [show (fun p : ℝ × ℝ =>
      RHLean.gammaKernelRescaled a ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re
        - gammaModelKernel a ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re)
      = (fun p : ℝ × ℝ =>
          gammaErrorKernel a ‖p.1 - p.2‖ * (g p.1 * star (g p.2)).re) from by
    funext p
    unfold gammaErrorKernel
    ring]
  exact (MeasureTheory.integral_prod
    (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
    (fun p : ℝ × ℝ => gammaErrorKernel a ‖p.1 - p.2‖ *
      (g p.1 * star (g p.2)).re)
    (integrable_kernel_prod (C := Y7Chain.epsilonGamma a / 2)
      (measurable_gammaErrorKernel a)
      (div_nonneg (epsilonGamma_nonneg ha0 ha) (by norm_num))
      (fun z hz => abs_gammaErrorKernel_le ha0 ha hz) hg))
theorem abs_gammaFormRescaled_sub_model_le
    {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ha : 2 * a < (14 : ℝ) / 5) (h2a1 : 1 ≤ 2 * a)
    {g : ℝ → ℂ} (hg : Continuous g) :
    |RHLean.gammaFormRescaled a g - gammaModelForm a g|
      ≤ Y7Chain.epsilonGamma a *
          (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  rw [gammaFormRescaled_sub_model_eq_errorForm ha0 ha1 ha h2a1 hg]
  have h := abs_kernelForm_le (C := Y7Chain.epsilonGamma a / 2)
    (measurable_gammaErrorKernel a)
    (div_nonneg (epsilonGamma_nonneg ha0 ha) (by norm_num))
    (fun z hz => abs_gammaErrorKernel_le ha0 ha hz) hg
  have h' : (2 * (Y7Chain.epsilonGamma a / 2)) *
      (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2)
      = Y7Chain.epsilonGamma a *
        (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by ring
  simpa [h'] using h
noncomputable def modelFormRescaled (a : ℝ) (g : ℝ → ℂ) : ℝ :=
  RHLean.archFormRescaled g
    + RHLean.c0 a * (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2)
    + RHLean.potentialFormRescaled g
    - gammaModelForm a g
    - 2 * a * ‖Y7Approx.polarInnerApprox a g‖ ^ 2
    - RHLean.shiftFormRescaled a g
theorem abs_localizedFormRescaled_sub_model_le
    {a : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (ha : 2 * a < (14 : ℝ) / 5) (h2a1 : 1 ≤ 2 * a)
    {g : ℝ → ℂ} (hg : Continuous g) :
    |RHLean.localizedFormRescaled a g - modelFormRescaled a g|
      ≤ (Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a) *
          (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by
  have hgmem : MemLp g 2 (volume.restrict (Set.Ioo (-1 : ℝ) 1)) :=
    memLp_two_of_continuous' hg
  have hgamma := abs_gammaFormRescaled_sub_model_le ha0 ha1 ha h2a1 hg
  have hpolar := Y7Approx.abs_polarFormRescaled_sub_approx_le a ha0 ha1 g hgmem
  have hEq : RHLean.localizedFormRescaled a g - modelFormRescaled a g
      = (gammaModelForm a g - RHLean.gammaFormRescaled a g)
        + (2 * a * ‖Y7Approx.polarInnerApprox a g‖ ^ 2
            - RHLean.polarFormRescaled a g) := by
    unfold RHLean.localizedFormRescaled modelFormRescaled
    ring
  rw [hEq]
  calc
    |(gammaModelForm a g - RHLean.gammaFormRescaled a g)
        + (2 * a * ‖Y7Approx.polarInnerApprox a g‖ ^ 2
            - RHLean.polarFormRescaled a g)|
        ≤ |gammaModelForm a g - RHLean.gammaFormRescaled a g|
          + |2 * a * ‖Y7Approx.polarInnerApprox a g‖ ^ 2
              - RHLean.polarFormRescaled a g| := abs_add_le _ _
    _ = |RHLean.gammaFormRescaled a g - gammaModelForm a g|
          + |RHLean.polarFormRescaled a g
              - 2 * a * ‖Y7Approx.polarInnerApprox a g‖ ^ 2| := by
          congr 1
          · exact abs_sub_comm _ _
          · exact abs_sub_comm _ _
    _ ≤ (Y7Chain.epsilonGamma a *
            (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2))
          + Y7Chain.epsilonPolar a *
            (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) :=
          add_le_add hgamma hpolar
    _ = (Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a) *
          (∫ x in Set.Ioo (-1 : ℝ) 1, ‖g x‖ ^ 2) := by ring
end Y7W5Kernel
end
