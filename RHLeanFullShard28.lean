        have h1 := hbound x
        have h2 := hBu x ⟨le_of_lt hxW.1, le_of_lt hxW.2⟩
        have hle : ‖g x - ((ur x : ℝ) : ℂ)‖ ≤ 2 * Bu + 2 * a * η := by
