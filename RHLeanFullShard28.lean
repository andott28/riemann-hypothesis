      RHLean.GateII.Reduction.localizedBilin_comm a g₂ f]
theorem massBilin_smul_left (a : ℝ) (c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.massBilin a (c • f) g
      = c * RHLean.GateII.Reduction.massBilin a f g := by
  unfold RHLean.GateII.Reduction.massBilin
  rw [show (fun x : ℝ => (((c • f) x) * star (g x)).re)
      = (fun x => c * ((f x * star (g x)).re)) from by
      funext x
      simp only [Pi.smul_apply, Complex.real_smul]
      rw [show ((↑c * f x) * star (g x)) = ↑c * (f x * star (g x)) from by ring]
      simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]]
  exact MeasureTheory.integral_smul c _
theorem polarInner_smul_left (a : ℝ) (c : ℝ) (f : ℝ → ℂ) :
    RHLean.polarInner a (c • f) = c * RHLean.polarInner a f := by
  unfold RHLean.polarInner
  rw [show (fun x : ℝ => star (RHLean.sph x) * ((c • f) x))
      = (fun x => c * (star (RHLean.sph x) * f x)) from by
      funext x
      simp only [Pi.smul_apply, Complex.real_smul]
      rw [show star (RHLean.sph x) * (↑c * f x) = ↑c * (star (RHLean.sph x) * f x) from by ring]
      try simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]]
  try exact MeasureTheory.integral_smul c _
theorem re_cmul (c : ℝ) (z : ℂ) : (↑c * z).re = c * z.re := by
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
theorem im_cmul (c : ℝ) (z : ℂ) : (↑c * z).im = c * z.im := by
  simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
theorem re_star (z : ℂ) : (star z).re = z.re := by
  rw [Complex.star_def]; exact Complex.conj_re z
theorem im_star (z : ℂ) : (star z).im = -z.im := by
  rw [Complex.star_def]; exact Complex.conj_im z
theorem star_cmul (c : ℝ) (z : ℂ) : star (↑c * z) = ↑c * star z := by
  apply Complex.ext
  · rw [re_star, re_cmul, re_cmul, re_star]; try ring
  · rw [im_star, im_cmul, im_cmul, im_star]; ring
theorem polarBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.polarBilin a (c • f) g
      = c * RHLean.GateII.Reduction.polarBilin a f g := by
  unfold RHLean.GateII.Reduction.polarBilin
  rw [polarInner_smul_left]
  rw [show ((c * RHLean.polarInner a f) * star (RHLean.polarInner a g))
      = ↑c * ((RHLean.polarInner a f) * star (RHLean.polarInner a g)) from by ring]
  rw [re_cmul]
  ring
theorem potentialBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.potentialBilin a (c • f) g
      = c * RHLean.GateII.Reduction.potentialBilin a f g := by
  unfold RHLean.GateII.Reduction.potentialBilin
  rw [show (fun x : ℝ => RHLean.endpointPotential a x * (((c • f) x) * star (g x)).re)
      = (fun x => c * (RHLean.endpointPotential a x * ((f x * star (g x)).re))) from by
      funext x
      rw [show ((c • f) x) * star (g x) = ↑c * (f x * star (g x)) from by
        simp only [Pi.smul_apply, Complex.real_smul]; ring]
      rw [re_cmul]
      ring]
  exact MeasureTheory.integral_smul c _
theorem gammaBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.gammaBilin a (c • f) g
      = c * RHLean.GateII.Reduction.gammaBilin a f g := by
  unfold RHLean.GateII.Reduction.gammaBilin
  have d1 : ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (((c • f) x) * star (g y)).re
      = c * ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (f x * star (g y)).re := by
    rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (((c • f) x) * star (g y)).re)
        = (fun x => c * (∫ y in Set.Ioo (-a) a,
            RHLean.gammaKernel ‖x - y‖ * (f x * star (g y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (((c • f) x) * star (g y)).re)
            = (fun y => c * (RHLean.gammaKernel ‖x - y‖ * (f x * star (g y)).re)) from by
            funext y
            rw [show ((c • f) x) * star (g y) = ↑c * (f x * star (g y)) from by
              simp only [Pi.smul_apply, Complex.real_smul]; ring]
            rw [re_cmul]
            ring]
        exact MeasureTheory.integral_smul c _]
    exact MeasureTheory.integral_smul c _
  have d2 : ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (g x * star ((c • f) y)).re
      = c * ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (g x * star (f y)).re := by
    rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (g x * star ((c • f) y)).re)
        = (fun x => c * (∫ y in Set.Ioo (-a) a,
            RHLean.gammaKernel ‖x - y‖ * (g x * star (f y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (g x * star ((c • f) y)).re)
            = (fun y => c * (RHLean.gammaKernel ‖x - y‖ * (g x * star (f y)).re)) from by
            funext y
            rw [show g x * star ((c • f) y) = ↑c * (g x * star (f y)) from by
              simp only [Pi.smul_apply, Complex.real_smul, star_cmul]; ring]
            rw [re_cmul]
            ring]
        exact MeasureTheory.integral_smul c _]
    exact MeasureTheory.integral_smul c _
  rw [d1, d2]
  ring
theorem archBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.archBilin a (c • f) g
      = c * RHLean.GateII.Reduction.archBilin a f g := by
  unfold RHLean.GateII.Reduction.archBilin
  have d1 : ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        (((c • f) x - (c • f) y) * star (g x - g y)).re / ‖x - y‖
      = c * ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
        ((f x - f y) * star (g x - g y)).re / ‖x - y‖ := by
    rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          (((c • f) x - (c • f) y) * star (g x - g y)).re / ‖x - y‖)
        = (fun x => c * (∫ y in Set.Ioo (-a) a,
            ((f x - f y) * star (g x - g y)).re / ‖x - y‖)) from by
        funext x
        rw [show (fun y : ℝ => (((c • f) x - (c • f) y) * star (g x - g y)).re / ‖x - y‖)
            = (fun y => c * (((f x - f y) * star (g x - g y)).re / ‖x - y‖)) from by
            funext y
            rw [show ((c • f) x - (c • f) y) * star (g x - g y)
                  = ↑c * ((f x - f y) * star (g x - g y)) from by
                simp only [Pi.smul_apply, Complex.real_smul, sub_smul]; ring]
            rw [re_cmul, mul_div]]
        exact MeasureTheory.integral_smul c _]
    exact MeasureTheory.integral_smul c _
  rw [d1]
  ring
theorem shiftBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.shiftBilin a (c • f) g
      = c * RHLean.GateII.Reduction.shiftBilin a f g := by
  unfold RHLean.GateII.Reduction.shiftBilin
  rw [show (fun n : ℕ => RHLean.arithCoeff n *
          (((∫ x in Set.Ioo (-a) a, ((c • f) x) * star (g (x + RHLean.shiftLength n)))).re
            + (∫ x in Set.Ioo (-a) a, g x * star ((c • f) (x + RHLean.shiftLength n))).re))
      = (fun n => c * (RHLean.arithCoeff n *
          (((∫ x in Set.Ioo (-a) a, (f x) * star (g (x + RHLean.shiftLength n)))).re
            + (∫ x in Set.Ioo (-a) a, g x * star (f (x + RHLean.shiftLength n))).re))) from by
      funext n
      have s1 : (∫ x in Set.Ioo (-a) a, ((c • f) x) * star (g (x + RHLean.shiftLength n)))
          = c • (∫ x in Set.Ioo (-a) a, (f x) * star (g (x + RHLean.shiftLength n))) := by
        rw [show (fun x : ℝ => ((c • f) x) * star (g (x + RHLean.shiftLength n)))
            = (fun x => c • ((f x) * star (g (x + RHLean.shiftLength n)))) from by
            funext x
            simp only [Pi.smul_apply, Complex.real_smul]; ring]
        exact MeasureTheory.integral_smul c _
      have s2 : (∫ x in Set.Ioo (-a) a, g x * star ((c • f) (x + RHLean.shiftLength n)))
          = c • (∫ x in Set.Ioo (-a) a, g x * star (f (x + RHLean.shiftLength n))) := by
        rw [show (fun x : ℝ => g x * star ((c • f) (x + RHLean.shiftLength n)))
            = (fun x => c • (g x * star (f (x + RHLean.shiftLength n)))) from by
            funext x
            simp only [Pi.smul_apply, Complex.real_smul, star_cmul]; ring]
        exact MeasureTheory.integral_smul c _
      rw [s1, s2]
      simp only [Complex.real_smul, re_cmul]
      ring]
  simp only [Finset.mul_sum]
theorem localizedBilin_smul_left (a c : ℝ) (f g : ℝ → ℂ) :
    RHLean.GateII.Reduction.localizedBilin a (c • f) g
      = c * RHLean.GateII.Reduction.localizedBilin a f g := by
  unfold RHLean.GateII.Reduction.localizedBilin
  rw [archBilin_smul_left, massBilin_smul_left, potentialBilin_smul_left,
      gammaBilin_smul_left, polarBilin_smul_left, shiftBilin_smul_left]
  ring
structure Admissible (a : ℝ) (h g : ℝ → ℂ) : Prop where
  arch_inner : ∀ x : ℝ, IntegrableOn
    (fun y => ((h x - h y) * star (g x - g y)).re / ‖x - y‖)
    (Set.Ioo (-a) a) volume
  arch_outer : IntegrableOn
    (fun x => ∫ y in Set.Ioo (-a) a, ((h x - h y) * star (g x - g y)).re / ‖x - y‖)
    (Set.Ioo (-a) a) volume
  mass : IntegrableOn
    (fun x => (h x * star (g x)).re) (Set.Ioo (-a) a) volume
  potential : IntegrableOn
    (fun x => RHLean.endpointPotential a x * (h x * star (g x)).re)
    (Set.Ioo (-a) a) volume
  gamma_inner : ∀ x : ℝ, IntegrableOn
    (fun y => RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re)
    (Set.Ioo (-a) a) volume
  gamma_outer : IntegrableOn
    (fun x => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re)
    (Set.Ioo (-a) a) volume
  gammaK_inner : ∀ x : ℝ, IntegrableOn
    (fun y => RHLean.gammaKernel ‖x - y‖ * (g x * star (h y)).re)
    (Set.Ioo (-a) a) volume
  gammaK_outer : IntegrableOn
    (fun x => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (g x * star (h y)).re)
    (Set.Ioo (-a) a) volume
  polar : IntegrableOn
    (fun x => star (RHLean.sph x) * h x) (Set.Ioo (-a) a) volume
  shift_first : ∀ n ∈ RHLean.arithSupport a, IntegrableOn
    (fun x => (h x * star (g (x + RHLean.shiftLength n))))
    (Set.Ioo (-a) a) volume
  shift_second : ∀ n ∈ RHLean.arithSupport a, IntegrableOn
    (fun x => (g x * star (h (x + RHLean.shiftLength n))))
    (Set.Ioo (-a) a) volume
theorem localizedBilin_add_left_of_admissible (a : ℝ) (f₁ f₂ g : ℝ → ℂ)
    (h1 : Admissible a f₁ g) (h2 : Admissible a f₂ g) :
    RHLean.GateII.Reduction.localizedBilin a (f₁ + f₂) g
      = RHLean.GateII.Reduction.localizedBilin a f₁ g
        + RHLean.GateII.Reduction.localizedBilin a f₂ g := by
  obtain ⟨ar1, arO1, ms1, pt1, gm1, gmO1, gk1, gkO1, pl1, sh1, sh3⟩ := h1
  obtain ⟨ar2, arO2, ms2, pt2, gm2, gmO2, gk2, gkO2, pl2, sh2, sh4⟩ := h2
  exact Y7GateIIAdd.localizedBilin_add_left a f₁ f₂ g
    ar1 ar2 arO1 arO2 ms1 ms2 pt1 pt2
    gm1 gm2 gmO1 gmO2 gk1 gk2 gkO1 gkO2 pl1 pl2 sh1 sh2 sh3 sh4
theorem localizedBilin_finset_sum_left {ι : Type*} [Fintype ι] [DecidableEq ι] (a : ℝ)
    (s : Finset ι) (c : ι → ℝ) (f : ι → ℝ → ℂ) (g : ℝ → ℂ)
    (hmem : ∀ i ∈ s, Admissible a (c i • f i) g)
    (hsum : ∀ t ⊆ s, Admissible a (Finset.sum t (fun j => c j • f j)) g) :
    RHLean.GateII.Reduction.localizedBilin a (Finset.sum s (fun i => c i • f i)) g
      = Finset.sum s (fun i =>
          c i * RHLean.GateII.Reduction.localizedBilin a (f i) g) := by
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      have h0 : Admissible a (0 : ℝ → ℂ) g := by
        simpa using hsum ∅ (by simp)
      have hadd := Y7GateIIAdd.localizedBilin_add_left_of_admissible
        a (0 : ℝ → ℂ) (0 : ℝ → ℂ) g h0 h0
      simp only [add_zero] at hadd
      linarith
  | insert i s his ih =>
      simp only [Finset.sum_insert his]
      have hi := Y7GateIIAdd.localizedBilin_add_left_of_admissible a (c i • f i)
        (Finset.sum s (fun j => c j • f j)) g
        (hmem i (Finset.mem_insert_self i s))
        (hsum s (by simp))
      have hih := ih (fun j hj => hmem j (by simp [hj]))
        (fun t ht => hsum t (fun x hx => by simp [ht hx]))
      rw [hi, Y7GateIIAdd.localizedBilin_smul_left, hih]
theorem localizedBilin_finset_sum_right {ι : Type*} [Fintype ι] [DecidableEq ι] (a : ℝ)
    (s : Finset ι) (c : ι → ℝ) (f : ι → ℝ → ℂ) (g : ℝ → ℂ)
    (hmem : ∀ i ∈ s, Admissible a (c i • f i) g)
    (hsum : ∀ t ⊆ s, Admissible a (Finset.sum t (fun j => c j • f j)) g) :
    RHLean.GateII.Reduction.localizedBilin a g (Finset.sum s (fun i => c i • f i))
      = Finset.sum s (fun i =>
          c i * RHLean.GateII.Reduction.localizedBilin a g (f i)) := by
  refine (RHLean.GateII.Reduction.localizedBilin_comm a g
      (Finset.sum s (fun i => c i • f i))).trans
    (Eq.trans (Y7GateIIAdd.localizedBilin_finset_sum_left a s c f g hmem hsum) ?_)
  exact Finset.sum_congr rfl (fun i _ =>
    congrArg (fun z : ℝ => c i * z)
      (RHLean.GateII.Reduction.localizedBilin_comm a (f i) g))
theorem archIntegrand_add (h₁ h₂ g : ℝ → ℂ) (x y : ℝ) :
    (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖
      = ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖
        + ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖ := by
  have hsub : ((h₁ + h₂) x - (h₁ + h₂) y) = ((h₁ x - h₁ y) + (h₂ x - h₂ y)) := by
    simp [Pi.add_apply] <;> ring
  rw [hsub]
  simp only [add_mul, Complex.add_re, add_div]
theorem Admissible.add {a : ℝ} {h₁ h₂ g : ℝ → ℂ}
    (h1 : Admissible a h₁ g) (h2 : Admissible a h₂ g) :
    Admissible a (h₁ + h₂) g := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [show (fun y : ℝ => (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖)
        = (fun y => ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖
            + ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖) from by
        funext y; exact Y7GateIIAdd.archIntegrand_add h₁ h₂ g x y]
    exact MeasureTheory.IntegrableOn.add (h1.arch_inner x) (h2.arch_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖)
            + (∫ y in Set.Ioo (-a) a,
                ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖)) from by
        funext x
        rw [show (fun y : ℝ => (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖)
            = (fun y => ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖
                + ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖) from by
            funext y; exact Y7GateIIAdd.archIntegrand_add h₁ h₂ g x y]
        exact MeasureTheory.integral_add (h1.arch_inner x) (h2.arch_inner x)]
    exact MeasureTheory.IntegrableOn.add h1.arch_outer h2.arch_outer
  · rw [show (fun x : ℝ => ((h₁ + h₂) x * star (g x)).re)
        = (fun x => (h₁ x * star (g x)).re + (h₂ x * star (g x)).re) from by
        funext x; simp only [Pi.add_apply, add_mul, Complex.add_re]]
    exact MeasureTheory.IntegrableOn.add h1.mass h2.mass
  · rw [show (fun x : ℝ => RHLean.endpointPotential a x * (((h₁ + h₂) x) * star (g x)).re)
        = (fun x => RHLean.endpointPotential a x * (h₁ x * star (g x)).re
            + RHLean.endpointPotential a x * (h₂ x * star (g x)).re) from by
        funext x; simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]]
    exact MeasureTheory.IntegrableOn.add h1.potential h2.potential
  · intro x
    rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (((h₁ + h₂) x) * star (g y)).re)
        = (fun y => RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re
            + RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re) from by
        funext y; simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]]
    exact MeasureTheory.IntegrableOn.add (h1.gamma_inner x) (h2.gamma_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (((h₁ + h₂) x) * star (g y)).re)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re)
            + (∫ y in Set.Ioo (-a) a,
                RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (((h₁ + h₂) x) * star (g y)).re)
            = (fun y => RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re
                + RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re) from by
            funext y; simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]]
        exact MeasureTheory.integral_add (h1.gamma_inner x) (h2.gamma_inner x)]
    exact MeasureTheory.IntegrableOn.add h1.gamma_outer h2.gamma_outer
  · intro x
    rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re)
        = (fun y => RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re
            + RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re) from by
        funext y; simp only [Pi.add_apply, star_add, mul_add, Complex.add_re]]
    exact MeasureTheory.IntegrableOn.add (h1.gammaK_inner x) (h2.gammaK_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re)
            + (∫ y in Set.Ioo (-a) a,
                RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re)
            = (fun y => RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re
                + RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re) from by
            funext y; simp only [Pi.add_apply, star_add, mul_add, Complex.add_re]]
        exact MeasureTheory.integral_add (h1.gammaK_inner x) (h2.gammaK_inner x)]
    exact MeasureTheory.IntegrableOn.add h1.gammaK_outer h2.gammaK_outer
  · rw [show (fun x : ℝ => star (RHLean.sph x) * ((h₁ + h₂) x))
        = (fun x => star (RHLean.sph x) * h₁ x + star (RHLean.sph x) * h₂ x) from by
        funext x; simp only [Pi.add_apply, mul_add]]
    exact MeasureTheory.IntegrableOn.add h1.polar h2.polar
  · intro n hn
    rw [show (fun x : ℝ => ((h₁ + h₂) x) * star (g (x + RHLean.shiftLength n)))
        = (fun x => h₁ x * star (g (x + RHLean.shiftLength n))
            + h₂ x * star (g (x + RHLean.shiftLength n))) from by
        funext x; simp only [Pi.add_apply, add_mul]]
    exact MeasureTheory.IntegrableOn.add (h1.shift_first n hn) (h2.shift_first n hn)
  · intro n hn
    rw [show (fun x : ℝ => g x * star ((h₁ + h₂) (x + RHLean.shiftLength n)))
        = (fun x => g x * star (h₁ (x + RHLean.shiftLength n))
            + g x * star (h₂ (x + RHLean.shiftLength n))) from by
        funext x; simp only [Pi.add_apply, star_add, mul_add]]
    exact MeasureTheory.IntegrableOn.add (h1.shift_second n hn) (h2.shift_second n hn)
theorem archIntegrand_sub (h₁ h₂ g : ℝ → ℂ) (x y : ℝ) :
    ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖
      = (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖
        - ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖ := by
  rw [Y7GateIIAdd.archIntegrand_add h₁ h₂ g x y]
  abel
theorem Admissible.sub_right {a : ℝ} {h₁ h₂ g : ℝ → ℂ}
    (h12 : Admissible a (h₁ + h₂) g) (h1 : Admissible a h₁ g) :
    Admissible a h₂ g := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [show (fun y : ℝ => ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖)
        = (fun y => (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖
            - ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖) from by
        funext y; exact Y7GateIIAdd.archIntegrand_sub h₁ h₂ g x y]
    exact MeasureTheory.IntegrableOn.sub (h12.arch_inner x) (h1.arch_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖)
            - (∫ y in Set.Ioo (-a) a,
                ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖)) from by
        funext x
        rw [show (fun y : ℝ => ((h₂ x - h₂ y) * star (g x - g y)).re / ‖x - y‖)
            = (fun y => (((h₁ + h₂) x - (h₁ + h₂) y) * star (g x - g y)).re / ‖x - y‖
                - ((h₁ x - h₁ y) * star (g x - g y)).re / ‖x - y‖) from by
            funext y; exact Y7GateIIAdd.archIntegrand_sub h₁ h₂ g x y]
        exact MeasureTheory.integral_sub (h12.arch_inner x) (h1.arch_inner x)]
    exact MeasureTheory.IntegrableOn.sub h12.arch_outer h1.arch_outer
  · rw [show (fun x : ℝ => (h₂ x * star (g x)).re)
        = (fun x => ((h₁ + h₂) x * star (g x)).re - (h₁ x * star (g x)).re) from by
        funext x; simp only [Pi.add_apply, add_mul, Complex.add_re]; abel]
    exact MeasureTheory.IntegrableOn.sub h12.mass h1.mass
  · rw [show (fun x : ℝ => RHLean.endpointPotential a x * (h₂ x * star (g x)).re)
        = (fun x => RHLean.endpointPotential a x * ((h₁ + h₂) x * star (g x)).re
            - RHLean.endpointPotential a x * (h₁ x * star (g x)).re) from by
        funext x
        simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]; abel]
    exact MeasureTheory.IntegrableOn.sub h12.potential h1.potential
  · intro x
    rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re)
        = (fun y => RHLean.gammaKernel ‖x - y‖ * ((h₁ + h₂) x * star (g y)).re
            - RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re) from by
        funext y
        simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]; abel]
    exact MeasureTheory.IntegrableOn.sub (h12.gamma_inner x) (h1.gamma_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              RHLean.gammaKernel ‖x - y‖ * ((h₁ + h₂) x * star (g y)).re)
            - (∫ y in Set.Ioo (-a) a,
                RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (h₂ x * star (g y)).re)
            = (fun y => RHLean.gammaKernel ‖x - y‖ * ((h₁ + h₂) x * star (g y)).re
                - RHLean.gammaKernel ‖x - y‖ * (h₁ x * star (g y)).re) from by
            funext y
            simp only [Pi.add_apply, add_mul, Complex.add_re, mul_add]; abel]
        exact MeasureTheory.integral_sub (h12.gamma_inner x) (h1.gamma_inner x)]
    exact MeasureTheory.IntegrableOn.sub h12.gamma_outer h1.gamma_outer
  · intro x
    rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re)
        = (fun y => RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re
            - RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re) from by
        funext y
        simp only [Pi.add_apply, star_add, mul_add, Complex.add_re]; abel]
    exact MeasureTheory.IntegrableOn.sub (h12.gammaK_inner x) (h1.gammaK_inner x)
  · rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re)
        = (fun x => (∫ y in Set.Ioo (-a) a,
              RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re)
            - (∫ y in Set.Ioo (-a) a,
                RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re)) from by
        funext x
        rw [show (fun y : ℝ => RHLean.gammaKernel ‖x - y‖ * (g x * star (h₂ y)).re)
            = (fun y => RHLean.gammaKernel ‖x - y‖ * (g x * star ((h₁ + h₂) y)).re
                - RHLean.gammaKernel ‖x - y‖ * (g x * star (h₁ y)).re) from by
            funext y
            simp only [Pi.add_apply, star_add, mul_add, Complex.add_re]; abel]
        exact MeasureTheory.integral_sub (h12.gammaK_inner x) (h1.gammaK_inner x)]
    exact MeasureTheory.IntegrableOn.sub h12.gammaK_outer h1.gammaK_outer
  · rw [show (fun x : ℝ => star (RHLean.sph x) * h₂ x)
        = (fun x => star (RHLean.sph x) * ((h₁ + h₂) x)
            - star (RHLean.sph x) * h₁ x) from by
        funext x; simp only [Pi.add_apply, mul_add]; abel]
    exact MeasureTheory.IntegrableOn.sub h12.polar h1.polar
  · intro n hn
    rw [show (fun x : ℝ => h₂ x * star (g (x + RHLean.shiftLength n)))
        = (fun x => (h₁ + h₂) x * star (g (x + RHLean.shiftLength n))
            - h₁ x * star (g (x + RHLean.shiftLength n))) from by
        funext x; simp only [Pi.add_apply, add_mul]; abel]
    exact MeasureTheory.IntegrableOn.sub (h12.shift_first n hn) (h1.shift_first n hn)
  · intro n hn
    rw [show (fun x : ℝ => g x * star (h₂ (x + RHLean.shiftLength n)))
        = (fun x => g x * star ((h₁ + h₂) (x + RHLean.shiftLength n))
            - g x * star (h₁ (x + RHLean.shiftLength n))) from by
        funext x; simp only [Pi.add_apply, star_add, mul_add]; abel]
    exact MeasureTheory.IntegrableOn.sub (h12.shift_second n hn) (h1.shift_second n hn)
theorem localizedBilin_gram_quadratic {ι : Type*} [Fintype ι] [DecidableEq ι] (a : ℝ)
    (s : Finset ι) (c : ι → ℝ) (φ : ι → ℝ → ℂ)
    (houter : ∀ i ∈ s, Admissible a (c i • φ i)
        (Finset.sum s (fun j => c j • φ j)))
    (houterSum : ∀ t ⊆ s, Admissible a (Finset.sum t (fun i => c i • φ i))
        (Finset.sum s (fun j => c j • φ j)))
    (hinner : ∀ i ∈ s, ∀ j ∈ s, Admissible a (c j • φ j) (φ i))
    (hinnerSum : ∀ i ∈ s, ∀ t ⊆ s,
        Admissible a (Finset.sum t (fun j => c j • φ j)) (φ i)) :
    RHLean.GateII.Reduction.localizedBilin a
        (Finset.sum s (fun i => c i • φ i))
        (Finset.sum s (fun j => c j • φ j))
      = Finset.sum s (fun i =>
          Finset.sum s (fun j =>
            c i * (RHLean.GateII.Reduction.gramMatrix a φ i j) * c j)) := by
  rw [Y7GateIIAdd.localizedBilin_finset_sum_left a s c φ
      (Finset.sum s (fun j => c j • φ j)) houter houterSum]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  rw [Y7GateIIAdd.localizedBilin_finset_sum_right a s c φ (φ i)
      (fun j hj => hinner i hi j hj) (fun t ht => hinnerSum i hi t ht)]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  unfold RHLean.GateII.Reduction.gramMatrix
  ring
theorem star_real_eq (r : ℝ) : star r = r := by
  simp only [star_trivial]
theorem finsupp_sum_star_support {ι : Type*} [Fintype ι] [DecidableEq ι]
    (x : ι →₀ ℝ) (M : Matrix ι ι ℝ) :
    x.sum (fun i xi => x.sum fun j xj => star xi * M i j * xj)
      = Finset.sum x.support (fun i =>
          Finset.sum x.support (fun j => star (x i) * M i j * x j)) := by
  rfl
theorem localizedBilin_nonneg_of_posSemidef
    {ι : Type*} [Fintype ι] [DecidableEq ι] {a : ℝ} {φ : ι → ℝ → ℂ}
    (hM : Matrix.PosSemidef (RHLean.GateII.Reduction.gramMatrix a φ))
    (x : ι →₀ ℝ)
    (houter : ∀ i ∈ x.support, Admissible a (x i • φ i)
        (Finset.sum x.support (fun j => x j • φ j)))
    (houterSum : ∀ t ⊆ x.support, Admissible a (Finset.sum t (fun i => x i • φ i))
        (Finset.sum x.support (fun j => x j • φ j)))
    (hinner : ∀ i ∈ x.support, ∀ j ∈ x.support, Admissible a (x j • φ j) (φ i))
    (hinnerSum : ∀ i ∈ x.support, ∀ t ⊆ x.support,
        Admissible a (Finset.sum t (fun j => x j • φ j)) (φ i)) :
    0 ≤ RHLean.GateII.Reduction.localizedBilin a
        (Finset.sum x.support (fun i => x i • φ i))
        (Finset.sum x.support (fun j => x j • φ j)) := by
  rw [Y7GateIIAdd.localizedBilin_gram_quadratic a x.support (fun i => x i) φ
      houter houterSum hinner hinnerSum]
  have hq := hM.2 x
  rw [Y7GateIIAdd.finsupp_sum_star_support x
      (RHLean.GateII.Reduction.gramMatrix a φ)] at hq
  simp only [Y7GateIIAdd.star_real_eq] at hq
  exact hq
end Y7GateIIAdd
namespace Y7GateIIAdd
theorem oldBasis_mem_range_truncBasis (a b : ℝ) (N k : ℕ) (hk : k < N) :
    RHLean.GateII.Reduction.oldBasis a k
      ∈ Set.range (RHLean.GateII.Reduction.truncBasis a b N) := by
  refine ⟨Sum.inl ⟨k, hk⟩, ?_⟩
  simp only [RHLean.GateII.Reduction.truncBasis, Sum.elim_inl, Fin.val_mk]
theorem mem_span_truncBasis_oldIndicator (a b : ℝ) (N : ℕ) (p : Polynomial ℝ)
    (hdeg : p.natDegree < N) :
    Set.indicator (Set.Ioo (-a) a) (fun x => ((p.eval (x / a) : ℝ) : ℂ))
      ∈ Submodule.span ℝ (Set.range
          (RHLean.GateII.Reduction.truncBasis a b N)) := by
  obtain ⟨c, hc⟩ := Y7Arch.exists_legP_expansion p.natDegree p le_rfl
  have hlt : ∀ k ∈ Finset.range (p.natDegree + 1), k < N := by
    intro k hk
    rw [Finset.mem_range] at hk
    omega
  have hroot : ∀ k : ℕ, 0 < Real.sqrt ((2 * (k : ℝ) + 1) / 2) := by
    intro k
    positivity
  have hpoly : ∀ x : ℝ, ((p.eval (x / a) : ℝ) : ℂ)
      = ∑ k ∈ Finset.range (p.natDegree + 1),
          (((c k * (Y7Legendre.legP k).eval (x / a)) : ℝ) : ℂ) := by
    intro x
    conv_lhs => rw [hc]
    simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
      Complex.ofReal_sum]
  have hpt : ∀ x : ℝ,
      Set.indicator (Set.Ioo (-a) a) (fun t => ((p.eval (t / a) : ℝ) : ℂ)) x
      = ∑ k ∈ Finset.range (p.natDegree + 1),
          (c k / Real.sqrt ((2 * (k : ℝ) + 1) / 2)) •
            RHLean.GateII.Reduction.oldBasis a k x := by
    intro x
    by_cases hx : x ∈ Set.Ioo (-a) a
    · rw [Set.indicator_of_mem hx, hpoly]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      simp only [RHLean.GateII.Reduction.oldBasis, Set.indicator_of_mem hx,
        Y7Matrix.phiC, Y7Legendre.phi, Polynomial.eval_mul, Polynomial.eval_C,
        Complex.real_smul]
      rw [← Complex.ofReal_mul]
      rw [← mul_assoc, div_mul_cancel₀ _ (ne_of_gt (hroot k))]
    · rw [Set.indicator_of_notMem hx]
      symm
      refine Finset.sum_eq_zero (fun k _ => ?_)
      simp only [RHLean.GateII.Reduction.oldBasis, Set.indicator_of_notMem hx,
        smul_zero]
  have hfun : Set.indicator (Set.Ioo (-a) a) (fun t => ((p.eval (t / a) : ℝ) : ℂ))
      = ∑ k ∈ Finset.range (p.natDegree + 1),
          (c k / Real.sqrt ((2 * (k : ℝ) + 1) / 2)) •
            RHLean.GateII.Reduction.oldBasis a k := by
    funext x
    simp only [Finset.sum_apply, Pi.smul_apply]
    exact hpt x
  rw [hfun]
  refine Submodule.sum_mem _ (fun k hk => ?_)
  apply Submodule.smul_mem
  exact Submodule.subset_span
    (Y7GateIIAdd.oldBasis_mem_range_truncBasis a b N k (hlt k hk))
theorem mul_star_re_zero₁ (z w : ℂ) (hz : z.im = 0) (hw : w.re = 0) :
    (z * star w).re = 0 := by
  simp only [Complex.mul_re, Y7GateIIAdd.re_star, Y7GateIIAdd.im_star, hz, hw]
  ring
theorem mul_star_re_zero₂ (z w : ℂ) (hz : z.re = 0) (hw : w.im = 0) :
    (z * star w).re = 0 := by
  simp only [Complex.mul_re, Y7GateIIAdd.re_star, Y7GateIIAdd.im_star, hz, hw]
  ring
theorem integral_eq_zero_of_forall {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    (s : Set ℝ) (f : ℝ → G) (h : ∀ x, f x = 0) :
    ∫ x in s, f x ∂volume = 0 := by
  rw [show f = fun _ => (0 : G) from funext fun x => h x]
  simp
theorem massBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.massBilin a u v = 0 := by
  show ∫ x in Set.Ioo (-a) a, (u x * star (v x)).re ∂volume = 0
  exact integral_eq_zero_of_forall _ _ fun x => mul_star_re_zero₁ _ _ (hu x) (hv x)
theorem potentialBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.potentialBilin a u v = 0 := by
  show ∫ x in Set.Ioo (-a) a, RHLean.endpointPotential a x * (u x * star (v x)).re ∂volume = 0
  exact integral_eq_zero_of_forall _ _ fun x => by
    simp only [mul_star_re_zero₁ _ _ (hu x) (hv x), mul_zero]
theorem archBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.archBilin a u v = 0 := by
  unfold RHLean.GateII.Reduction.archBilin
  have hsub : ∀ x y : ℝ, ((u x - u y) * star (v x - v y)).re = 0 := fun x y =>
    mul_star_re_zero₁ _ _ (by simp only [Complex.sub_im, hu, sub_self])
      (by simp only [Complex.sub_re, hv, sub_self])
  have houter : ∀ x : ℝ, ∫ y in Set.Ioo (-a) a,
      ((u x - u y) * star (v x - v y)).re / ‖x - y‖ ∂volume = 0 := fun x =>
    integral_eq_zero_of_forall _ _ fun y => by rw [hsub x y]; simp
  simp only [integral_eq_zero_of_forall _ _ houter]
  simp
theorem gammaBilin_real_imag (a : ℝ) (u v : ℝ → ℂ)
    (hu : ∀ x, (u x).im = 0) (hv : ∀ x, (v x).re = 0) :
    RHLean.GateII.Reduction.gammaBilin a u v = 0 := by
  unfold RHLean.GateII.Reduction.gammaBilin
  have h1 : ∀ x y : ℝ, (u x * star (v y)).re = 0 := fun x y => mul_star_re_zero₁ _ _ (hu x) (hv y)
  have h2 : ∀ x y : ℝ, (v x * star (u y)).re = 0 := fun x y => mul_star_re_zero₂ _ _ (hv x) (hu y)
  have hout1 : ∀ x : ℝ, ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (u x * star (v y)).re ∂volume = 0 := fun x =>
    integral_eq_zero_of_forall _ _ fun y => by rw [h1 x y]; simp
  have hout2 : ∀ x : ℝ, ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (v x * star (u y)).re ∂volume = 0 := fun x =>
    integral_eq_zero_of_forall _ _ fun y => by rw [h2 x y]; simp
  simp only [hout1, hout2]
  simp
end Y7GateIIAdd
