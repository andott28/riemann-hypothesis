theorem gammaForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (M Bf Bg : ℝ) (ha : 0 < a)
    (hM : ∀ z : ℝ, 0 ≤ z → |RHLean.gammaKernel z| ≤ M)
    (hbf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hbg : ∀ x : ℝ, ‖g x‖ ≤ Bg)
    (hf : Continuous f) (hg : Continuous g) :
    |RHLean.gammaForm a f - RHLean.gammaForm a g|
      ≤ 2 * M * a * Real.sqrt (2 * a) * (Bf + Bg)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) := by
  have ha2 : 0 ≤ a := ha.le
  have hM0 : 0 ≤ M := le_trans (abs_nonneg _) (hM 0 (by norm_num))
  have hBf0 : 0 ≤ Bf := le_trans (norm_nonneg _) (hbf 0)
  have hBg0 : 0 ≤ Bg := le_trans (norm_nonneg _) (hbg 0)
  have hvol : (volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hru : (volume.restrict (Set.Ioo (-a) a)).real Set.univ = 2 * a := by
    show ENNReal.toReal ((volume.restrict (Set.Ioo (-a) a)) Set.univ) = 2 * a
    rw [Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  have hR : Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) ≥ 0 :=
    Real.sqrt_nonneg _
  have hLfg : ∫ x in Set.Ioo (-a) a, ‖f x - g x‖
      ≤ Real.sqrt (2 * a) * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2) :=
    l1_le_sqrt_measure_l2 a (fun x => f x - g x) ha2 (hf.sub hg)
  have hcBf : Continuous (fun _ : ℝ => (Bf:ℝ)) := by fun_prop
  have hcBg : Continuous (fun _ : ℝ => (Bg:ℝ)) := by fun_prop
  have hintBf : IntegrableOn (fun _ : ℝ => Bf) (Set.Ioo (-a) a) volume :=
    hcBf.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hintBg : IntegrableOn (fun _ : ℝ => Bg) (Set.Ioo (-a) a) volume :=
    hcBg.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hLf : ∫ x in Set.Ioo (-a) a, ‖f x‖ ≤ Bf * (2 * a) := by
    have hmono := setIntegral_mono_ae (f := fun x => ‖f x‖) (g := fun _ => Bf)
      (hf := (by fun_prop : Continuous (fun x : ℝ => ‖f x‖)).integrableOn_Icc.mono_set
        Set.Ioo_subset_Icc_self)
      (hg := hintBf) (by filter_upwards [] with x; exact hbf x)
    refine le_trans hmono ?_
    have hi := integral_const (μ := volume.restrict (Set.Ioo (-a) a)) (c := (Bf:ℝ))
    rw [hi, smul_eq_mul, hru]
    linarith
  have hLg : ∫ x in Set.Ioo (-a) a, ‖g x‖ ≤ Bg * (2 * a) := by
    have hmono := setIntegral_mono_ae (f := fun x => ‖g x‖) (g := fun _ => Bg)
      (hf := (by fun_prop : Continuous (fun x : ℝ => ‖g x‖)).integrableOn_Icc.mono_set
        Set.Ioo_subset_Icc_self)
      (hg := hintBg) (by filter_upwards [] with x; exact hbg x)
    refine le_trans hmono ?_
    have hi := integral_const (μ := volume.restrict (Set.Ioo (-a) a)) (c := (Bg:ℝ))
    rw [hi, smul_eq_mul, hru]
    linarith
  have hi1 : ∀ x : ℝ, IntegrableOn (fun y : ℝ =>
      RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)
      (Set.Ioo (-a) a) volume :=
    fun x => admissible_gamma_inner_field a f f Bf ha.le hf (fun y _ => hbf y) x
  have hi2 : ∀ x : ℝ, IntegrableOn (fun y : ℝ =>
      RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re)
      (Set.Ioo (-a) a) volume :=
    fun x => admissible_gamma_inner_field a g g Bg ha.le hg (fun y _ => hbg y) x
  have hpt : ∀ (x y : ℝ),
      |RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re
        - RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re|
      ≤ M * (Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖) := by
    intro x y
    have hker : |RHLean.gammaKernel ‖x - y‖| ≤ M := hM _ (norm_nonneg _)
    have hstep : |RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re
        - RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re|
        = |RHLean.gammaKernel ‖x - y‖| *
          |(f x * star (f y)).re - (g x * star (g y)).re| := by
      rw [← mul_sub, abs_mul]
    rw [hstep]
    have hpol : |(f x * star (f y)).re - (g x * star (g y)).re|
        ≤ ‖f x - g x‖ * ‖f y‖ + ‖g x‖ * ‖f y - g y‖ := by
      have hsplit : (f x * star (f y)) - (g x * star (g y))
          = (f x - g x) * star (f y) + g x * star (f y - g y) := by
        rw [star_sub, sub_mul, mul_sub]; ring
      rw [← Complex.sub_re, hsplit]
      refine le_trans (Complex.abs_re_le_norm _) ?_
      refine le_trans (norm_add_le _ _) ?_
      rw [norm_mul, norm_star, norm_mul, norm_star]
    have hmid : |(f x * star (f y)).re - (g x * star (g y)).re|
        ≤ Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖ := by
      refine le_trans hpol ?_
      nlinarith [hbf y, norm_sub_le (f y) (g y), hBf0, norm_nonneg (f x - g x)]
    exact mul_le_mul hker hmid (abs_nonneg _) hM0
  have hinner : ∀ x : ℝ,
      |(∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)
        - (∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re)|
      ≤ M * (Bf * (2 * a) * ‖f x - g x‖
        + ‖g x‖ * (Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))) := by
    intro x
    rw [← integral_sub (hi1 x) (hi2 x)]
    have habs := norm_integral_le_integral_norm
      (μ := volume.restrict (Set.Ioo (-a) a)) (fun y : ℝ =>
        RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re
          - RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re)
    simp only [Real.norm_eq_abs] at habs
    refine le_trans habs ?_
    have hP : Continuous (fun y : ℝ =>
        M * (Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖)) := by fun_prop
    have hintP : IntegrableOn (fun y : ℝ =>
        M * (Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖))
        (Set.Ioo (-a) a) volume :=
      hP.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hhint1 : IntegrableOn (fun _ : ℝ => Bf * ‖f x - g x‖)
        (Set.Ioo (-a) a) volume :=
      (by fun_prop : Continuous (fun _ : ℝ => (Bf * ‖f x - g x‖:ℝ))).integrableOn_Icc.mono_set
        Set.Ioo_subset_Icc_self
    have hhint2 : IntegrableOn (fun y : ℝ => ‖g x‖ * ‖f y - g y‖)
        (Set.Ioo (-a) a) volume :=
      (by fun_prop : Continuous (fun y : ℝ => ‖g x‖ * ‖f y - g y‖)).integrableOn_Icc.mono_set
        Set.Ioo_subset_Icc_self
    have hmono := setIntegral_mono_ae
      (f := fun y => |RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re
          - RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re|)
      (g := fun y => M * (Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖))
      (hf := (hi1 x).sub (hi2 x) |>.norm)
      (hg := hintP)
      (by filter_upwards [] with y; exact hpt x y)
    refine le_trans hmono ?_
    have heq : ∫ y in Set.Ioo (-a) a, M * (Bf * ‖f x - g x‖ + ‖g x‖ * ‖f y - g y‖)
        = M * (Bf * ‖f x - g x‖ * (2 * a)
          + ‖g x‖ * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖) := by
      rw [integral_const_mul, integral_add hhint1 hhint2]
      rw [integral_const, smul_eq_mul, hru, integral_const_mul]
      ring
    rw [heq]
    have hstep1 : Bf * ‖f x - g x‖ * (2 * a) = Bf * (2 * a) * ‖f x - g x‖ := by ring
    rw [hstep1]
    have hstep2 : ‖g x‖ * ∫ y in Set.Ioo (-a) a, ‖f y - g y‖
        ≤ ‖g x‖ * (Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) := by
      nlinarith [hLfg, norm_nonneg (g x)]
    nlinarith [hstep2, hM0]
  unfold RHLean.gammaForm
  have hintFx : IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)
      (Set.Ioo (-a) a) volume :=
    admissible_gamma_outer_field a f f Bf ha.le hf hf
      (fun x _ => hbf x) (fun y _ => hbf y)
  have hintGx : IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
      RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re)
      (Set.Ioo (-a) a) volume :=
    admissible_gamma_outer_field a g g Bg ha.le hg hg
      (fun x _ => hbg x) (fun y _ => hbg y)
  rw [← integral_sub hintFx hintGx]
  have habs := norm_integral_le_integral_norm
    (μ := volume.restrict (Set.Ioo (-a) a)) (fun x : ℝ =>
      (∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)
        - (∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re))
  simp only [Real.norm_eq_abs] at habs
  refine le_trans habs ?_
  have hQ : Continuous (fun x : ℝ => M * (Bf * (2 * a) * ‖f x - g x‖
      + ‖g x‖ * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)))) := by fun_prop
  have hintQ : IntegrableOn (fun x : ℝ => M * (Bf * (2 * a) * ‖f x - g x‖
      + ‖g x‖ * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))))
      (Set.Ioo (-a) a) volume :=
    hQ.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
  have hmono := setIntegral_mono_ae
    (f := fun x => |(∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (f x * star (f y)).re)
        - (∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖ * (g x * star (g y)).re)|)
    (g := fun x => M * (Bf * (2 * a) * ‖f x - g x‖ + ‖g x‖ * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))))
    (hf := (hintFx.sub hintGx).norm)
    (hg := hintQ)
    (by filter_upwards [] with x; exact hinner x)
  refine le_trans hmono ?_
  have hintPD : IntegrableOn (fun x : ℝ => Bf * (2 * a) * ‖f x - g x‖)
      (Set.Ioo (-a) a) volume :=
    (by fun_prop : Continuous (fun x : ℝ => Bf * (2 * a) * ‖f x - g x‖)).integrableOn_Icc.mono_set
      Set.Ioo_subset_Icc_self
  have hintPG : IntegrableOn (fun x : ℝ => ‖g x‖ * (Real.sqrt (2 * a)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)))
      (Set.Ioo (-a) a) volume :=
    (by fun_prop : Continuous (fun x : ℝ => ‖g x‖ * (Real.sqrt (2 * a)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)))).integrableOn_Icc.mono_set
      Set.Ioo_subset_Icc_self
  rw [integral_const_mul, integral_add hintPD hintPG, integral_const_mul,
    integral_mul_const]
  have hfin : 2 * M * a * Real.sqrt (2 * a) * (Bf + Bg)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)
      = M * ((Bf * (2 * a)) * (Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))
        + (Bg * (2 * a)) * (Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))) := by ring
  rw [hfin]
  have hD0 : 0 ≤ ∫ x in Set.Ioo (-a) a, ‖f x - g x‖ :=
    integral_nonneg (fun _ => norm_nonneg _)
  have hX0 : 0 ≤ Bf * (2 * a) := by nlinarith [hBf0, ha2]
  have hY0 : 0 ≤ Bg * (2 * a) := by nlinarith [hBg0, ha2]
  have hA : (Bf * (2 * a)) * ∫ x in Set.Ioo (-a) a, ‖f x - g x‖
      ≤ (Bf * (2 * a)) * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) :=
    mul_le_mul (le_refl _) hLfg hD0 hX0
  have hB : (∫ x in Set.Ioo (-a) a, ‖g x‖) * (Real.sqrt (2 * a)
      * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2))
      ≤ (Bg * (2 * a)) * (Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)) := by
    refine mul_le_mul hLg (le_refl _) ?_ hY0
    nlinarith [hR, ha2]
  nlinarith [hA, hB, hM0]
end Y7GateIIAdd
