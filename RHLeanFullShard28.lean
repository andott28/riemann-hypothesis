namespace RHLean.GateII.Chain
open Matrix
open scoped InnerProductSpace
theorem feshbach_rankOne {m n : Type*} [Fintype m] [Fintype n] [DecidableEq m]
    (A : Matrix m m ℝ) (B : Matrix m n ℝ) (D : Matrix n n ℝ) (t : n → ℝ)
    (hA : A.PosDef) [Invertible A]
    (hS : (D - (2 : ℝ) • vecMulVec t t - Bᴴ * A⁻¹ * B).PosSemidef) :
    (fromBlocks A B Bᴴ D).PosSemidef := by
  rw [Matrix.PosDef.fromBlocks₁₁ B D hA]
  have hdecomp : D - Bᴴ * A⁻¹ * B
      = (D - (2 : ℝ) • vecMulVec t t - Bᴴ * A⁻¹ * B) + (2 : ℝ) • vecMulVec t t := by
    abel
  rw [hdecomp]
  have hvv : (vecMulVec t t).PosSemidef := by
    simpa only [star_trivial] using Matrix.posSemidef_vecMulVec_self_star t
  exact hS.add (hvv.smul (show (0 : ℝ) ≤ 2 by norm_num))
theorem aligned_parent_penalty {Pi0 A χ ρ c θ b Γ X γ : ℝ}
    (hPi0 : 0 < Pi0) (hA : A = (1 - θ ^ 2) * Pi0) (hθ : θ ^ 2 < 1)
    (hχ : 0 ≤ χ) (hρ0 : 0 ≤ ρ) (hΓ : Γ ^ 2 ≤ ρ * χ)
    (hrho : ρ ≤ c * (1 - θ ^ 2) * Pi0) (hc : 0 ≤ c)
    (hc5 : (5 / 3) * c ≤ 189 / 250) (hγ : 0 < γ) :
    -χ * γ ^ 2 + A * X ^ 2 - 2 * θ * Γ * X * γ - 2 * (1 - θ) * b * X * γ
      ≥ -((439 / 250) * χ + (5 / 2) * (((1 - θ) / (1 + θ)) * b ^ 2 / Pi0)) * γ ^ 2 := by
  have hγne : γ ≠ 0 := ne_of_gt hγ
  have hcore := aligned_penalty_core (Pi0 := Pi0) (A := A) (χ := χ) (ρ := ρ) (c := c)
    (θ := θ) (b := b) (y := X / γ) (Γ := Γ) hPi0 hA hθ hχ hρ0 hΓ hrho hc hc5
  have hmul := mul_le_mul_of_nonneg_right hcore (sq_nonneg γ : (0 : ℝ) ≤ γ ^ 2)
  have hrew : (A * (X / γ) ^ 2 - 2 * θ * Γ * (X / γ) - 2 * (1 - θ) * b * (X / γ))
      * γ ^ 2 = A * X ^ 2 - 2 * θ * Γ * X * γ - 2 * (1 - θ) * b * X * γ := by
    field_simp [hγne]
  have hsplit : (-((189 / 250) * χ) - (5 / 2) * (((1 - θ) / (1 + θ)) * b ^ 2 / Pi0))
      * γ ^ 2
      = -((439 / 250) * χ + (5 / 2) * (((1 - θ) / (1 + θ)) * b ^ 2 / Pi0)) * γ ^ 2
        + χ * γ ^ 2 := by
    ring
  rw [hrew, hsplit] at hmul
  linarith [hmul]
theorem osp_cauchy_schwarz {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsPositive) (e : E) (hα : 0 < ⟪e, T e⟫_ℝ) (x : E) :
    ⟪T e, x⟫_ℝ ^ 2 ≤ ⟪e, T e⟫_ℝ * ⟪x, T x⟫_ℝ := by
  set c : ℝ := ⟪T e, x⟫_ℝ / ⟪e, T e⟫_ℝ with hc
  have h0 : 0 ≤ ⟪x - c • e, T (x - c • e)⟫_ℝ := hT.inner_nonneg_right _
  have hxe : ⟪x, T e⟫_ℝ = ⟪T e, x⟫_ℝ := real_inner_comm (T e) x
  have hex : ⟪e, T x⟫_ℝ = ⟪T e, x⟫_ℝ := (hT.isSymmetric e x).symm
  have hexp : ⟪x - c • e, T (x - c • e)⟫_ℝ
      = ⟪x, T x⟫_ℝ - 2 * c * ⟪T e, x⟫_ℝ + c ^ 2 * ⟪e, T e⟫_ℝ := by
    simp only [map_sub, map_smul, inner_sub_left, inner_sub_right,
      real_inner_smul_left, real_inner_smul_right]
    rw [hxe, hex]
    ring
  have hcsq : c ^ 2 * ⟪e, T e⟫_ℝ = ⟪T e, x⟫_ℝ ^ 2 / ⟪e, T e⟫_ℝ := by
    rw [hc]
    field_simp
  have hclin : 2 * c * ⟪T e, x⟫_ℝ = 2 * (⟪T e, x⟫_ℝ ^ 2 / ⟪e, T e⟫_ℝ) := by
    rw [hc]
    field_simp
  rw [hexp, hcsq, hclin] at h0
  have hle : ⟪T e, x⟫_ℝ ^ 2 / ⟪e, T e⟫_ℝ ≤ ⟪x, T x⟫_ℝ := by linarith
  have := (div_le_iff₀ hα).mp hle
  linarith [this]
theorem master_decomposition {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (e w : E) (γ : ℝ)
    (hw : ⟪e, w⟫_ℝ = 0) :
    ⟪γ • e + w, T (γ • e + w)⟫_ℝ
      = γ ^ 2 * ⟪e, T e⟫_ℝ + 2 * γ * ⟪e, T w⟫_ℝ + ⟪w, T w⟫_ℝ := by
  simp only [map_add, map_smul, inner_add_left, inner_add_right,
    real_inner_smul_left, real_inner_smul_right]
  rw [real_inner_comm (T e) w]
  rw [hT e w]
  ring
theorem master_coercivity {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsPositive) (e w : E) (γ : ℝ)
    (hγ : 0 ≤ γ) (hw : ⟪e, w⟫_ℝ = 0) (hcross : 0 ≤ ⟪e, T w⟫_ℝ) :
    γ ^ 2 * ⟪e, T e⟫_ℝ ≤ ⟪γ • e + w, T (γ • e + w)⟫_ℝ := by
  rw [master_decomposition T hT.isSymmetric e w γ hw]
  have h2 : 0 ≤ 2 * γ * ⟪e, T w⟫_ℝ := by positivity
  have h3 : 0 ≤ ⟪w, T w⟫_ℝ := hT.inner_nonneg_right w
  linarith
noncomputable def lineMetric (P : ℝ) (z : ℂ) : ℝ := P * ‖z‖ ^ 2
theorem master_P2_row {P : ℝ} {a ω : ℂ} (h : (P : ℂ) * a = ω) :
    P * ‖a‖ ^ 2 - 2 * (star a * ω).re = -(P * ‖a‖ ^ 2) := by
  rw [← h]
  have hnorm : star a * a = ((Complex.normSq a : ℝ) : ℂ) :=
    (Complex.normSq_eq_conj_mul_self (z := a)).symm
  have hval : (star a * ((P : ℂ) * a)).re = P * Complex.normSq a := by
    rw [show star a * ((P : ℂ) * a) = (P : ℂ) * (star a * a) by ring, hnorm]
    rw [← Complex.ofReal_mul, Complex.ofReal_re]
  rw [hval, Complex.normSq_eq_norm_sq]
  ring
theorem master_P2_splice (P θ r0 : ℝ) (c : ℂ) :
    - lineMetric P (((θ * r0 : ℝ) : ℂ) * c)
      = - lineMetric P ((r0 : ℂ) * c)
        + ‖c‖ ^ 2 * (lineMetric P (r0 : ℂ) - lineMetric P ((θ * r0 : ℝ) : ℂ)) := by
  unfold lineMetric
  simp only [← Complex.normSq_eq_norm_sq, Complex.normSq_mul, Complex.normSq_ofReal]
  ring
theorem master_P2_deltaS_factor (ε θ : ℝ) :
    ε ^ 2 - (θ * ε) ^ 2 = ε ^ 2 * (1 - θ ^ 2) := by
  ring
theorem master_P2_sharp_scalar {Pi0 P C ε θ : ℝ} (hP : Pi0 ≤ P) (hC : 0 ≤ C)
    (hθ : 0 ≤ 1 - θ ^ 2) :
    (1 - θ ^ 2) * Pi0 * (ε ^ 2 * C) ≤ (ε ^ 2 * C) * (P * (1 - θ ^ 2)) := by
  have h1 : (1 - θ ^ 2) * Pi0 ≤ (1 - θ ^ 2) * P :=
    mul_le_mul_of_nonneg_left hP hθ
  calc (1 - θ ^ 2) * Pi0 * (ε ^ 2 * C)
      ≤ (1 - θ ^ 2) * P * (ε ^ 2 * C) :=
        mul_le_mul_of_nonneg_right h1 (mul_nonneg (sq_nonneg ε) hC)
    _ = (ε ^ 2 * C) * (P * (1 - θ ^ 2)) := by ring
theorem master_P3_completion {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (C D : E →ₗ[ℝ] E) (hC : C.IsSymmetric) (hCD : ∀ x, C (D x) = x) (lam x : E) :
    ⟪x, C x⟫_ℝ - 2 * ⟪lam, x⟫_ℝ
      = -⟪lam, D lam⟫_ℝ + ⟪x - D lam, C (x - D lam)⟫_ℝ := by
  have hsym : ⟪D lam, C x⟫_ℝ = ⟪lam, x⟫_ℝ := by
    rw [← hC (D lam) x, hCD]
  have hexp : ⟪x - D lam, C (x - D lam)⟫_ℝ
      = ⟪x, C x⟫_ℝ - ⟪x, lam⟫_ℝ - ⟪D lam, C x⟫_ℝ + ⟪D lam, lam⟫_ℝ := by
    rw [map_sub, hCD, inner_sub_left, inner_sub_right, inner_sub_right]
    ring
  rw [hexp, hsym]
  rw [real_inner_comm lam x, ← real_inner_comm (D lam) lam]
  ring
theorem master_P3_bound {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (C D : E →ₗ[ℝ] E) (hC : C.IsSymmetric) (hCD : ∀ x, C (D x) = x)
    (hpos : ∀ x, 0 ≤ ⟪x, C x⟫_ℝ) (lam x : E) :
    -⟪lam, D lam⟫_ℝ ≤ ⟪x, C x⟫_ℝ - 2 * ⟪lam, x⟫_ℝ := by
  rw [master_P3_completion C D hC hCD lam x]
  linarith [hpos (x - D lam)]
theorem master_P3_at_response {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (C D : E →ₗ[ℝ] E) (hCD : ∀ x, C (D x) = x) (lam : E) :
    ⟪D lam, C (D lam)⟫_ℝ - 2 * ⟪lam, D lam⟫_ℝ = -⟪lam, D lam⟫_ℝ := by
  rw [hCD]
  rw [← real_inner_comm lam (D lam)]
  ring
theorem posSemidef_unitary_conj {n : Type*} [Fintype n] [DecidableEq n]
    {A U : Matrix n n ℝ} (hU : IsUnit U) :
    (star U * A * U).PosSemidef ↔ A.PosSemidef :=
  Matrix.IsUnit.posSemidef_star_left_conjugate_iff hU
theorem posDef_unitary_conj {n : Type*} [Fintype n] [DecidableEq n]
    {A U : Matrix n n ℝ} (hU : IsUnit U) :
    (star U * A * U).PosDef ↔ A.PosDef :=
  Matrix.IsUnit.posDef_star_left_conjugate_iff hU
theorem inverse_gap_debit {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (C D : E →ₗ[ℝ] E) (hCD : ∀ x, C (D x) = x)
    (γ : ℝ) (hγ : 0 < γ) (hgap : ∀ x, γ * ‖x‖ ^ 2 ≤ ⟪x, C x⟫_ℝ) (lam : E) :
    ⟪lam, D lam⟫_ℝ ≤ ‖lam‖ ^ 2 / γ := by
  have hsquare : 0 ≤ ‖lam - γ • D lam‖ ^ 2 := sq_nonneg _
  rw [norm_sub_sq_real, real_inner_smul_right] at hsquare
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos hγ] at hsquare
  have h1 : 2 * γ * ⟪lam, D lam⟫_ℝ - γ ^ 2 * ‖D lam‖ ^ 2 ≤ ‖lam‖ ^ 2 := by
    nlinarith [hsquare]
  have h2 : γ * ‖D lam‖ ^ 2 ≤ ⟪D lam, C (D lam)⟫_ℝ := hgap (D lam)
  rw [hCD] at h2
  rw [← real_inner_comm (D lam) lam] at h2
  have h3 : γ * ⟪lam, D lam⟫_ℝ ≤ ‖lam‖ ^ 2 := by nlinarith [h1, h2, hγ]
  rw [le_div_iff₀ hγ]
  linarith [h3]
theorem master_coercivity_posDef {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsPositive) (e w : E) (γ : ℝ)
    (hγ : 0 < γ) (hg : 0 < ⟪e, T e⟫_ℝ) (hw : ⟪e, w⟫_ℝ = 0)
    (hcross : 0 ≤ ⟪e, T w⟫_ℝ) :
    0 < ⟪γ • e + w, T (γ • e + w)⟫_ℝ := by
  rw [master_decomposition T hT.isSymmetric e w γ hw]
  have h2 : 0 ≤ 2 * γ * ⟪e, T w⟫_ℝ := by positivity
  have h3 : 0 ≤ ⟪w, T w⟫_ℝ := hT.inner_nonneg_right w
  have h4 : 0 < γ ^ 2 * ⟪e, T e⟫_ℝ := mul_pos (sq_pos_of_pos hγ) hg
  linarith
