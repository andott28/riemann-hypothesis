namespace RHLean.ExplicitFormula
def goodZeroSet : Set ℂ :=
  {z : ℂ | z ≠ 0 ∧ MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z ≠ 0}
def xiZeroSigmaEquiv :
    XiZero ≃ Σ z : goodZeroSet,
      Fin (Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z.1)) where
  toFun p :=
    ⟨⟨p.1.1, p.2, by
        intro hdiv
        have h0 : Int.toNat (MeromorphicOn.divisor riemannXi
            (Set.univ : Set ℂ) p.1.1) = 0 := by simp [hdiv]
        have := p.1.2.isLt
        omega⟩, p.1.2⟩
  invFun q := ⟨⟨q.1.1, q.2⟩, q.1.2.1⟩
  left_inv p := by
    rcases p with ⟨⟨z, i⟩, hz⟩
    rfl
  right_inv q := by
    rcases q with ⟨⟨z, hz⟩, i⟩
    rfl
def goodZeroEquiv :
    goodZeroSet ≃ {ρ : ℂ // Zeta23.IsNontrivialZero ρ} where
  toFun z := ⟨z.1, isNontrivialZero_of_divisor_ne_zero z.2.1 z.2.2⟩
  invFun ρ := ⟨ρ.1, by
    refine ⟨?_, divisor_ne_zero_of_isNontrivialZero ρ.2⟩
    intro h
    have hre := ρ.2.2.1
    rw [h] at hre
    norm_num at hre⟩
  left_inv z := by
    rcases z with ⟨z, hz⟩
    rfl
  right_inv ρ := by
    rcases ρ with ⟨ρ, hρ⟩
    rfl
theorem tsum_XiZero_eq_zetaZeros {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    (∑' p : XiZero, transf (autocorr f) (centeredZero p))
      = ∑' ρ : {ρ : ℂ // Zeta23.IsNontrivialZero ρ},
          (Zeta23.zeroMult ρ : ℂ) * Zeta23.WeilEF.Hfn (autocorr f) ρ := by
  let F : XiZero → ℂ := fun p => transf (autocorr f) (centeredZero p)
  have hsum : Summable F := summable_transf_autocorr hf
  calc
    (∑' p : XiZero, F p)
        = ∑' q : Σ z : goodZeroSet,
            Fin (Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z.1)),
            F (xiZeroSigmaEquiv.symm q) :=
          (Equiv.tsum_eq xiZeroSigmaEquiv.symm F).symm
    _ = ∑' z : goodZeroSet,
          ∑' i : Fin (Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z.1)),
            F (xiZeroSigmaEquiv.symm ⟨z, i⟩) := by
          rw [Summable.tsum_sigma]
          exact (Equiv.summable_iff xiZeroSigmaEquiv.symm).mpr hsum
    _ = ∑' z : goodZeroSet,
          (Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z.1) : ℂ)
            * transf (autocorr f) (z.1 - 1 / 2) := by
          refine tsum_congr fun z => ?_
          have hconst : ∀ i : Fin (Int.toNat (MeromorphicOn.divisor riemannXi
              (Set.univ : Set ℂ) z.1)),
              F (xiZeroSigmaEquiv.symm ⟨z, i⟩)
                = transf (autocorr f) (z.1 - 1 / 2) := by
            intro i
            simp [F, xiZeroSigmaEquiv, centeredZero]
          rw [tsum_congr hconst, tsum_fintype, Finset.sum_const, Finset.card_univ,
            Fintype.card_fin]
          simp [nsmul_eq_mul]
    _ = ∑' ρ : {ρ : ℂ // Zeta23.IsNontrivialZero ρ},
          (Zeta23.zeroMult ρ : ℂ) * Zeta23.WeilEF.Hfn (autocorr f) ρ := by
          have hz : ∀ z : goodZeroSet,
              (Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z.1) : ℂ)
                * transf (autocorr f) (z.1 - 1 / 2)
              = (Zeta23.zeroMult (goodZeroEquiv z) : ℂ)
                * Zeta23.WeilEF.Hfn (autocorr f) (goodZeroEquiv z) := by
            intro z
            have hzdiv : Int.toNat (MeromorphicOn.divisor riemannXi
                (Set.univ : Set ℂ) z.1) = Zeta23.zeroMult (goodZeroEquiv z).1 := by
              simpa [goodZeroEquiv] using
                divisor_eq_zeroMult_of_isNontrivialZero (goodZeroEquiv z).2
            rw [hzdiv, zeta23_Hfn_eq]
            simp [goodZeroEquiv]
          rw [tsum_congr hz]
          exact Equiv.tsum_eq goodZeroEquiv
            (fun ρ : {ρ : ℂ // Zeta23.IsNontrivialZero ρ} =>
              (Zeta23.zeroMult ρ : ℂ) * Zeta23.WeilEF.Hfn (autocorr f) ρ)
end RHLean.ExplicitFormula
namespace RHLean.ExplicitFormula
theorem weilOdd_eq_arch_pole_prime {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    weilOdd f = archimedeanBlock f + poleBlock f - primeSideComb f a / Real.pi := by
  have hodd : f ∈ oddCore := localizedCore_subset_oddCore a hf
  have hcd : ContDiff ℝ 2 (autocorr f) := (contDiff_autocorr hodd).of_le (by simp)
  have hcs : HasCompactSupport (autocorr f) := hasCompactSupport_autocorr hodd
  obtain ⟨_hsum, hval⟩ :=
    (Zeta23.WeilEF.EF_lit_zeta Zeta23.zetaSeam) (autocorr f) hcd hcs
  rw [weilOdd_eq_tsum_transf_autocorr hf.1.1.continuous hf.1.2.1]
  have hsum_eq : (∑' p : XiZero, transf (autocorr f) (centeredZero p))
      = Zeta23.EF.literatureRHS (autocorr f) :=
    (tsum_XiZero_eq_zetaZeros hodd).trans hval
  rw [hsum_eq, zeta23_literatureRHS_autocorr hf]
  simp
theorem weilBridge_unconditional : WeilBridge := by
  intro a ha f hf
  rw [weilOdd_eq_arch_pole_prime hf, localizedForm_eq_blocks ha hf]
  unfold primeSideComb
  ring
end RHLean.ExplicitFormula
namespace RHLean
theorem localPSD_endpoint_seven_of_gramFloorF_unconditional
    (hG : Y7A3GramFloor.GramFloorF (endpoint 7)) :
    LocalPSD (endpoint 7) :=
  localPSD_endpoint_seven_of_gramFloorF
    RHLean.ExplicitFormula.weilBridge_unconditional hG
theorem riemannHypothesis_of_gramFloorF_unconditional
    (hG : Y7A3GramFloor.GramFloorF (endpoint 7))
    (hII : GateIIOperatorStep) : RiemannHypothesis :=
  rh_full_proof RHLean.ExplicitFormula.weilBridge_unconditional
    (localPSD_endpoint_seven_of_gramFloorF_unconditional hG) hII
theorem riemannHypothesis_of_zhu_unconditional
    (hzhu : ZhuBase.ZhuWindowPositivity)
    (hII : ZhuBase.GateIIOperatorStepFour) : RiemannHypothesis :=
  riemannHypothesis_of_zhu_cited
    RHLean.ExplicitFormula.weilBridge_unconditional hzhu hII
theorem gateIIOperatorStep_of_RH (hbridge : WeilBridge) (hRH : RiemannHypothesis) :
    GateIIOperatorStep :=
  fun _ _ _ => LocalPSD_of_weil_nonneg_of_bridge hbridge (weilOdd_nonneg_of_RH hRH) _
theorem gateIIOperatorStep_iff_RH_of_base (hbridge : WeilBridge) (hbase : Y7OperatorTarget) :
    GateIIOperatorStep ↔ RiemannHypothesis :=
  ⟨fun hstep => rh_full_proof hbridge hbase hstep,
   fun hRH => gateIIOperatorStep_of_RH hbridge hRH⟩
theorem not_gateIIOperatorStep_of_not_RH {hbridge : WeilBridge}
    (hbase : Y7OperatorTarget) (hRH : ¬ RiemannHypothesis) :
    ¬ GateIIOperatorStep :=
  fun hstep => hRH ((gateIIOperatorStep_iff_RH_of_base hbridge hbase).1 hstep)
theorem rh_iff_base_and_step (hbridge : WeilBridge) :
    (Y7OperatorTarget ∧ GateIIOperatorStep) ↔ RiemannHypothesis :=
  operator_targets_iff_RH_of_bridge hbridge
end RHLean
