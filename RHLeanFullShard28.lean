theorem exists_span_right_l2_approx (a b : ℝ) (u : ℝ → ℂ)
    (hu : Continuous u) (hre : ∀ x, (u x).im = 0)
    (hab : a < b) (ε : ℝ) (hε : 0 < ε) :
    ∃ N g,
      g ∈ Submodule.span ℝ (Set.range (RHLean.GateII.Reduction.truncBasis a b N))
      ∧ ∫ x in Set.Ioo a b, ‖g x - u x‖ ^ 2 ≤ ε ^ 2 * (b - a) := by
  have hane : b ≠ a := ne_of_gt hab
  obtain ⟨q, hq⟩ := exists_poly_uniform_approx_on_Icc a b (fun x : ℝ => (u x).re)
    (by fun_prop) ε hε
  let p : Polynomial ℝ := q.comp
    (Polynomial.C ((b - a) / 2) * Polynomial.X + Polynomial.C ((a + b) / 2))
  have hpv : ∀ x : ℝ, p.eval ((2 * x - (a + b)) / (b - a)) = q.eval x := fun x => by
    show (q.comp (Polynomial.C ((b - a) / 2) * Polynomial.X
        + Polynomial.C ((a + b) / 2))).eval ((2 * x - (a + b)) / (b - a)) = q.eval x
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X]
    rw [show ((b - a) / 2) * ((2 * x - (a + b)) / (b - a)) + (a + b) / 2 = x
        from by field_simp [hane]; ring]
  refine ⟨p.natDegree + 1,
    Set.indicator (Set.Ioo a b) (fun t =>
      ((p.eval ((2 * t - (a + b)) / (b - a)) : ℝ) : ℂ)), ?_, ?_⟩
  · exact mem_span_truncBasis_rightIndicator a b (p.natDegree + 1) p
      (Nat.lt_succ_self _)
  · have hpt : ∀ x ∈ Set.Ioo a b,
        ‖Set.indicator (Set.Ioo a b) (fun t =>
            ((p.eval ((2 * t - (a + b)) / (b - a)) : ℝ) : ℂ)) x - u x‖ ^ 2
          = (q.eval x - (u x).re) ^ 2 := fun x hx => by
      rw [Set.indicator_of_mem hx, hpv]
      have huf : u x = ((u x).re : ℂ) := by
        rw [← Complex.re_add_im (u x)]
        simp [hre x]
      rw [huf, ← Complex.ofReal_sub]
      have hn : ‖((((q.eval x - (u x).re : ℝ)) : ℂ))‖ = |q.eval x - (u x).re| :=
        RCLike.norm_ofReal _
      rw [hn]
      simp [sq_abs]
    rw [setIntegral_congr_fun measurableSet_Ioo hpt]
    have hfin : volume (Set.Ioo a b) < ⊤ := by
      rw [Real.volume_Ioo]
      exact ENNReal.ofReal_lt_top
    have hvol : (volume (Set.Ioo a b)).toReal = b - a := by
      rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    have hC : ∀ x ∈ Set.Ioo a b, ‖(q.eval x - (u x).re) ^ 2‖ ≤ ε ^ 2 := fun x hx => by
      have h1 : |q.eval x - (u x).re| ≤ ε := hq x ⟨le_of_lt hx.1, le_of_lt hx.2⟩
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      nlinarith [abs_le.mp h1, hε, sq_nonneg (q.eval x - (u x).re)]
    have hb2 := norm_setIntegral_le_of_norm_le_const (μ := volume) hfin hC
    rw [measureReal_def, hvol] at hb2
    rw [Real.norm_eq_abs] at hb2
    exact (abs_le.mp hb2).2
