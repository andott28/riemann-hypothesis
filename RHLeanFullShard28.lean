theorem admissible_gamma_outer_field (a : ℝ) (h g : ℝ → ℂ) (B : ℝ)
    (ha : 0 ≤ a) (ch : Continuous h) (cg : Continuous g)
    (bh : ∀ x ∈ Set.Ioo (-a) a, ‖h x‖ ≤ B)
    (bg : ∀ y ∈ Set.Ioo (-a) a, ‖g y‖ ≤ B) :
    IntegrableOn (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
        RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re)
      (Set.Ioo (-a) a) volume := by
  set K := Real.exp (2 * a) / 2 + Real.exp (2 * a / 2) / 4 with hKdef
  have hK0 : 0 ≤ K := by positivity
  have hfin : volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hvol : (volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  refine IntegrableOn.of_bound hfin ?hmeas (K * B * B * (2 * a)) ?hbound
  · have hmeas : Measurable (fun p : ℝ × ℝ =>
        RHLean.gammaKernel ‖p.1 - p.2‖ * (h p.1 * star (g p.2)).re) := by
      refine Measurable.mul ?_ ?_
      · exact RHLean.GateII.Collar.measurable_gammaKernel.comp (by fun_prop)
      · fun_prop
    have hf : AEStronglyMeasurable (fun p : ℝ × ℝ =>
        RHLean.gammaKernel ‖p.1 - p.2‖ * (h p.1 * star (g p.2)).re)
        (volume.prod (volume.restrict (Set.Ioo (-a) a))) :=
      hmeas.aestronglyMeasurable
    simpa only using (hf.integral_prod_right').mono_measure Measure.restrict_le_self
  · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
    have hxa : |x| ≤ a := by
      rw [abs_le]
      exact ⟨le_of_lt hx.1, le_of_lt hx.2⟩
    have hC : ∀ y ∈ Set.Ioo (-a) a,
        ‖RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re‖ ≤ K * B * B := by
      intro y hy
      have hyn : |y| ≤ a := by
        rw [abs_le]
        exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
      have hdist : ‖x - y‖ ≤ 2 * a := by
        calc ‖x - y‖ ≤ ‖x‖ + ‖y‖ := norm_sub_le x y
          _ = |x| + |y| := by rw [Real.norm_eq_abs, Real.norm_eq_abs]
          _ ≤ 2 * a := by linarith
      have hker : |RHLean.gammaKernel ‖x - y‖| ≤ K := by
        rw [hKdef]
        exact RHLean.GateII.Collar.gammaKernel_abs_le (by positivity)
          (Set.mem_Icc.mpr ⟨norm_nonneg _, hdist⟩)
      have hre : |(h x * star (g y)).re| ≤ B * B := by
        calc |(h x * star (g y)).re| ≤ ‖h x * star (g y)‖ := Complex.abs_re_le_norm _
          _ = ‖h x‖ * ‖g y‖ := by rw [norm_mul, norm_star]
          _ ≤ B * B := by
            nlinarith [bh x hx, bg y hy, norm_nonneg (h x), norm_nonneg (g y)]
      rw [Real.norm_eq_abs, abs_mul]
      calc |RHLean.gammaKernel ‖x - y‖| * |(h x * star (g y)).re|
          ≤ K * (B * B) := mul_le_mul hker hre (abs_nonneg _) hK0
        _ = K * B * B := by ring
    have hb := norm_setIntegral_le_of_norm_le_const (μ := volume) hfin hC
    rw [measureReal_def, hvol] at hb
    simpa only [mul_assoc] using hb
