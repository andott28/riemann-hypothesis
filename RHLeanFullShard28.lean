private theorem star_I_eq : star (Complex.I : ℂ) = -Complex.I := by
  simp only [Complex.star_def]
  rw [Complex.conj_I]
private theorem mul_I_star_mul_I {z z' : ℂ} :
    (z * Complex.I) * star (z' * Complex.I) = z * star z' := by
  rw [star_mul', star_I_eq,
    show (z * Complex.I) * (star z' * -(Complex.I : ℂ))
      = z * ((Complex.I * (-(Complex.I : ℂ))) * star z') from by ring,
    show Complex.I * (-(Complex.I : ℂ)) = 1 from by
      rw [mul_neg, Complex.I_mul_I, neg_neg]]
  ring
private theorem measurable_endpointPotential' (a : ℝ) :
    Measurable (fun x : ℝ => RHLean.endpointPotential a x) := by
  have hm1 : Measurable (fun x : ℝ => a ^ 2 - x ^ 2) := by fun_prop
  have heq : (fun x : ℝ => RHLean.endpointPotential a x)
      = fun x => (-(1 / 2) : ℝ) * Real.log (a ^ 2 - x ^ 2) := by
    funext x
    rw [RHLean.ExplicitFormula.endpointPotential_eq]
  rw [heq]
  exact hm1.log.const_mul (-(1 / 2))
theorem localizedForm_imag_eq_real (a : ℝ) (vr : ℝ → ℝ) :
    RHLean.localizedForm a (fun x : ℝ => ((vr x : ℝ) : ℂ) * Complex.I)
      = RHLean.localizedForm a (fun x : ℝ => ((vr x : ℝ) : ℂ)) := by
  set w : ℝ → ℂ := fun x => ((vr x : ℝ) : ℂ) with hwd
  set wI : ℝ → ℂ := fun x => w x * Complex.I with hwId
  have hkey : ∀ x y : ℝ, wI x * star (wI y) = w x * star (w y) := by
    intro x y
    show (w x * Complex.I) * star (w y * Complex.I) = w x * star (w y)
    exact mul_I_star_mul_I
  have hnorm : ∀ x y : ℝ, ‖wI x - wI y‖ = ‖w x - w y‖ := by
    intro x y
    show ‖w x * Complex.I - w y * Complex.I‖ = ‖w x - w y‖
    rw [show w x * Complex.I - w y * Complex.I = (w x - w y) * Complex.I from by
        ring, norm_mul, Complex.norm_I, mul_one]
  have hquot : ∀ x y : ℝ, ‖wI x - wI y‖ ^ 2 / ‖x - y‖
      = ‖w x - w y‖ ^ 2 / ‖x - y‖ := fun x y => by rw [hnorm x y]
  have hmasssq : ∀ x : ℝ, ‖wI x‖ ^ 2 = ‖w x‖ ^ 2 := by
    intro x
    show ‖w x * Complex.I‖ ^ 2 = ‖w x‖ ^ 2
    rw [norm_mul, Complex.norm_I, mul_one]
  have harchEq : RHLean.archForm a wI = RHLean.archForm a w := by
    unfold RHLean.archForm
    rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          ‖wI x - wI y‖ ^ 2 / ‖x - y‖ ∂volume)
        = (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
          ‖w x - w y‖ ^ 2 / ‖x - y‖ ∂volume) from by
        funext x
        exact MeasureTheory.setIntegral_congr_fun measurableSet_Ioo
          (fun y _ => hquot x y)]
  have hmassEq : ∫ x in Set.Ioo (-a) a, ‖wI x‖ ^ 2 ∂volume
      = ∫ x in Set.Ioo (-a) a, ‖w x‖ ^ 2 ∂volume :=
    MeasureTheory.setIntegral_congr_fun measurableSet_Ioo
      (fun x _ => hmasssq x)
  have hpotEq : RHLean.potentialForm a wI = RHLean.potentialForm a w := by
    unfold RHLean.potentialForm
    rw [show (fun x : ℝ => RHLean.endpointPotential a x * ‖wI x‖ ^ 2)
        = (fun x : ℝ => RHLean.endpointPotential a x * ‖w x‖ ^ 2) from by
        funext x
        rw [hmasssq x]]
  have hgamEq : RHLean.gammaForm a wI = RHLean.gammaForm a w := by
    unfold RHLean.gammaForm
    rw [show (fun x : ℝ => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (wI x * star (wI y)).re ∂volume)
        = (fun x : ℝ => ∫ y in Set.Ioo (-a) a, RHLean.gammaKernel ‖x - y‖
          * (w x * star (w y)).re ∂volume) from by
        funext x
        refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioo
          (fun y _ => ?_)
        rw [show (wI x * star (wI y)).re = (w x * star (w y)).re from by
          rw [hkey x y]]]
  have hpolIn : RHLean.polarInner a wI = Complex.I * RHLean.polarInner a w := by
    unfold RHLean.polarInner
    rw [show (fun y : ℝ => star (RHLean.sph y) * wI y)
        = (fun y : ℝ => Complex.I • (star (RHLean.sph y) * w y)) from by
        funext y
        show star (RHLean.sph y) * (w y * Complex.I)
            = Complex.I • (star (RHLean.sph y) * w y)
        rw [smul_eq_mul]
        ring
      , MeasureTheory.integral_smul, smul_eq_mul]
  have hpolEq : RHLean.polarForm a wI = RHLean.polarForm a w := by
    unfold RHLean.polarForm
    rw [hpolIn, show ‖Complex.I * RHLean.polarInner a w‖ ^ 2
        = ‖RHLean.polarInner a w‖ ^ 2 from by
        rw [norm_mul, Complex.norm_I, one_mul]]
  have hshiEq : RHLean.shiftForm a wI = RHLean.shiftForm a w := by
    unfold RHLean.shiftForm
    refine Finset.sum_congr rfl (fun n hn => ?_)
    have hinner : ∫ x in Set.Ioo (-a) a,
        wI x * star (wI (x + RHLean.shiftLength n)) ∂volume
        = ∫ x in Set.Ioo (-a) a,
          w x * star (w (x + RHLean.shiftLength n)) ∂volume :=
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioo
        (fun x _ => hkey x (x + RHLean.shiftLength n))
    rw [hinner]
  unfold RHLean.localizedForm
  rw [harchEq, hpotEq, hgamEq, hpolEq, hshiEq,
    show RHLean.physicalConstant * (∫ x in Set.Ioo (-a) a, ‖wI x‖ ^ 2 ∂volume)
        = RHLean.physicalConstant
          * (∫ x in Set.Ioo (-a) a, ‖w x‖ ^ 2 ∂volume) from
        congrArg (fun X : ℝ => RHLean.physicalConstant * X) hmassEq]
theorem gramSemidefToLocalPSD_of_stack :
    RHLean.GateII.A3.GramSemidefToLocalPSD := by
  intro k hk hGram
  have hapos : 0 < RHLean.endpoint (k + 1) :=
    RHLean.GateII.Reduction.endpoint_pos (by omega)
  have ha₀pos : 0 < RHLean.endpoint k :=
    RHLean.GateII.Reduction.endpoint_pos (by omega)
  have ha₀a : RHLean.endpoint k < RHLean.endpoint (k + 1) :=
    RHLean.GateII.Reduction.endpoint_succ_gt (by omega)
  refine (RHLean.LocalPSD_iff _).mpr ?_
  intro _ f hf
  have hfzero : ∀ x : ℝ, x ∉ Set.Ioo (-RHLean.endpoint (k + 1))
      (RHLean.endpoint (k + 1)) → f x = 0 := by
    intro x hx
    by_contra h
    exact hx (hf.2 (Function.mem_support.mpr h))
  obtain ⟨Bu, hBu0, hBuf⟩ :=
    RHLean.ExplicitFormula.exists_norm_le_of_localizedCore hf
  have hu : 0 ≤ RHLean.localizedForm (RHLean.endpoint (k + 1))
      (fun x : ℝ => ((f x).re : ℂ)) := by
    have hCDre2 : ContDiff ℝ ∞ (fun x : ℝ => (f x).re) := by
      have h1 : ContDiff ℝ ∞ (Complex.reCLM ∘ f) :=
        Complex.reCLM.contDiff.comp hf.1.1
      have h2 : (Complex.reCLM ∘ f) = (fun x : ℝ => (f x).re) := by
        funext x
        exact Complex.reCLM_apply (f x)
      rw [h2] at h1
      exact h1
    obtain ⟨Lu, hLu⟩ := (isCompact_Icc (a := -RHLean.endpoint (k + 1))
      (b := RHLean.endpoint (k + 1))).exists_bound_of_continuousOn
      (hCDre2.continuous_deriv (by norm_num)).continuousOn
    exact Y7Epsilon.localizedForm_nonneg_of_real_core
      (a := RHLean.endpoint (k + 1)) (a₀ := RHLean.endpoint k) (Lu := Lu)
      (Bu := Bu) (fun x => (f x).re) hapos ha₀pos ha₀a
      (fun t => (hCDre2.differentiable (by simp) t).hasDerivAt)
      (hCDre2.continuous_deriv (by norm_num))
      (fun t ht => by
        have h1 := hLu t ht
        rw [Real.norm_eq_abs] at h1
        exact h1)
      (by
        show (f (-RHLean.endpoint (k + 1))).re = 0
        rw [hfzero (-RHLean.endpoint (k + 1)) (by
          intro h
          exact absurd h.1 (lt_irrefl _))]
        simp)
      (fun t _ => le_trans (Complex.abs_re_le_norm (f t)) (hBuf t))
      (fun x => le_trans (Complex.abs_re_le_norm (f x)) (hBuf x))
      (fun x hx => by rw [hfzero x hx]; simp)
      (measurable_endpointPotential' _) hGram
  have hv : 0 ≤ RHLean.localizedForm (RHLean.endpoint (k + 1))
      (fun x : ℝ => ((f x).im : ℂ)) := by
    have hCDim2 : ContDiff ℝ ∞ (fun x : ℝ => (f x).im) := by
      have h1 : ContDiff ℝ ∞ (Complex.imCLM ∘ f) :=
        Complex.imCLM.contDiff.comp hf.1.1
      have h2 : (Complex.imCLM ∘ f) = (fun x : ℝ => (f x).im) := by
        funext x
        exact Complex.imCLM_apply (f x)
      rw [h2] at h1
      exact h1
    obtain ⟨Lu, hLu⟩ := (isCompact_Icc (a := -RHLean.endpoint (k + 1))
      (b := RHLean.endpoint (k + 1))).exists_bound_of_continuousOn
      (hCDim2.continuous_deriv (by norm_num)).continuousOn
    exact Y7Epsilon.localizedForm_nonneg_of_real_core
      (a := RHLean.endpoint (k + 1)) (a₀ := RHLean.endpoint k) (Lu := Lu)
      (Bu := Bu) (fun x => (f x).im) hapos ha₀pos ha₀a
      (fun t => (hCDim2.differentiable (by simp) t).hasDerivAt)
      (hCDim2.continuous_deriv (by norm_num))
      (fun t ht => by
        have h1 := hLu t ht
        rw [Real.norm_eq_abs] at h1
        exact h1)
      (by
        show (f (-RHLean.endpoint (k + 1))).im = 0
        rw [hfzero (-RHLean.endpoint (k + 1)) (by
          intro h
          exact absurd h.1 (lt_irrefl _))]
        simp)
      (fun t _ => le_trans (Complex.abs_im_le_norm (f t)) (hBuf t))
      (fun x => le_trans (Complex.abs_im_le_norm (f x)) (hBuf x))
      (fun x hx => by rw [hfzero x hx]; simp)
      (measurable_endpointPotential' _) hGram
  have hadd : RHLean.localizedForm (RHLean.endpoint (k + 1))
      ((fun x : ℝ => ((f x).re : ℂ))
        + (fun x : ℝ => ((f x).im : ℂ) * Complex.I))
      = RHLean.localizedForm (RHLean.endpoint (k + 1))
          (fun x : ℝ => ((f x).re : ℂ))
        + RHLean.localizedForm (RHLean.endpoint (k + 1))
          (fun x : ℝ => ((f x).im : ℂ) * Complex.I) :=
    Y7GateIIAdd.localizedForm_add_real_imag_of_core _ _ f
      (fun x : ℝ => ((f x).re : ℂ)) (fun x : ℝ => ((f x).im : ℂ) * Complex.I)
      (fun _ => rfl) (fun _ => rfl) hf hapos
  have huvf : (fun x : ℝ => ((f x).re : ℂ))
      + (fun x : ℝ => ((f x).im : ℂ) * Complex.I) = f := by
    funext x
    rw [Complex.ext_iff]
    simp [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
      Complex.I_re, Complex.I_im, Complex.ofReal_re, Complex.ofReal_im]
  have hvE7 : RHLean.localizedForm (RHLean.endpoint (k + 1))
      (fun x : ℝ => ((f x).im : ℂ) * Complex.I)
      = RHLean.localizedForm (RHLean.endpoint (k + 1))
        (fun x : ℝ => ((f x).im : ℂ)) :=
    localizedForm_imag_eq_real _ (fun x => (f x).im)
  rw [← huvf, hadd, hvE7]
  exact add_nonneg hu hv
end Y7Epsilon
