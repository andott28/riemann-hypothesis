theorem collarBasisRight_mem_range_truncBasis (a b : ℝ) (N k : ℕ) (hk : k < N) :
    RHLean.GateII.Reduction.collarBasisRight a b k
      ∈ Set.range (RHLean.GateII.Reduction.truncBasis a b N) := by
  refine ⟨Sum.inr (Sum.inl ⟨k, hk⟩), ?_⟩
  simp only [RHLean.GateII.Reduction.truncBasis, Sum.elim_inr, Sum.elim_inl, Fin.val_mk]
theorem mem_span_truncBasis_rightIndicator (a b : ℝ) (N : ℕ) (p : Polynomial ℝ)
    (hdeg : p.natDegree < N) :
    Set.indicator (Set.Ioo a b) (fun x =>
        ((p.eval ((2 * x - (a + b)) / (b - a)) : ℝ) : ℂ))
