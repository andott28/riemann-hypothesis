private lemma eval_sum_monomial (s : Finset ℕ) (c : ℕ → ℝ) (x : ℝ) :
    (∑ k ∈ s, Polynomial.monomial k (c k)).eval x = ∑ k ∈ s, c k * x ^ k := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert k s hk ih =>
      rw [Finset.sum_insert hk, Finset.sum_insert hk, Polynomial.eval_add,
        Polynomial.eval_monomial, ih]
theorem exists_c1_poly_approx {a Lu η : ℝ} (ha : 0 < a) (hη : 0 < η)
    (u : ℝ → ℝ) (hud : ∀ t : ℝ, HasDerivAt u (deriv u t) t)
    (hduc : Continuous (deriv u))
    (huL : ∀ t ∈ Set.Icc (-a) a, |deriv u t| ≤ Lu)
    (huA : u (-a) = 0) :
    ∃ P : Polynomial ℝ, P.eval (-a) = 0 ∧
      (∀ x ∈ Set.Icc (-a) a, |P.eval x - u x| ≤ 2 * a * η) ∧
      (∀ x ∈ Set.Icc (-a) a, |(P.derivative).eval x| ≤ Lu + η) := by
  obtain ⟨R, hR⟩ := Y7GateIIAdd.exists_poly_uniform_approx_on_Icc (-a) a
    (deriv u) hduc η hη
  set I : Polynomial ℝ := ∑ k ∈ Finset.range (R.natDegree + 1),
      Polynomial.monomial (k + 1) (R.coeff k / ((k : ℝ) + 1)) with hIdef
  set P : Polynomial ℝ := I + Polynomial.C (-(I.eval (-a))) with hPdef
  have hPR : ∀ t : ℝ, (P.derivative).eval t = R.eval t := by
    intro t
    rw [hPdef, hIdef]
    simp only [Polynomial.derivative_add, Polynomial.derivative_C, add_zero,
      Polynomial.derivative_sum, Polynomial.derivative_monomial_succ,
      Nat.cast_succ]
    have h3 : (∑ k ∈ Finset.range (R.natDegree + 1),
        Polynomial.monomial k ((R.coeff k / ((k : ℝ) + 1)) * ((k : ℝ) + 1)))
        = ∑ k ∈ Finset.range (R.natDegree + 1),
          Polynomial.monomial k (R.coeff k) :=
      Finset.sum_congr rfl (fun k _ => by
        rw [div_mul_cancel₀ _ (ne_of_gt (by positivity : (0:ℝ) < (k : ℝ) + 1))])
    rw [h3, eval_sum_monomial, Polynomial.eval_eq_sum_range]
  have hP0 : P.eval (-a) = 0 := by
    rw [hPdef]
    simp only [Polynomial.eval_add, Polynomial.eval_C]
    ring
  refine ⟨P, hP0, ?_, ?_⟩
  · intro x hx
    have hseg : ∀ t ∈ Set.Icc (-a) x,
        HasDerivWithinAt (fun t => u t - P.eval t)
          (deriv u t - (P.derivative).eval t) (Set.Icc (-a) x) t := by
      intro t _
      have hd : HasDerivAt (fun t : ℝ => u t - P.eval t)
          (deriv u t - (P.derivative).eval t) t :=
        (hud t).sub (P.hasDerivAt t)
      exact hd.hasDerivWithinAt
    have hbound : ∀ t ∈ Set.Ico (-a) x,
        |deriv u t - (P.derivative).eval t| ≤ η := by
      intro t ht
      have hta : t ∈ Set.Icc (-a) a := ⟨ht.1, le_trans ht.2.le hx.2⟩
      rw [hPR t, abs_sub_comm]
      exact hR t hta
    have hmvt := norm_image_sub_le_of_norm_deriv_le_segment'
      (a := -a) (b := x) (f := fun t => u t - P.eval t)
      (f' := fun t => deriv u t - (P.derivative).eval t) (C := η)
      hseg hbound
    have hvx := hmvt x ⟨hx.1, le_rfl⟩
    rw [show u (-a) - P.eval (-a) = 0 from by rw [huA, hP0]; ring,
      Real.norm_eq_abs, sub_zero] at hvx
    calc |P.eval x - u x| = |u x - P.eval x| := abs_sub_comm _ _
      _ ≤ η * (x - (-a)) := hvx
      _ ≤ 2 * a * η := by nlinarith [hx.1, hx.2, hη]
  · intro x hx
    rw [hPR x]
    calc |R.eval x| = |(R.eval x - deriv u x) + deriv u x| := by ring
      _ ≤ |R.eval x - deriv u x| + |deriv u x| := abs_add_le _ _
      _ ≤ η + Lu := by
          have h1 := hR x hx
          have h2 := huL x hx
          linarith
      _ = Lu + η := by ring
end Y7Epsilon
namespace Y7Epsilon
theorem exists_span_c1_approx {a a₀ η Bu Lu : ℝ} (ha : 0 < a) (ha₀ : 0 < a₀)
    (ha₀a : a₀ < a)
    (ur : ℝ → ℝ) (hud : ∀ t : ℝ, HasDerivAt ur (deriv ur t) t)
    (hduc : Continuous (deriv ur))
    (huL : ∀ t ∈ Set.Icc (-a) a, |deriv ur t| ≤ Lu) (huA : ur (-a) = 0)
    (hBu : ∀ x ∈ Set.Icc (-a) a, |ur x| ≤ Bu) (hη : 0 < η) :
    ∃ (N : ℕ) (g : ℝ → ℂ),
      g ∈ Submodule.span ℝ (Set.range
          (RHLean.GateII.Reduction.truncBasis a₀ a N)) ∧
      (∀ x : ℝ, ‖g x‖ ≤ Bu + 2 * a * η) ∧
      (∀ x ∈ Set.Ioo (-a) a, x ≠ a₀ → x ≠ -a₀ →
        ∀ y ∈ Set.Ioo (-a) a, y ≠ a₀ → y ≠ -a₀ →
          ‖g x - g y‖ ≤ (Lu + η) * |x - y|) ∧
      (∫ x in Set.Ioo (-a) a, ‖g x - ((ur x : ℝ) : ℂ)‖ ^ 2
        ≤ (2 * a * η) ^ 2 * (2 * a)) := by
  obtain ⟨P, hP0, hPc0, hPd⟩ := Y7Epsilon.exists_c1_poly_approx ha hη ur hud hduc
    huL huA
  set p_old : Polynomial ℝ :=
    P.comp (Polynomial.C a₀ * Polynomial.X) with hp_old
  set p_R : Polynomial ℝ :=
    P.comp (Polynomial.C ((a - a₀) / 2) * Polynomial.X
      + Polynomial.C ((a₀ + a) / 2)) with hp_R
  set p_L : Polynomial ℝ :=
    P.comp (Polynomial.C ((a - a₀) / 2) * Polynomial.X
      + Polynomial.C (-(a₀ + a) / 2)) with hp_L
  have hne : a - a₀ ≠ 0 := by linarith
  have hIold : ∀ x : ℝ, p_old.eval (x / a₀) = P.eval x := fun x => by
    show (P.comp (Polynomial.C a₀ * Polynomial.X)).eval (x / a₀) = P.eval x
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    field_simp
  have hIR : ∀ x : ℝ,
      p_R.eval ((2 * x - (a₀ + a)) / (a - a₀)) = P.eval x := fun x => by
    show (P.comp (Polynomial.C ((a - a₀) / 2) * Polynomial.X
      + Polynomial.C ((a₀ + a) / 2))).eval ((2 * x - (a₀ + a)) / (a - a₀))
      = P.eval x
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X]
    have key : ((a - a₀) / 2) * ((2 * x - (a₀ + a)) / (a - a₀))
        + (a₀ + a) / 2 = x := by
      field_simp [hne]
      ring
    rw [key]
  have hIL : ∀ x : ℝ,
      p_L.eval ((2 * x + (a₀ + a)) / (a - a₀)) = P.eval x := fun x => by
    show (P.comp (Polynomial.C ((a - a₀) / 2) * Polynomial.X
      + Polynomial.C (-(a₀ + a) / 2))).eval ((2 * x + (a₀ + a)) / (a - a₀))
      = P.eval x
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X]
    have key : ((a - a₀) / 2) * ((2 * x + (a₀ + a)) / (a - a₀))
        + -(a₀ + a) / 2 = x := by
      field_simp [hne]
      ring
    rw [key]
  set N : ℕ := p_old.natDegree + p_R.natDegree + p_L.natDegree + 1 with hN
  set g_old : ℝ → ℂ := Set.indicator (Set.Ioo (-a₀) a₀)
    (fun x => ((p_old.eval (x / a₀) : ℝ) : ℂ)) with hgold
  set g_R : ℝ → ℂ := Set.indicator (Set.Ioo a₀ a)
    (fun x => ((p_R.eval ((2 * x - (a₀ + a)) / (a - a₀)) : ℝ) : ℂ)) with hgR
  set g_L : ℝ → ℂ := Set.indicator (Set.Ioo (-a) (-a₀))
    (fun x => ((p_L.eval ((2 * x + (a₀ + a)) / (a - a₀)) : ℝ) : ℂ)) with hgL
  set g : ℝ → ℂ := g_old + g_R + g_L with hgdef
  have hmem : g ∈ Submodule.span ℝ (Set.range
      (RHLean.GateII.Reduction.truncBasis a₀ a N)) := by
    have h1 : g_old ∈ Submodule.span ℝ (Set.range
        (RHLean.GateII.Reduction.truncBasis a₀ a N)) :=
      Y7GateIIAdd.mem_span_truncBasis_oldIndicator a₀ a N p_old
        (by rw [hN]; omega)
    have h2 : g_R ∈ Submodule.span ℝ (Set.range
        (RHLean.GateII.Reduction.truncBasis a₀ a N)) :=
      Y7GateIIAdd.mem_span_truncBasis_rightIndicator a₀ a N p_R
        (by rw [hN]; omega)
    have h3 : g_L ∈ Submodule.span ℝ (Set.range
        (RHLean.GateII.Reduction.truncBasis a₀ a N)) :=
      Y7GateIIAdd.mem_span_truncBasis_leftIndicator a₀ a N p_L
        (by rw [hN]; omega)
    rw [hgdef]
    exact Submodule.add_mem _ (Submodule.add_mem _ h1 h2) h3
  have hLipP : ∀ s ∈ Set.Icc (-a) a, ∀ t ∈ Set.Icc (-a) a,
      |P.eval s - P.eval t| ≤ (Lu + η) * |s - t| := by
    intro s hs t ht
    rcases le_total s t with hst | hts
    · have hm := norm_image_sub_le_of_norm_deriv_le_segment'
        (a := s) (b := t) (f := fun x => P.eval x)
        (f' := fun x => (P.derivative).eval x) (C := Lu + η)
        (fun x _ => (P.hasDerivAt x).hasDerivWithinAt)
        (fun x hx => hPd x ⟨hs.1.trans hx.1, hx.2.le.trans ht.2⟩)
      have hv := hm t ⟨hst, le_rfl⟩
      rw [Real.norm_eq_abs, abs_sub_comm] at hv
      rw [show |s - t| = t - s from by
        rw [abs_sub_comm]; exact abs_of_nonneg (sub_nonneg.mpr hst)]
      exact hv
    · have hm := norm_image_sub_le_of_norm_deriv_le_segment'
        (a := t) (b := s) (f := fun x => P.eval x)
        (f' := fun x => (P.derivative).eval x) (C := Lu + η)
        (fun x _ => (P.hasDerivAt x).hasDerivWithinAt)
        (fun x hx => hPd x ⟨ht.1.trans hx.1, hx.2.le.trans hs.2⟩)
      have hv := hm s ⟨hts, le_rfl⟩
      rw [Real.norm_eq_abs] at hv
      rw [abs_of_nonneg (sub_nonneg.mpr hts)]
      exact hv
  have hptw : ∀ x ∈ Set.Ioo (-a) a, x ≠ a₀ → x ≠ -a₀ →
      g x = ((P.eval x : ℝ) : ℂ) := by
    intro x hxW hxa hxma
    rcases lt_or_gt_of_ne hxa with hxa | hxa
    ·
      rcases lt_or_gt_of_ne hxma with hxm | hxm
      ·
        have h1L : x ∈ Set.Ioo (-a) (-a₀) := ⟨hxW.1, hxm⟩
        have h1O : x ∉ Set.Ioo (-a₀) a₀ := by
          rintro ⟨h4, _⟩; exact absurd h4 (not_lt.mpr (le_of_lt hxm))
        have h1R : x ∉ Set.Ioo a₀ a := by
          rintro ⟨h4, _⟩; exact absurd h4 (not_lt.mpr (le_of_lt hxa))
        rw [hgdef, hgold, hgR, hgL]
        simp only [Pi.add_apply, Set.indicator_of_mem h1L,
          Set.indicator_of_notMem h1O, Set.indicator_of_notMem h1R,
          add_zero, zero_add]
        rw [hIL x]
      ·
        have h1O : x ∈ Set.Ioo (-a₀) a₀ := ⟨hxm, hxa⟩
        have h1L : x ∉ Set.Ioo (-a) (-a₀) := by
          rintro ⟨_, h4⟩; exact absurd h4 (not_lt.mpr (le_of_lt hxm))
        have h1R : x ∉ Set.Ioo a₀ a := by
          rintro ⟨h4, _⟩; exact absurd h4 (not_lt.mpr (le_of_lt hxa))
        rw [hgdef, hgold, hgR, hgL]
        simp only [Pi.add_apply, Set.indicator_of_mem h1O,
          Set.indicator_of_notMem h1L, Set.indicator_of_notMem h1R, add_zero]
        rw [hIold x]
    ·
      have h1R : x ∈ Set.Ioo a₀ a := ⟨hxa, hxW.2⟩
      have h1O : x ∉ Set.Ioo (-a₀) a₀ := by
        rintro ⟨_, h4⟩; exact absurd h4 (not_lt.mpr (le_of_lt hxa))
      have h1L : x ∉ Set.Ioo (-a) (-a₀) := by
        rintro ⟨_, h4⟩
        exact absurd h4 (not_lt.mpr (by linarith : (-a₀ : ℝ) ≤ x))
      rw [hgdef, hgold, hgR, hgL]
      simp only [Pi.add_apply, Set.indicator_of_mem h1R,
        Set.indicator_of_notMem h1O, Set.indicator_of_notMem h1L, add_zero,
        zero_add]
      rw [hIR x]
  have hnn : (0:ℝ) ≤ Bu + 2 * a * η := by
    have hB0 := hBu 0 ⟨by linarith, by linarith⟩
    have hnnB : (0:ℝ) ≤ Bu := le_trans (abs_nonneg (ur 0)) hB0
    nlinarith [ha, hη, hnnB]
  have hbound : ∀ x : ℝ, ‖g x‖ ≤ Bu + 2 * a * η := by
    intro x
    rcases Classical.em (x ∈ Set.Ioo (-a) a) with hxW | hxW
    · rcases Classical.em (x = a₀) with hxa | hxa
      · have h1 : x ∉ Set.Ioo (-a₀) a₀ := by
          rw [hxa]; rintro ⟨_, h2⟩; exact absurd h2 (lt_irrefl a₀)
        have h2 : x ∉ Set.Ioo a₀ a := by
          rw [hxa]; rintro ⟨h3, _⟩; exact absurd h3 (lt_irrefl a₀)
        have h3 : x ∉ Set.Ioo (-a) (-a₀) := by
          rw [hxa]; rintro ⟨_, h4⟩
          exact absurd h4 (not_lt.mpr (by linarith))
        rw [hgdef, hgold, hgR, hgL]
        simp only [Pi.add_apply, Set.indicator_of_notMem h1,
          Set.indicator_of_notMem h2, Set.indicator_of_notMem h3, add_zero,
          zero_add, norm_zero]
        exact hnn
      · rcases Classical.em (x = -a₀) with hxm | hxm
        · have h1 : x ∉ Set.Ioo (-a₀) a₀ := by
            rw [hxm]; rintro ⟨h3, _⟩; exact absurd h3 (lt_irrefl (-a₀))
          have h2 : x ∉ Set.Ioo a₀ a := by
            rw [hxm]; rintro ⟨h4, _⟩
            exact absurd h4 (not_lt.mpr (by linarith))
          have h3 : x ∉ Set.Ioo (-a) (-a₀) := by
            rw [hxm]; rintro ⟨_, h5⟩; exact absurd h5 (lt_irrefl (-a₀))
          rw [hgdef, hgold, hgR, hgL]
          simp only [Pi.add_apply, Set.indicator_of_notMem h1,
            Set.indicator_of_notMem h2, Set.indicator_of_notMem h3, add_zero,
            zero_add, norm_zero]
          exact hnn
        · have hgPx : g x = ((P.eval x : ℝ) : ℂ) := hptw x hxW hxa hxm
          have hb0 := hBu x ⟨le_of_lt hxW.1, le_of_lt hxW.2⟩
          have hc0 := hPc0 x ⟨le_of_lt hxW.1, le_of_lt hxW.2⟩
          have hPx : |P.eval x| ≤ Bu + 2 * a * η := by
            calc |P.eval x|
                = |(P.eval x - ur x) + ur x| := by
                  rw [show (P.eval x - ur x) + ur x = P.eval x from by ring]
              _ ≤ |P.eval x - ur x| + |ur x| := abs_add_le _ _
              _ ≤ Bu + 2 * a * η := by linarith
          rw [hgPx]
          have hn : ‖((P.eval x : ℝ) : ℂ)‖ = |P.eval x| := RCLike.norm_ofReal _
          rw [hn]
          exact hPx
    · have h1 : x ∉ Set.Ioo (-a₀) a₀ := by
        rintro ⟨h2, h3⟩
        exact hxW ⟨by linarith, by linarith⟩
      have h2 : x ∉ Set.Ioo a₀ a := by
        rintro ⟨h3, h4⟩
        exact hxW ⟨by linarith, h4⟩
      have h3 : x ∉ Set.Ioo (-a) (-a₀) := by
        rintro ⟨h4, h5⟩
        exact hxW ⟨h4, by linarith⟩
      rw [hgdef, hgold, hgR, hgL]
      simp only [Pi.add_apply, Set.indicator_of_notMem h1,
        Set.indicator_of_notMem h2, Set.indicator_of_notMem h3, add_zero,
        zero_add, norm_zero]
      exact hnn
  refine ⟨N, g, hmem, hbound, ?_, ?_⟩
  ·
    intro x hxW hxa hxma y hyW hya hyma
    rw [hptw x hxW hxa hxma, hptw y hyW hya hyma,
      show ((P.eval x : ℝ) : ℂ) - ((P.eval y : ℝ) : ℂ)
        = (((P.eval x - P.eval y : ℝ)) : ℂ) from by rw [← Complex.ofReal_sub]]
    have hn : ‖(((P.eval x - P.eval y : ℝ)) : ℂ)‖
        = |P.eval x - P.eval y| := RCLike.norm_ofReal _
    rw [hn]
    exact hLipP x ⟨le_of_lt hxW.1, le_of_lt hxW.2⟩
      y ⟨le_of_lt hyW.1, le_of_lt hyW.2⟩
  ·
    have hae0 : ∀ c : ℝ, {x : ℝ | x ≠ c} ∈
        MeasureTheory.ae (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
      intro c
      have hnull : (MeasureTheory.volume.restrict (Set.Ioo (-a) a))
          ({c} : Set ℝ) = 0 := by
        rw [MeasureTheory.Measure.restrict_apply (MeasurableSet.singleton c)]
        exact MeasureTheory.measure_mono_null (fun y hy => hy.1)
          Real.volume_singleton
      have hset : {x : ℝ | x ≠ c} = ({c} : Set ℝ)ᶜ := by
        ext y
        simp
      rw [hset]
      exact MeasureTheory.compl_mem_ae_iff.mpr hnull
    have hmeas_g : Measurable g := by
      rw [hgdef, hgold, hgR, hgL]
      have m1 : Measurable (Set.indicator (Set.Ioo (-a₀) a₀)
          (fun x => ((p_old.eval (x / a₀) : ℝ) : ℂ))) := by
        have hcont : Continuous (fun x => ((p_old.eval (x / a₀) : ℝ) : ℂ)) := by
          fun_prop
        exact hcont.measurable.indicator measurableSet_Ioo
      have m2 : Measurable (Set.indicator (Set.Ioo a₀ a)
          (fun x => ((p_R.eval ((2 * x - (a₀ + a)) / (a - a₀)) : ℝ) : ℂ))) := by
        have hcont : Continuous (fun x => ((p_R.eval
            ((2 * x - (a₀ + a)) / (a - a₀)) : ℝ) : ℂ)) := by fun_prop
        exact hcont.measurable.indicator measurableSet_Ioo
      have m3 : Measurable (Set.indicator (Set.Ioo (-a) (-a₀))
          (fun x => ((p_L.eval ((2 * x + (a₀ + a)) / (a - a₀)) : ℝ) : ℂ))) := by
        have hcont : Continuous (fun x => ((p_L.eval
            ((2 * x + (a₀ + a)) / (a - a₀)) : ℝ) : ℂ)) := by fun_prop
        exact hcont.measurable.indicator measurableSet_Ioo
