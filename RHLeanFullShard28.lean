namespace Y7W5OldMixedHi
open Y7A3Data
open Y7A3GramFloor
open RHLean.GateII.Harmonic
open RHLean.GateII.Reduction
noncomputable def FCoordHi (s : Finset ℕ) (x : ℕ → ℝ) : Fin 7 ⊕ Fin 50 → ℝ :=
  letI : Invertible (Matrix.diagonal Y7A3Data.dd) :=
    RHLean.GateII.Reduction.posDef_invertible_of_posDef _
      (Matrix.posDef_diagonal_iff.mpr Y7A3Data.dd_pos)
  harmonicExtension Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd)
    (Y7W5MarginHi.coordOldHi s x)
def SchurBlockFloorHi (a : ℝ) : Prop :=
  ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) →
    (FCoordHi s x) ⬝ᵥ (Y7W5Connect.FBlockMatrix *ᵥ FCoordHi s x)
      ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM a m n
theorem gramFloorFHi_of_schurBlockFloorHi {a : ℝ}
    (h : SchurBlockFloorHi a) : Y7W5MarginHi.GramFloorFHi a := by
  intro s x hs
  have hD : (Matrix.diagonal Y7A3Data.dd).PosDef :=
    Matrix.posDef_diagonal_iff.mpr Y7A3Data.dd_pos
  letI : Invertible (Matrix.diagonal Y7A3Data.dd) :=
    RHLean.GateII.Reduction.posDef_invertible_of_posDef _ hD
  have hcut := dotProduct_harmonicExtension
    Y7W5Connect.FBlockA Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd) hD.1
    (Y7W5MarginHi.coordOldHi s x)
  have hF : harmonicForm Y7W5Connect.FBlockA Y7A3Data.Bm
      (Matrix.diagonal Y7A3Data.dd) = Y7A3GramFloor.F := by
    unfold Y7W5Connect.FBlockA harmonicForm
    abel
  rw [hF] at hcut
  have hblk := h s x hs
  rw [show FCoordHi s x
      = harmonicExtension Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd)
          (Y7W5MarginHi.coordOldHi s x) from rfl] at hblk
  rw [show Y7W5Connect.FBlockMatrix
      = oldNewBlock Y7W5Connect.FBlockA Y7A3Data.Bm
          (Matrix.diagonal Y7A3Data.dd) from rfl] at hblk
  rw [← hcut]
  exact hblk
theorem gramFloorFHi_endpoint_seven_of_schurBlockFloorHi
    (h : SchurBlockFloorHi (RHLean.endpoint 7)) :
    Y7W5MarginHi.GramFloorFHi (RHLean.endpoint 7) :=
  gramFloorFHi_of_schurBlockFloorHi h
end Y7W5OldMixedHi
