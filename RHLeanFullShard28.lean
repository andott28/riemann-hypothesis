          rw [integral_const, smul_eq_mul]
          have hvol : (MeasureTheory.volume.restrict
              (Set.Ioo (-a : ℝ) a)).real Set.univ = a + a := by
            show (MeasureTheory.volume.restrict
                (Set.Ioo (-a : ℝ) a) Set.univ).toReal = a + a
            rw [MeasureTheory.Measure.restrict_apply MeasurableSet.univ,
              Set.univ_inter, Real.volume_Ioo,
              ENNReal.toReal_ofReal (by linarith)]
            ring
          rw [hvol]
