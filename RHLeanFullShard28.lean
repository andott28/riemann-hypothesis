theorem exists_span_inner_l2_approx (a b : ℝ) (u : ℝ → ℂ)
    (hu : Continuous u) (hodd : ∀ x, u (-x) = -u x)
    (hre : ∀ x, (u x).im = 0) (ha : 0 < a) (ε : ℝ) (hε : 0 < ε) :
    ∃ N g,
      g ∈ Submodule.span ℝ (Set.range (RHLean.GateII.Reduction.truncBasis a b N))
      ∧ ∫ x in Set.Ioo (-a) a, ‖g x - u x‖ ^ 2 ≤ ε ^ 2 * (a + a) := by
  have hane : a ≠ 0 := ne_of_gt ha
  obtain ⟨q, _, hq⟩ := Y7Density.exists_odd_poly_l2_approx
    (f := fun x : ℝ => (u x).re) (by fun_prop)
    (fun x => by show (u (-x)).re = -(u x).re; rw [hodd x, Complex.neg_re])
    (b := a) (le_of_lt ha) hε
  let p : Polynomial ℝ := q.comp (Polynomial.C a * Polynomial.X)
  have hpv : ∀ x : ℝ, p.eval (x / a) = q.eval x := fun x => by
    show (q.comp (Polynomial.C a * Polynomial.X)).eval (x / a) = q.eval x
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    congr 1
    field_simp [hane]
  refine ⟨p.natDegree + 1,
    Set.indicator (Set.Ioo (-a) a) (fun t => ((p.eval (t / a) : ℝ) : ℂ)), ?_, ?_⟩
  · exact mem_span_truncBasis_oldIndicator a b (p.natDegree + 1) p (Nat.lt_succ_self _)
  · have hpt : ∀ x ∈ Set.Ioo (-a) a,
        ‖Set.indicator (Set.Ioo (-a) a) (fun t => ((p.eval (t / a) : ℝ) : ℂ)) x - u x‖ ^ 2
          = (q.eval x - (u x).re) ^ 2 := fun x hx => by
      rw [Set.indicator_of_mem hx, hpv]
      have huf : u x = ((u x).re : ℂ) := by
        rw [← Complex.re_add_im (u x)]
        simp [hre x]
      rw [huf, ← Complex.ofReal_sub]
      have hn : ‖((((q.eval x - (u x).re : ℝ)) : ℂ))‖ = |q.eval x - (u x).re| :=
        RCLike.norm_ofReal _
      rw [hn]
      simp [sq_abs]
    rw [setIntegral_congr_fun measurableSet_Ioo hpt]
    exact hq
end Y7GateIIAdd
