theorem polarInner_sub (a : ℝ) (f₁ f₂ : ℝ → ℂ)
    (h1 : IntegrableOn (fun x => star (RHLean.sph x) * f₁ x) (Set.Ioo (-a) a) volume)
    (h2 : IntegrableOn (fun x => star (RHLean.sph x) * f₂ x) (Set.Ioo (-a) a) volume) :
    RHLean.polarInner a (f₁ - f₂) = RHLean.polarInner a f₁ - RHLean.polarInner a f₂ := by
  unfold RHLean.polarInner
  simp only [Pi.sub_apply]
  have hpt : ∀ x : ℝ, star (RHLean.sph x) * (f₁ x - f₂ x)
      = star (RHLean.sph x) * f₁ x - star (RHLean.sph x) * f₂ x := fun x => by ring
  simp only [hpt]
  exact MeasureTheory.integral_sub h1 h2
