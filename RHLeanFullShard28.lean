        = M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖) * (2 * a) := by
      rw [integral_const (c := M * Bw * (∫ y in Set.Ioo (-a) a, ‖h y‖))
        (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
      ring
    have habs1 : |∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
