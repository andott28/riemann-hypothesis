private lemma re_finset_sum {ι : Type*} (s : Finset ι) (z : ι → ℂ) :
    (∑ i ∈ s, z i).re = ∑ i ∈ s, (z i).re := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, Complex.add_re, ih]
private lemma sumfn_apply {ι : Type*} (s : Finset ι) (c : ι → ℝ) (φ : ι → ℝ → ℂ)
    (t : ℝ) :
    (Finset.sum s (fun i => c i • φ i)) t
      = ∑ i ∈ s, ((c i : ℝ) : ℂ) * φ i t := by
  rw [Finset.sum_apply]
  exact Finset.sum_congr rfl (fun i _ => RCLike.real_smul_eq_coe_mul _ _)
private lemma star_sumfn {ι : Type*} (s : Finset ι) (c : ι → ℝ) (φ : ι → ℝ → ℂ)
    (t : ℝ) :
    star ((Finset.sum s (fun i => c i • φ i)) t)
      = ∑ j ∈ s, ((c j : ℝ) : ℂ) * star (φ j t) := by
  rw [sumfn_apply s c φ t, star_sum]
  exact Finset.sum_congr rfl (fun j _ => Y7GateIIAdd.star_cmul _ _)
private lemma re_sumfn_prod {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (c : ι → ℝ) (φ : ι → ℝ → ℂ) (t₁ t₂ : ℝ) :
    ((Finset.sum s (fun i => c i • φ i)) t₁
        * star ((Finset.sum s (fun j => c j • φ j)) t₂)).re
      = ∑ i ∈ s, ∑ j ∈ s, c i * c j * (φ i t₁ * star (φ j t₂)).re := by
  rw [sumfn_apply s c φ t₁, star_sumfn s c φ t₂, Finset.sum_mul_sum,
    re_finset_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [re_finset_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [show (((c i : ℝ) : ℂ) * φ i t₁) * (((c j : ℝ) : ℂ) * star (φ j t₂))
      = (((c i * c j : ℝ)) : ℂ) * (φ i t₁ * star (φ j t₂)) from by
      push_cast
      ring, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
theorem archBilin_eq_prod {a : ℝ} (f g : ℝ → ℂ)
