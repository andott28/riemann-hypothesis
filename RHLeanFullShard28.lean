theorem legSum_neg_of_odd (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (y : ℝ) :
    Y7Op.legSum x s (-y) = -Y7Op.legSum x s y := by
  rw [Y7Op.legSum_apply, Y7Op.legSum_apply, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl ?_
  intro m hm
  have hphi : Y7Matrix.phiC m (-y) = -Y7Matrix.phiC m y := by
    rw [Y7Matrix.phiC_apply, Y7Matrix.phiC_apply, Y7Density.eval_phi_neg,
      Odd.neg_one_pow (hs m hm)]
    push_cast
    ring
  rw [hphi]
  ring
theorem isOddPoly_of_legSum {s : Finset ℕ} {x : ℕ → ℝ} {q : Polynomial ℝ}
    (hs : ∀ m ∈ s, Odd m)
    (hq : ∀ y : ℝ, Y7Op.legSum x s y = ((q.eval y : ℝ) : ℂ)) :
    Y7Density.IsOddPoly q := by
  unfold Y7Density.IsOddPoly
  refine Polynomial.funext (p := q.comp (-Polynomial.X)) (q := -q) ?_
  intro y
  rw [Polynomial.eval_comp, Polynomial.eval_neg, Polynomial.eval_X]
  have hnegC : ((q.eval (-y) : ℝ) : ℂ) = -(((q.eval y : ℝ)) : ℂ) := by
    rw [← hq (-y), ← hq y, legSum_neg_of_odd s x hs y]
  have hneg : q.eval (-y) = -(q.eval y) := by
    have := congrArg Complex.re hnegC
    simpa using this
  rw [hneg]
  exact (Polynomial.eval_neg q y).symm
theorem matrixBlocksPos_of_polynomialPositivity {a : ℝ}
