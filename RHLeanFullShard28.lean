open Matrix
open scoped BigOperators
namespace Y7W5MarginDirect
open Y7A3Data
open Y7A3GramFloor
open Y7W5MarginHi
noncomputable def modelM (a : ℝ) : Matrix (Fin 100) (Fin 100) ℝ :=
  fun i j => Y7KPP.modelM a (2 * (i : ℕ) + 1) (2 * (j : ℕ) + 1)
noncomputable def gammaModelM (a : ℝ) : Matrix (Fin 100) (Fin 100) ℝ :=
  fun i j => Y7KPP.gammaModelM a (2 * (i : ℕ) + 1) (2 * (j : ℕ) + 1)
noncomputable def APP (a : ℝ) : Matrix (Fin 100) (Fin 100) ℝ :=
  modelM a - (a - 1) • gammaModelM a
noncomputable def coordQHi (x : Fin 100 → ℝ) : Fin 7 → ℝ :=
  fun i => ∑ j : Fin 100, (Y7W5MarginHi.QHi j i : ℝ) * x j
def QFQ_le_APP_eps (a eps : ℝ) : Prop :=
  ∀ x : Fin 100 → ℝ,
    coordQHi x ⬝ᵥ (Y7A3GramFloor.F *ᵥ coordQHi x) + eps * (∑ i, x i ^ 2)
      ≤ ∑ i : Fin 100, ∑ j : Fin 100, x i * x j * APP a i j
def oldIndex (m : ℕ) (hm : m < 200) : Fin 100 :=
  ⟨(m - 1) / 2, by omega⟩
lemma oldIndex_two_mul_add_one (m : ℕ) (hm : m < 200) (hodd : Odd m) :
    2 * (oldIndex m hm : ℕ) + 1 = m := by
  obtain ⟨k, rfl⟩ := hodd
  unfold oldIndex
  simp
lemma oldIndex_injective_on_odd (m n : ℕ) (hm : m < 200) (hn : n < 200)
    (hm' : Odd m) (hn' : Odd n)
    (h : oldIndex m hm = oldIndex n hn) : m = n := by
  have hm2 := oldIndex_two_mul_add_one m hm hm'
  have hn2 := oldIndex_two_mul_add_one n hn hn'
  have hval : (oldIndex m hm : ℕ) = (oldIndex n hn : ℕ) := congrArg Fin.val h
  omega
def oldIndexOf (m : ℕ) : Fin 100 :=
  if h : m < 200 ∧ Odd m then oldIndex m h.1 else 0
lemma oldIndexOf_eq {m : ℕ} (hm : m < 200) (hodd : Odd m) :
    oldIndexOf m = oldIndex m hm := by
  unfold oldIndexOf
  rw [dif_pos ⟨hm, hodd⟩]
lemma oldIndexOf_two_mul_add_one (i : Fin 100) :
    oldIndexOf (2 * (i : ℕ) + 1) = i := by
  unfold oldIndexOf
  rw [dif_pos ⟨by omega, ⟨i, by ring⟩⟩]
  apply Fin.ext
  unfold oldIndex
  simp
lemma oldIndexOf_injective_on {m n : ℕ} (hm : m < 200) (hn : n < 200)
    (hm' : Odd m) (hn' : Odd n) (h : oldIndexOf m = oldIndexOf n) : m = n := by
  rw [oldIndexOf_eq hm hm', oldIndexOf_eq hn hn'] at h
  exact oldIndex_injective_on_odd m n hm hn hm' hn' h
noncomputable def oldCoeff (s : Finset ℕ) (x : ℕ → ℝ) : Fin 100 → ℝ :=
  fun i => if 2 * (i : ℕ) + 1 ∈ s then x (2 * (i : ℕ) + 1) else 0
lemma oldCoeff_eq_zero_of_not_mem {s : Finset ℕ} {x : ℕ → ℝ} {i : Fin 100}
    (h : 2 * (i : ℕ) + 1 ∉ s) : oldCoeff s x i = 0 := by
  unfold oldCoeff
  rw [if_neg h]
lemma oldCoeff_mem_iff {s : Finset ℕ} {x : ℕ → ℝ} {i : Fin 100} :
    oldCoeff s x i ≠ 0 ↔ 2 * (i : ℕ) + 1 ∈ s ∧ x (2 * (i : ℕ) + 1) ≠ 0 := by
  unfold oldCoeff
  split_ifs with h
  · simp [h]
  · simp [h]
lemma QextOldHi_eq_QHi {m : ℕ} (hm : m < 200) (hodd : Odd m) (i : Fin 7) :
    Y7W5MarginHi.QextOldHi m i = (Y7W5MarginHi.QHi (oldIndex m hm) i : ℝ) := by
  unfold Y7W5MarginHi.QextOldHi
  rw [if_pos hm]
  apply congrArg (fun z : Fin 100 => Y7W5MarginHi.QHi z i)
  apply Fin.ext
  simp
  apply Nat.mod_eq_of_lt
  omega
lemma coordOldHi_eq_coordQHi_oldCoeff (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) :
    Y7W5MarginHi.coordOldHi s x = coordQHi (oldCoeff s x) := by
  funext i
  unfold Y7W5MarginHi.coordOldHi coordQHi
  let t : Finset (Fin 100) := s.image oldIndexOf
  have hleft : (∑ m ∈ s, x m * Y7W5MarginHi.QextOldHi m i)
      = ∑ m ∈ s, x m * (Y7W5MarginHi.QHi (oldIndexOf m) i : ℝ) := by
    apply Finset.sum_congr rfl
    intro m hm
    rw [oldIndexOf_eq (hs_old m hm) (hs m hm),
      QextOldHi_eq_QHi (hs_old m hm) (hs m hm)]
  rw [hleft]
  have hzero : ∀ j ∈ Finset.univ, j ∉ t →
      (Y7W5MarginHi.QHi j i : ℝ) * oldCoeff s x j = 0 := by
    intro j _ hj
    have hcoeff : oldCoeff s x j = 0 := by
      apply oldCoeff_eq_zero_of_not_mem
      intro hmem
      apply hj
      have hodd : Odd (2 * (j : ℕ) + 1) := ⟨j, by ring⟩
      have hlt : 2 * (j : ℕ) + 1 < 200 := by omega
      rw [← oldIndexOf_two_mul_add_one j]
      exact Finset.mem_image.mpr ⟨2 * (j : ℕ) + 1, hmem, rfl⟩
    rw [hcoeff, mul_zero]
  rw [← Finset.sum_subset (Finset.subset_univ t) hzero]
  rw [Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro m hm
    have hcoeff : oldCoeff s x (oldIndexOf m) = x m := by
      unfold oldCoeff
      rw [oldIndexOf_eq (hs_old m hm) (hs m hm),
        oldIndex_two_mul_add_one m (hs_old m hm) (hs m hm), if_pos hm]
    rw [hcoeff]
    ring
  · intro m hm n hn hmn
    exact oldIndexOf_injective_on (hs_old m hm) (hs_old n hn) (hs m hm) (hs n hn) hmn
lemma sum_old_support_eq (s : Finset ℕ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) (f : ℕ → ℝ) :
    (∑ i : Fin 100, if 2 * (i : ℕ) + 1 ∈ s then f (2 * (i : ℕ) + 1) else 0)
      = ∑ m ∈ s, f m := by
  let t : Finset (Fin 100) := s.image oldIndexOf
  have hzero : ∀ j ∈ Finset.univ, j ∉ t →
      (if 2 * (j : ℕ) + 1 ∈ s then f (2 * (j : ℕ) + 1) else 0) = 0 := by
    intro j _ hj
    rw [if_neg]
    intro hmem
    apply hj
    have hodd : Odd (2 * (j : ℕ) + 1) := ⟨j, by ring⟩
    have hlt : 2 * (j : ℕ) + 1 < 200 := by omega
    rw [← oldIndexOf_two_mul_add_one j]
    exact Finset.mem_image.mpr ⟨2 * (j : ℕ) + 1, hmem, rfl⟩
  rw [← Finset.sum_subset (Finset.subset_univ t) hzero]
  rw [Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro m hm
    have hcond : 2 * (oldIndexOf m : ℕ) + 1 ∈ s := by
      rw [oldIndexOf_eq (hs_old m hm) (hs m hm),
        oldIndex_two_mul_add_one m (hs_old m hm) (hs m hm)]
      exact hm
    rw [if_pos hcond]
    rw [oldIndexOf_eq (hs_old m hm) (hs m hm),
      oldIndex_two_mul_add_one m (hs_old m hm) (hs m hm)]
  · intro m hm n hn hmn
    exact oldIndexOf_injective_on (hs_old m hm) (hs_old n hn)
      (hs m hm) (hs n hn) hmn
lemma mass_eq_oldCoeff (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) :
    (∫ y in Set.Ioo (-1 : ℝ) 1, ‖Y7Op.legSum x s y‖ ^ 2)
      = ∑ i : Fin 100, oldCoeff s x i ^ 2 := by
  rw [Y7Tail.mass_legSum]
  rw [← sum_old_support_eq s hs hs_old (fun m => x m ^ 2)]
  apply Finset.sum_congr rfl
  intro i _
  by_cases h : 2 * (i : ℕ) + 1 ∈ s
  · simp [oldCoeff, h]
  · simp [oldCoeff, h]
lemma modelSum_eq_modelM (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) :
    (∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7KPP.modelM a m n)
      = ∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * modelM a i j := by
  rw [← sum_old_support_eq s hs hs_old
    (fun m => ∑ n ∈ s, x m * x n * Y7KPP.modelM a m n)]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : 2 * (i : ℕ) + 1 ∈ s
  · rw [if_pos hi]
    rw [← sum_old_support_eq s hs hs_old
      (fun n => x (2 * (i : ℕ) + 1) * x n * Y7KPP.modelM a (2 * (i : ℕ) + 1) n)]
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : 2 * (j : ℕ) + 1 ∈ s
    · rw [if_pos hj]
      unfold modelM oldCoeff
      simp [hi, hj]
    · rw [if_neg hj]
      simp [oldCoeff, hi, hj]
  · rw [if_neg hi]
    simp [oldCoeff, hi]
namespace Y7EpsTight
open RHLean.EpsBound
theorem epsilonGamma_le_tight : Y7Chain.epsilonGamma (RHLean.endpoint 7) ≤ 1 / 10 ^ 27 := by
  unfold Y7Chain.epsilonGamma
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hr0 := ratio_pos
  have hr1 := ratio_le
  have hden := one_sub_ratio
  have hden_pos : 0 < 1 - 2 * RHLean.endpoint 7 / (14 / 5) := by linarith
  have h40 : (5 / 7 : ℝ) ^ 40 ≤ 1 / 100000 := by norm_num
  have h240 : ((5 / 7 : ℝ) ^ 40) ^ 6 ≤ ((1 / 100000 : ℝ)) ^ 6 :=
    pow_le_pow_left₀ (by norm_num) h40 6
  have hsplit : ((5 / 7 : ℝ) ^ 40) ^ 6 = (5 / 7 : ℝ) ^ 240 := by
    rw [← pow_mul]
  have hle240 : (5 / 7 : ℝ) ^ 241 ≤ (5 / 7 : ℝ) ^ 240 := by
    have hnn : (0 : ℝ) ≤ (5 / 7 : ℝ) ^ 240 := by positivity
    have h1 : (5 / 7 : ℝ) ≤ 1 := by norm_num
    calc (5 / 7 : ℝ) ^ 241 = (5 / 7 : ℝ) ^ 240 * (5 / 7) := by
          rw [show 241 = 240 + 1 by norm_num, pow_succ]
        _ ≤ (5 / 7 : ℝ) ^ 240 * 1 := by
          exact mul_le_mul_of_nonneg_left h1 hnn
        _ = (5 / 7 : ℝ) ^ 240 := mul_one _
  have hr_mono : (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ (5 / 7 : ℝ) ^ 241 :=
    pow_le_pow_left₀ hr0 hr1 241
  have h6 : ((1 / 100000 : ℝ)) ^ 6 = 1 / 10 ^ 30 := by norm_num
  have hrpow : (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ 1 / 10 ^ 30 := by
    linarith [hr_mono, hle240, h240, hsplit, h6]
  have hγ := gammaM_le
  have hγpos : 0 ≤ Y7Chain.gammaM (14 / 5) := by
    unfold Y7Chain.gammaM
    have hA : 0 < Real.exp (14 / 5 / 2) / (2 * Real.sin (14 / 5)) :=
      div_pos (Real.exp_pos _) (by linarith [sin_14_5_pos])
    have hB : 0 < (1 : ℝ) / (2 * (14 / 5)) := by positivity
    linarith
  have hrp : 0 ≤ (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 := pow_nonneg hr0 241
  have hstep1 : RHLean.endpoint 7 * Y7Chain.gammaM (14 / 5) ≤ 1 * 20 := by
    nlinarith [ha0, ha1, hγ, hγpos]
  have hstep2 : RHLean.endpoint 7 * Y7Chain.gammaM (14 / 5)
      * (2 * RHLean.endpoint 7 / (14 / 5)) ^ 241 ≤ (1 * 20) * (1 / 10 ^ 30) :=
    mul_le_mul hstep1 hrpow hrp (by norm_num)
  refine (div_le_iff₀ hden_pos).mpr ?_
  nlinarith [hstep2, hden, hden_pos]
theorem sinhRem_nonneg : 0 ≤ Y7Chain.sinhRemainder (RHLean.endpoint 7) := by
  unfold Y7Chain.sinhRemainder
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hsq : (RHLean.endpoint 7 / 2) ^ 2 ≤ 1 / 4 := by nlinarith [ha0, ha1]
  have hd : (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) ≤ 1 / 2 := by
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 202 * 203)]
    nlinarith
  have hpos : (0 : ℝ) < 1 - (RHLean.endpoint 7 / 2) ^ 2 / (202 * 203) := by linarith
  positivity
theorem epsilonPolar_le_tight : Y7Chain.epsilonPolar (RHLean.endpoint 7) ≤ 1 / 10 ^ 27 := by
  unfold Y7Chain.epsilonPolar
  have ha0 : 0 ≤ RHLean.endpoint 7 := le_of_lt a_pos
  have ha1 : RHLean.endpoint 7 ≤ 1 := a_le_one
  have hs := sinhRem_le
  have hs0 := sinhRem_nonneg
  have hs1 : Y7Chain.sinhRemainder (RHLean.endpoint 7) ≤ 1 := by
    linarith [hs]
  have hs2 : Y7Chain.sinhRemainder (RHLean.endpoint 7) ^ 2 ≤ 1 / 10 ^ 60 := by
    nlinarith [hs, hs0, hs1, sq_nonneg (Y7Chain.sinhRemainder (RHLean.endpoint 7) - 1)]
  have h1 := sqrt_le_two
  have h1pos : 0 ≤ Real.sqrt (Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 - 1) :=
    Real.sqrt_nonneg _
  have h2 : Real.sqrt 2 ≤ 2 := by
    have := Real.sqrt_two_lt_three_halves
    linarith
  have h2pos : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg _
  have hterm : 2 * Real.sqrt (Real.sinh (RHLean.endpoint 7) / RHLean.endpoint 7 - 1)
      * Real.sqrt 2 * Y7Chain.sinhRemainder (RHLean.endpoint 7) ≤ 8 / 10 ^ 60 := by
    nlinarith [h1, h2, hs, h1pos, h2pos, hs0,
      mul_nonneg h1pos h2pos, mul_nonneg (mul_nonneg h1pos h2pos) hs0]
  nlinarith [hterm, hs2, ha0, ha1]
theorem epsilonTotal_endpoint_seven_le_tight :
    Y7Chain.epsilonGamma (RHLean.endpoint 7) + Y7Chain.epsilonPolar (RHLean.endpoint 7)
      ≤ 1 / 10 ^ 26 := by
  have h1 := epsilonGamma_le_tight
  have h2 := epsilonPolar_le_tight
  linarith
end Y7EpsTight
lemma polarInnerApprox_legSum (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ) :
    Y7Approx.polarInnerApprox a (Y7Op.legSum x s)
      = ∑ n ∈ s, (x n : ℂ) * (Y7ModelOne.polarMomentModel a n : ℂ) := by
  unfold Y7Approx.polarInnerApprox
  simp only [Y7Op.legSum]
  simp_rw [Finset.mul_sum]
  rw [MeasureTheory.integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro n hn
    have hpt : (fun y : ℝ => star (Y7Approx.sTrunc a y) *
        ((x n : ℂ) * Y7Matrix.phiC n y))
        = fun y : ℝ => (x n : ℂ) *
            (star (Y7Approx.sTrunc a y) * Y7Matrix.phiC n y) := by
      funext y
      ring
    rw [hpt, MeasureTheory.integral_const_mul]
    rw [show (∫ y in Set.Ioo (-1 : ℝ) 1,
        star (Y7Approx.sTrunc a y) * Y7Matrix.phiC n y)
        = Y7Approx.polarInnerApprox a (Y7Matrix.phiC n) from rfl]
    rw [Y7ModelOne.polarInnerApprox_eq_polarMomentModel]
  · intro n hn
    have hsinh : Continuous (fun y : ℝ => Y7Chain.sinhTaylorFun a y 100) := by
      unfold Y7Chain.sinhTaylorFun
      fun_prop
    have hpoly : Continuous (fun y : ℝ => (Y7Legendre.phi n).eval y) :=
      Polynomial.continuous (Y7Legendre.phi n)
    have hcont : Continuous (fun y : ℝ => star (Y7Approx.sTrunc a y) *
        ((x n : ℂ) * Y7Matrix.phiC n y)) := by
      unfold Y7Approx.sTrunc Y7Matrix.phiC
      exact (Complex.continuous_conj.comp
        (Complex.continuous_ofReal.comp hsinh)).mul
        (continuous_const.mul (Complex.continuous_ofReal.comp hpoly))
    exact (integrableOn_Icc_iff_integrableOn_Ioo).mp hcont.integrableOn_Icc
lemma norm_polarInnerApprox_legSum (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ) :
    ‖Y7Approx.polarInnerApprox a (Y7Op.legSum x s)‖ ^ 2
      = (∑ n ∈ s, x n * Y7ModelOne.polarMomentModel a n) ^ 2 := by
  rw [polarInnerApprox_legSum]
  have hcast : (∑ n ∈ s, (x n : ℂ) * (Y7ModelOne.polarMomentModel a n : ℂ))
      = ((∑ n ∈ s, x n * Y7ModelOne.polarMomentModel a n : ℝ) : ℂ) := by
    push_cast
    rfl
  rw [hcast, Complex.sq_norm, Complex.normSq_ofReal]
  ring
lemma gammaSum_eq_gammaModelM (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) :
    (∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7KPP.gammaModelM a m n)
      = ∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * gammaModelM a i j := by
  rw [← sum_old_support_eq s hs hs_old
    (fun m => ∑ n ∈ s, x m * x n * Y7KPP.gammaModelM a m n)]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : 2 * (i : ℕ) + 1 ∈ s
  · rw [if_pos hi]
    rw [← sum_old_support_eq s hs hs_old
      (fun n => x (2 * (i : ℕ) + 1) * x n * Y7KPP.gammaModelM a (2 * (i : ℕ) + 1) n)]
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : 2 * (j : ℕ) + 1 ∈ s
    · rw [if_pos hj]
      unfold gammaModelM oldCoeff
      simp [hi, hj]
    · rw [if_neg hj]
      simp [oldCoeff, hi, hj]
  · rw [if_neg hi]
    simp [oldCoeff, hi]
theorem modelFormRescaled_eq_APP_sum (a : ℝ) (s : Finset ℕ) (x : ℕ → ℝ)
    (hs : ∀ m ∈ s, Odd m) (hs_old : ∀ m ∈ s, m < 200) :
    Y7W5Kernel.modelFormRescaled a (Y7Op.legSum x s)
      = ∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * APP a i j := by
  have hM := Y7KPP.modelFormRep a s x
  have hG := Y7W5GammaModel.gammaModelForm_legSum a s x
  have hPnorm := norm_polarInnerApprox_legSum a s x
  have hAPPij : ∀ i j : Fin 100,
      APP a i j = modelM a i j - (a - 1) * gammaModelM a i j := by
    intro i j
    unfold APP
    simp [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
  have hAPP : (∑ i : Fin 100, ∑ j : Fin 100,
        oldCoeff s x i * oldCoeff s x j * APP a i j)
      = (∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * modelM a i j)
        - (a - 1) * (∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * gammaModelM a i j) := by
    calc
      (∑ i : Fin 100, ∑ j : Fin 100,
          oldCoeff s x i * oldCoeff s x j * APP a i j)
          = ∑ i : Fin 100, ((∑ j : Fin 100,
                oldCoeff s x i * oldCoeff s x j * modelM a i j)
              - (a - 1) * (∑ j : Fin 100,
                oldCoeff s x i * oldCoeff s x j * gammaModelM a i j)) := by
            apply Finset.sum_congr rfl
            intro i _
            rw [show (∑ j : Fin 100,
                oldCoeff s x i * oldCoeff s x j * APP a i j)
                = ∑ j : Fin 100,
                    (oldCoeff s x i * oldCoeff s x j * modelM a i j
                      - (a - 1) * (oldCoeff s x i * oldCoeff s x j
                          * gammaModelM a i j)) by
                  apply Finset.sum_congr rfl
                  intro j _
                  rw [hAPPij]
                  ring]
            rw [Finset.sum_sub_distrib, Finset.mul_sum]
      _ = (∑ i : Fin 100, ∑ j : Fin 100,
            oldCoeff s x i * oldCoeff s x j * modelM a i j)
          - (a - 1) * (∑ i : Fin 100, ∑ j : Fin 100,
            oldCoeff s x i * oldCoeff s x j * gammaModelM a i j) := by
            rw [Finset.sum_sub_distrib, Finset.mul_sum]
  rw [hAPP, ← modelSum_eq_modelM a s x hs hs_old,
    ← gammaSum_eq_gammaModelM a s x hs hs_old]
  unfold Y7W5Kernel.modelFormRescaled
  rw [hG, hPnorm, hM]
  ring
theorem marginAtCenterHi_old_of_qfq {a eps : ℝ}
    (hQFQ : QFQ_le_APP_eps a eps)
    (hε : Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a ≤ eps)
    (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
    (hs_old : ∀ m ∈ s, m < 200) :
    Y7W5MarginHi.MarginAtCenterHi a s x := by
  unfold Y7W5MarginHi.MarginAtCenterHi
  have hcoord := coordOldHi_eq_coordQHi_oldCoeff s x hs hs_old
  have hmass := mass_eq_oldCoeff s x hs hs_old
  rw [hcoord, hmass, modelFormRescaled_eq_APP_sum a s x hs hs_old]
  have h := hQFQ (oldCoeff s x)
  have hε' : (Y7Chain.epsilonGamma a + Y7Chain.epsilonPolar a)
        * (∑ i : Fin 100, oldCoeff s x i ^ 2)
      ≤ eps * (∑ i : Fin 100, oldCoeff s x i ^ 2) :=
    mul_le_mul_of_nonneg_right hε
      (Finset.sum_nonneg (fun i _ => sq_nonneg (oldCoeff s x i)))
  linarith
theorem marginAtCenterHi_old_endpoint_seven_of_qfq
    (hQFQ : QFQ_le_APP_eps (RHLean.endpoint 7) (1 / 10 ^ 26))
    (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
    (hs_old : ∀ m ∈ s, m < 200) :
    Y7W5MarginHi.MarginAtCenterHi (RHLean.endpoint 7) s x :=
  marginAtCenterHi_old_of_qfq hQFQ
    Y7EpsTight.epsilonTotal_endpoint_seven_le_tight s x hs hs_old
def QFQHyp : Prop :=
  QFQ_le_APP_eps (RHLean.endpoint 7) (1 / 10 ^ 26)
theorem marginAtCenterHi_old_endpoint_seven
    (hQFQ : QFQHyp)
    (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
    (hs_old : ∀ m ∈ s, m < 200) :
    Y7W5MarginHi.MarginAtCenterHi (RHLean.endpoint 7) s x :=
  marginAtCenterHi_old_endpoint_seven_of_qfq hQFQ s x hs hs_old
