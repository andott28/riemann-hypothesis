theorem localizedForm_add_real_imag_of_core (a b : ℝ) (f u v : ℝ → ℂ)
    (hu_def : ∀ x : ℝ, u x = ((f x).re : ℂ))
    (hv_def : ∀ x : ℝ, v x = ((f x).im : ℂ) * Complex.I)
    (hf : f ∈ RHLean.localizedCore b) (ha : 0 < a) :
    RHLean.localizedForm a (u + v)
      = RHLean.localizedForm a u + RHLean.localizedForm a v := by
  obtain ⟨B1, hB10, hB1⟩ := core_re_bounded (a := a) hf
  obtain ⟨B2, hB20, hB2⟩ := core_im_bounded (a := a) hf
  obtain ⟨L1, hL10, hL1⟩ := core_re_lipschitz (a := a) hf
  obtain ⟨L2, hL20, hL2⟩ := core_im_lipschitz (a := a) hf
  have hcf : Continuous f := hf.1.1.continuous
  have hcu : Continuous u := by
    rw [show u = fun x : ℝ => ((f x).re : ℂ) from funext hu_def]
    fun_prop
  have hcv : Continuous v := by
    rw [show v = fun x : ℝ => ((f x).im : ℂ) * Complex.I from funext hv_def]
    fun_prop
  have hru : ∀ x : ℝ, (u x).im = 0 := fun x => by
    rw [hu_def]; simp [Complex.ofReal_im]
  have hvr : ∀ x : ℝ, (v x).re = 0 := fun x => by
    rw [hv_def]
    simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im]
  have hBu : ∀ y : ℝ, ‖u y‖ ≤ 2 * (B1 + B2) := fun y => by
    simp only [hu_def]
    exact le_trans (hB1 y) (by linarith [hB10, hB20])
  have hBv : ∀ y : ℝ, ‖v y‖ ≤ 2 * (B1 + B2) := fun y => by
    rw [hv_def, norm_mul, Complex.norm_I, mul_one]
    exact le_trans (hB2 y) (by linarith [hB10, hB20])
  have hBuv : ∀ y : ℝ, ‖(u + v) y‖ ≤ 2 * (B1 + B2) := fun y => by
    simp only [Pi.add_apply, hu_def, hv_def]
    refine le_trans (norm_add_le _ _) ?_
    rw [norm_mul, Complex.norm_I, mul_one]
    nlinarith [hB1 y, hB2 y]
  have hLu1 : ∀ x y : ℝ, ‖u x - u y‖ ≤ L1 * |x - y| := fun x y => by
    simp only [hu_def]
    exact hL1 x y
  have hLv1 : ∀ x y : ℝ, ‖v x - v y‖ ≤ L2 * |x - y| := fun x y => by
    simp only [hv_def]
    rw [← sub_mul, ← Complex.ofReal_sub, norm_mul, Complex.norm_I, mul_one]
    have hn : ‖((((f x).im - (f y).im : ℝ)) : ℂ)‖ = |(f x).im - (f y).im| := RCLike.norm_ofReal _
    rw [hn]
    have h := hL2 x y
    rw [← Complex.ofReal_sub] at h
    rw [hn] at h
    exact h
  have hLu : ∀ x y : ℝ, ‖u x - u y‖ ≤ |2 * (L1 + L2)| * |x - y| := fun x y => by
    rw [abs_of_nonneg (by positivity)]
    exact le_trans (hLu1 x y) (by nlinarith [hL10, hL20, abs_nonneg (x - y)])
  have hLv : ∀ x y : ℝ, ‖v x - v y‖ ≤ |2 * (L1 + L2)| * |x - y| := fun x y => by
    rw [abs_of_nonneg (by positivity)]
    exact le_trans (hLv1 x y) (by nlinarith [hL10, hL20, abs_nonneg (x - y)])
  have hLuv : ∀ x y : ℝ, ‖(u + v) x - (u + v) y‖ ≤ |2 * (L1 + L2)| * |x - y| := fun x y => by
    simp only [Pi.add_apply, Pi.sub_apply]
    rw [show (u x + v x) - (u y + v y) = (u x - u y) + (v x - v y) from by ring,
      abs_of_nonneg (by positivity)]
    refine le_trans (norm_add_le _ _) ?_
    nlinarith [hLu1 x y, hLv1 x y, abs_nonneg (x - y)]
  refine localizedForm_add_real_imag a u v hru hvr ?_ ?_ ?_ ?_ ?_ ?_
  · exact admissible_of_bdd_lipschitz a u (u + v) (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcu (hcu.add hcv) hBu hBuv hLu hLuv
  · exact admissible_of_bdd_lipschitz a v (u + v) (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcv (hcu.add hcv) hBv hBuv hLv hLuv
  · exact admissible_of_bdd_lipschitz a u u (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcu hcu hBu hBu hLu hLu
  · exact admissible_of_bdd_lipschitz a v u (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcv hcu hBv hBu hLv hLu
  · exact admissible_of_bdd_lipschitz a u v (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcu hcv hBu hBv hLu hLv
  · exact admissible_of_bdd_lipschitz a v v (2 * (B1 + B2)) (2 * (L1 + L2))
      (2 * (L1 + L2)) ha hcv hcv hBv hBv hLv hLv
end Y7GateIIAdd
