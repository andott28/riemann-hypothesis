section Inline_Y7_Step
open Matrix Matrix
namespace Y7Step
variable {M : ℕ → ℕ → ℝ}
def Quad (M : ℕ → ℕ → ℝ) (s : Finset ℕ) (p : ℕ → ℝ) : ℝ :=
  ∑ i ∈ s, ∑ j ∈ s, p i * M i j * p j
noncomputable def Cross (M : ℕ → ℕ → ℝ) (s : Finset ℕ) (k : ℕ) (p : ℕ → ℝ) : ℝ :=
  ((∑ i ∈ s, p i * M i k) + (∑ i ∈ s, M k i * p i)) / 2
theorem mul_sum_const (c : ℝ) (t : Finset ℕ) (f : ℕ → ℝ) :
    c * (∑ i ∈ t, f i) = ∑ i ∈ t, c * f i := by
  induction t using Finset.induction_on with
  | empty => simp
  | insert a t ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, mul_add, ih]
theorem sum_mul_const (c : ℝ) (t : Finset ℕ) (f : ℕ → ℝ) :
    (∑ i ∈ t, f i) * c = ∑ i ∈ t, f i * c := by
  induction t using Finset.induction_on with
  | empty => simp
  | insert a t ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, add_mul, ih]
theorem quad_insert {k : ℕ} (hk : k ∉ s) (p : ℕ → ℝ) :
    Quad M (insert k s) p = Quad M s p + 2 * p k * Cross M s k p + p k ^ 2 * M k k := by
  have hS1 : (∑ j ∈ s, p k * M k j * p j) = p k * (∑ j ∈ s, M k j * p j) := by
    rw [mul_sum_const]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  have hS2 : (∑ x ∈ s, p x * M x k * p k) = p k * (∑ x ∈ s, p x * M x k) := by
    rw [mul_sum_const]
    exact Finset.sum_congr rfl (fun x _ => by ring)
  have hcross : (∑ j ∈ s, p k * M k j * p j) + (∑ x ∈ s, p x * M x k * p k)
      = 2 * p k * Cross M s k p := by
    rw [hS1, hS2]
    unfold Cross
    ring
  have hmkk : p k * M k k * p k = p k ^ 2 * M k k := by ring
  simp only [Quad, Finset.sum_insert hk, Finset.sum_add_distrib, mul_sum_const,
    sum_mul_const, mul_add]
  linarith [hcross, hmkk]
theorem step_iff {k : ℕ} (hk : k ∉ s) (hc : 0 < M k k) :
    (∀ p : ℕ → ℝ, 0 ≤ Quad M (insert k s) p)
      ↔ (∀ x : ℕ → ℝ, (Cross M s k x) ^ 2 ≤ M k k * Quad M s x) := by
  have hkne : M k k ≠ 0 := ne_of_gt hc
  constructor
  · intro h x
    set t : ℝ := -(Cross M s k x) / M k k with ht
    have hne : ∀ i ∈ s, (if i = k then t else x i) = x i := by
      intro i hi
      have hik : i ≠ k := fun hik => hk (hik ▸ hi)
      simp [hik]
    have hquad : Quad M s (fun i => if i = k then t else x i) = Quad M s x := by
      simp only [Quad]
      exact Finset.sum_congr rfl (fun i hi => Finset.sum_congr rfl (fun j hj => by
        rw [hne i hi, hne j hj]))
    have hs1 : (∑ i ∈ s, (if i = k then t else x i) * M i k) = ∑ i ∈ s, x i * M i k :=
      Finset.sum_congr rfl (fun i hi => by rw [hne i hi])
    have hs2 : (∑ i ∈ s, M k i * (if i = k then t else x i)) = ∑ i ∈ s, M k i * x i :=
      Finset.sum_congr rfl (fun i hi => by rw [hne i hi])
    have hcross : Cross M s k (fun i => if i = k then t else x i) = Cross M s k x := by
      simp only [Cross]
      rw [hs1, hs2]
    have hkk : (if k = k then t else x k) = t := if_pos rfl
    have hmain := h (fun i => if i = k then t else x i)
    rw [quad_insert hk, hquad, hcross, hkk] at hmain
    have hkey : M k k * (Quad M s x + 2 * t * Cross M s k x + t ^ 2 * M k k)
        = M k k * Quad M s x - Cross M s k x ^ 2 := by
      rw [ht]
      field_simp
      ring
    nlinarith [hmain, hkey, hc]
  · intro hSc p
    rw [quad_insert hk]
    have hb : Cross M s k p ^ 2 ≤ M k k * Quad M s p := hSc p
    have h1 : Quad M s p + 2 * p k * Cross M s k p + p k ^ 2 * M k k
        = ((M k k * p k + Cross M s k p) ^ 2
            + (M k k * Quad M s p - Cross M s k p ^ 2)) / M k k := by
      field_simp
      ring
    rw [h1]
    apply div_nonneg _ (le_of_lt hc)
    nlinarith [sq_nonneg (M k k * p k + Cross M s k p)]
theorem Quad_eq (M : ℕ → ℕ → ℝ) (t : Finset ℕ) (p : ℕ → ℝ) :
    Quad M t p = ∑ i ∈ t, ∑ j ∈ t, p i * p j * M i j := by
  simp only [Quad]
  exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
theorem quad_collapse {s t : Finset ℕ} (hsub : s ⊆ t) (x : ℕ → ℝ) :
    Quad M t (fun m => if m ∈ s then x m else 0) = Quad M s x := by
  set w : ℕ → ℝ := fun m => if m ∈ s then x m else 0 with hw
  have hw0 : ∀ m ∉ s, w m = 0 := by
    intro m hm
    simp [hw, hm]
  have hw1 : ∀ m ∈ s, w m = x m := by
    intro m hm
    simp [hw, hm]
  have hin : ∀ m, (∑ n ∈ t, w m * M m n * w n) = ∑ n ∈ s, w m * M m n * x n := by
    intro m
    have hz : ∀ n ∈ t, n ∉ s → w m * M m n * w n = 0 := by
      intro n _ hn
      rw [hw0 n hn]
      ring
    rw [← Finset.sum_subset hsub hz]
    exact Finset.sum_congr rfl (fun n hn => by rw [hw1 n hn])
  show Quad M t w = Quad M s x
  simp only [Quad]
  rw [Finset.sum_congr rfl (fun m (_ : m ∈ t) => hin m)]
  have hz2 : ∀ m ∈ t, m ∉ s → (∑ n ∈ s, w m * M m n * x n) = 0 := by
    intro m _ hm
    exact Finset.sum_eq_zero (fun n _ => by rw [hw0 m hm]; ring)
  rw [← Finset.sum_subset hsub hz2]
  exact Finset.sum_congr rfl (fun m hm => by rw [hw1 m hm])
theorem oddInit_succ_of_odd {k : ℕ} (hk : Odd k) :
    Y7BaseChain.oddInit (k + 1) = insert k (Y7BaseChain.oddInit k) := by
  ext m
  simp only [Y7BaseChain.oddInit, Finset.mem_filter, Finset.mem_range, Finset.mem_insert]
  constructor
  · rintro ⟨hlt, hodd⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with h | h
    · exact Or.inr ⟨h, hodd⟩
    · exact Or.inl h
  · rintro (h | ⟨hlt, hodd⟩)
    · rw [h]; exact ⟨Nat.lt_succ_self k, hk⟩
    · exact ⟨Nat.lt_succ_of_lt hlt, hodd⟩
theorem oddInit_succ_of_not_odd {k : ℕ} (hk : ¬ Odd k) :
    Y7BaseChain.oddInit (k + 1) = Y7BaseChain.oddInit k := by
  ext m
  simp only [Y7BaseChain.oddInit, Finset.mem_filter, Finset.mem_range]
  constructor
  · rintro ⟨hlt, hodd⟩
    refine ⟨?_, hodd⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with h | h
    · exact h
    · exact absurd (h ▸ hodd) hk
  · rintro ⟨hlt, hodd⟩
    exact ⟨Nat.lt_succ_of_lt hlt, hodd⟩
theorem not_mem_oddInit (k : ℕ) : k ∉ Y7BaseChain.oddInit k := by
  simp [Y7BaseChain.oddInit]
theorem quad_nonneg_of_posSemidef (M : ℕ → ℕ → ℝ) (t : Finset ℕ)
    (hP : (Matrix.of (fun i j : t => M (i : ℕ) (j : ℕ))).PosSemidef) :
    ∀ p : ℕ → ℝ, 0 ≤ Quad M t p := by
  intro p
  have h := Y7A3.posSemidef_finset_quadform_nonneg
    (Matrix.of (fun i j : ↥t => M (i : ℕ) (j : ℕ))) hP
    (Finset.univ : Finset ↥t) (fun i : ↥t => p (i : ℕ))
  have hstep : (∑ i : ↥t, ∑ j : ↥t, p (i : ℕ) * p (j : ℕ) * M (i : ℕ) (j : ℕ))
      = ∑ i ∈ t, ∑ j ∈ t, p i * p j * M i j := by
    rw [Finset.sum_coe_sort t (fun i => ∑ j : ↥t, p i * p (j : ℕ) * M i (j : ℕ))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    exact Finset.sum_coe_sort t (fun j => p i * p j * M i j)
  have h' : 0 ≤ ∑ i : ↥t, ∑ j : ↥t, p (i : ℕ) * p (j : ℕ) * M (i : ℕ) (j : ℕ) := by
    simpa using h
  rw [Quad_eq, ← hstep]
  exact h'
theorem matrixBlocksPos_of_nested_quad {a : ℝ}
    (h : ∀ N : ℕ, ∀ p : ℕ → ℝ,
      0 ≤ Quad (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit N) p) :
    Y7Density.MatrixBlocksPos a := by
  intro s x hs
  set N : ℕ := s.sup id + 1 with hN
  have hsub : s ⊆ Y7BaseChain.oddInit N := by
    intro m hm
    refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ?_, hs m hm⟩
    have hle : m ≤ s.sup id := Finset.le_sup (f := id) hm
    omega
  have hq := h N (fun m => if m ∈ s then x m else 0)
  rw [quad_collapse hsub x, Quad_eq] at hq
  simpa using hq
theorem baseBlocks_of_scalar_chain {a : ℝ} (N₀ : ℕ)
    (hbase : ∀ p : ℕ → ℝ,
      0 ≤ Quad (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit N₀) p)
    (hpos : ∀ k, Odd k → 0 < Y7Op.rescaledOperatorM a k k)
    (hschur : ∀ k, N₀ ≤ k → Odd k → ∀ x : ℕ → ℝ,
      (Cross (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit k) k x) ^ 2
        ≤ Y7Op.rescaledOperatorM a k k
          * Quad (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit k) x) :
    Y7Density.MatrixBlocksPos a := by
  refine matrixBlocksPos_of_nested_quad (a := a) (fun N => ?_)
  by_cases hN : N₀ ≤ N
  · have hchain : ∀ n, N₀ ≤ n → ∀ p : ℕ → ℝ,
        0 ≤ Quad (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit n) p := by
      intro n hn
      induction n, hn using Nat.le_induction with
      | base => exact hbase
      | succ k hk ih =>
        by_cases hodd : Odd k
        · rw [oddInit_succ_of_odd hodd]
          exact (step_iff (not_mem_oddInit k) (hpos k hodd)).2 (hschur k hk hodd)
        · rw [oddInit_succ_of_not_odd hodd]
          exact ih
    exact hchain N hN
  · have hN' : N ≤ N₀ := by omega
    have hsub : Y7BaseChain.oddInit N ⊆ Y7BaseChain.oddInit N₀ := by
      intro m hm
      simp only [Y7BaseChain.oddInit, Finset.mem_filter, Finset.mem_range] at hm ⊢
      exact ⟨by omega, hm.2⟩
    intro p
    have := hbase (fun m => if m ∈ Y7BaseChain.oddInit N then p m else 0)
    rwa [quad_collapse hsub p] at this
theorem baseBlocks_of_posSemidef_chain {a : ℝ} (N₀ : ℕ)
    (hbase : (Matrix.of (fun i j : Y7BaseChain.oddInit N₀ =>
      Y7Op.rescaledOperatorM a (i : ℕ) (j : ℕ))).PosSemidef)
    (hpos : ∀ k, Odd k → 0 < Y7Op.rescaledOperatorM a k k)
    (hschur : ∀ k, N₀ ≤ k → Odd k → ∀ x : ℕ → ℝ,
      (Cross (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit k) k x) ^ 2
        ≤ Y7Op.rescaledOperatorM a k k
          * Quad (fun i j => Y7Op.rescaledOperatorM a i j) (Y7BaseChain.oddInit k) x) :
