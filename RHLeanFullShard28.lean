  baseBlocks_of_scalar_chain (a := a) N₀
    (quad_nonneg_of_posSemidef (fun i j => Y7Op.rescaledOperatorM a i j)
      (Y7BaseChain.oddInit N₀) hbase) hpos hschur
theorem tail_block_nonneg (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m)
