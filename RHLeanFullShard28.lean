      (RHLean.GateII.Reduction.archBilinKernel f₂ g)
      (Set.Ioo (-a) a ×ˢ Set.Ioo (-a) a)
      (MeasureTheory.volume.prod MeasureTheory.volume)) :
    RHLean.GateII.Reduction.archBilin a (f₁ + f₂) g
      = RHLean.GateII.Reduction.archBilin a f₁ g
        + RHLean.GateII.Reduction.archBilin a f₂ g := by
