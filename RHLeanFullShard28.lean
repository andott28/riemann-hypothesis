theorem gramMatrix_truncBasisSmooth_eq_oldNewBlock' (a b : ℝ) (N : ℕ) :
    gramMatrix b (truncBasisSmooth a b N)
      = oldNewBlock (truncOldBlockSmooth a b N) (truncCrossBlockSmooth a b N)
          (truncCollarBlockSmooth a b N) :=
  gramMatrix_truncBasisSmooth_eq_oldNewBlock a b N
theorem truncBasisSmooth_posDef_of_schur (a b : ℝ) (N : ℕ)
    [Invertible (truncCollarBlockSmooth a b N)]
    (hA : (truncOldBlockSmooth a b N).PosDef)
    (hD : (truncCollarBlockSmooth a b N).PosDef)
    (hT : (truncHarmonicFormSmooth a b N).PosDef) :
    (gramMatrix b (truncBasisSmooth a b N)).PosDef := by
  rw [gramMatrix_truncBasisSmooth_eq_oldNewBlock']
  exact oldNew_schur _ _ _ hA hD hT
theorem truncBasisSmooth_posDef_of_components (a b : ℝ) (N : ℕ)
    [Invertible (truncCollarBlockSmooth a b N)]
    (hA : (truncOldBlockSmooth a b N).PosDef)
    (hD : (truncCollarBlockSmooth a b N).PosDef)
    (hT : (truncHarmonicFormSmooth a b N).PosSemidef)
    (e : EuclideanSpace ℝ (Fin N)) (he : e ≠ 0) (g : ℝ) (hg : 0 < g)
    (hground : g * ‖e‖ ^ 2
      ≤ ⟪e, (truncHarmonicFormSmooth a b N).toEuclideanLin e⟫_ℝ)
    (hplace : ∀ f : EuclideanSpace ℝ (Fin N),
      0 ≤ groundCoord e f
        * ⟪e, (truncHarmonicFormSmooth a b N).toEuclideanLin
            (transversePart e f)⟫_ℝ)
    (hres : ∀ w : EuclideanSpace ℝ (Fin N), ⟪e, w⟫_ℝ = 0 → w ≠ 0 →
      0 < ⟪w, (truncHarmonicFormSmooth a b N).toEuclideanLin w⟫_ℝ) :
    (gramMatrix b (truncBasisSmooth a b N)).PosDef := by
  haveI : Invertible (collarCollarBlock b (truncCollarBasisSmooth a b N)) :=
    inferInstanceAs (Invertible (truncCollarBlockSmooth a b N))
  refine truncBasisSmooth_posDef_of_schur a b N hA hD ?_
  exact harmonicForm_posDef_of_components (truncOldBlockSmooth a b N)
    (truncCrossBlockSmooth a b N) (truncCollarBlockSmooth a b N)
    hT e he g hg hground hplace hres
theorem truncGramPosSemidef_of_components_smooth (a b : ℝ) (N : ℕ)
    [Invertible (truncCollarBlockSmooth a b N)]
    (hA : (truncOldBlockSmooth a b N).PosDef)
    (hD : (truncCollarBlockSmooth a b N).PosDef)
    (hT : (truncHarmonicFormSmooth a b N).PosSemidef)
    (e : EuclideanSpace ℝ (Fin N)) (he : e ≠ 0) (g : ℝ) (hg : 0 < g)
    (hground : g * ‖e‖ ^ 2
      ≤ ⟪e, (truncHarmonicFormSmooth a b N).toEuclideanLin e⟫_ℝ)
    (hplace : ∀ f : EuclideanSpace ℝ (Fin N),
      0 ≤ groundCoord e f
        * ⟪e, (truncHarmonicFormSmooth a b N).toEuclideanLin
            (transversePart e f)⟫_ℝ)
    (hres : ∀ w : EuclideanSpace ℝ (Fin N), ⟪e, w⟫_ℝ = 0 → w ≠ 0 →
      0 < ⟪w, (truncHarmonicFormSmooth a b N).toEuclideanLin w⟫_ℝ) :
    (gramMatrix b (truncBasisSmooth a b N)).PosSemidef :=
  (truncBasisSmooth_posDef_of_components a b N hA hD hT e he g hg
    hground hplace hres).posSemidef
def TruncGramSemidefSmooth : Prop :=
  ∀ k : ℕ, 7 ≤ k → ∀ N : ℕ,
    (gramMatrix (RHLean.endpoint (k + 1))
      (truncBasisSmooth (RHLean.endpoint k) (RHLean.endpoint (k + 1)) N)).PosSemidef
def GramSemidefToLocalPSDSmooth : Prop :=
  ∀ k : ℕ, 7 ≤ k →
    (∀ N : ℕ,
      (gramMatrix (RHLean.endpoint (k + 1))
        (truncBasisSmooth (RHLean.endpoint k) (RHLean.endpoint (k + 1)) N)).PosSemidef) →
    RHLean.LocalPSD (RHLean.endpoint (k + 1))
theorem gateIIOperatorStep_of_smooth (hG : TruncGramSemidefSmooth)
    (hL : GramSemidefToLocalPSDSmooth) :
