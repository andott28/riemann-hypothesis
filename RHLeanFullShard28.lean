theorem primeSum_autocorr {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    (∑' n : ℕ, ((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ)
        * (autocorr f (Real.log n) + autocorr f (-Real.log n)))
      = (primeSideComb f a : ℂ) / Real.pi := by
  have hodd : f ∈ oddCore := localizedCore_subset_oddCore a hf
  have heven : ∀ u : ℝ, autocorr f (-u) = autocorr f u := autocorr_even_of_mem_oddCore hodd
  have hzero : ∀ n ∉ arithSupport a,
      ((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ)
        * (autocorr f (Real.log n) + autocorr f (-Real.log n)) = 0 := by
    intro n hn
    by_cases hn2 : 2 ≤ n
    · have hge : Nat.ceil (Real.exp (2 * a)) ≤ n := by
        by_contra hlt
        have hlt' : n < Nat.ceil (Real.exp (2 * a)) := lt_of_not_ge hlt
        exact hn (Finset.mem_Icc.mpr ⟨hn2, Nat.le_sub_one_of_lt hlt'⟩)
      have hexp : Real.exp (2 * a) ≤ (n : ℝ) := Nat.ceil_le.mp hge
      have hlog : 2 * a ≤ Real.log n := by
        have h1 : Real.log (Real.exp (2 * a)) ≤ Real.log n :=
          Real.log_le_log (Real.exp_pos _) hexp
        rwa [Real.log_exp] at h1
      have hvan : autocorr f (Real.log n) = 0 := autocorr_eq_zero_of_two_a_le hf.2 hlog
      rw [hvan, heven (Real.log n), hvan, add_zero, mul_zero]
    · have hn01 : n = 0 ∨ n = 1 := by omega
      rcases hn01 with rfl | rfl <;> simp
  rw [tsum_eq_sum hzero]
  have hterm : ∀ n ∈ arithSupport a,
      ((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ)
        * (autocorr f (Real.log n) + autocorr f (-Real.log n))
      = 2 * (((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ)
          * autocorr f (Real.log n)) := by
    intro n hn
    rw [heven (Real.log n)]
    ring
  rw [Finset.sum_congr rfl hterm]
  rw [← Finset.mul_sum]
  have hreal : (∑ n ∈ arithSupport a,
      ((ArithmeticFunction.vonMangoldt n / Real.sqrt n : ℝ) : ℂ) * autocorr f (Real.log n))
      = ((∑ n ∈ arithSupport a,
          arithCoeff n * (autocorr f (Real.log n)).re : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum]
    refine Finset.sum_congr rfl fun n hn => ?_
    rw [autocorr_eq_re hodd.2.2 (Real.log n)]
    unfold arithCoeff
    push_cast
    simp
  rw [hreal]
  have hcomb : (primeSideComb f a : ℂ)
      = ((2 * Real.pi) : ℂ) * ((∑ n ∈ arithSupport a,
          arithCoeff n * (autocorr f (Real.log n)).re : ℝ) : ℂ) := by
    rw [show ((2 * Real.pi) : ℂ) = (2 : ℂ) * (Real.pi : ℂ) by rfl]
    unfold primeSideComb
    rw [Complex.ofReal_sum]
    rw [Complex.ofReal_sum]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun n hn => ?_
    have hg := ghatAt_eq hodd n
    rw [hg, RHLean.shiftLength]
    push_cast
    ring
  rw [hcomb]
  field_simp [Real.pi_ne_zero]
