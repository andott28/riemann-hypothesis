private theorem integrableOn_norm_of_sq {s : Set ℝ} {h : ℝ → ℂ}
    (hhm : Measurable h)
    (hint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2) s
      MeasureTheory.volume)
    (hfin : MeasureTheory.volume s < ⊤) :
    MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖) s MeasureTheory.volume := by
  have hconst : MeasureTheory.IntegrableOn (fun _ : ℝ => (1 : ℝ)) s
      MeasureTheory.volume := by
    refine MeasureTheory.IntegrableOn.of_bound hfin ?_ 1 ?_
    · exact measurable_const.aestronglyMeasurable
    · filter_upwards with x
      simp
  have hdom : MeasureTheory.IntegrableOn
      (fun x : ℝ => (1 / 2) * (‖h x‖ ^ 2 + 1)) s MeasureTheory.volume :=
    (hint.add hconst).const_mul (1 / 2)
  have hmeasN : MeasureTheory.AEStronglyMeasurable (fun x : ℝ => ‖h x‖)
      (MeasureTheory.volume.restrict s) :=
    (hhm.norm.aestronglyMeasurable).mono_measure
      MeasureTheory.Measure.restrict_le_self
  refine MeasureTheory.Integrable.mono
      (μ := MeasureTheory.volume.restrict s)
      (g := fun x : ℝ => (1 / 2) * (‖h x‖ ^ 2 + 1)) hdom hmeasN ?_
  filter_upwards with x
  have hsq := sq_nonneg (‖h x‖ - 1)
  have h2 : (‖h x‖ - 1) ^ 2 = ‖h x‖ ^ 2 - 2 * ‖h x‖ + 1 := by ring
  rw [h2] at hsq
  rw [Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg (h x)),
    abs_of_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (add_nonneg (by have := sq_nonneg (‖h x‖); linarith) zero_le_one))]
  nlinarith [hsq]
private theorem l1_le_sqrt_measure_l2_meas (c d : ℝ) (h : ℝ → ℂ) (hcd : c < d)
    (hhm : Measurable h)
    (hint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc c d) MeasureTheory.volume) :
    ∫ x in Set.Ioc c d, ‖h x‖
      ≤ Real.sqrt (d - c) * Real.sqrt (∫ x in Set.Ioc c d, ‖h x‖ ^ 2) := by
  have hm1 : MeasureTheory.MemLp (fun _ : ℝ => (1 : ℂ)) 2
      (MeasureTheory.volume.restrict (Set.Ioc c d)) :=
    Y7GateIIAdd.memLp_two_of_continuous_gen continuous_const _
      Set.Ioc_subset_Icc_self
  have hmh : MeasureTheory.MemLp h 2
      (MeasureTheory.volume.restrict (Set.Ioc c d)) :=
    (MeasureTheory.memLp_two_iff_integrable_sq_norm
      (hhm.aestronglyMeasurable)).mpr hint
  have hcs : ∫ x in Set.Ioc c d, ‖h x‖ * ‖(fun _ : ℝ => (1 : ℂ)) x‖
      ≤ Real.sqrt (∫ x in Set.Ioc c d, ‖h x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioc c d, ‖(fun _ : ℝ => (1 : ℂ)) x‖ ^ 2) :=
    Y7GateIIAdd.l2_integral_mul_le_gen _ hmh hm1
  simp only [norm_one, mul_one] at hcs
  have hvol : (MeasureTheory.volume (Set.Ioc c d)).toReal = d - c := by
    rw [Real.volume_Ioc, ENNReal.toReal_ofReal (by linarith)]
  have hone : ∫ x in Set.Ioc c d, 1 ^ 2 = d - c := by
    rw [pow_two, one_mul]
    have hi := integral_const (μ := MeasureTheory.volume.restrict (Set.Ioc c d))
      (c := (1 : ℝ))
    rw [hi, smul_eq_mul, mul_one]
    show ENNReal.toReal ((MeasureTheory.volume.restrict (Set.Ioc c d))
        Set.univ) = d - c
    rw [MeasureTheory.Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  rw [hone] at hcs
  rwa [mul_comm] at hcs
private theorem l1_Ioo_le_fat (a : ℝ) (h : ℝ → ℂ) (ha : 0 < a)
    (hhm : Measurable h)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    ∫ x in Set.Ioo (-a) a, ‖h x‖
      ≤ Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfinIoc : MeasureTheory.volume (Set.Ioc (-a) a) < ⊤ := by
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hintSqIoc : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioc.mp hx).1, (Set.mem_Ioc.mp hx).2])
  have hintNormIoc : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
      (Set.Ioc (-a) a) MeasureTheory.volume :=
    integrableOn_norm_of_sq hhm hintSqIoc hfinIoc
  have hmono : ∫ x in Set.Ioo (-a) a, ‖h x‖ ≤ ∫ x in Set.Ioc (-a) a, ‖h x‖ :=
    MeasureTheory.setIntegral_mono_set (t := Set.Ioc (-a) a) hintNormIoc
      (MeasureTheory.ae_of_all _ (fun x => norm_nonneg (h x)))
      (MeasureTheory.ae_of_all _ (fun x hx => by
        constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2]))
  have hcs := l1_le_sqrt_measure_l2_meas (-a) a h (by linarith) hhm hintSqIoc
  rw [show a - (-a : ℝ) = 2 * a from by ring] at hcs
  have hin : ∫ x in Set.Ioc (-a) a, ‖h x‖ ^ 2
      ≤ ∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2 :=
    MeasureTheory.setIntegral_mono_set (t := Set.Ioc (-(3 * a)) (3 * a))
      hhint (MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖h x‖)))
      (MeasureTheory.ae_of_all _ (fun x hx => by
        constructor <;> linarith [(Set.mem_Ioc.mp hx).1, (Set.mem_Ioc.mp hx).2]))
  calc ∫ x in Set.Ioo (-a) a, ‖h x‖
      ≤ ∫ x in Set.Ioc (-a) a, ‖h x‖ := hmono
    _ ≤ Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-a) a, ‖h x‖ ^ 2) := hcs
    _ ≤ Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hin) (Real.sqrt_nonneg _)
private theorem archBilin_half_cont {a : ℝ} (w h : ℝ → ℂ) (s₁ s₂ Lw Bh : ℝ)
    (ha : 0 < a) (hLw0 : 0 ≤ Lw)
    (hwm : Measurable w) (hhm : Measurable h)
    (hhB : ∀ x : ℝ, ‖h x‖ ≤ Bh)
    (hwL : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      ∀ y ∈ Set.Ioo (-a) a, y ≠ s₁ → y ≠ s₂ →
        ‖w x - w y‖ ≤ Lw * |x - y|)
    (hhint : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) MeasureTheory.volume) :
    |RHLean.GateII.Reduction.archBilin a w h|
      ≤ Lw * a * Real.sqrt (2 * a)
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖h x‖ ^ 2) := by
  have hfin : MeasureTheory.volume (Set.Ioo (-a) a) < ⊤ := by
    rw [Real.volume_Ioo]
    exact ENNReal.ofReal_lt_top
  have hvol : (MeasureTheory.volume (Set.Ioo (-a) a)).toReal = 2 * a := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hru : (MeasureTheory.volume.restrict (Set.Ioo (-a) a)).real
      Set.univ = 2 * a := by
    show ENNReal.toReal ((MeasureTheory.volume.restrict (Set.Ioo (-a) a))
        Set.univ) = 2 * a
    rw [MeasureTheory.Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  have hintSq : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖ ^ 2)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    hhint.mono_set (by
      intro x hx
      constructor <;> linarith [(Set.mem_Ioo.mp hx).1, (Set.mem_Ioo.mp hx).2])
  have hintNorm : MeasureTheory.IntegrableOn (fun x : ℝ => ‖h x‖)
      (Set.Ioo (-a) a) MeasureTheory.volume :=
    integrableOn_norm_of_sq hhm hintSq hfin
  have hH2 := l1_Ioo_le_fat a h ha hhm hhint
  have haeSeam : ∀ c : ℝ, {x : ℝ | x ≠ c} ∈
      MeasureTheory.ae (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    intro c
    have hnull : (MeasureTheory.volume.restrict (Set.Ioo (-a) a))
        ({c} : Set ℝ) = 0 := by
      rw [MeasureTheory.Measure.restrict_apply (MeasurableSet.singleton c)]
      exact MeasureTheory.measure_mono_null (fun y hy => hy.1)
        Real.volume_singleton
    have hset : {x : ℝ | x ≠ c} = ({c} : Set ℝ)ᶜ := by
      ext y
      simp
    rw [hset]
    exact MeasureTheory.compl_mem_ae_iff.mpr hnull
  have hKB : ∀ x : ℝ, x ∈ Set.Ioo (-a) a → x ≠ s₁ → x ≠ s₂ →
      ∀ y : ℝ, y ∈ Set.Ioo (-a) a → y ≠ s₁ → y ≠ s₂ →
        ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
          ≤ Lw * (‖h x‖ + ‖h y‖) := by
    intro x hx hxs1 hxs2 y hy hys1 hys2
    unfold RHLean.GateII.Reduction.archBilinKernel
    rw [Real.norm_eq_abs, abs_div, Real.norm_eq_abs, abs_abs]
    rcases eq_or_ne y x with rfl | hne
    · rw [sub_self, sub_self]
      simp only [mul_zero, Complex.zero_re, sub_self, norm_zero, div_zero,
        abs_zero]
      exact mul_nonneg hLw0 (add_nonneg (norm_nonneg _) (norm_nonneg _))
    · have hpos : 0 < |x - y| := by
        rw [abs_pos]
        exact sub_ne_zero.mpr (Ne.symm hne)
      have hwd : ‖w x - w y‖ ≤ Lw * |x - y| :=
        hwL x hx hxs1 hxs2 y hy hys1 hys2
      have hnum : |((w x - w y) * star (h x - h y)).re|
          ≤ Lw * |x - y| * (‖h x‖ + ‖h y‖) := by
        calc |((w x - w y) * star (h x - h y)).re|
            ≤ ‖(w x - w y) * star (h x - h y)‖ := Complex.abs_re_le_norm _
          _ = ‖w x - w y‖ * ‖h x - h y‖ := by rw [norm_mul, norm_star]
          _ ≤ Lw * |x - y| * (‖h x‖ + ‖h y‖) :=
              mul_le_mul hwd (norm_sub_le (h x) (h y)) (norm_nonneg _)
                (mul_nonneg hLw0 (abs_nonneg _))
      rw [div_le_iff₀ hpos]
      calc |((w x - w y) * star (h x - h y)).re|
          ≤ Lw * |x - y| * (‖h x‖ + ‖h y‖) := hnum
        _ = Lw * (‖h x‖ + ‖h y‖) * |x - y| := by ring
  have hKm : Measurable
      (RHLean.GateII.Reduction.archBilinKernel w h) := by
    have hre : Measurable (fun p : ℝ × ℝ =>
        ((w p.1 - w p.2) * star (h p.1 - h p.2)).re) :=
      Complex.continuous_re.measurable.comp
        (((hwm.comp measurable_fst).sub (hwm.comp measurable_snd)).mul
          (continuous_star.measurable.comp
            ((hhm.comp measurable_fst).sub (hhm.comp measurable_snd))))
    exact hre.div ((continuous_fst.sub continuous_snd).norm.measurable)
  have hintKx : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      MeasureTheory.IntegrableOn
        (fun y : ℝ => RHLean.GateII.Reduction.archBilinKernel w h (x, y))
        (Set.Ioo (-a) a) MeasureTheory.volume := by
    intro x hx hxs1 hxs2
    refine MeasureTheory.IntegrableOn.of_bound hfin ?_ (2 * Lw * Bh) ?_
    · exact ((hKm.comp
          (measurable_const.prodMk measurable_id))).aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        haeSeam s₁, haeSeam s₂] with y hy hys1 hys2
      have hstep : ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
          ≤ Lw * (2 * Bh) := by
        calc ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
            ≤ Lw * (‖h x‖ + ‖h y‖) := hKB x hx hxs1 hxs2 y hy hys1 hys2
          _ ≤ Lw * (2 * Bh) := by
              refine mul_le_mul (le_refl _) ?_
                (add_nonneg (norm_nonneg _) (norm_nonneg _)) hLw0
              exact le_trans (add_le_add (hhB x) (hhB y))
                (le_of_eq (by ring : Bh + Bh = 2 * Bh))
      exact le_trans hstep (le_of_eq (by ring : Lw * (2 * Bh) = 2 * Lw * Bh))
  have hGm : MeasureTheory.AEStronglyMeasurable
      (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
        RHLean.GateII.Reduction.archBilinKernel w h (x, y))
      (MeasureTheory.volume.restrict (Set.Ioo (-a) a)) := by
    have hfm : MeasureTheory.AEStronglyMeasurable
        (RHLean.GateII.Reduction.archBilinKernel w h)
        (MeasureTheory.volume.prod
          (MeasureTheory.volume.restrict (Set.Ioo (-a) a))) :=
      hKm.aestronglyMeasurable
    simpa only using (hfm.integral_prod_right').mono_measure
      MeasureTheory.Measure.restrict_le_self
  have hintDom : MeasureTheory.IntegrableOn
      (fun x : ℝ => Lw * (2 * a * ‖h x‖
        + ∫ y in Set.Ioo (-a) a, ‖h y‖)) (Set.Ioo (-a) a)
      MeasureTheory.volume := by
    have hint1 : MeasureTheory.IntegrableOn
        (fun x : ℝ => Lw * (2 * a) * ‖h x‖) (Set.Ioo (-a) a)
        MeasureTheory.volume :=
      hintNorm.const_mul (Lw * (2 * a))
    have hint2 : MeasureTheory.IntegrableOn
        (fun x : ℝ => Lw * ∫ y in Set.Ioo (-a) a, ‖h y‖)
        (Set.Ioo (-a) a) MeasureTheory.volume := by
      have hc : Continuous
          (fun _ : ℝ => Lw * ∫ y in Set.Ioo (-a) a, ‖h y‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hL := hint1.add hint2
    have hEq : (fun x : ℝ => Lw * (2 * a * ‖h x‖
        + ∫ y in Set.Ioo (-a) a, ‖h y‖))
        = (fun x : ℝ => Lw * (2 * a) * ‖h x‖)
          + (fun x : ℝ => Lw * ∫ y in Set.Ioo (-a) a, ‖h y‖) := by
      funext x
      show Lw * (2 * a * ‖h x‖ + ∫ y in Set.Ioo (-a) a, ‖h y‖)
          = Lw * (2 * a) * ‖h x‖ + Lw * (∫ y in Set.Ioo (-a) a, ‖h y‖)
      ring
    rw [hEq]
    exact hL
  have hinnerFold : ∀ x : ℝ,
      ∫ y in Set.Ioo (-a) a, (Lw * ‖h x‖ + Lw * ‖h y‖)
      = Lw * ‖h x‖ * (2 * a) + Lw * (∫ y in Set.Ioo (-a) a, ‖h y‖) := by
    intro x
    have hintConst : MeasureTheory.IntegrableOn
        (fun _ : ℝ => Lw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume := by
      have hc : Continuous (fun _ : ℝ => Lw * ‖h x‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hintConst2 : MeasureTheory.IntegrableOn
        (fun y : ℝ => Lw * ‖h y‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
      hintNorm.const_mul Lw
    rw [integral_add hintConst hintConst2]
    rw [integral_const (c := Lw * ‖h x‖)
      (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)), smul_eq_mul, hru]
    have hfc : ∫ y in Set.Ioo (-a) a, Lw * ‖h y‖
        = Lw * ∫ y in Set.Ioo (-a) a, ‖h y‖ :=
      integral_const_mul _ _
    rw [hfc]
    ring
  have hvalx : ∀ x ∈ Set.Ioo (-a) a, x ≠ s₁ → x ≠ s₂ →
      ‖∫ y in Set.Ioo (-a) a,
        RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
      ≤ Lw * (2 * a * ‖h x‖ + ∫ y in Set.Ioo (-a) a, ‖h y‖) := by
    intro x hx hxs1 hxs2
    have hintConst : MeasureTheory.IntegrableOn
        (fun _ : ℝ => Lw * ‖h x‖) (Set.Ioo (-a) a) MeasureTheory.volume := by
      have hc : Continuous (fun _ : ℝ => Lw * ‖h x‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hintConst2 : MeasureTheory.IntegrableOn
        (fun y : ℝ => Lw * ‖h y‖) (Set.Ioo (-a) a) MeasureTheory.volume :=
      hintNorm.const_mul Lw
    have hintDom2 : MeasureTheory.IntegrableOn
        (fun y : ℝ => Lw * ‖h x‖ + Lw * ‖h y‖) (Set.Ioo (-a) a)
        MeasureTheory.volume := hintConst.add hintConst2
    have hmono : ∫ y in Set.Ioo (-a) a,
        ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
        ≤ ∫ y in Set.Ioo (-a) a, (Lw * ‖h x‖ + Lw * ‖h y‖) :=
      MeasureTheory.setIntegral_mono_ae_restrict
        (f := fun y : ℝ =>
          ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖)
        (g := fun y : ℝ => Lw * ‖h x‖ + Lw * ‖h y‖)
        (hf := (hintKx x hx hxs1 hxs2).abs) (hg := hintDom2)
        (by filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
            haeSeam s₁, haeSeam s₂] with y hy hys1 hys2
            exact le_trans (hKB x hx hxs1 hxs2 y hy hys1 hys2) (le_of_eq (by ring)))
    calc ‖∫ y in Set.Ioo (-a) a,
          RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖
        ≤ ∫ y in Set.Ioo (-a) a,
            ‖RHLean.GateII.Reduction.archBilinKernel w h (x, y)‖ :=
          MeasureTheory.norm_integral_le_integral_norm
            (μ := MeasureTheory.volume.restrict (Set.Ioo (-a) a)) _
      _ ≤ ∫ y in Set.Ioo (-a) a, Lw * ‖h x‖ + Lw * ‖h y‖ := hmono
      _ = Lw * ‖h x‖ * (2 * a) + Lw * (∫ y in Set.Ioo (-a) a, ‖h y‖) :=
          hinnerFold x
      _ = Lw * (2 * a * ‖h x‖ + ∫ y in Set.Ioo (-a) a, ‖h y‖) := by ring
  have hintG : MeasureTheory.IntegrableOn
      (fun x : ℝ => ∫ y in Set.Ioo (-a) a,
        RHLean.GateII.Reduction.archBilinKernel w h (x, y))
      (Set.Ioo (-a) a) MeasureTheory.volume := by
    refine MeasureTheory.IntegrableOn.of_bound hfin hGm
        (Lw * (2 * a * Bh + ∫ y in Set.Ioo (-a) a, ‖h y‖)) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo,
        haeSeam s₁, haeSeam s₂] with x hx hxs1 hxs2
    refine le_trans (hvalx x hx hxs1 hxs2) ?_
    have hnn : 0 ≤ Lw * (2 * a) := mul_nonneg hLw0 (by linarith)
    have hI : (0 : ℝ) ≤ ∫ y in Set.Ioo (-a) a, ‖h y‖ :=
      integral_nonneg (fun y => norm_nonneg (h y))
    have h1 : Lw * (2 * a) * ‖h x‖ ≤ Lw * (2 * a) * Bh :=
      mul_le_mul_of_nonneg_left (hhB x) hnn
    have hring1 : Lw * (2 * a * ‖h x‖ + ∫ y in Set.Ioo (-a) a, ‖h y‖)
        = Lw * (2 * a) * ‖h x‖ + Lw * (∫ y in Set.Ioo (-a) a, ‖h y‖) := by ring
    have hring2 : Lw * (2 * a * Bh + ∫ y in Set.Ioo (-a) a, ‖h y‖)
        = Lw * (2 * a) * Bh + Lw * (∫ y in Set.Ioo (-a) a, ‖h y‖) := by ring
    linarith
  rw [show RHLean.GateII.Reduction.archBilin a w h
      = (1 / 4) * ∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.GateII.Reduction.archBilinKernel w h (x, y) from rfl,
    abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 4)]
  have habsG : |∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
