theorem memLp_two_of_continuous_gen {c d : ℝ} {f : ℝ → ℂ} (hf : Continuous f)
    (s : Set ℝ) (hs : s ⊆ Set.Icc c d) :
    MemLp f 2 (volume.restrict s) := by
  have hcont : Continuous (fun x : ℝ => ‖f x‖ ^ 2) := hf.norm.pow 2
  have hint : IntegrableOn (fun x : ℝ => ‖f x‖ ^ 2) (Set.Icc c d) volume :=
    hcont.integrableOn_Icc
  exact (MeasureTheory.memLp_two_iff_integrable_sq_norm
    hf.measurable.aestronglyMeasurable).mpr (hint.mono_set hs)
theorem l2_integral_mul_le_gen {f g : ℝ → ℂ} (s : Set ℝ)
    (hf : MemLp f 2 (volume.restrict s))
    (hg : MemLp g 2 (volume.restrict s)) :
    (∫ x in s, ‖f x‖ * ‖g x‖)
      ≤ Real.sqrt (∫ x in s, ‖f x‖ ^ 2) * Real.sqrt (∫ x in s, ‖g x‖ ^ 2) := by
  have h := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
    (μ := volume.restrict s) (f := f) (g := g) (p := (2 : ℝ)) (q := (2 : ℝ))
    Real.HolderConjugate.two_two (by simpa using hf) (by simpa using hg)
  simp_rw [Real.rpow_two] at h
  rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at h
  simpa using h
theorem norm_polarInner_le (a : ℝ) (g : ℝ → ℂ)
    (hg : MemLp g 2 (volume.restrict (Set.Ioo (-a) a))) :
    ‖RHLean.polarInner a g‖
      ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) := by
  have hf : MemLp (RHLean.sph) 2 (volume.restrict (Set.Ioo (-a) a)) :=
    memLp_two_of_continuous_gen (by unfold RHLean.sph; fun_prop) _
      Set.Ioo_subset_Icc_self
  calc ‖RHLean.polarInner a g‖
      = ‖∫ x in Set.Ioo (-a) a, star (RHLean.sph x) * g x‖ := by
        rw [RHLean.polarInner]
    _ ≤ ∫ x in Set.Ioo (-a) a, ‖star (RHLean.sph x) * g x‖ :=
        norm_integral_le_integral_norm
          (μ := volume.restrict (Set.Ioo (-a) a)) _
    _ = ∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ * ‖g x‖ := by
        apply integral_congr_ae
        filter_upwards with x
        rw [norm_mul, norm_star]
    _ ≤ Real.sqrt (∫ x in Set.Ioo (-a) a, ‖RHLean.sph x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioo (-a) a, ‖g x‖ ^ 2) :=
        l2_integral_mul_le_gen _ hf hg
