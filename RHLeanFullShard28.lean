def SchurBlockFloor (a : ℝ) : Prop :=
  ∀ (s : Finset ℕ) (x : ℕ → ℝ), (∀ m ∈ s, Odd m) →
    (FCoord s x) ⬝ᵥ (FBlockMatrix *ᵥ FCoord s x)
      ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM a m n
theorem gramFloorF_of_schurBlockFloor {a : ℝ}
    (hBlock : SchurBlockFloor a) :
    Y7A3GramFloor.GramFloorF a := by
  intro s x hs
  have hD : (Matrix.diagonal Y7A3Data.dd).PosDef :=
    Matrix.posDef_diagonal_iff.mpr Y7A3Data.dd_pos
  letI : Invertible (Matrix.diagonal Y7A3Data.dd) :=
    RHLean.GateII.Reduction.posDef_invertible_of_posDef _ hD
  set p : Fin 7 → ℝ := coordOld s x
  have hcut := dotProduct_harmonicExtension
    FBlockA Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd) hD.1 p
  have hF : harmonicForm FBlockA Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd)
      = Y7A3GramFloor.F := by
    unfold FBlockA harmonicForm
    abel
  rw [hF] at hcut
  have hcoord : FCoord s x
      = harmonicExtension Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd) p := by
    simp [FCoord, p]
  have hblk := hBlock s x hs
  rw [hcoord] at hblk
  rw [show FBlockMatrix
      = oldNewBlock FBlockA Y7A3Data.Bm (Matrix.diagonal Y7A3Data.dd) from rfl] at hblk
  rw [← hcut]
  exact hblk
