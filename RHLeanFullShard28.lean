theorem integrableOn_bound_Ioo_of_measurable (a : ℝ) (f : ℝ → ℝ) (C : ℝ)
    (hm : Measurable f) (hb : ∀ x ∈ Set.Ioo (-a) a, ‖f x‖ ≤ C) :
    IntegrableOn f (Set.Ioo (-a) a) volume := by
  refine IntegrableOn.of_bound measure_Ioo_lt_top hm.aestronglyMeasurable C ?_
