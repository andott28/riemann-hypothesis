section Inline_LdlBridge
open Matrix
namespace LdlBridge
open Matrix
variable {m : Type*} [Fintype m] [DecidableEq m]
theorem quad_eq (L : Matrix m m ℝ) (d : m → ℝ) (x : m → ℝ) :
    x ⬝ᵥ ((L * Matrix.diagonal d * Lᵀ) *ᵥ x)
      = ∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 := by
  have hstep : (L * Matrix.diagonal d * Lᵀ) *ᵥ x
      = L *ᵥ (Matrix.diagonal d *ᵥ (Lᵀ *ᵥ x)) := by
    rw [(mulVec_mulVec (v := x) (M := L * Matrix.diagonal d) (N := Lᵀ)).symm,
      (mulVec_mulVec (v := Lᵀ *ᵥ x) (M := L) (N := Matrix.diagonal d)).symm]
  rw [hstep]
  have h1 : x ⬝ᵥ (L *ᵥ (Matrix.diagonal d *ᵥ (Lᵀ *ᵥ x)))
      = (Matrix.diagonal d *ᵥ (Lᵀ *ᵥ x)) ⬝ᵥ (Lᵀ *ᵥ x) := by
    rw [dotProduct_mulVec, ← Matrix.mulVec_transpose]
    exact dotProduct_comm _ _
  rw [h1, dotProduct]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Matrix.mulVec_diagonal]
  ring
theorem posSemidef_of_ldl_perturbation
    (L : Matrix m m ℝ) (d : m → ℝ) (dmin K η : ℝ)
    (A E : Matrix m m ℝ)
    (hA : A = L * Matrix.diagonal d * Lᵀ)
    (hE : E.IsSymm)
    (hmin : ∀ i, dmin ≤ d i)
    (hdmin : 0 < dmin)
    (hK : 0 < K)
    (hcond : ∀ x : m → ℝ, ∑ i, x i ^ 2 ≤ K * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2)
    (hη : ∀ x : m → ℝ, x ⬝ᵥ (E *ᵥ x) ≤ η * ∑ i, x i ^ 2)
    (hsmall : η * K < dmin) :
    (A - E).PosSemidef := by
  have hAs : Aᵀ = A := by
    rw [hA, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_mul,
      Matrix.diagonal_transpose, Matrix.mul_assoc]
  refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ ?_
  · rw [isHermitian_iff_isSymm]
    show (A - E)ᵀ = A - E
    rw [Matrix.transpose_sub, hAs]
    rw [show Eᵀ = E from hE]
  · intro x
    show 0 ≤ x ⬝ᵥ ((A - E) *ᵥ x)
    have hqA : x ⬝ᵥ (A *ᵥ x) = ∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 := by
      rw [hA]
      exact quad_eq L d x
    have hle : dmin * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2
        ≤ ∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 := by
      rw [Finset.mul_sum]
      exact Finset.sum_le_sum (fun i _ =>
        mul_le_mul_of_nonneg_right (hmin i) (sq_nonneg ((Lᵀ *ᵥ x) i)))
    have hKz : ∑ i, x i ^ 2 ≤ K * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2 := hcond x
    have hs : 0 ≤ ∑ i, x i ^ 2 :=
      Finset.sum_nonneg (fun i _ => sq_nonneg (x i))
    have hbig : dmin * ∑ i, x i ^ 2 ≤ K * ∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 := by
      calc dmin * ∑ i, x i ^ 2
          ≤ dmin * (K * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2) :=
            mul_le_mul_of_nonneg_left hKz (le_of_lt hdmin)
        _ = K * (dmin * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2) := by ring
        _ ≤ K * ∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 :=
          mul_le_mul_of_nonneg_left hle hK.le
    have hsmall' : K * (η * ∑ i, x i ^ 2) ≤ dmin * ∑ i, x i ^ 2 := by
      have h1 : (η * K) * ∑ i, x i ^ 2 ≤ dmin * ∑ i, x i ^ 2 :=
        mul_le_mul_of_nonneg_right (le_of_lt hsmall) hs
      rw [show K * (η * ∑ i, x i ^ 2) = (η * K) * ∑ i, x i ^ 2 from by ring]
      exact h1
    have hE' : x ⬝ᵥ (E *ᵥ x) ≤ η * ∑ i, x i ^ 2 := hη x
    have hV : K * (x ⬝ᵥ (E *ᵥ x)) ≤ dmin * ∑ i, x i ^ 2 :=
      le_trans (mul_le_mul_of_nonneg_left hE' hK.le) hsmall'
    have hsub : x ⬝ᵥ ((A - E) *ᵥ x) = x ⬝ᵥ (A *ᵥ x) - x ⬝ᵥ (E *ᵥ x) := by
      rw [Matrix.sub_mulVec]
      exact dotProduct_sub x (A *ᵥ x) (E *ᵥ x)
    rw [hsub, hqA]
    have hfin : 0 ≤ K * (∑ i, d i * ((Lᵀ *ᵥ x) i) ^ 2 - x ⬝ᵥ (E *ᵥ x)) := by
      rw [mul_sub]
      linarith [hbig, hV]
    exact nonneg_of_mul_nonneg_right hfin hK
end LdlBridge
