section Inline_ThetaTrustCounterexample
theorem theta_two_point_nine : Chebyshev.theta (29 / 10 : ℝ) = Real.log 2 := by
  rw [Chebyshev.theta_eq_sum_Icc]
  have hfloor : ⌊(29 / 10 : ℝ)⌋₊ = 2 := by norm_num
  rw [hfloor]
  have h : (Finset.Icc 0 2).filter Nat.Prime = {2} := by decide
  simp [h]
theorem not_sharpThetaCFrom_two_point_nine :
    ¬ RHLean.GateII.BClosure.SharpThetaCFrom (1 / 5) (29 / 10) := by
  intro h
  have h := h (29 / 10 : ℝ) (by norm_num)
  rw [theta_two_point_nine] at h
  have hlog2 : Real.log 2 < 0.7 := lt_trans Real.log_two_lt_d9 (by norm_num)
  have hlog29 : (1 : ℝ) < Real.log (29 / 10) := by
    rw [Real.lt_log_iff_exp_lt (by norm_num : (0 : ℝ) < 29 / 10)]
    exact lt_trans Real.exp_one_lt_d9 (by norm_num)
  have hsq : (1 : ℝ) < (Real.log (29 / 10)) ^ 2 := by nlinarith
  have hRHS : (1 / 5 : ℝ) * (29 / 10) / (Real.log (29 / 10)) ^ 2 < 29 / 50 := by
    rw [div_lt_iff₀ (by positivity)]
    nlinarith
  have hLHS : (29 / 50 : ℝ) < |Real.log 2 - 29 / 10| := by
    rw [abs_of_neg (by linarith)]
    linarith
  linarith
end Inline_ThetaTrustCounterexample
