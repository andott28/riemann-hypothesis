theorem l1_le_sqrt_measure_l2_gen_Ioc (c d : ℝ) (h : ℝ → ℂ) (hcd : c < d)
    (hh : Continuous h) :
    ∫ x in Set.Ioc c d, ‖h x‖
      ≤ Real.sqrt (d - c) * Real.sqrt (∫ x in Set.Ioc c d, ‖h x‖ ^ 2) := by
  have hcont1 : Continuous (fun _ : ℝ => (1:ℂ)) := continuous_const
  have hm1 : MemLp (fun _ => (1:ℂ)) 2 (volume.restrict (Set.Ioc c d)) :=
    memLp_two_of_continuous_gen hcont1 _ Set.Ioc_subset_Icc_self
  have hmh : MemLp h 2 (volume.restrict (Set.Ioc c d)) :=
    memLp_two_of_continuous_gen hh _ Set.Ioc_subset_Icc_self
  have hcs : ∫ x in Set.Ioc c d, ‖h x‖ * ‖(fun _ => (1:ℂ)) x‖
      ≤ Real.sqrt (∫ x in Set.Ioc c d, ‖h x‖ ^ 2)
        * Real.sqrt (∫ x in Set.Ioc c d, ‖(fun _ => (1:ℂ)) x‖ ^ 2) :=
    l2_integral_mul_le_gen _ hmh hm1
  simp only [norm_one, mul_one] at hcs
  have hvol : (volume (Set.Ioc c d)).toReal = d - c := by
    rw [Real.volume_Ioc, ENNReal.toReal_ofReal (by linarith)]
  have hone : ∫ x in Set.Ioc c d, 1 ^ 2 = d - c := by
    rw [pow_two, one_mul]
    have hi := integral_const (μ := volume.restrict (Set.Ioc c d)) (c := (1:ℝ))
    rw [hi, smul_eq_mul, mul_one]
    show ENNReal.toReal ((volume.restrict (Set.Ioc c d)) Set.univ) = d - c
    rw [Measure.restrict_apply, Set.univ_inter, hvol]
    exact MeasurableSet.univ
  rw [hone] at hcs
  rwa [mul_comm] at hcs
theorem setIntegral_translate_Ioc (d : ℝ) (F : ℝ → ℝ) (c₁ c₂ : ℝ)
    (hc : c₁ ≤ c₂) :
    ∫ x in Set.Ioc c₁ c₂, F (x + d) = ∫ x in Set.Ioc (c₁ + d) (c₂ + d), F x := by
  rw [← intervalIntegral.integral_of_le hc,
    intervalIntegral.integral_comp_add_right,
    intervalIntegral.integral_of_le (by linarith : c₁ + d ≤ c₂ + d)]
theorem shiftLength_bounds (a : ℝ) (ha : 0 < a) (n : ℕ)
    (hn : n ∈ RHLean.arithSupport a) :
    0 ≤ RHLean.shiftLength n ∧ RHLean.shiftLength n ≤ 2 * a := by
  have hmem : 2 ≤ n ∧ n ≤ Nat.ceil (Real.exp (2 * a)) - 1 := Finset.mem_Icc.mp hn
  have hnK : n + 1 ≤ Nat.ceil (Real.exp (2 * a)) := by omega
  have hnlt : (n:ℝ) < Real.exp (2 * a) := by
    have h1 : (n:ℝ) + 1 ≤ (Nat.ceil (Real.exp (2 * a)) : ℝ) := by
      exact_mod_cast hnK
    have h2 : (Nat.ceil (Real.exp (2 * a)) : ℝ) < Real.exp (2 * a) + 1 :=
      Nat.ceil_lt_add_one (by positivity)
    linarith
  have hn0 : 0 < (n:ℝ) := Nat.cast_pos.mpr (by omega)
  constructor
  · show 0 ≤ Real.log n
    exact Real.log_nonneg (by exact_mod_cast (by omega : (1:ℕ) ≤ n))
  · show Real.log n ≤ 2 * a
    have hle : Real.log n ≤ Real.log (Real.exp (2 * a)) :=
      (Real.log_le_log_iff hn0 (by positivity)).mpr (le_of_lt hnlt)
    rwa [Real.log_exp] at hle
theorem shiftForm_L2_bound (a : ℝ) (f g : ℝ → ℂ) (Bf Bg : ℝ) (ha : 0 < a)
    (hf : Continuous f) (hg : Continuous g)
    (hbf : ∀ x : ℝ, ‖f x‖ ≤ Bf) (hbg : ∀ x : ℝ, ‖g x‖ ≤ Bg) :
    |RHLean.shiftForm a f - RHLean.shiftForm a g|
      ≤ (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
        * (2 * Real.sqrt (2 * a) * (Bf + Bg))
        * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
  have hBf0 : 0 ≤ Bf := le_trans (norm_nonneg _) (hbf 0)
  have hBg0 : 0 ≤ Bg := le_trans (norm_nonneg _) (hbg 0)
  have h2pos : (0:ℝ) < 2 := by norm_num
  have hHcont : Continuous (fun x : ℝ => f x - g x) := hf.sub hg
  have hFat : IntegrableOn (fun x : ℝ => ‖f x - g x‖ ^ 2)
      (Set.Ioc (-(3 * a)) (3 * a)) volume := by
    have hc : Continuous (fun x : ℝ => ‖f x - g x‖ ^ 2) := by fun_prop
    exact hc.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
  have hL2grow : (∫ x in Set.Ioo (-a) a, ‖f x - g x‖ ^ 2)
      ≤ ∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2 := by
    refine setIntegral_mono_set hFat ?_ ?_
    · exact MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖f x - g x‖))
    · exact MeasureTheory.ae_of_all _ (fun x hx =>
        (Set.Subset.trans Set.Ioo_subset_Ioc_self
          (Set.Ioc_subset_Ioc (by linarith : -(3 * a) ≤ -a)
            (by linarith : a ≤ 3 * a))) hx)
  have hA : ∫ x in Set.Ioo (-a) a, ‖f x - g x‖
      ≤ Real.sqrt (2 * a)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) :=
    le_trans (l1_le_sqrt_measure_l2 a (fun x => f x - g x) ha.le hHcont)
      (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hL2grow) (Real.sqrt_nonneg _))
  have hterm : ∀ n ∈ RHLean.arithSupport a,
      |RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
        - RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)|
      ≤ |RHLean.arithCoeff n|
          * (2 * Real.sqrt (2 * a) * (Bf + Bg)
              * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)) := by
    intro n hn
    have hd := shiftLength_bounds a ha n hn
    have hintFc : IntegrableOn (fun x : ℝ =>
        f x * star (f (x + RHLean.shiftLength n))) (Set.Ioo (-a) a) volume :=
      admissible_shift_first_field a f f Bf Bf hf hf hbf hbf n hn
    have hintGc : IntegrableOn (fun x : ℝ =>
        g x * star (g (x + RHLean.shiftLength n))) (Set.Ioo (-a) a) volume :=
      admissible_shift_first_field a g g Bg Bg hg hg hbg hbg n hn
    have hintF : IntegrableOn (fun x : ℝ =>
        (f x * star (f (x + RHLean.shiftLength n))).re)
        (Set.Ioo (-a) a) volume := by
      refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ (Bf * Bf) ?_
      · have hc : Continuous (fun x : ℝ =>
            (f x * star (f (x + RHLean.shiftLength n))).re) := by fun_prop
        exact hc.measurable.aestronglyMeasurable
      · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
        rw [Real.norm_eq_abs]
        refine le_trans (Complex.abs_re_le_norm _) ?_
        rw [norm_mul, norm_star]
        nlinarith [hbf x, hbf (x + RHLean.shiftLength n),
          norm_nonneg (f x), norm_nonneg (f (x + RHLean.shiftLength n))]
    have hintG : IntegrableOn (fun x : ℝ =>
        (g x * star (g (x + RHLean.shiftLength n))).re)
        (Set.Ioo (-a) a) volume := by
      refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ (Bg * Bg) ?_
      · have hc : Continuous (fun x : ℝ =>
            (g x * star (g (x + RHLean.shiftLength n))).re) := by fun_prop
        exact hc.measurable.aestronglyMeasurable
      · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
        rw [Real.norm_eq_abs]
        refine le_trans (Complex.abs_re_le_norm _) ?_
        rw [norm_mul, norm_star]
        nlinarith [hbg x, hbg (x + RHLean.shiftLength n),
          norm_nonneg (g x), norm_nonneg (g (x + RHLean.shiftLength n))]
    have hintReF : (∫ x in Set.Ioo (-a) a,
        f x * star (f (x + RHLean.shiftLength n)) ∂volume).re
        = ∫ x in Set.Ioo (-a) a,
            (f x * star (f (x + RHLean.shiftLength n))).re :=
      (integral_re hintFc.integrable).symm
    have hintReG : (∫ x in Set.Ioo (-a) a,
        g x * star (g (x + RHLean.shiftLength n)) ∂volume).re
        = ∫ x in Set.Ioo (-a) a,
            (g x * star (g (x + RHLean.shiftLength n))).re :=
      (integral_re hintGc.integrable).symm
    have hIn : (2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
        - (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)
        = 2 * ∫ x in Set.Ioo (-a) a,
            ((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re := by
      have hring : (2 * (∫ x in Set.Ioo (-a) a,
              f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
          - (2 * (∫ x in Set.Ioo (-a) a,
              g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)
          = 2 * ((∫ x in Set.Ioo (-a) a,
              f x * star (f (x + RHLean.shiftLength n)) ∂volume).re
            - (∫ x in Set.Ioo (-a) a,
              g x * star (g (x + RHLean.shiftLength n)) ∂volume).re) := by ring
      rw [hring, hintReF, hintReG, ← integral_sub hintF hintG]
      simp only [Complex.sub_re]
    have habs : |∫ x in Set.Ioo (-a) a,
            ((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re|
        ≤ ∫ x in Set.Ioo (-a) a,
            |((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re| := by
      have h := norm_integral_le_integral_norm
        (μ := volume.restrict (Set.Ioo (-a) a))
        (fun x : ℝ => ((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re)
      rw [Real.norm_eq_abs] at h
      exact h
    have hpt : ∀ x : ℝ, |((f x * star (f (x + RHLean.shiftLength n)))
          - (g x * star (g (x + RHLean.shiftLength n)))).re|
        ≤ ‖f x - g x‖ * ‖f (x + RHLean.shiftLength n)‖
          + ‖g x‖ * ‖f (x + RHLean.shiftLength n)
              - g (x + RHLean.shiftLength n)‖ := by
      intro x
      have hsplit : (f x * star (f (x + RHLean.shiftLength n)))
          - (g x * star (g (x + RHLean.shiftLength n)))
          = (f x - g x) * star (f (x + RHLean.shiftLength n))
            + g x * star (f (x + RHLean.shiftLength n)
              - g (x + RHLean.shiftLength n)) := by
        rw [star_sub, sub_mul, mul_sub]
        ring
      rw [hsplit]
      refine le_trans (Complex.abs_re_le_norm _) ?_
      refine le_trans (norm_add_le _ _) ?_
      rw [norm_mul, norm_star, norm_mul, norm_star]
    have hmid : ∀ x : ℝ, |((f x * star (f (x + RHLean.shiftLength n)))
          - (g x * star (g (x + RHLean.shiftLength n)))).re|
        ≤ Bf * ‖f x - g x‖
          + Bg * ‖f (x + RHLean.shiftLength n)
              - g (x + RHLean.shiftLength n)‖ := by
      intro x
      refine le_trans (hpt x) ?_
      have e1 : ‖f x - g x‖ * ‖f (x + RHLean.shiftLength n)‖
          ≤ Bf * ‖f x - g x‖ := by
        calc ‖f x - g x‖ * ‖f (x + RHLean.shiftLength n)‖
            = ‖f (x + RHLean.shiftLength n)‖ * ‖f x - g x‖ := by ring
          _ ≤ Bf * ‖f x - g x‖ :=
              mul_le_mul (hbf (x + RHLean.shiftLength n)) (le_refl _)
                (norm_nonneg _) hBf0
      have e2 : ‖g x‖ * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
          ≤ Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖ :=
        mul_le_mul (hbg x) (le_refl _) (norm_nonneg _) hBg0
      linarith
    have hintMaj : IntegrableOn (fun x : ℝ => Bf * ‖f x - g x‖
        + Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)
        (Set.Ioo (-a) a) volume := by
      have hc1 : Continuous (fun x : ℝ => Bf * ‖f x - g x‖) := by fun_prop
      have hc2 : Continuous (fun x : ℝ =>
          Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖) := by fun_prop
      exact (hc1.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self).add
        (hc2.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self)
    have hintAbs : IntegrableOn (fun x : ℝ =>
        |((f x * star (f (x + RHLean.shiftLength n)))
          - (g x * star (g (x + RHLean.shiftLength n)))).re|)
        (Set.Ioo (-a) a) volume := by
      refine IntegrableOn.of_bound measure_Ioo_lt_top ?_ (Bf * Bf + Bg * Bg) ?_
      · have hc : Continuous (fun x : ℝ =>
            |((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re|) := by fun_prop
        exact hc.measurable.aestronglyMeasurable
      · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
        rw [Real.norm_eq_abs, abs_abs]
        refine le_trans (Complex.abs_re_le_norm _) ?_
        refine le_trans (norm_sub_le _ _) ?_
        calc ‖f x * star (f (x + RHLean.shiftLength n))‖
            + ‖g x * star (g (x + RHLean.shiftLength n))‖
            = ‖f x‖ * ‖f (x + RHLean.shiftLength n)‖
              + ‖g x‖ * ‖g (x + RHLean.shiftLength n)‖ := by
              rw [norm_mul, norm_star, norm_mul, norm_star]
          _ ≤ Bf * Bf + Bg * Bg := by
              nlinarith [hbf x, hbg x, hbf (x + RHLean.shiftLength n),
                hbg (x + RHLean.shiftLength n),
                norm_nonneg (f x), norm_nonneg (g x)]
    have hB : ∫ x in Set.Ioo (-a) a,
          ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
        ≤ Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
      have htr1 : ∫ x in Set.Ioo (-a) a,
          ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
          ≤ ∫ x in Set.Ioc (-a) a,
              ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖ := by
        refine setIntegral_mono_set ?_ ?_ ?_
        · have hc : Continuous (fun x : ℝ =>
              ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖) := by fun_prop
          exact hc.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
        · exact MeasureTheory.ae_of_all _ (fun x => norm_nonneg _)
        · exact MeasureTheory.ae_of_all _ (fun x hx => Set.Ioo_subset_Ioc_self hx)
      have htr2 : ∫ x in Set.Ioc (-a) a,
          ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
          = ∫ x in Set.Ioc (-a + RHLean.shiftLength n) (a + RHLean.shiftLength n),
              ‖f x - g x‖ :=
        setIntegral_translate_Ioc _ (fun y => ‖f y - g y‖) _ _ (by linarith)
      have htr3 : ∫ x in Set.Ioc (-a + RHLean.shiftLength n) (a + RHLean.shiftLength n),
            ‖f x - g x‖
          ≤ Real.sqrt (2 * a)
              * Real.sqrt (∫ x in Set.Ioc (-a + RHLean.shiftLength n)
                  (a + RHLean.shiftLength n), ‖f x - g x‖ ^ 2) := by
        have hgt : -a + RHLean.shiftLength n < a + RHLean.shiftLength n := by
          linarith
        have hgen := l1_le_sqrt_measure_l2_gen_Ioc (-a + RHLean.shiftLength n)
          (a + RHLean.shiftLength n) (fun x => f x - g x) hgt hHcont
        rwa [show (a + RHLean.shiftLength n) - (-a + RHLean.shiftLength n)
            = 2 * a by ring] at hgen
      have hL2g : (∫ x in Set.Ioc (-a + RHLean.shiftLength n) (a + RHLean.shiftLength n),
            ‖f x - g x‖ ^ 2)
          ≤ ∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2 := by
        refine setIntegral_mono_set hFat ?_ ?_
        · exact MeasureTheory.ae_of_all _ (fun x => sq_nonneg (‖f x - g x‖))
        · exact MeasureTheory.ae_of_all _ (fun x hx =>
            (Set.Ioc_subset_Ioc
              (by linarith : -(3 * a) ≤ -a + RHLean.shiftLength n)
              (by linarith : a + RHLean.shiftLength n ≤ 3 * a)) hx)
      calc ∫ x in Set.Ioo (-a) a,
            ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
          ≤ ∫ x in Set.Ioc (-a + RHLean.shiftLength n) (a + RHLean.shiftLength n),
              ‖f x - g x‖ := htr1.trans_eq htr2
        _ ≤ Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-a + RHLean.shiftLength n)
                (a + RHLean.shiftLength n), ‖f x - g x‖ ^ 2) := htr3
        _ ≤ Real.sqrt (2 * a)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) :=
            mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hL2g) (Real.sqrt_nonneg _)
    have hint1 : IntegrableOn (fun x : ℝ => Bf * ‖f x - g x‖)
        (Set.Ioo (-a) a) volume := by
      have hc : Continuous (fun x : ℝ => Bf * ‖f x - g x‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hint2 : IntegrableOn (fun x : ℝ =>
        Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)
        (Set.Ioo (-a) a) volume := by
      have hc : Continuous (fun x : ℝ =>
          Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖) := by fun_prop
      exact hc.integrableOn_Icc.mono_set Set.Ioo_subset_Icc_self
    have hfold : ∫ x in Set.Ioo (-a) a, (Bf * ‖f x - g x‖
          + Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)
        = Bf * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖)
          + Bg * (∫ x in Set.Ioo (-a) a,
              ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖) := by
      have hfoldF : ∫ x in Set.Ioo (-a) a, Bf * ‖f x - g x‖
          = Bf * ∫ x in Set.Ioo (-a) a, ‖f x - g x‖ := integral_const_mul _ _
      have hfoldG : ∫ x in Set.Ioo (-a) a,
          Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖
          = Bg * ∫ x in Set.Ioo (-a) a,
              ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖ :=
        integral_const_mul _ _
      rw [integral_add hint1 hint2, hfoldF, hfoldG]
    have hbare : |(2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
        - (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)|
        ≤ 2 * Real.sqrt (2 * a) * (Bf + Bg)
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
      calc |(2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
        - (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)|
          = 2 * |∫ x in Set.Ioo (-a) a,
            ((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re| := by
            rw [hIn, abs_mul, abs_of_pos h2pos]
        _ ≤ 2 * ∫ x in Set.Ioo (-a) a,
            |((f x * star (f (x + RHLean.shiftLength n)))
              - (g x * star (g (x + RHLean.shiftLength n)))).re| :=
            mul_le_mul_of_nonneg_left habs (by norm_num)
        _ ≤ 2 * ∫ x in Set.Ioo (-a) a, (Bf * ‖f x - g x‖
            + Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖) := by
            refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
            exact setIntegral_mono_ae (f := fun x : ℝ =>
                |((f x * star (f (x + RHLean.shiftLength n)))
                  - (g x * star (g (x + RHLean.shiftLength n)))).re|)
              (g := fun x : ℝ => Bf * ‖f x - g x‖
                + Bg * ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)
              (hf := hintAbs) (hg := hintMaj)
              (by filter_upwards [] with x; exact hmid x)
        _ = 2 * (Bf * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖)
            + Bg * (∫ x in Set.Ioo (-a) a,
                ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)) := by
            rw [hfold]
        _ ≤ 2 * Real.sqrt (2 * a) * (Bf + Bg)
            * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by
            have hA' : Bf * (∫ x in Set.Ioo (-a) a, ‖f x - g x‖)
                ≤ Bf * (Real.sqrt (2 * a)
                  * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
                    ‖f x - g x‖ ^ 2)) :=
              mul_le_mul_of_nonneg_left hA hBf0
            have hB' : Bg * (∫ x in Set.Ioo (-a) a,
                ‖f (x + RHLean.shiftLength n) - g (x + RHLean.shiftLength n)‖)
                ≤ Bg * (Real.sqrt (2 * a)
                  * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a),
                    ‖f x - g x‖ ^ 2)) :=
              mul_le_mul_of_nonneg_left hB hBg0
            nlinarith [hA', hB', Real.sqrt_nonneg
              (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)]
    calc |RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
        - RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)|
        = |RHLean.arithCoeff n| * |(2 * (∫ x in Set.Ioo (-a) a,
            f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
            - (2 * (∫ x in Set.Ioo (-a) a,
            g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)| := by
            rw [← mul_sub, abs_mul]
      _ ≤ |RHLean.arithCoeff n|
          * (2 * Real.sqrt (2 * a) * (Bf + Bg)
              * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)) :=
          mul_le_mul (le_refl _) hbare (abs_nonneg _) (abs_nonneg _)
  have hSumDiff : RHLean.shiftForm a f - RHLean.shiftForm a g
      = ∑ n ∈ RHLean.arithSupport a,
          (RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
            - RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)) := by
    unfold RHLean.shiftForm
    rw [← Finset.sum_sub_distrib]
  calc |RHLean.shiftForm a f - RHLean.shiftForm a g|
      = |∑ n ∈ RHLean.arithSupport a,
          (RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
            - RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              g x * star (g (x + RHLean.shiftLength n)) ∂volume).re))| := by
        rw [hSumDiff]
    _ ≤ ∑ n ∈ RHLean.arithSupport a,
          |RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              f x * star (f (x + RHLean.shiftLength n)) ∂volume).re)
            - RHLean.arithCoeff n * (2 * (∫ x in Set.Ioo (-a) a,
              g x * star (g (x + RHLean.shiftLength n)) ∂volume).re)| :=
          Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|
          * (2 * Real.sqrt (2 * a) * (Bf + Bg)
              * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)) := by
          refine Finset.sum_le_sum (fun n hn => ?_)
          exact hterm n hn
    _ = (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
          * (2 * Real.sqrt (2 * a) * (Bf + Bg)
              * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2)) := by
          rw [← Finset.sum_mul]
    _ = (∑ n ∈ RHLean.arithSupport a, |RHLean.arithCoeff n|)
          * (2 * Real.sqrt (2 * a) * (Bf + Bg))
          * Real.sqrt (∫ x in Set.Ioc (-(3 * a)) (3 * a), ‖f x - g x‖ ^ 2) := by ring
