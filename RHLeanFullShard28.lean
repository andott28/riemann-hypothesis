          ≤ |Real.log (a - x)| * (B * B) :=
            mul_le_mul_of_nonneg_left (hR x hx) (abs_nonneg _)
        _ = (B * B) * |Real.log (a - x)| := by ring
  have hp2 : IntegrableOn (fun x : ℝ => Real.log (a + x) * (h x * star (g x)).re)
      (Set.Ioo (-a) a) volume := by
    refine hmaj2.mono' ?_ ?_
    · have hlogm : Measurable (fun x : ℝ => Real.log (a + x)) :=
        ((continuous_const : Continuous fun _ : ℝ => a).add continuous_id).measurable.log
      have hRm : Measurable (fun x : ℝ => (h x * star (g x)).re) := by fun_prop
      exact (hlogm.mul hRm).aestronglyMeasurable
    · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioo] with x hx
      rw [Real.norm_eq_abs, abs_mul]
      calc |Real.log (a + x)| * |(h x * star (g x)).re|
          ≤ |Real.log (a + x)| * (B * B) :=
            mul_le_mul_of_nonneg_left (hR x hx) (abs_nonneg _)
        _ = (B * B) * |Real.log (a + x)| := by ring
  have hsum : IntegrableOn (fun x : ℝ => (-(1 / 2)) *
      (Real.log (a - x) * (h x * star (g x)).re
        + Real.log (a + x) * (h x * star (g x)).re))
      (Set.Ioo (-a) a) volume := (hp1.add hp2).const_mul (-(1 / 2))
  refine hsum.congr_fun ?_ measurableSet_Ioo
  intro x hx
  have hx1 : 0 < a - x := by linarith [(Set.mem_Ioo.mp hx).2]
  have hx2 : 0 < a + x := by linarith [(Set.mem_Ioo.mp hx).1]
  change -(1 / 2) * (Real.log (a - x) * (h x * star (g x)).re
      + Real.log (a + x) * (h x * star (g x)).re)
    = RHLean.endpointPotential a x * (h x * star (g x)).re
  rw [RHLean.ExplicitFormula.endpointPotential_eq,
    show a ^ 2 - x ^ 2 = (a - x) * (a + x) by ring,
    Real.log_mul (ne_of_gt hx1) (ne_of_gt hx2)]
  ring
end Y7GateIIAdd
