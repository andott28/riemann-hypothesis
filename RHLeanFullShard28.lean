  rw [h1, h2, coordQHi_eq x]
lemma eps_form (x : Fin 100 → ℝ) :
    x ⬝ᵥ (Matrix.diagonal (fun _ => epsQ) *ᵥ x) = epsQ * ∑ i, x i ^ 2 := by
  rw [dotProduct, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Matrix.mulVec_diagonal]
  ring
theorem Wref_posSemidef_of_ldl (L : Matrix (Fin 100) (Fin 100) ℝ)
    (d : Fin 100 → ℝ) (dmin K : ℝ)
    (hA : Wref = L * Matrix.diagonal d * Lᵀ)
    (hmin : ∀ i, dmin ≤ d i) (hdmin : 0 < dmin) (hK : 0 < K)
    (hcond : ∀ x : Fin 100 → ℝ,
      ∑ i, x i ^ 2 ≤ K * ∑ i, ((Lᵀ *ᵥ x) i) ^ 2) :
    Wref.PosSemidef := by
  have h := LdlBridge.posSemidef_of_ldl_perturbation L d dmin K 0
    Wref (0 : Matrix (Fin 100) (Fin 100) ℝ) hA
    (by
      show (0 : Matrix (Fin 100) (Fin 100) ℝ)ᵀ = 0
      simp)
    hmin hdmin hK hcond
    (fun x => by simp [dotProduct_zero])
    (by rw [zero_mul]; exact hdmin)
  simpa [sub_zero] using h
lemma app_dotProduct_eq (x : Fin 100 → ℝ) :
    x ⬝ᵥ (Y7W5MarginDirect.APP (RHLean.endpoint 7) *ᵥ x)
      = ∑ i : Fin 100, ∑ j : Fin 100,
          x i * x j * Y7W5MarginDirect.APP (RHLean.endpoint 7) i j := by
  simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
  ring
theorem QFQHyp_of_ref (hW : Wref.PosSemidef) (hb : AppBridge) :
    Y7W5MarginDirect.QFQ_le_APP_eps (RHLean.endpoint 7) epsQ := by
  intro x
  have hnn : 0 ≤ x ⬝ᵥ (Wref *ᵥ x) :=
    Matrix.PosSemidef.dotProduct_mulVec_nonneg hW x
  unfold Wref at hnn
  rw [Matrix.sub_mulVec, Matrix.sub_mulVec, dotProduct_sub, dotProduct_sub] at hnn
  have hb1 : x ⬝ᵥ (APPref *ᵥ x)
      ≤ x ⬝ᵥ (Y7W5MarginDirect.APP (RHLean.endpoint 7) *ᵥ x) := hb x
  have hb2 : x ⬝ᵥ ((Y7W5MarginHi.QHi * Y7A3GramFloor.F * Y7W5MarginHi.QHiᵀ) *ᵥ x)
      = coordQHi x ⬝ᵥ (Y7A3GramFloor.F *ᵥ coordQHi x) := fq_form x
  have hb3 : x ⬝ᵥ (Matrix.diagonal (fun _ => epsQ) *ᵥ x)
      = epsQ * ∑ i, x i ^ 2 := eps_form x
  have hx := app_dotProduct_eq x
  linarith
theorem QFQHyp_of_ref' (hW : Wref.PosSemidef) (hb : AppBridge) : QFQHyp :=
  QFQHyp_of_ref hW hb
