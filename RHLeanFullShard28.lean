theorem tsum_Jm_lt_margin :
    (∑' m : ℕ, RHLean.GateII.Chain.Jm (m + 1))
      < 0.100317302 - 1 / 10 ^ 12 := by
  rw [RHLean.GateII.Chain.tsum_Jm]
  have hγ : ((577215664901531953 / 10 ^ 18 : ℚ) : ℝ)
      ≤ Real.eulerMascheroniConstant := Y7Chain.gamma_box.lo_le
  norm_num at hγ
  have hπ : (3.14159265358979323846 : ℝ) < Real.pi := Real.pi_gt_d20
  have hπ2 : (3.14159265358979323846 : ℝ) ^ 2 < Real.pi ^ 2 := by
    nlinarith [Real.pi_pos]
  nlinarith [hγ, hπ2]
theorem em_sum_lt_margin (L : ℝ) (hL : 15 ≤ L) (M : ℕ) (hM : 200 ≤ M)
    (hact : ∀ m ∈ Finset.Icc 201 M,
      Real.log 2.9 < L - Real.log ((m : ℝ) + 1)) :
    ∑ m ∈ Finset.Icc 1 M, RHLean.GateII.AWGC.Em L m
      < 0.259330618 - 1 / 1000 := by
  have hunion : Finset.Icc 1 M = Finset.Icc 1 200 ∪ Finset.Icc 201 M := by
    ext m
    simp only [Finset.mem_Icc, Finset.mem_union]
    omega
  have hdisj : Disjoint (Finset.Icc 1 200) (Finset.Icc 201 M) := by
    rw [Finset.disjoint_left]
    intro m hm1 hm2
    simp only [Finset.mem_Icc] at hm1 hm2
    omega
  rw [hunion, Finset.sum_union hdisj]
  have htail := RHLean.GateII.EmData.Em_Icc_tail_le_of (L := L) 201 M (by norm_num) hact
  have htail' : ∑ m ∈ Finset.Icc 201 M, RHLean.GateII.AWGC.Em L m ≤ 1 / 135 := by
    convert htail using 1
    norm_num
  have hfin := RHLean.GateII.EmData.finite_bound L hL
  have hnum : (RHLean.GateII.EmData.SnumLit : ℝ) / RHLean.GateII.EmData.D + 1 / 135
      < 0.259330618 - 1 / 1000 := by
    norm_num [RHLean.GateII.EmData.SnumLit, RHLean.GateII.EmData.D]
  linarith
theorem prime_part_arith_margin {L SJ SE : ℝ} (hL : 0 ≤ L)
    (hJ : SJ < 0.100317302 - 1 / 10 ^ 12)
    (hE : SE < 0.259330618 - 1 / 1000) :
    L * SJ + SE < 0.100317302 * L + 0.259330618 - 1 / 10 ^ 12 := by
  have h1 : L * SJ ≤ L * (0.100317302 - 1 / 10 ^ 12) := by
    rcases eq_or_lt_of_le hL with h | h
    · subst h
      simp
    · exact (mul_lt_mul_of_pos_left hJ h).le
  have h2 : L * (0.100317302 - 1 / 10 ^ 12) + (0.259330618 - 1 / 1000)
      ≤ 0.100317302 * L + 0.259330618 - 1 / 10 ^ 12 := by
    nlinarith [hL]
  linarith
theorem prime_part_sum_le_margin {k M : ℕ} (hk : 1 ≤ k) (hM : 200 ≤ M)
    (hL : 15 ≤ Real.log (k : ℝ))
    (ha : ∀ m ∈ Finset.Icc 1 M, 2.9 < (k : ℝ) / ((m : ℝ) + 1))
    (hMert : ∀ m ∈ Finset.Icc 1 M,
        ∀ t ∈ Set.Icc ((k : ℝ) / ((m : ℝ) + 1)) ((k : ℝ) / (m : ℝ)),
        |Chebyshev.theta t - t| ≤ Dm m * ((k : ℝ) / (m : ℝ)) / (La k m) ^ 2)
    (hact : ∀ m ∈ Finset.Icc 201 M,
        Real.log 2.9 < Real.log (k : ℝ) - Real.log ((m : ℝ) + 1)) :
    ∑ m ∈ Finset.Icc 1 M,
        (∑ p ∈ (Nat.primesLE ⌊(k : ℝ) / (m : ℝ)⌋₊).filter
            (fun p : ℕ => (k : ℝ) / ((m : ℝ) + 1) < (p : ℝ)),
          gpar (Lb k m / ((k : ℝ) / (m : ℝ))) (p : ℝ) * Real.log (p : ℝ))
      < 0.100317302 * Real.log (k : ℝ) + 0.259330618 - 1 / 10 ^ 12 := by
  have hbin : ∀ m ∈ Finset.Icc 1 M,
      (∑ p ∈ (Nat.primesLE ⌊(k : ℝ) / (m : ℝ)⌋₊).filter
          (fun p : ℕ => (k : ℝ) / ((m : ℝ) + 1) < (p : ℝ)),
        gpar (Lb k m / ((k : ℝ) / (m : ℝ))) (p : ℝ) * Real.log (p : ℝ))
      ≤ ((Lb k m - 1) ^ 2 / La k m) * Jm m + Em (Real.log (k : ℝ)) m :=
    fun m hm => prime_part_bin_le (Finset.mem_Icc.mp hm).1 hk (ha m hm) (hMert m hm)
  have hsum1 : (∑ m ∈ Finset.Icc 1 M,
        (∑ p ∈ (Nat.primesLE ⌊(k : ℝ) / (m : ℝ)⌋₊).filter
            (fun p : ℕ => (k : ℝ) / ((m : ℝ) + 1) < (p : ℝ)),
          gpar (Lb k m / ((k : ℝ) / (m : ℝ))) (p : ℝ) * Real.log (p : ℝ)))
      ≤ (∑ m ∈ Finset.Icc 1 M, ((Lb k m - 1) ^ 2 / La k m) * Jm m)
        + ∑ m ∈ Finset.Icc 1 M, Em (Real.log (k : ℝ)) m := by
    simpa [Finset.sum_add_distrib] using Finset.sum_le_sum hbin
  have hJpart : (∑ m ∈ Finset.Icc 1 M, ((Lb k m - 1) ^ 2 / La k m) * Jm m)
      ≤ Real.log (k : ℝ) * ∑ m ∈ Finset.Icc 1 M, Jm m := by
    calc (∑ m ∈ Finset.Icc 1 M, ((Lb k m - 1) ^ 2 / La k m) * Jm m)
        ≤ ∑ m ∈ Finset.Icc 1 M, Real.log (k : ℝ) * Jm m :=
          Finset.sum_le_sum fun m hm =>
            Lb_sub_one_sq_div_La_mul_Jm_le (Finset.mem_Icc.mp hm).1 (ha m hm) hL
      _ = Real.log (k : ℝ) * ∑ m ∈ Finset.Icc 1 M, Jm m :=
          (Finset.mul_sum (Finset.Icc 1 M) Jm (Real.log (k : ℝ))).symm
  have hJtot : (∑ m ∈ Finset.Icc 1 M, Jm m) < 0.100317302 - 1 / 10 ^ 12 :=
    lt_of_le_of_lt (sum_Icc_Jm_le_tsum M) tsum_Jm_lt_margin
  have hEtot := em_sum_lt_margin (Real.log (k : ℝ)) hL M hM hact
  have hfin : Real.log (k : ℝ) * (∑ m ∈ Finset.Icc 1 M, Jm m)
        + ∑ m ∈ Finset.Icc 1 M, Em (Real.log (k : ℝ)) m
      < 0.100317302 * Real.log (k : ℝ) + 0.259330618 - 1 / 10 ^ 12 :=
    prime_part_arith_margin (log_k_nonneg hL) hJtot hEtot
  calc (∑ m ∈ Finset.Icc 1 M,
        (∑ p ∈ (Nat.primesLE ⌊(k : ℝ) / (m : ℝ)⌋₊).filter
            (fun p : ℕ => (k : ℝ) / ((m : ℝ) + 1) < (p : ℝ)),
