theorem exists_poly_uniform_approx_on_Icc (a b : ℝ) (f : ℝ → ℝ)
    (hf : Continuous f) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : Polynomial ℝ, ∀ x ∈ Set.Icc a b, |p.eval x - f x| ≤ ε := by
  set B := max |a| |b| with hBdef
  obtain ⟨p, hp⟩ := Y7Density.exists_poly_uniform_approx_real (f := f) hf (b := B) hε
  refine ⟨p, fun x hx => hp x ?_⟩
  rw [Set.mem_Icc, hBdef]
  constructor <;> linarith
    [le_max_left |a| |b|, le_max_right |a| |b|,
     le_abs_self a, le_abs_self b, neg_abs_le a, neg_abs_le b, hx.1, hx.2]
