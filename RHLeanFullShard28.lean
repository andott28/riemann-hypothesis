  exact hb x hx
theorem admissible_gamma_inner_field (a : ℝ) (h g : ℝ → ℂ) (B : ℝ)
    (ha : 0 ≤ a) (cg : Continuous g)
    (bg : ∀ y ∈ Set.Ioo (-a) a, ‖g y‖ ≤ B) :
    ∀ x : ℝ, IntegrableOn (fun y : ℝ =>
        RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re)
      (Set.Ioo (-a) a) volume := by
  intro x
  set M := |x| + a with hMdef
  set K := Real.exp M / 2 + Real.exp (M / 2) / 4 with hKdef
  have hM0 : 0 ≤ M := by positivity
  have hK0 : 0 ≤ K := by positivity
  apply integrableOn_bound_Ioo_of_measurable a _ (‖h x‖ * K * B)
  · have hker : Measurable (fun y : ℝ => RHLean.gammaKernel ‖x - y‖) :=
      RHLean.GateII.Collar.measurable_gammaKernel.comp (by fun_prop)
    have hcont : Continuous (fun y : ℝ => (h x * star (g y)).re) := by fun_prop
    exact hker.mul hcont.measurable
  · intro y hy
    have hyn : ‖y‖ ≤ a := by
      rw [Real.norm_eq_abs, abs_le]
      exact ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hdist : ‖x - y‖ ≤ M := by
      rw [hMdef]
      calc ‖x - y‖ ≤ ‖x‖ + ‖y‖ := norm_sub_le x y
        _ = |x| + ‖y‖ := by rw [Real.norm_eq_abs]
        _ ≤ |x| + a := add_le_add (le_refl |x|) hyn
    have hker : |RHLean.gammaKernel ‖x - y‖| ≤ K := by
      rw [hKdef]
      exact RHLean.GateII.Collar.gammaKernel_abs_le hM0 (Set.mem_Icc.mpr ⟨norm_nonneg _, hdist⟩)
    have hre : |(h x * star (g y)).re| ≤ ‖h x‖ * B := by
      calc |(h x * star (g y)).re| ≤ ‖h x * star (g y)‖ := Complex.abs_re_le_norm _
        _ = ‖h x‖ * ‖g y‖ := by rw [norm_mul, norm_star]
        _ ≤ ‖h x‖ * B := mul_le_mul_of_nonneg_left (bg y hy) (norm_nonneg (h x))
    calc ‖RHLean.gammaKernel ‖x - y‖ * (h x * star (g y)).re‖
        = |RHLean.gammaKernel ‖x - y‖| * |(h x * star (g y)).re| := by
            rw [Real.norm_eq_abs, abs_mul]
      _ ≤ K * |(h x * star (g y)).re| := mul_le_mul_of_nonneg_right hker (abs_nonneg _)
      _ ≤ K * (‖h x‖ * B) := mul_le_mul_of_nonneg_left hre hK0
      _ = ‖h x‖ * K * B := by ring
