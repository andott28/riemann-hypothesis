noncomputable def APP0 (a : ℝ) : Matrix (Fin 100) (Fin 100) ℝ :=
  fun i j =>
    (Y7W5MarginDirect.modelM a i j - (if i = j then RHLean.c0 a else 0))
      - (a - 1) * Y7W5MarginDirect.gammaModelM a i j
theorem APP_eq_APP0_add (a : ℝ) :
    Y7W5MarginDirect.APP a
      = APP0 a + RHLean.c0 a • (1 : Matrix (Fin 100) (Fin 100) ℝ) := by
  ext i j
  simp only [Y7W5MarginDirect.APP, APP0, Matrix.sub_apply, Matrix.add_apply,
    Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  by_cases h : i = j <;> simp [h] <;> ring
theorem dot_smul_one (c : ℝ) (x : Fin 100 → ℝ) :
    x ⬝ᵥ ((c • (1 : Matrix (Fin 100) (Fin 100) ℝ)) *ᵥ x) = c * ∑ i, x i ^ 2 := by
  rw [Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul, Matrix.one_mulVec,
    dotProduct]
  congr 1
  exact Finset.sum_congr rfl (fun i _ => by ring)
def QFQc (a c eps : ℝ) : Prop :=
  ∀ x : Fin 100 → ℝ,
    coordQHi x ⬝ᵥ (Y7A3GramFloor.F *ᵥ coordQHi x) + eps * (∑ i, x i ^ 2)
      ≤ x ⬝ᵥ ((APP0 a + c • (1 : Matrix (Fin 100) (Fin 100) ℝ)) *ᵥ x)
lemma dot_eq_sum (M : Matrix (Fin 100) (Fin 100) ℝ) (x : Fin 100 → ℝ) :
    x ⬝ᵥ (M *ᵥ x) = ∑ i, ∑ j, x i * x j * M i j := by
  simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
  ring
theorem QFQc_iff (a eps : ℝ) :
    QFQc a (RHLean.c0 a) eps ↔ Y7W5MarginDirect.QFQ_le_APP_eps a eps := by
  have hsum : ∀ x : Fin 100 → ℝ,
      x ⬝ᵥ ((APP0 a + RHLean.c0 a • (1 : Matrix (Fin 100) (Fin 100) ℝ)) *ᵥ x)
        = ∑ i, ∑ j, x i * x j * Y7W5MarginDirect.APP a i j := by
    intro x
    rw [← APP_eq_APP0_add a]
    exact dot_eq_sum _ x
  constructor
  · intro h x
    rw [← hsum x]
    exact h x
  · intro h x
    rw [hsum x]
    exact h x
theorem QFQ_le_APP_eps_of_shift {a eps c : ℝ} (hc : c ≤ RHLean.c0 a)
    (h : QFQc a c (eps + (RHLean.c0 a - c))) :
    Y7W5MarginDirect.QFQ_le_APP_eps a eps := by
  rw [← QFQc_iff]
  intro x
  have hx := h x
  have hsplit : x ⬝ᵥ ((APP0 a + c • (1 : Matrix (Fin 100) (Fin 100) ℝ)) *ᵥ x)
      = x ⬝ᵥ (APP0 a *ᵥ x) + c * ∑ i, x i ^ 2 := by
    rw [Matrix.add_mulVec, dotProduct_add, dot_smul_one]
  have hAPP : x ⬝ᵥ ((APP0 a + RHLean.c0 a • (1 : Matrix (Fin 100) (Fin 100) ℝ)) *ᵥ x)
      = x ⬝ᵥ (APP0 a *ᵥ x) + RHLean.c0 a * ∑ i, x i ^ 2 := by
    rw [Matrix.add_mulVec, dotProduct_add, dot_smul_one]
  rw [hsplit] at hx
  rw [hAPP]
  have hs : 0 ≤ ∑ i, x i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg (x i))
  nlinarith [hx, hs, hc]
theorem QFQHyp_of_c0_lower (c : ℝ) (hc : c ≤ RHLean.c0 (RHLean.endpoint 7))
    (h : QFQc (RHLean.endpoint 7) c
      (1 / 10 ^ 26 + (RHLean.c0 (RHLean.endpoint 7) - c))) :
    Y7W5MarginDirect.QFQ_le_APP_eps (RHLean.endpoint 7) (1 / 10 ^ 26) :=
  QFQ_le_APP_eps_of_shift hc h
end
end
