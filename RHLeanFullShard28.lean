theorem admissible_shift_first_field (a : ℝ) (h g : ℝ → ℂ) (Bh Bg : ℝ)
    (ch : Continuous h) (cg : Continuous g)
    (bh : ∀ y : ℝ, ‖h y‖ ≤ Bh) (bg : ∀ y : ℝ, ‖g y‖ ≤ Bg) :
    ∀ n ∈ RHLean.arithSupport a, IntegrableOn
      (fun x : ℝ => h x * star (g (x + RHLean.shiftLength n)))
      (Set.Ioo (-a) a) volume := by
  intro n hn
  apply integrableOn_bound_Ioo_clm a _ (Bh * Bg)
  · fun_prop
  · intro x hx
    calc ‖h x * star (g (x + RHLean.shiftLength n))‖
        = ‖h x‖ * ‖g (x + RHLean.shiftLength n)‖ := by rw [norm_mul, norm_star]
      _ ≤ Bh * Bg := by
        nlinarith [bh x, bg (x + RHLean.shiftLength n), norm_nonneg (h x),
