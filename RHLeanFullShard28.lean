      have h1 : ‖∫ x in Set.Ioo (-a) a, ∫ y in Set.Ioo (-a) a,
          RHLean.gammaKernel ‖x - y‖ * (w x * star (h y)).re‖
          ≤ ∫ x in Set.Ioo (-a) a, ‖∫ y in Set.Ioo (-a) a,
