section Inline_ExplicitFormula_RH13
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
noncomputable def autocorr (f : ℝ → ℂ) (u : ℝ) : ℂ :=
  ∫ x : ℝ, f (x + u) * star (f x)
theorem star_transf_neg_star {f : ℝ → ℂ} (z : ℂ) :
    star (transf f (-(star z)))
      = ∫ x : ℝ, star (f x) * Complex.exp (-(z * (x : ℂ))) := by
  rw [transf]
  rw [show star (∫ x : ℝ, f x * Complex.exp ((-(star z)) * (x : ℂ)))
      = (starRingEnd ℂ) (∫ x : ℝ, f x * Complex.exp ((-(star z)) * (x : ℂ)))
      from starRingEnd_apply _]
  rw [← integral_conj (μ := volume) (𝕜 := ℂ)]
  apply integral_congr_ae
  filter_upwards with x
  have hx : star (x : ℂ) = (x : ℂ) := by
    rw [RCLike.star_def, Complex.conj_ofReal]
  have hw : star ((-(star z)) * (x : ℂ)) = -(z * (x : ℂ)) := by
    rw [star_mul, star_neg, star_star, hx]
    ring
  have hgoal : (starRingEnd ℂ) (f x * Complex.exp ((-(star z)) * (x : ℂ)))
      = star (f x) * Complex.exp (-(z * (x : ℂ))) := by
    rw [map_mul, ← Complex.exp_conj]
    simp only [starRingEnd_apply]
    rw [hw]
  exact hgoal
theorem transf_autocorr {f : ℝ → ℂ} (hf : Continuous f) (hs : HasCompactSupport f) (z : ℂ) :
    transf (autocorr f) z = transf f z * star (transf f (-(star z))) := by
  obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_closedBall (0 : ℝ)).mp hs.isCompact.isBounded
  have hcont : Continuous (fun p : ℝ × ℝ =>
      f (p.2 + p.1) * star (f p.2) * Complex.exp (z * (p.1 : ℂ))) := by
    refine (((hf.comp (continuous_snd.add continuous_fst)).mul
      (continuous_star.comp (hf.comp continuous_snd))).mul ?_)
    exact Complex.continuous_exp.comp (continuous_const.mul
      (Complex.continuous_ofReal.comp continuous_fst))
  have hsupp : Function.support (fun p : ℝ × ℝ =>
      f (p.2 + p.1) * star (f p.2) * Complex.exp (z * (p.1 : ℂ)))
      ⊆ Metric.closedBall (0 : ℝ × ℝ) (3 * max R 0 + 1) := by
    intro p hp
    have h1 : f (p.2 + p.1) ≠ 0 := by
      intro h
      apply hp
      simp [h]
    have h2 : f p.2 ≠ 0 := by
      intro h
      apply hp
      simp [h]
    have hb1 : |p.2 + p.1| ≤ R := by
      have := hR (subset_tsupport f h1)
      simpa [Metric.mem_closedBall, Real.dist_eq] using this
    have hb2 : |p.2| ≤ R := by
      have := hR (subset_tsupport f h2)
      simpa [Metric.mem_closedBall, Real.dist_eq] using this
    have hb1' : |p.1| ≤ 2 * max R 0 := by
      have h : p.1 = (p.2 + p.1) + (-p.2) := by ring
      have hle : |p.1| ≤ 2 * R := by
        calc |p.1| = |(p.2 + p.1) + (-p.2)| := by rw [← h]
          _ ≤ |p.2 + p.1| + |-p.2| := abs_add_le _ _
          _ = |p.2 + p.1| + |p.2| := by rw [abs_neg]
          _ ≤ R + R := add_le_add hb1 hb2
          _ = 2 * R := by ring
      nlinarith [hle, le_max_left R 0]
    have hb2' : |p.2| ≤ 2 * max R 0 := by
      nlinarith [hb2, le_max_left R 0, le_max_right R 0]
    have hmax0 : 0 ≤ max R 0 := le_max_right R 0
    have hnorm : ‖p‖ ≤ 3 * max R 0 + 1 := by
      rw [Prod.norm_def]
      refine max_le ?_ ?_
      · have h1'' : ‖p.1‖ ≤ 2 * max R 0 := by simpa [Real.norm_eq_abs] using hb1'
        nlinarith
      · have h2'' : ‖p.2‖ ≤ 2 * max R 0 := by simpa [Real.norm_eq_abs] using hb2'
        nlinarith
    simpa [Metric.mem_closedBall, dist_eq_norm] using hnorm
  have hint : Integrable (fun p : ℝ × ℝ =>
      f (p.2 + p.1) * star (f p.2) * Complex.exp (z * (p.1 : ℂ))) (volume.prod volume) :=
    hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall _ _) hsupp)
  have hR : transf f z * star (transf f (-(star z)))
      = (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ)))
        * ∫ x : ℝ, star (f x) * Complex.exp (-(z * (x : ℂ))) := by
    rw [transf, star_transf_neg_star]
  rw [hR, transf]
  have hpush : (∫ u : ℝ, autocorr f u * Complex.exp (z * (u : ℂ)))
      = ∫ u : ℝ, ∫ x : ℝ, (f (x + u) * star (f x)) * Complex.exp (z * (u : ℂ)) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [autocorr, MeasureTheory.integral_mul_const]
  rw [hpush, MeasureTheory.integral_integral_swap hint]
  have hinner : ∀ x : ℝ, (∫ u : ℝ, (f (x + u) * star (f x)) * Complex.exp (z * (u : ℂ)))
      = (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ)))
        * (star (f x) * Complex.exp (-(z * (x : ℂ)))) := by
    intro x
    have htrans : (∫ u : ℝ, f (x + u) * Complex.exp (z * (u : ℂ)))
        = ∫ y : ℝ, f y * Complex.exp (z * ((y : ℂ) - (x : ℂ))) := by
      have h := MeasureTheory.integral_add_right_eq_self (μ := volume)
        (fun y : ℝ => f y * Complex.exp (z * ((y : ℂ) - (x : ℂ)))) x
      rw [← h]
      apply integral_congr_ae
      filter_upwards with u
      have harg' : z * ((((u : ℝ) + x : ℝ) : ℂ) - (x : ℂ)) = z * (u : ℂ) := by
        push_cast
        ring
      rw [add_comm x u]
      rw [harg']
    have hsplit : (∫ y : ℝ, f y * Complex.exp (z * ((y : ℂ) - (x : ℂ))))
        = Complex.exp (-(z * (x : ℂ))) * (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ))) := by
      rw [← MeasureTheory.integral_const_mul]
      apply integral_congr_ae
      filter_upwards with y
      rw [show z * ((y : ℂ) - (x : ℂ)) = z * (y : ℂ) + (-(z * (x : ℂ))) by ring,
        Complex.exp_add]
      ring
    have hmul : (∫ u : ℝ, (f (x + u) * star (f x)) * Complex.exp (z * (u : ℂ)))
        = star (f x) * ∫ u : ℝ, f (x + u) * Complex.exp (z * (u : ℂ)) := by
      have hpt : (∫ u : ℝ, (f (x + u) * star (f x)) * Complex.exp (z * (u : ℂ)))
          = ∫ u : ℝ, star (f x) * (f (x + u) * Complex.exp (z * (u : ℂ))) :=
        integral_congr_ae (Eventually.of_forall fun u => by ring)
      rw [hpt, MeasureTheory.integral_const_mul]
    rw [hmul, htrans, hsplit]
    ring
  have hcongr : (∫ x : ℝ, ∫ u : ℝ, (f (x + u) * star (f x)) * Complex.exp (z * (u : ℂ)))
      = ∫ x : ℝ, (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ)))
          * (star (f x) * Complex.exp (-(z * (x : ℂ)))) :=
    integral_congr_ae (Eventually.of_forall hinner)
  rw [hcongr]
  have hfactor : (∫ x : ℝ, (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ)))
        * (star (f x) * Complex.exp (-(z * (x : ℂ)))))
      = (∫ y : ℝ, f y * Complex.exp (z * (y : ℂ)))
        * ∫ x : ℝ, star (f x) * Complex.exp (-(z * (x : ℂ))) := by
    rw [MeasureTheory.integral_const_mul]
  rw [hfactor]
theorem transf_autocorr_one_half {f : ℝ → ℂ} (hf : Continuous f)
    (hs : HasCompactSupport f) (hodd : ∀ x, f (-x) = -f x) :
    transf (autocorr f) (1 / 2)
      = -(transf f (1 / 2)) * star (transf f (1 / 2)) := by
  have hst : star (1 / 2 : ℂ) = 1 / 2 := by
    rw [show (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) by norm_num, RCLike.star_def,
      Complex.conj_ofReal]
  have harg : -(star (1 / 2 : ℂ)) = -(1 / 2 : ℂ) := by rw [hst]
  rw [transf_autocorr hf hs (1 / 2), harg, transf_neg_arg hodd (1 / 2), star_neg]
  ring
theorem polarForm_eq_neg_two_transf_autocorr {a : ℝ} {f : ℝ → ℂ}
    (hf : Continuous f) (hs : HasCompactSupport f) (hodd : ∀ x, f (-x) = -f x)
    (hpi : polarInner a f = transf f (1 / 2)) :
    polarForm a f = -2 * (transf (autocorr f) (1 / 2)).re := by
  have hnorm : (polarInner a f * star (polarInner a f)).re = ‖polarInner a f‖ ^ 2 := by
    rw [← Complex.normSq_eq_norm_sq]
    simpa using congrArg Complex.re (Complex.mul_conj (polarInner a f))
  rw [transf_autocorr_one_half hf hs hodd, ← hpi]
  have hneg : (-polarInner a f * star (polarInner a f)).re
      = -(polarInner a f * star (polarInner a f)).re := by
    rw [neg_mul, Complex.neg_re]
  rw [hneg, hnorm]
  unfold polarForm
  ring
def PolarInnerTransfIdentity : Prop :=
  ∀ a : ℝ, ∀ f : ℝ → ℂ, f ∈ localizedCore a → polarInner a f = transf f (1 / 2)
end RHLean.ExplicitFormula
