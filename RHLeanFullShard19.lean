namespace RHLean.ZhuBase
open RHLean
def ZhuWindowPositivity : Prop := LocalPSD (0.8 : ℝ)
theorem endpoint_four_le : endpoint 4 ≤ (0.8 : ℝ) := by
  unfold endpoint
  have h4 : Real.log ((4 : ℕ) : ℝ) = 2 * Real.log 2 := by
    rw [show ((4 : ℕ) : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    push_cast
    ring
  rw [h4]
  have h2 : Real.log 2 < 0.7 := lt_trans Real.log_two_lt_d9 (by norm_num)
  linarith
