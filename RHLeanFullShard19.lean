theorem rectangleResidueLimit_of_summable {h : ℂ → ℂ} (hh : Differentiable ℂ h)
    (hsum : Summable (fun p : XiZero => h (centeredZero p))) {Z W : ℕ → ℂ}
    (horder : ∀ n, (Z n).re < (W n).re) (him : ∀ n, (Z n).im < (W n).im)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (Z n) (W n) → centeredZero p ∈ rectOpen (Z n) (W n))
    (hfin : ∀ n, ({p : XiZero | centeredZero p ∈ rectOpen (Z n) (W n)} : Set XiZero).Finite)
    (hcofinal : ∀ p : XiZero, ∃ N, ∀ n ≥ N, centeredZero p ∈ rectOpen (Z n) (W n)) :
    Tendsto (fun n => rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) (Z n) (W n)) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, h (centeredZero p))) := by
  have hzero := tendsto_rectangleZeroSum hsum hfin hcofinal
  have hFin : ∀ n, rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) (Z n) (W n) =
      2 * (Real.pi : ℂ) * I * rectangleZeroSum (Z n) (W n) h :=
    fun n => rectangleResidueIdentityFinite h hh (Z n) (W n) (horder n) (him n)
      (hbd n) (hfin n)
  have hconst : Tendsto (fun n => 2 * (Real.pi : ℂ) * I * rectangleZeroSum (Z n) (W n) h)
      atTop (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, h (centeredZero p))) :=
    tendsto_const_nhds.mul hzero
  refine hconst.congr' ?_
  filter_upwards with n
  exact (hFin n).symm
theorem differentiable_transf_autocorr {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Differentiable ℂ (transf (autocorr f)) :=
  differentiable_transf (contDiff_autocorr hf) (hasCompactSupport_autocorr hf)
theorem summable_transf_autocorr' {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Summable (fun p : XiZero => transf (autocorr f) (centeredZero p)) :=
  summable_transf_autocorr hf
theorem rectangleResidueLimit_autocorr {f : ℝ → ℂ} (hf : f ∈ oddCore)
    {T : ℕ → ℝ} (hT : Tendsto T atTop atTop) (hTpos : ∀ n, 0 < T n)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (stripLeft (T n)) (stripRight (T n)) →
        centeredZero p ∈ rectOpen (stripLeft (T n)) (stripRight (T n))) :
    Tendsto (fun n => rectangleBoundaryIntegral
        (fun u => transf (autocorr f) u * logDeriv riemannXi ((1 / 2 : ℂ) + u))
        (stripLeft (T n)) (stripRight (T n))) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, transf (autocorr f) (centeredZero p))) := by
  refine rectangleResidueLimit_of_summable (differentiable_transf_autocorr hf)
    (summable_transf_autocorr hf) (Z := fun n => stripLeft (T n))
    (W := fun n => stripRight (T n)) ?_ ?_ hbd ?_ ?_
  · intro n
    rw [stripLeft_re, stripRight_re]
    norm_num
  · intro n
    rw [stripLeft_im, stripRight_im]
    linarith [hTpos n]
  · intro n
    exact finite_centeredZero_mem_rectOpen _ _
  · intro p
    have hM : ∀ᶠ n in atTop, |(centeredZero p).im| < T n := by
      have h1 : ∀ᶠ n in atTop, |(centeredZero p).im| + 1 ≤ T n :=
        tendsto_atTop.mp hT _
      filter_upwards [h1] with n hn
      linarith
    obtain ⟨N, hN⟩ := eventually_atTop.mp hM
    refine ⟨N, fun n hn => ?_⟩
    have hre : -(1 / 2 : ℝ) < (centeredZero p).re ∧ (centeredZero p).re < 1 / 2 := by
      have hp := val_re_mem_Ioo p
      have h : (centeredZero p).re =
          (Complex.Hadamard.divisorZeroIndex₀_val p).re - 1 / 2 := by
        rw [centeredZero, Complex.sub_re]
        norm_num
      rw [h]
      exact ⟨by linarith [hp.1], by linarith [hp.2]⟩
    rw [rectOpen, stripLeft_re, stripLeft_im, stripRight_re, stripRight_im]
    refine ⟨?_, ?_, ?_, ?_⟩
    · have h := hre.1
      linarith [min_le_left (-1 / 2 : ℝ) (1 / 2)]
    · have h := hre.2
      linarith [le_max_right (-1 / 2 : ℝ) (1 / 2)]
    · have h := (abs_lt.mp (hN n hn)).1
      linarith [min_le_left (-(T n)) (T n)]
    · have h := (abs_lt.mp (hN n hn)).2
      linarith [le_max_right (-(T n)) (T n)]
theorem transf_autocorr_even {f : ℝ → ℂ} (hf : f ∈ oddCore) (u : ℂ) :
    transf (autocorr f) (-u) = transf (autocorr f) u :=
  transf_autocorr_neg hf.1.continuous hf.2.1 hf.2.2 u
theorem stripBoundaryIntegral_autocorr_decomposition {f : ℝ → ℂ} (hf : f ∈ oddCore)
    (T : ℝ) :
    rectangleBoundaryIntegral (xiLogIntegrand (transf (autocorr f)))
        (stripLeft T) (stripRight T)
      = -(2 * stripTopIntegral (transf (autocorr f)) T)
        + 2 * I * stripRightIntegral (transf (autocorr f)) T :=
  stripBoundaryIntegral_even_decomposition (transf_autocorr_even hf) T
