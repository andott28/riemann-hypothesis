          · exact hdec.trans (div_le_div_of_nonneg_left hD0 (by positivity) hden)
          · positivity
      _ = D * (C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 3) := by ring
  have hInt := intervalIntegral.norm_integral_le_of_norm_le_const
    (f := fun x : ℝ => xiLogIntegrand h ((x : ℂ) + (T : ℂ) * I))
    (a := -(1 / 2 : ℝ)) (b := 1 / 2)
