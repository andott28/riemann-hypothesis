    linarith
  have hu_dist : ‖u - lam‖ < δ := by
    rw [hu_sub, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr0]
    exact hrδ
  obtain ⟨heq_u, hGu⟩ := hδ u hu_dist hu_ne
  have hnorm_div : ‖(m : ℂ) / (u - lam)‖ = (m : ℝ) / r := by
    rw [hu_sub, norm_div, Complex.norm_natCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr0]
  have hr_le : M + D + 1 ≤ (m : ℝ) / r := by
    rw [le_div_iff₀ hr0]
    have h1 : r < (m : ℝ) / (M + D + 1) := hr3
    have hlt : r * (M + D + 1) < (m : ℝ) := by
      rwa [lt_div_iff₀ hden] at h1
