section Inline_ExplicitFormula_RH14
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
theorem polarInner_eq_transf_half {a : ℝ} {f : ℝ → ℂ}
    (hf : Continuous f) (hodd : ∀ x, f (-x) = -f x) (ha : 0 ≤ a)
    (hsupp : Function.support f ⊆ Set.Ioo (-a) a) :
    polarInner a f = transf f (1 / 2) := by
  have hsinh (y : ℝ) : star (sph y) * f y
      = ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y := by
    unfold sph
    rw [RCLike.star_def, Complex.conj_ofReal, Real.sinh_eq]
    push_cast
    ring
  have h1 : polarInner a f
      = ∫ y in Set.Ioo (-a) a,
          ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y := by
    unfold polarInner
    apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioo
    intro y _
    exact hsinh y
  have hcont1 : Continuous (fun y : ℝ => f y * Complex.exp ((y : ℂ) / 2)) := by
    refine hf.mul ?_
    exact Complex.continuous_exp.comp (Complex.continuous_ofReal.div_const 2)
  have hcont2 : Continuous (fun y : ℝ => f y * Complex.exp (-((y : ℂ) / 2))) := by
    refine hf.mul ?_
    exact Complex.continuous_exp.comp ((Complex.continuous_ofReal.div_const 2).neg)
  have hsplit : (∫ y in (-a)..a,
        ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y)
      = (1 / 2) * (∫ y in (-a)..a, f y * Complex.exp ((y : ℂ) / 2))
        - (1 / 2) * (∫ y in (-a)..a, f y * Complex.exp (-((y : ℂ) / 2))) := by
    have hpt : (∫ y in (-a)..a,
          ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y)
        = ∫ y in (-a)..a,
            ((1 / 2) * (f y * Complex.exp ((y : ℂ) / 2))
              - (1 / 2) * (f y * Complex.exp (-((y : ℂ) / 2)))) := by
      apply intervalIntegral.integral_congr
      intro y _
      ring
    rw [hpt, intervalIntegral.integral_sub
      ((hcont1.const_mul (1 / 2 : ℂ)).intervalIntegrable _ _)
      ((hcont2.const_mul (1 / 2 : ℂ)).intervalIntegrable _ _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  have hodd_int : (∫ y in (-a)..a, f y * Complex.exp (-((y : ℂ) / 2)))
      = -(∫ y in (-a)..a, f y * Complex.exp ((y : ℂ) / 2)) := by
    have hcomp := intervalIntegral.integral_comp_neg
      (f := fun y : ℝ => f y * Complex.exp (-((y : ℂ) / 2))) (a := -a) (b := a)
    simp only [neg_neg] at hcomp
    have hpt : ∀ y : ℝ, f (-y) * Complex.exp (-(((-y : ℝ) : ℂ) / 2))
        = -(f y * Complex.exp ((y : ℂ) / 2)) := by
      intro y
      rw [hodd y]
      have harg : -(((-y : ℝ) : ℂ) / 2) = (y : ℂ) / 2 := by push_cast; ring
      rw [harg]
      ring
    calc (∫ y in (-a)..a, f y * Complex.exp (-((y : ℂ) / 2)))
        = ∫ y in (-a)..a, f (-y) * Complex.exp (-(((-y : ℝ) : ℂ) / 2)) := hcomp.symm
      _ = ∫ y in (-a)..a, -(f y * Complex.exp ((y : ℂ) / 2)) := by
          apply intervalIntegral.integral_congr
          intro y _
          exact hpt y
      _ = -(∫ y in (-a)..a, f y * Complex.exp ((y : ℂ) / 2)) :=
          intervalIntegral.integral_neg
  have htransf : transf f (1 / 2) = ∫ y in (-a)..a, f y * Complex.exp ((y : ℂ) / 2) := by
    rw [transf]
    have harg : ∀ y : ℝ, (1 / 2 : ℂ) * (y : ℂ) = (y : ℂ) / 2 := by intro y; ring
    simp only [harg]
    have hsupp_eq : (∫ y : ℝ, f y * Complex.exp ((y : ℂ) / 2))
        = ∫ y : ℝ, (Set.Ioo (-a) a).indicator
            (fun y : ℝ => f y * Complex.exp ((y : ℂ) / 2)) y := by
      apply integral_congr_ae
      filter_upwards with y
      by_cases hy : y ∈ Set.Ioo (-a) a
      · rw [Set.indicator_of_mem hy]
      · rw [Set.indicator_of_notMem hy]
        have hfy : f y = 0 := by
          by_contra h
          exact hy (hsupp h)
        rw [hfy, zero_mul]
    rw [hsupp_eq, MeasureTheory.integral_indicator measurableSet_Ioo]
    exact ((intervalIntegral.integral_of_le (by linarith)).trans
      MeasureTheory.integral_Ioc_eq_integral_Ioo).symm
  have h2 : (∫ y in Set.Ioo (-a) a,
        ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y)
      = ∫ y in (-a)..a,
          ((Complex.exp ((y : ℂ) / 2) - Complex.exp (-((y : ℂ) / 2))) / 2) * f y :=
    ((intervalIntegral.integral_of_le (by linarith)).trans
      MeasureTheory.integral_Ioc_eq_integral_Ioo).symm
  rw [h1, h2, htransf, hsplit, hodd_int]
  ring
theorem polarInnerTransfIdentity_proof : PolarInnerTransfIdentity := by
  intro a f hf
  by_cases ha : 0 ≤ a
  · exact polarInner_eq_transf_half hf.1.1.continuous hf.1.2.2 ha hf.2
  · have hneg : a < 0 := lt_of_not_ge ha
    have hfzero : f = 0 := by
      funext x
      by_contra hx
      have h2 := hf.2 (show x ∈ Function.support f from hx)
      rw [Set.mem_Ioo] at h2
      linarith [h2.1, h2.2]
    rw [hfzero]
    simp [polarInner]
theorem polarForm_eq_neg_two_transf_autocorr' {a : ℝ} {f : ℝ → ℂ}
    (hf : f ∈ localizedCore a) :
    polarForm a f = -2 * (transf (autocorr f) (1 / 2)).re :=
  polarForm_eq_neg_two_transf_autocorr hf.1.1.continuous hf.1.2.1 hf.1.2.2
    (polarInnerTransfIdentity_proof a f hf)
theorem transf_autocorr_eq_neg_sq {f : ℝ → ℂ} (hf : Continuous f)
    (hs : HasCompactSupport f) (hodd : ∀ x, f (-x) = -f x)
    (hreal : ∀ x, star (f x) = f x) (z : ℂ) :
    transf (autocorr f) z = -(transf f z) ^ 2 := by
  rw [transf_autocorr hf hs z, transf_neg_arg hodd (star z), star_neg,
    transf_conj hreal z, star_star]
  ring
theorem weilOdd_eq_tsum_transf_autocorr {f : ℝ → ℂ} (hf : Continuous f)
    (hs : HasCompactSupport f) :
    weilOdd f = (∑' p : XiZero, transf (autocorr f) (centeredZero p)).re := by
  rw [weilOdd]
  congr 1
  exact tsum_congr fun p => (transf_autocorr hf hs (centeredZero p)).symm
theorem weil_summand_eq_transf_autocorr {f : ℝ → ℂ} (hf : Continuous f)
    (hs : HasCompactSupport f) (p : XiZero) :
    transf f (centeredZero p) * star (transf f (-(star (centeredZero p))))
      = transf (autocorr f) (centeredZero p) :=
  (transf_autocorr hf hs (centeredZero p)).symm
end RHLean.ExplicitFormula
end
