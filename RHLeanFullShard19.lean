  have hmax := hc.2.1
  rw [h] at hmin hmax
  rcases min_choice z.re c.re with hm | hm
  · rw [hm] at hmin
    have hz : z.re < c.re := hmin
    rcases max_choice z.re c.re with hM | hM
    · rw [hM] at hmax
      exact not_lt.mpr hz.le hmax
    · rw [hM] at hmax
      exact lt_irrefl _ hmax
  · rw [hm] at hmin
    exact lt_irrefl _ hmin
