  refine hF.comp (continuous_edgeLeft z w).continuousOn ?_
  intro y hy
  exact edgeLeft_mem_rectBoundary z w hzr hzi (by simpa [Set.uIcc_of_le hzi.le] using hy)
noncomputable def hadamardSummandValue (h : ℂ → ℂ) (z w : ℂ) (p : XiZero) : ℂ := by
  classical
  exact if centeredZero p ∈ rectOpen z w then
    2 * (Real.pi : ℂ) * I * h (centeredZero p) else 0
theorem rectangleBoundaryIntegral_hadamardSummand (h : ℂ → ℂ) (hh : Differentiable ℂ h)
    {z w : ℂ} (hzr : z.re < w.re) (hzi : z.im < w.im)
    (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w)
    (p : XiZero) :
    rectangleBoundaryIntegral
        (fun u => h u *
          (1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)) z w =
      hadamardSummandValue h z w p := by
  rw [hadamardSummandValue]
  have hne : ∀ u ∈ rectBoundary z w, u - centeredZero p ≠ 0 :=
    fun u hu => fun h =>
      centeredZero_not_mem_rectBoundary z w hbound p (by rw [← sub_eq_zero.mp h]; exact hu)
  by_cases hp : centeredZero p ∈ rectOpen z w
  · rw [if_pos hp]
    have hc1 : ContinuousOn (fun u : ℂ => h u / (u - centeredZero p)) (rectBoundary z w) :=
      ContinuousOn.div hh.continuous.continuousOn
        (continuousOn_id.sub continuousOn_const)
        (fun u hu => hne u hu)
    have hc2 : ContinuousOn
        (fun u : ℂ => h u * (1 / Complex.Hadamard.divisorZeroIndex₀_val p))
        (rectBoundary z w) :=
      ContinuousOn.mul hh.continuous.continuousOn continuousOn_const
    rw [rectangleBoundaryIntegral_congr_edge
      (F := fun u => h u *
        (1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p))
      (G := fun u => h u / (u - centeredZero p) +
        h u * (1 / Complex.Hadamard.divisorZeroIndex₀_val p))
      (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring)]
    rw [rectangleBoundaryIntegral_add (fun u => h u / (u - centeredZero p))
      (fun u => h u * (1 / Complex.Hadamard.divisorZeroIndex₀_val p)) z w
      (intervalIntegrable_edgeBottom_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeBottom_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeTop_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeTop_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeRight_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeRight_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeLeft_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeLeft_of_continuousOn hzr hzi hc2)]
    rw [single_pole_residue hh hzr hzi hp]
    have hconst : rectangleBoundaryIntegral
        (fun u => h u * (1 / Complex.Hadamard.divisorZeroIndex₀_val p)) z w = 0 := by
      rw [rectangleBoundaryIntegral_congr_edge
        (F := fun u => h u * (1 / Complex.Hadamard.divisorZeroIndex₀_val p))
        (G := fun u => (1 / Complex.Hadamard.divisorZeroIndex₀_val p) * h u)
        (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring)]
      rw [rectangleBoundaryIntegral_const_mul
          (1 / Complex.Hadamard.divisorZeroIndex₀_val p) h z w,
        rectangleBoundaryIntegral_eq_zero_of_differentiableOn h z w hh.differentiableOn]
      ring
    rw [hconst]
    ring
  · rw [if_neg hp]
    apply rectangleBoundaryIntegral_eq_zero_of_differentiableOn
    refine DifferentiableOn.mul hh.differentiableOn ?_
    refine DifferentiableOn.add ?_ (differentiableOn_const (1 / Complex.Hadamard.divisorZeroIndex₀_val p))
    refine DifferentiableOn.div (differentiableOn_const (1 : ℂ))
      (differentiableOn_id.sub (differentiableOn_const (centeredZero p))) ?_
    intro u hu h
    exact hp (hbound p (by rw [← sub_eq_zero.mp h]; exact hu))
theorem hasSum_edgeIntegral
    {z w : ℂ} (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w)
    {B : ℂ}
    (hB : ∀ u ∈ rectBoundary z w,
      logDeriv riemannXi ((1 / 2 : ℂ) + u) =
        B + ∑' p : XiZero,
          (1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p))
    (h : ℂ → ℂ) (hh : Differentiable ℂ h)
    {φ : ℝ → ℂ} {a b : ℝ} (hab : a ≤ b)
    {M C : ℝ} (hM : 0 ≤ M) (hC : 0 ≤ C)
    (hφ : ∀ t ∈ Set.uIcc a b, φ t ∈ rectBoundary z w)
    (hφcont : ContinuousOn φ (Set.uIcc a b))
    (hMh : ∀ t ∈ Set.uIcc a b, ‖h (φ t)‖ ≤ M)
    (hCφ : ∀ p : XiZero, ∀ t ∈ Set.uIcc a b,
      ‖1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤
        C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) :
    HasSum (fun p : XiZero => ∫ t in a..b,
        h (φ t) * (1 / (φ t - centeredZero p) +
          1 / Complex.Hadamard.divisorZeroIndex₀_val p))
      (∫ t in a..b,
        (h (φ t) * logDeriv riemannXi ((1 / 2 : ℂ) + φ t) - h (φ t) * B)) := by
  set μ : Measure ℝ := volume.restrict (Set.Ioc a b) with hμ
  have hcont : ∀ p : XiZero, ContinuousOn
      (fun t : ℝ => h (φ t) *
        (1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p))
      (Set.uIcc a b) := by
    intro p
    refine ContinuousOn.mul ?_ ?_
    · exact (hh.continuous.continuousOn (s := Set.univ)).comp hφcont
        (fun t _ => Set.mem_univ (φ t))
    · refine ContinuousOn.add (ContinuousOn.div continuousOn_const
        (hφcont.sub continuousOn_const) ?_) continuousOn_const
      intro t ht h
      have hue : φ t = centeredZero p := sub_eq_zero.mp h
      exact centeredZero_not_mem_rectBoundary z w hbound p (by rw [← hue]; exact hφ t ht)
  have hHas : HasSum (fun p : XiZero => ∫ t, h (φ t) *
        (1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p) ∂μ)
      (∫ t, ∑' p : XiZero, h (φ t) *
        (1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p) ∂μ) := by
    refine hasSum_integral_of_summable_integral_norm ?_ ?_
    · intro p
      have hint : IntervalIntegrable (fun t : ℝ => h (φ t) *
          (1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p))
          volume a b := ContinuousOn.intervalIntegrable (hcont p)
      have hlint := intervalIntegrable_iff.mp hint
      rwa [Set.uIoc_of_le hab] at hlint
    · have hmaj : Summable (fun p : XiZero =>
          ((M * C) * (b - a)) * (1 / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2))) :=
        summable_one_div_one_add_norm_sq.mul_left _
      refine Summable.of_nonneg_of_le (fun p => integral_nonneg (fun t => norm_nonneg _))
        (fun p => ?_) hmaj
      have hint : IntervalIntegrable (fun t : ℝ => ‖h (φ t) *
          (1 / (φ t - centeredZero p) +
            1 / Complex.Hadamard.divisorZeroIndex₀_val p)‖) volume a b :=
        ContinuousOn.intervalIntegrable (hcont p).norm
      calc ∫ t, ‖h (φ t) *
              (1 / (φ t - centeredZero p) +
                1 / Complex.Hadamard.divisorZeroIndex₀_val p)‖ ∂μ
          = ∫ t in a..b, ‖h (φ t) *
              (1 / (φ t - centeredZero p) +
                1 / Complex.Hadamard.divisorZeroIndex₀_val p)‖ :=
            (intervalIntegral.integral_of_le hab).symm
        _ ≤ ∫ t in a..b, M * (C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) := by
            refine intervalIntegral.integral_mono_on hab hint intervalIntegrable_const ?_
            intro t ht
            have ht' : t ∈ Set.uIcc a b := by rw [Set.uIcc_of_le hab]; exact ht
            rw [norm_mul]
            exact mul_le_mul (hMh t ht') (hCφ p t ht') (norm_nonneg _) hM
        _ = ((M * C) * (b - a)) *
              (1 / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) := by
            rw [intervalIntegral.integral_const, smul_eq_mul]
            ring
  have hpoint : (fun t : ℝ => ∑' p : XiZero, h (φ t) *
        (1 / (φ t - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)) =ᵐ[μ]
      (fun t => h (φ t) * logDeriv riemannXi ((1 / 2 : ℂ) + φ t) - h (φ t) * B) := by
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc] with t ht
    have ht' : t ∈ Set.uIcc a b := by rw [Set.uIcc_of_le hab]; exact ⟨ht.1.le, ht.2⟩
    have hM1 := hB (φ t) (hφ t ht')
    rw [tsum_mul_left]
    have hT : (∑' q : XiZero, (1 / (φ t - centeredZero q) +
        1 / Complex.Hadamard.divisorZeroIndex₀_val q)) =
        logDeriv riemannXi ((1 / 2 : ℂ) + φ t) - B := by
      rw [hM1]; abel
    rw [hT, mul_sub]
  rw [MeasureTheory.integral_congr_ae hpoint] at hHas
  simpa only [hμ, intervalIntegral.integral_of_le hab] using hHas
theorem hasSum_boundaryIntegral
    {z w : ℂ} (hzr : z.re < w.re) (hzi : z.im < w.im)
    (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w)
    {B : ℂ}
    (hB : ∀ u ∈ rectBoundary z w,
      logDeriv riemannXi ((1 / 2 : ℂ) + u) =
        B + ∑' p : XiZero,
          (1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p))
    (h : ℂ → ℂ) (hh : Differentiable ℂ h) :
    HasSum (fun p : XiZero => rectangleBoundaryIntegral
        (fun u => h u * (1 / (u - centeredZero p) +
          1 / Complex.Hadamard.divisorZeroIndex₀_val p)) z w)
      (rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u) - h u * B) z w) := by
  obtain ⟨C, hC0, hC⟩ := exists_bound_centeredZero_summand z w hbound
  obtain ⟨M, hM0, hM⟩ := exists_bound_of_differentiable h hh z w
  have hφb : ∀ t ∈ Set.uIcc z.re w.re, edgeBottom z w t ∈ rectBoundary z w :=
    fun t ht => edgeBottom_mem_rectBoundary z w hzr hzi (by
      simpa [Set.uIcc_of_le hzr.le] using ht)
  have hφt : ∀ t ∈ Set.uIcc z.re w.re, edgeTop z w t ∈ rectBoundary z w :=
    fun t ht => edgeTop_mem_rectBoundary z w hzr hzi (by
      simpa [Set.uIcc_of_le hzr.le] using ht)
  have hφr : ∀ t ∈ Set.uIcc z.im w.im, edgeRight z w t ∈ rectBoundary z w :=
    fun t ht => edgeRight_mem_rectBoundary z w hzr hzi (by
      simpa [Set.uIcc_of_le hzi.le] using ht)
  have hφl : ∀ t ∈ Set.uIcc z.im w.im, edgeLeft z w t ∈ rectBoundary z w :=
    fun t ht => edgeLeft_mem_rectBoundary z w hzr hzi (by
      simpa [Set.uIcc_of_le hzi.le] using ht)
  have hb := hasSum_edgeIntegral hbound hB h hh (φ := edgeBottom z w) (a := z.re) (b := w.re)
    hzr.le hM0 hC0 hφb (continuous_edgeBottom z w).continuousOn
    (fun t ht => hM _ (hφb t ht).1) (fun p t ht => hC p _ (hφb t ht))
  have ht := hasSum_edgeIntegral hbound hB h hh (φ := edgeTop z w) (a := z.re) (b := w.re)
    hzr.le hM0 hC0 hφt (continuous_edgeTop z w).continuousOn
    (fun t ht => hM _ (hφt t ht).1) (fun p t ht => hC p _ (hφt t ht))
  have hr := hasSum_edgeIntegral hbound hB h hh (φ := edgeRight z w) (a := z.im) (b := w.im)
    hzi.le hM0 hC0 hφr (continuous_edgeRight z w).continuousOn
    (fun t ht => hM _ (hφr t ht).1) (fun p t ht => hC p _ (hφr t ht))
  have hl := hasSum_edgeIntegral hbound hB h hh (φ := edgeLeft z w) (a := z.im) (b := w.im)
    hzi.le hM0 hC0 hφl (continuous_edgeLeft z w).continuousOn
    (fun t ht => hM _ (hφl t ht).1) (fun p t ht => hC p _ (hφl t ht))
  let Fb : XiZero → ℂ := fun p => ∫ x in z.re..w.re, h (edgeBottom z w x) *
    (1 / (edgeBottom z w x - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)
  let Ft : XiZero → ℂ := fun p => ∫ x in z.re..w.re, h (edgeTop z w x) *
    (1 / (edgeTop z w x - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)
  let Fr : XiZero → ℂ := fun p => ∫ y in z.im..w.im, h (edgeRight z w y) *
    (1 / (edgeRight z w y - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)
  let Fl : XiZero → ℂ := fun p => ∫ y in z.im..w.im, h (edgeLeft z w y) *
    (1 / (edgeLeft z w y - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)
  let Lb : ℂ := ∫ x in z.re..w.re,
    (h (edgeBottom z w x) * logDeriv riemannXi ((1 / 2 : ℂ) + edgeBottom z w x) -
      h (edgeBottom z w x) * B)
  let Lt : ℂ := ∫ x in z.re..w.re,
    (h (edgeTop z w x) * logDeriv riemannXi ((1 / 2 : ℂ) + edgeTop z w x) -
      h (edgeTop z w x) * B)
  let Lr : ℂ := ∫ y in z.im..w.im,
    (h (edgeRight z w y) * logDeriv riemannXi ((1 / 2 : ℂ) + edgeRight z w y) -
      h (edgeRight z w y) * B)
  let Ll : ℂ := ∫ y in z.im..w.im,
    (h (edgeLeft z w y) * logDeriv riemannXi ((1 / 2 : ℂ) + edgeLeft z w y) -
      h (edgeLeft z w y) * B)
  change HasSum (fun p : XiZero => (Fb p - Ft p + I * Fr p) - I * Fl p)
    (((Lb - Lt) + I * Lr) - I * Ll)
  have h1 : HasSum (fun p : XiZero => Fb p - Ft p) (Lb - Lt) := hb.sub ht
  have h2 : HasSum (fun p : XiZero => I * Fr p) (I * Lr) := hr.mul_left I
  have h3 : HasSum (fun p : XiZero => I * Fl p) (I * Ll) := hl.mul_left I
  have h4 : HasSum (fun p : XiZero => (Fb p - Ft p) + I * Fr p) ((Lb - Lt) + I * Lr) :=
    h1.add h2
  have h5 : HasSum (fun p : XiZero => ((Fb p - Ft p) + I * Fr p) - I * Fl p)
      (((Lb - Lt) + I * Lr) - I * Ll) := h4.sub h3
  exact h5
theorem rectangleResidueIdentityFinite : RectangleResidueIdentityFinite := by
  intro h hh z w hzr hzi hbound hfin
  obtain ⟨B, hB0⟩ := exists_logDeriv_riemannXi_centered
  have hB : ∀ u ∈ rectBoundary z w,
      logDeriv riemannXi ((1 / 2 : ℂ) + u) =
        B + ∑' p : XiZero,
          (1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p) := by
    intro u hu
    have hw : ∀ p : XiZero, (1 / 2 : ℂ) + u ≠ Complex.Hadamard.divisorZeroIndex₀_val p := by
      intro p hp
      have hue : u = centeredZero p := by
        rw [centeredZero]
        have h2 : Complex.Hadamard.divisorZeroIndex₀_val p - 1 / 2 = u := by
          rw [← hp]
          ring
        exact h2.symm
      exact hu.2 (by rw [hue]; exact hbound p (by rw [← hue]; exact hu.1))
    rw [hB0 u hw]
    apply congrArg (fun t : ℂ => B + t)
    refine tsum_congr fun p => ?_
    have h1 : (1 / 2 : ℂ) + centeredZero p =
        Complex.Hadamard.divisorZeroIndex₀_val p := by rw [centeredZero]; ring
    rw [h1]
  have hsum := hasSum_boundaryIntegral hzr hzi hbound hB h hh
  have hz : rectangleBoundaryIntegral h z w = 0 :=
    rectangleBoundaryIntegral_eq_zero_of_differentiableOn h z w hh.differentiableOn
  have hlimit : rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u) - h u * B) z w =
      rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) z w := by
    have hGcont : ContinuousOn (fun u : ℂ => logDeriv riemannXi ((1 / 2 : ℂ) + u))
        (rectBoundary z w) := by
      have h1 : ContinuousOn (fun u : ℂ => riemannXi ((1 / 2 : ℂ) + u)) (rectBoundary z w) :=
        (differentiable_riemannXi.continuous.continuousOn (s := Set.univ)).comp
          (continuousOn_const.add continuousOn_id) (fun u _ => Set.mem_univ _)
      have h2 : ContinuousOn (fun u : ℂ => deriv riemannXi ((1 / 2 : ℂ) + u))
          (rectBoundary z w) :=
        (differentiable_riemannXi.deriv.continuous.continuousOn (s := Set.univ)).comp
          (continuousOn_const.add continuousOn_id) (fun u _ => Set.mem_univ _)
      rw [logDeriv]
      refine ContinuousOn.div h2 h1 ?_
      intro u hu h
      obtain ⟨p, hp⟩ := exists_divisorIndex_of_riemannXi_eq_zero h
      have hue : u = centeredZero p := by
        rw [centeredZero]
        have h2 : Complex.Hadamard.divisorZeroIndex₀_val p - 1 / 2 = u := by
          rw [hp]
          ring
        exact h2.symm
      exact centeredZero_not_mem_rectBoundary z w hbound p (by rw [← hue]; exact hu)
    have hc1 : ContinuousOn
        (fun u : ℂ => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u) - h u * B)
        (rectBoundary z w) :=
      ContinuousOn.sub (ContinuousOn.mul hh.continuous.continuousOn hGcont)
        (ContinuousOn.mul hh.continuous.continuousOn continuousOn_const)
    have hc2 : ContinuousOn (fun u : ℂ => h u * B) (rectBoundary z w) :=
      ContinuousOn.mul hh.continuous.continuousOn continuousOn_const
    have hsplit := rectangleBoundaryIntegral_add
      (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u) - h u * B)
      (fun u => h u * B) z w
      (intervalIntegrable_edgeBottom_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeBottom_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeTop_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeTop_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeRight_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeRight_of_continuousOn hzr hzi hc2)
      (intervalIntegrable_edgeLeft_of_continuousOn hzr hzi hc1)
      (intervalIntegrable_edgeLeft_of_continuousOn hzr hzi hc2)
    rw [rectangleBoundaryIntegral_congr_edge
      (F := fun u => (h u * logDeriv riemannXi ((1 / 2 : ℂ) + u) - h u * B) + h u * B)
      (G := fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u))
      (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring)]
      at hsplit
    have hBzero : rectangleBoundaryIntegral (fun u : ℂ => h u * B) z w = 0 := by
      rw [rectangleBoundaryIntegral_congr_edge (F := fun u : ℂ => h u * B)
        (G := fun u : ℂ => B * h u)
        (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring) (fun _ _ => by ring)]
      rw [rectangleBoundaryIntegral_const_mul B h z w, hz]
      ring
    rw [hBzero, add_zero] at hsplit
    exact hsplit.symm
  rw [hlimit] at hsum
  have hterm : (fun p : XiZero => rectangleBoundaryIntegral
        (fun u => h u * (1 / (u - centeredZero p) +
          1 / Complex.Hadamard.divisorZeroIndex₀_val p)) z w) =
      fun p : XiZero => hadamardSummandValue h z w p :=
    funext fun p => rectangleBoundaryIntegral_hadamardSummand h hh hzr hzi hbound p
  rw [hterm] at hsum
  have htsum : (∑' p : XiZero, hadamardSummandValue h z w p) =
      2 * (Real.pi : ℂ) * I * rectangleZeroSum z w h := by
    rw [rectangleZeroSum]
    rw [← tsum_mul_left]
    refine tsum_congr fun p => ?_
    rw [hadamardSummandValue]
    split_ifs <;> ring
  exact (htsum.symm.trans hsum.tsum_eq).symm
