      intervalIntegral.integral_comp_neg
        (f := fun y : ℝ => F ((z.re : ℂ) + (y : ℂ) * I)) (a := z.im) (b := w.im)
    have h4 : (∫ y : ℝ in -(w.im)..-(z.im), F ((z.re : ℂ) + (y : ℂ) * I)) =
        ∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + (y : ℂ) * I) := by
      congr 1 <;> linarith
    exact h1.trans (h2.trans (congrArg Neg.neg (h3.trans h4)))
