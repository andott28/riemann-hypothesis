section Inline_ExplicitFormula_RH7
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
theorem norm_le_of_mem_rectOpen {u z w : ℂ} (hu : u ∈ rectOpen z w) :
    ‖u‖ ≤ 2 * (‖z‖ + ‖w‖) := by
  have hre : |u.re| ≤ max |z.re| |w.re| := by
    have h1 : min z.re w.re < u.re := hu.1
    have h2 : u.re < max z.re w.re := hu.2.1
    rw [abs_le]
    constructor
    · have : -max |z.re| |w.re| ≤ min z.re w.re :=
        le_min (by linarith [neg_abs_le z.re, le_max_left |z.re| |w.re|])
          (by linarith [neg_abs_le w.re, le_max_right |z.re| |w.re|])
      linarith
    · have : max z.re w.re ≤ max |z.re| |w.re| :=
        max_le (le_trans (le_abs_self z.re) (le_max_left _ _))
          (le_trans (le_abs_self w.re) (le_max_right _ _))
      linarith
  have him : |u.im| ≤ max |z.im| |w.im| := by
    have h1 : min z.im w.im < u.im := hu.2.2.1
    have h2 : u.im < max z.im w.im := hu.2.2.2
    rw [abs_le]
    constructor
    · have : -max |z.im| |w.im| ≤ min z.im w.im :=
        le_min (by linarith [neg_abs_le z.im, le_max_left |z.im| |w.im|])
          (by linarith [neg_abs_le w.im, le_max_right |z.im| |w.im|])
      linarith
    · have : max z.im w.im ≤ max |z.im| |w.im| :=
        max_le (le_trans (le_abs_self z.im) (le_max_left _ _))
          (le_trans (le_abs_self w.im) (le_max_right _ _))
      linarith
  have hmaxre : max |z.re| |w.re| ≤ ‖z‖ + ‖w‖ :=
    max_le (by linarith [abs_re_le_norm z, norm_nonneg w])
      (by linarith [abs_re_le_norm w, norm_nonneg z])
  have hmaxim : max |z.im| |w.im| ≤ ‖z‖ + ‖w‖ :=
    max_le (by linarith [abs_im_le_norm z, norm_nonneg w])
      (by linarith [abs_im_le_norm w, norm_nonneg z])
  calc ‖u‖ ≤ |u.re| + |u.im| := norm_le_abs_re_add_abs_im u
    _ ≤ max |z.re| |w.re| + max |z.im| |w.im| := add_le_add hre him
    _ ≤ (‖z‖ + ‖w‖) + (‖z‖ + ‖w‖) := add_le_add hmaxre hmaxim
    _ = 2 * (‖z‖ + ‖w‖) := by ring
theorem finite_centeredZero_mem_rectOpen (z w : ℂ) :
    ({p : XiZero | centeredZero p ∈ rectOpen z w} : Set XiZero).Finite := by
  refine (Complex.Hadamard.divisorZeroIndex₀_norm_le_finite (f := riemannXi) (U := Set.univ)
    (2 * (‖z‖ + ‖w‖) + 1) (by simp)).subset ?_
  intro p hp
  have hu := norm_le_of_mem_rectOpen hp
  calc ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ =
        ‖centeredZero p + 1 / 2‖ := by
        rw [centeredZero]
        ring_nf
    _ ≤ ‖centeredZero p‖ + 1 / 2 := by
        have := norm_add_le (centeredZero p) (1 / 2 : ℂ)
        rwa [show ‖(1 / 2 : ℂ)‖ = 1 / 2 by norm_num] at this
    _ ≤ 2 * (‖z‖ + ‖w‖) + 1 / 2 := by linarith
    _ ≤ 2 * (‖z‖ + ‖w‖) + 1 := by linarith [norm_nonneg z, norm_nonneg w]
def stripLeft (T : ℝ) : ℂ := ((-1 / 2 : ℝ) : ℂ) - (T : ℂ) * I
def stripRight (T : ℝ) : ℂ := ((1 / 2 : ℝ) : ℂ) + (T : ℂ) * I
theorem stripLeft_re (T : ℝ) : (stripLeft T).re = -1 / 2 := by
  simp only [stripLeft, Complex.sub_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re,
    Complex.ofReal_im, Complex.I_im, mul_zero, mul_one, sub_zero]
theorem stripLeft_im (T : ℝ) : (stripLeft T).im = -T := by
  simp only [stripLeft, Complex.sub_im, Complex.ofReal_im, Complex.mul_im, Complex.I_im,
    Complex.ofReal_re, Complex.I_re, mul_zero, mul_one, add_zero]
  ring
theorem stripRight_re (T : ℝ) : (stripRight T).re = 1 / 2 := by
  simp only [stripRight, Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re,
    Complex.ofReal_im, Complex.I_im, mul_zero, mul_one, add_zero, sub_zero]
theorem stripRight_im (T : ℝ) : (stripRight T).im = T := by
  simp only [stripRight, Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.I_im,
    Complex.ofReal_re, Complex.I_re, mul_zero, mul_one, add_zero]
  ring
theorem rectangleResidueLimit_strip {h : ℂ → ℂ} (hh : Differentiable ℂ h)
    (hdecay : PolyDecay h) {T : ℕ → ℝ} (hT : Tendsto T atTop atTop)
    (hTpos : ∀ n, 0 < T n)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (stripLeft (T n)) (stripRight (T n)) →
        centeredZero p ∈ rectOpen (stripLeft (T n)) (stripRight (T n))) :
    Tendsto (fun n => rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u))
        (stripLeft (T n)) (stripRight (T n))) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, h (centeredZero p))) := by
  refine rectangleResidueLimit hh hdecay (Z := fun n => stripLeft (T n))
    (W := fun n => stripRight (T n)) ?_ ?_ hbd ?_ ?_
  · intro n
    rw [stripLeft_re, stripRight_re]
    norm_num
  · intro n
    rw [stripLeft_im, stripRight_im]
    linarith [hTpos n]
  · intro n
    exact finite_centeredZero_mem_rectOpen _ _
  · intro p
    have hM : ∀ᶠ n in atTop, |(centeredZero p).im| < T n := by
      have h1 : ∀ᶠ n in atTop, |(centeredZero p).im| + 1 ≤ T n :=
        tendsto_atTop.mp hT _
      filter_upwards [h1] with n hn
      linarith
    obtain ⟨N, hN⟩ := eventually_atTop.mp hM
    refine ⟨N, fun n hn => ?_⟩
    have hre : -(1 / 2 : ℝ) < (centeredZero p).re ∧ (centeredZero p).re < 1 / 2 := by
      have hp := val_re_mem_Ioo p
      have h : (centeredZero p).re =
          (Complex.Hadamard.divisorZeroIndex₀_val p).re - 1 / 2 := by
        rw [centeredZero, Complex.sub_re]
        norm_num
      rw [h]
      exact ⟨by linarith [hp.1], by linarith [hp.2]⟩
    rw [rectOpen, stripLeft_re, stripLeft_im, stripRight_re, stripRight_im]
    refine ⟨?_, ?_, ?_, ?_⟩
    · have h := hre.1
      linarith [min_le_left (-1 / 2 : ℝ) (1 / 2)]
    · have h := hre.2
      linarith [le_max_right (-1 / 2 : ℝ) (1 / 2)]
    · have h := (abs_lt.mp (hN n hn)).1
      linarith [min_le_left (-(T n)) (T n)]
    · have h := (abs_lt.mp (hN n hn)).2
      linarith [le_max_right (-(T n)) (T n)]
end RHLean.ExplicitFormula
end
