theorem stripBoundaryIntegral_even_decomposition {h : ℂ → ℂ}
    (heven : ∀ u : ℂ, h (-u) = h u) (T : ℝ) :
    rectangleBoundaryIntegral (xiLogIntegrand h) (stripLeft T) (stripRight T) =
      -(2 * stripTopIntegral h T) + 2 * I * stripRightIntegral h T := by
  have hzre : (stripLeft T).re = -(stripRight T).re := by
    rw [stripLeft_re, stripRight_re]
    norm_num
  have hzim : (stripLeft T).im = -(stripRight T).im := by
    rw [stripLeft_im, stripRight_im]
