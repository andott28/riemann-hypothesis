section Inline_Y7_A3Step4
noncomputable section
open Matrix
open scoped BigOperators
namespace Y7A3Final
structure Step3Enclosure (a : ℝ) where
  N : ℕ
  A : Matrix (Fin 7) (Fin 7) ℝ
  Bm : Matrix (Fin 7) (Fin N) ℝ
  d : Fin N → ℝ
  hd : ∀ j, 0 < d j
  AU : Matrix (Fin 7) (Fin 7) ℝ
  WL : Matrix (Fin 7) (Fin 7) ℝ
  Scrit : Matrix (Fin 7) (Fin 7) ℝ
  Corr : Matrix (Fin 7) (Fin 7) ℝ
  hAUsym : AU.IsSymm
  hWLsym : WL.IsSymm
  hScritsym : Scrit.IsSymm
  hCorrsym : Corr.IsSymm
  hAU : Y7AssemblyBox.InBox Y7AssemblyBox.AUlo Y7AssemblyBox.AUhi AU
  hWL : Y7AssemblyBox.InBox Y7AssemblyBox.WLlo Y7AssemblyBox.WLhi WL
  hScrit : Y7AssemblyBox.InBox Y7AssemblyBox.Scrit_lo Y7AssemblyBox.Scrit_hi Scrit
  hCorr : Y7AssemblyBox.InBox Y7AssemblyBox.Corrlo Y7AssemblyBox.Corrhi Corr
  hSchur : (A - Bm * (Matrix.diagonal d)⁻¹ * Bm.conjTranspose
      - Y7Assembly.finalMatrix AU WL Scrit Corr (1 / 5)).PosSemidef
  coord : (s : Finset ℕ) → (x : ℕ → ℝ) → (∀ m ∈ s, Odd m) → (Fin 7 ⊕ Fin N → ℝ)
  hdom : ∀ (s : Finset ℕ) (x : ℕ → ℝ) (hs : ∀ m ∈ s, Odd m),
      (coord s x hs) ⬝ᵥ
          ((Matrix.fromBlocks A Bm Bm.conjTranspose (Matrix.diagonal d))
            *ᵥ (coord s x hs))
        ≤ ∑ m ∈ s, ∑ n ∈ s, x m * x n * Y7Op.rescaledOperatorM a m n
def ofCertificate {a : ℝ} (h : Y7A3Cert.Certificate a) : Step3Enclosure a where
  N := h.N
  A := h.A
  Bm := h.Bm
  d := h.d
  hd := h.hd
  AU := h.AU
  WL := h.WL
  Scrit := h.Scrit
  Corr := h.Corr
  hAUsym := h.hAUsym
  hWLsym := h.hWLsym
  hScritsym := h.hScritsym
  hCorrsym := h.hCorrsym
  hAU := h.hAU
  hWL := h.hWL
  hScrit := h.hScrit
  hCorr := h.hCorr
  hSchur := h.hSchur
  coord := h.coord
  hdom := h.hdom
theorem GRes_endpoint_seven :
    (Y7K2.K2PP (RHLean.endpoint 7)
      - (Y7KPP.KPP (RHLean.endpoint 7))ᵀ * Y7KPP.KPP (RHLean.endpoint 7)
      - (Y7ParsevalC.Bcrit (RHLean.endpoint 7))ᵀ
          * Y7ParsevalC.Bcrit (RHLean.endpoint 7)).PosSemidef :=
  Y7ParsevalC.GRes_posSemidef (by unfold RHLean.endpoint; positivity)
theorem matrixBlocksPos_of_enclosure {a : ℝ} (h : Step3Enclosure a) :
    Y7Density.MatrixBlocksPos a := by
  intro s x hs
  have hPSD : (Matrix.fromBlocks h.A h.Bm h.Bm.conjTranspose
      (Matrix.diagonal h.d)).PosSemidef :=
    Y7Density.finalMatrix_block_posSemidef h.AU h.WL h.Scrit h.Corr (1 / 5)
      h.hAUsym h.hWLsym h.hScritsym h.hCorrsym h.hAU h.hWL h.hScrit h.hCorr rfl
      h.A h.Bm h.d h.hd h.hSchur
  have hnn : 0 ≤ (h.coord s x hs) ⬝ᵥ
      ((Matrix.fromBlocks h.A h.Bm h.Bm.conjTranspose (Matrix.diagonal h.d))
        *ᵥ (h.coord s x hs)) := by
    simpa only [star_trivial] using hPSD.dotProduct_mulVec_nonneg (h.coord s x hs)
  exact le_trans hnn (h.hdom s x hs)
theorem matrixBlocksPos_of_certificate {a : ℝ} (h : Y7A3Cert.Certificate a) :
    Y7Density.MatrixBlocksPos a :=
  matrixBlocksPos_of_enclosure (ofCertificate h)
theorem polynomialPositivity_of_enclosure
    (h : Step3Enclosure (RHLean.endpoint 7)) :
    Y7Density.PolynomialPositivity (RHLean.endpoint 7) :=
  Y7Density.polynomialPositivity_of_matrixBlocks
    Y7Density.formMatrixRep_endpoint_seven
    (matrixBlocksPos_of_enclosure h)
theorem polynomialPositivity_of_certificate
    (h : Y7A3Cert.Certificate (RHLean.endpoint 7)) :
    Y7Density.PolynomialPositivity (RHLean.endpoint 7) :=
  polynomialPositivity_of_enclosure (ofCertificate h)
theorem localPSDRescaled_of_enclosure
    (h : Step3Enclosure (RHLean.endpoint 7)) :
