      Y7A3Step3Data.SwCrow0, Y7A3Step3Data.SwCrow1, Y7A3Step3Data.SwCrow2,
      Y7A3Step3Data.SwCrow3, Y7A3Step3Data.SwCrow4, Y7A3Step3Data.SwCrow5,
      Y7A3Step3Data.SwCrow6,
      Y7A3Step3Data.BmCrow0, Y7A3Step3Data.BmCrow1, Y7A3Step3Data.BmCrow2,
      Y7A3Step3Data.BmCrow3, Y7A3Step3Data.BmCrow4, Y7A3Step3Data.BmCrow5,
      Y7A3Step3Data.BmCrow6, Y7A3Step3Data.w,
      Y7AssemblyBox.WLlo.eq_def, Y7AssemblyBox.WLhi.eq_def,
      Y7AssemblyBox.Corrlo.eq_def, Y7AssemblyBox.Corrhi.eq_def,
      Y7AssemblyBox.Scrit_lo.eq_def, Y7AssemblyBox.Scrit_hi.eq_def,
      Y7AssemblyBox.Slowlo.eq_def, Y7AssemblyBox.Slowhi.eq_def,
      Y7AssemblyBox.Sinflo.eq_def, Y7AssemblyBox.Sinfhi.eq_def,
      Fin.sum_univ_succ]
theorem Sw_eq (i j : Fin 7) :
    Y7A3Step3Data.Sw i j
      = Y7A3Data.WL i j + 6 * Y7A3Data.Scrit i j + Y7A3Data.Corr i j
        - (Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
            * Y7A3Data.Bm.conjTranspose) i j := by
  have h : (Y7A3Step3Data.SwC i j : ℝ)
      = (WLq i j : ℝ) + 6 * (Scritq i j : ℝ) + (Corrq i j : ℝ) - (BwB i j : ℝ) := by
    rw [SwC_eq i j]
    push_cast
    ring
  have hBwB : (BwB i j : ℝ)
      = ∑ k : Fin 50, Y7A3Data.Bm i k * (Y7A3Step3Data.w : ℝ) * Y7A3Data.Bm j k := by
    simp only [BwB, Y7A3Data.Bm]
    push_cast
    rfl
  have hprod : (Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
        * Y7A3Data.Bm.conjTranspose) i j
      = ∑ k : Fin 50, Y7A3Data.Bm i k * (Y7A3Step3Data.w : ℝ) * Y7A3Data.Bm j k := by
    rw [Matrix.mul_assoc, Matrix.mul_apply]
    apply Finset.sum_congr rfl
    intro k _
    rw [Matrix.diagonal_mul, Matrix.conjTranspose_apply]
    simp only [star_trivial]
    ring
  simp only [Y7A3Step3Data.Sw, Y7A3Data.WL, Y7A3Data.Scrit, Y7A3Data.Corr,
    Y7A3Data.boxMid, WLq, Scritq, Corrq] at h ⊢
  rw [hprod, h, hBwB]
end Y7A3Wire
