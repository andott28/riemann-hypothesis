          * Complex.exp (-(Complex.I * ((Real.log q : ℝ) : ℂ)) * (r : ℂ)) := by
    apply integral_congr_ae
    filter_upwards with r
    have hr : (-(2 * (Real.pi : ℂ) * I * ((Real.log q / (2 * Real.pi) : ℝ)) ) * (r : ℂ))
        = -(Complex.I * ((Real.log q : ℝ) : ℂ)) * (r : ℂ) := by
      rw [harg]
