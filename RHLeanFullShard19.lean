section Inline_ExplicitFormula_RH24
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology ContDiff Convolution FourierTransform Pointwise ComplexConjugate
namespace RHLean.ExplicitFormula
noncomputable def halflineTest (f : ℝ → ℂ) : ℝ → ℂ :=
  fun x => autocorr f x * Complex.exp ((x : ℂ) / 2)
theorem continuous_halflineTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Continuous (halflineTest f) :=
  (contDiff_autocorr hf).continuous.mul
    ((Complex.continuous_exp.comp (continuous_ofReal.div_const 2)))
theorem hasCompactSupport_halflineTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    HasCompactSupport (halflineTest f) :=
  (hasCompactSupport_autocorr hf).mul_right
theorem integrable_halflineTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (halflineTest f) :=
  (continuous_halflineTest hf).integrable_of_hasCompactSupport
    (hasCompactSupport_halflineTest hf)
theorem fourier_halflineTest (f : ℝ → ℂ) (ξ : ℝ) :
    𝓕 (halflineTest f) ξ
      = transf (autocorr f) ((1 / 2 : ℂ) + ((-(2 * Real.pi * ξ)) : ℝ) * I) := by
  rw [Real.fourier_eq]
  unfold halflineTest transf
  apply integral_congr_ae
  filter_upwards with x
  rw [Circle.smul_def, smul_eq_mul, Real.fourierChar_apply]
  have hinner : inner ℝ x ξ = ξ * x := by simp
  rw [hinner]
  have hexp : ((1 / 2 : ℂ) + ((-(2 * Real.pi * ξ)) : ℝ) * I) * (x : ℂ)
      = (↑(2 * Real.pi * (-(ξ * x))) : ℂ) * I + (x : ℂ) / 2 := by
    push_cast
    ring
  rw [hexp, Complex.exp_add]
  ring
theorem integrable_fourier_halflineTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (𝓕 (halflineTest f)) := by
  obtain ⟨C, hC0, hC⟩ := transf_autocorr_StripQuadDecay hf
  have hdecay : ∀ ξ : ℝ, ‖𝓕 (halflineTest f) ξ‖ ≤ 4 * C * (1 + ξ ^ 2)⁻¹ := by
    intro ξ
    rw [fourier_halflineTest f ξ]
    set u : ℂ := (1 / 2 : ℂ) + ((-(2 * Real.pi * ξ)) : ℝ) * I with hu
    have hu_re : |u.re| ≤ (1 : ℝ) / 2 := by
      rw [hu]
      simp
    have h1 := hC u hu_re
    have hnle : (2 : ℝ) * Real.pi * |ξ| ≤ ‖u‖ := by
      have h2 : |u.im| ≤ ‖u‖ := Complex.abs_im_le_norm u
      have him : u.im = -(2 * Real.pi * ξ) := by
        rw [hu]
        simp
      rw [him, abs_neg] at h2
      have habs : |2 * Real.pi * ξ| = 2 * Real.pi * |ξ| := by
        rw [abs_mul, abs_mul, abs_of_pos Real.pi_pos]
        norm_num
