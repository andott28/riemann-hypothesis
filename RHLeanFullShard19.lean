theorem exists_support_radius {g : ℝ → ℂ} (hcs : HasCompactSupport g) :
    ∃ R : ℝ, 0 ≤ R ∧ ∀ y : ℝ, R < |y| → g y = 0 := by
  obtain ⟨C, hC⟩ := hcs.isBounded.exists_norm_le
  refine ⟨max C 0, le_max_right _ _, fun y hy => ?_⟩
  by_contra hy0
  have hmem : y ∈ tsupport g := subset_tsupport g (Function.mem_support.mpr hy0)
  have h1 : ‖y‖ ≤ C := hC y hmem
  rw [Real.norm_eq_abs] at h1
  have h2 : |y| ≤ max C 0 := le_trans h1 (le_max_left _ _)
  linarith
theorem hasCompactSupport_of_support_radius {g : ℝ → ℂ} {R : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ y : ℝ, R < |y| → g y = 0) : HasCompactSupport g := by
  have hsub : tsupport g ⊆ Set.Icc (-R) R := by
    have hsupp : Function.support g ⊆ Set.Icc (-R) R := by
      intro y hy
      rw [Set.mem_Icc]
      constructor <;> by_contra hlt <;> push_neg at hlt
      · exact hy (hR y (by rw [abs_of_neg (by linarith)]; linarith))
      · exact hy (hR y (by rw [abs_of_pos (by linarith)]; linarith))
    calc tsupport g = closure (Function.support g) := rfl
      _ ⊆ closure (Set.Icc (-R) R) := closure_mono hsupp
      _ = Set.Icc (-R) R := isClosed_Icc.closure_eq
  exact isCompact_Icc.of_isClosed_subset (isClosed_tsupport g) hsub
theorem deriv_eq_zero_of_support_radius {g : ℝ → ℂ} (hcd : ContDiff ℝ ∞ g) {R : ℝ}
    (hR : ∀ y : ℝ, R < |y| → g y = 0) : ∀ y : ℝ, R < |y| → deriv g y = 0 := by
  intro y hy
  have hev : g =ᶠ[𝓝 y] 0 := by
    filter_upwards [isOpen_lt continuous_const continuous_abs |>.mem_nhds hy] with y' hy'
    exact hR y' hy'
  rw [hev.deriv_eq]
  exact deriv_const y 0
theorem exists_transf_norm_pow_mul_le {g : ℝ → ℂ} {R M : ℝ} (hR0 : 0 ≤ R) (hM0 : 0 ≤ M)
    (hcd : ContDiff ℝ ∞ g) (hR : ∀ y : ℝ, R < |y| → g y = 0) (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, |z.re| ≤ M → (1 + ‖z‖) ^ n * ‖transf g z‖ ≤ C := by
  have key : ∀ n : ℕ, ∀ h : ℝ → ℂ, ContDiff ℝ ∞ h → (∀ y : ℝ, R < |y| → h y = 0) →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, |z.re| ≤ M → (1 + ‖z‖) ^ n * ‖transf h z‖ ≤ C := by
    intro n
    induction n with
    | zero =>
        intro h hhd hh
        refine ⟨Real.exp (M * R) * ∫ y : ℝ, ‖h y‖, by positivity, fun z hz => ?_⟩
        simp only [pow_zero, one_mul]
        have hcs : HasCompactSupport h := hasCompactSupport_of_support_radius hR0 hh
        have hch : Continuous h := hhd.continuous
        have hint1 : Integrable (fun y : ℝ => h y * cexp (z * (y : ℂ))) :=
          (hch.mul (Complex.continuous_exp.comp
            (continuous_const.mul continuous_ofReal))).integrable_of_hasCompactSupport
            (hcs.mul_right)
        have hint2 : Integrable (fun y : ℝ => Real.exp (M * R) * ‖h y‖) :=
          (hch.norm.integrable_of_hasCompactSupport hcs.norm).const_mul _
        calc ‖transf h z‖ = ‖∫ y : ℝ, h y * cexp (z * (y : ℂ))‖ := rfl
          _ ≤ ∫ y : ℝ, ‖h y * cexp (z * (y : ℂ))‖ := norm_integral_le_integral_norm _
          _ ≤ ∫ y : ℝ, Real.exp (M * R) * ‖h y‖ := by
              apply integral_mono_ae hint1.norm hint2
              filter_upwards with y
              by_cases hy : h y = 0
              · simp [hy]
              · have hle : |y| ≤ R := by
                  by_contra hlt
                  push_neg at hlt
                  exact hy (hh y hlt)
                rw [norm_mul, Complex.norm_exp]
                have h1 : (z * (y : ℂ)).re = z.re * y := by simp
                rw [h1]
                have h2 : z.re * y ≤ M * R := by
                  calc z.re * y ≤ |z.re * y| := le_abs_self _
                    _ = |z.re| * |y| := abs_mul _ _
                    _ ≤ M * R := mul_le_mul hz hle (abs_nonneg _) hM0
                calc ‖h y‖ * Real.exp (z.re * y) ≤ ‖h y‖ * Real.exp (M * R) := by
                      exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr h2) (norm_nonneg _)
                  _ = Real.exp (M * R) * ‖h y‖ := by ring
          _ = Real.exp (M * R) * ∫ y : ℝ, ‖h y‖ := integral_const_mul _ _
    | succ n ih =>
        intro h hhd hh
        obtain ⟨C₁, hC₁0, hC₁⟩ := ih h hhd hh
        have hdcd : ContDiff ℝ ∞ (deriv h) := by
          have := ContDiff.iterate_deriv (𝕜 := ℝ) 1 hhd
          simpa using this
        have hdh : ∀ y : ℝ, R < |y| → deriv h y = 0 := deriv_eq_zero_of_support_radius hhd hh
        obtain ⟨C₂, hC₂0, hC₂⟩ := ih (deriv h) hdcd hdh
        have hdiff : ∀ y : ℝ, HasDerivAt h (deriv h y) y :=
          fun y => (hhd.differentiable (by simp)).differentiableAt.hasDerivAt
        have hcont : Continuous (deriv h) := hhd.continuous_deriv (by simp)
        have hIBP : ∀ z : ℂ, z * transf h z = -transf (deriv h) z :=
          fun z => transf_mul_eq_neg_transf_deriv hR0 hh hdiff hcont
        refine ⟨C₁ + C₂, add_nonneg hC₁0 hC₂0, fun z hz => ?_⟩
        have hz2 : ‖transf (deriv h) z‖ = ‖z‖ * ‖transf h z‖ := by
          have hneg : transf (deriv h) z = -(z * transf h z) := by
            rw [hIBP z]
            simp
          rw [hneg, norm_neg, norm_mul]
        calc (1 + ‖z‖) ^ (n + 1) * ‖transf h z‖
            = (1 + ‖z‖) ^ n * ((1 + ‖z‖) * ‖transf h z‖) := by ring
          _ ≤ (1 + ‖z‖) ^ n * (‖transf h z‖ + ‖z‖ * ‖transf h z‖) := by
              have h1 : (1 + ‖z‖) * ‖transf h z‖
                  = ‖transf h z‖ + ‖z‖ * ‖transf h z‖ := by ring
              rw [h1]
          _ = (1 + ‖z‖) ^ n * ‖transf h z‖ + (1 + ‖z‖) ^ n * ‖transf (deriv h) z‖ := by
              rw [hz2]
              ring
          _ ≤ C₁ + C₂ := add_le_add (hC₁ z hz) (hC₂ z hz)
  exact key n g hcd hR
end RHLean.ExplicitFormula
namespace RHLean.ExplicitFormula
theorem exists_transf_autocorr_norm_pow_mul_le {f : ℝ → ℂ} (hf : f ∈ oddCore)
