  unfold conjReflect
  exact (Complex.conjCLE.contDiff.comp (hf.comp contDiff_neg))
theorem hasCompactSupport_conjReflect {f : ℝ → ℂ} (hf : HasCompactSupport f) :
    HasCompactSupport (conjReflect f) := by
  unfold conjReflect
  exact (hf.comp_homeomorph (Homeomorph.neg ℝ)).comp_left (by simp)
theorem autocorr_eq_convolution (f : ℝ → ℂ) (u : ℝ) :
    autocorr f u = (f ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] conjReflect f) u := by
  rw [autocorr, MeasureTheory.convolution_def]
  have h := MeasureTheory.integral_add_right_eq_self (μ := volume)
    (fun t : ℝ => f t * star (f (t - u))) u
  simp only [add_sub_cancel_right] at h
  rw [h]
  apply integral_congr_ae
  filter_upwards with x
  unfold conjReflect
  show f x * star (f (x - u)) = f x * star (f (-(u - x)))
  rw [show x - u = -(u - x) by ring]
theorem contDiff_autocorr {f : ℝ → ℂ} (hf : f ∈ oddCore) : ContDiff ℝ ∞ (autocorr f) := by
  have hcd : ContDiff ℝ ∞ (conjReflect f) := contDiff_conjReflect hf.1
  have hconv : ContDiff ℝ ∞ (f ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] conjReflect f) :=
    (hasCompactSupport_conjReflect hf.2.1).contDiff_convolution_right
      (ContinuousLinearMap.mul ℝ ℂ) (hf.1.continuous.locallyIntegrable) hcd
  have hfun : autocorr f = f ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] conjReflect f :=
    funext fun u => autocorr_eq_convolution f u
  rw [hfun]
  exact hconv
theorem hasCompactSupport_autocorr {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    HasCompactSupport (autocorr f) := by
  have hK : IsCompact (tsupport f + tsupport (conjReflect f)) :=
    hf.2.1.isCompact.add (hasCompactSupport_conjReflect hf.2.1).isCompact
  refine HasCompactSupport.of_support_subset_isCompact hK fun u hu => ?_
  by_contra hnot
  have hnot' : u ∉ tsupport f + tsupport (conjReflect f) := hnot
  apply hu
  rw [autocorr]
