theorem two_pi_mul_div (r : ℝ) : 2 * Real.pi * (r / (2 * Real.pi)) = r := by
  have h : (2 * Real.pi) ≠ 0 := two_pi_ne_zero
  field_simp
theorem inv_abs_neg_two_pi : |(-(2 * (Real.pi : ℝ)))⁻¹|⁻¹ = 2 * Real.pi := by
  rw [abs_inv, inv_inv, abs_neg, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi)]
theorem ofReal_neg_two_pi_mul_mul (v w : ℝ) :
    (((-(2 * Real.pi) * w : ℝ)) : ℂ) * ((v : ℝ) : ℂ)
      = (((2 * Real.pi * -(v * w) : ℝ)) : ℂ) := by
  rw [← Complex.ofReal_mul]
  congr 1
  rw [neg_mul, neg_mul, mul_assoc, mul_comm w v, mul_neg]
