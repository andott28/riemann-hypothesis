      analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) :=
  Complex.Hadamard.divisorZeroIndex₀_fiberFinset_card_eq_analyticOrderNatAt
    differentiable_riemannXi (Complex.Hadamard.divisorZeroIndex₀_val_ne_zero p)
theorem mem_centeredZero_fiberFinset (p q : XiZero) :
    q ∈ Complex.Hadamard.divisorZeroIndex₀_fiberFinset riemannXi
