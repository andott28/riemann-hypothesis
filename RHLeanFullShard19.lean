theorem norm_hadamardTerm_far {T : ℝ} (hT : 0 ≤ T) {μ : ℂ}
    (hμ : 2 * (1 + T) ≤ ‖μ‖) {x : ℝ} (hx : |x| ≤ 1 / 2) :
    ‖((x : ℂ) + (T : ℂ) * I) / (((x : ℂ) + (T : ℂ) * I) ^ 2 - μ ^ 2)‖
