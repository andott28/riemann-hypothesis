  Y7AssemblyBox.InBox Y7AssemblyBox.Corrlo Y7AssemblyBox.Corrhi Corr
def BoxesOK : Prop := InBoxAU ∧ InBoxWL ∧ InBoxScrit ∧ InBoxCorr
