    (hasCompactSupport_autocorr hf)).continuous.comp (by fun_prop)
theorem integrable_bridgeLine {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (bridgeLine f) volume := by
  obtain ⟨C, hC0, hC⟩ := transf_autocorr_StripQuadDecay hf
  refine Integrable.mono' (integrable_inv_one_add_sq.const_mul C)
    (continuous_bridgeLine hf).aestronglyMeasurable ?_
  filter_upwards with y
  set u : ℂ := (1 / 2 : ℂ) + (y : ℂ) * I with hu
  have hdec := hC u (by rw [hu]; norm_num)
  have hyu : y ^ 2 ≤ ‖u‖ ^ 2 := by
    have h1 := Complex.abs_im_le_norm u
    have him : u.im = y := by rw [hu]; simp
    rw [him] at h1
    calc y ^ 2 = |y| ^ 2 := (sq_abs y).symm
      _ ≤ ‖u‖ ^ 2 := pow_le_pow_left₀ (abs_nonneg y) h1 2
  calc ‖bridgeLine f y‖ = ‖transf (autocorr f) u‖ := by rw [bridgeLine, hu]
    _ ≤ C / (1 + ‖u‖) ^ 2 := hdec
    _ = C * ((1 + ‖u‖) ^ 2)⁻¹ := by rw [div_eq_mul_inv]
    _ ≤ C * (1 + y ^ 2)⁻¹ := by
        refine mul_le_mul_of_nonneg_left ?_ hC0
        rw [inv_le_inv₀ (by positivity) (by positivity)]
        nlinarith [hyu, norm_nonneg u]
theorem continuous_primeLSeriesKernel {ε : ℝ} {n : ℕ} (hn : n ≠ 0) :
    Continuous (primeLSeriesKernel ε n) := by
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn
  rw [show primeLSeriesKernel ε n = fun y : ℝ =>
      Complex.exp (Complex.log (n : ℂ) * (-(1 + (ε : ℂ) + (y : ℂ) * I))) from by
    funext y
    rw [primeLSeriesKernel, Complex.cpow_def_of_ne_zero hnC]]
  fun_prop
theorem norm_primeLSeriesKernel {ε : ℝ} {n : ℕ} (hn : 0 < n) (y : ℝ) :
    ‖primeLSeriesKernel ε n y‖ = (n : ℝ) ^ (-(1 + ε)) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  rw [primeLSeriesKernel,
    show (n : ℂ) = ((n : ℝ) : ℂ) from (Complex.ofReal_natCast n).symm,
    Complex.norm_cpow_eq_rpow_re_of_pos hnR]
  congr 1
  simp
theorem summable_primeLSeriesWeight {ε : ℝ} (hε : 0 < ε) :
    Summable (primeLSeriesWeight ε) := by
  set s₀ : ℂ := (((1 + ε : ℝ)) : ℂ) with hs₀
  have hs : (1 : ℝ) < s₀.re := by rw [hs₀]; simp; linarith
  have h : LSeriesSummable vonMangoldtComplex s₀ :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt (s := s₀) hs
  have hnorm : Summable (fun n => ‖LSeries.term vonMangoldtComplex s₀ n‖) := h.norm
  refine hnorm.congr fun n => ?_
  by_cases hn : n = 0
  · subst hn
    simp [primeLSeriesWeight, vonMangoldtComplex]
  · have hnpos : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
    have hs₀re : s₀.re = 1 + ε := by rw [hs₀]; simp
    rw [LSeries.term_of_ne_zero hn, norm_div,
      show (n : ℂ) = ((n : ℝ) : ℂ) from (Complex.ofReal_natCast n).symm,
      Complex.norm_cpow_eq_rpow_re_of_pos hnpos, hs₀re,
      div_eq_mul_inv, primeLSeriesWeight]
    congr 1
    exact (Real.rpow_neg (Nat.cast_nonneg n) (1 + ε)).symm
theorem norm_bridgePrimeIntegrand (f : ℝ → ℂ) (ε : ℝ) (n : ℕ) (y : ℝ) :
    ‖bridgePrimeIntegrand f ε n y‖ = ‖bridgeLine f y‖ * primeLSeriesWeight ε n := by
  by_cases hn : n = 0
  · subst hn
    simp [bridgePrimeIntegrand, vonMangoldtComplex, primeLSeriesWeight]
  · rw [bridgePrimeIntegrand, norm_mul, norm_mul,
      norm_primeLSeriesKernel (ε := ε) (Nat.pos_of_ne_zero hn) y, primeLSeriesWeight]
theorem tsum_bridgePrimeIntegrand (f : ℝ → ℂ) (ε : ℝ) (y : ℝ) :
    (∑' n : ℕ, bridgePrimeIntegrand f ε n y)
      = bridgeLine f y * LSeries vonMangoldtComplex (bridgeSpectralArgument ε y) := by
  unfold bridgePrimeIntegrand
  rw [LSeries_def₀ vonMangoldtComplex_zero, tsum_mul_left]
  congr 1
  refine tsum_congr fun n => ?_
  rw [primeLSeriesKernel, div_eq_mul_inv,
    ← Complex.cpow_neg (n : ℂ) (bridgeSpectralArgument ε y)]
  congr 1
  rw [bridgeSpectralArgument]
  push_cast
  ring
theorem integral_bridgePrimeIntegrand {f : ℝ → ℂ} (hf : f ∈ oddCore)
    {ε : ℝ} (n : ℕ) :
    (∫ y : ℝ, bridgePrimeIntegrand f ε n y) = primeSideTerm f ε n := by
  by_cases hn : n = 0
  · subst hn
    have hzero : bridgePrimeIntegrand f ε 0 = fun _ => 0 := by
      funext y
      simp [bridgePrimeIntegrand, vonMangoldtComplex]
    rw [hzero, integral_zero]
    simp [primeSideTerm]
  · have hnpos : 0 < n := Nat.pos_of_ne_zero hn
    have h1 : (∫ y : ℝ, bridgePrimeIntegrand f ε n y)
        = vonMangoldtComplex n
            * (∫ y : ℝ, bridgeLine f y * primeLSeriesKernel ε n y) := by
      rw [show bridgePrimeIntegrand f ε n
          = fun y : ℝ => vonMangoldtComplex n * (bridgeLine f y * primeLSeriesKernel ε n y)
        from by funext y; unfold bridgePrimeIntegrand; ring]
      exact integral_const_mul _ _
    rw [h1]
    have h2 : (∫ y : ℝ, bridgeLine f y * primeLSeriesKernel ε n y)
        = ∫ y : ℝ, transf (autocorr f) ((1 / 2 : ℂ) + (y : ℂ) * I)
            * (n : ℂ) ^ (-(1 + ε + y * I)) := by
      apply integral_congr_ae
      filter_upwards with y
      rw [bridgeLine, primeLSeriesKernel]
    rw [h2, integral_transf_autocorr_cpow hf n hnpos ε]
    unfold primeSideTerm vonMangoldtComplex
    rw [Complex.real_smul]
    ring
theorem integral_LSeries_eq_tsum_primeSideTerm {f : ℝ → ℂ} (hf : f ∈ oddCore)
    {ε : ℝ} (hε : 0 < ε) :
    (∫ y : ℝ, bridgeLine f y * LSeries vonMangoldtComplex (bridgeSpectralArgument ε y))
      = ∑' n : ℕ, primeSideTerm f ε n := by
  have hg_int : Integrable (bridgeLine f) volume := integrable_bridgeLine hf
  have hg_norm_int : Integrable (fun y => ‖bridgeLine f y‖) volume := hg_int.norm
  set G : ℝ := ∫ y, ‖bridgeLine f y‖ with hG
  have hK_summable : Summable (primeLSeriesWeight ε) := summable_primeLSeriesWeight hε
  have hG_summable : Summable (fun n : ℕ => primeLSeriesWeight ε n * G) :=
    hK_summable.mul_right G
  have hF_int : ∀ n : ℕ, Integrable (bridgePrimeIntegrand f ε n) volume := by
    intro n
    by_cases hn : n = 0
    · subst hn
      have hzero : bridgePrimeIntegrand f ε 0 = fun _ => 0 := by
        funext y
        simp [bridgePrimeIntegrand, vonMangoldtComplex]
      rw [hzero]
      exact integrable_zero ℝ ℂ volume
    · have hcont : Continuous (bridgePrimeIntegrand f ε n) :=
        (continuous_bridgeLine hf).mul (continuous_const.mul
          (continuous_primeLSeriesKernel (ε := ε) hn))
      refine Integrable.mono' (hg_norm_int.mul_const (primeLSeriesWeight ε n))
        hcont.aestronglyMeasurable ?_
      filter_upwards with y
      rw [norm_bridgePrimeIntegrand]
  have hF_sum : Summable (fun n : ℕ => ∫ y, ‖bridgePrimeIntegrand f ε n y‖) := by
    refine hG_summable.congr fun n => ?_
    rw [integral_congr_ae (Eventually.of_forall
        (fun y => norm_bridgePrimeIntegrand f ε n y)),
      integral_mul_const, ← hG]
    ring
  have hhas : HasSum (fun n : ℕ => ∫ y, bridgePrimeIntegrand f ε n y)
      (∫ y, ∑' n : ℕ, bridgePrimeIntegrand f ε n y) :=
    hasSum_integral_of_summable_integral_norm hF_int hF_sum
  have hLHS : (∫ y : ℝ, bridgeLine f y * LSeries vonMangoldtComplex (bridgeSpectralArgument ε y))
      = ∫ y : ℝ, ∑' n : ℕ, bridgePrimeIntegrand f ε n y :=
    integral_congr_ae (Eventually.of_forall fun y =>
      (tsum_bridgePrimeIntegrand f ε y).symm)
  rw [hLHS, ← hhas.tsum_eq]
  exact tsum_congr fun n => integral_bridgePrimeIntegrand hf n
theorem primeSideTerm_eq_zero_of_not_mem_arithSupport {a : ℝ} {f : ℝ → ℂ}
    (hf : f ∈ localizedCore a) {ε : ℝ} {n : ℕ} (hn : n ∉ arithSupport a) :
    primeSideTerm f ε n = 0 := by
  by_cases h2 : 2 ≤ n
  · have hge : Nat.ceil (Real.exp (2 * a)) ≤ n := by
      by_contra hlt
      have hlt' : n < Nat.ceil (Real.exp (2 * a)) := lt_of_not_ge hlt
      exact hn (Finset.mem_Icc.mpr ⟨h2, Nat.le_sub_one_of_lt hlt'⟩)
    have hexp : Real.exp (2 * a) ≤ (n : ℝ) := Nat.ceil_le.mp hge
    have hlog : 2 * a ≤ Real.log n := by
      have h1 : Real.log (Real.exp (2 * a)) ≤ Real.log n :=
        Real.log_le_log (Real.exp_pos _) hexp
      rwa [Real.log_exp] at h1
    have hvan : autocorr f (Real.log n) = 0 := autocorr_eq_zero_of_two_a_le hf.2 hlog
    unfold primeSideTerm
    rw [hvan]
    simp
  · have hn01 : n = 0 ∨ n = 1 := by omega
    rcases hn01 with rfl | rfl <;> simp [primeSideTerm]
theorem tsum_primeSideTerm_eq_sum_arithSupport {a : ℝ} {f : ℝ → ℂ}
    (hf : f ∈ localizedCore a) (ε : ℝ) :
    (∑' n : ℕ, primeSideTerm f ε n) = ∑ n ∈ arithSupport a, primeSideTerm f ε n :=
  tsum_eq_sum fun _ hn => primeSideTerm_eq_zero_of_not_mem_arithSupport hf hn
theorem tendsto_integral_LSeries {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    Tendsto (fun ε : ℝ =>
        ∫ y : ℝ, bridgeLine f y * LSeries vonMangoldtComplex (bridgeSpectralArgument ε y))
      (𝓝[>] (0 : ℝ)) (𝓝 ((primeSideComb f a : ℝ) : ℂ)) := by
  have h := tendsto_primeSideComb (localizedCore_subset_oddCore a hf) a
  refine Tendsto.congr' ?_ h
  filter_upwards [self_mem_nhdsWithin] with ε hε
  exact (tsum_primeSideTerm_eq_sum_arithSupport hf ε).symm.trans
    (integral_LSeries_eq_tsum_primeSideTerm
      (localizedCore_subset_oddCore a hf) hε).symm
end RHLean.ExplicitFormula
end
