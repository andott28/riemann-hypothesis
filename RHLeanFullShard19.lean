theorem riemannXi_centered_functionalEquation (w : ℂ) :
    riemannXi ((1 / 2 : ℂ) - w) = riemannXi ((1 / 2 : ℂ) + w) := by
  have h := riemannXi_one_sub ((1 / 2 : ℂ) + w)
  have hc : (1 : ℂ) - ((1 / 2 : ℂ) + w) = (1 / 2 : ℂ) - w := by ring
  rwa [hc] at h
theorem logDeriv_riemannXi_centered_eq (t : ℂ) :
    logDeriv (fun x : ℂ => riemannXi ((1 / 2 : ℂ) + x)) t =
      logDeriv riemannXi ((1 / 2 : ℂ) + t) := by
  change logDeriv (riemannXi ∘ fun x : ℂ => (1 / 2 : ℂ) + x) t =
      logDeriv riemannXi ((1 / 2 : ℂ) + t)
  have h := logDeriv_comp (f := riemannXi) (g := fun x : ℂ => (1 / 2 : ℂ) + x)
    differentiable_riemannXi.differentiableAt (x := t) (by fun_prop)
  have hd : deriv (fun x : ℂ => (1 / 2 : ℂ) + x) t = 1 := by
    simp
  rw [hd, mul_one] at h
  exact h
theorem logDeriv_riemannXi_centered_reflect (w : ℂ) :
    logDeriv riemannXi ((1 / 2 : ℂ) - w) = -logDeriv riemannXi ((1 / 2 : ℂ) + w) := by
  set F : ℂ → ℂ := fun t => riemannXi ((1 / 2 : ℂ) + t) with hF
  have heven : (fun t => F (-t)) = F := by
    funext t
    rw [hF]
    show riemannXi ((1 / 2 : ℂ) + (-t)) = riemannXi ((1 / 2 : ℂ) + t)
    have h := riemannXi_centered_functionalEquation (-t)
    rw [show (1 / 2 : ℂ) - (-t) = (1 / 2 : ℂ) + t by ring] at h
    exact h.symm
  have hodd : ∀ t : ℂ, logDeriv F (-t) = -logDeriv F t := by
    intro t
    have h := logDeriv_comp_neg F (-t)
    rw [heven, neg_neg] at h
    simpa using h
  have h1 : logDeriv F (-w) = -logDeriv F w := hodd w
  rw [logDeriv_riemannXi_centered_eq (-w), logDeriv_riemannXi_centered_eq w] at h1
  simpa only [sub_eq_add_neg] using h1
theorem logDeriv_riemannXi_reflect_pair (y : ℝ) :
    logDeriv riemannXi ((y : ℂ) * I) = -logDeriv riemannXi (1 - (y : ℂ) * I) := by
  have h := logDeriv_riemannXi_centered_reflect (-(1 / 2 : ℂ) + (y : ℂ) * I)
  have h1 : (1 / 2 : ℂ) - (-(1 / 2 : ℂ) + (y : ℂ) * I) = 1 - (y : ℂ) * I := by ring
  have h2 : (1 / 2 : ℂ) + (-(1 / 2 : ℂ) + (y : ℂ) * I) = (y : ℂ) * I := by ring
  rw [h1, h2] at h
  have hneg : -logDeriv riemannXi (1 - (y : ℂ) * I) = logDeriv riemannXi ((y : ℂ) * I) :=
    (neg_eq_iff_eq_neg).mpr h
  exact hneg.symm
noncomputable def xiLogIntegrand (h : ℂ → ℂ) (u : ℂ) : ℂ :=
  h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)
theorem xiLogIntegrand_neg {h : ℂ → ℂ} (hodd : ∀ u : ℂ, h (-u) = -h u) (u : ℂ) :
    xiLogIntegrand h (-u) = xiLogIntegrand h u := by
  unfold xiLogIntegrand
  rw [hodd u, show (1 / 2 : ℂ) + (-u) = (1 / 2 : ℂ) - u by ring,
    logDeriv_riemannXi_centered_reflect u]
  ring
theorem rectangleBoundaryIntegral_eq_zero_of_even_integrand {F : ℂ → ℂ}
    (heven : ∀ u : ℂ, F (-u) = F u) {z w : ℂ}
    (hz : z.re = -(1 / 2 : ℝ)) (hw : w.re = 1 / 2) (him : z.im = -w.im) :
    rectangleBoundaryIntegral F z w = 0 := by
  have hb (x : ℝ) : F ((x : ℂ) + (z.im : ℂ) * I) =
      F (((-x : ℝ) : ℂ) + (w.im : ℂ) * I) := by
    have hzi : (z.im : ℂ) = -(w.im : ℂ) := by
      rw [him]
      push_cast
      ring
    have h1 : (x : ℂ) + (z.im : ℂ) * I = -(((-x : ℝ) : ℂ) + (w.im : ℂ) * I) := by
      rw [hzi]
      push_cast
      ring
    rw [h1, heven]
  have hbot : (∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (z.im : ℂ) * I)) =
      ∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (w.im : ℂ) * I) := by
    have h1 : (∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (z.im : ℂ) * I)) =
        ∫ x : ℝ in z.re..w.re, F (((-x : ℝ) : ℂ) + (w.im : ℂ) * I) :=
      intervalIntegral.integral_congr fun x _ => hb x
    have h2 : (∫ x : ℝ in z.re..w.re, F (((-x : ℝ) : ℂ) + (w.im : ℂ) * I)) =
        ∫ x : ℝ in -(w.re)..-(z.re), F ((x : ℂ) + (w.im : ℂ) * I) :=
      intervalIntegral.integral_comp_neg
        (f := fun x : ℝ => F ((x : ℂ) + (w.im : ℂ) * I)) (a := z.re) (b := w.re)
    have h3 : (∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (w.im : ℂ) * I)) =
        ∫ x : ℝ in -(w.re)..-(z.re), F ((x : ℂ) + (w.im : ℂ) * I) := by
      congr 1 <;> linarith
    exact h1.trans (h2.trans h3.symm)
  have hr (y : ℝ) : F ((w.re : ℂ) + (y : ℂ) * I) =
      F ((z.re : ℂ) + ((-y : ℝ) : ℂ) * I) := by
    have h1 : (w.re : ℂ) + (y : ℂ) * I = -((z.re : ℂ) + ((-y : ℝ) : ℂ) * I) := by
      have hz' : (z.re : ℂ) = -(w.re : ℂ) := by
        rw [show z.re = -(w.re) by linarith]
        push_cast
        ring
      rw [hz']
      push_cast
      ring
    rw [h1, heven]
  have hvert : (∫ y : ℝ in z.im..w.im, F ((w.re : ℂ) + (y : ℂ) * I)) =
      ∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + (y : ℂ) * I) := by
    have h1 : (∫ y : ℝ in z.im..w.im, F ((w.re : ℂ) + (y : ℂ) * I)) =
        ∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + ((-y : ℝ) : ℂ) * I) :=
      intervalIntegral.integral_congr fun y _ => hr y
    have h2 : (∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + ((-y : ℝ) : ℂ) * I)) =
        ∫ y : ℝ in -(w.im)..-(z.im), F ((z.re : ℂ) + (y : ℂ) * I) :=
      intervalIntegral.integral_comp_neg
        (f := fun y : ℝ => F ((z.re : ℂ) + (y : ℂ) * I)) (a := z.im) (b := w.im)
    have h3 : (∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + (y : ℂ) * I)) =
        ∫ y : ℝ in -(w.im)..-(z.im), F ((z.re : ℂ) + (y : ℂ) * I) := by
      congr 1
      all_goals linarith
    exact h1.trans (h2.trans h3.symm)
  rw [rectangleBoundaryIntegral, hbot, hvert]
  ring
theorem stripBoundaryIntegral_eq_zero_of_odd {h : ℂ → ℂ}
    (hodd : ∀ u : ℂ, h (-u) = -h u) (T : ℝ) :
    rectangleBoundaryIntegral (xiLogIntegrand h) (stripLeft T) (stripRight T) = 0 := by
  refine rectangleBoundaryIntegral_eq_zero_of_even_integrand (F := xiLogIntegrand h)
    (fun u => xiLogIntegrand_neg hodd u) ?_ ?_ ?_
  · show (stripLeft T).re = -(1 / 2 : ℝ)
    rw [stripLeft_re]
    norm_num
  · show (stripRight T).re = 1 / 2
    rw [stripRight_re]
  · show (stripLeft T).im = -(stripRight T).im
    rw [stripLeft_im, stripRight_im]
def LogDerivStripGrowth : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∀ T : ℝ, 2 ≤ T → ∀ x : ℝ,
    x ∈ Set.Icc (-(1 / 2)) (1 / 2) →
      ‖logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))‖ ≤
        C * (Real.log (1 + T)) ^ 2
end RHLean.ExplicitFormula
end
