theorem exists_logDeriv_riemannXi_centered :
    ∃ B : ℂ, ∀ w : ℂ,
      (∀ p : XiZero, (1 / 2 : ℂ) + w ≠ Complex.Hadamard.divisorZeroIndex₀_val p) →
      logDeriv riemannXi ((1 / 2 : ℂ) + w) =
        B + ∑' p : XiZero,
          (1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p)) := by
  obtain ⟨P, hdeg, hfac⟩ := riemannXi_hadamard_factorization_no_monomial
  refine ⟨P.coeff 1, fun w hw => ?_⟩
  rw [logDeriv_riemannXi_eq_coeff_one_add_tsum hdeg hfac hw]
  have hsum :
      (∑' p : XiZero,
        (1 / ((1 / 2 : ℂ) + w - Complex.Hadamard.divisorZeroIndex₀_val p) +
          1 / Complex.Hadamard.divisorZeroIndex₀_val p)) =
      (∑' p : XiZero,
        (1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) :=
    tsum_congr fun p => by
      have h1 : (1 / 2 : ℂ) + w - Complex.Hadamard.divisorZeroIndex₀_val p =
          w - centeredZero p := by
        rw [centeredZero]
        ring
      have h2 : Complex.Hadamard.divisorZeroIndex₀_val p =
          (1 / 2 : ℂ) + centeredZero p := by
        rw [centeredZero]
        ring
      have e1 := congrArg
        (fun x : ℂ => 1 / x + 1 / Complex.Hadamard.divisorZeroIndex₀_val p) h1
      have e2 := congrArg
        (fun x : ℂ => 1 / (w - centeredZero p) + 1 / x) h2
      exact e1.trans e2
  exact congrArg (fun t : ℂ => P.coeff 1 + t) hsum
theorem logDeriv_riemannXi_centered_odd (w : ℂ) :
    logDeriv riemannXi ((1 / 2 : ℂ) + w) =
      -logDeriv riemannXi ((1 / 2 : ℂ) - w) := by
  have hcomp :
      logDeriv riemannXi ((1 / 2 : ℂ) - w) =
        -logDeriv riemannXi ((1 / 2 : ℂ) + w) := by
    have h := logDeriv_comp (f := riemannXi) (g := fun s : ℂ => 1 - s)
      (x := (1 / 2 : ℂ) - w) differentiable_riemannXi.differentiableAt (by fun_prop)
    have hfun : (riemannXi ∘ fun s : ℂ => 1 - s) = riemannXi := by
      funext s
      exact riemannXi_one_sub s
    rw [hfun] at h
    rw [show (1 : ℂ) - ((1 / 2 : ℂ) - w) = (1 / 2 : ℂ) + w by ring] at h
    rw [deriv_const_sub_id, mul_neg, mul_one] at h
    exact h
  exact neg_eq_iff_eq_neg.mp hcomp.symm
theorem abs_re_centeredZero_le (p : XiZero) : |(centeredZero p).re| ≤ 1 / 2 := by
  have hp := val_re_mem_Ioo p
  have hre : (centeredZero p).re =
      (Complex.Hadamard.divisorZeroIndex₀_val p).re - 1 / 2 := by
    rw [centeredZero, Complex.sub_re]
    norm_num
  rw [hre, abs_le]
  exact ⟨by linarith [hp.1], by linarith [hp.2]⟩
theorem orbit_pair_identity (w lam : ℂ) (h1 : w - lam ≠ 0) (h2 : w + lam ≠ 0) :
    1 / (w - lam) + 1 / (w + lam) = 2 * w / (w ^ 2 - lam ^ 2) := by
  rw [one_div_add_one_div h1 h2]
  have hden : (w - lam) * (w + lam) ≠ 0 := mul_ne_zero h1 h2
  have hden' : w ^ 2 - lam ^ 2 ≠ 0 := by
    rw [show w ^ 2 - lam ^ 2 = (w - lam) * (w + lam) by ring]
    exact hden
  rw [div_eq_div_iff hden hden']
  ring
theorem centered_kernel_sub (w lam : ℂ) (h1 : w - lam ≠ 0) (h2 : w + lam ≠ 0) :
    (1 / (w - lam) + 1 / ((1 / 2 : ℂ) + lam)) -
      (1 / (-w - lam) + 1 / ((1 / 2 : ℂ) + lam)) =
        2 * (w / (w ^ 2 - lam ^ 2)) := by
  have h1' : 1 / (-w - lam) = -(1 / (w + lam)) := by
    rw [show -w - lam = -(w + lam) by ring, div_neg]
  have hsq : w ^ 2 - lam ^ 2 = (w - lam) * (w + lam) := by ring
  calc (1 / (w - lam) + 1 / ((1 / 2 : ℂ) + lam)) -
        (1 / (-w - lam) + 1 / ((1 / 2 : ℂ) + lam))
      = 1 / (w - lam) - 1 / (-w - lam) := by ring
    _ = 1 / (w - lam) + 1 / (w + lam) := by rw [h1']; ring
    _ = 2 * w / ((w - lam) * (w + lam)) := by
        rw [div_add_div (1 : ℂ) 1 h1 h2]
        rw [show 1 * (w + lam) + (w - lam) * 1 = 2 * w by ring]
    _ = 2 * (w / (w ^ 2 - lam ^ 2)) := by
        rw [← hsq]
        ring
def HadamardDensityCentered : Prop :=
  ∀ w : ℂ,
    (∀ p : XiZero, w ≠ centeredZero p) →
    (∀ p : XiZero, w ≠ -centeredZero p) →
    logDeriv riemannXi ((1 / 2 : ℂ) + w) =
      ∑' p : XiZero, w / (w ^ 2 - centeredZero p ^ 2)
theorem hadamardDensityCentered : HadamardDensityCentered := by
  intro w hw hw'
  obtain ⟨B, hB⟩ := exists_logDeriv_riemannXi_centered
  have hwv : ∀ p : XiZero,
      (1 / 2 : ℂ) + w ≠ Complex.Hadamard.divisorZeroIndex₀_val p := by
    intro p hp
    refine hw p ?_
    have hw' : w = Complex.Hadamard.divisorZeroIndex₀_val p - 1 / 2 := by
      rw [← hp]
      ring
    simpa [centeredZero] using hw'
  have hnwv : ∀ p : XiZero,
      (1 / 2 : ℂ) + (-w) ≠ Complex.Hadamard.divisorZeroIndex₀_val p := by
    intro p hp
    refine hw' p ?_
    have hw' : w = -(Complex.Hadamard.divisorZeroIndex₀_val p - 1 / 2) := by
      rw [← hp]
      ring
    simpa [centeredZero] using hw'
  have hsum_w := summable_centered_logDerivTerms (w := w) hwv
  have hsum_nw := summable_centered_logDerivTerms (w := -w) hnwv
  have hGw := hB w hwv
  have hGnw := hB (-w) hnwv
  have hGnw' : logDeriv riemannXi ((1 / 2 : ℂ) - w) =
      B + ∑' p : XiZero,
        (1 / (-w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p)) :=
    by simpa only [sub_eq_add_neg] using hGnw
  have hsub :
      (∑' p : XiZero,
          (1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) -
        (∑' p : XiZero,
          (1 / (-w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) =
      ∑' p : XiZero, 2 * (w / (w ^ 2 - centeredZero p ^ 2)) := by
    rw [← hsum_w.tsum_sub hsum_nw]
    refine tsum_congr fun p => ?_
    have h1 : w - centeredZero p ≠ 0 := by
      intro h
      exact hw p (sub_eq_zero.mp h)
    have h2 : w + centeredZero p ≠ 0 := by
      intro h
      exact hw' p (add_eq_zero_iff_eq_neg.mp h)
    exact centered_kernel_sub w (centeredZero p) h1 h2
  have hD :
      logDeriv riemannXi ((1 / 2 : ℂ) + w) -
        logDeriv riemannXi ((1 / 2 : ℂ) - w) =
      ∑' p : XiZero, 2 * (w / (w ^ 2 - centeredZero p ^ 2)) := by
    rw [hGw, hGnw']
    rw [show (B + ∑' p : XiZero,
            (1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) -
          (B + ∑' p : XiZero,
            (1 / (-w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) =
        (∑' p : XiZero,
            (1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) -
          (∑' p : XiZero,
            (1 / (-w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p))) by ring]
    exact hsub
  have hodd :
      logDeriv riemannXi ((1 / 2 : ℂ) + w) -
        logDeriv riemannXi ((1 / 2 : ℂ) - w) =
      2 * logDeriv riemannXi ((1 / 2 : ℂ) + w) := by
    rw [logDeriv_riemannXi_centered_odd w]
    ring
  have h2G :
      2 * logDeriv riemannXi ((1 / 2 : ℂ) + w) =
      ∑' p : XiZero, 2 * (w / (w ^ 2 - centeredZero p ^ 2)) :=
    hodd.symm.trans hD
  have h2K :
      (∑' p : XiZero, 2 * (w / (w ^ 2 - centeredZero p ^ 2))) =
      2 * ∑' p : XiZero, w / (w ^ 2 - centeredZero p ^ 2) :=
    tsum_mul_left
  exact mul_left_cancel₀ two_ne_zero (h2G.trans h2K)
def rectOpen (z w : ℂ) : Set ℂ :=
  {u | min z.re w.re < u.re ∧ u.re < max z.re w.re ∧
       min z.im w.im < u.im ∧ u.im < max z.im w.im}
def rectClosed (z w : ℂ) : Set ℂ :=
  {u | min z.re w.re ≤ u.re ∧ u.re ≤ max z.re w.re ∧
       min z.im w.im ≤ u.im ∧ u.im ≤ max z.im w.im}
noncomputable def rectangleBoundaryIntegral (F : ℂ → ℂ) (z w : ℂ) : ℂ :=
  (∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (z.im : ℂ) * I))
    - (∫ x : ℝ in z.re..w.re, F ((x : ℂ) + (w.im : ℂ) * I))
    + I * (∫ y : ℝ in z.im..w.im, F ((w.re : ℂ) + (y : ℂ) * I))
    - I * (∫ y : ℝ in z.im..w.im, F ((z.re : ℂ) + (y : ℂ) * I))
noncomputable def rectangleZeroSum (z w : ℂ) (h : ℂ → ℂ) : ℂ := by
  classical
  exact ∑' p : XiZero,
    if centeredZero p ∈ rectOpen z w then h (centeredZero p) else 0
def RectangleWinding : Prop :=
  ∀ c z w : ℂ, z.re < w.re → z.im < w.im → c ∈ rectOpen z w →
    rectangleBoundaryIntegral (fun u => 1 / (u - c)) z w =
      2 * (Real.pi : ℂ) * I
def RectangleResidueIdentityFinite : Prop :=
  ∀ (h : ℂ → ℂ), Differentiable ℂ h →
    ∀ z w : ℂ, z.re < w.re → z.im < w.im →
      (∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w) →
      (Set.Finite {p : XiZero | centeredZero p ∈ rectOpen z w}) →
      rectangleBoundaryIntegral
          (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) z w =
        2 * (Real.pi : ℂ) * I * rectangleZeroSum z w h
end RHLean.ExplicitFormula
end
end Inline_ExplicitFormula_RH0
