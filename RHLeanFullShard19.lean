namespace RHLean.ExplicitFormula
theorem hadamardTerm_partial_fraction {w lam : ℂ} (h1 : w - lam ≠ 0) (h2 : w + lam ≠ 0) :
    w / (w ^ 2 - lam ^ 2) = (1 / 2) * (1 / (w - lam) + 1 / (w + lam)) := by
  have hdiv : 1 / (w - lam) + 1 / (w + lam) = 2 * w / ((w - lam) * (w + lam)) := by
    rw [div_add_div (1 : ℂ) 1 h1 h2]
    rw [show 1 * (w + lam) + (w - lam) * 1 = 2 * w by ring]
  rw [hdiv, show w ^ 2 - lam ^ 2 = (w - lam) * (w + lam) by ring]
  field_simp [mul_ne_zero h1 h2]
theorem norm_hadamardTerm_le (w lam : ℂ) :
    ‖w / (w ^ 2 - lam ^ 2)‖ ≤ (1 / 2) * (1 / ‖w - lam‖ + 1 / ‖w + lam‖) := by
  by_cases h : w ^ 2 - lam ^ 2 = 0
  · rw [h, div_zero, norm_zero]
    positivity
  · have hprod : (w - lam) * (w + lam) ≠ 0 := by
      rwa [← show w ^ 2 - lam ^ 2 = (w - lam) * (w + lam) by ring]
    have h1 : w - lam ≠ 0 := fun hh => hprod (by rw [hh, zero_mul])
    have h2 : w + lam ≠ 0 := fun hh => hprod (by rw [hh, mul_zero])
    rw [hadamardTerm_partial_fraction h1 h2, norm_mul]
    have h12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
    rw [h12]
    calc (1 / 2) * ‖1 / (w - lam) + 1 / (w + lam)‖
        ≤ (1 / 2) * (‖1 / (w - lam)‖ + ‖1 / (w + lam)‖) :=
          mul_le_mul_of_nonneg_left (norm_add_le _ _) (by norm_num)
      _ = (1 / 2) * (1 / ‖w - lam‖ + 1 / ‖w + lam‖) := by
          simp only [norm_div, norm_one]
theorem exists_ball_punctured_of_eventually {lam : ℂ} {P Q : ℂ → Prop}
    (hP : ∀ᶠ u in 𝓝[≠] lam, P u) (hQ : ∀ᶠ u in 𝓝 lam, Q u) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ u : ℂ, ‖u - lam‖ < δ → u ≠ lam → P u ∧ Q u := by
  rw [eventually_nhdsWithin_iff] at hP
  obtain ⟨δ₁, hδ₁0, hδ₁⟩ := Metric.mem_nhds_iff.mp hP
  obtain ⟨δ₂, hδ₂0, hδ₂⟩ := Metric.mem_nhds_iff.mp hQ
  refine ⟨min δ₁ δ₂, lt_min hδ₁0 hδ₂0, fun u hu hune => ?_⟩
  have hu1 : ‖u - lam‖ < δ₁ := lt_of_lt_of_le hu (min_le_left _ _)
  have hu2 : ‖u - lam‖ < δ₂ := lt_of_lt_of_le hu (min_le_right _ _)
  have hmem1 : u ∈ Metric.ball lam δ₁ := by
    rw [Metric.mem_ball, dist_eq_norm]
    exact hu1
  have hmem2 : u ∈ Metric.ball lam δ₂ := by
    rw [Metric.mem_ball, dist_eq_norm]
    exact hu2
  exact ⟨hδ₁ hmem1 hune, hδ₂ hmem2⟩
theorem not_logDerivStripGrowth_of_principalPart
    {lam : ℂ} (h2T : 2 ≤ lam.im) (hre : lam.re ∈ Set.Ioo (-(1 / 2)) (1 / 2))
    {m : ℕ} (hm : 0 < m) {G : ℂ → ℂ} (hGc : ContinuousAt G lam)
    (hfrac : (fun u : ℂ => logDeriv riemannXi ((1 / 2 : ℂ) + u)) =ᶠ[𝓝[≠] lam]
