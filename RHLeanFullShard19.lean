section Inline_ExplicitFormula_RH15
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
theorem summable_transf_autocorr {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Summable (fun p : XiZero => transf (autocorr f) (centeredZero p)) :=
  (summable_weil_summand hf).congr fun p =>
    (transf_autocorr hf.1.continuous hf.2.1 (centeredZero p)).symm
noncomputable def archDensity (r : ℝ) : ℝ :=
  (Complex.digamma ((1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)).re - Real.log Real.pi
noncomputable def spectralTest (f : ℝ → ℂ) (r : ℝ) : ℂ :=
  transf (autocorr f) ((r : ℂ) * I)
noncomputable def ghatAt (f : ℝ → ℂ) (q : ℕ) : ℝ :=
  (∫ r : ℝ, spectralTest f r
      * Complex.exp (-(2 * (Real.pi : ℂ) * I * (((Real.log q / (2 * Real.pi) : ℝ)) : ℂ))
          * (r : ℂ))).re
noncomputable def archimedeanBlock (f : ℝ → ℂ) : ℝ :=
  (1 / (2 * Real.pi)) * ∫ r : ℝ, archDensity r * (spectralTest f r).re
noncomputable def poleBlock (f : ℝ → ℂ) : ℝ :=
  2 * (transf (autocorr f) (-(1 / 2))).re
noncomputable def primeBlock (a : ℝ) (f : ℝ → ℂ) : ℝ :=
  ∑ q ∈ arithSupport a, arithCoeff q * (2 * (autocorr f (shiftLength q)).re)
def EvenGuinandWeilAt (a : ℝ) : Prop :=
  0 < a → ∀ f : ℝ → ℂ, f ∈ localizedCore a →
    (∑' p : XiZero, transf (autocorr f) (centeredZero p)).re
      = archimedeanBlock f + poleBlock f
        - (1 / Real.pi) * ∑ q ∈ arithSupport a, arithCoeff q * ghatAt f q
def PrimeParsevalAt (a : ℝ) : Prop :=
  0 < a → ∀ f : ℝ → ℂ, f ∈ localizedCore a →
    (1 / Real.pi) * ∑ q ∈ arithSupport a, arithCoeff q * ghatAt f q = primeBlock a f
def ArchimedeanMatchAt (a : ℝ) : Prop :=
  0 < a → ∀ f : ℝ → ℂ, f ∈ localizedCore a →
    archimedeanBlock f
      = archForm a f + physicalConstant * (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 ∂volume)
        + potentialForm a f - gammaForm a f
theorem transf_autocorr_neg {f : ℝ → ℂ} (hf : Continuous f) (hs : HasCompactSupport f)
    (hodd : ∀ x, f (-x) = -f x) (z : ℂ) :
    transf (autocorr f) (-z) = transf (autocorr f) z := by
  rw [transf_autocorr hf hs (-z), transf_autocorr hf hs z,
    show -(star (-z)) = star z from by rw [star_neg, neg_neg],
    transf_neg_arg hodd z, transf_neg_arg hodd (star z), star_neg]
  ring
theorem poleBlock_eq_neg_polarForm {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    poleBlock f = -(polarForm a f) := by
  unfold poleBlock
  rw [transf_autocorr_neg hf.1.1.continuous hf.1.2.1 hf.1.2.2 (1 / 2),
    polarForm_eq_neg_two_transf_autocorr' hf]
  ring
theorem primeBlock_eq_shiftForm {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    primeBlock a f = shiftForm a f := by
  unfold primeBlock shiftForm
  refine Finset.sum_congr rfl fun q _ => ?_
  congr 1
  congr 1
  have hsuppg : Function.support (fun x : ℝ => f x * star (f (x + shiftLength q)))
      ⊆ Set.Ioo (-a) a := by
    intro x hx
    have hfx : f x ≠ 0 := fun h => hx (by simp [h])
    exact hf.2 hfx
  have htransfer : (∫ x : ℝ, f x * star (f (x + shiftLength q)))
      = ∫ x in Set.Ioo (-a) a, f x * star (f (x + shiftLength q)) := by
    have hsupp_eq : (∫ x : ℝ, f x * star (f (x + shiftLength q)))
        = ∫ x : ℝ, (Set.Ioo (-a) a).indicator
            (fun x : ℝ => f x * star (f (x + shiftLength q))) x := by
      apply integral_congr_ae
      filter_upwards with x
      by_cases hx : x ∈ Set.Ioo (-a) a
      · rw [Set.indicator_of_mem hx]
      · rw [Set.indicator_of_notMem hx]
        have hzero : f x = 0 := by
          by_contra h
          exact hx (hf.2 (show x ∈ Function.support f from h))
        rw [hzero, zero_mul]
    rw [hsupp_eq, MeasureTheory.integral_indicator measurableSet_Ioo]
  have hconj : star (autocorr f (shiftLength q))
      = ∫ x : ℝ, f x * star (f (x + shiftLength q)) := by
    rw [autocorr]
    rw [show star (∫ x : ℝ, f (x + shiftLength q) * star (f x))
        = (starRingEnd ℂ) (∫ x : ℝ, f (x + shiftLength q) * star (f x))
        from starRingEnd_apply _]
    rw [← integral_conj (μ := volume) (𝕜 := ℂ)]
    apply integral_congr_ae
    filter_upwards with x
