namespace RHLean.ExplicitFormula
instance xiZeroCountable : Countable XiZero := by
  let f : XiZero → {z : ℂ // z ∈ (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ)).support} × ℕ :=
    fun p =>
      (⟨Complex.Hadamard.divisorZeroIndex₀_val p,
          Complex.Hadamard.divisorZeroIndex₀_val_mem_divisor_support' p⟩,
        (p.1.2 : ℕ))
  haveI : Countable
      {z : ℂ // z ∈ (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ)).support} :=
    (MeromorphicOn.divisor_support_countable riemannXi (Set.univ : Set ℂ)).to_subtype
  have hf : Function.Injective f := by
    intro p q hpq
    have hval : Complex.Hadamard.divisorZeroIndex₀_val p =
        Complex.Hadamard.divisorZeroIndex₀_val q :=
      congrArg (fun x => (x.1 : ℂ)) hpq
    have hfin : (p.1.2 : ℕ) = (q.1.2 : ℕ) := congrArg Prod.snd hpq
    apply Subtype.ext
    exact Sigma.ext hval ((Fin.heq_ext_iff (congrArg (fun z : ℂ =>
      Int.toNat (MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ) z)) hval)).mpr hfin)
  exact hf.countable
theorem logDeriv_comp_add_const (f : ℂ → ℂ) (c : ℂ) (hf : Differentiable ℂ f) :
    (fun u : ℂ => logDeriv f (c + u)) = logDeriv (fun u : ℂ => f (c + u)) := by
  funext u
  rw [logDeriv_apply, logDeriv_apply]
  have hd : deriv (fun u : ℂ => f (c + u)) u = deriv f (c + u) := by
    have h := deriv_comp (h₂ := f) (h := fun v : ℂ => c + v) (x := u)
      hf.differentiableAt (by fun_prop)
    change deriv (f ∘ fun v : ℂ => c + v) u = deriv f (c + u)
    simpa using h
  rw [hd]
theorem exists_factorization_centered (p : XiZero) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ (fun u : ℂ => g ((1 / 2 : ℂ) + u)) (centeredZero p) ∧
      (fun u : ℂ => g ((1 / 2 : ℂ) + u)) (centeredZero p) ≠ 0 ∧
      (fun u : ℂ => riemannXi ((1 / 2 : ℂ) + u)) =ᶠ[𝓝 (centeredZero p)]
        (fun u : ℂ => (u - centeredZero p) ^
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p)) *
            g ((1 / 2 : ℂ) + u)) := by
  obtain ⟨g, hg, hg0, hgfac⟩ := exists_factorization p
  have hy : (1 / 2 : ℂ) + centeredZero p = Complex.Hadamard.divisorZeroIndex₀_val p := by
    rw [centeredZero]
    ring
  have hshift : Tendsto (fun u : ℂ => (1 / 2 : ℂ) + u) (𝓝 (centeredZero p))
      (𝓝 (Complex.Hadamard.divisorZeroIndex₀_val p)) := by
    have hcont : Tendsto (fun u : ℂ => (1 / 2 : ℂ) + u) (𝓝 (centeredZero p))
        (𝓝 ((1 / 2 : ℂ) + centeredZero p)) := tendsto_const_nhds.add tendsto_id
    rwa [hy] at hcont
  refine ⟨g, ?_, ?_, ?_⟩
  · have hshiftAt : AnalyticAt ℂ (fun u : ℂ => (1 / 2 : ℂ) + u) (centeredZero p) := by
      fun_prop
    exact AnalyticAt.comp_of_eq hg hshiftAt hy
  · convert hg0 using 1
    rw [centeredZero]
    ring
  · have h0 := hgfac.comp_tendsto hshift
    filter_upwards [h0] with u hu
    simp only [Function.comp_apply] at hu
    rw [hu, show ((1 / 2 : ℂ) + u) - Complex.Hadamard.divisorZeroIndex₀_val p =
      u - centeredZero p by rw [centeredZero]; ring]
theorem exists_principalPart_logDeriv_centered (p : XiZero) :
    ∃ G : ℂ → ℂ, AnalyticAt ℂ G (centeredZero p) ∧
      (fun u : ℂ => logDeriv riemannXi ((1 / 2 : ℂ) + u)) =ᶠ[𝓝[≠] (centeredZero p)]
        (fun u : ℂ =>
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) : ℂ) /
            (u - centeredZero p) + G u) := by
  obtain ⟨g, hg_shift, hg0_shift, hgfac_c⟩ := exists_factorization_centered p
  refine ⟨logDeriv (fun u : ℂ => g ((1 / 2 : ℂ) + u)), ?_, ?_⟩
  · rw [logDeriv]
    exact hg_shift.deriv.div hg_shift hg0_shift
  · have hchain : (fun u : ℂ => logDeriv riemannXi ((1 / 2 : ℂ) + u)) =
        logDeriv (fun u : ℂ => riemannXi ((1 / 2 : ℂ) + u)) :=
      logDeriv_comp_add_const riemannXi (1 / 2 : ℂ) differentiable_riemannXi
    rw [hchain]
    have hcongr := logDeriv_congr_nhds hgfac_c
    have hgnz : ∀ᶠ u in 𝓝 (centeredZero p), g ((1 / 2 : ℂ) + u) ≠ 0 :=
      hg_shift.continuousAt.eventually_ne hg0_shift
    have hgdiff : ∀ᶠ u in 𝓝 (centeredZero p),
        DifferentiableAt ℂ (fun u : ℂ => g ((1 / 2 : ℂ) + u)) u := by
      obtain ⟨pfs, hpfs⟩ := hg_shift
      exact hpfs.eventually_differentiableAt
    have hrhs : logDeriv (fun u : ℂ => (u - centeredZero p) ^
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p)) *
            g ((1 / 2 : ℂ) + u)) =ᶠ[𝓝[≠] (centeredZero p)]
        (fun u : ℂ =>
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) : ℂ) /
            (u - centeredZero p) + logDeriv (fun u : ℂ => g ((1 / 2 : ℂ) + u)) u) := by
      filter_upwards [hgnz.filter_mono nhdsWithin_le_nhds,
        hgdiff.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin]
        with u hgnz_u hgdz_u hune
      have hune' : u ≠ centeredZero p := hune
      change logDeriv ((fun u : ℂ => (u - centeredZero p) ^
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p))) *
            (fun u : ℂ => g ((1 / 2 : ℂ) + u))) u = _
      rw [logDeriv_mul
        (f := fun u : ℂ => (u - centeredZero p) ^
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p)))
        (g := fun u : ℂ => g ((1 / 2 : ℂ) + u)) u
        (pow_ne_zero _ (sub_ne_zero.mpr hune')) hgnz_u (by fun_prop) hgdz_u, logDeriv_sub_pow]
    exact (hcongr.filter_mono nhdsWithin_le_nhds).trans hrhs
theorem centeredZero_fiberFinset_card (p : XiZero) :
    (Complex.Hadamard.divisorZeroIndex₀_fiberFinset riemannXi
