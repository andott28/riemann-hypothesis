theorem transf_mul_eq_neg_transf_deriv {g : ℝ → ℂ} {z : ℂ} {R : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ y : ℝ, R < |y| → g y = 0)
    (hdiff : ∀ y : ℝ, HasDerivAt g (deriv g y) y)
    (hcont : Continuous (deriv g)) :
    z * transf g z = -transf (deriv g) z := by
  have hexp : Continuous fun y : ℝ => cexp (z * (y : ℂ)) :=
    Complex.continuous_exp.comp (continuous_const.mul continuous_ofReal)
  have hker : ∀ y : ℝ, HasDerivAt (fun y : ℝ => cexp (z * (y : ℂ)))
      (cexp (z * (y : ℂ)) * z) y := by
    intro y
    have h1 : HasDerivAt (fun y : ℝ => z * (y : ℂ)) (z * 1) y :=
      (Complex.ofRealCLM.hasDerivAt (x := y)).const_mul z
    have h2 : HasDerivAt (fun y : ℝ => cexp (z * (y : ℂ)))
        (cexp (z * (y : ℂ)) * (z * 1)) y := h1.cexp
    simpa using h2
  have hF : ∀ y : ℝ, HasDerivAt (fun y : ℝ => g y * cexp (z * (y : ℂ)))
      (deriv g y * cexp (z * (y : ℂ)) + g y * (cexp (z * (y : ℂ)) * z)) y :=
    fun y => (hdiff y).mul (hker y)
  have hgcont : Continuous g :=
    continuous_iff_continuousAt.mpr fun y => (hdiff y).continuousAt
  have hFcont : Continuous fun y : ℝ =>
      deriv g y * cexp (z * (y : ℂ)) + g y * (cexp (z * (y : ℂ)) * z) :=
    (hcont.mul hexp).add (hgcont.mul (hexp.mul continuous_const))
  set S : ℝ := R + 1 with hSdef
  have hS0 : 0 < S := by rw [hSdef]; linarith
  have hSgt : R < S := by rw [hSdef]; linarith
  have hlt_outer : ∀ y : ℝ, S ≤ |y| → g y = 0 := fun y hy => hR y (lt_of_lt_of_le hSgt hy)
  have hFT := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (f := fun y : ℝ => g y * cexp (z * (y : ℂ)))
    (f' := fun y : ℝ => deriv g y * cexp (z * (y : ℂ)) + g y * (cexp (z * (y : ℂ)) * z))
    (fun y _ => hF y) (hFcont.intervalIntegrable (-S) S)
  have habs_neg : |-S| = S := by rw [abs_neg, abs_of_pos hS0]
  have hzero : (∫ y in (-S)..S, (deriv g y * cexp (z * (y : ℂ))
      + g y * (cexp (z * (y : ℂ)) * z))) = 0 := by
    rw [hFT, hlt_outer S (le_of_eq (abs_of_pos hS0).symm),
      hlt_outer (-S) (le_of_eq habs_neg.symm)]
    simp
  have hsplit : (∫ y in (-S)..S, (deriv g y * cexp (z * (y : ℂ))
        + g y * (cexp (z * (y : ℂ)) * z)))
      = (∫ y in (-S)..S, deriv g y * cexp (z * (y : ℂ)))
        + z * (∫ y in (-S)..S, g y * cexp (z * (y : ℂ))) := by
    rw [intervalIntegral.integral_add]
    · rw [show (∫ y in (-S)..S, g y * (cexp (z * (y : ℂ)) * z))
          = ∫ y in (-S)..S, (g y * cexp (z * (y : ℂ))) * z from
        intervalIntegral.integral_congr fun y _ => by ring]
      rw [intervalIntegral.integral_mul_const]
      ring
    · exact (hcont.mul hexp).intervalIntegrable _ _
    · exact (hgcont.mul (hexp.mul continuous_const)).intervalIntegrable _ _
  have h_away_of : ∀ y : ℝ, y ∉ Set.Ioc (-S) S → R < |y| := by
    intro y hy
    rw [Set.mem_Ioc] at hy
    have hcases : y ≤ -S ∨ S < y := by
      by_cases h1 : -S < y
      · exact Or.inr (not_le.mp (fun h2 => hy ⟨h1, h2⟩))
      · exact Or.inl (not_lt.mp h1)
    rcases hcases with h | h
    · rw [abs_of_neg (by linarith)]
      linarith
    · rw [abs_of_pos (by linarith)]
      linarith
  have hg_out : ∀ y : ℝ, y ∉ Set.Ioc (-S) S → g y * cexp (z * (y : ℂ)) = 0 := by
    intro y hy
    rw [hR y (h_away_of y hy), zero_mul]
  have hdg_out : ∀ y : ℝ, y ∉ Set.Ioc (-S) S → deriv g y * cexp (z * (y : ℂ)) = 0 := by
    intro y hy
    have h_away : R < |y| := h_away_of y hy
    have hev : g =ᶠ[𝓝 y] 0 := by
      filter_upwards [isOpen_lt continuous_const continuous_abs |>.mem_nhds h_away] with y' hy'
      exact hR y' hy'
    have hzero' : deriv g y = 0 := by
      rw [hev.deriv_eq]
      exact deriv_const y 0
    rw [hzero', zero_mul]
  have hA : (∫ y in (-S)..S, deriv g y * cexp (z * (y : ℂ))) = transf (deriv g) z := by
    rw [intervalIntegral.integral_of_le (by linarith : -S ≤ S)]
    exact setIntegral_eq_integral_of_forall_compl_eq_zero hdg_out
  have hB : (∫ y in (-S)..S, g y * cexp (z * (y : ℂ))) = transf g z := by
    rw [intervalIntegral.integral_of_le (by linarith : -S ≤ S)]
    exact setIntegral_eq_integral_of_forall_compl_eq_zero hg_out
  rw [hsplit, hA, hB] at hzero
  linear_combination hzero
end RHLean.ExplicitFormula
end
