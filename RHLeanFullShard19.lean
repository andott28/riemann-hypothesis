  have hexp : (((-(2 * Real.pi) * w : ℝ)) : ℂ) * I * (↑v)
      = ((2 * Real.pi * -(v * w) : ℝ) : ℂ) * I := by
    rw [mul_assoc, mul_comm I (↑v), ← mul_assoc, ofReal_neg_two_pi_mul_mul]
