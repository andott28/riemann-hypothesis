theorem summable_centered_logDerivTerms {w : ℂ}
    (hw : ∀ p : XiZero, (1 / 2 : ℂ) + w ≠ Complex.Hadamard.divisorZeroIndex₀_val p) :
    Summable (fun p : XiZero =>
      1 / (w - centeredZero p) + 1 / ((1 / 2 : ℂ) + centeredZero p)) := by
  have h := summable_riemannXi_logDerivTerms_divisorZeroIndex₀
    (z := (1 / 2 : ℂ) + w) hw
  refine h.congr fun p => ?_
  have hv : (1 / 2 : ℂ) + centeredZero p =
      Complex.Hadamard.divisorZeroIndex₀_val p := by
    rw [centeredZero]
    ring
  have hw' : (1 / 2 : ℂ) + w - Complex.Hadamard.divisorZeroIndex₀_val p =
      w - centeredZero p := by
    rw [centeredZero]
    ring
