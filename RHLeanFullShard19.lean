  · have hcont : Continuous fun y : ℝ => ((ε / (ε ^ 2 + y ^ 2) : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp
        (continuous_const.div (by fun_prop) (fun y => by positivity))
    exact hcont.intervalIntegrable _ _
  · have hcont : Continuous fun y : ℝ => ((y / (ε ^ 2 + y ^ 2) : ℝ) : ℂ) * I :=
      (Complex.continuous_ofReal.comp
        (continuous_id.div (by fun_prop) (fun y => by positivity))).mul continuous_const
    exact hcont.intervalIntegrable _ _
theorem tendsto_integral_subtracted {h : ℝ → ℂ} {C : ℝ} (hcont : Continuous h)
    (hC0 : 0 ≤ C) (hC : ∀ y : ℝ, ‖h y - h 0‖ ≤ C * |y|) {T : ℝ} (hT : 0 < T) :
    Tendsto (fun ε : ℝ => ∫ y in (-T)..T, (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
      (𝓝[>] (0 : ℝ)) (𝓝 (∫ y in (-T)..T, (h y - h 0) / ((y : ℂ) * I))) := by
  have hle : -T ≤ T := by linarith
  have hpt : ∀ y : ℝ, Tendsto (fun ε : ℝ => (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
      (𝓝[>] (0 : ℝ)) (𝓝 ((h y - h 0) / ((y : ℂ) * I))) := by
    intro y
    by_cases hy : y = 0
    · subst hy
      simp
    · have hyC : (y : ℂ) ≠ 0 := by simpa using hy
      have hyI : ((y : ℂ) * I) ≠ 0 := mul_ne_zero hyC Complex.I_ne_zero
      have hden : Tendsto (fun ε : ℝ => ((ε : ℂ) + (y : ℂ) * I)) (𝓝 (0 : ℝ))
          (𝓝 ((y : ℂ) * I)) := by
        simpa using (Complex.continuous_ofReal.tendsto (0 : ℝ)).add tendsto_const_nhds
      exact (Tendsto.div tendsto_const_nhds hden hyI).mono_left nhdsWithin_le_nhds
  have hbound : ∀ᶠ (ε : ℝ) in (𝓝[>] (0 : ℝ)), ∀ᵐ y ∂(volume.restrict (Set.Ioc (-T) T)),
      ‖(h y - h 0) / ((ε : ℂ) + (y : ℂ) * I)‖ ≤ C :=
    Filter.Eventually.of_forall fun (ε : ℝ) => Filter.Eventually.of_forall fun (y : ℝ) => by
      by_cases hy : y = 0
      · subst hy
        simp
        exact hC0
      · have hden : |y| ≤ ‖(ε : ℂ) + (y : ℂ) * I‖ := by
          have := Complex.abs_im_le_norm ((ε : ℂ) + (y : ℂ) * I)
          simpa using this
        have hdpos : 0 < ‖(ε : ℂ) + (y : ℂ) * I‖ :=
          lt_of_lt_of_le (abs_pos.mpr hy) hden
        rw [norm_div, div_le_iff₀ hdpos]
        calc ‖h y - h 0‖ ≤ C * |y| := hC y
          _ ≤ C * ‖(ε : ℂ) + (y : ℂ) * I‖ := mul_le_mul_of_nonneg_left hden hC0
  have hden : ∀ (ε : ℝ), 0 < ε → ∀ y : ℝ, ((ε : ℂ) + (y : ℂ) * I) ≠ 0 := by
    intro ε hε y hy
    have him := congrArg Complex.im hy
    have hre := congrArg Complex.re hy
    simp at him hre
    linarith
  have hmeas : ∀ᶠ (ε : ℝ) in (𝓝[>] (0 : ℝ)),
      AEStronglyMeasurable (fun y : ℝ => (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
        (volume.restrict (Set.Ioc (-T) T)) := by
    filter_upwards [self_mem_nhdsWithin] with ε hε
    exact ((hcont.sub continuous_const).div
      (continuous_const.add ((Complex.continuous_ofReal.comp continuous_id).mul continuous_const))
      (hden ε hε)).aestronglyMeasurable
  have hmain := MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (μ := volume.restrict (Set.Ioc (-T) T)) (l := 𝓝[>] (0 : ℝ))
    (F := fun (ε : ℝ) (y : ℝ) => (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
    (f := fun y : ℝ => (h y - h 0) / ((y : ℂ) * I)) (fun _ => C)
    hmeas hbound (integrable_const C) (Filter.Eventually.of_forall fun y => hpt y)
  simpa only [intervalIntegral.integral_of_le hle] using hmain
theorem poleAbelAt_of_continuous {h : ℝ → ℂ} {C : ℝ} (hcont : Continuous h)
    (hC0 : 0 ≤ C) (hC : ∀ y : ℝ, ‖h y - h 0‖ ≤ C * |y|) {T : ℝ} (hT : 0 < T) :
    PoleAbelAt T h := by
  have hsub := tendsto_integral_subtracted hcont hC0 hC hT
  have hquot : Tendsto (fun ε : ℝ => T / ε) (𝓝[>] (0 : ℝ)) atTop := by
    have h1 := tendsto_inv_nhdsGT_zero (𝕜 := ℝ)
    have h2 := h1.const_mul_atTop hT
    simpa [div_eq_mul_inv] using h2
  have harctan_re : Tendsto (fun ε : ℝ => 2 * Real.arctan (T / ε)) (𝓝[>] (0 : ℝ))
      (𝓝 Real.pi) := by
    have h3 := (Real.tendsto_arctan_atTop.comp hquot).mono_right nhdsWithin_le_nhds
    have h4 := h3.const_mul 2
    have h5 : (2 : ℝ) * (Real.pi / 2) = Real.pi := by ring
    rwa [h5] at h4
  have harctan : Tendsto (fun ε : ℝ => ((2 * Real.arctan (T / ε) : ℝ) : ℂ))
      (𝓝[>] (0 : ℝ)) (𝓝 ((Real.pi : ℝ) : ℂ)) :=
    Complex.continuous_ofReal.continuousAt.tendsto.comp harctan_re
  have hden : ∀ (ε : ℝ), 0 < ε → ∀ y : ℝ, ((ε : ℂ) + (y : ℂ) * I) ≠ 0 := by
    intro ε hε y hy
    have him := congrArg Complex.im hy
    have hre := congrArg Complex.re hy
    simp at him hre
    linarith
  have hsplit : ∀ ε : ℝ, 0 < ε →
      (∫ y in (-T)..T, h y * (1 / ((ε : ℂ) + (y : ℂ) * I)))
        = (∫ y in (-T)..T, (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
          + h 0 * ((2 * Real.arctan (T / ε) : ℝ) : ℂ) := by
    intro ε hε
    have hpt : ∀ y : ℝ, h y * (1 / ((ε : ℂ) + (y : ℂ) * I))
        = (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I)
          + h 0 * (1 / ((ε : ℂ) + (y : ℂ) * I)) := by
      intro y
      ring
    rw [show (∫ y in (-T)..T, h y * (1 / ((ε : ℂ) + (y : ℂ) * I)))
        = ∫ y in (-T)..T, ((h y - h 0) / ((ε : ℂ) + (y : ℂ) * I)
            + h 0 * (1 / ((ε : ℂ) + (y : ℂ) * I))) from
      intervalIntegral.integral_congr fun y _ => hpt y]
    rw [intervalIntegral.integral_add]
    · rw [intervalIntegral.integral_const_mul, integral_one_div_eps_add_mul_I T hε]
    · have hc : Continuous fun y : ℝ => (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I) :=
        (hcont.sub continuous_const).div
          (continuous_const.add ((Complex.continuous_ofReal.comp continuous_id).mul
            continuous_const))
          (hden ε hε)
      exact hc.intervalIntegrable _ _
    · have hc : Continuous fun y : ℝ => h 0 * (1 / ((ε : ℂ) + (y : ℂ) * I)) :=
        continuous_const.mul (continuous_const.div
          (continuous_const.add ((Complex.continuous_ofReal.comp continuous_id).mul
            continuous_const))
          (hden ε hε))
      exact hc.intervalIntegrable _ _
  have htarget : Tendsto (fun ε : ℝ =>
      (∫ y in (-T)..T, (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
        + h 0 * ((2 * Real.arctan (T / ε) : ℝ) : ℂ))
      (𝓝[>] (0 : ℝ))
      (𝓝 ((∫ y in (-T)..T, (h y - h 0) / ((y : ℂ) * I)) + h 0 * (Real.pi : ℂ))) :=
    hsub.add (harctan.const_mul (h 0))
  have hcongr : (fun ε : ℝ =>
        (∫ y in (-T)..T, (h y - h 0) / ((ε : ℂ) + (y : ℂ) * I))
          + h 0 * ((2 * Real.arctan (T / ε) : ℝ) : ℂ))
      =ᶠ[𝓝[>] (0 : ℝ)] (fun ε : ℝ => ∫ y in (-T)..T, h y * (1 / ((ε : ℂ) + (y : ℂ) * I))) := by
    filter_upwards [self_mem_nhdsWithin] with ε hε
    exact (hsplit ε hε).symm
  have hres := htarget.congr' hcongr
  have hlim_eq : (∫ y in (-T)..T, (h y - h 0) / ((y : ℂ) * I)) + h 0 * (Real.pi : ℂ)
      = Real.pi * h 0 + ∫ y in (-T)..T, (h y - h 0) * (1 / ((y : ℂ) * I)) := by
    have hint_eq : (∫ y in (-T)..T, (h y - h 0) / ((y : ℂ) * I))
        = ∫ y in (-T)..T, (h y - h 0) * (1 / ((y : ℂ) * I)) := by
      apply intervalIntegral.integral_congr
      intro y _
      show (h y - h 0) / ((y : ℂ) * I) = (h y - h 0) * (1 / ((y : ℂ) * I))
      rw [div_eq_mul_inv, one_div]
    rw [hint_eq]
    ring
  unfold PoleAbelAt
  rw [hlim_eq] at hres
  exact hres
end RHLean.ExplicitFormula
