  have hδ₁0 : 0 < δ₁ := lt_min (by linarith [hre.1]) (by linarith [hre.2])
  have hden : 0 < M + D + 1 := by linarith
  set δ₃ : ℝ := (m : ℝ) / (M + D + 1) with hδ₃
  have hδ₃0 : 0 < δ₃ := div_pos (by exact_mod_cast hm) hden
  set r : ℝ := min (δ₁ / 2) (min (δ / 2) (δ₃ / 2)) with hr
