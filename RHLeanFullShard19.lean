theorem norm_hadamardTerm_sep {T : ℝ} {μ : ℂ} {x : ℝ}
    (hsep1 : T ≠ μ.im) (hsep2 : T ≠ -μ.im) :
    ‖((x : ℂ) + (T : ℂ) * I) / (((x : ℂ) + (T : ℂ) * I) ^ 2 - μ ^ 2)‖
