section Inline_ExplicitFormula_RH4
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
def rectBoundary (z w : ℂ) : Set ℂ := rectClosed z w \ rectOpen z w
theorem isCompact_rectClosed (z w : ℂ) : IsCompact (rectClosed z w) := by
  have h : rectClosed z w =
      reProdIm (Set.Icc (min z.re w.re) (max z.re w.re))
        (Set.Icc (min z.im w.im) (max z.im w.im)) := by
    ext u
    simp only [rectClosed, Set.mem_setOf_eq, reProdIm, Set.mem_preimage, Set.mem_inter_iff,
      Set.mem_Icc]
    tauto
  rw [h]
  exact isCompact_Icc.reProdIm isCompact_Icc
theorem isOpen_rectOpen (z w : ℂ) : IsOpen (rectOpen z w) := by
  have h : rectOpen z w =
      {u : ℂ | min z.re w.re < u.re} ∩ {u : ℂ | u.re < max z.re w.re} ∩
        {u : ℂ | min z.im w.im < u.im} ∩ {u : ℂ | u.im < max z.im w.im} := by
    ext u
    simp only [rectOpen, Set.mem_setOf_eq, Set.mem_inter_iff]
    tauto
  rw [h]
  refine IsOpen.inter (IsOpen.inter (IsOpen.inter ?_ ?_) ?_) ?_
  · exact isOpen_lt continuous_const Complex.continuous_re
  · exact isOpen_lt Complex.continuous_re continuous_const
  · exact isOpen_lt continuous_const Complex.continuous_im
  · exact isOpen_lt Complex.continuous_im continuous_const
theorem isClosed_rectClosed (z w : ℂ) : IsClosed (rectClosed z w) :=
  (isCompact_rectClosed z w).isClosed
theorem isCompact_rectBoundary (z w : ℂ) : IsCompact (rectBoundary z w) := by
  have hclosed : IsClosed (rectBoundary z w) := by
    have h : rectBoundary z w = rectClosed z w ∩ (rectOpen z w)ᶜ := by
      ext u
      simp only [rectBoundary, Set.mem_diff, Set.mem_inter_iff, Set.mem_compl_iff]
    rw [h]
    exact (isClosed_rectClosed z w).inter (isOpen_rectOpen z w).isClosed_compl
  exact (isCompact_rectClosed z w).of_isClosed_subset hclosed Set.diff_subset
theorem summable_one_div_one_add_norm_sq :
    Summable (fun p : XiZero => 1 / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) := by
  refine Summable.of_nonneg_of_le (fun p => by positivity) (fun p => ?_)
    summable_riemannXi_divisorZeroIndex₀_norm_inv_sq
  calc 1 / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) ≤
        1 / ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 :=
        one_div_le_one_div_of_le
          (pow_pos (norm_pos_iff.mpr (Complex.Hadamard.divisorZeroIndex₀_val_ne_zero p)) 2)
          (by nlinarith [norm_nonneg (Complex.Hadamard.divisorZeroIndex₀_val p)])
    _ = ‖Complex.Hadamard.divisorZeroIndex₀_val p‖⁻¹ ^ 2 := by rw [one_div, inv_pow]
theorem centeredZero_not_mem_rectBoundary (z w : ℂ)
    (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w)
    (p : XiZero) : centeredZero p ∉ rectBoundary z w :=
  fun h => h.2 (hbound p h.1)
theorem continuousOn_hadamardSummand (z w : ℂ)
    (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w)
    (p : XiZero) :
    ContinuousOn
      (fun u : ℂ => 1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p)
      (rectBoundary z w) := by
  refine ContinuousOn.add ?_ continuousOn_const
  refine ContinuousOn.div continuousOn_const
    (continuousOn_id.sub continuousOn_const) ?_
  intro u hu h
  have hueq : u = centeredZero p := sub_eq_zero.mp h
  exact centeredZero_not_mem_rectBoundary z w hbound p (by rw [← hueq]; exact hu)
theorem exists_bound_centeredZero_summand (z w : ℂ)
    (hbound : ∀ p : XiZero, centeredZero p ∈ rectClosed z w → centeredZero p ∈ rectOpen z w) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p : XiZero, ∀ u : ℂ, u ∈ rectBoundary z w →
      ‖1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤
        C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) := by
  obtain ⟨R, hR⟩ := (isCompact_rectClosed z w).exists_bound_of_continuousOn
    (continuous_id.add continuous_const : Continuous (fun u : ℂ => u + 1 / 2)).continuousOn
  set K : ℝ := 2 * max R 1 with hK
  have hK1 : 1 ≤ max R 1 := le_max_right _ _
  have hKpos : 0 < K := by rw [hK]; positivity
  have hRle : R ≤ K / 2 := by
    rw [hK]; linarith [le_max_left R 1]
  have hfin : ({p : XiZero | ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤ K} : Set XiZero).Finite :=
    Complex.Hadamard.divisorZeroIndex₀_norm_le_finite (f := riemannXi) (U := Set.univ) K (by simp)
  let P : Finset XiZero := hfin.toFinset
  have hPmem : ∀ p : XiZero, p ∈ P ↔ ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤ K := by
    intro p; simp [P]
  have hC : ∀ p : XiZero, ∃ C_p : ℝ, ∀ u ∈ rectBoundary z w,
      ‖1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤ C_p := by
    intro p
    exact (isCompact_rectBoundary z w).exists_bound_of_continuousOn
      (continuousOn_hadamardSummand z w hbound p)
  choose Cp hCp using hC
  let C₁ : ℝ := if h : P.Nonempty then P.sup' h (fun p => Cp p * (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) else 0
  refine ⟨max (8 * max R 1) C₁, le_trans (by nlinarith [le_max_right R 1]) (le_max_left _ _),
    fun p u hu => ?_⟩
  have hvalne : Complex.Hadamard.divisorZeroIndex₀_val p ≠ 0 :=
    Complex.Hadamard.divisorZeroIndex₀_val_ne_zero p
  have hvalpos : 0 < ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ := norm_pos_iff.mpr hvalne
  have hRn : 0 ≤ R := le_trans (norm_nonneg _) (hR z (by simp [rectClosed]))
  have hune : u ≠ centeredZero p := fun h =>
    centeredZero_not_mem_rectBoundary z w hbound p (by rw [← h]; exact hu)
  have hnum : ‖u + 1 / 2‖ ≤ R := hR u hu.1
  by_cases hsmall : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤ K
  ·
    have hp : p ∈ P := (hPmem p).mpr hsmall
    have hle : Cp p * (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) ≤ C₁ := by
      have hne : P.Nonempty := ⟨p, hp⟩
      rw [show C₁ = P.sup' hne (fun q => Cp q * (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val q‖ ^ 2)) by
        simp only [C₁, dif_pos hne]]
      exact Finset.le_sup' (fun q => Cp q * (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val q‖ ^ 2)) hp
    have hden : 0 < 1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 := by positivity
    have h1 : Cp p ≤ C₁ / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) := by
      rw [le_div_iff₀ hden]
      linarith
    exact (hCp p u hu).trans (h1.trans (div_le_div_of_nonneg_right (le_max_right _ _) hden.le))
  ·
    push_neg at hsmall
    have hhalf : R ≤ ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2 := by linarith
    have hdecomp : u - centeredZero p = (u + 1 / 2) - Complex.Hadamard.divisorZeroIndex₀_val p := by
      rw [centeredZero]; ring
    have hden : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2 ≤ ‖u - centeredZero p‖ := by
      rw [hdecomp]
      have hge : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ - ‖u + 1 / 2‖ ≤
          ‖(u + 1 / 2) - Complex.Hadamard.divisorZeroIndex₀_val p‖ := by
        have h := abs_norm_sub_norm_le (Complex.Hadamard.divisorZeroIndex₀_val p) (u + 1 / 2)
        rw [norm_sub_rev] at h
        linarith [le_abs_self (‖Complex.Hadamard.divisorZeroIndex₀_val p‖ - ‖u + 1 / 2‖)]
      linarith
    have hdenpos : 0 < ‖u - centeredZero p‖ := lt_of_lt_of_le (by positivity) hden
    have hid : 1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p =
        (u + 1 / 2) / ((u - centeredZero p) * Complex.Hadamard.divisorZeroIndex₀_val p) := by
      have h1 : u - centeredZero p ≠ 0 := sub_ne_zero.mpr hune
      rw [div_add_div 1 1 h1 hvalne]
      rw [show 1 * Complex.Hadamard.divisorZeroIndex₀_val p +
          (u - centeredZero p) * 1 = u + 1 / 2 by rw [centeredZero]; ring]
    have hstep : ‖1 / (u - centeredZero p) + 1 / Complex.Hadamard.divisorZeroIndex₀_val p‖ ≤
        2 * R / ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 := by
      rw [hid, norm_div, norm_mul]
      calc ‖u + 1 / 2‖ / (‖u - centeredZero p‖ * ‖Complex.Hadamard.divisorZeroIndex₀_val p‖) ≤
            R / (‖u - centeredZero p‖ * ‖Complex.Hadamard.divisorZeroIndex₀_val p‖) :=
            div_le_div_of_nonneg_right hnum (by positivity)
        _ ≤ R / ((‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2) *
              ‖Complex.Hadamard.divisorZeroIndex₀_val p‖) := by
            rw [div_le_div_iff₀ (by positivity) (by positivity)]
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right hden hvalpos.le) hRn
        _ = 2 * R / ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 := by
            have h : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ≠ 0 :=
              norm_ne_zero_iff.mpr hvalne
            have h2 : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2 ≠ 0 :=
              div_ne_zero h (by norm_num)
            rw [div_eq_div_iff (mul_ne_zero h2 h) (pow_ne_zero 2 h)]
            ring
    have ht2 : 1 ≤ ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 := by
      nlinarith [hvalpos, hK1, hsmall.le]
    have hstep2 : 2 * R / ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 ≤
        (8 * max R 1) / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith [le_max_left R 1, le_max_right R 1, ht2, hK1, hR, hnum]
    exact hstep.trans (hstep2.trans (div_le_div_of_nonneg_right (le_max_left _ _) (by positivity)))
end RHLean.ExplicitFormula
