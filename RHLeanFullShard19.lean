section Inline_ExplicitFormula_RH9
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
theorem tendsto_log_sq_div_cube :
    Tendsto (fun T : ℝ => (Real.log (1 + T)) ^ 2 / (1 + T) ^ 3) atTop (𝓝 0) := by
  have hshift : Tendsto (fun T : ℝ => (1 : ℝ) + T) atTop atTop :=
    tendsto_atTop_add_const_left atTop (1 : ℝ) tendsto_id
  have hone : Tendsto (fun T : ℝ => Real.log (1 + T) / (1 + T)) atTop (𝓝 0) := by
