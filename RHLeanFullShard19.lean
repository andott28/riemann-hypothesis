          * Complex.exp (2 * (Real.pi : ℂ) * I * (x : ℂ) * (w : ℂ)) := by
    have h := MeasureTheory.Measure.integral_comp_mul_left
      (fun r : ℝ => spectralTest f r * Complex.exp (-(Complex.I * (x : ℂ)) * (r : ℂ)))
      (-(2 * Real.pi))
    have hG : (fun w : ℝ => spectralTest f ((-(2 * Real.pi)) * w)
