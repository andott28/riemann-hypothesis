lemma boxMid_mem (lo hi : Matrix (Fin 7) (Fin 7) ℚ)
    (h : ∀ i j, lo i j ≤ hi i j) :
    Y7AssemblyBox.InBox lo hi (boxMid lo hi) := by
  intro i j
  constructor
  · have hr : ((lo i j : ℚ) : ℝ) ≤ ((hi i j : ℚ) : ℝ) := by exact_mod_cast h i j
    simp only [boxMid]
    push_cast
    linarith
  · have hr : ((lo i j : ℚ) : ℝ) ≤ ((hi i j : ℚ) : ℝ) := by exact_mod_cast h i j
    simp only [boxMid]
    push_cast
    linarith
theorem boxesOK_centers :
    Y7AssemblyBox.InBox Y7AssemblyBox.AUlo Y7AssemblyBox.AUhi
        (boxMid Y7AssemblyBox.AUlo Y7AssemblyBox.AUhi) ∧
      Y7AssemblyBox.InBox Y7AssemblyBox.WLlo Y7AssemblyBox.WLhi
