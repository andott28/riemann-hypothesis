theorem ne_left_re_of_mem_rectOpen {z w c : ℂ} (hc : c ∈ rectOpen z w) :
    z.re ≠ c.re := by
  intro h
  have hmin := hc.1
  have hmax := hc.2.1
  rw [h] at hmin hmax
  rcases min_choice c.re w.re with hm | hm
  · rw [hm] at hmin
    exact lt_irrefl _ hmin
  · rw [hm] at hmin
    have hw : w.re < c.re := hmin
    rcases max_choice c.re w.re with hM | hM
    · rw [hM] at hmax
      exact lt_irrefl _ hmax
    · rw [hM] at hmax
      exact not_lt.mpr hw.le hmax
theorem ne_right_re_of_mem_rectOpen {z w c : ℂ} (hc : c ∈ rectOpen z w) :
    w.re ≠ c.re := by
