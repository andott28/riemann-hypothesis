theorem diagonal_inv_dd :
    (Matrix.diagonal Y7A3Data.dd)⁻¹ = Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹) := by
  refine Matrix.inv_eq_right_inv ?_
  ext i j
  rw [Matrix.diagonal_mul_diagonal]
  by_cases h : i = j
  · subst h
    simp [Matrix.diagonal_apply, Matrix.one_apply, mul_inv_cancel₀ (ne_of_gt (Y7A3Data.dd_pos i))]
  · simp [Matrix.diagonal_apply, Matrix.one_apply, h]
theorem schurMatrix_eq :
    Y7A3Data.A - Y7A3Data.Bm * (Matrix.diagonal Y7A3Data.dd)⁻¹ * Y7A3Data.Bm.conjTranspose
      - Y7Assembly.finalMatrix Y7A3Data.AU Y7A3Data.WL Y7A3Data.Scrit Y7A3Data.Corr (1 / 5)
    = (Y7A3Data.WL + 6 • Y7A3Data.Scrit + Y7A3Data.Corr)
      - Y7A3Data.Bm * Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹)
          * Y7A3Data.Bm.conjTranspose := by
  rw [diagonal_inv_dd]
  have h6 : (1 + 1 / (1 / 5) : ℝ) = 6 := by norm_num
  simp only [Y7Assembly.finalMatrix, Y7A3Data.AU, h6]
  ext i j
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply]
  ring
private def SwSide : Matrix (Fin 7) (Fin 7) ℝ :=
  Y7A3Data.WL + 6 • Y7A3Data.Scrit + Y7A3Data.Corr
    - Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
        * Y7A3Data.Bm.conjTranspose
theorem Sw_eq_side : Y7A3Step3Data.Sw = SwSide := by
  ext i j
  simp only [SwSide, Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply]
  rw [Sw_eq i j]
  ring
theorem SwSide_posSemidef : SwSide.PosSemidef := by
  rw [← Sw_eq_side]
  exact Y7A3Step3Data.Sw_posSemidef
theorem schurFloor : Y7A3Data.SchurFloor := by
  unfold Y7A3Data.SchurFloor
  rw [schurMatrix_eq]
  have hmono : (Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
        * Y7A3Data.Bm.conjTranspose
      - Y7A3Data.Bm * Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹)
        * Y7A3Data.Bm.conjTranspose).PosSemidef := by
    have hD : (Matrix.diagonal
        (fun j : Fin 50 => (Y7A3Step3Data.w : ℝ) - (Y7A3Data.dd j)⁻¹)).PosSemidef :=
      Matrix.PosSemidef.diagonal (fun j => sub_nonneg.mpr (dd_inv_le_w j))
    have hB := hD.mul_mul_conjTranspose_same Y7A3Data.Bm
    rwa [show Y7A3Data.Bm * Matrix.diagonal
          (fun j : Fin 50 => (Y7A3Step3Data.w : ℝ) - (Y7A3Data.dd j)⁻¹)
          * Y7A3Data.Bm.conjTranspose
        = Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
            * Y7A3Data.Bm.conjTranspose
          - Y7A3Data.Bm * Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹)
            * Y7A3Data.Bm.conjTranspose from by
      rw [← Matrix.diagonal_sub, Matrix.mul_sub, Matrix.sub_mul]] at hB
  have hsum := SwSide_posSemidef.add hmono
  simp only [SwSide] at hsum
  rwa [show (Y7A3Data.WL + 6 • Y7A3Data.Scrit + Y7A3Data.Corr
        - Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
          * Y7A3Data.Bm.conjTranspose)
      + (Y7A3Data.Bm * Matrix.diagonal (fun _ : Fin 50 => (Y7A3Step3Data.w : ℝ))
            * Y7A3Data.Bm.conjTranspose
          - Y7A3Data.Bm * Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹)
            * Y7A3Data.Bm.conjTranspose)
      = Y7A3Data.WL + 6 • Y7A3Data.Scrit + Y7A3Data.Corr
        - Y7A3Data.Bm * Matrix.diagonal (fun j => (Y7A3Data.dd j)⁻¹)
          * Y7A3Data.Bm.conjTranspose from by
    abel] at hsum
end Y7A3Wire
