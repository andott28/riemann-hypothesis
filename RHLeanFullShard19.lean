    norm_num [Sw, SwC, SwCrow0, SwCrow1, SwCrow2, SwCrow3, SwCrow4, SwCrow5, SwCrow6,
      SwLR, SwL, SwLrow0, SwLrow1, SwLrow2, SwLrow3, SwLrow4, SwLrow5, SwLrow6,
