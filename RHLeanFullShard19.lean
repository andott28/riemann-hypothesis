    have h := transf_conj hf.2.2.2 (-(1 / 2 : ℂ))
    rw [show star (-(1 / 2 : ℂ)) = (-(1 / 2 : ℂ)) by
      rw [show (-(1 / 2 : ℂ)) = ((-(1 / 2) : ℝ) : ℂ) by norm_num]
      simp] at h
