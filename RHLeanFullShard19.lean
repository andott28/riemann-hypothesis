    stripRightIntegral] using h
theorem tendsto_right_vertical_of_even (hgrowth : LogDerivStripGrowth) {h : ℂ → ℂ}
    (hh : Differentiable ℂ h) (hdecay : PolyDecay h) (heven : ∀ u : ℂ, h (-u) = h u)
    {T : ℕ → ℝ} (hT : Tendsto T atTop atTop) (hTpos : ∀ n, 0 < T n)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (stripLeft (T n)) (stripRight (T n)) →
        centeredZero p ∈ rectOpen (stripLeft (T n)) (stripRight (T n))) :
    Tendsto (fun n => stripRightIntegral h (T n)) atTop
      (𝓝 ((Real.pi : ℂ) * ∑' p : XiZero, h (centeredZero p))) := by
