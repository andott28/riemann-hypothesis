noncomputable def stripTopIntegral (h : ℂ → ℂ) (T : ℝ) : ℂ :=
  ∫ x : ℝ in (-(1 / 2 : ℝ))..(1 / 2), xiLogIntegrand h ((x : ℂ) + (T : ℂ) * I)
