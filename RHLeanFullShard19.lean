            - (Real.eulerMascheroniConstant : ℂ)‖ := by rw [add_sub_cancel_right]
      _ ≤ ‖Complex.digamma z + (Real.eulerMascheroniConstant : ℂ)‖
            + ‖(Real.eulerMascheroniConstant : ℂ)‖ := norm_sub_le _ _
      _ = ‖Complex.digamma z + (Real.eulerMascheroniConstant : ℂ)‖
            + |Real.eulerMascheroniConstant| := by rw [norm_ofReal_complex]
      _ ≤ 4 * (‖z‖ + 1) * S + |Real.eulerMascheroniConstant| :=
