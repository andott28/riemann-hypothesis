    LocalPSD (endpoint 4) :=
  LocalPSD_mono_of_bridge hbridge endpoint_four_le hzhu
def GateIIOperatorStepFour : Prop :=
  ∀ k : ℕ, 4 ≤ k → LocalPSD (endpoint k) → LocalPSD (endpoint (k + 1))
theorem endpoints_psd_of_zhu (hbridge : WeilBridge) (hzhu : ZhuWindowPositivity)
    (hII : GateIIOperatorStepFour) :
    ∀ k : ℕ, 4 ≤ k → LocalPSD (endpoint k) := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => exact localPSD_of_zhu_window hbridge hzhu
  | succ n hn ih => exact hII n hn ih
theorem gateIII_cofinal_of_base4 (hbridge : WeilBridge)
    (h : ∀ k : ℕ, 4 ≤ k → LocalPSD (endpoint k)) : ∀ a : ℝ, 0 < a → LocalPSD a := by
  intro a ha
  intro _ f hf
  obtain ⟨N, hN⟩ : ∃ N : ℕ, Real.exp (2 * a) ≤ N := exists_nat_ge (Real.exp (2 * a))
  have hNpos : (0 : ℝ) < N := lt_of_lt_of_le (Real.exp_pos (2 * a)) hN
  have hlogN : 2 * a ≤ Real.log (N : ℝ) := by
    have hmono := Real.log_le_log (Real.exp_pos (2 * a)) hN
    rwa [Real.log_exp] at hmono
  let k : ℕ := max N 4
  have hk : N ≤ k := le_max_left N 4
  have h4le : 4 ≤ k := le_max_right N 4
  have hlogk : Real.log (N : ℝ) ≤ Real.log (k : ℝ) :=
    Real.log_le_log hNpos (by exact_mod_cast hk)
  have ha_le : a ≤ endpoint k := by
    unfold endpoint
    linarith
  have hep : 0 < endpoint k := by
    unfold endpoint
    have h1 : (1 : ℝ) < (k : ℝ) := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num : (1 : ℕ) < 4) h4le)
    have hpos := Real.log_pos h1
    linarith
  have hsub : Function.support f ⊆ Set.Ioo (-(endpoint k)) (endpoint k) := by
    intro x hx
    have hxa := hf.2 hx
    exact ⟨by linarith [hxa.1, ha_le], by linarith [hxa.2, ha_le]⟩
  rw [← localizedForm_compression_of_bridge hbridge ha ha_le hf]
  exact (h k h4le) hep f ⟨hf.1, hsub⟩
theorem riemannHypothesis_of_zhu (hbridge : WeilBridge) (hzhu : ZhuWindowPositivity)
    (hII : GateIIOperatorStepFour) : RiemannHypothesis :=
  weil_odd_criterion_converse
    (gateIII_closure_of_bridge hbridge
      (gateIII_cofinal_of_base4 hbridge (endpoints_psd_of_zhu hbridge hzhu hII)))
