      have hxb : x ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2) :=
        Set.uIoc_of_le (show -(1 / 2 : ℝ) ≤ 1 / 2 by norm_num) ▸ hx
      exact ⟨hxb.1.le, hxb.2⟩
