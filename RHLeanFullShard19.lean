  unfold archBoundConstant
  have hT : 0 ≤ ∑' m : ℕ, 1 / ((m : ℝ) + 1) ^ 2 :=
    tsum_nonneg fun m => by positivity
  have hlog : 0 < Real.log Real.pi := Real.log_pos (by linarith [Real.pi_gt_three])
  have h5T : 0 ≤ 5 * ∑' m : ℕ, 1 / ((m : ℝ) + 1) ^ 2 := by positivity
  have hγ : 0 ≤ |Real.eulerMascheroniConstant| := abs_nonneg _
  linarith
theorem archDensity_le (t : ℝ) :
    |archDensity t| ≤ archBoundConstant * (1 + |t|) := by
