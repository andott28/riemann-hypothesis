theorem edgeBottom_ne {z w c : ℂ} (hc : c ∈ rectOpen z w) (x : ℝ) :
    edgeBottom z w x ≠ c := by
  intro h
  exact ne_left_im_of_mem_rectOpen hc (by
    have := congrArg Complex.im h
    simpa [edgeBottom] using this)
theorem edgeTop_ne {z w c : ℂ} (hc : c ∈ rectOpen z w) (x : ℝ) :
    edgeTop z w x ≠ c := by
