theorem intervalIntegrable_edgeLeft_of_continuousOn {F : ℂ → ℂ} {z w : ℂ}
    (hzr : z.re < w.re) (hzi : z.im < w.im) (hF : ContinuousOn F (rectBoundary z w)) :
