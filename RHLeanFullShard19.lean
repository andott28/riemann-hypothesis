section Inline_ExplicitFormula_RH6
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
def PolyDecay (h : ℂ → ℂ) : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∀ u : ℂ, ‖h u‖ ≤ C / (1 + ‖u‖) ^ 3
theorem summable_hadamardTestValues {h : ℂ → ℂ} (hh : PolyDecay h) :
    Summable (fun p : XiZero => h (centeredZero p)) := by
  obtain ⟨C, hC0, hC⟩ := hh
  refine Summable.of_norm_bounded (g := fun p : XiZero => 16 * C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2)) ?_
    (fun p => ?_)
  · refine (summable_one_div_one_add_norm_sq.mul_left (16 * C)).congr (fun p => ?_)
    ring
  · have ht : 0 < ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ :=
      norm_pos_iff.mpr (Complex.Hadamard.divisorZeroIndex₀_val_ne_zero p)
    by_cases h1 : 1 ≤ ‖Complex.Hadamard.divisorZeroIndex₀_val p‖
    · have hc : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2 ≤ ‖centeredZero p‖ := by
        have hc' : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2 ≤
            ‖Complex.Hadamard.divisorZeroIndex₀_val p - 1 / 2‖ := by
          have h2 := abs_norm_sub_norm_le (Complex.Hadamard.divisorZeroIndex₀_val p) (1 / 2 : ℂ)
          rw [show ‖(1 / 2 : ℂ)‖ = 1 / 2 by norm_num] at h2
          have h3 : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ - 1 / 2 ≤
              |‖Complex.Hadamard.divisorZeroIndex₀_val p‖ - 1 / 2| := le_abs_self _
          linarith
        simpa [centeredZero] using hc'
      calc ‖h (centeredZero p)‖ ≤ C / (1 + ‖centeredZero p‖) ^ 3 := hC _
        _ ≤ C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ / 2) ^ 3 := by
            refine div_le_div_of_nonneg_left hC0 (by positivity) ?_
            exact pow_le_pow_left₀ (by positivity) (by linarith) 3
        _ ≤ 16 * C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) := by
            rw [div_le_div_iff₀ (by positivity) (by positivity)]
            nlinarith [hC0, h1, sq_nonneg (‖Complex.Hadamard.divisorZeroIndex₀_val p‖),
              mul_nonneg (le_trans zero_le_one h1)
                (sq_nonneg (‖Complex.Hadamard.divisorZeroIndex₀_val p‖))]
    · have hlt : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ < 1 := lt_of_not_ge h1
      have hge : 1 ≤ 1 + ‖centeredZero p‖ := by linarith [norm_nonneg (centeredZero p)]
      have hcube : (1 + ‖centeredZero p‖) ≤ (1 + ‖centeredZero p‖) ^ 3 :=
        le_self_pow₀ hge (by norm_num)
      calc ‖h (centeredZero p)‖ ≤ C / (1 + ‖centeredZero p‖) ^ 3 := hC _
        _ ≤ C := by
            rw [div_le_iff₀ (by positivity)]
            calc C = C * 1 := by ring
              _ ≤ C * (1 + ‖centeredZero p‖) := mul_le_mul_of_nonneg_left hge hC0
              _ ≤ C * (1 + ‖centeredZero p‖) ^ 3 := mul_le_mul_of_nonneg_left hcube hC0
        _ ≤ 16 * C / (1 + ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2) := by
            rw [le_div_iff₀ (by positivity)]
            have ht2 : ‖Complex.Hadamard.divisorZeroIndex₀_val p‖ ^ 2 ≤ 1 := by
              nlinarith [ht.le, hlt, mul_self_le_mul_self ht.le hlt.le]
            nlinarith [hC0, ht2]
theorem rectangleZeroSum_eq_sum {z w : ℂ}
    (hfin : ({p : XiZero | centeredZero p ∈ rectOpen z w} : Set XiZero).Finite)
    (h : ℂ → ℂ) :
    rectangleZeroSum z w h = ∑ p ∈ hfin.toFinset, h (centeredZero p) := by
  rw [rectangleZeroSum]
  refine (tsum_eq_sum (s := hfin.toFinset) (fun p hp => ?_)).trans ?_
  · exact if_neg (fun hmem => hp ((Set.Finite.mem_toFinset hfin).mpr hmem))
  · refine Finset.sum_congr rfl fun p hp => ?_
    exact if_pos ((Set.Finite.mem_toFinset hfin).mp hp)
theorem tendsto_rectangleZeroSum {h : ℂ → ℂ}
    (hsum : Summable (fun p : XiZero => h (centeredZero p)))
    {Z W : ℕ → ℂ}
    (hfin : ∀ n, ({p : XiZero | centeredZero p ∈ rectOpen (Z n) (W n)} : Set XiZero).Finite)
    (hcofinal : ∀ p : XiZero, ∃ N, ∀ n ≥ N, centeredZero p ∈ rectOpen (Z n) (W n)) :
    Tendsto (fun n => rectangleZeroSum (Z n) (W n) h) atTop
      (𝓝 (∑' p : XiZero, h (centeredZero p))) := by
  classical
  have hS : Tendsto (fun n => (hfin n).toFinset) atTop atTop := by
    rw [Filter.tendsto_atTop]
    intro s
    have hall : ∀ᶠ n in atTop, ∀ p ∈ s, centeredZero p ∈ rectOpen (Z n) (W n) := by
      induction s using Finset.induction_on with
      | empty => exact Filter.Eventually.of_forall fun n p hp => (Finset.notMem_empty p hp).elim
      | insert a s ha ih =>
          obtain ⟨N, hN⟩ := hcofinal a
          filter_upwards [eventually_atTop.mpr ⟨N, fun n hn => hN n hn⟩, ih] with n hna hns
          intro p hp
          rw [Finset.mem_insert] at hp
          rcases hp with rfl | hp
          · exact hna
          · exact hns p hp
    filter_upwards [hall] with n hn
    intro p hp
    exact (Set.Finite.mem_toFinset (hfin n)).mpr (hn p hp)
  have hconv : Tendsto (fun n => ∑ p ∈ (hfin n).toFinset, h (centeredZero p)) atTop
      (𝓝 (∑' p : XiZero, h (centeredZero p))) :=
    hsum.hasSum.comp hS
  refine hconv.congr' ?_
  filter_upwards with n
  exact (rectangleZeroSum_eq_sum (hfin n) h).symm
theorem rectangleResidueLimit {h : ℂ → ℂ} (hh : Differentiable ℂ h) (hdecay : PolyDecay h)
    {Z W : ℕ → ℂ}
    (horder : ∀ n, (Z n).re < (W n).re) (him : ∀ n, (Z n).im < (W n).im)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (Z n) (W n) → centeredZero p ∈ rectOpen (Z n) (W n))
    (hfin : ∀ n, ({p : XiZero | centeredZero p ∈ rectOpen (Z n) (W n)} : Set XiZero).Finite)
    (hcofinal : ∀ p : XiZero, ∃ N, ∀ n ≥ N, centeredZero p ∈ rectOpen (Z n) (W n)) :
    Tendsto (fun n => rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) (Z n) (W n)) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, h (centeredZero p))) := by
  have hsum := summable_hadamardTestValues hdecay
  have hzero := tendsto_rectangleZeroSum hsum hfin hcofinal
  have hFin : ∀ n, rectangleBoundaryIntegral
        (fun u => h u * logDeriv riemannXi ((1 / 2 : ℂ) + u)) (Z n) (W n) =
      2 * (Real.pi : ℂ) * I * rectangleZeroSum (Z n) (W n) h :=
    fun n => rectangleResidueIdentityFinite h hh (Z n) (W n) (horder n) (him n)
      (hbd n) (hfin n)
  have hconst : Tendsto (fun n => 2 * (Real.pi : ℂ) * I * rectangleZeroSum (Z n) (W n) h)
      atTop (𝓝 (2 * (Real.pi : ℂ) * I * ∑' p : XiZero, h (centeredZero p))) :=
    tendsto_const_nhds.mul hzero
  refine hconst.congr' ?_
  filter_upwards with n
  exact (hFin n).symm
end RHLean.ExplicitFormula
end
