section Inline_ExplicitFormula_RH2
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology
namespace RHLean.ExplicitFormula
theorem logDeriv_sub_pow (ρ z : ℂ) (n : ℕ) :
    logDeriv (fun w : ℂ => (w - ρ) ^ n) z = (n : ℂ) / (z - ρ) := by
  rw [logDeriv_fun_pow (f := fun w : ℂ => w - ρ) (by fun_prop) n]
  have h : logDeriv (fun w : ℂ => w - ρ) z = 1 / (z - ρ) := by
    rw [logDeriv_apply, show deriv (fun w : ℂ => w - ρ) z = 1 from by
      rw [deriv_sub_const]
      exact deriv_id z]
  rw [h, mul_one_div]
theorem exists_factorization (p : XiZero) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g (Complex.Hadamard.divisorZeroIndex₀_val p) ∧
      g (Complex.Hadamard.divisorZeroIndex₀_val p) ≠ 0 ∧
      riemannXi =ᶠ[𝓝 (Complex.Hadamard.divisorZeroIndex₀_val p)]
        (fun z : ℂ =>
          (z - Complex.Hadamard.divisorZeroIndex₀_val p) ^
            (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p)) * g z) := by
  have hf : AnalyticAt ℂ riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) :=
    differentiable_riemannXi.analyticAt _
  have hfin : analyticOrderAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) ≠ ⊤ := by
    intro htop
    have hmero : meromorphicOrderAt riemannXi
        (Complex.Hadamard.divisorZeroIndex₀_val p) = ⊤ := by
      rw [hf.meromorphicOrderAt_eq, htop]
      simp
    have hdiv : MeromorphicOn.divisor riemannXi (Set.univ : Set ℂ)
        (Complex.Hadamard.divisorZeroIndex₀_val p) = 0 := by
      have hmeroOn : MeromorphicOn riemannXi (Set.univ : Set ℂ) :=
        (differentiable_riemannXi.differentiableOn.analyticOnNhd isOpen_univ).meromorphicOn
      rw [MeromorphicOn.divisor_apply hmeroOn (Set.mem_univ _), hmero]
      rfl
    exact Complex.Hadamard.divisorZeroIndex₀_val_mem_divisor_support p hdiv
  exact (hf.analyticOrderNatAt_eq_iff hfin).mp rfl
theorem exists_principalPart_logDeriv (p : XiZero) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g (Complex.Hadamard.divisorZeroIndex₀_val p) ∧
      g (Complex.Hadamard.divisorZeroIndex₀_val p) ≠ 0 ∧
      logDeriv riemannXi =ᶠ[𝓝[≠] (Complex.Hadamard.divisorZeroIndex₀_val p)]
        (fun z : ℂ =>
          (analyticOrderNatAt riemannXi (Complex.Hadamard.divisorZeroIndex₀_val p) : ℂ) /
            (z - Complex.Hadamard.divisorZeroIndex₀_val p) + logDeriv g z) := by
  obtain ⟨g, hg, hg0, hgfac⟩ := exists_factorization p
  refine ⟨g, hg, hg0, ?_⟩
  set ρ : ℂ := Complex.Hadamard.divisorZeroIndex₀_val p with hρ
  have hgnz : ∀ᶠ z in 𝓝 ρ, g z ≠ 0 :=
    ContinuousAt.eventually_ne (AnalyticAt.continuousAt hg) hg0
  have hgdiff : ∀ᶠ z in 𝓝 ρ, DifferentiableAt ℂ g z := by
    obtain ⟨pfs, hpfs⟩ := hg
    exact hpfs.eventually_differentiableAt
  have hrhs :
      logDeriv (fun z : ℂ => (z - ρ) ^ (analyticOrderNatAt riemannXi ρ) * g z)
        =ᶠ[𝓝[≠] ρ]
        (fun z : ℂ =>
          (analyticOrderNatAt riemannXi ρ : ℂ) / (z - ρ) + logDeriv g z) := by
    filter_upwards [hgnz.filter_mono nhdsWithin_le_nhds,
      hgdiff.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with z hgnz_z hgdz hzne
    have hzne' : z ≠ ρ := hzne
    change logDeriv ((fun z : ℂ => (z - ρ) ^ (analyticOrderNatAt riemannXi ρ)) * g) z =
      (analyticOrderNatAt riemannXi ρ : ℂ) / (z - ρ) + logDeriv g z
    rw [logDeriv_mul
      (f := fun z : ℂ => (z - ρ) ^ (analyticOrderNatAt riemannXi ρ)) (g := g) z
      (pow_ne_zero _ (sub_ne_zero.mpr hzne')) hgnz_z (by fun_prop) hgdz, logDeriv_sub_pow]
  exact (logDeriv_congr_nhds hgfac).filter_mono nhdsWithin_le_nhds |>.trans hrhs
end RHLean.ExplicitFormula
end
