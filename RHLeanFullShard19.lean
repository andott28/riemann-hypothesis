theorem logDeriv_Gamma_div_two (s : ℂ) (hs : ∀ m : ℕ, s / 2 ≠ -m) :
    logDeriv (fun z : ℂ => Gamma (z / 2)) s = (1 / 2) * digamma (s / 2) := by
