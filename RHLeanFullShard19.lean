theorem rectangleBoundaryIntegral_congr_edge {F G : ℂ → ℂ} {z w : ℂ}
    (hb : ∀ x ∈ Set.uIcc z.re w.re, F (edgeBottom z w x) = G (edgeBottom z w x))
    (ht : ∀ x ∈ Set.uIcc z.re w.re, F (edgeTop z w x) = G (edgeTop z w x))
    (hr : ∀ y ∈ Set.uIcc z.im w.im, F (edgeRight z w y) = G (edgeRight z w y))
    (hl : ∀ y ∈ Set.uIcc z.im w.im, F (edgeLeft z w y) = G (edgeLeft z w y)) :
    rectangleBoundaryIntegral F z w = rectangleBoundaryIntegral G z w := by
  have hb' : ∀ x ∈ Set.uIcc z.re w.re,
      F ((x : ℂ) + (z.im : ℂ) * I) = G ((x : ℂ) + (z.im : ℂ) * I) :=
    fun x hx => hb x hx
  have ht' : ∀ x ∈ Set.uIcc z.re w.re,
      F ((x : ℂ) + (w.im : ℂ) * I) = G ((x : ℂ) + (w.im : ℂ) * I) :=
    fun x hx => ht x hx
  have hr' : ∀ y ∈ Set.uIcc z.im w.im,
      F ((w.re : ℂ) + (y : ℂ) * I) = G ((w.re : ℂ) + (y : ℂ) * I) :=
    fun y hy => hr y hy
  have hl' : ∀ y ∈ Set.uIcc z.im w.im,
      F ((z.re : ℂ) + (y : ℂ) * I) = G ((z.re : ℂ) + (y : ℂ) * I) :=
    fun y hy => hl y hy
  unfold rectangleBoundaryIntegral
  rw [intervalIntegral.integral_congr hb', intervalIntegral.integral_congr ht',
    intervalIntegral.integral_congr hr', intervalIntegral.integral_congr hl']
theorem rectangleBoundaryIntegral_add (F G : ℂ → ℂ) (z w : ℂ)
    (hFb : IntervalIntegrable (fun x : ℝ => F (edgeBottom z w x)) volume z.re w.re)
    (hGb : IntervalIntegrable (fun x : ℝ => G (edgeBottom z w x)) volume z.re w.re)
    (hFt : IntervalIntegrable (fun x : ℝ => F (edgeTop z w x)) volume z.re w.re)
    (hGt : IntervalIntegrable (fun x : ℝ => G (edgeTop z w x)) volume z.re w.re)
    (hFr : IntervalIntegrable (fun y : ℝ => F (edgeRight z w y)) volume z.im w.im)
    (hGr : IntervalIntegrable (fun y : ℝ => G (edgeRight z w y)) volume z.im w.im)
    (hFl : IntervalIntegrable (fun y : ℝ => F (edgeLeft z w y)) volume z.im w.im)
    (hGl : IntervalIntegrable (fun y : ℝ => G (edgeLeft z w y)) volume z.im w.im) :
    rectangleBoundaryIntegral (fun u => F u + G u) z w =
      rectangleBoundaryIntegral F z w + rectangleBoundaryIntegral G z w := by
  unfold rectangleBoundaryIntegral edgeBottom edgeTop edgeRight edgeLeft at *
  rw [intervalIntegral.integral_add hFb hGb, intervalIntegral.integral_add hFt hGt,
    intervalIntegral.integral_add hFr hGr, intervalIntegral.integral_add hFl hGl]
  ring
theorem rectangleBoundaryIntegral_const_mul (cst : ℂ) (F : ℂ → ℂ) (z w : ℂ) :
    rectangleBoundaryIntegral (fun u => cst * F u) z w =
      cst * rectangleBoundaryIntegral F z w := by
  unfold rectangleBoundaryIntegral
  rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  ring
theorem rectangleBoundaryIntegral_eq_zero_of_differentiableOn (F : ℂ → ℂ) (z w : ℂ)
    (H : DifferentiableOn ℂ F (rectClosed z w)) :
    rectangleBoundaryIntegral F z w = 0 := by
  have hset : rectClosed z w =
      reProdIm (Set.uIcc z.re w.re) (Set.uIcc z.im w.im) := by
    ext u
    simp only [rectClosed, Set.mem_setOf_eq, reProdIm, Set.mem_preimage, Set.mem_inter_iff,
      Set.uIcc, Set.mem_Icc]
    tauto
  have h := Complex.integral_boundary_rect_eq_zero_of_differentiableOn F z w (hset ▸ H)
  simpa [rectangleBoundaryIntegral, smul_eq_mul] using h
theorem intervalIntegrable_edgeBottom_of_continuousAt {F : ℂ → ℂ} {z w c : ℂ}
    (hc : c ∈ rectOpen z w) (hF : ∀ u ∈ rectClosed z w, u ≠ c → ContinuousAt F u) :
    IntervalIntegrable (fun x : ℝ => F (edgeBottom z w x)) volume z.re w.re := by
  apply ContinuousOn.intervalIntegrable
  intro x hx
  exact ((hF _ (edgeBottom_mem z w hx) (edgeBottom_ne hc x)).comp
    (continuous_edgeBottom z w).continuousAt).continuousWithinAt
theorem intervalIntegrable_edgeTop_of_continuousAt {F : ℂ → ℂ} {z w c : ℂ}
    (hc : c ∈ rectOpen z w) (hF : ∀ u ∈ rectClosed z w, u ≠ c → ContinuousAt F u) :
    IntervalIntegrable (fun x : ℝ => F (edgeTop z w x)) volume z.re w.re := by
  apply ContinuousOn.intervalIntegrable
  intro x hx
  exact ((hF _ (edgeTop_mem z w hx) (edgeTop_ne hc x)).comp
    (continuous_edgeTop z w).continuousAt).continuousWithinAt
theorem intervalIntegrable_edgeRight_of_continuousAt {F : ℂ → ℂ} {z w c : ℂ}
    (hc : c ∈ rectOpen z w) (hF : ∀ u ∈ rectClosed z w, u ≠ c → ContinuousAt F u) :
    IntervalIntegrable (fun y : ℝ => F (edgeRight z w y)) volume z.im w.im := by
  apply ContinuousOn.intervalIntegrable
  intro y hy
  exact ((hF _ (edgeRight_mem z w hy) (edgeRight_ne hc y)).comp
    (continuous_edgeRight z w).continuousAt).continuousWithinAt
theorem intervalIntegrable_edgeLeft_of_continuousAt {F : ℂ → ℂ} {z w c : ℂ}
    (hc : c ∈ rectOpen z w) (hF : ∀ u ∈ rectClosed z w, u ≠ c → ContinuousAt F u) :
    IntervalIntegrable (fun y : ℝ => F (edgeLeft z w y)) volume z.im w.im := by
  apply ContinuousOn.intervalIntegrable
  intro y hy
  exact ((hF _ (edgeLeft_mem z w hy) (edgeLeft_ne hc y)).comp
    (continuous_edgeLeft z w).continuousAt).continuousWithinAt
theorem div_eq_dslope_add (g : ℂ → ℂ) {c u : ℂ} (hu : u ≠ c) :
    g u / (u - c) = dslope g c u + g c * (u - c)⁻¹ := by
  rw [dslope_of_ne g hu]
  unfold slope
  rw [vsub_eq_sub, smul_eq_mul]
  have hne : u - c ≠ 0 := sub_ne_zero.mpr hu
  field_simp
  ring
theorem single_pole_of_winding (hW : RectangleWinding) {g : ℂ → ℂ}
    (hg : Differentiable ℂ g) {c z w : ℂ} (hzr : z.re < w.re) (hzi : z.im < w.im)
    (hc : c ∈ rectOpen z w) :
    rectangleBoundaryIntegral (fun u => g u / (u - c)) z w =
      2 * (Real.pi : ℂ) * I * g c := by
  have hds : Differentiable ℂ (dslope g c) :=
    differentiableOn_univ.mp <|
      (differentiableOn_dslope (s := Set.univ) (c := c) Filter.univ_mem).mpr
        (differentiableOn_univ.mpr hg)
  have hGoursat : rectangleBoundaryIntegral (dslope g c) z w = 0 :=
    rectangleBoundaryIntegral_eq_zero_of_differentiableOn _ z w
      (hds.differentiableOn.mono (Set.subset_univ _))
  have hdsCont : ∀ u ∈ rectClosed z w, u ≠ c → ContinuousAt (dslope g c) u :=
    fun u _ _ => hds.continuous.continuousAt
  have hpoleCont : ∀ u ∈ rectClosed z w, u ≠ c →
      ContinuousAt (fun v : ℂ => g c * (v - c)⁻¹) u := by
    intro u _ hu
    have hsub : ContinuousAt (fun v : ℂ => v - c) u :=
      continuousAt_id.sub continuousAt_const
    exact continuousAt_const.mul (hsub.inv₀ (sub_ne_zero.mpr hu))
  have hcongr : rectangleBoundaryIntegral (fun u => g u / (u - c)) z w =
      rectangleBoundaryIntegral (fun u => dslope g c u + g c * (u - c)⁻¹) z w := by
    apply rectangleBoundaryIntegral_congr_edge
    · intro x hx
      have hne : edgeBottom z w x ≠ c := edgeBottom_ne hc x
      rw [div_eq_dslope_add g hne]
    · intro x hx
      have hne : edgeTop z w x ≠ c := edgeTop_ne hc x
      rw [div_eq_dslope_add g hne]
    · intro y hy
      have hne : edgeRight z w y ≠ c := edgeRight_ne hc y
      rw [div_eq_dslope_add g hne]
    · intro y hy
      have hne : edgeLeft z w y ≠ c := edgeLeft_ne hc y
      rw [div_eq_dslope_add g hne]
  have hsplit : rectangleBoundaryIntegral
        (fun u => dslope g c u + g c * (u - c)⁻¹) z w =
      rectangleBoundaryIntegral (dslope g c) z w +
        rectangleBoundaryIntegral (fun u => g c * (u - c)⁻¹) z w :=
    rectangleBoundaryIntegral_add _ _ z w
      (intervalIntegrable_edgeBottom_of_continuousAt hc hdsCont)
      (intervalIntegrable_edgeBottom_of_continuousAt hc hpoleCont)
      (intervalIntegrable_edgeTop_of_continuousAt hc hdsCont)
      (intervalIntegrable_edgeTop_of_continuousAt hc hpoleCont)
      (intervalIntegrable_edgeRight_of_continuousAt hc hdsCont)
      (intervalIntegrable_edgeRight_of_continuousAt hc hpoleCont)
      (intervalIntegrable_edgeLeft_of_continuousAt hc hdsCont)
      (intervalIntegrable_edgeLeft_of_continuousAt hc hpoleCont)
  have hpull : rectangleBoundaryIntegral (fun u => g c * (u - c)⁻¹) z w =
      g c * rectangleBoundaryIntegral (fun u => 1 / (u - c)) z w := by
    simpa only [one_div] using
      rectangleBoundaryIntegral_const_mul (g c) (fun u => 1 / (u - c)) z w
  calc rectangleBoundaryIntegral (fun u => g u / (u - c)) z w
      = rectangleBoundaryIntegral (fun u => dslope g c u + g c * (u - c)⁻¹) z w :=
        hcongr
    _ = rectangleBoundaryIntegral (dslope g c) z w +
          rectangleBoundaryIntegral (fun u => g c * (u - c)⁻¹) z w := hsplit
    _ = 0 + g c * rectangleBoundaryIntegral (fun u => 1 / (u - c)) z w := by
        rw [hGoursat, hpull]
    _ = g c * (2 * (Real.pi : ℂ) * I) := by rw [hW c z w hzr hzi hc]; ring
    _ = 2 * (Real.pi : ℂ) * I * g c := by ring
theorem log_neg_of_im_neg {w : ℂ} (h : w.im < 0) :
    Complex.log (-w) = Complex.log w + π * I := by
  rw [Complex.ext_iff]
  constructor <;> simp [Complex.log_re, Complex.log_im,
    Complex.arg_neg_eq_arg_add_pi_of_im_neg h]
theorem log_neg_of_im_pos {w : ℂ} (h : 0 < w.im) :
    Complex.log (-w) = Complex.log w - π * I := by
  rw [Complex.ext_iff]
  constructor <;> simp [Complex.log_re, Complex.log_im,
    Complex.arg_neg_eq_arg_sub_pi_of_im_pos h]
theorem integral_inv_ofReal_add_const_of_im_ne {a b : ℝ} {d : ℂ} (him : d.im ≠ 0) :
    (∫ x : ℝ in a..b, ((x : ℂ) + d)⁻¹) =
      Complex.log ((b : ℂ) + d) - Complex.log ((a : ℂ) + d) := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro x hx
    have hmem : (x : ℂ) + d ∈ slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      exact Or.inr (by simpa using him)
    have hlin : HasDerivAt (fun x : ℝ => (x : ℂ) + d) 1 x := by
      simpa using (hasDerivAt_id x).ofReal_comp.add_const d
    simpa [one_div] using hlin.clog_real hmem
  · apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.inv₀
    · exact Complex.continuous_ofReal.continuousOn.add continuousOn_const
    · intro x hx
      exact Complex.slitPlane_ne_zero (by
        rw [Complex.mem_slitPlane_iff]
        exact Or.inr (by simpa using him))
theorem integral_inv_const_add_ofReal_mul_I_of_re_pos {a b : ℝ} {d : ℂ}
    (hre : 0 < d.re) :
    (∫ y : ℝ in a..b, (d + (y : ℂ) * I)⁻¹) =
      I⁻¹ * Complex.log (d + (b : ℂ) * I) -
        I⁻¹ * Complex.log (d + (a : ℂ) * I) := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro y hy
    have hmem : d + (y : ℂ) * I ∈ slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      exact Or.inl (by simpa using hre)
    have hlin : HasDerivAt (fun y : ℝ => d + (y : ℂ) * I) I y := by
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 y := (hasDerivAt_id y).ofReal_comp
      simpa using (h1.mul_const I).const_add d
    have hcomp := (hlin.clog_real hmem).const_mul I⁻¹
    have hval : I⁻¹ * (I / (d + (y : ℂ) * I)) = (d + (y : ℂ) * I)⁻¹ := by
      rw [div_eq_mul_inv]
      calc I⁻¹ * (I * (d + (y : ℂ) * I)⁻¹)
          = (I⁻¹ * I) * (d + (y : ℂ) * I)⁻¹ := by ring
        _ = (d + (y : ℂ) * I)⁻¹ := by rw [inv_mul_cancel₀ Complex.I_ne_zero, one_mul]
    exact hcomp.congr_deriv hval
  · apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.inv₀
    · exact (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
    · intro y hy
      exact Complex.slitPlane_ne_zero (by
        rw [Complex.mem_slitPlane_iff]
        exact Or.inl (by simpa using hre))
theorem integral_inv_const_add_ofReal_mul_I_of_re_neg {a b : ℝ} {d : ℂ}
    (hre : d.re < 0) :
    (∫ y : ℝ in a..b, (d + (y : ℂ) * I)⁻¹) =
      I⁻¹ * Complex.log (-(d + (b : ℂ) * I)) -
        I⁻¹ * Complex.log (-(d + (a : ℂ) * I)) := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro y hy
    have hmem : -(d + (y : ℂ) * I) ∈ slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      refine Or.inl ?_
      have hre' : (-(d + (y : ℂ) * I)).re = -d.re := by simp
      rw [hre']
      linarith
    have hlin : HasDerivAt (fun y : ℝ => -(d + (y : ℂ) * I)) (-I) y := by
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 y := (hasDerivAt_id y).ofReal_comp
      have h2 : HasDerivAt (fun y : ℝ => d + (y : ℂ) * I) I y := by
        simpa using (h1.mul_const I).const_add d
      exact h2.neg
    have hcomp := (hlin.clog_real hmem).const_mul I⁻¹
    have hval : I⁻¹ * ((-I) / (-(d + (y : ℂ) * I))) = (d + (y : ℂ) * I)⁻¹ := by
      rw [div_eq_mul_inv, inv_neg]
      calc I⁻¹ * (-I * -(d + (y : ℂ) * I)⁻¹)
          = (I⁻¹ * I) * (d + (y : ℂ) * I)⁻¹ := by ring
        _ = (d + (y : ℂ) * I)⁻¹ := by rw [inv_mul_cancel₀ Complex.I_ne_zero, one_mul]
    exact hcomp.congr_deriv hval
  · apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.inv₀
    · exact (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
    · intro y hy
      intro hzero
      have hre' : (d + (y : ℂ) * I).re = d.re := by simp
      have := congrArg Complex.re hzero
      rw [hre'] at this
      simp at this
      linarith
theorem rectangleWinding : RectangleWinding := by
  intro c z w hzr hzi hc
  have hzcr : z.re < c.re := by
    have h := hc.1
    rwa [min_eq_left hzr.le] at h
  have hcwr : c.re < w.re := by
    have h := hc.2.1
    rwa [max_eq_right hzr.le] at h
  have hzci : z.im < c.im := by
    have h := hc.2.2.1
    rwa [min_eq_left hzi.le] at h
  have hcwi : c.im < w.im := by
    have h := hc.2.2.2
    rwa [max_eq_right hzi.le] at h
  set A : ℂ := (z.re : ℂ) + (z.im : ℂ) * I with hA
  set B : ℂ := (w.re : ℂ) + (z.im : ℂ) * I with hB
  set C : ℂ := (w.re : ℂ) + (w.im : ℂ) * I with hC
  set D : ℂ := (z.re : ℂ) + (w.im : ℂ) * I with hD
  set db : ℂ := (z.im : ℂ) * I - c with hdb
  set dt : ℂ := (w.im : ℂ) * I - c with hdt
  set dr : ℂ := (w.re : ℂ) - c with hdr
  set dl : ℂ := (z.re : ℂ) - c with hdl
  have hdbim : db.im ≠ 0 := by
    rw [hdb]
    simp only [Complex.sub_im, Complex.mul_im, Complex.ofReal_im, Complex.ofReal_re,
      Complex.I_im, Complex.I_re, mul_one, mul_zero, add_zero, zero_add, sub_zero]
    exact ne_of_lt (sub_neg.mpr hzci)
  have hdtim : dt.im ≠ 0 := by
    rw [hdt]
    simp only [Complex.sub_im, Complex.mul_im, Complex.ofReal_im, Complex.ofReal_re,
      Complex.I_im, Complex.I_re, mul_one, mul_zero, add_zero, zero_add, sub_zero]
    exact ne_of_gt (sub_pos.mpr hcwi)
  have hdrre : 0 < dr.re := by
    rw [hdr]
    simp only [Complex.sub_re, Complex.ofReal_re]
    exact sub_pos.mpr hcwr
  have hdlre : dl.re < 0 := by
    rw [hdl]
    simp only [Complex.sub_re, Complex.ofReal_re]
    exact sub_neg.mpr hzcr
  have hJb : (∫ x : ℝ in z.re..w.re, (((x : ℂ) + (z.im : ℂ) * I) - c)⁻¹) =
      Complex.log (B - c) - Complex.log (A - c) := by
    have h := integral_inv_ofReal_add_const_of_im_ne (d := db) (a := z.re) (b := w.re) hdbim
    have e3 : (∫ x : ℝ in z.re..w.re, (((x : ℂ) + (z.im : ℂ) * I) - c)⁻¹) =
        ∫ x : ℝ in z.re..w.re, ((x : ℂ) + db)⁻¹ := by
      apply intervalIntegral.integral_congr
      intro x hx
      congr 1
      rw [hdb]
      ring
    rw [e3, h, show (w.re : ℂ) + db = B - c by rw [hdb, hB]; ring,
      show (z.re : ℂ) + db = A - c by rw [hdb, hA]; ring]
  have hJt : (∫ x : ℝ in z.re..w.re, (((x : ℂ) + (w.im : ℂ) * I) - c)⁻¹) =
      Complex.log (C - c) - Complex.log (D - c) := by
    have h := integral_inv_ofReal_add_const_of_im_ne (d := dt) (a := z.re) (b := w.re) hdtim
    have e3 : (∫ x : ℝ in z.re..w.re, (((x : ℂ) + (w.im : ℂ) * I) - c)⁻¹) =
        ∫ x : ℝ in z.re..w.re, ((x : ℂ) + dt)⁻¹ := by
      apply intervalIntegral.integral_congr
      intro x hx
      congr 1
      rw [hdt]
      ring
    rw [e3, h, show (w.re : ℂ) + dt = C - c by rw [hdt, hC]; ring,
      show (z.re : ℂ) + dt = D - c by rw [hdt, hD]; ring]
  have hJr : (∫ y : ℝ in z.im..w.im, (((w.re : ℂ) + (y : ℂ) * I) - c)⁻¹) =
      I⁻¹ * (Complex.log (C - c) - Complex.log (B - c)) := by
    have h := integral_inv_const_add_ofReal_mul_I_of_re_pos (d := dr) (a := z.im) (b := w.im) hdrre
    have e3 : (∫ y : ℝ in z.im..w.im, (((w.re : ℂ) + (y : ℂ) * I) - c)⁻¹) =
        ∫ y : ℝ in z.im..w.im, (dr + (y : ℂ) * I)⁻¹ := by
      apply intervalIntegral.integral_congr
      intro y hy
      congr 1
      rw [hdr]
      ring
    rw [e3, h, show dr + (w.im : ℂ) * I = C - c by rw [hdr, hC]; ring,
      show dr + (z.im : ℂ) * I = B - c by rw [hdr, hB]; ring, ← mul_sub]
  have hJl : (∫ y : ℝ in z.im..w.im, (((z.re : ℂ) + (y : ℂ) * I) - c)⁻¹) =
      I⁻¹ * (Complex.log (D - c) - Complex.log (A - c) - 2 * π * I) := by
    have h := integral_inv_const_add_ofReal_mul_I_of_re_neg (d := dl) (a := z.im) (b := w.im) hdlre
    have e3 : (∫ y : ℝ in z.im..w.im, (((z.re : ℂ) + (y : ℂ) * I) - c)⁻¹) =
        ∫ y : ℝ in z.im..w.im, (dl + (y : ℂ) * I)⁻¹ := by
      apply intervalIntegral.integral_congr
      intro y hy
      congr 1
      rw [hdl]
      ring
    have himD : 0 < (D - c).im := by
      have : (D - c).im = w.im - c.im := by rw [hD]; simp
      rw [this]
      exact sub_pos.mpr hcwi
    have himA : (A - c).im < 0 := by
      have : (A - c).im = z.im - c.im := by rw [hA]; simp
      rw [this]
      exact sub_neg.mpr hzci
    have eDw : dl + (w.im : ℂ) * I = D - c := by rw [hdl, hD]; ring
    have eDz : dl + (z.im : ℂ) * I = A - c := by rw [hdl, hA]; ring
    rw [e3, h,
      show -(dl + (w.im : ℂ) * I) = -(D - c) by rw [eDw],
      show -(dl + (z.im : ℂ) * I) = -(A - c) by rw [eDz],
      log_neg_of_im_pos himD, log_neg_of_im_neg himA, ← mul_sub]
    congr 1
    ring
  have hI : I * I⁻¹ = 1 := mul_inv_cancel₀ Complex.I_ne_zero
  have hsum : rectangleBoundaryIntegral (fun u : ℂ => (u - c)⁻¹) z w =
      (Complex.log (B - c) - Complex.log (A - c)) -
        (Complex.log (C - c) - Complex.log (D - c)) +
        I * (I⁻¹ * (Complex.log (C - c) - Complex.log (B - c))) -
        I * (I⁻¹ * (Complex.log (D - c) - Complex.log (A - c) - 2 * π * I)) := by
    unfold rectangleBoundaryIntegral
    simp only []
    rw [hJb, hJt, hJr, hJl]
  have hfinal : rectangleBoundaryIntegral (fun u : ℂ => (u - c)⁻¹) z w =
      2 * (Real.pi : ℂ) * I := by
    rw [hsum]
    have e1 : I * (I⁻¹ * (Complex.log (C - c) - Complex.log (B - c))) =
        Complex.log (C - c) - Complex.log (B - c) := by
      rw [← mul_assoc, hI, one_mul]
    have e2 : I * (I⁻¹ * (Complex.log (D - c) - Complex.log (A - c) - 2 * π * I)) =
        Complex.log (D - c) - Complex.log (A - c) - 2 * π * I := by
      rw [← mul_assoc, hI, one_mul]
    rw [e1, e2]
    ring
  simpa only [one_div] using hfinal
theorem single_pole_residue {g : ℂ → ℂ} (hg : Differentiable ℂ g) {c z w : ℂ}
    (hzr : z.re < w.re) (hzi : z.im < w.im) (hc : c ∈ rectOpen z w) :
    rectangleBoundaryIntegral (fun u => g u / (u - c)) z w =
      2 * (Real.pi : ℂ) * I * g c :=
  single_pole_of_winding rectangleWinding hg hzr hzi hc
end RHLean.ExplicitFormula
end
