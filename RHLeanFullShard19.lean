    have him : |T - μ.im| ≤ ‖((x : ℂ) + (T : ℂ) * I) - μ‖ := by
      have h := Complex.abs_im_le_norm (((x : ℂ) + (T : ℂ) * I) - μ)
      simpa [Complex.sub_im, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
        Complex.I_re, Complex.I_im, mul_one, zero_add] using h
    exact one_div_le_one_div_of_le (abs_pos.mpr (sub_ne_zero.mpr hsep1)) him
  have h2 : (1 : ℝ) / ‖((x : ℂ) + (T : ℂ) * I) + μ‖ ≤ 1 / |T + μ.im| := by
    have him : |T + μ.im| ≤ ‖((x : ℂ) + (T : ℂ) * I) + μ‖ := by
      have h := Complex.abs_im_le_norm (((x : ℂ) + (T : ℂ) * I) + μ)
      simpa [Complex.add_im, Complex.ofReal_im, Complex.mul_im,
        Complex.I_re, Complex.I_im, mul_one, zero_add] using h
    exact one_div_le_one_div_of_le (abs_pos.mpr h2') him
  exact mul_le_mul_of_nonneg_left (add_le_add h1 h2) (by norm_num)
