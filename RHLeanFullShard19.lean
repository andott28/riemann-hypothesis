      Complex.Hadamard.divisorZeroIndex₀_val q =
        Complex.Hadamard.divisorZeroIndex₀_val p :=
  Complex.Hadamard.mem_divisorZeroIndex₀_fiberFinset riemannXi _ q
theorem exists_divisorIndex_of_riemannXi_eq_zero {s : ℂ} (hs : riemannXi s = 0) :
    ∃ p : XiZero, Complex.Hadamard.divisorZeroIndex₀_val p = s := by
  have hs0 : s ≠ 0 := by
    intro h
    rw [h, riemannXi_zero] at hs
    norm_num at hs
  have htop : analyticOrderAt riemannXi s ≠ ⊤ := by
    intro htop
    rw [AnalyticOnNhd.analyticOrderAt_eq_top_iff_eq_zero s
      (fun z => differentiable_riemannXi.analyticAt z)] at htop
    have h0 := congrFun htop 0
    rw [riemannXi_zero] at h0
    norm_num at h0
  have h0 : analyticOrderAt riemannXi s ≠ 0 := by
    intro hzero
    rcases (analyticOrderAt_eq_zero.mp hzero) with hna | hne
    · exact hna (differentiable_riemannXi.analyticAt s)
    · exact hne hs
  have hnat : analyticOrderNatAt riemannXi s ≠ 0 := by
    intro hz
    apply h0
    have hcast := Nat.cast_analyticOrderNatAt (f := riemannXi) (z₀ := s) htop
    rw [← hcast, hz]
    rfl
  have hcard := Complex.Hadamard.divisorZeroIndex₀_fiberFinset_card_eq_analyticOrderNatAt
    (f := riemannXi) differentiable_riemannXi (z₀ := s) hs0
  have hne : (Complex.Hadamard.divisorZeroIndex₀_fiberFinset riemannXi s).Nonempty := by
    rw [← Finset.card_pos, hcard]
    exact Nat.pos_of_ne_zero hnat
  obtain ⟨p, hp⟩ := hne
  exact ⟨p, (Complex.Hadamard.mem_divisorZeroIndex₀_fiberFinset riemannXi s p).mp hp⟩
theorem rectangleBoundaryIntegral_finsetSum {ι : Type*} (s : Finset ι) (F : ι → ℂ → ℂ)
    (z w : ℂ)
    (hb : ∀ i ∈ s, IntervalIntegrable (fun x : ℝ => F i (edgeBottom z w x)) volume z.re w.re)
    (ht : ∀ i ∈ s, IntervalIntegrable (fun x : ℝ => F i (edgeTop z w x)) volume z.re w.re)
    (hr : ∀ i ∈ s, IntervalIntegrable (fun y : ℝ => F i (edgeRight z w y)) volume z.im w.im)
    (hl : ∀ i ∈ s, IntervalIntegrable (fun y : ℝ => F i (edgeLeft z w y)) volume z.im w.im) :
    rectangleBoundaryIntegral (fun u => ∑ i ∈ s, F i u) z w =
      ∑ i ∈ s, rectangleBoundaryIntegral (F i) z w := by
  have hb' : ∀ i ∈ s, IntervalIntegrable (fun x : ℝ => F i ((x : ℂ) + (z.im : ℂ) * I))
      volume z.re w.re := fun i hi => hb i hi
  have ht' : ∀ i ∈ s, IntervalIntegrable (fun x : ℝ => F i ((x : ℂ) + (w.im : ℂ) * I))
      volume z.re w.re := fun i hi => ht i hi
  have hr' : ∀ i ∈ s, IntervalIntegrable (fun y : ℝ => F i ((w.re : ℂ) + (y : ℂ) * I))
      volume z.im w.im := fun i hi => hr i hi
  have hl' : ∀ i ∈ s, IntervalIntegrable (fun y : ℝ => F i ((z.re : ℂ) + (y : ℂ) * I))
      volume z.im w.im := fun i hi => hl i hi
  have hL : rectangleBoundaryIntegral (fun u => ∑ i ∈ s, F i u) z w =
      (∑ i ∈ s, ∫ x in z.re..w.re, F i ((x : ℂ) + (z.im : ℂ) * I))
        - (∑ i ∈ s, ∫ x in z.re..w.re, F i ((x : ℂ) + (w.im : ℂ) * I))
        + I * (∑ i ∈ s, ∫ y in z.im..w.im, F i ((w.re : ℂ) + (y : ℂ) * I))
        - I * (∑ i ∈ s, ∫ y in z.im..w.im, F i ((z.re : ℂ) + (y : ℂ) * I)) := by
    simp only [rectangleBoundaryIntegral]
    rw [intervalIntegral.integral_finsetSum hb', intervalIntegral.integral_finsetSum ht',
      intervalIntegral.integral_finsetSum hr', intervalIntegral.integral_finsetSum hl']
  have hR : (∑ i ∈ s, rectangleBoundaryIntegral (F i) z w) =
      (∑ i ∈ s, ∫ x in z.re..w.re, F i ((x : ℂ) + (z.im : ℂ) * I))
        - (∑ i ∈ s, ∫ x in z.re..w.re, F i ((x : ℂ) + (w.im : ℂ) * I))
        + I * (∑ i ∈ s, ∫ y in z.im..w.im, F i ((w.re : ℂ) + (y : ℂ) * I))
        - I * (∑ i ∈ s, ∫ y in z.im..w.im, F i ((z.re : ℂ) + (y : ℂ) * I)) := by
    simp only [rectangleBoundaryIntegral]
    rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum]
  rw [hL, hR]
end RHLean.ExplicitFormula
