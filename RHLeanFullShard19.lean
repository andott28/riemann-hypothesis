def zhuCore (L : ℝ) : Set (ℝ → ℂ) :=
  {f | IsEvenRealTest f ∧ Function.support f ⊆ Set.Ioo (-L) L}
noncomputable def zhuPsi (L : ℝ) (t : ℝ) : ℝ :=
