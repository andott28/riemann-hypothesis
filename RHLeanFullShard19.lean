theorem riemannXi_log_growth_three_halves :
    ∃ C : ℝ, 0 < C ∧
      ∀ z : ℂ, Real.log (1 + ‖riemannXi z‖) ≤ C * (1 + ‖z‖) ^ ((3 : ℝ) / 2) :=
  riemannXi_entireOfOrderAtMost_one.exists_log_growth (τ := (3 : ℝ) / 2)
    (by norm_num) (by norm_num)
theorem riemannXi_divisorMass_le_three_halves :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R →
      Complex.Hadamard.divisorMassClosedBall₀ riemannXi R
        ≤ C * (1 + R) ^ ((3 : ℝ) / 2) := by
  obtain ⟨C, hC0, hC⟩ := riemannXi_log_growth_three_halves
  set K : ℝ := |Real.log ‖meromorphicTrailingCoeffAt riemannXi 0‖| with hK
  refine ⟨(C * 2 ^ ((3 : ℝ) / 2) + K) / Real.log 2, ?_, ?_⟩
  · refine div_pos ?_ (Real.log_pos one_lt_two)
    have hK0 : (0 : ℝ) ≤ K := abs_nonneg _
    have h2 : (0 : ℝ) < 2 ^ ((3 : ℝ) / 2) := Real.rpow_pos_of_pos two_pos _
    nlinarith [mul_pos hC0 h2]
  · intro R hR
    have hmass := Complex.Hadamard.divisorMassClosedBall₀_le_of_growth
      (f := riemannXi) differentiable_riemannXi hC hR
    refine hmass.trans ?_
    rw [div_eq_mul_inv, div_eq_mul_inv]
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ 2 * R)]
    have hK0 : (0 : ℝ) ≤ K := abs_nonneg _
    have hnum : C * (1 + 2 * R) ^ ((3 : ℝ) / 2) + K
        ≤ (C * 2 ^ ((3 : ℝ) / 2) + K) * (1 + R) ^ ((3 : ℝ) / 2) := by
      have h1R : (0 : ℝ) ≤ 1 + R := by linarith
      have hone : (1 : ℝ) ≤ (1 + R) ^ ((3 : ℝ) / 2) := by
        calc (1 : ℝ) = (1 : ℝ) ^ ((3 : ℝ) / 2) := (Real.one_rpow _).symm
          _ ≤ (1 + R) ^ ((3 : ℝ) / 2) :=
              Real.rpow_le_rpow zero_le_one (by linarith) (by norm_num)
      have hpow : (1 + 2 * R) ^ ((3 : ℝ) / 2)
          ≤ 2 ^ ((3 : ℝ) / 2) * (1 + R) ^ ((3 : ℝ) / 2) := by
        rw [← Real.mul_rpow (by norm_num) h1R]
        exact Real.rpow_le_rpow (by linarith) (by linarith) (by norm_num)
      calc C * (1 + 2 * R) ^ ((3 : ℝ) / 2) + K
          ≤ C * (2 ^ ((3 : ℝ) / 2) * (1 + R) ^ ((3 : ℝ) / 2))
              + K * (1 + R) ^ ((3 : ℝ) / 2) :=
            add_le_add (mul_le_mul_of_nonneg_left hpow hC0.le)
              (le_mul_of_one_le_right hK0 hone)
        _ = (C * 2 ^ ((3 : ℝ) / 2) + K) * (1 + R) ^ ((3 : ℝ) / 2) := by ring
    calc (C * (1 + 2 * R) ^ ((3 : ℝ) / 2) + K) * (Real.log 2)⁻¹
        ≤ ((C * 2 ^ ((3 : ℝ) / 2) + K) * (1 + R) ^ ((3 : ℝ) / 2))
            * (Real.log 2)⁻¹ :=
          mul_le_mul_of_nonneg_right hnum (inv_nonneg.mpr (Real.log_nonneg one_le_two))
      _ = ((C * 2 ^ ((3 : ℝ) / 2) + K) * (Real.log 2)⁻¹)
            * (1 + R) ^ ((3 : ℝ) / 2) := by ring
def StripQuadDecay (h : ℂ → ℂ) : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∀ u : ℂ, |u.re| ≤ (1 : ℝ) / 2 → ‖h u‖ ≤ C / (1 + ‖u‖) ^ 2
theorem transf_autocorr_StripQuadDecay {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    StripQuadDecay (transf (autocorr f)) := by
  obtain ⟨C, hC0, hC⟩ := exists_transf_norm_mul_le hf.1 hf.2.1
  refine ⟨C * C, mul_nonneg hC0 hC0, fun u hu => ?_⟩
  rw [transf_autocorr hf.1.continuous hf.2.1 u]
  have hstar : |(-(star u)).re| ≤ (1 : ℝ) / 2 := by
    simpa using hu
  have h1 := hC u hu
  have h2 : ‖transf f (-(star u))‖ * (1 + ‖u‖) ≤ C := by
    have h2' := hC (-(star u)) hstar
    simpa only [norm_neg, norm_star] using h2'
  have hden : 0 < (1 + ‖u‖) ^ 2 := by positivity
  have hprod : (‖transf f u‖ * (1 + ‖u‖)) * (‖transf f (-(star u))‖ * (1 + ‖u‖))
      ≤ C * C := mul_le_mul h1 h2 (by positivity) hC0
  calc ‖transf f u * star (transf f (-(star u)))‖
      = ‖transf f u‖ * ‖transf f (-(star u))‖ := by rw [norm_mul, norm_star]
    _ ≤ C * C / (1 + ‖u‖) ^ 2 := by
        rw [le_div_iff₀ hden]
        calc ‖transf f u‖ * ‖transf f (-(star u))‖ * (1 + ‖u‖) ^ 2
            = (‖transf f u‖ * (1 + ‖u‖)) * (‖transf f (-(star u))‖ * (1 + ‖u‖)) := by
              ring
          _ ≤ C * C := hprod
theorem tendsto_log_sq_div_sq :
    Tendsto (fun T : ℝ => (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2) atTop (𝓝 0) := by
  have hshift : Tendsto (fun T : ℝ => (1 : ℝ) + T) atTop atTop :=
    tendsto_atTop_add_const_left atTop (1 : ℝ) tendsto_id
  have hone : Tendsto (fun T : ℝ => Real.log (1 + T) / (1 + T)) atTop (𝓝 0) := by
    have h := ((isLittleO_log_rpow_atTop (show (0 : ℝ) < 1 by norm_num)).tendsto_div_nhds_zero).comp
      hshift
    refine h.congr' ?_
    filter_upwards with T
    simp
  have hsq : Tendsto (fun T : ℝ => (Real.log (1 + T) / (1 + T)) ^ 2) atTop (𝓝 0) := by
    simpa using hone.pow 2
  refine hsq.congr' ?_
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with T hT
  have hT1 : (1 + T) ≠ 0 := by positivity
  field_simp
theorem tendsto_horizontal_integral_zero_quad (hgrowth : LogDerivStripGrowth) {h : ℂ → ℂ}
    (hdecay : StripQuadDecay h) :
    Tendsto (fun T : ℝ => ∫ x : ℝ in (-(1 / 2 : ℝ))..(1 / 2),
        h ((x : ℂ) + (T : ℂ) * I)
          * logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))) atTop (𝓝 0) := by
  obtain ⟨C, hC0, hC⟩ := hgrowth
  obtain ⟨D, hD0, hD⟩ := hdecay
  have hlim : Tendsto (fun T : ℝ => D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2)
      atTop (𝓝 0) := by
    have h := (tendsto_const_nhds (x := D * C)).mul tendsto_log_sq_div_sq
    have h' : Tendsto (fun T : ℝ => D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2)
        atTop (𝓝 (D * C * 0)) := by
      refine h.congr' ?_
      filter_upwards with T
      ring
    simpa using h'
  refine squeeze_zero_norm' ?_ hlim
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with T hT
  have hpoint : ∀ x : ℝ, x ∈ Set.uIoc (-(1 / 2 : ℝ)) (1 / 2) →
      ‖h ((x : ℂ) + (T : ℂ) * I)
          * logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))‖
        ≤ D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2 := by
    intro x hx
    have hxI : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2) := by
      have hxb : x ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2) :=
        Set.uIoc_of_le (show (-(1 / 2 : ℝ)) ≤ 1 / 2 by norm_num) ▸ hx
      exact ⟨hxb.1.le, hxb.2⟩
    have hre : |(((x : ℂ) + (T : ℂ) * I)).re| ≤ (1 : ℝ) / 2 := by
      have hxre : (((x : ℂ) + (T : ℂ) * I)).re = x := by
        simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im, mul_one, mul_zero, sub_zero, add_zero]
      rw [hxre]
      exact abs_le.mpr ⟨hxI.1, hxI.2⟩
    have hdec := hD ((x : ℂ) + (T : ℂ) * I) hre
    have hlog := hC T hT x hxI
    have him : T ≤ ‖(x : ℂ) + (T : ℂ) * I‖ := by
      have h := abs_im_le_norm ((x : ℂ) + (T : ℂ) * I)
      have hz : ((x : ℂ) + (T : ℂ) * I).im = T := by
        simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.I_im,
          Complex.ofReal_re, Complex.I_re, mul_one, mul_zero, add_zero, zero_add]
      rw [hz, abs_of_nonneg (by linarith)] at h
      exact h
    have hden : (1 + T) ^ 2 ≤ (1 + ‖(x : ℂ) + (T : ℂ) * I‖) ^ 2 :=
      pow_le_pow_left₀ (by linarith) (by linarith) 2
    calc ‖h ((x : ℂ) + (T : ℂ) * I)
          * logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))‖
        = ‖h ((x : ℂ) + (T : ℂ) * I)‖
            * ‖logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))‖ := by
          rw [norm_mul]
      _ ≤ (D / (1 + T) ^ 2) * (C * (Real.log (1 + T)) ^ 2) := by
          refine mul_le_mul ?_ ?_ (norm_nonneg _) ?_
          · exact hdec.trans (div_le_div_of_nonneg_left hD0 (by positivity) hden)
          · exact hlog
          · positivity
      _ = D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2 := by ring
  have hInt := intervalIntegral.norm_integral_le_of_norm_le_const
    (f := fun x : ℝ => h ((x : ℂ) + (T : ℂ) * I)
      * logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I)))
    (a := -(1 / 2 : ℝ)) (b := 1 / 2)
    (C := D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2) hpoint
  have hInt' : ‖∫ x : ℝ in (-(1 / 2 : ℝ))..(1 / 2), h ((x : ℂ) + (T : ℂ) * I)
      * logDeriv riemannXi ((1 / 2 : ℂ) + ((x : ℂ) + (T : ℂ) * I))‖
      ≤ D * C * (Real.log (1 + T)) ^ 2 / (1 + T) ^ 2 := by
    have h := hInt
    rw [show |(1 / 2 : ℝ) - (-(1 / 2))| = 1 by norm_num, mul_one] at h
    exact h
  exact hInt'
theorem tendsto_horizontal_integral_autocorr (hgrowth : LogDerivStripGrowth)
    {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Tendsto (fun T : ℝ => stripTopIntegral (transf (autocorr f)) T) atTop (𝓝 0) :=
  tendsto_horizontal_integral_zero_quad hgrowth (transf_autocorr_StripQuadDecay hf)
theorem tendsto_right_vertical_autocorr (hgrowth : LogDerivStripGrowth)
    {f : ℝ → ℂ} (hf : f ∈ oddCore) {T : ℕ → ℝ} (hT : Tendsto T atTop atTop)
    (hTpos : ∀ n, 0 < T n)
    (hbd : ∀ n, ∀ p : XiZero,
      centeredZero p ∈ rectClosed (stripLeft (T n)) (stripRight (T n)) →
        centeredZero p ∈ rectOpen (stripLeft (T n)) (stripRight (T n))) :
    Tendsto (fun n => stripRightIntegral (transf (autocorr f)) (T n)) atTop
      (𝓝 ((Real.pi : ℂ) * ∑' p : XiZero, transf (autocorr f) (centeredZero p))) := by
  set S : ℂ := ∑' p : XiZero, transf (autocorr f) (centeredZero p) with hS
  have hlim := rectangleResidueLimit_autocorr hf hT hTpos hbd
  have htop : Tendsto (fun n => stripTopIntegral (transf (autocorr f)) (T n)) atTop (𝓝 0) :=
    (tendsto_horizontal_integral_autocorr hgrowth hf).comp hT
  have hsum : Tendsto (fun n => rectangleBoundaryIntegral
        (xiLogIntegrand (transf (autocorr f))) (stripLeft (T n)) (stripRight (T n))
      + 2 * stripTopIntegral (transf (autocorr f)) (T n)) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * S + 2 * 0)) :=
    hlim.add ((tendsto_const_nhds (x := (2 : ℂ))).mul htop)
  have hprod : Tendsto (fun n => 2 * I * stripRightIntegral (transf (autocorr f)) (T n))
      atTop (𝓝 (2 * (Real.pi : ℂ) * I * S)) := by
    have hsum' : Tendsto (fun n => rectangleBoundaryIntegral
          (xiLogIntegrand (transf (autocorr f))) (stripLeft (T n)) (stripRight (T n))
        + 2 * stripTopIntegral (transf (autocorr f)) (T n)) atTop
        (𝓝 (2 * (Real.pi : ℂ) * I * S)) := by
      simpa using hsum
    refine hsum'.congr' ?_
    filter_upwards with n
    have hdec := stripBoundaryIntegral_autocorr_decomposition hf (T n)
    linear_combination hdec
  have h2I : (2 * I : ℂ) ≠ 0 := mul_ne_zero two_ne_zero Complex.I_ne_zero
  have hR : Tendsto (fun n => (2 * I * stripRightIntegral (transf (autocorr f)) (T n))
      / (2 * I)) atTop (𝓝 ((2 * (Real.pi : ℂ) * I * S) / (2 * I))) :=
    hprod.div_const (2 * I)
  have hval : (2 * (Real.pi : ℂ) * I * S) / (2 * I) = (Real.pi : ℂ) * S := by
    field_simp
  rw [hval] at hR
  refine hR.congr' ?_
  filter_upwards with n
  field_simp
end RHLean.ExplicitFormula
