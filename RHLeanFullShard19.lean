theorem completedRiemannZeta_eq_GammaR_mul_zeta {s : ℂ} (hs : 1 < s.re) :
    completedRiemannZeta s = Gammaℝ s * riemannZeta s := by
  have hs0 : s ≠ 0 := by intro h; rw [h] at hs; norm_num at hs
