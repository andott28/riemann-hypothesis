    rw [hzdef]
    simp
  have hz_norm : ‖z‖ ≤ 1 / 4 + |t| / 2 := by
    rw [hzdef]
    have h1 : ‖(1 / 4 : ℂ)‖ = 1 / 4 := by
      rw [show (1 / 4 : ℂ) = ((1 / 4 : ℝ) : ℂ) by norm_num, norm_ofReal_complex]
      norm_num
    have h2 : ‖((t / 2 : ℝ) : ℂ) * I‖ = |t| / 2 := by
      rw [norm_mul, Complex.norm_I, mul_one, norm_ofReal_complex, abs_div,
        abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    calc ‖(1 / 4 : ℂ) + ((t / 2 : ℝ) : ℂ) * I‖
        ≤ ‖(1 / 4 : ℂ)‖ + ‖((t / 2 : ℝ) : ℂ) * I‖ := norm_add_le _ _
      _ = 1 / 4 + |t| / 2 := by rw [h1, h2]
