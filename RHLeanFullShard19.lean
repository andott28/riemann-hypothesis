theorem norm_ofReal_complex (r : ℝ) : ‖(r : ℂ)‖ = |r| := by
  rw [Complex.norm_def, Complex.normSq_ofReal, ← pow_two, Real.sqrt_sq_eq_abs]
theorem norm_digamma_add_gamma_le {z : ℂ} (hz : ∀ n : ℕ, z ≠ -(n : ℂ))
    (hza : (1 / 4 : ℝ) ≤ z.re) :
    ‖Complex.digamma z + (Real.eulerMascheroniConstant : ℂ)‖
      ≤ 4 * (‖z‖ + 1) * ∑' m : ℕ, 1 / ((m : ℝ) + 1) ^ 2 := by
  have hEq : Complex.digamma z + (Real.eulerMascheroniConstant : ℂ)
      = ∑' n : ℕ, (((n : ℂ) + 1)⁻¹ - (z + (n : ℂ))⁻¹) := by
    rw [Complex.digamma_eq_tsum hz,
      show (fun n : ℕ => 1 / ((n : ℂ) + 1) - 1 / ((n : ℂ) + z))
        = fun n : ℕ => ((n : ℂ) + 1)⁻¹ - (z + (n : ℂ))⁻¹ from by
          funext n
          rw [one_div, one_div]
          congr 1
          rw [add_comm]]
    ring
  rw [hEq]
  set K : ℝ := 4 * (‖z‖ + 1) with hK
  have hmajor : Summable (fun m : ℕ => K * (1 / ((m : ℝ) + 1) ^ 2)) :=
    Complex.summable_one_div_natCast_add_one_sq.mul_left K
  have hpt : ∀ m : ℕ, ‖((m : ℂ) + 1)⁻¹ - (z + (m : ℂ))⁻¹‖
      ≤ K * (1 / ((m : ℝ) + 1) ^ 2) := by
    intro m
    have h1 : ‖((m : ℂ) + 1)⁻¹ - (z + (m : ℂ))⁻¹‖
        ≤ (‖z‖ + 1) / ((1 / 4 : ℝ) * ((m : ℝ) + 1) ^ 2) :=
      Complex.norm_inv_add_one_sub_inv_le (a := (1 / 4 : ℝ)) (R := ‖z‖)
        (by norm_num) (by norm_num) hza (le_refl ‖z‖) m
    calc ‖((m : ℂ) + 1)⁻¹ - (z + (m : ℂ))⁻¹‖
        ≤ (‖z‖ + 1) / ((1 / 4 : ℝ) * ((m : ℝ) + 1) ^ 2) := h1
      _ = K * (1 / ((m : ℝ) + 1) ^ 2) := by
          rw [hK]
          field_simp
  have hnorm_summable : Summable (fun m : ℕ =>
      ‖((m : ℂ) + 1)⁻¹ - (z + (m : ℂ))⁻¹‖) :=
    Summable.of_nonneg_of_le (f := fun m : ℕ => K * (1 / ((m : ℝ) + 1) ^ 2))
      (g := fun m : ℕ => ‖((m : ℂ) + 1)⁻¹ - (z + (m : ℂ))⁻¹‖)
