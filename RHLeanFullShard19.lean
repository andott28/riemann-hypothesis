  have hsub : ∫ y : ℝ, f y * cexp ((-z) * (y : ℂ))
      = ∫ y : ℝ, f (-y) * cexp ((-z) * ((-y : ℝ) : ℂ)) := by
    rw [← integral_neg_eq_self (f := fun y : ℝ => f y * cexp ((-z) * (y : ℂ)))]
  rw [hsub]
  apply integral_congr_ae
  filter_upwards with y
  rw [heven y]
  congr 1
  push_cast
  ring
