section Inline_ExplicitFormula_RH45
noncomputable section
open MeasureTheory Complex Set Filter
open scoped Real Topology BigOperators ComplexConjugate
namespace RHLean.ExplicitFormula
noncomputable def digammaDensity (r : ℝ) : ℝ :=
  (Complex.digamma ((1 / 4 : ℂ) + ((r / 2 : ℝ) : ℂ) * I)).re
noncomputable def digammaSpectralBlock (f : ℝ → ℂ) : ℝ :=
  (1 / (2 * Real.pi)) * ∫ r : ℝ, digammaDensity r * (spectralTest f r).re
theorem digammaDensity_eq_archDensity_add (r : ℝ) :
    digammaDensity r = archDensity r + Real.log Real.pi := by
  unfold digammaDensity archDensity
  ring
theorem continuous_digammaDensity : Continuous digammaDensity := by
  rw [show digammaDensity = fun r : ℝ => archDensity r + Real.log Real.pi from
    funext digammaDensity_eq_archDensity_add]
  exact continuous_archDensity.add continuous_const
theorem continuous_spectralTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Continuous (spectralTest f) :=
  (differentiable_transf (contDiff_autocorr hf)
    (hasCompactSupport_autocorr hf)).continuous.comp (by fun_prop)
theorem exists_spectralTest_norm_pow_mul_le {f : ℝ → ℂ} (hf : f ∈ oddCore) (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ r : ℝ, (1 + |r|) ^ n * ‖spectralTest f r‖ ≤ C := by
  obtain ⟨R, hR0, hR⟩ := exists_support_radius (hasCompactSupport_autocorr hf)
  obtain ⟨C, hC0, hC⟩ := exists_transf_norm_pow_mul_le hR0 (by norm_num : (0 : ℝ) ≤ 1 / 4)
    (contDiff_autocorr hf) hR n
  refine ⟨C, hC0, fun r => ?_⟩
  have h := hC ((r : ℂ) * I) (by simp)
  have hnorm : ‖((r : ℂ) * I)‖ = |r| := by simp
  simpa [spectralTest, hnorm] using h
theorem integrable_spectralTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (spectralTest f) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_spectralTest_norm_pow_mul_le hf 2
  refine Integrable.mono' (integrable_inv_one_add_sq.const_mul C)
    (continuous_spectralTest hf).aestronglyMeasurable ?_
  filter_upwards with r
  have hle : ‖spectralTest f r‖ ≤ C / (1 + |r|) ^ 2 := by
    rw [le_div_iff₀ (by positivity)]
    calc ‖spectralTest f r‖ * (1 + |r|) ^ 2
        = (1 + |r|) ^ 2 * ‖spectralTest f r‖ := by ring
      _ ≤ C := hC r
  calc ‖spectralTest f r‖ ≤ C / (1 + |r|) ^ 2 := hle
    _ = C * ((1 + |r|) ^ 2)⁻¹ := by rw [div_eq_mul_inv]
    _ ≤ C * (1 + r ^ 2)⁻¹ := by
        refine mul_le_mul_of_nonneg_left ?_ hC0
        rw [inv_le_inv₀ (by positivity) (by positivity)]
        nlinarith [sq_abs r, abs_nonneg r, sq_nonneg r]
theorem integrable_normSq_complex {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (fun x : ℝ => ((‖f x‖ ^ 2 : ℝ) : ℂ)) volume := by
  have hcont : Continuous (fun x : ℝ => ((‖f x‖ ^ 2 : ℝ) : ℂ)) :=
    Complex.continuous_ofReal.comp (hf.1.continuous.norm.pow 2)
  refine hcont.integrable_of_hasCompactSupport ?_
  refine HasCompactSupport.of_support_subset_isCompact hf.2.1.isCompact (fun x hx => ?_)
  exact subset_tsupport f (fun h => hx (by simp [h]))
theorem integral_spectralTest_re_eq {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    (∫ r : ℝ, (spectralTest f r).re) = 2 * Real.pi * ∫ x : ℝ, ‖f x‖ ^ 2 := by
  have hexp : ∀ r : ℝ, Complex.exp (-(Complex.I * ((0 : ℝ) : ℂ)) * (r : ℂ)) = 1 := by
    intro r
    simp
  calc (∫ r : ℝ, (spectralTest f r).re)
      = (∫ r : ℝ, spectralTest f r).re :=
        integral_re (integrable_spectralTest hf)
    _ = (∫ r : ℝ, spectralTest f r
          * Complex.exp (-(Complex.I * ((0 : ℝ) : ℂ)) * (r : ℂ))).re := by
        congr 1
        apply integral_congr_ae
        filter_upwards with r
        rw [hexp r, mul_one]
    _ = 2 * Real.pi * (autocorr f 0).re := ghatAt_eq_aux hf 0
    _ = 2 * Real.pi * ∫ x : ℝ, ‖f x‖ ^ 2 := by
        rw [autocorr_zero hf]
        congr 1
        calc (∫ x : ℝ, ((‖f x‖ ^ 2 : ℝ) : ℂ)).re
            = ∫ x : ℝ, (((‖f x‖ ^ 2 : ℝ) : ℂ)).re :=
              (integral_re (integrable_normSq_complex hf)).symm
          _ = ∫ x : ℝ, ‖f x‖ ^ 2 := by
              apply integral_congr_ae
              filter_upwards with x
              rw [Complex.ofReal_re]
theorem integrable_of_polyBound_mul_spectralTest {g : ℝ → ℝ} (hg_cont : Continuous g)
    (hg : ∃ C : ℝ, ∃ m : ℕ, 0 ≤ C ∧ ∀ r : ℝ, |g r| ≤ C * (1 + |r|) ^ m)
    {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (fun r : ℝ => g r * (spectralTest f r).re) volume := by
  obtain ⟨C, m, hC0, hC⟩ := hg
  obtain ⟨D, hD0, hD⟩ := exists_spectralTest_norm_pow_mul_le hf (m + 2)
  have hcont : Continuous (fun r : ℝ => g r * (spectralTest f r).re) :=
    hg_cont.mul (Complex.continuous_re.comp (continuous_spectralTest hf))
  refine Integrable.mono' (integrable_inv_one_add_sq.const_mul (C * D))
    hcont.aestronglyMeasurable ?_
  filter_upwards with r
  have hspec : ‖spectralTest f r‖ ≤ D / (1 + |r|) ^ (m + 2) := by
    rw [le_div_iff₀ (by positivity)]
    calc ‖spectralTest f r‖ * (1 + |r|) ^ (m + 2)
        = (1 + |r|) ^ (m + 2) * ‖spectralTest f r‖ := by ring
      _ ≤ D := hD r
  calc ‖g r * (spectralTest f r).re‖
      = |g r| * |(spectralTest f r).re| := by rw [Real.norm_eq_abs, abs_mul]
    _ ≤ (C * (1 + |r|) ^ m) * ‖spectralTest f r‖ :=
        mul_le_mul (hC r) (Complex.abs_re_le_norm _) (abs_nonneg _) (by positivity)
    _ ≤ (C * (1 + |r|) ^ m) * (D / (1 + |r|) ^ (m + 2)) :=
        mul_le_mul_of_nonneg_left hspec (by positivity)
    _ = (C * D) * (1 / (1 + |r|) ^ 2) := by
        field_simp
        ring
    _ ≤ (C * D) * (1 + r ^ 2)⁻¹ := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        rw [one_div, inv_le_inv₀ (by positivity) (by positivity)]
        nlinarith [sq_abs r, abs_nonneg r, sq_nonneg r]
theorem digammaDensity_polyBound :
    ∃ C : ℝ, ∃ m : ℕ, 0 ≤ C ∧ ∀ r : ℝ, |digammaDensity r| ≤ C * (1 + |r|) ^ m := by
  obtain ⟨C, hC0, m, hC⟩ := digammaStripPolyBound
  refine ⟨C + |Real.log Real.pi|, m, add_nonneg hC0.le (abs_nonneg _), fun r => ?_⟩
  have hone : (1 : ℝ) ≤ (1 + |r|) ^ m := by
    calc (1 : ℝ) = 1 ^ m := (one_pow m).symm
      _ ≤ (1 + |r|) ^ m :=
          pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1)
            (le_add_of_nonneg_right (abs_nonneg r)) m
  calc |digammaDensity r| = |archDensity r + Real.log Real.pi| := by
        rw [digammaDensity_eq_archDensity_add]
    _ ≤ |archDensity r| + |Real.log Real.pi| := abs_add_le _ _
    _ ≤ C * (1 + |r|) ^ m + |Real.log Real.pi| := add_le_add (hC r) le_rfl
    _ ≤ (C + |Real.log Real.pi|) * (1 + |r|) ^ m := by
        have := le_mul_of_one_le_right (abs_nonneg (Real.log Real.pi)) hone
        nlinarith
theorem integrable_digammaDensity_mul_spectralTest {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    Integrable (fun r : ℝ => digammaDensity r * (spectralTest f r).re) volume :=
  integrable_of_polyBound_mul_spectralTest continuous_digammaDensity
    digammaDensity_polyBound hf
theorem archIntegrable_of_oddCore {f : ℝ → ℂ} (hf : f ∈ oddCore) : ArchIntegrable f := by
  have h1 := integrable_digammaDensity_mul_spectralTest hf
  have h2 : Integrable (fun r : ℝ => Real.log Real.pi * (spectralTest f r).re) volume :=
    (integrable_spectralTest hf).re.const_mul _
  have h := h1.sub h2
  refine h.congr ?_
  filter_upwards with r
  change digammaDensity r * (spectralTest f r).re
      - Real.log Real.pi * (spectralTest f r).re = (spectralTest f r).re * archDensity r
  rw [digammaDensity_eq_archDensity_add]
  ring
theorem archimedeanBlock_eq_digammaSpectralBlock {f : ℝ → ℂ} (hf : f ∈ oddCore) :
    archimedeanBlock f
      = digammaSpectralBlock f - Real.log Real.pi * (∫ x : ℝ, ‖f x‖ ^ 2) := by
  have hspec_int : Integrable (fun r : ℝ => (spectralTest f r).re) volume :=
    (integrable_spectralTest hf).re
  have hdig_int := integrable_digammaDensity_mul_spectralTest hf
  have hsplit : ∀ r : ℝ, archDensity r * (spectralTest f r).re
      = digammaDensity r * (spectralTest f r).re
        - Real.log Real.pi * (spectralTest f r).re := by
    intro r
    rw [digammaDensity_eq_archDensity_add]
    ring
  unfold archimedeanBlock digammaSpectralBlock
  rw [show (∫ r : ℝ, archDensity r * (spectralTest f r).re)
      = ∫ r : ℝ, (digammaDensity r * (spectralTest f r).re
          - Real.log Real.pi * (spectralTest f r).re) from
        integral_congr_ae (Eventually.of_forall hsplit)]
  rw [integral_sub hdig_int (hspec_int.const_mul _), integral_const_mul,
    integral_spectralTest_re_eq hf]
  field_simp [Real.pi_ne_zero]
def DigammaArchimedeanMatchAt (a : ℝ) : Prop :=
  0 < a → ∀ f : ℝ → ℂ, f ∈ localizedCore a →
    digammaSpectralBlock f
      = archForm a f
        + (physicalConstant + Real.log Real.pi)
            * (∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 ∂volume)
        + potentialForm a f - gammaForm a f
theorem integral_normSq_eq_setIntegral {a : ℝ} {f : ℝ → ℂ} (hf : f ∈ localizedCore a) :
    (∫ x : ℝ, ‖f x‖ ^ 2) = ∫ x in Set.Ioo (-a) a, ‖f x‖ ^ 2 := by
  have hpt : ∀ x ∉ Set.Ioo (-a) a, ‖f x‖ ^ 2 = 0 := by
    intro x hx
    have hzero : f x = 0 := by
      by_contra h
      exact hx (hf.2 (by simpa using h))
    simp [hzero]
  rw [← integral_indicator measurableSet_Ioo]
  apply integral_congr_ae
  filter_upwards with x
  by_cases hx : x ∈ Set.Ioo (-a) a
  · rw [Set.indicator_of_mem hx]
  · rw [Set.indicator_of_notMem hx, hpt x hx]
theorem archimedeanMatchAt_of_digammaMatch {a : ℝ} (h : DigammaArchimedeanMatchAt a) :
    ArchimedeanMatchAt a := by
  intro ha f hf
  have hodd : f ∈ oddCore := localizedCore_subset_oddCore a hf
  have hsplit := archimedeanBlock_eq_digammaSpectralBlock hodd
  have hd := h ha f hf
  rw [archimedeanBlock_eq_digammaSpectralBlock hodd, hd, integral_normSq_eq_setIntegral hf]
  ring
end RHLean.ExplicitFormula
end
