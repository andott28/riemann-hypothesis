  have h2I : (2 * I : ℂ) ≠ 0 := mul_ne_zero two_ne_zero Complex.I_ne_zero
  have hlim := rectangleResidueLimit_strip hh hdecay hT hTpos hbd
  have htop : Tendsto (fun T : ℝ => stripTopIntegral h T) atTop (𝓝 0) :=
    tendsto_horizontal_integral_zero hgrowth hdecay
  have h2top : Tendsto (fun n => 2 * stripTopIntegral h (T n)) atTop (𝓝 (2 * 0)) :=
    (tendsto_const_nhds (x := (2 : ℂ))).mul (htop.comp hT)
  have hsum : Tendsto (fun n => rectangleBoundaryIntegral (xiLogIntegrand h)
        (stripLeft (T n)) (stripRight (T n)) + 2 * stripTopIntegral h (T n)) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * S + 2 * 0)) :=
    hlim.add h2top
  have hprod : Tendsto (fun n => 2 * I * stripRightIntegral h (T n)) atTop
      (𝓝 (2 * (Real.pi : ℂ) * I * S)) := by
    have hsum' : Tendsto (fun n => rectangleBoundaryIntegral (xiLogIntegrand h)
          (stripLeft (T n)) (stripRight (T n)) + 2 * stripTopIntegral h (T n)) atTop
        (𝓝 (2 * (Real.pi : ℂ) * I * S)) := by
      simpa using hsum
    refine hsum'.congr' ?_
    filter_upwards with n
    have hdec := stripBoundaryIntegral_even_decomposition heven (T n)
    linear_combination hdec
  have hval : (2 * (Real.pi : ℂ) * I * S) / (2 * I) = (Real.pi : ℂ) * S := by
    field_simp
  have hR : Tendsto (fun n => (2 * I * stripRightIntegral h (T n)) / (2 * I)) atTop
      (𝓝 ((Real.pi : ℂ) * S)) := by
    simpa only [hval] using hprod.div_const (2 * I)
