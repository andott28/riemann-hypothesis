  have hnormval : ∀ x : ℝ,
      ‖(2 * (Real.pi : ℂ) * I * (x : ℂ)) ^ 2‖ = (2 * Real.pi * |x|) ^ 2 := by
    intro x
    have h1 : ‖(2 * (Real.pi : ℂ) * I * (x : ℂ))‖ = 2 * Real.pi * |x| := by
      have h2 : ‖((2 : ℂ))‖ = 2 := by norm_num
