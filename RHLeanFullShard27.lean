theorem mertensSweep_closed : MertensSweep := by
  intro k hk hkX
  have hcheck : mertensHi k < harmonicQ k - 1 :=
    mertensGo_sound 3594641 (by simpa [mertensRunSpecial, mertensRun] using mertensCheck_proved)
      k hkX hk
  have hcast : ((mertensHi k : ℚ) : ℝ) < ((harmonicQ k : ℚ) : ℝ) - 1 := by
    exact_mod_cast hcheck
  have hHle : ((harmonicQ k : ℚ) : ℝ) ≤ 1 + Real.log (k : ℝ) := by
    rw [harmonicQ_eq_harmonic]
    exact harmonic_le_one_add_log k
  have hTle : (∑ n ∈ Finset.range (k + 1), Lambda n / (n : ℝ))
      ≤ ((mertensHi k : ℚ) : ℝ) := by
    unfold mertensHi
    rw [Rat.cast_sum]
    apply Finset.sum_le_sum
    intro n _
    push_cast
    exact div_le_div_of_nonneg_right (lambda_le_hiLambda n) (Nat.cast_nonneg n)
  have hfull : (∑ n ∈ Finset.range (k + 1), Lambda n / (n : ℝ)) ≤ Real.log (k : ℝ) := by
    linarith
  exact mertensActive_of_all hk hfull







theorem wsweep_closed :
    ∀ k : ℕ, 7 ≤ k → k ≤ 3594641 →
      0 < RHLean.GateII.Chain.masterGap k (Walign k) := by
  intro k hk hkX
  have hsound := masterGo_sound 3594640 (by
    simpa [masterRunSpecial, masterRun] using masterCheck_proved)
    k (by omega) hkX hk
  have htot := masterGo_tot (k - 1)
  have hw := masterGo_w (k - 1)
  have hk1 : k - 1 + 1 = k := by omega
  have hk2 : k - 1 + 2 = k + 1 := by omega
  rw [hk1, hk2] at htot hw
  rw [htot, hw] at hsound
  have hV : RHLean.GateII.Chain.Vsum k
      ≤ ((∑ p ∈ Finset.range (k + 1), Vhi k p loFun hiFun : ℚ) : ℝ) :=
    Vsum_le_VhiSum k loFun_nonneg
      (fun n hn => loFun_le_lambda hn) (fun n hn => lambda_le_hiFun hn)
  have hW : Walign k
      ≤ ∑ x ∈ Finset.range (k + 1), alignedCoeff x * (binA k x hiFun : ℝ) :=
    Walign_le_binA_sum k
  have hV0 : 0 ≤ RHLean.GateII.Chain.Vsum k := Vsum_nonneg k
  have hc : 439 / (250 * Real.log 2)
      ≤ 439 / (250 * (log2loQ : ℝ)) := by
    have hlog : (log2loQ : ℝ) ≤ Real.log 2 := log2loQ_sound
    have hden : 250 * (log2loQ : ℝ) ≤ 250 * Real.log 2 := by linarith
    have hpos : (0 : ℝ) < 250 * (log2loQ : ℝ) := by
      have hq : (0 : ℚ) < log2loQ := by norm_num [log2loQ]
      exact_mod_cast (mul_pos (by norm_num : (0 : ℚ) < 250) hq)
    exact div_le_div_of_nonneg_left (by norm_num) hpos hden
  have hc0 : (0 : ℝ) ≤ 439 / (250 * (log2loQ : ℝ)) := by
    have hq : (0 : ℚ) ≤ log2loQ := by norm_num [log2loQ]
    have hpos : (0 : ℝ) < 250 * (log2loQ : ℝ) := by
      have hq : (0 : ℚ) < log2loQ := by norm_num [log2loQ]
      exact_mod_cast (mul_pos (by norm_num : (0 : ℚ) < 250) hq)
    exact div_nonneg (by norm_num) hpos.le
  have hcV : (439 / (250 * Real.log 2)) * RHLean.GateII.Chain.Vsum k
      ≤ (439 / (250 * (log2loQ : ℝ)))
          * ((∑ p ∈ Finset.range (k + 1), Vhi k p loFun hiFun : ℚ) : ℝ) := by
    have h1 : (439 / (250 * Real.log 2)) * RHLean.GateII.Chain.Vsum k
        ≤ (439 / (250 * (log2loQ : ℝ))) * RHLean.GateII.Chain.Vsum k :=
      mul_le_mul_of_nonneg_right hc hV0
    have h2 : (439 / (250 * (log2loQ : ℝ))) * RHLean.GateII.Chain.Vsum k
        ≤ (439 / (250 * (log2loQ : ℝ)))
            * ((∑ p ∈ Finset.range (k + 1), Vhi k p loFun hiFun : ℚ) : ℝ) :=
      mul_le_mul_of_nonneg_left hV hc0
    linarith
  have hW5 : (5 / 2) * Walign k
      ≤ (5 / 2) * ∑ x ∈ Finset.range (k + 1), alignedCoeff x * (binA k x hiFun : ℝ) :=
    mul_le_mul_of_nonneg_left hW (by norm_num)
  have hloglow : (logLower k : ℝ) ≤ Real.log (k : ℝ) :=
    logLower_sound_nat (by omega)
  unfold RHLean.GateII.Chain.masterGap
  linarith

end

