theorem ThetaRel_of_int_data {K : ℕ}
    (hd : ∀ m : ℕ, X0 ≤ m → m ≤ K →
      |Chebyshev.theta (m : ℝ) - (m : ℝ)| ≤ (13 / 100) * (m : ℝ) - 1) :
    ∀ t ∈ Set.Icc (X0 : ℝ) (K : ℝ), |Chebyshev.theta t - t| ≤ (13 / 100) * t := by
  intro t ht
  obtain ⟨ht0, htK⟩ := ht
  set m : ℕ := ⌊t⌋₊ with hm
  have htm : Chebyshev.theta t = Chebyshev.theta (m : ℝ) := by
    rw [Chebyshev.theta_eq_theta_coe_floor t]
  have hm_ge : X0 ≤ m := by
    rw [hm]
    exact Nat.le_floor ht0
  have hm_le : m ≤ K := by
    have h2 : (m : ℝ) ≤ (K : ℝ) := by
      rw [hm]
      exact le_trans (Nat.floor_le (le_trans (Nat.cast_nonneg X0) ht0)) htK
    exact_mod_cast h2
  have hd' := hd m hm_ge hm_le
  have hfl : (m : ℝ) ≤ t := by
    rw [hm]; exact Nat.floor_le (le_trans (Nat.cast_nonneg X0) ht0)
  have hlt : t < (m : ℝ) + 1 := by rw [hm]; exact Nat.lt_floor_add_one t
