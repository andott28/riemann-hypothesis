theorem upper_le_lower_scalar_eps {u u₀ : ℝ} (hu : u₀ ≤ u) (h15 : 15 ≤ u₀)
    (h151 : u₀ ≤ 15.1) :
    (1 / Real.log 2) * (0.100317302 * u + 3.13082720797)
      ≤ 11.045 - 1.91 - u / 19 + (2001 / 2500 : ℝ) * (u - u₀) - 1.52 := by
  have hlog2 : (0.6931471803 : ℝ) ≤ Real.log 2 := le_of_lt Real.log_two_gt_d9
  have h1 : (1 / Real.log 2) * (0.100317302 * u + 3.13082720797)
      ≤ (1 / 0.6931471803) * (0.100317302 * u + 3.13082720797) := by
    apply mul_le_mul_of_nonneg_right _ (by nlinarith [hu, h15])
    apply div_le_div_of_nonneg_left (by norm_num) (by norm_num) hlog2
  have h2 : (1 / 0.6931471803) * (0.100317302 * u + 3.13082720797)
      ≤ 11.045 - 1.91 - u / 19 + (2001 / 2500 : ℝ) * (u - u₀) - 1.52 := by
    nlinarith [hu, h15, h151]
  linarith







theorem sigmaTilde_ge_of_bounds {k : ℕ} (hk : RHLean.GateII.SA.X0 ≤ k)
    (hFX0 : 11.045 ≤ Fprime RHLean.GateII.SA.X0)
    (hTheta : ∀ t ∈ Set.Icc (RHLean.GateII.SA.X0 : ℝ) (k : ℝ),
      |Chebyshev.theta t - t| ≤ (13 / 100) * t)
    (hVup : (1 / Real.log 2) * Vsum k
      ≤ (1 / Real.log 2) * (0.100317302 * Real.log (k : ℝ) + 3.13082720797)) :
    (1 / Real.log 2) * Vsum k ≤ sigmaTilde k := by
  have hu_le : Real.log (RHLean.GateII.SA.X0 : ℝ) ≤ Real.log (k : ℝ) :=
    Real.log_le_log (by norm_num [RHLean.GateII.SA.X0]) (by exact_mod_cast hk)
  have hk0 : 0 < k := lt_of_lt_of_le (by norm_num [RHLean.GateII.SA.X0]) hk

  have hSt := Fprime_sub_ge (A := RHLean.GateII.SA.X0) (B := k) X0_ge_5 hk
    (by norm_num : (0 : ℝ) ≤ 13 / 100) (by norm_num : (13 : ℝ) / 100 ≤ 1) hTheta
  have hFk : 11.045 + ((1 - 13 / 100)
      * (Phi0 (Real.log (k : ℝ)) - Phi0 (Real.log (RHLean.GateII.SA.X0 : ℝ)))
      - 4 * (13 / 100) - gpar2 (RHLean.GateII.SA.X0 : ℝ)) ≤ Fprime k :=
    by linarith [hSt, hFX0]

  have hPhi0 : (23 / 25 : ℝ) * (Real.log (k : ℝ) - Real.log (RHLean.GateII.SA.X0 : ℝ))
      ≤ Phi0 (Real.log (k : ℝ)) - Phi0 (Real.log (RHLean.GateII.SA.X0 : ℝ)) :=
    Phi0_sub_ge hu_le log_X0_ge_15
  have hPhi2 : (2001 / 2500 : ℝ)
      * (Real.log (k : ℝ) - Real.log (RHLean.GateII.SA.X0 : ℝ))
      ≤ (1 - 13 / 100)
        * (Phi0 (Real.log (k : ℝ)) - Phi0 (Real.log (RHLean.GateII.SA.X0 : ℝ))) := by
    have hle := mul_le_mul_of_nonneg_left hPhi0 (by norm_num : (0 : ℝ) ≤ 1 - 13 / 100)
    have h2 : (2001 / 2500 : ℝ) ≤ (1 - 13 / 100) * (23 / 25) := by norm_num
    have h3 : (0 : ℝ) ≤ Real.log (k : ℝ) - Real.log (RHLean.GateII.SA.X0 : ℝ) :=
      sub_nonneg.mpr hu_le
    nlinarith [mul_le_mul_of_nonneg_right h2 h3, hle]
  have hg : gpar2 (RHLean.GateII.SA.X0 : ℝ) ≤ 1 := gpar2_X0_le_one

  have hDiv := Fprime_sub_le_sigmaTilde (k := k) hk0
  have hsig : 11.045 - 1.91 - Real.log (k : ℝ) / 19
      + (2001 / 2500 : ℝ) * (Real.log (k : ℝ) - Real.log (RHLean.GateII.SA.X0 : ℝ))
      - 1.52 ≤ sigmaTilde k :=
    by linarith [hDiv, hFk, hPhi2, hg]

  have hsc := upper_le_lower_scalar_eps (u := Real.log (k : ℝ))
    (u₀ := Real.log (RHLean.GateII.SA.X0 : ℝ)) hu_le log_X0_ge_15 log_X0_le_151
  linarith [hVup, hsc, hsig]

