noncomputable def NsetTerm (k m : ℕ) : ℝ :=
  ∑ n ∈ (RHLean.GateII.Nset k m).filter (fun n => Nat.Prime n),
    (RHLean.GateII.Lambda n - cBin k m * (n : ℝ)) ^ 2 / (n : ℝ)


theorem NsetTerm_zero (k : ℕ) : NsetTerm k 0 = 0 := by
  unfold NsetTerm
  have hempty : RHLean.GateII.Nset k 0 = ∅ := by
    rw [Finset.eq_empty_iff_forall_notMem]
    intro n hn
    obtain ⟨hnle, hΛ, _, hdiv⟩ := mem_Nset.mp hn
    have hnpos : 0 < n := by
      rcases Nat.eq_zero_or_pos n with h0 | h
      · subst h0
        exact absurd (by simp [RHLean.GateII.Lambda, ArithmeticFunction.map_zero]) hΛ
      · exact h
    have hlt : k < n := Nat.lt_of_div_eq_zero hnpos hdiv
    omega
  rw [hempty, Finset.filter_empty, Finset.sum_empty]


theorem NsetTerm_zero_of_gt_third {k m : ℕ} (hm : k / 3 < m) (hnm : m ≠ k / 2) :
    NsetTerm k m = 0 := by
  unfold NsetTerm
  rw [Nset_prime_tail_eq_empty hm hnm, Finset.sum_empty]



theorem primePart_eq_Icc_add_div2 (k : ℕ) (hk : X0 ≤ k) :
    primePart k
      = (∑ m ∈ Finset.Icc 1 (k / 3), NsetTerm k m) + NsetTerm k (k / 2) := by
  rw [show primePart k = ∑ m ∈ Finset.range (k + 1), NsetTerm k m by
    simpa [NsetTerm] using primePart_eq_sum_Nset k]
  let T : Finset ℕ := Finset.Icc 1 (k / 3) ∪ {k / 2}
  have hTsub : T ⊆ Finset.range (k + 1) := by
    intro m hm
    rw [Finset.mem_range]
    rcases Finset.mem_union.mp hm with hm | hm
    · have hm' := Finset.mem_Icc.mp hm
      have : m ≤ k / 3 := hm'.2
      have : k / 3 ≤ k := Nat.div_le_self k 3
      omega
    · have : m = k / 2 := by simpa using hm
      subst this
      have : k / 2 ≤ k := Nat.div_le_self k 2
      omega
  have hzero : ∀ m ∈ Finset.range (k + 1), m ∉ T → NsetTerm k m = 0 := by
    intro m hm hmT
    have hmle : m ≤ k := by
      have := Finset.mem_range.mp hm
      omega
    by_cases hm0 : m = 0
    · subst hm0
      exact NsetTerm_zero k
    · have hm1 : 1 ≤ m := by omega
      have hgt : k / 3 < m := by
        by_contra h
        have : m ≤ k / 3 := by omega
        exact hmT (Finset.mem_union_left _ (Finset.mem_Icc.mpr ⟨hm1, this⟩))
      have hne : m ≠ k / 2 := by
        intro h
        exact hmT (Finset.mem_union_right _ (by simp [h]))
      exact NsetTerm_zero_of_gt_third hgt hne
  have hdisj : Disjoint (Finset.Icc 1 (k / 3)) ({k / 2} : Finset ℕ) := by
    rw [Finset.disjoint_left]
    intro m hm1 hm2
    simp only [Finset.mem_Icc] at hm1
    simp only [Finset.mem_singleton] at hm2
    subst hm2
    have hkR : 3594641 ≤ k := hk
    have : k / 3 < k / 2 := by omega
    omega
  calc (∑ m ∈ Finset.range (k + 1), NsetTerm k m)
      = ∑ m ∈ T, NsetTerm k m := (Finset.sum_subset hTsub hzero).symm
    _ = (∑ m ∈ Finset.Icc 1 (k / 3), NsetTerm k m)
          + ∑ m ∈ ({k / 2} : Finset ℕ), NsetTerm k m := Finset.sum_union hdisj
    _ = (∑ m ∈ Finset.Icc 1 (k / 3), NsetTerm k m) + NsetTerm k (k / 2) := by simp





def PrimePartThetaResidual : Prop :=
  ∀ k : ℕ, X0 ≤ k → ∀ m ∈ Finset.Icc 1 (k / 3),
    ∀ t ∈ Set.Icc ((k : ℝ) / ((m : ℝ) + 1)) ((k : ℝ) / (m : ℝ)),
      |Chebyshev.theta t - t|
        ≤ RHLean.GateII.AWGC.Dm m * ((k : ℝ) / (m : ℝ))
            / (RHLean.GateII.AWGC.La k m) ^ 2


theorem exp_15_le_X0 : Real.exp 15 ≤ (X0 : ℝ) := by
  have h1 : Real.exp 1 < (2.7182818286 : ℝ) := Real.exp_one_lt_d9
  have h2 : (Real.exp 1) ^ 15 < (2.7182818286 : ℝ) ^ 15 :=
    pow_lt_pow_left₀ h1 (Real.exp_pos 1).le (by norm_num : (15 : ℕ) ≠ 0)
  have h3 : Real.exp 15 = (Real.exp 1) ^ 15 := by
    rw [← Real.exp_nat_mul]
    norm_num
  have h4 : (2.7182818286 : ℝ) ^ 15 < (3594641 : ℝ) := by norm_num
  have hX0eq : (X0 : ℝ) = 3594641 := by norm_num [X0]
  rw [hX0eq, h3]
  linarith


theorem log_ge_15_of_X0 {k : ℕ} (hk : X0 ≤ k) : 15 ≤ Real.log (k : ℝ) := by
  have hX0pos : (0 : ℝ) < (X0 : ℝ) := by norm_num [X0]
  have hkpos : (0 : ℝ) < (k : ℝ) := lt_of_lt_of_le hX0pos (by exact_mod_cast hk)
  have hk15 : Real.exp 15 ≤ (k : ℝ) :=
    le_trans exp_15_le_X0 (by exact_mod_cast hk)
  exact (Real.le_log_iff_exp_le hkpos).mpr hk15


theorem activity_of_le_third {k m : ℕ} (hk : X0 ≤ k) (hm : m ≤ k / 3) :
    2.9 < (k : ℝ) / ((m : ℝ) + 1) := by
  have hkX : (3594641 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hkpos : (0 : ℝ) < (k : ℝ) := by linarith
  have hmR : (m : ℝ) ≤ (k : ℝ) / 3 := by
    have h1 : (m : ℝ) ≤ ((k / 3 : ℕ) : ℝ) := by exact_mod_cast hm
    have h2 : ((k / 3 : ℕ) : ℝ) ≤ (k : ℝ) / 3 := Nat.cast_div_le
    linarith
  have hden : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hden2 : (m : ℝ) + 1 ≤ (k : ℝ) / 3 + 1 := by linarith
  have hmono : (k : ℝ) / ((k : ℝ) / 3 + 1) ≤ (k : ℝ) / ((m : ℝ) + 1) :=
    div_le_div_of_nonneg_left hkpos.le hden hden2
  have hcore : (2.9 : ℝ) < (k : ℝ) / ((k : ℝ) / 3 + 1) := by
    rw [lt_div_iff₀ (by positivity)]
    nlinarith [hkX]
  linarith


theorem tail_activity_of_le_third {k m : ℕ} (hk : X0 ≤ k) (hm : m ≤ k / 3) :
    Real.log 2.9 < Real.log (k : ℝ) - Real.log ((m : ℝ) + 1) := by
  have hfrac : (2.9 : ℝ) < (k : ℝ) / ((m : ℝ) + 1) := activity_of_le_third hk hm
  have hden : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hkpos : (0 : ℝ) < (k : ℝ) := by
    have : (0 : ℝ) < (X0 : ℝ) := by norm_num [X0]
    exact lt_of_lt_of_le this (by exact_mod_cast hk)
  have hlog : Real.log 2.9 < Real.log ((k : ℝ) / ((m : ℝ) + 1)) :=
    Real.log_lt_log (by norm_num) hfrac
  rw [Real.log_div hkpos.ne' hden.ne'] at hlog
  linarith





theorem NsetPrimeSum_lt_of_theta (hTheta : PrimePartThetaResidual) :
    ∀ k : ℕ, X0 ≤ k →
      (∑ m ∈ Finset.Icc 1 (k / 3), NsetTerm k m)
        < 0.100317302 * Real.log (k : ℝ) + 0.259330618 := by
  intro k hkX
  have hk1 : 1 ≤ k := by
    have : 1 ≤ X0 := by norm_num [X0]
    omega
  have hM200 : 200 ≤ k / 3 := by
    have : 600 ≤ k := by
      have : 600 ≤ X0 := by norm_num [X0]
      omega
    omega
  have hL : 15 ≤ Real.log (k : ℝ) := log_ge_15_of_X0 hkX
  have hmain := Nset_prime_sum_lt (k := k) (M := k / 3) hk1 hM200 hL
    (fun m hm => activity_of_le_third hkX (Finset.mem_Icc.mp hm).2)
    (fun m hm => hTheta k hkX m hm)
    (fun m hm => tail_activity_of_le_third hkX (Finset.mem_Icc.mp hm).2)
  simpa [NsetTerm] using hmain





def PrimePartFiniteBound : Prop :=
  ∀ k : ℕ, X0 ≤ k →
    (∑ m ∈ Finset.Icc 1 (k / 3), NsetTerm k m) + NsetTerm k (k / 2)
      ≤ 0.100317302 * Real.log (k : ℝ) + 0.259330618




theorem PrimePartBound_of_finite (h : PrimePartFiniteBound) : PrimePartBound := by
  intro k hkX
  rw [primePart_eq_Icc_add_div2 k hkX]
  exact h k hkX










