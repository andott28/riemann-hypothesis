theorem Walign_eq_binSum (k : ℕ) :
    Walign k = ∑ m ∈ Finset.range (k + 1),
      alignedCoeff m * ∑ n ∈ Nset k m, (Lambda n) ^ 2 / (n : ℝ) := by
  unfold Walign
  have hmap : ∀ n ∈ activeN k, k / n ∈ Finset.range (k + 1) := by
    intro n hn
    rw [Finset.mem_range]
    have hle : k / n ≤ k := Nat.div_le_self k n
    omega
  have hfiber := Finset.sum_fiberwise_of_maps_to (s := activeN k)
    (t := Finset.range (k + 1)) (g := fun n : ℕ => k / n)
    (f := fun n : ℕ => alignedCoeff (k / n) * (Lambda n) ^ 2 / (n : ℝ)) hmap
  rw [← hfiber]
  apply Finset.sum_congr rfl
  intro m hm
  rw [Finset.mul_sum]
  apply Finset.sum_congr ?_ ?_
  · ext n
    simp [activeN, mem_Nset, Finset.mem_range, Nat.lt_succ_iff]
    tauto
  · intro n hn
    have hkn : k / n = m := (mem_Nset.mp hn).2.2.2
    rw [hkn]
    ring

theorem Walign_nonneg (k : ℕ) : 0 ≤ Walign k := by
  unfold Walign
  exact Finset.sum_nonneg fun n hn => by
    have hΛ0 : 0 ≤ Lambda n := by
      simpa [Lambda] using ArithmeticFunction.vonMangoldt_nonneg (n := n)
    have hc0 : 0 ≤ alignedCoeff (k / n) := by
      unfold alignedCoeff
      split_ifs with h
      · norm_num
      · positivity
    exact div_nonneg (mul_nonneg hc0 (sq_nonneg _)) (Nat.cast_nonneg n)

theorem Walign_le_binA (k : ℕ) :
    Walign k ≤ ∑ m ∈ Finset.range (k + 1),
      alignedCoeff m * ∑ n ∈ Nset k m, (Lambda n) ^ 2 / (n : ℝ) :=
  le_of_eq (Walign_eq_binSum k)

theorem binA_ge (k m : ℕ) :
    (∑ n ∈ Nset k m, (Lambda n) ^ 2 / (n : ℝ))
      ≤ (binA k m hiFun : ℝ) := by
  unfold binA
  rw [Rat.cast_sum]
  apply Finset.sum_le_sum
  intro n hn
  have hpp : IsPrimePow n := isPrimePow_of_vonMangoldt_ne_zero (mem_Nset.mp hn).2.1
  have hΛ0 : 0 ≤ Lambda n := by
    simpa [Lambda] using ArithmeticFunction.vonMangoldt_nonneg (n := n)
  have hhi0 : 0 ≤ (hiFun n : ℝ) := le_trans hΛ0 (lambda_le_hiFun hpp)
  have hsq : (Lambda n) ^ 2 ≤ (hiFun n : ℝ) ^ 2 :=
    pow_le_pow_left₀ hΛ0 (lambda_le_hiFun hpp) 2
  push_cast
  exact div_le_div_of_nonneg_right hsq (Nat.cast_nonneg n)

theorem Walign_le_binA_sum (k : ℕ) :
    Walign k ≤ ∑ m ∈ Finset.range (k + 1),
      alignedCoeff m * (binA k m hiFun : ℝ) := by
  refine le_trans (Walign_le_binA k) ?_
  apply Finset.sum_le_sum
  intro m _
  have hc0 : 0 ≤ alignedCoeff m := by
    unfold alignedCoeff
    split_ifs with h
    · norm_num
    · positivity
  exact mul_le_mul_of_nonneg_left (binA_ge k m) hc0



noncomputable def masterW (s : SweepState) (k : ℕ) : ℝ :=
  ∑ x ∈ Finset.range (k + 1), alignedCoeff x * ((s.bins x).A : ℝ)


noncomputable def masterGo : ℕ → SweepState × Bool
  | 0 => (initState, true)
  | (m + 1) =>
      let prev := masterGo m
      let k := m + 2
      let s' := sweepStep k loFun hiFun prev.1
      let w := masterW s' k
      let c : ℝ := 439 / (250 * (log2loQ : ℝ))
      (s', prev.2 && decide (k < 7 ∨
        0 < 1 / 2 + (logLower k : ℝ) - c * (s'.tot : ℝ) - (5 / 2) * w))

theorem masterGo_state (m : ℕ) :
    (masterGo m).1 = (sweepGo loFun hiFun hiLogFun log2loQ log2hiQ m).1 := by
  induction m with
  | zero => rfl
  | succ m ih => simp [masterGo, sweepGo, ih]

theorem masterGo_bins (m : ℕ) :
    ∀ x, (masterGo m).1.bins x = BinState.ofSums (m + 1) x loFun hiFun := by
  intro x
  rw [masterGo_state, sweepGo_bins]

theorem masterGo_tot (m : ℕ) :
    (masterGo m).1.tot
      = ∑ p ∈ Finset.range (m + 2), Vhi (m + 1) p loFun hiFun := by
  rw [masterGo_state, sweepGo_tot]

theorem masterGo_w (m : ℕ) :
    masterW (masterGo m).1 (m + 1)
      = ∑ x ∈ Finset.range (m + 2), alignedCoeff x * (binA (m + 1) x hiFun : ℝ) := by
  unfold masterW
  apply Finset.sum_congr rfl
  intro x _
  rw [masterGo_bins m x]
  rfl

theorem masterGo_sound (m : ℕ) (h : (masterGo m).2 = true) :
    ∀ j : ℕ, 2 ≤ j → j ≤ m + 1 → 7 ≤ j →
      0 < 1 / 2 + (logLower j : ℝ)
        - (439 / (250 * (log2loQ : ℝ))) * ((masterGo (j - 1)).1.tot : ℝ)
        - (5 / 2) * masterW (masterGo (j - 1)).1 j := by
  induction m with
  | zero => intro j hj hjle h7; omega
  | succ m ih =>
      rw [masterGo] at h
      obtain ⟨hprev, hstep⟩ := Bool.and_eq_true_iff.mp h
      intro j hj hjle h7
      rcases Nat.lt_or_ge j (m + 2) with hlt | hge
      · exact ih hprev j hj (by omega) h7
      · have hj_eq : j = m + 2 := by omega
        subst hj_eq
        have hcheck := of_decide_eq_true hstep
        rcases hcheck with hsmall | hbig
        · omega
        · simpa [masterGo, masterGo_state] using hbig



unsafe def masterFast (N : Nat) : Bool := Id.run do
  let spf := mkSPF N
  let logArr := mkLogArr N spf
  let sz := N + 2
  let mut binsA := Array.replicate sz 0.0
  let mut binsB := Array.replicate sz 0.0
  let mut binsC := Array.replicate sz 0.0
  let mut tot : Float := 0.0
  let mut wTot : Float := 0.0
  let mut ok := true
  let eps : Float := 1e-6
  let log2lo : Float := 0.6931471803
  for k in List.range (N + 1) do
    if k >= 2 then
      for (n, p, _e) in ppList spf k do
        if n < k then
          let m := (k - 1) / n
          let hi := logArr.getD p 0.0 + eps
          let lo := logArr.getD p 0.0 - eps
          let tA := hi * hi / (Float.ofNat n)
          let tB := lo
          let tC := Float.ofNat n
          let oldA := binsA.getD m 0.0
          let oldB := binsB.getD m 0.0
          let oldC := binsC.getD m 0.0
          let oldT := if oldC == 0.0 then 0.0 else oldA - oldB * oldB / oldC
          let newA := oldA - tA
          let newB := oldB - tB
          let newC := oldC - tC
          let newT := if newC == 0.0 then 0.0 else newA - newB * newB / newC
          let coeff := if m == 1 then 0.0145 else 0.0301 / (Float.ofNat m * Float.ofNat m)
          wTot := wTot + coeff * (newA - oldA)
          tot := tot - oldT + newT
          binsA := binsA.set! m newA
          binsB := binsB.set! m newB
          binsC := binsC.set! m newC
      for (n, p, _e) in ppList spf (k - 1) do
        let m := k / n
        let hi := logArr.getD p 0.0 + eps
        let lo := logArr.getD p 0.0 - eps
        let tA := hi * hi / (Float.ofNat n)
        let tB := lo
        let tC := Float.ofNat n
        let oldA := binsA.getD m 0.0
        let oldB := binsB.getD m 0.0
        let oldC := binsC.getD m 0.0
        let oldT := if oldC == 0.0 then 0.0 else oldA - oldB * oldB / oldC
        let newA := oldA + tA
        let newB := oldB + tB
        let newC := oldC + tC
        let newT := if newC == 0.0 then 0.0 else newA - newB * newB / newC
        let coeff := if m == 1 then 0.0145 else 0.0301 / (Float.ofNat m * Float.ofNat m)
        wTot := wTot + coeff * (newA - oldA)
        tot := tot - oldT + newT
        binsA := binsA.set! m newA
        binsB := binsB.set! m newB
        binsC := binsC.set! m newC
      if k >= 7 then



        if 0.5 + Float.log (Float.ofNat k)
            - (439.0 / (250.0 * log2lo)) * tot - 2.5 * wTot <= 1e-3 then
          ok := false
  return ok


noncomputable def masterRun (N : ℕ) : Bool := (masterGo N).2

