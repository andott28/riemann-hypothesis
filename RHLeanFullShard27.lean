    norm_num
  rw [h3]
  have h4 : (2.7182818286 : ℝ) ^ 15 < (RHLean.GateII.SA.X0 : ℝ) := by
    norm_num [RHLean.GateII.SA.X0]
  linarith


theorem log_X0_ge_15 : 15 ≤ Real.log (RHLean.GateII.SA.X0 : ℝ) :=
