    (by norm_num [Finset.sum_range_succ])


theorem prime_le_seventeen {p : ℕ} (hp : Nat.Prime p) (h17 : p ≤ 17) :
    p ∈ ({2, 3, 5, 7, 11, 13, 17} : Finset ℕ) := by
  have hmem : p ∈ Nat.primesLE 17 := Nat.mem_primesLE.mpr ⟨h17, hp⟩
  have hlist : Nat.primesLE 17 = ({2, 3, 5, 7, 11, 13, 17} : Finset ℕ) := by decide
  rwa [hlist] at hmem


theorem small_primes_sum : (∑ p ∈ ({2, 3, 5, 7, 11, 13, 17} : Finset ℕ), tailW p)
    ≤ (191 : ℝ) / 100 := by
  have h2 : tailW 2 ≤ (7 : ℝ) / 10 / 2 :=
    tailW_le_div (p := 2) (by norm_num) log_two_le
  have h3 : tailW 3 ≤ (11 : ℝ) / 10 / 3 :=
    tailW_le_div (p := 3) (by norm_num) log_three_le
  have h5 : tailW 5 ≤ (161 : ℝ) / 100 / 5 :=
    tailW_le_div (p := 5) (by norm_num) log_five_le
  have h7 : tailW 7 ≤ (195 : ℝ) / 100 / 7 :=
    tailW_le_div (p := 7) (by norm_num) log_seven_le
  have h11 : tailW 11 ≤ (24 : ℝ) / 10 / 11 :=
    tailW_le_div (p := 11) (by norm_num) log_eleven_le
  have h13 : tailW 13 ≤ (257 : ℝ) / 100 / 13 :=
    tailW_le_div (p := 13) (by norm_num) log_thirteen_le
  have h17 : tailW 17 ≤ (284 : ℝ) / 100 / 17 :=
    tailW_le_div (p := 17) (by norm_num) log_seventeen_le
  have hsum : (∑ p ∈ ({2, 3, 5, 7, 11, 13, 17} : Finset ℕ), tailW p)
      = tailW 2 + tailW 3 + tailW 5 + tailW 7 + tailW 11 + tailW 13 + tailW 17 := by
    norm_num [Finset.sum_insert]
    ring
  rw [hsum]
  linarith





theorem sum_log_primeFactors_le {k : ℕ} (hk : k ≠ 0) :
    (∑ p ∈ k.primeFactors, Real.log (p : ℝ)) ≤ Real.log (k : ℝ) := by
  have hprod : (k : ℝ) = ∏ p ∈ k.primeFactors, (p : ℝ) ^ k.factorization p := by
    have h1 : (k : ℝ) = ((∏ p ∈ k.primeFactors, p ^ k.factorization p : ℕ) : ℝ) :=
      by exact_mod_cast (Nat.prod_primeFactors_pow_factorization hk)
    rw [h1]
    push_cast
    rfl
  have hlog : Real.log (k : ℝ)
      = ∑ p ∈ k.primeFactors, (k.factorization p : ℝ) * Real.log (p : ℝ) := by
    have h1 : Real.log (∏ p ∈ k.primeFactors, (p : ℝ) ^ k.factorization p)
        = ∑ p ∈ k.primeFactors, (k.factorization p : ℝ) * Real.log (p : ℝ) := by
      rw [Real.log_prod (fun p hp => by
        have hp0 : p ≠ 0 := (Nat.prime_of_mem_primeFactors hp).ne_zero
        positivity)]
      exact Finset.sum_congr rfl (fun p _ => by rw [Real.log_pow])
    rwa [← hprod] at h1
  rw [hlog]
  refine Finset.sum_le_sum (fun p hp => ?_)
  have hp1 : 1 ≤ k.factorization p := by
    have := (Nat.prime_of_mem_primeFactors hp).dvd_iff_one_le_factorization hk
    exact this.mp (Nat.dvd_of_mem_primeFactors hp)
  have hL : 0 ≤ Real.log (p : ℝ) := Real.log_natCast_nonneg p
  have : (1 : ℝ) ≤ (k.factorization p : ℝ) := by exact_mod_cast hp1
  nlinarith



theorem sum_tailW_primeFactors_le {k : ℕ} (hk : 0 < k) :
    (∑ p ∈ k.primeFactors, tailW p) ≤ (191 : ℝ) / 100 + Real.log (k : ℝ) / 19 := by
  have hk0 : k ≠ 0 := hk.ne'

  have hsplit := Finset.sum_filter_add_sum_filter_not (s := k.primeFactors)
    (p := fun p : ℕ => p ≤ 17) (f := tailW)

  have hsmall : (∑ p ∈ k.primeFactors.filter (fun p : ℕ => p ≤ 17), tailW p)
      ≤ (191 : ℝ) / 100 := by
    have hsub : k.primeFactors.filter (fun p : ℕ => p ≤ 17)
        ⊆ ({2, 3, 5, 7, 11, 13, 17} : Finset ℕ) := by
      intro p hp
      obtain ⟨hpf, h17⟩ := Finset.mem_filter.mp hp
      exact prime_le_seventeen (Nat.prime_of_mem_primeFactors hpf) h17
    exact le_trans (Finset.sum_le_sum_of_subset_of_nonneg hsub
      (fun p _ _ => tailW_nonneg p)) small_primes_sum

  have hlarge : (∑ p ∈ k.primeFactors.filter (fun p : ℕ => ¬ p ≤ 17), tailW p)
      ≤ Real.log (k : ℝ) / 19 := by
    have hstep : (∑ p ∈ k.primeFactors.filter (fun p : ℕ => ¬ p ≤ 17), tailW p)
        ≤ ∑ p ∈ k.primeFactors.filter (fun p : ℕ => ¬ p ≤ 17), Real.log (p : ℝ) / 19 := by
      refine Finset.sum_le_sum (fun p hp => ?_)
      obtain ⟨hpf, h17⟩ := Finset.mem_filter.mp hp
      have hpr : Nat.Prime p := Nat.prime_of_mem_primeFactors hpf
      have h19 : 19 ≤ p := by
        have h18 : p ≠ 18 := by
          rintro rfl
          norm_num [Nat.Prime] at hpr
        omega
      have h19R : (19 : ℝ) ≤ (p : ℝ) := by exact_mod_cast h19
      have hpR : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hpr.pos
      have hL : 0 ≤ Real.log (p : ℝ) := Real.log_natCast_nonneg p
      calc tailW p ≤ Real.log (p : ℝ) / (p : ℝ) := by
            simpa using tailW_le_div (p := p) hpr.one_le le_rfl
        _ ≤ Real.log (p : ℝ) / 19 := by
            apply div_le_div_of_nonneg_left hL (by norm_num) h19R
    refine le_trans hstep ?_
    rw [← Finset.sum_div]
    apply div_le_div_of_nonneg_right ?_ (by norm_num)
    exact le_trans (Finset.sum_le_sum_of_subset_of_nonneg
      (fun p hp => (Finset.mem_filter.mp hp).1) (fun p _ _ => Real.log_natCast_nonneg p))
      (sum_log_primeFactors_le hk0)
  linarith [hsplit]





theorem sum_tailW_primeTailSet_le_sigmaTilde (k : ℕ) :
    (∑ p ∈ primeTailSet k, tailW p) ≤ sigmaTilde k := by
  have hsub : primeTailSet k ⊆ activeN k := by
    intro p hp
    obtain ⟨hp', hndvd⟩ := Finset.mem_filter.mp hp
    obtain ⟨hple, h5⟩ := Finset.mem_filter.mp hp'
    have hpr : Nat.Prime p := (Nat.mem_primesLE.mp hple).2
    have hk : p ≤ k := (Nat.mem_primesLE.mp hple).1
    refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hk), ?_, hndvd⟩
    have hΛp : RHLean.GateII.Chain.Lambda p = ArithmeticFunction.vonMangoldt p := rfl
    rw [hΛp, ArithmeticFunction.vonMangoldt_apply_prime hpr]
    exact ne_of_gt (Real.log_pos (by exact_mod_cast hpr.one_lt))
  have hcongr : (∑ p ∈ primeTailSet k, tailW p)
      = ∑ p ∈ primeTailSet k,
          (RHLean.GateII.Chain.Lambda p) ^ 2
            / ((p : ℝ) * (Real.log (p : ℝ) + beta0)) := by
    refine Finset.sum_congr rfl (fun p hp => ?_)
    have hpr : Nat.Prime p := (Nat.mem_primesLE.mp (Finset.mem_filter.mp
      (Finset.mem_filter.mp hp).1).1).2
    unfold tailW
    change Real.log (p : ℝ) ^ 2 / ((p : ℝ) * (Real.log (p : ℝ) + beta0))
      = (RHLean.GateII.Chain.Lambda p) ^ 2 / ((p : ℝ) * (Real.log (p : ℝ) + beta0))
    rw [show RHLean.GateII.Chain.Lambda p = ArithmeticFunction.vonMangoldt p from rfl,
      ArithmeticFunction.vonMangoldt_apply_prime hpr]
  rw [hcongr, sigmaTilde]
  refine Finset.sum_le_sum_of_subset_of_nonneg hsub (fun n hn _ => ?_)
  have hn' := Finset.mem_filter.mp hn
  have hn2 : 2 ≤ n := by
    have hΛ : Lambda n ≠ 0 := hn'.2.1
    have hpp : IsPrimePow n :=
      ArithmeticFunction.vonMangoldt_ne_zero_iff.mp (by simpa [Lambda] using hΛ)
    exact IsPrimePow.two_le hpp
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (by omega : 0 < n)
  have hlog : 0 < Real.log (n : ℝ) := Real.log_pos (by exact_mod_cast (by omega : 1 < n))
  exact div_nonneg (sq_nonneg _) (mul_pos hnR (by linarith [beta0_pos])).le


theorem Fprime_sub_le_sigmaTilde {k : ℕ} (hk : 0 < k) :
    Fprime k - ((191 : ℝ) / 100 + Real.log (k : ℝ) / 19) ≤ sigmaTilde k := by
  have hsplit := Finset.sum_filter_add_sum_filter_not
    (s := (Nat.primesLE k).filter (fun p => 5 ≤ p)) (p := fun p : ℕ => p ∣ k) (f := tailW)
  have hdvd : (∑ p ∈ primeDvdSet k, tailW p) ≤ (191 : ℝ) / 100 + Real.log (k : ℝ) / 19 := by
    have hsub : primeDvdSet k ⊆ k.primeFactors := by
      intro p hp
      obtain ⟨hp', hpdvd⟩ := Finset.mem_filter.mp hp
      obtain ⟨hple, h5⟩ := Finset.mem_filter.mp hp'
      exact Nat.mem_primeFactors.mpr ⟨(Nat.mem_primesLE.mp hple).2, hpdvd, hk.ne'⟩
    have hmono : (∑ p ∈ primeDvdSet k, tailW p) ≤ ∑ p ∈ k.primeFactors, tailW p :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => tailW_nonneg p)
    exact le_trans hmono (sum_tailW_primeFactors_le hk)
  have hoff : (∑ p ∈ primeTailSet k, tailW p) ≤ sigmaTilde k :=
    sum_tailW_primeTailSet_le_sigmaTilde k
  have hsum : Fprime k
      = (∑ p ∈ primeTailSet k, tailW p) + ∑ p ∈ primeDvdSet k, tailW p := by
    rw [Fprime]
    unfold primeTailSet primeDvdSet
    linarith [hsplit]
  linarith

