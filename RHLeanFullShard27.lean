theorem primePart_eq_sum_Nset (k : ℕ) :
    primePart k = ∑ m ∈ Finset.range (k + 1),
      ∑ n ∈ (Nset k m).filter (fun n => Nat.Prime n),
        (Lambda n - cBin k m * (n : ℝ)) ^ 2 / (n : ℝ) := by
  have hmap : ∀ n ∈ (activeN k).filter (fun n => Nat.Prime n),
      k / n ∈ Finset.range (k + 1) := by
    intro n _
    rw [Finset.mem_range]
    have hle : k / n ≤ k := Nat.div_le_self k n
    omega
  have hfiber := Finset.sum_fiberwise_of_maps_to
    (s := (activeN k).filter (fun n => Nat.Prime n))
    (t := Finset.range (k + 1)) (g := fun n : ℕ => k / n)
    (f := fun n : ℕ => (Lambda n - cBin k (k / n) * (n : ℝ)) ^ 2 / (n : ℝ)) hmap
  rw [primePart, ← hfiber]
  refine Finset.sum_congr rfl (fun m _ => ?_)
  have hset : ((activeN k).filter (fun n => Nat.Prime n)).filter (fun n : ℕ => k / n = m)
      = (Nset k m).filter (fun n => Nat.Prime n) := by
    ext n
    simp only [mem_Nset, activeN, Finset.mem_filter, Finset.mem_range, Nat.lt_succ_iff]
    tauto
  rw [hset]
  refine Finset.sum_congr rfl (fun n hn => ?_)
  have hkn : k / n = m := (mem_Nset.mp (Finset.mem_filter.mp hn).1).2.2.2
  rw [hkn]




theorem Nset_prime_tail_subset_two {k m : ℕ} (hm : k / 3 < m) :
    ((Nset k m).filter (fun n => Nat.Prime n)) ⊆ ({2} : Finset ℕ) := by
  intro n hn
  obtain ⟨hnset, hnprime⟩ := Finset.mem_filter.mp hn
  have hkn : k / n = m := (mem_Nset.mp hnset).2.2.2
  have hm0 : 0 < m := by omega
  have hnk : n * m ≤ k := by
    rw [← hkn]
    exact Nat.mul_div_le k n
  have h3 : k < 3 * m := by omega
  have hn_lt : n < 3 := by
    by_contra h
    have h3n : 3 ≤ n := by omega
    have h1 : 3 * m ≤ n * m := Nat.mul_le_mul_right m h3n
    omega
  have hn2 : n = 2 := by
    have := hnprime.two_le
    omega
  simp [hn2]



theorem Nset_prime_tail_eq_empty {k m : ℕ} (hm : k / 3 < m) (hnm : m ≠ k / 2) :
    (Nset k m).filter (fun n => Nat.Prime n) = ∅ := by
  rw [Finset.eq_empty_iff_forall_notMem]
  intro n hn
  have h2 := Nset_prime_tail_subset_two (k := k) hm hn
  simp only [Finset.mem_singleton] at h2
  subst h2
  exact hnm ((mem_Nset.mp (Finset.mem_filter.mp hn).1).2.2.2).symm








theorem AWGC_of_data (hsweep : FiniteSweep)
    (hPrime : ∀ k : ℕ, X0 ≤ k →
