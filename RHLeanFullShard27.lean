      ∀ t ∈ Set.Icc (X0 : ℝ) (k : ℝ), |Chebyshev.theta t - t| ≤ (13 / 100) * t) :
    ∀ k : ℕ, X0 ≤ k → (1 / Real.log 2) * Vsum k ≤ sigmaTilde k :=
