    have h' : (1.105 : ℝ) ≤ ∑ k ∈ Finset.range 4, (1 / 10 : ℝ) ^ k / (Nat.factorial k : ℝ) := by
      norm_num [Finset.sum_range_succ]
    linarith
  have h3 : (RHLean.GateII.SA.X0 : ℝ) < 2.7182818283 ^ 15 * 1.105 := by
    norm_num [RHLean.GateII.SA.X0]
  have h4 : 2.7182818283 ^ 15 * 1.105 ≤ (Real.exp 1) ^ 15 * Real.exp (1 / 10) :=
    mul_le_mul (pow_le_pow_left₀ (by norm_num) he 15) he10 (by norm_num) (by positivity)
