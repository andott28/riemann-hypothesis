noncomputable def cut (a : ℝ) : ℝ → ℝ :=
  fun x => Real.smoothTransition (1 - (x / a) ^ 2)

theorem cut_contDiff (a : ℝ) : ContDiff ℝ ∞ (cut a) := by
  have h : ContDiff ℝ ∞ (fun x : ℝ => 1 - (x / a) ^ 2) := by fun_prop
  have h2 : ContDiff ℝ ∞ (fun x : ℝ => Real.smoothTransition (1 - (x / a) ^ 2)) :=
    Real.smoothTransition.contDiff.comp h
  exact h2

theorem cut_even (a x : ℝ) : cut a (-x) = cut a x := by
  unfold cut
  rw [neg_div, neg_sq]


theorem cut_eq_zero_of_le {a : ℝ} (ha : 0 < a) {x : ℝ} (h : a ≤ |x|) :
    cut a x = 0 := by
  have ha2 : (0 : ℝ) < a ^ 2 := by positivity
  have hsq : a ^ 2 ≤ x ^ 2 := by nlinarith [sq_abs x, abs_nonneg x]
  have harg : 1 - (x / a) ^ 2 ≤ 0 := by
    have h1 : (x / a) ^ 2 = x ^ 2 / a ^ 2 := by ring
    rw [h1, sub_nonpos, le_div_iff₀ ha2]
    simpa using hsq
  unfold cut
  exact Real.smoothTransition.zero_of_nonpos harg

theorem cut_support {a : ℝ} (ha : 0 < a) :
    Function.support (cut a) ⊆ Set.Ioo (-a) a := by
  intro x hx
  rw [Function.mem_support] at hx
  refine ⟨?_, ?_⟩
  · by_contra h
    have hxle : x ≤ -a := le_of_not_gt h
    have hxneg : x ≤ 0 := by linarith
    exact hx (cut_eq_zero_of_le ha (by rw [abs_of_nonpos hxneg]; linarith))
  · by_contra h
    exact hx (cut_eq_zero_of_le ha (le_trans (le_of_not_gt h) (le_abs_self x)))




theorem mem_localizedCore_of {a : ℝ} {f : ℝ → ℂ} (hcd : ContDiff ℝ ∞ f)
    (hsup : Function.support f ⊆ Set.Ioo (-a) a) (hodd : ∀ x, f (-x) = - f x) :
    f ∈ RHLean.localizedCore a := by
  refine ⟨⟨hcd, ?_, hodd⟩, hsup⟩
  refine HasCompactSupport.of_support_subset_isCompact (K := Set.Icc (-a) a)
    isCompact_Icc ?_
  intro x hx
  exact ⟨le_of_lt (hsup hx).1, le_of_lt (hsup hx).2⟩


theorem phiC_neg (n : ℕ) (x : ℝ) :
    Y7Matrix.phiC n (-x) = ((((-1 : ℝ) ^ n : ℝ)) : ℂ) * Y7Matrix.phiC n x := by
  unfold Y7Matrix.phiC
  rw [Y7Density.eval_phi_neg n x]
  push_cast
  ring


noncomputable def oldBasisCut (a : ℝ) (n : ℕ) : ℝ → ℂ :=
  fun x => (cut a x : ℂ) * Y7Matrix.phiC n (x / a)

theorem oldBasisCut_contDiff (a : ℝ) (n : ℕ) :
    ContDiff ℝ ∞ (oldBasisCut a n) := by
  have hpoly : ContDiff ℝ ∞ (fun t : ℝ => (Y7Legendre.phi n).eval t) := by
    simpa [Polynomial.aeval_def, Polynomial.eval₂_id] using
      (Y7Legendre.phi n).contDiff_aeval (𝕜 := ℝ) (n := ∞)
  have hphi : ContDiff ℝ ∞ (fun x : ℝ => Y7Matrix.phiC n (x / a)) := by
    have h1 : ContDiff ℝ ∞ (fun x : ℝ => (Y7Legendre.phi n).eval (x / a)) :=
      hpoly.comp (by fun_prop : ContDiff ℝ ∞ (fun x : ℝ => x / a))
    simpa [Y7Matrix.phiC, Function.comp_def, Complex.ofRealCLM_apply] using
      Complex.ofRealCLM.contDiff.comp h1
  have hcut : ContDiff ℝ ∞ (fun x : ℝ => (cut a x : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (cut_contDiff a)
  exact hcut.mul hphi

theorem oldBasisCut_continuous (a : ℝ) (n : ℕ) :
    Continuous (oldBasisCut a n) :=
  (oldBasisCut_contDiff a n).continuous

theorem oldBasisCut_support {a : ℝ} (ha : 0 < a) (n : ℕ) :
    Function.support (oldBasisCut a n) ⊆ Set.Ioo (-a) a := by
  intro x hx
  have hx' : oldBasisCut a n x ≠ 0 := hx
  have hcut : cut a x ≠ 0 := by
    intro h0
    exact hx' (by simp [oldBasisCut, h0])
  exact cut_support ha (by simpa [Function.mem_support] using hcut)

theorem oldBasisCut_odd {a : ℝ} {n : ℕ} (hn : Odd n) (x : ℝ) :
    oldBasisCut a n (-x) = - oldBasisCut a n x := by
  unfold oldBasisCut
  rw [cut_even (a := a), neg_div, phiC_neg]
  have hsign : (((-1 : ℝ) ^ n : ℝ)) = -1 := by
    obtain ⟨k, rfl⟩ := hn
    push_cast
    rw [pow_succ, pow_mul]
    norm_num
  rw [hsign]
  push_cast
  ring



theorem oldBasisCut_mem_localizedCore {a : ℝ} (ha : 0 < a) {n : ℕ} (hn : Odd n) :
    oldBasisCut a n ∈ RHLean.localizedCore a :=
  mem_localizedCore_of (oldBasisCut_contDiff a n) (oldBasisCut_support ha n)
    (oldBasisCut_odd hn)




theorem localizedCore_finset_sum {a : ℝ} {ι : Type*} (s : Finset ι) (c : ι → ℝ)
    (φ : ι → ℝ → ℂ)
    (hcd : ∀ i ∈ s, ContDiff ℝ ∞ (φ i))
    (hodd : ∀ i ∈ s, ∀ x, φ i (-x) = - φ i x)
    (hsup : ∀ i ∈ s, Function.support (φ i) ⊆ Set.Ioo (-a) a) :
    (fun x => ∑ i ∈ s, (c i : ℂ) * φ i x) ∈ RHLean.localizedCore a := by
  have hcd' : ContDiff ℝ ∞ (fun x => ∑ i ∈ s, (c i : ℂ) * φ i x) :=
    ContDiff.sum (fun i hi => (hcd i hi).const_smul (c i))
  have hodd' : ∀ x, (∑ i ∈ s, (c i : ℂ) * φ i (-x)) = -(∑ i ∈ s, (c i : ℂ) * φ i x) := by
    intro x
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl ?_
    intro i hi
    rw [hodd i hi x, mul_neg]
  have hsup' : Function.support (fun x => ∑ i ∈ s, (c i : ℂ) * φ i x)
      ⊆ Set.Ioo (-a) a := by
    intro x hx
    have hx' : (∑ i ∈ s, (c i : ℂ) * φ i x) ≠ 0 := hx
    by_contra hbad
    apply hx'
    apply Finset.sum_eq_zero
    intro i hi
    by_cases hci : c i = 0
    · simp [hci]
    · apply mul_eq_zero.mpr
      right
      by_contra hne
      exact hbad (hsup i hi (by simpa [Function.mem_support] using hne))
  exact mem_localizedCore_of hcd' hsup' hodd'




theorem localPSD_finset_sum {a : ℝ} (ha : 0 < a) (h : RHLean.LocalPSD a)
    {ι : Type*} (s : Finset ι) (c : ι → ℝ) (φ : ι → ℝ → ℂ)
    (hcd : ∀ i ∈ s, ContDiff ℝ ∞ (φ i))
    (hodd : ∀ i ∈ s, ∀ x, φ i (-x) = - φ i x)
    (hsup : ∀ i ∈ s, Function.support (φ i) ⊆ Set.Ioo (-a) a) :
    0 ≤ RHLean.localizedForm a (fun x => ∑ i ∈ s, (c i : ℂ) * φ i x) :=
  h ha _ (localizedCore_finset_sum s c φ hcd hodd hsup)




theorem localPSD_oldBasisCut_combination {a : ℝ} (ha : 0 < a)
    (h : RHLean.LocalPSD a) (s : Finset ℕ) (c : ℕ → ℝ)
    (hs : ∀ n ∈ s, Odd n) :
    0 ≤ RHLean.localizedForm a
      (fun x => ∑ n ∈ s, (c n : ℂ) * oldBasisCut a n x) :=
  localPSD_finset_sum ha h s c _
    (fun n _ => oldBasisCut_contDiff a n)
    (fun n hn => oldBasisCut_odd (hs n hn))
    (fun n _ => oldBasisCut_support ha n)











noncomputable def chart (lo hi x : ℝ) : ℝ := (2 * x - (lo + hi)) / (hi - lo)


noncomputable def cutChart (lo hi : ℝ) : ℝ → ℝ :=
  fun x => Real.smoothTransition (1 - (chart lo hi x) ^ 2)



noncomputable def collarOdd (lo hi : ℝ) (n : ℕ) : ℝ → ℂ :=
  fun x => (cutChart lo hi x : ℂ) * Y7Matrix.phiC n (chart lo hi x)
    - (cutChart lo hi (-x) : ℂ) * Y7Matrix.phiC n (chart lo hi (-x))

theorem cutChart_contDiff (lo hi : ℝ) : ContDiff ℝ ∞ (cutChart lo hi) := by
  have h : ContDiff ℝ ∞ (fun x : ℝ => 1 - (chart lo hi x) ^ 2) := by
    unfold chart
    fun_prop
  have h2 : ContDiff ℝ ∞ (fun x : ℝ => Real.smoothTransition (1 - (chart lo hi x) ^ 2)) :=
    Real.smoothTransition.contDiff.comp h
  exact h2

theorem collarOdd_contDiff (lo hi : ℝ) (n : ℕ) :
    ContDiff ℝ ∞ (collarOdd lo hi n) := by
  have hpoly : ContDiff ℝ ∞ (fun t : ℝ => (Y7Legendre.phi n).eval t) := by
    simpa [Polynomial.aeval_def, Polynomial.eval₂_id] using
      (Y7Legendre.phi n).contDiff_aeval (𝕜 := ℝ) (n := ∞)
  have hchart : ContDiff ℝ ∞ (fun x : ℝ => chart lo hi x) := by
    unfold chart
    fun_prop
  have hphi : ContDiff ℝ ∞ (fun x : ℝ => Y7Matrix.phiC n (chart lo hi x)) := by
    have h1 : ContDiff ℝ ∞ (fun x : ℝ => (Y7Legendre.phi n).eval (chart lo hi x)) :=
      hpoly.comp hchart
    simpa [Y7Matrix.phiC, Function.comp_def, Complex.ofRealCLM_apply] using
      Complex.ofRealCLM.contDiff.comp h1
  have hcut : ContDiff ℝ ∞ (fun x : ℝ => (cutChart lo hi x : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (cutChart_contDiff lo hi)
  have hcut' : ContDiff ℝ ∞ (fun x : ℝ => (cutChart lo hi (-x) : ℂ)) :=
    hcut.comp (by fun_prop : ContDiff ℝ ∞ (fun x : ℝ => -x))
  have hphi' : ContDiff ℝ ∞ (fun x : ℝ => Y7Matrix.phiC n (chart lo hi (-x))) :=
    hphi.comp (by fun_prop : ContDiff ℝ ∞ (fun x : ℝ => -x))
  exact (hcut.mul hphi).sub (hcut'.mul hphi')

theorem collarOdd_neg (lo hi : ℝ) (n : ℕ) (x : ℝ) :
    collarOdd lo hi n (-x) = - collarOdd lo hi n x := by
  unfold collarOdd
  rw [neg_neg]
  ring
























