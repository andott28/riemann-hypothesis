      (∑ n ∈ (activeN k).filter (fun n => Nat.Prime n),
          (Lambda n - cBin k (k / n) * (n : ℝ)) ^ 2 / (n : ℝ))
        + hppHalf k :=
  Vsum_le_prime_add_hpp k


theorem hppHalf_lt' (k : ℕ) (hk : X0 ≤ k) : hppHalf k < 2.871506589970 := by
  have h := hppHalf_lt_2871486594208 k hk
