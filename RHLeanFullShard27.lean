theorem moduli_prime (q : ℕ) (hq : q ∈ moduli) : Nat.Prime q := by
  have h : moduli.all (fun q => decide (Nat.Prime q)) = true := by decide
  exact of_decide_eq_true ((List.all_eq_true.mp h) q hq)


theorem moduli_le_B (q : ℕ) (hq : q ∈ moduli) : q ≤ B := by
  have h : moduli.all (fun q => decide (q ≤ B)) = true := by decide
  exact of_decide_eq_true ((List.all_eq_true.mp h) q hq)





theorem mem_boxP_of_prime {p : ℕ} (hp : Nat.Prime p) (hle : p ≤ P) : p ∈ boxP := by
  rw [boxP, List.mem_filter]
  refine ⟨List.mem_range.2 (by omega), ?_⟩
  have hp0 : 0 < p := hp.pos
  by_cases hB : p ≤ B
  · simp [hp0, hB]
  · have hrough : roughPred p = true := by
      rw [roughPred, List.all_eq_true]
      intro q hq
      rw [decide_eq_true_iff]
      intro hmod
      have hqprime : Nat.Prime q := moduli_prime q hq
      have hqB : q ≤ B := moduli_le_B q hq
      have hqp : q < p := lt_of_le_of_lt hqB (not_le.mp hB)
      have hdvd : q ∣ p := Nat.dvd_of_mod_eq_zero hmod
      have hq1p : q = 1 ∨ q = p := (Nat.dvd_prime hp).mp hdvd
      have hq2 : 2 ≤ q := hqprime.two_le
      rcases hq1p with h | h
      · omega
      · omega
    simp [hp0, hB, hrough]


theorem mem_boxes_of_prime {p : ℕ} (hp : Nat.Prime p) (hle : p ≤ P) :
    ∃ b ∈ boxes, b.p = p := by
  have hmem := mem_boxP_of_prime hp hle
  rw [← boxes_p] at hmem
  rw [List.mem_map] at hmem
  obtain ⟨b, hb, hbp⟩ := hmem
  exact ⟨b, hb, hbp⟩


theorem Hpp_lt_2798806594208 : Hpp < 2.798806594208 := by
  have hkP0 : (0 : ℚ) ≤ (kP : ℚ) / 10 ^ 5 :=
    div_nonneg (by positivity) (by norm_num)
  have hlogP : Real.log (P : ℝ) ≤ (((kP : ℚ) / 10 ^ 5 : ℚ) : ℝ) := by
    have h := log_le_of_taylor (p := P) (N := NP) (u := (kP : ℚ) / 10 ^ 5)
      (by norm_num [P]) hkP0 (by norm_num [P, NP, kP, Finset.sum_range_succ])
    simpa using h
  refine Hpp_lt_of_boxdata P (by norm_num [P]) boxes vList Vtotal ((kP : ℚ) / 10 ^ 5)
    2.798806594208 boxes_v (le_of_eq vList_sum)
    (fun p hp hle => mem_boxes_of_prime hp hle) hlogP ?_
  norm_num [Vtotal, P, kP, hppRatio]

end RHLean.GateII.HCert



