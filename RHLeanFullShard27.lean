theorem Vtail_closed (hPrime : PrimePartBound) :
    ∀ k : ℕ, 3594642 ≤ k →
      RHLean.GateII.Chain.Vsum k ≤ (12 / 100) * Real.log k + (2873 / 1000) := by
  intro k hk
  have hkX : X0 ≤ k := by
    unfold X0
    omega
  have hprime : primePart k ≤ 0.100317302 * Real.log (k : ℝ) + 0.259330618 :=
    hPrime k hkX
  have hsplit : RHLean.GateII.Chain.Vsum k ≤ primePart k + hppHalf k :=
    Vsum_le_prime_add_hppHalf k
  have hhpp : hppHalf k < 2.871496589970 := hppHalf_lt k hkX
  have hlog : (15 : ℝ) ≤ Real.log (k : ℝ) :=
    le_trans RHLean.GateII.Chain.log_3594642_ge_15
      (Real.log_le_log (by norm_num) (by exact_mod_cast hk))
  linarith








noncomputable def chihatCanon (k m : ℕ) : ℝ :=
  RHLean.GateII.Chain.V k m / Real.log 2


theorem chi_closed : ∀ k m : ℕ,
    chihatCanon k m ≤ RHLean.GateII.Chain.V k m / Real.log 2 := by
  intro k m
  exact le_rfl



theorem chihatCanon_sum_le (k : ℕ) :
    ∑ m ∈ Finset.range (k + 1), chihatCanon k m
      ≤ (1 / Real.log 2) * RHLean.GateII.Chain.Vsum k :=
  AWGC_of_V_bound (fun m => le_rfl)













def MertensAllBound : Prop :=
  ∀ k : ℕ, 7 ≤ k →
    ∑ n ∈ Finset.range (k + 1), RHLean.GateII.Lambda n / (n : ℝ)
      ≤ Real.log (k : ℝ)


theorem mertensActive_of_all {k : ℕ} (hk : 7 ≤ k)
    (hall : ∑ n ∈ Finset.range (k + 1), RHLean.GateII.Lambda n / (n : ℝ)
      ≤ Real.log (k : ℝ)) :
    RHLean.GateII.Chain.MertensActive k := by
  unfold RHLean.GateII.Chain.MertensActive
  refine le_trans ?_ hall
  unfold RHLean.GateII.Chain.activeN
  exact Finset.sum_le_sum_of_subset_of_nonneg
    (by
      intro n hn
      exact Finset.mem_filter.mp hn |>.1)
    (by
      intro n _ _
      exact div_nonneg
        (by simpa [RHLean.GateII.Chain.Lambda] using
          ArithmeticFunction.vonMangoldt_nonneg (n := n))
        (Nat.cast_nonneg n))


theorem mertensSweep_of_all (h : MertensAllBound) : MertensSweep := by
  intro k hk _
  exact mertensActive_of_all hk (h k hk)


theorem mertensTail_of_all (h : MertensAllBound) : MertensTail := by
  intro k hk
  exact mertensActive_of_all (by omega) (h k (by omega))



theorem mertensActive_of_all_all (h : MertensAllBound) :
    ∀ k : ℕ, 7 ≤ k → RHLean.GateII.Chain.MertensActive k :=
  MertensActive_of_sweep_tail (mertensSweep_of_all h) (mertensTail_of_all h)






noncomputable def alignedCoeff (m : ℕ) : ℝ :=
  if m = 1 then 145 / 10000 else (301 / 10000) / ((m : ℝ) ^ 2)




noncomputable def Walign (k : ℕ) : ℝ :=
  ∑ n ∈ RHLean.GateII.Chain.activeN k,
    alignedCoeff (k / n) * (RHLean.GateII.Lambda n) ^ 2 / (n : ℝ)



theorem alignedCoeff_le (k n : ℕ) (hn : n ∈ RHLean.GateII.Chain.activeN k) :
    alignedCoeff (k / n) ≤ (301 / 10000) * (4 * (n : ℝ) ^ 2 / (k : ℝ) ^ 2) := by
