section Inline_GateII_TailStieltjes

























open Finset
open scoped BigOperators

namespace RHLean.GateII.Tail

open RHLean.GateII.Chain
open RHLean.GateII.Stieltjes

set_option maxHeartbeats 1000000





noncomputable def gpar2 (t : ℝ) : ℝ := Real.log t / (t * (Real.log t + beta0))



noncomputable def Phi0 (u : ℝ) : ℝ := u - beta0 * Real.log (u + beta0)

theorem beta0_le : beta0 ≤ 1.2 := by
  unfold beta0
  linarith [Real.log_two_lt_d9]

theorem gpar2_nonneg {t : ℝ} (ht : 1 ≤ t) : 0 ≤ gpar2 t := by
  unfold gpar2
  have ht0 : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hL : 0 ≤ Real.log t := Real.log_nonneg ht
  exact div_nonneg hL (by nlinarith [beta0_pos, ht0])


theorem gpar2_le_inv {t : ℝ} (ht : 1 ≤ t) : gpar2 t ≤ 1 / t := by
  unfold gpar2
  have ht0 : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hL : 0 ≤ Real.log t := Real.log_nonneg ht
  rcases eq_or_lt_of_le hL with h | h
  · rw [← h]
    simp [ht0.le]
  · have hden : 0 < t * Real.log t := mul_pos ht0 h
    have hden2 : 0 < t * (Real.log t + beta0) := mul_pos ht0 (by linarith [beta0_pos])
    calc Real.log t / (t * (Real.log t + beta0))
        ≤ Real.log t / (t * Real.log t) := by
          apply div_le_div_of_nonneg_left hL hden
          nlinarith [beta0_pos, ht0.le]
      _ = 1 / t := by field_simp


theorem gpar2_mul_le_one {t : ℝ} (ht : 1 ≤ t) : t * gpar2 t ≤ 1 := by
  have h := gpar2_le_inv ht
  have ht0 : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have := mul_le_mul_of_nonneg_left h ht0.le
  rwa [mul_one_div, div_self ht0.ne'] at this


theorem gpar2_mul_monotoneOn : MonotoneOn (fun t => t * gpar2 t) (Set.Ici 1) := by
  intro x hx y hy hxy
  have hx0 : 0 < x := lt_of_lt_of_le zero_lt_one hx
  have hy0 : 0 < y := lt_of_lt_of_le zero_lt_one (le_trans hx hxy)
  have hlog : Real.log x ≤ Real.log y := Real.log_le_log hx0 hxy
  have hLx : 0 < Real.log x + beta0 := by
    have := Real.log_nonneg hx
    linarith [beta0_pos]
  have hLy : 0 < Real.log y + beta0 := by
    have := Real.log_nonneg (le_trans hx hxy)
    linarith [beta0_pos]
  have h1 : x * gpar2 x = Real.log x / (Real.log x + beta0) := by
    unfold gpar2
    field_simp
  have h2 : y * gpar2 y = Real.log y / (Real.log y + beta0) := by
    unfold gpar2
    field_simp
  show x * gpar2 x ≤ y * gpar2 y
  rw [h1, h2]
  rw [div_le_div_iff₀ hLx hLy]
  nlinarith [beta0_pos, hlog]



theorem Phi0_sub_ge {u u₀ : ℝ} (hu : u₀ ≤ u) (hu₀ : 15 ≤ u₀) :
    (23 / 25 : ℝ) * (u - u₀) ≤ Phi0 u - Phi0 u₀ := by
  rcases eq_or_lt_of_le hu with h | hlt
  · subst h
    simp
  have h1 : 0 < u₀ + beta0 := by linarith [beta0_pos]
  have h2 : 0 < u + beta0 := by linarith [beta0_pos]
  have hkey : Real.log ((u + beta0) / (u₀ + beta0)) ≤ (u - u₀) / (u₀ + beta0) := by
    have hpos : 0 < (u + beta0) / (u₀ + beta0) := div_pos h2 h1
    have hne : (u + beta0) / (u₀ + beta0) ≠ 1 := by
      intro h
      have := (div_eq_one_iff_eq h1.ne').mp h
      linarith
    have hlog := Real.log_lt_sub_one_of_pos hpos hne
    have hx : (u + beta0) / (u₀ + beta0) - 1 = (u - u₀) / (u₀ + beta0) := by
      field_simp
      ring
    linarith [hlog, hx]
  have hratio : (23 / 25 : ℝ) ≤ u₀ / (u₀ + beta0) := by
    rw [le_div_iff₀ h1]
    nlinarith [beta0_le, hu₀]
  calc (23 / 25 : ℝ) * (u - u₀) ≤ (u₀ / (u₀ + beta0)) * (u - u₀) :=
        mul_le_mul_of_nonneg_right hratio (sub_nonneg.mpr hu)
    _ = (u - u₀) - beta0 * ((u - u₀) / (u₀ + beta0)) := by
        field_simp
        ring
    _ ≤ (u - u₀) - beta0 * Real.log ((u + beta0) / (u₀ + beta0)) := by
        nlinarith [beta0_pos, hkey]
    _ = Phi0 u - Phi0 u₀ := by
        unfold Phi0
        rw [Real.log_div h2.ne' h1.ne']
        ring





theorem upper_le_lower_scalar {u u₀ : ℝ} (hu : u₀ ≤ u) (h15 : 15 ≤ u₀)
    (h151 : u₀ ≤ 15.1) :
    (1 / Real.log 2) * (0.100317302 * u + 3.13082720797)
      ≤ 11.045 - 1.91 - u / 19 + (23 / 25 : ℝ) * (u - u₀) - 0.005 := by
  have hlog2 : (0.6931471803 : ℝ) ≤ Real.log 2 := le_of_lt Real.log_two_gt_d9
  have h1 : (1 / Real.log 2) * (0.100317302 * u + 3.13082720797)
      ≤ (1 / 0.6931471803) * (0.100317302 * u + 3.13082720797) := by
    apply mul_le_mul_of_nonneg_right _ (by nlinarith [hu, h15])
    apply div_le_div_of_nonneg_left (by norm_num) (by norm_num) hlog2
  have h2 : (1 / 0.6931471803) * (0.100317302 * u + 3.13082720797)
      ≤ 11.045 - 1.91 - u / 19 + (23 / 25 : ℝ) * (u - u₀) - 0.005 := by
    nlinarith [hu, h15, h151]
  linarith



theorem hasDerivAt_gpar2 {t : ℝ} (ht : 0 < t) (hβ : Real.log t + beta0 ≠ 0) :
    HasDerivAt gpar2 ((beta0 * (1 - Real.log t) - Real.log t ^ 2)
      / (t * (Real.log t + beta0)) ^ 2) t := by
  have hlog : HasDerivAt Real.log t⁻¹ t := Real.hasDerivAt_log ht.ne'
  have hden : HasDerivAt (fun s : ℝ => s * (Real.log s + beta0))
      (1 * (Real.log t + beta0) + t * t⁻¹) t :=
    (hasDerivAt_id t).mul (hlog.add_const beta0)
  have hquot : HasDerivAt (fun s : ℝ => Real.log s / (s * (Real.log s + beta0)))
      ((t⁻¹ * (t * (Real.log t + beta0)) - Real.log t * (1 * (Real.log t + beta0) + t * t⁻¹))
        / (t * (Real.log t + beta0)) ^ 2) t :=
    hlog.div hden (mul_ne_zero ht.ne' hβ)
  have hval : (t⁻¹ * (t * (Real.log t + beta0))
        - Real.log t * (1 * (Real.log t + beta0) + t * t⁻¹))
        / (t * (Real.log t + beta0)) ^ 2
      = (beta0 * (1 - Real.log t) - Real.log t ^ 2) / (t * (Real.log t + beta0)) ^ 2 := by
    field_simp
    ring
  unfold gpar2
  convert hquot using 1
  exact hval.symm


theorem hasDerivAt_Phi0_log {t : ℝ} (ht : 0 < t) (hβ : Real.log t + beta0 ≠ 0) :
    HasDerivAt (fun s : ℝ => Phi0 (Real.log s)) (gpar2 t) t := by
  have hphi : HasDerivAt Phi0 (1 - beta0 / (Real.log t + beta0)) (Real.log t) := by
    have h1 : HasDerivAt (fun u : ℝ => u + beta0) 1 (Real.log t) :=
      (hasDerivAt_id (Real.log t)).add_const beta0
    have h2 : HasDerivAt (fun u : ℝ => beta0 * Real.log (u + beta0))
        (beta0 * (1 / (Real.log t + beta0))) (Real.log t) :=
      (h1.log hβ).const_mul beta0
    have h3 : HasDerivAt (fun u : ℝ => u - beta0 * Real.log (u + beta0))
        (1 - beta0 * (1 / (Real.log t + beta0))) (Real.log t) :=
      (hasDerivAt_id (Real.log t)).sub h2
    convert h3 using 1
    · ext u
      rfl
    · field_simp
  have hcomp := hphi.comp t (Real.hasDerivAt_log ht.ne')
  have hval : (1 - beta0 / (Real.log t + beta0)) * t⁻¹ = gpar2 t := by
    unfold gpar2
    field_simp
    ring
  rwa [hval] at hcomp

theorem exp_one_gt_one : (1 : ℝ) < Real.exp 1 := by
  linarith [Real.exp_one_gt_d9]



theorem log_add_beta0_pos {A B : ℕ} (hA : Real.exp 1 ≤ (A : ℝ)) {t : ℝ}
    (ht : t ∈ Set.Icc (A : ℝ) (B : ℝ)) : 0 < t ∧ 0 < Real.log t + beta0 := by
  have h1 : Real.exp 1 ≤ t := le_trans hA ht.1
  have h2 := Real.log_le_log (Real.exp_pos 1) h1
  rw [Real.log_exp] at h2
  exact ⟨lt_of_lt_of_le (Real.exp_pos 1) h1, by linarith [beta0_pos]⟩


theorem gpar2_antitoneOn_Icc {A B : ℕ} (hA : Real.exp 1 ≤ (A : ℝ)) (_hAB : A ≤ B) :
    AntitoneOn gpar2 (Set.Icc (A : ℝ) (B : ℝ)) := by
  have hdiff : DifferentiableOn ℝ gpar2 (Set.Icc (A : ℝ) (B : ℝ)) :=
    fun t ht => ((hasDerivAt_gpar2 (log_add_beta0_pos hA ht).1
      (log_add_beta0_pos hA ht).2.ne').differentiableAt).differentiableWithinAt
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _) hdiff.continuousOn
    (hdiff.mono interior_subset) ?_
  intro t ht
  rw [interior_Icc] at ht
  obtain ⟨ht0, hL⟩ := log_add_beta0_pos hA ⟨le_of_lt ht.1, le_of_lt ht.2⟩
  have hL1 : 1 ≤ Real.log t := by
    have h1 : Real.exp 1 ≤ t := le_trans hA (le_of_lt ht.1)
    have h2 := Real.log_le_log (Real.exp_pos 1) h1
    rwa [Real.log_exp] at h2
  rw [(hasDerivAt_gpar2 ht0 hL.ne').deriv]
  have hnum : beta0 * (1 - Real.log t) - Real.log t ^ 2 ≤ 0 := by
    nlinarith [beta0_pos, hL1]
  exact div_nonpos_of_nonpos_of_nonneg hnum (by positivity)



theorem integral_gpar2 {A B : ℕ} (hA : Real.exp 1 ≤ (A : ℝ)) (hAB : A ≤ B) :
    ∫ t in (A : ℝ)..(B : ℝ), gpar2 t
      = Phi0 (Real.log (B : ℝ)) - Phi0 (Real.log (A : ℝ)) := by
  have hanti := gpar2_antitoneOn_Icc hA hAB
  refine intervalIntegral.integral_eq_sub_of_hasDerivAt
    (f := fun s : ℝ => Phi0 (Real.log s)) (f' := gpar2) (fun x hx => ?_) ?_
  · rcases Set.mem_uIcc.mp hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · obtain ⟨hx0, hL⟩ := log_add_beta0_pos hA ⟨h1, h2⟩
      simpa using hasDerivAt_Phi0_log hx0 hL.ne'
    · have h1' : (A : ℝ) ≤ x := le_trans (by exact_mod_cast hAB) h1
      obtain ⟨hx0, hL⟩ := log_add_beta0_pos hA ⟨h1', h2⟩
      simpa using hasDerivAt_Phi0_log hx0 hL.ne'
  · rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by exact_mod_cast hAB)]
    exact hanti.integrableOn_isCompact isCompact_Icc






theorem sum_Ico_succ_mul_sub_le {A B : ℕ} {g : ℝ → ℝ}
    (hg0 : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), 0 ≤ g t)
    (hmono : MonotoneOn (fun t => t * g t) (Set.Icc (A : ℝ) (B : ℝ))) :
    ∀ M : ℕ, A + 1 ≤ M → M ≤ B →
      ∑ m ∈ Finset.Ico (A + 1) M, ((m : ℝ) + 1) * (g (m : ℝ) - g (((m + 1 : ℕ) : ℝ)))
        ≤ ((A : ℝ) + 2) * g ((A + 1 : ℕ) : ℝ) + ∑ m ∈ Finset.Ico (A + 1) M, g (m : ℝ) := by
  intro M hNM
  induction M, hNM using Nat.le_induction with
  | base =>
      intro hb
      rw [Finset.Ico_self, Finset.sum_empty, Finset.sum_empty, add_zero]
      have hA : (0 : ℝ) ≤ (A : ℝ) + 2 := by
        have h0 : (0 : ℝ) ≤ (A : ℝ) := Nat.cast_nonneg A
        linarith
      refine mul_nonneg hA (hg0 (((A + 1 : ℕ) : ℝ)) ⟨?_, ?_⟩)
      · exact_mod_cast (Nat.le_succ A)
      · exact_mod_cast hb
  | succ M hNM ih =>
      intro hM1B
      have hMB : M ≤ B := by omega
      have ih' := ih hMB
      have hstep : ((M : ℝ) + 1) * (g (M : ℝ) - g (((M + 1 : ℕ) : ℝ))) ≤ g (M : ℝ) := by
        have hMmem : (M : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := by
          refine ⟨?_, by exact_mod_cast hMB⟩
          have h1 : ((A + 1 : ℕ) : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
          push_cast at h1
          linarith
        have hM1mem : (((M + 1 : ℕ)) : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := by
          refine ⟨?_, by exact_mod_cast hM1B⟩
          have h1 : ((A + 1 : ℕ) : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
          push_cast at h1 ⊢
          linarith
        have hcast : (((M + 1 : ℕ)) : ℝ) = (M : ℝ) + 1 := by push_cast; ring
        have hmul : (M : ℝ) * g (M : ℝ)
            ≤ (((M + 1 : ℕ)) : ℝ) * g (((M + 1 : ℕ)) : ℝ) :=
          hmono hMmem hM1mem (by rw [hcast]; linarith)
        rw [hcast] at hmul ⊢
        nlinarith [hmul]
      have e1 := Finset.sum_Ico_succ_top hNM
        (fun m => ((m : ℝ) + 1) * (g (m : ℝ) - g (((m + 1 : ℕ) : ℝ))))
      have e2 := Finset.sum_Ico_succ_top hNM (fun m => g (m : ℝ))
      rw [e1, e2]
      linarith








theorem thetaJump_lower_bound (g : ℝ → ℝ) {A B : ℕ} {ε : ℝ}
    (hAB : A ≤ B) (hε : 0 ≤ ε) (hε1 : ε ≤ 1)
    (hg0 : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), 0 ≤ g t)
    (hganti : AntitoneOn g (Set.Icc (A : ℝ) (B : ℝ)))
    (hmono : MonotoneOn (fun t => t * g t) (Set.Icc (A : ℝ) (B : ℝ)))
    (hbound : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), t * g t ≤ 1)
    (hE : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), |Chebyshev.theta t - t| ≤ ε * t) :
    (1 - ε) * (∫ t in (A : ℝ)..(B : ℝ), g t) - 4 * ε - g (A : ℝ)
      ≤ ∑ m ∈ Finset.Ico (A + 1) (B + 1), g (m : ℝ) * thetaJump m := by
  rcases eq_or_lt_of_le hAB with h | hlt
  · subst h
    rw [Finset.Ico_self, Finset.sum_empty]
    have hz : (∫ t in (A : ℝ)..(A : ℝ), g t) = 0 := by simp
    rw [hz]
    have hgA : (0 : ℝ) ≤ g (A : ℝ) := hg0 _ ⟨le_rfl, le_rfl⟩
    linarith
  have hNM : A + 1 ≤ B := hlt
  have hid := sum_thetaJump_mul_identity g (a := (A : ℝ)) (b := (B : ℝ))
    (N := A + 1) (M := B) (by rw [Nat.floor_natCast]) (by rw [Nat.floor_natCast]) hNM
  have hNA : (((A + 1 : ℕ)) : ℝ) - 1 = (A : ℝ) := by push_cast; ring
  rw [hNA] at hid
  have hAmem : (A : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := ⟨le_rfl, by exact_mod_cast hAB⟩
  have hBmem : (B : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := ⟨by exact_mod_cast hAB, le_rfl⟩
  have hNmem : (((A + 1 : ℕ)) : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) :=
    ⟨by exact_mod_cast (Nat.le_succ A), by exact_mod_cast hNM⟩
  have hIcomem : ∀ m ∈ Finset.Ico (A + 1) B, (m : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := by
    intro m hm
    obtain ⟨hm1, hm2⟩ := Finset.mem_Ico.mp hm
    constructor
    · have h1 : ((A + 1 : ℕ) : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm1
      push_cast at h1
      linarith
    · exact_mod_cast (Nat.le_of_lt hm2)
  have hN1mem : ∀ m ∈ Finset.Ico (A + 1) B,
      (((m + 1 : ℕ)) : ℝ) ∈ Set.Icc (A : ℝ) (B : ℝ) := by
    intro m hm
    obtain ⟨hm1, hm2⟩ := Finset.mem_Ico.mp hm
    constructor
    · have h1 : ((A + 1 : ℕ) : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm1
      push_cast at h1 ⊢
      linarith
    · exact_mod_cast (Nat.succ_le_of_lt hm2 : m + 1 ≤ B)

  have hb1 : -ε ≤ g (B : ℝ) * (Chebyshev.theta (B : ℝ) - (B : ℝ)) := by
    have h1 : -(ε * (B : ℝ)) ≤ Chebyshev.theta (B : ℝ) - (B : ℝ) :=
      (abs_le.mp (hE (B : ℝ) hBmem)).1
    have h2 : (B : ℝ) * g (B : ℝ) ≤ 1 := hbound (B : ℝ) hBmem
    have hgB : (0 : ℝ) ≤ g (B : ℝ) := hg0 (B : ℝ) hBmem
    nlinarith [h1, h2, hgB, hε]

  have hb2 : -ε ≤ -(g (((A + 1 : ℕ)) : ℝ) * (Chebyshev.theta (A : ℝ) - (A : ℝ))) := by
    have h1 : Chebyshev.theta (A : ℝ) - (A : ℝ) ≤ ε * (A : ℝ) :=
      (abs_le.mp (hE (A : ℝ) hAmem)).2
    have h2 : (A : ℝ) * g (A : ℝ) ≤ 1 := hbound (A : ℝ) hAmem
    have h3 : g (((A + 1 : ℕ)) : ℝ) ≤ g (A : ℝ) :=
      hganti hAmem hNmem (by exact_mod_cast (Nat.le_succ A))
    have hgN : (0 : ℝ) ≤ g (((A + 1 : ℕ)) : ℝ) := hg0 _ hNmem
    by_cases hEpos : 0 ≤ Chebyshev.theta (A : ℝ) - (A : ℝ)
    · have h4 : g (((A + 1 : ℕ)) : ℝ) * (Chebyshev.theta (A : ℝ) - (A : ℝ)) ≤ ε := by
        have h5 : g (((A + 1 : ℕ)) : ℝ) * (Chebyshev.theta (A : ℝ) - (A : ℝ))
            ≤ g (A : ℝ) * (ε * (A : ℝ)) :=
          mul_le_mul h3 h1 hEpos (le_trans hgN h3)
        nlinarith [h5, h2, hε]
      linarith
    · nlinarith [hgN, hEpos]

  have hb3 : ∑ m ∈ Finset.Ico (A + 1) B,
      (g (((m + 1 : ℕ)) : ℝ) - g (m : ℝ)) * (Chebyshev.theta (m : ℝ) - (m : ℝ))
      ≤ ε * (2 + ∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ)) := by
    have hterm : ∀ m ∈ Finset.Ico (A + 1) B,
        (g (((m + 1 : ℕ)) : ℝ) - g (m : ℝ)) * (Chebyshev.theta (m : ℝ) - (m : ℝ))
          ≤ (g (m : ℝ) - g (((m + 1 : ℕ)) : ℝ)) * (ε * ((m : ℝ) + 1)) := by
      intro m hm
      have hmem := hIcomem m hm
      have hm1mem := hN1mem m hm
      have hcast : (((m + 1 : ℕ)) : ℝ) = (m : ℝ) + 1 := by push_cast; ring
      have hanti : g (((m + 1 : ℕ)) : ℝ) ≤ g (m : ℝ) :=
        hganti hmem hm1mem (by rw [hcast]; linarith)
      have h2 : -(ε * ((m : ℝ) + 1)) ≤ Chebyshev.theta (m : ℝ) - (m : ℝ) := by
        have h1 : -(ε * (m : ℝ)) ≤ Chebyshev.theta (m : ℝ) - (m : ℝ) :=
          (abs_le.mp (hE (m : ℝ) hmem)).1
        have hm0 : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
        linarith [h1, hε, hm0]
      have h3 : g (((m + 1 : ℕ)) : ℝ) - g (m : ℝ) ≤ 0 := by linarith
      have h4 := mul_le_mul_of_nonpos_left h2 h3
      nlinarith [h4]
    have hsum := Finset.sum_le_sum hterm
    have hleft : ∑ m ∈ Finset.Ico (A + 1) B,
          (g (m : ℝ) - g (((m + 1 : ℕ)) : ℝ)) * (ε * ((m : ℝ) + 1))
        = ε * ∑ m ∈ Finset.Ico (A + 1) B,
            ((m : ℝ) + 1) * (g (m : ℝ) - g (((m + 1 : ℕ)) : ℝ)) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun m _ => by ring)
    rw [hleft] at hsum
    have htelesc := sum_Ico_succ_mul_sub_le (A := A) (B := B) (g := g) hg0 hmono B hNM le_rfl
    have hIco : ∑ m ∈ Finset.Ico (A + 1) B, g (m : ℝ)
        ≤ ∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg
        (fun m hm => Finset.mem_Icc.mpr ⟨(Finset.mem_Ico.mp hm).1,
          Nat.le_of_lt (Finset.mem_Ico.mp hm).2⟩)
        (fun m hm _ => hg0 (m : ℝ) ⟨by
            have h1 : (((A + 1 : ℕ)) : ℝ) ≤ (m : ℝ) := by
              exact_mod_cast (Finset.mem_Icc.mp hm).1
            push_cast at h1
            linarith,
          by exact_mod_cast (Finset.mem_Icc.mp hm).2⟩)
    have hNle : g (((A + 1 : ℕ)) : ℝ) ≤ 1 / ((A : ℝ) + 1) := by
      have h1 : (((A + 1 : ℕ)) : ℝ) * g (((A + 1 : ℕ)) : ℝ) ≤ 1 := hbound _ hNmem
      have h3 : (((A + 1 : ℕ)) : ℝ) = (A : ℝ) + 1 := by push_cast; ring
      rw [le_div_iff₀ (by linarith [Nat.cast_nonneg (α := ℝ) A] : (0 : ℝ) < (A : ℝ) + 1)]
      rw [← h3, mul_comm]
      exact h1
    have h2b : ((A : ℝ) + 2) * g (((A + 1 : ℕ)) : ℝ) ≤ 2 := by
      have h1 : ((A : ℝ) + 2) * g (((A + 1 : ℕ)) : ℝ)
          ≤ ((A : ℝ) + 2) * (1 / ((A : ℝ) + 1)) :=
        mul_le_mul_of_nonneg_left hNle (by linarith [Nat.cast_nonneg (α := ℝ) A])
      have h2 : ((A : ℝ) + 2) * (1 / ((A : ℝ) + 1)) ≤ 2 := by
        rw [mul_one_div, div_le_iff₀ (by linarith [Nat.cast_nonneg (α := ℝ) A] :
          (0 : ℝ) < (A : ℝ) + 1)]
        linarith [Nat.cast_nonneg (α := ℝ) A]
      linarith
    refine le_trans hsum (mul_le_mul_of_nonneg_left ?_ hε)
    linarith [htelesc, h2b, hIco]

  have hint : (∫ t in (A : ℝ)..(B : ℝ), g t)
      ≤ g (A : ℝ) + ∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ) := by
    have h1 := AntitoneOn.integral_le_sum_Ico (f := g) hAB hganti
    have hsub2 : Finset.Ico A B ⊆ insert A (Finset.Icc (A + 1) B) := by
      intro m hm
      obtain ⟨hm1, hm2⟩ := Finset.mem_Ico.mp hm
      rcases eq_or_lt_of_le hm1 with h | h
      · subst h
        exact Finset.mem_insert_self _ _
      · exact Finset.mem_insert_of_mem (Finset.mem_Icc.mpr ⟨h, Nat.le_of_lt hm2⟩)
    have h3 : ∑ m ∈ Finset.Ico A B, g (m : ℝ)
        ≤ ∑ m ∈ insert A (Finset.Icc (A + 1) B), g (m : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub2 (fun m hm _ => by
        rcases Finset.mem_insert.mp hm with h | hm'
        · subst h
          exact hg0 _ hAmem
        · exact hg0 _ ⟨by
              have h1 : (((A + 1 : ℕ)) : ℝ) ≤ (m : ℝ) := by
                exact_mod_cast (Finset.mem_Icc.mp hm').1
              push_cast at h1
              linarith,
            by exact_mod_cast (Finset.mem_Icc.mp hm').2⟩)
    rw [Finset.sum_insert (by simp)] at h3
    linarith [h1, h3]
  rw [hid]
  have hprod : (1 - ε) * (∫ t in (A : ℝ)..(B : ℝ), g t) - (1 - ε) * g (A : ℝ)
      ≤ (1 - ε) * (∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ)) := by
    have h1 : (∫ t in (A : ℝ)..(B : ℝ), g t) - g (A : ℝ)
        ≤ ∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ) := by linarith [hint]
    have h2 : (0 : ℝ) ≤ 1 - ε := by linarith
    have h3 := mul_le_mul_of_nonneg_left h1 h2
    calc (1 - ε) * (∫ t in (A : ℝ)..(B : ℝ), g t) - (1 - ε) * g (A : ℝ)
        = (1 - ε) * ((∫ t in (A : ℝ)..(B : ℝ), g t) - g (A : ℝ)) := by ring
      _ ≤ (1 - ε) * (∑ m ∈ Finset.Icc (A + 1) B, g (m : ℝ)) := h3
  have hgA : (0 : ℝ) ≤ g (A : ℝ) := hg0 (A : ℝ) hAmem
  nlinarith [hb1, hb2, hb3, hprod, hε, hε1, hgA]




theorem gpar2_mul_log_eq_tailW {p : ℕ} (hp : 2 ≤ p) :
    gpar2 (p : ℝ) * Real.log (p : ℝ) = tailW p := by
  have hp1 : (1 : ℝ) < (p : ℝ) := by exact_mod_cast (by omega : 1 < p)
  have hL : Real.log (p : ℝ) ≠ 0 := ne_of_gt (Real.log_pos hp1)
  have hp0 : (p : ℝ) ≠ 0 := by positivity
  unfold gpar2 tailW
  field_simp



theorem Fprime_sub_eq_sum {A B : ℕ} (hA5 : 5 ≤ A) (hAB : A ≤ B) :
    Fprime B - Fprime A
      = ∑ p ∈ (Nat.primesLE B).filter (fun p => A < p), tailW p := by
  have hset : ((Nat.primesLE B).filter (fun p => 5 ≤ p)).filter (fun p : ℕ => A < p)
      = (Nat.primesLE B).filter (fun p => A < p) := by
    ext p
    simp only [Finset.mem_filter, Nat.mem_primesLE]
    constructor
    · rintro ⟨⟨⟨hpB, hpr⟩, h5⟩, hA⟩
      exact ⟨⟨hpB, hpr⟩, hA⟩
    · rintro ⟨⟨hpB, hpr⟩, hA⟩
      exact ⟨⟨⟨hpB, hpr⟩, by omega⟩, hA⟩
  have hset2 : ((Nat.primesLE B).filter (fun p => 5 ≤ p)).filter (fun p : ℕ => ¬ A < p)
      = (Nat.primesLE A).filter (fun p => 5 ≤ p) := by
    ext p
    simp only [Finset.mem_filter, Nat.mem_primesLE]
    constructor
    · rintro ⟨⟨⟨hpB, hpr⟩, h5⟩, hA⟩
      exact ⟨⟨by omega, hpr⟩, h5⟩
    · rintro ⟨⟨hpA, hpr⟩, h5⟩
      exact ⟨⟨⟨le_trans hpA hAB, hpr⟩, h5⟩, by omega⟩
  have h1 := Finset.sum_filter_add_sum_filter_not
    (s := (Nat.primesLE B).filter (fun p => 5 ≤ p)) (p := fun p : ℕ => A < p) (f := tailW)
  rw [hset, hset2] at h1
  have hFB : (∑ p ∈ (Nat.primesLE B).filter (fun p => 5 ≤ p), tailW p) = Fprime B := rfl
  have hFA : (∑ p ∈ (Nat.primesLE A).filter (fun p => 5 ≤ p), tailW p) = Fprime A := rfl
  rw [hFB, hFA] at h1
  linarith [h1]




theorem Fprime_sub_ge {A B : ℕ} (hA5 : 5 ≤ A) (hAB : A ≤ B)
    {ε : ℝ} (hε : 0 ≤ ε) (hε1 : ε ≤ 1)
    (hE : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), |Chebyshev.theta t - t| ≤ ε * t) :
    (1 - ε) * (Phi0 (Real.log (B : ℝ)) - Phi0 (Real.log (A : ℝ)))
        - 4 * ε - gpar2 (A : ℝ)
      ≤ Fprime B - Fprime A := by
  have hA : Real.exp 1 ≤ (A : ℝ) :=
    le_trans (le_of_lt (lt_trans Real.exp_one_lt_d9 (by norm_num : (2.7182818286 : ℝ) < 5)))
      (by exact_mod_cast hA5)
  have hA1 : (1 : ℝ) < (A : ℝ) :=
    lt_of_lt_of_le (by norm_num : (1 : ℝ) < 5) (by exact_mod_cast hA5)
  have hg0 : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), 0 ≤ gpar2 t :=
    fun t ht => gpar2_nonneg (le_trans hA1.le ht.1)
  have hanti : AntitoneOn gpar2 (Set.Icc (A : ℝ) (B : ℝ)) := gpar2_antitoneOn_Icc hA hAB
  have hmono : MonotoneOn (fun t => t * gpar2 t) (Set.Icc (A : ℝ) (B : ℝ)) :=
    gpar2_mul_monotoneOn.mono (fun t ht => le_trans hA1.le ht.1)
  have hbound : ∀ t ∈ Set.Icc (A : ℝ) (B : ℝ), t * gpar2 t ≤ 1 :=
    fun t ht => gpar2_mul_le_one (le_trans hA1.le ht.1)
  have hL := thetaJump_lower_bound gpar2 hAB hε hε1 hg0 hanti hmono hbound hE
  rw [integral_gpar2 hA hAB] at hL
  have hprime' : (∑ p ∈ (Nat.primesLE B).filter (fun p => A < p), tailW p)
      = ∑ m ∈ Finset.Ico (A + 1) (B + 1), gpar2 (m : ℝ) * thetaJump m := by
    have hf : (Nat.primesLE B).filter (fun p => A < p)
        = (Nat.primesLE B).filter (fun p : ℕ => (A : ℝ) < (p : ℝ)) := by
      apply Finset.filter_congr
      intro p _
      exact (Nat.cast_lt (α := ℝ)).symm
    have hprime := sum_primes_eq_sum_thetaJump (g := gpar2) (a := (A : ℝ)) (b := (B : ℝ))
      (by positivity)
    rw [show ⌊(B : ℝ)⌋₊ = B from Nat.floor_natCast B,
      show ⌊(A : ℝ)⌋₊ = A from Nat.floor_natCast A, ← hf] at hprime
    rw [← hprime]
    refine Finset.sum_congr rfl (fun p hp => ?_)
    have hp' := Finset.mem_filter.mp hp
    have hpr : Nat.Prime p := (Nat.mem_primesLE.mp hp'.1).2
    exact (gpar2_mul_log_eq_tailW hpr.two_le).symm
  rw [Fprime_sub_eq_sum hA5 hAB, hprime']
  exact hL




theorem X0_ge_5 : 5 ≤ RHLean.GateII.SA.X0 := by norm_num [RHLean.GateII.SA.X0]


theorem exp_15_le_X0 : Real.exp 15 ≤ (RHLean.GateII.SA.X0 : ℝ) := by
