noncomputable def primePart (k : ℕ) : ℝ :=
  ∑ n ∈ (activeN k).filter (fun n => Nat.Prime n),
    (Lambda n - cBin k (k / n) * (n : ℝ)) ^ 2 / (n : ℝ)




theorem Vsum_le_of_primePart_hpp {k : ℕ} (hk : X0 ≤ k)
    (hPrime : primePart k ≤ 0.100317302 * Real.log (k : ℝ) + 0.259330618) :
    (1 / Real.log 2) * Vsum k
      ≤ (1 / Real.log 2) * (0.100317302 * Real.log (k : ℝ) + 3.13082720797) := by
  have h1 : Vsum k ≤ primePart k + hppHalf k := Vsum_le_prime_add_hppHalf k
  have h2 : hppHalf k < 2.871496589970 := hppHalf_lt k hk
  have h3 : Vsum k ≤ 0.100317302 * Real.log (k : ℝ) + 3.13082720797 := by linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  exact mul_le_mul_of_nonneg_left h3 (div_nonneg zero_le_one hlog2.le)




theorem AWGCTail_on_Ici_X0
    (hPrime : ∀ k : ℕ, X0 ≤ k →
      primePart k ≤ 0.100317302 * Real.log (k : ℝ) + 0.259330618)
    (hFX0 : 11.045 ≤ Fprime X0)
