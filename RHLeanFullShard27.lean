  ∑ n ∈ (activeN k).filter (fun n => ¬ Nat.Prime n),
    (Lambda n - cBin k (k / n) * (n : ℝ)) ^ 2 / (n : ℝ)



theorem hppHalf_le_surcharge_add_Dsum (k : ℕ) (hk : 4 ≤ k) :
    hppHalf k ≤ surcharge k + Dsum k :=
  hppHalf_le_surcharge_add_D k hk



theorem hppHalf_lt_2871486594208 (k : ℕ) (hk : X0 ≤ k) :
    hppHalf k < 2.871486594208 := by
  have hk4 : 4 ≤ k := le_trans (by norm_num [X0]) hk
  have h1 : hppHalf k ≤ surcharge k + Dsum k := hppHalf_le_surcharge_add_Dsum k hk4
  have h2 : surcharge k < 0.07268 := surcharge_lt k hk
  have h3 : Dsum k ≤ Hpp := Dsum_le_Hpp k
  have h4 : Hpp < 2.798806594208 := RHLean.GateII.HCert.Hpp_lt_2798806594208
  linarith


theorem hppHalf_lt (k : ℕ) (hk : X0 ≤ k) : hppHalf k < 2.871496589970 := by
  have h := hppHalf_lt_2871486594208 k hk
  linarith



theorem Vsum_le_prime_add_hppHalf (k : ℕ) :
