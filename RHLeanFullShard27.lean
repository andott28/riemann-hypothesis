theorem X0_lt_exp_151 : (RHLean.GateII.SA.X0 : ℝ) < Real.exp 15.1 := by
  have h1 : Real.exp 15.1 = (Real.exp 1) ^ 15 * Real.exp (1 / 10) := by
    rw [show (15.1 : ℝ) = 15 + 1 / 10 by norm_num, Real.exp_add, ← Real.exp_nat_mul]
    norm_num
  have he : (2.7182818283 : ℝ) ≤ Real.exp 1 := le_of_lt Real.exp_one_gt_d9
  have he10 : (1.105 : ℝ) ≤ Real.exp (1 / 10) := by
