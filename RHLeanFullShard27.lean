noncomputable def hiLambda (n : ℕ) : ℚ :=
  if _h : IsPrimePow n then logUpper (Nat.minFac n) else 0

theorem hiLambda_nonneg (n : ℕ) : 0 ≤ hiLambda n := by
  unfold hiLambda
  split_ifs with h
  · have hp : Nat.Prime (Nat.minFac n) := Nat.minFac_prime h.ne_one
    have h1 : 1 ≤ Nat.minFac n := hp.one_lt.le
    have hlog : 0 ≤ Real.log (Nat.minFac n : ℝ) := Real.log_nonneg (by exact_mod_cast h1)
    exact_mod_cast (le_trans hlog (logUpper_sound hp))
  · norm_num

theorem lambda_le_hiLambda (n : ℕ) : Lambda n ≤ (hiLambda n : ℝ) := by
  unfold hiLambda
  split_ifs with h
  · have hfun : hiFun n = logUpper (Nat.minFac n) := by
      unfold hiFun
      rw [if_neg (by have := h.two_le; omega : ¬ n < 2)]
    rw [← hfun]
    exact lambda_le_hiFun h
  · have hz : Lambda n = 0 := by
      simpa [Lambda] using (ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr h)
    rw [hz]
    norm_num


noncomputable def mertensHi (k : ℕ) : ℚ :=
  ∑ n ∈ Finset.range (k + 1), hiLambda n / (n : ℚ)

noncomputable def harmonicQ (k : ℕ) : ℚ :=
  ∑ n ∈ Finset.range (k + 1), (1 : ℚ) / (n : ℚ)

theorem mertensHi_zero : mertensHi 0 = 0 := by
  unfold mertensHi
  simp [hiLambda]

theorem mertensHi_succ (k : ℕ) :
    mertensHi (k + 1) = mertensHi k + hiLambda (k + 1) / ((k + 1 : ℕ) : ℚ) := by
  unfold mertensHi
  rw [Finset.sum_range_succ]

theorem harmonicQ_succ (k : ℕ) :
    harmonicQ (k + 1) = harmonicQ k + (1 : ℚ) / ((k + 1 : ℕ) : ℚ) := by
  unfold harmonicQ
  rw [Finset.sum_range_succ]

theorem harmonicQ_eq_harmonic (k : ℕ) : harmonicQ k = harmonic k := by
  unfold harmonicQ harmonic
  rw [Finset.sum_range_succ']
  simp




noncomputable def mertensGo : ℕ → Bool × ℚ × ℚ
  | 0 => (true, 0, 0)
  | (m + 1) =>
      let prev := mertensGo m
      let k := m + 1
      let t := prev.2.1 + hiLambda k / (k : ℚ)
      let h := prev.2.2 + (1 : ℚ) / (k : ℚ)
      (prev.1 && decide (k < 7 ∨ t < h - 1), t, h)

theorem mertensGo_snd (m : ℕ) :
    (mertensGo m).2.1 = mertensHi m ∧ (mertensGo m).2.2 = harmonicQ m := by
  induction m with
  | zero => simp [mertensGo, mertensHi_zero, harmonicQ]
  | succ m ih =>
      simp [mertensGo, ih.1, ih.2, mertensHi_succ, harmonicQ_succ]



theorem mertensGo_sound (m : ℕ) (h : (mertensGo m).1 = true) :
    ∀ k : ℕ, k ≤ m → 7 ≤ k →
      mertensHi k < harmonicQ k - 1 := by
  induction m with
  | zero =>
      intro k hk h7
      omega
  | succ m ih =>
      rw [mertensGo] at h
      obtain ⟨hprev, hstep⟩ := Bool.and_eq_true_iff.mp h
      intro k hk h7
      rcases Nat.lt_or_ge k (m + 1) with hlt | hge
      · exact ih hprev k (by omega) h7
      · have hk_eq : k = m + 1 := by omega
        subst hk_eq
        have hcheck := of_decide_eq_true hstep
        rcases hcheck with hsmall | hbig
        · omega
        · have hsnd := mertensGo_snd m
          rw [hsnd.1, hsnd.2] at hbig
          simpa [mertensHi_succ, harmonicQ_succ] using hbig


theorem logLower_sound_nat {n : ℕ} (hn : 1 ≤ n) :
    (logLower n : ℝ) ≤ Real.log (n : ℝ) := by
  rcases eq_or_lt_of_le hn with rfl | hlt
  · norm_num [logLower, logLo, xOf]
  · have hn2 : 2 ≤ n := by omega
    unfold logLower
    exact logLo_sound (by omega) (xOf_nonneg hn2) (xOf_lt_one hn) (xOf_eq hn) log2loQ_sound


theorem log_succ_sub_one_lt (k : ℕ) (hk : 1 ≤ k) :
    Real.log ((k + 1 : ℕ) : ℝ) - 1 < Real.log (k : ℝ) := by
  have hkpos : (0 : ℝ) < (k : ℝ) := by exact_mod_cast (by omega : 0 < k)
  have hk1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hxpos : (0 : ℝ) < 1 + 1 / (k : ℝ) := by positivity
  have hxne : 1 + 1 / (k : ℝ) ≠ 1 := by
    have : 0 < 1 / (k : ℝ) := by positivity
    linarith
  have hlog : Real.log (1 + 1 / (k : ℝ)) < 1 / (k : ℝ) := by
    have := Real.log_lt_sub_one_of_pos hxpos hxne
    linarith
  have hsplit : Real.log ((k + 1 : ℕ) : ℝ)
      = Real.log (k : ℝ) + Real.log (1 + 1 / (k : ℝ)) := by
    rw [show ((k + 1 : ℕ) : ℝ) = (k : ℝ) * (1 + 1 / (k : ℝ)) by
      push_cast
      field_simp]
    rw [Real.log_mul hkpos.ne' hxpos.ne']
  have hinv : 1 / (k : ℝ) ≤ 1 := by
    rw [div_le_one hkpos]
    exact hk1
  linarith



unsafe def mertensFast (N : Nat) : Bool := Id.run do
  let spf := mkSPF N
  let logArr := mkLogArr N spf
  let mut lam : Array Float := Array.replicate (N + 1) 0.0
  for k in List.range (N + 1) do
    if k >= 2 then


      for (n, p, _e) in ppList spf k do
        if n == k then
          lam := lam.set! k (logArr.getD p 0.0 + 1e-6)
  let mut t : Float := 0.0
  let mut h : Float := 0.0
  let mut ok := true
  for k in List.range (N + 1) do
    if k >= 1 then
      h := h + 1.0 / Float.ofNat k
    if k >= 2 then
      t := t + lam.getD k 0.0 / Float.ofNat k
    if k >= 7 then
      if t >= h - 1.0 - 1e-6 then
        ok := false
  return ok


noncomputable def mertensRun (N : ℕ) : Bool := (mertensGo N).1

unsafe def mertensRunImpl (N : ℕ) : Bool := mertensFast N

@[implemented_by mertensRunImpl]
