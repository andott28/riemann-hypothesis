    (hTheta : ∀ k : ℕ, X0 ≤ k →
      ∀ t ∈ Set.Icc (X0 : ℝ) (k : ℝ), |Chebyshev.theta t - t| ≤ (13 / 100) * t) :
    AWGCTail := by
  have hX0 : X0 ≤ 3594642 := by norm_num [X0]
