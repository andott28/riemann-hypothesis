theorem tailW_le_div {p : ℕ} (hp1 : 1 ≤ p) {u : ℝ} (hlog : Real.log (p : ℝ) ≤ u) :
    tailW p ≤ u / (p : ℝ) := by
  have hpR : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hp1
  have hL0 : 0 ≤ Real.log (p : ℝ) := Real.log_natCast_nonneg p
  have hu0 : 0 ≤ u := le_trans hL0 hlog
  rcases eq_or_lt_of_le hL0 with h | h
  · have hzero : tailW p = 0 := by
      unfold tailW
      rw [← h]
      simp
    rw [hzero]
    exact div_nonneg hu0 hpR.le
  · have hden1 : 0 < (p : ℝ) * Real.log (p : ℝ) := mul_pos hpR h
    have hden2 : 0 < (p : ℝ) * (Real.log (p : ℝ) + beta0) :=
      mul_pos hpR (by linarith [beta0_pos])
    have hmono : (p : ℝ) * Real.log (p : ℝ)
        ≤ (p : ℝ) * (Real.log (p : ℝ) + beta0) := by
      nlinarith [beta0_pos, hpR.le]
    calc tailW p
        = (Real.log (p : ℝ)) ^ 2 / ((p : ℝ) * (Real.log (p : ℝ) + beta0)) := rfl
      _ ≤ (Real.log (p : ℝ)) ^ 2 / ((p : ℝ) * Real.log (p : ℝ)) :=
          div_le_div_of_nonneg_left (sq_nonneg _) hden1 hmono
      _ = Real.log (p : ℝ) / (p : ℝ) := by
          field_simp
      _ ≤ u / (p : ℝ) := div_le_div_of_nonneg_right hlog hpR.le



theorem log_two_le : Real.log (2 : ℝ) ≤ (7 : ℝ) / 10 := by
  simpa using log_le_of_taylor (p := 2) (N := 10) (u := 7 / 10) (by norm_num) (by norm_num)
    (by norm_num [Finset.sum_range_succ])

