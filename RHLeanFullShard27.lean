      (gramMatrix (RHLean.endpoint (k + 1))
        (truncBasis (RHLean.endpoint k) (RHLean.endpoint (k + 1)) N)).PosSemidef) →
    RHLean.LocalPSD (RHLean.endpoint (k + 1))




theorem gateIIOperatorStep_of (hG : TruncGramSemidef)
    (hL : GramSemidefToLocalPSD) :
    RHLean.GateIIOperatorStep := by
  intro k hk _
  exact hL k hk (hG k hk)





theorem gateIIOperatorStep_of_budget (hbudget : ScalarPacket)
    (hcomp : ScalarPacket → TruncGramSemidef)
    (hL : GramSemidefToLocalPSD) :
    RHLean.GateIIOperatorStep :=
  gateIIOperatorStep_of (hcomp hbudget) hL



theorem gateIIOperatorStep_of_residuals
    (hMert : RHLean.GateII.BClosure.MertensAllBound)
    (hPrime : RHLean.GateII.Tail.PrimePartBound)
    (hWsweep : RHLean.GateII.BClosure.MasterSweepResidual)
    (hcomp : ScalarPacket → TruncGramSemidef)
    (hL : GramSemidefToLocalPSD) :
    RHLean.GateIIOperatorStep :=
  gateIIOperatorStep_of_budget
    (scalarPacket_of_residuals (awgcTail_of_primePart hPrime) hMert hPrime hWsweep)
    hcomp hL






theorem truncGramPosSemidef_of_components {a b : ℝ} {N : ℕ}
    [Invertible (truncCollarBlock a b N)]
    (hA : (truncOldBlock a b N).PosDef)
    (hD : (truncCollarBlock a b N).PosDef)
    (hT : (truncHarmonicForm a b N).PosSemidef)
    (e : EuclideanSpace ℝ (Fin N)) (he : e ≠ 0) (g : ℝ) (hg : 0 < g)
    (hground : g * ‖e‖ ^ 2
      ≤ inner ℝ e (Matrix.toEuclideanLin (truncHarmonicForm a b N) e))
    (hplace : ∀ f : EuclideanSpace ℝ (Fin N),
      0 ≤ groundCoord e f
        * inner ℝ e (Matrix.toEuclideanLin (truncHarmonicForm a b N) (transversePart e f)))
    (hres : ∀ w : EuclideanSpace ℝ (Fin N), inner ℝ e w = 0 → w ≠ 0 →
      0 < inner ℝ w (Matrix.toEuclideanLin (truncHarmonicForm a b N) w)) :
    (gramMatrix b (truncBasis a b N)).PosSemidef :=
  (truncBasis_posDef_of_components a b N hA hD hT e he g hg hground hplace hres).posSemidef




theorem truncGramPosSemidef_of_schur {a b : ℝ} {N : ℕ}
    [Invertible (collarCollarBlock b (truncCollarBasis a b N))]
    (hA : (oldOldBlock b (fun i : Fin N => oldBasis a i)).PosDef)
    (hD : (collarCollarBlock b (truncCollarBasis a b N)).PosDef)
    (hT : (harmonicForm
        (oldOldBlock b (fun i : Fin N => oldBasis a i))
        (oldCollarBlock b (fun i : Fin N => oldBasis a i) (truncCollarBasis a b N))
        (collarCollarBlock b (truncCollarBasis a b N))).PosDef) :
    (gramMatrix b (truncBasis a b N)).PosSemidef :=
  (truncBasis_posDef_of_schur a b N hA hD hT).posSemidef





theorem oldBasis_tendsto_left {a : ℝ} (ha : 0 < a) (n : ℕ) :
    Tendsto (oldBasis a n) (𝓝[<] a) (𝓝 (Y7Matrix.phiC n (a / a))) := by
  have hgt : ∀ᶠ x : ℝ in 𝓝[<] a, -a < x :=
    (eventually_gt_nhds (show -a < a by linarith)).filter_mono nhdsWithin_le_nhds
  have hev : ∀ᶠ x : ℝ in 𝓝[<] a, oldBasis a n x = Y7Matrix.phiC n (x / a) := by
    filter_upwards [self_mem_nhdsWithin, hgt] with x hx hx'
    unfold oldBasis
    rw [Set.indicator_of_mem]
    exact ⟨hx', hx⟩
  have hx : Tendsto (fun x : ℝ => x / a) (𝓝[<] a) (𝓝 (a / a)) :=
    Tendsto.div_const (tendsto_id.mono_left nhdsWithin_le_nhds) a
  have hc : Continuous (fun t : ℝ => Y7Matrix.phiC n t) := by
    unfold Y7Matrix.phiC
    fun_prop
  have hcomp : Tendsto (fun x : ℝ => Y7Matrix.phiC n (x / a)) (𝓝[<] a)
      (𝓝 (Y7Matrix.phiC n (a / a))) :=
    hc.continuousAt.tendsto.comp hx
  exact Tendsto.congr' (hev.mono fun x hx => hx.symm) hcomp


theorem phiC_one_ne_zero (n : ℕ) : Y7Matrix.phiC n 1 ≠ 0 := by
  have h := Y7Legendre.phi_eval_one n
  unfold Y7Matrix.phiC
  rw [h]
  simp only [Ne]
  rw [Complex.ofReal_eq_zero]
  exact (Real.sqrt_pos.mpr (by positivity)).ne'


theorem oldBasis_not_continuousAt {a : ℝ} (ha : 0 < a) (n : ℕ) :
    ¬ ContinuousAt (oldBasis a n) a := by
  intro hcont
  have hval : oldBasis a n a = 0 := by simp [oldBasis]
  have hlim : Tendsto (oldBasis a n) (𝓝[<] a) (𝓝 (oldBasis a n a)) :=
    hcont.tendsto.mono_left nhdsWithin_le_nhds
  rw [hval] at hlim
  have h1 := oldBasis_tendsto_left ha n
  have h2 : Y7Matrix.phiC n (a / a) = 0 := tendsto_nhds_unique h1 hlim
  have h3 : a / a = (1 : ℝ) := by field_simp
  rw [h3] at h2
  exact phiC_one_ne_zero n h2


theorem oldBasis_not_mem_localizedCore (a b : ℝ) (ha : 0 < a) (n : ℕ) :
    oldBasis a n ∉ RHLean.localizedCore b := by
  intro h
  exact oldBasis_not_continuousAt ha n h.1.1.continuous.continuousAt


theorem truncBasis_old_not_mem_localizedCore (a b : ℝ) (ha : 0 < a) (N : ℕ)
    (i : Fin N) :
    truncBasis a b N (Sum.inl i) ∉ RHLean.localizedCore b := by
  have h : truncBasis a b N (Sum.inl i) = oldBasis a i := rfl
  rw [h]
  exact oldBasis_not_mem_localizedCore a b ha i





theorem gateIIOperatorStep_of_endpoint_psd
    (h : ∀ k : ℕ, 7 ≤ k → RHLean.LocalPSD (RHLean.endpoint (k + 1))) :
    RHLean.GateIIOperatorStep :=
  fun k hk _ => h k hk



theorem endpoints_psd_of_step
    (hbase : RHLean.LocalPSD (RHLean.endpoint 7))
    (h : RHLean.GateIIOperatorStep) :
    ∀ k : ℕ, 7 ≤ k → RHLean.LocalPSD (RHLean.endpoint k) :=
  RHLean.endpoints_psd_of_targets hbase h

