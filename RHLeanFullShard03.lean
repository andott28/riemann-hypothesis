    rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_add]
    · rw [setIntegral_shift_plus n j hr0 hr2.le, setIntegral_shift_minus n j hr0 hr2.le,
        Y7Matrix.shiftGram]
      ring
    · refine Integrable.of_bound ?_ (Bn * Bj) ?_
