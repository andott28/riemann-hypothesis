section Inline_Y7Bessel
noncomputable section
open MeasureTheory
open scoped BigOperators ENNReal
namespace Y7Bessel
abbrev mu : Measure ℝ := volume.restrict (Set.Ioo (-1 : ℝ) 1)
abbrev E : Type := Lp ℂ 2 mu
instance : IsFiniteMeasure mu := by
  constructor
  rw [Measure.restrict_apply MeasurableSet.univ, Set.univ_inter]
  exact measure_Ioo_lt_top
lemma memLp_phiC (n : ℕ) : MemLp (Y7Matrix.phiC n) 2 mu := by
  have hcont : Continuous (Y7Matrix.phiC n) := by
    unfold Y7Matrix.phiC
    fun_prop
  have h2 : Continuous (fun x : ℝ => ‖Y7Matrix.phiC n x‖ ^ 2) := hcont.norm.pow 2
  have hint : IntegrableOn (fun x : ℝ => ‖Y7Matrix.phiC n x‖ ^ 2) (Set.Icc (-1 : ℝ) 1) :=
    h2.integrableOn_Icc
  exact (memLp_two_iff_integrable_sq_norm hcont.measurable.aestronglyMeasurable).mpr
    (hint.mono_set Set.Ioo_subset_Icc_self)
noncomputable def phiLp (n : ℕ) : E := (memLp_phiC n).toLp (Y7Matrix.phiC n)
lemma inner_toLp {f g : ℝ → ℂ} (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :
    inner ℂ (hf.toLp f) (hg.toLp g) = ∫ x, inner ℂ (f x) (g x) ∂mu := by
  rw [MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with x hx hy
  rw [hx, hy]
lemma integral_phi_mul_phi_Ioo' (m n : ℕ) :
    (∫ y in Set.Ioo (-1 : ℝ) 1, (Y7Legendre.phi m).eval y * (Y7Legendre.phi n).eval y) =
      if m = n then 1 else 0 := by
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  exact Y7Rodrigues.integral_phi_mul_phi_eq_ite m n
lemma inner_phiLp (m n : ℕ) :
    inner ℂ (phiLp m) (phiLp n) = if m = n then 1 else 0 := by
  rw [phiLp, phiLp, inner_toLp (memLp_phiC m) (memLp_phiC n)]
  have hpt : ∀ x : ℝ, inner ℂ (Y7Matrix.phiC m x) (Y7Matrix.phiC n x)
      = (((Y7Legendre.phi m).eval x * (Y7Legendre.phi n).eval x : ℝ) : ℂ) := by
    intro x
    rw [RCLike.inner_apply']
    simp only [Y7Matrix.phiC, Complex.conj_ofReal, Complex.ofReal_mul]
  simp_rw [hpt]
  have hcast : (∫ x, (((Y7Legendre.phi m).eval x * (Y7Legendre.phi n).eval x : ℝ) : ℂ) ∂mu)
      = ((∫ x, (Y7Legendre.phi m).eval x * (Y7Legendre.phi n).eval x ∂mu : ℝ) : ℂ) :=
    integral_ofReal (𝕜 := ℂ) (μ := mu)
      (f := fun x => (Y7Legendre.phi m).eval x * (Y7Legendre.phi n).eval x)
  rw [hcast, integral_phi_mul_phi_Ioo']
  by_cases h : m = n <;> simp [h]
theorem phiLp_orthonormal : Orthonormal ℂ phiLp := by
  refine ⟨?_, ?_⟩
  · intro n
    have h := inner_phiLp n n
    simp only [if_true] at h
    have h2 : ((‖phiLp n‖ ^ 2 : ℝ) : ℂ) = 1 := by
      rw [← h, inner_self_eq_norm_sq_to_K]
      push_cast
      rfl
    have h3 : ‖phiLp n‖ ^ 2 = 1 := by exact_mod_cast h2
    rcases sq_eq_one_iff.mp h3 with h1 | h1
    · exact h1
    · linarith [norm_nonneg (phiLp n)]
  · intro m n hmn
    rw [inner_phiLp m n]
    simp [hmn]
theorem bessel {s : Finset ℕ} (f : E) :
    ∑ n ∈ s, ‖inner ℂ (phiLp n) f‖ ^ 2 ≤ ‖f‖ ^ 2 :=
  phiLp_orthonormal.sum_inner_products_le f
end Y7Bessel
end
end Inline_Y7Bessel
section Inline_Y7Parseval
noncomputable section
open MeasureTheory
open scoped BigOperators ENNReal
namespace Y7Parseval
abbrev mu : Measure ℝ := volume.restrict (Set.Ioo (-1 : ℝ) 1)
lemma measurable_rescaledPotential :
    Measurable (fun x : ℝ => RHLean.rescaledPotential x) := by
  unfold RHLean.rescaledPotential
  fun_prop
lemma exists_bound_phi (i : ℕ) :
    ∃ C : ℝ, ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖(Y7Legendre.phi i).eval x‖ ≤ C := by
  have hcont : Continuous (Y7Matrix.phiC i) := by
    unfold Y7Matrix.phiC
    fun_prop
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hcont.continuousOn
  refine ⟨C, fun x hx => ?_⟩
  have := hC x hx
  simpa [Y7Matrix.phiC, Complex.norm_real] using this
lemma memLp_V : MemLp (fun x : ℝ => RHLean.rescaledPotential x) 2 mu := by
  rw [memLp_two_iff_integrable_sq_norm
    (measurable_rescaledPotential.aestronglyMeasurable)]
  have hV2 : IntervalIntegrable (fun x : ℝ => RHLean.rescaledPotential x ^ 2) volume (-1) 1 := by
    simpa using Y7Matrix.intervalIntegrable_rescaledPotential_sq_mul_pow 0
  have hV2n : IntervalIntegrable (fun x : ℝ => ‖RHLean.rescaledPotential x‖ ^ 2)
      volume (-1) 1 := by
    convert hV2 using 1
    funext x
    rw [Real.norm_eq_abs, sq_abs]
  exact (integrableOn_Ioc_iff_integrableOn_Ioo).mp
    ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num : (-1 : ℝ) ≤ 1)).mp hV2n)
lemma memLp_V_phi (j : ℕ) :
    MemLp (fun x : ℝ => RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x) 2 mu := by
  have hmeas : AEStronglyMeasurable
      (fun x : ℝ => RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x) mu :=
    (measurable_rescaledPotential.mul
      (by unfold Y7Legendre.phi; fun_prop : Measurable
        (fun x : ℝ => (Y7Legendre.phi j).eval x))).aestronglyMeasurable
  rw [memLp_two_iff_integrable_sq_norm hmeas]
  obtain ⟨C, hC⟩ := exists_bound_phi j
  have hV2 : IntervalIntegrable (fun x : ℝ => RHLean.rescaledPotential x ^ 2) volume (-1) 1 := by
    simpa using Y7Matrix.intervalIntegrable_rescaledPotential_sq_mul_pow 0
  have hV2' : Integrable (fun x : ℝ => RHLean.rescaledPotential x ^ 2) mu :=
    (integrableOn_Ioc_iff_integrableOn_Ioo).mp
      ((intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num : (-1 : ℝ) ≤ 1)).mp hV2)
  have hdom : Integrable (fun x : ℝ => C ^ 2 * RHLean.rescaledPotential x ^ 2) mu :=
    hV2'.const_mul (C ^ 2)
  refine Integrable.mono' hdom ((hmeas.norm.pow 2)) ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
  have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := Set.Ioo_subset_Icc_self hx
  have h1 : ‖(Y7Legendre.phi j).eval x‖ ≤ C := hC x hx'
  have hVnn : 0 ≤ RHLean.rescaledPotential x := Y7Density.rescaledPotential_nonneg hx
  have hsq : ‖RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x‖ ^ 2
      = RHLean.rescaledPotential x ^ 2 * ‖(Y7Legendre.phi j).eval x‖ ^ 2 := by
    rw [Real.norm_eq_abs, abs_mul, mul_pow, sq_abs, Real.norm_eq_abs]
  rw [hsq, Real.norm_of_nonneg (by positivity)]
  have h2 : ‖(Y7Legendre.phi j).eval x‖ ^ 2 ≤ C ^ 2 := by
    have hCnn : 0 ≤ C := le_trans (norm_nonneg _) h1
    nlinarith [h1, norm_nonneg ((Y7Legendre.phi j).eval x), hCnn]
  have h3 : 0 ≤ RHLean.rescaledPotential x ^ 2 := sq_nonneg _
  calc RHLean.rescaledPotential x ^ 2 * ‖(Y7Legendre.phi j).eval x‖ ^ 2
      ≤ RHLean.rescaledPotential x ^ 2 * C ^ 2 := mul_le_mul_of_nonneg_left h2 h3
    _ = C ^ 2 * RHLean.rescaledPotential x ^ 2 := by ring
lemma memLp_poly (p : Polynomial ℝ) : MemLp (fun x : ℝ => p.eval x) 2 mu := by
  have hcont : Continuous (fun x : ℝ => p.eval x) := p.continuous
  rw [memLp_two_iff_integrable_sq_norm hcont.measurable.aestronglyMeasurable]
  have hint : IntegrableOn (fun x : ℝ => ‖p.eval x‖ ^ 2) (Set.Icc (-1 : ℝ) 1) :=
    ((hcont.norm.pow 2)).integrableOn_Icc
  exact hint.mono_set Set.Ioo_subset_Icc_self
lemma memLp_sinhTaylor (a : ℝ) :
    MemLp (fun x : ℝ => Y7Chain.sinhTaylorFun a x 100) 2 mu := by
  have hcont : Continuous (fun x : ℝ => Y7Chain.sinhTaylorFun a x 100) := by
    unfold Y7Chain.sinhTaylorFun
    fun_prop
  rw [memLp_two_iff_integrable_sq_norm hcont.measurable.aestronglyMeasurable]
  have hint : IntegrableOn (fun x : ℝ => ‖Y7Chain.sinhTaylorFun a x 100‖ ^ 2)
      (Set.Icc (-1 : ℝ) 1) := (hcont.norm.pow 2).integrableOn_Icc
  exact hint.mono_set Set.Ioo_subset_Icc_self
lemma exists_bound_phi_ext (j : ℕ) :
    ∃ C : ℝ, ∀ y ∈ Set.Icc (-1 : ℝ) 3, ‖(Y7Legendre.phi j).eval y‖ ≤ C := by
  have hcont : Continuous (fun y : ℝ => (Y7Legendre.phi j).eval y) :=
    ((Y7Legendre.phi j)).continuous
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 3)).exists_bound_of_continuousOn
    hcont.continuousOn
  exact ⟨C, hC⟩
lemma exists_bound_shiftAction {a : ℝ} (ha : 0 < a) (j : ℕ) :
    ∃ C : ℝ, ∀ x ∈ Set.Ioo (-1 : ℝ) 1, ‖Y7K2.shiftAction a j x‖ ≤ C := by
  obtain ⟨B, hB⟩ := exists_bound_phi_ext j
  have hBnn : 0 ≤ B := le_trans (norm_nonneg _) (hB (-1) ⟨by norm_num, by norm_num⟩)
  refine ⟨2 * (∑ k ∈ RHLean.arithSupport a, ‖RHLean.arithCoeff k‖) * B, fun x hx => ?_⟩
  unfold Y7K2.shiftAction
  have hx1 : -1 < x := hx.1
  have hx2 : x < 1 := hx.2
  calc ‖∑ k ∈ RHLean.arithSupport a, RHLean.arithCoeff k *
        ((if x < 1 - RHLean.shiftLengthRescaled a k then
            (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
          + (if -1 + RHLean.shiftLengthRescaled a k < x then
            (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0))‖
      ≤ ∑ k ∈ RHLean.arithSupport a, ‖RHLean.arithCoeff k *
          ((if x < 1 - RHLean.shiftLengthRescaled a k then
              (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
            + (if -1 + RHLean.shiftLengthRescaled a k < x then
              (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0))‖ :=
        norm_sum_le _ _
    _ ≤ ∑ k ∈ RHLean.arithSupport a, ‖RHLean.arithCoeff k‖ * (2 * B) := by
        apply Finset.sum_le_sum
        intro k hk
        have hr2 : RHLean.shiftLengthRescaled a k < 2 :=
          Y7Op.shiftLengthRescaled_lt_two hk
        have hr0 : 0 ≤ RHLean.shiftLengthRescaled a k := by
          unfold RHLean.shiftLengthRescaled
          apply div_nonneg (Real.log_nonneg ?_) ha.le
          rw [RHLean.arithSupport, Finset.mem_Icc] at hk
          exact_mod_cast (show 1 ≤ k by omega)
        have hterm1 : ‖(if x < 1 - RHLean.shiftLengthRescaled a k then
              (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)‖ ≤ B := by
          split_ifs with h
          · exact hB _ ⟨by linarith, by linarith⟩
          · simpa using hBnn
        have hterm2 : ‖(if -1 + RHLean.shiftLengthRescaled a k < x then
              (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)‖ ≤ B := by
          split_ifs with h
          · exact hB _ ⟨by linarith, by linarith⟩
          · simpa using hBnn
        calc ‖RHLean.arithCoeff k *
              ((if x < 1 - RHLean.shiftLengthRescaled a k then
                  (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
                + (if -1 + RHLean.shiftLengthRescaled a k < x then
                  (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0))‖
            = ‖RHLean.arithCoeff k‖ *
                ‖(if x < 1 - RHLean.shiftLengthRescaled a k then
                    (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
                  + (if -1 + RHLean.shiftLengthRescaled a k < x then
                    (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)‖ :=
              norm_mul _ _
          _ ≤ ‖RHLean.arithCoeff k‖ * (2 * B) := by
              apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
              calc ‖(if x < 1 - RHLean.shiftLengthRescaled a k then
                    (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
                  + (if -1 + RHLean.shiftLengthRescaled a k < x then
                    (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)‖
                  ≤ ‖(if x < 1 - RHLean.shiftLengthRescaled a k then
                      (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)‖
                    + ‖(if -1 + RHLean.shiftLengthRescaled a k < x then
                      (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)‖ :=
                    norm_add_le _ _
                _ ≤ B + B := add_le_add hterm1 hterm2
                _ = 2 * B := by ring
    _ = 2 * (∑ k ∈ RHLean.arithSupport a, ‖RHLean.arithCoeff k‖) * B := by
        rw [← Finset.sum_mul]
        ring
lemma measurable_shiftAction (a : ℝ) (j : ℕ) :
    Measurable (fun x : ℝ => Y7K2.shiftAction a j x) := by
  unfold Y7K2.shiftAction
  apply Finset.measurable_sum
  intro k hk
  apply Measurable.mul measurable_const
  apply Measurable.add
  · apply Measurable.ite (measurableSet_lt measurable_id measurable_const)
    · fun_prop
    · exact measurable_const
  · apply Measurable.ite (measurableSet_lt measurable_const measurable_id)
    · fun_prop
    · exact measurable_const
lemma memLp_shiftAction {a : ℝ} (ha : 0 < a) (j : ℕ) :
    MemLp (fun x : ℝ => Y7K2.shiftAction a j x) 2 mu := by
  have hmeas : AEStronglyMeasurable (fun x : ℝ => Y7K2.shiftAction a j x) mu :=
    (measurable_shiftAction a j).aestronglyMeasurable
  obtain ⟨C, hC⟩ := exists_bound_shiftAction ha j
  exact MemLp.of_bound hmeas C (by
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    exact hC x hx)
lemma memLp_K0Action {a : ℝ} (ha : 0 < a) (j : ℕ) :
    MemLp (fun x : ℝ => Y7K2.K0Action a j x) 2 mu := by
  have h1 : MemLp (fun x : ℝ => RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x) 2 mu :=
    memLp_V_phi j
  have h2 : MemLp (fun x : ℝ => (Y7K2.gammaActionPhi a j).eval x) 2 mu :=
    memLp_poly _
  have h3 : MemLp (fun x : ℝ => 2 * a * Y7ModelOne.polarMomentModel a j *
      Y7Chain.sinhTaylorFun a x 100) 2 mu :=
    (memLp_sinhTaylor a).const_mul _
  have h4 : MemLp (fun x : ℝ => Y7K2.shiftAction a j x) 2 mu :=
    memLp_shiftAction ha j
  unfold Y7K2.K0Action
  exact ((h1.sub h2).sub h3).sub h4
end Y7Parseval
end
end Inline_Y7Parseval
section Inline_Y7MatElem
noncomputable section
open MeasureTheory
open scoped BigOperators ENNReal
namespace Y7MatElem
lemma integral_V_part (n j : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x *
          (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x))
      = Y7Matrix.potentialMatrix n j := by
  rw [Y7Matrix.potentialMatrix]
  apply integral_congr_ae
  filter_upwards with x
  ring
lemma integral_gamma_part (a : ℝ) (n j : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x * (Y7K2.gammaActionPhi a j).eval x)
      = Y7KPP.gammaModelM a n j := by
  rw [show Y7KPP.gammaModelM a n j = ∫ x in (-1 : ℝ)..1, ∫ y in (-1 : ℝ)..1,
      (Y7Density.rhoTrunc 240).eval (a * |x - y|) *
        ((Y7Legendre.phi n).eval x * (Y7Legendre.phi j).eval y) from
    Y7ModelOne.gammaModelMatrix_phi 240 a n j]
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  apply intervalIntegral.integral_congr
  intro x hx
  beta_reduce
  rw [Set.uIcc_of_le (by norm_num : (-1 : ℝ) ≤ 1)] at hx
  rw [Y7K2.gammaActionPhi_eval a j hx]
  rw [← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_congr
  intro y hy
  beta_reduce
  ring
lemma integral_phi_sinhTaylor (a : ℝ) (n : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x * Y7Chain.sinhTaylorFun a x 100)
      = Y7ModelOne.polarMomentModel a n := by
  have h1 : Y7Approx.polarInnerApprox a (Y7Matrix.phiC n)
      = ((∫ x in Set.Ioo (-1 : ℝ) 1,
          Y7Chain.sinhTaylorFun a x 100 * (Y7Legendre.phi n).eval x : ℝ) : ℂ) := by
    unfold Y7Approx.polarInnerApprox Y7Approx.sTrunc Y7Matrix.phiC
    have hpt : ∀ x : ℝ, star (((Y7Chain.sinhTaylorFun a x 100 : ℝ) : ℂ)) *
        (((Y7Legendre.phi n).eval x : ℝ) : ℂ)
        = (((Y7Chain.sinhTaylorFun a x 100 * (Y7Legendre.phi n).eval x : ℝ) : ℂ)) := by
      intro x
      simp only [Complex.star_def, Complex.conj_ofReal]
      push_cast
      ring
    simp_rw [hpt]
    exact integral_ofReal (𝕜 := ℂ) (μ := volume.restrict (Set.Ioo (-1 : ℝ) 1))
      (f := fun x => Y7Chain.sinhTaylorFun a x 100 * (Y7Legendre.phi n).eval x)
  have h2 := Y7ModelOne.polarInnerApprox_eq a n
  rw [h1] at h2
  have h3 : (∫ x in Set.Ioo (-1 : ℝ) 1,
        Y7Chain.sinhTaylorFun a x 100 * (Y7Legendre.phi n).eval x)
      = Real.sqrt ((2 * (n : ℝ) + 1) / 2) *
        ∫ x in (-1 : ℝ)..1, Y7Chain.sinhTaylorFun a x 100 *
          (Y7Legendre.legP n).eval x := Complex.ofReal_inj.mp h2
  rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x * Y7Chain.sinhTaylorFun a x 100)
      = (∫ x in Set.Ioo (-1 : ℝ) 1,
          Y7Chain.sinhTaylorFun a x 100 * (Y7Legendre.phi n).eval x) from by
        apply integral_congr_ae
        filter_upwards with x
        ring]
  rw [h3, Y7ModelOne.polarMomentModel]
lemma integral_polar_part (a : ℝ) (n j : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x *
          (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100))
      = Y7KPP.polarModelM a n j := by
  rw [show (∫ x in Set.Ioo (-1 : ℝ) 1,
        (Y7Legendre.phi n).eval x *
          (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100))
      = (2 * a * Y7ModelOne.polarMomentModel a j) *
        (∫ x in Set.Ioo (-1 : ℝ) 1,
          (Y7Legendre.phi n).eval x * Y7Chain.sinhTaylorFun a x 100) from by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with x
        ring]
  rw [integral_phi_sinhTaylor, Y7KPP.polarModelM]
  ring
lemma setIntegral_shift_plus (n j : ℕ) {r : ℝ} (hr : 0 ≤ r) (hr2 : r ≤ 2) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, (Y7Legendre.phi n).eval x *
        (if x < 1 - r then (Y7Legendre.phi j).eval (x + r) else 0))
      = Real.sqrt ((2 * (n : ℝ) + 1) / 2) * Real.sqrt ((2 * (j : ℝ) + 1) / 2) *
          Y7Matrix.shiftOverlap n j r := by
  have hc : 1 - r ≤ 1 := by linarith
  have h1 : ∀ x : ℝ, (Y7Legendre.phi n).eval x *
        (if x < 1 - r then (Y7Legendre.phi j).eval (x + r) else 0)
      = ((Set.Iio (1 - r)).indicator
          (fun x => (Y7Legendre.phi n).eval x * (Y7Legendre.phi j).eval (x + r))) x := by
    intro x
    by_cases h : x ∈ Set.Iio (1 - r)
    · have hh : x < 1 - r := h
      simp [Set.indicator, h, hh]
    · have hh : ¬ (x < 1 - r) := h
      simp [Set.indicator, h, hh]
  simp_rw [h1]
  rw [MeasureTheory.setIntegral_indicator measurableSet_Iio]
  rw [show Set.Ioo (-1 : ℝ) 1 ∩ Set.Iio (1 - r) = Set.Ioo (-1 : ℝ) (1 - r) from by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_Ioo, Set.mem_setOf_eq]
    constructor
    · rintro ⟨⟨h1', _⟩, h2⟩; exact ⟨h1', h2⟩
    · rintro ⟨h1', h2⟩; exact ⟨⟨h1', lt_of_lt_of_le h2 hc⟩, h2⟩]
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
    ← intervalIntegral.integral_of_le (by linarith : (-1 : ℝ) ≤ 1 - r)]
