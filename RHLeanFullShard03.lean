  unfold Y7Bessel.phiLp
  rw [Y7Bessel.inner_toLp (Y7Bessel.memLp_phiC n) (memLp_K0ActionC ha j)]
  have hpt : ∀ x : ℝ, inner ℂ (Y7Matrix.phiC n x) ((Y7K2.K0Action a j x : ℝ) : ℂ)
      = (((Y7Legendre.phi n).eval x * Y7K2.K0Action a j x : ℝ) : ℂ) := by
    intro x
    rw [RCLike.inner_apply']
    simp only [Y7Matrix.phiC, Complex.conj_ofReal]
    push_cast
    ring
  simp_rw [hpt]
  have hcast : (∫ x, (((Y7Legendre.phi n).eval x * Y7K2.K0Action a j x : ℝ) : ℂ) ∂mu)
      = ((∫ x, (Y7Legendre.phi n).eval x * Y7K2.K0Action a j x ∂mu : ℝ) : ℂ) :=
    integral_ofReal (𝕜 := ℂ) (μ := mu)
      (f := fun x => (Y7Legendre.phi n).eval x * Y7K2.K0Action a j x)
  rw [hcast]
  congr 1
  exact Y7ParsevalB.integral_K0Action ha n j
lemma inner_actionLp {a : ℝ} (ha : 0 < a) (i j : Fin 100) :
    inner ℂ (actionLp ha (2 * (i : ℕ) + 1)) (actionLp ha (2 * (j : ℕ) + 1))
      = ((Y7K2.K2PP a i j : ℝ) : ℂ) := by
  rw [actionLp, actionLp]
  rw [Y7Bessel.inner_toLp (memLp_K0ActionC ha _) (memLp_K0ActionC ha _)]
  have hpt : ∀ x : ℝ, inner ℂ (((Y7K2.K0Action a (2 * (i : ℕ) + 1) x : ℝ) : ℂ))
      (((Y7K2.K0Action a (2 * (j : ℕ) + 1) x : ℝ) : ℂ))
      = (((Y7K2.K0Action a (2 * (i : ℕ) + 1) x *
          Y7K2.K0Action a (2 * (j : ℕ) + 1) x : ℝ) : ℂ)) := by
    intro x
    rw [RCLike.inner_apply']
    simp only [Complex.conj_ofReal]
    push_cast
    ring
  simp_rw [hpt]
  have hcast : (∫ x, (((Y7K2.K0Action a (2 * (i : ℕ) + 1) x *
        Y7K2.K0Action a (2 * (j : ℕ) + 1) x : ℝ) : ℂ)) ∂mu)
      = ((∫ x, Y7K2.K0Action a (2 * (i : ℕ) + 1) x *
          Y7K2.K0Action a (2 * (j : ℕ) + 1) x ∂mu : ℝ) : ℂ) :=
    integral_ofReal (𝕜 := ℂ) (μ := mu)
      (f := fun x => Y7K2.K0Action a (2 * (i : ℕ) + 1) x *
        Y7K2.K0Action a (2 * (j : ℕ) + 1) x)
  rw [hcast]
  congr 1
noncomputable def coeff (a : ℝ) (n j : ℕ) : ℝ :=
  Y7KPP.modelM a n j - ((if n = j then Y7Matrix.harmonicR n else 0)
    + RHLean.c0 a * (if n = j then 1 else 0))
lemma coeff_KPP (a : ℝ) (i j : Fin 100) :
    coeff a (2 * (i : ℕ) + 1) (2 * (j : ℕ) + 1) = Y7KPP.KPP a i j := by
  unfold coeff
  rw [Y7KPP.KPP_eq_modelM]
noncomputable def Bcrit (a : ℝ) : Matrix (Fin 50) (Fin 100) ℝ :=
  fun m j => Y7KPP.modelM a (2 * (100 + (m : ℕ)) + 1) (2 * (j : ℕ) + 1)
lemma coeff_Bcrit (a : ℝ) (m : Fin 50) (j : Fin 100) :
    coeff a (2 * (100 + (m : ℕ)) + 1) (2 * (j : ℕ) + 1) = Bcrit a m j := by
  unfold coeff Bcrit
  have h : ¬ (100 + (m : ℕ) = (j : ℕ)) := by
    have := j.isLt; omega
  simp [h]
noncomputable def testLp {a : ℝ} (ha : 0 < a) (y : Fin 100 → ℝ) : Y7Bessel.E :=
  ∑ j : Fin 100, ((y j : ℝ) : ℂ) • actionLp ha (2 * (j : ℕ) + 1)
lemma inner_phiLp_testLp {a : ℝ} (ha : 0 < a) (y : Fin 100 → ℝ) (n : ℕ) :
    inner ℂ (Y7Bessel.phiLp n) (testLp ha y)
      = ((∑ j : Fin 100, y j * coeff a n (2 * (j : ℕ) + 1) : ℝ) : ℂ) := by
  unfold testLp
  rw [inner_sum]
  simp only [inner_smul_right, inner_phiLp_actionLp, coeff]
  push_cast
  apply Finset.sum_congr rfl
  intro j hj
  ring
lemma K2PP_comm (a : ℝ) (i j : Fin 100) :
    Y7K2.K2PP a i j = Y7K2.K2PP a j i := by
  unfold Y7K2.K2PP
  apply integral_congr_ae
  filter_upwards with x
  ring
lemma norm_sq_testLp {a : ℝ} (ha : 0 < a) (y : Fin 100 → ℝ) :
    ‖testLp ha y‖ ^ 2 = ∑ i : Fin 100, ∑ j : Fin 100,
      y i * y j * Y7K2.K2PP a i j := by
  have h : inner ℂ (testLp ha y) (testLp ha y)
      = ((∑ i : Fin 100, ∑ j : Fin 100, y i * y j * Y7K2.K2PP a i j : ℝ) : ℂ) := by
    unfold testLp
    rw [sum_inner]
    simp only [inner_sum, inner_smul_left, inner_smul_right, inner_actionLp,
      Complex.conj_ofReal]
    push_cast
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i hi
    apply Finset.sum_congr rfl
    intro j hj
    rw [K2PP_comm a j i]
    ring
  have h2 : ((‖testLp ha y‖ ^ 2 : ℝ) : ℂ) = inner ℂ (testLp ha y) (testLp ha y) := by
    rw [inner_self_eq_norm_sq_to_K]
    push_cast
    rfl
  rw [h] at h2
  exact Complex.ofReal_inj.mp h2
lemma bessel_quadratic {a : ℝ} (ha : 0 < a) (y : Fin 100 → ℝ) :
    (∑ i : Fin 100, (∑ j : Fin 100, y j * Y7KPP.KPP a i j) ^ 2)
      + (∑ m : Fin 50, (∑ j : Fin 100, y j * Bcrit a m j) ^ 2)
      ≤ ∑ i : Fin 100, ∑ j : Fin 100, y i * y j * Y7K2.K2PP a i j := by
  have hb := Y7Bessel.bessel
    (s := Finset.univ.image (fun i : Fin 150 => 2 * (i : ℕ) + 1)) (testLp ha y)
  rw [Finset.sum_image] at hb
  · rw [norm_sq_testLp] at hb
    have hsummand : ∀ i : Fin 150,
        ‖inner ℂ (Y7Bessel.phiLp (2 * (i : ℕ) + 1)) (testLp ha y)‖ ^ 2
          = (∑ j : Fin 100, y j * coeff a (2 * (i : ℕ) + 1) (2 * (j : ℕ) + 1)) ^ 2 := by
      intro i
      rw [inner_phiLp_testLp]
      simp only [Complex.norm_real, Real.norm_eq_abs, sq_abs]
    simp_rw [hsummand] at hb
    rw [Fin.sum_univ_add (a := 100) (b := 50)] at hb
    have h1 : (∑ i : Fin 100,
          (∑ j : Fin 100,
            y j * coeff a (2 * ((Fin.castAdd 50 i : Fin 150) : ℕ) + 1) (2 * (j : ℕ) + 1)) ^ 2)
        = ∑ i : Fin 100, (∑ j : Fin 100, y j * Y7KPP.KPP a i j) ^ 2 := by
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      apply Finset.sum_congr rfl
      intro j hj
      rw [show (2 * ((Fin.castAdd 50 i : Fin 150) : ℕ) + 1) = 2 * (i : ℕ) + 1 from rfl]
      rw [coeff_KPP]
    have h2 : (∑ i : Fin 50,
          (∑ j : Fin 100,
            y j * coeff a (2 * ((Fin.natAdd 100 i : Fin 150) : ℕ) + 1) (2 * (j : ℕ) + 1)) ^ 2)
        = ∑ i : Fin 50, (∑ j : Fin 100, y j * Bcrit a i j) ^ 2 := by
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      apply Finset.sum_congr rfl
      intro j hj
      rw [show (2 * ((Fin.natAdd 100 i : Fin 150) : ℕ) + 1) = 2 * (100 + (i : ℕ)) + 1 from rfl]
      rw [coeff_Bcrit]
    rw [h1, h2] at hb
    exact hb
  · intro x _ y _ hxy
    simp only at hxy
    exact Fin.ext (by omega)
lemma K2PP_isSymm (a : ℝ) : (Y7K2.K2PP a).IsSymm := by
  ext i j
  exact (K2PP_comm a i j).symm
lemma K2PP_quadform (a : ℝ) (y : Fin 100 → ℝ) :
    y ⬝ᵥ (Y7K2.K2PP a *ᵥ y)
      = ∑ i : Fin 100, ∑ j : Fin 100, y i * y j * Y7K2.K2PP a i j := by
  rw [show y ⬝ᵥ (Y7K2.K2PP a *ᵥ y)
      = ∑ i : Fin 100, y i * (∑ j : Fin 100, Y7K2.K2PP a i j * y j) from rfl]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  ring
lemma KPPtKPP_quadform (a : ℝ) (y : Fin 100 → ℝ) :
    y ⬝ᵥ (((Y7KPP.KPP a)ᵀ * Y7KPP.KPP a) *ᵥ y)
      = ∑ k : Fin 100, (∑ i : Fin 100, y i * Y7KPP.KPP a k i) ^ 2 := by
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_transpose_mulVec]
  rw [show (Y7KPP.KPP a *ᵥ y) ⬝ᵥ (Y7KPP.KPP a *ᵥ y)
      = ∑ k : Fin 100, (Y7KPP.KPP a *ᵥ y) k * (Y7KPP.KPP a *ᵥ y) k from rfl]
  apply Finset.sum_congr rfl
  intro k hk
  rw [show (Y7KPP.KPP a *ᵥ y) k = ∑ i : Fin 100, Y7KPP.KPP a k i * y i from rfl]
  rw [sq]
  have h : (∑ i : Fin 100, Y7KPP.KPP a k i * y i)
      = ∑ i : Fin 100, y i * Y7KPP.KPP a k i := by
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [h]
lemma BcrittBcrit_quadform (a : ℝ) (y : Fin 100 → ℝ) :
    y ⬝ᵥ (((Bcrit a)ᵀ * Bcrit a) *ᵥ y)
      = ∑ m : Fin 50, (∑ j : Fin 100, y j * Bcrit a m j) ^ 2 := by
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_transpose_mulVec]
  rw [show (Bcrit a *ᵥ y) ⬝ᵥ (Bcrit a *ᵥ y)
      = ∑ m : Fin 50, (Bcrit a *ᵥ y) m * (Bcrit a *ᵥ y) m from rfl]
  apply Finset.sum_congr rfl
  intro m hm
  rw [show (Bcrit a *ᵥ y) m = ∑ j : Fin 100, Bcrit a m j * y j from rfl]
  rw [sq]
  have h : (∑ j : Fin 100, Bcrit a m j * y j)
      = ∑ j : Fin 100, y j * Bcrit a m j := by
    apply Finset.sum_congr rfl
    intro j hj
    ring
  rw [h]
lemma BcrittBcrit_symm (a : ℝ) : ((Bcrit a)ᵀ * Bcrit a).IsSymm := by
  ext i j
  simp only [Matrix.transpose_apply, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro k hk
  ring
theorem GRes_posSemidef {a : ℝ} (ha : 0 < a) :
    (Y7K2.K2PP a - (Y7KPP.KPP a)ᵀ * Y7KPP.KPP a - (Bcrit a)ᵀ * Bcrit a).PosSemidef := by
  have hsym : (Y7K2.K2PP a - (Y7KPP.KPP a)ᵀ * Y7KPP.KPP a
      - (Bcrit a)ᵀ * Bcrit a).IsSymm :=
    ((K2PP_isSymm a).sub (Matrix.isSymm_transpose_mul_self (Y7KPP.KPP a))).sub
      (BcrittBcrit_symm a)
  rw [Matrix.posSemidef_iff_dotProduct_mulVec]
  refine ⟨Matrix.isHermitian_iff_isSymm.mpr hsym, ?_⟩
  intro y
  rw [star_trivial]
  rw [Matrix.sub_mulVec, Matrix.sub_mulVec]
  rw [dotProduct_sub, dotProduct_sub]
  rw [K2PP_quadform, KPPtKPP_quadform, BcrittBcrit_quadform]
  linarith [bessel_quadratic ha y]
