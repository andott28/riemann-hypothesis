    · refine Integrable.of_bound ?_ (Bn * Bj) ?_
      · apply Measurable.aestronglyMeasurable
        exact (Polynomial.continuous (Y7Legendre.phi n)).measurable.mul
          (Measurable.ite (measurableSet_lt measurable_const measurable_id)
            ((Polynomial.continuous (Y7Legendre.phi j)).comp
              (continuous_id.sub continuous_const)).measurable measurable_const)
