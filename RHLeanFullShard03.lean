      have h1 : ‖(Y7Legendre.phi n).eval x‖ ≤ Bn := hBn x ⟨hx'.1, le_trans hx'.2 (by norm_num)⟩
      have hA : ‖(if x < 1 - RHLean.shiftLengthRescaled a k then
            (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)‖ ≤ Bj := by
        split_ifs with h
        · exact hBj _ ⟨by linarith [hx'.1, hr0], by linarith [hx'.2, hr2]⟩
        · simpa using hBjn
      have hB : ‖(if -1 + RHLean.shiftLengthRescaled a k < x then
            (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)‖ ≤ Bj := by
        split_ifs with h
