section Inline_Y7ParsevalB
noncomputable section
open MeasureTheory
open scoped BigOperators ENNReal
namespace Y7ParsevalB
abbrev mu : Measure ℝ := volume.restrict (Set.Ioo (-1 : ℝ) 1)
lemma exists_bound_poly (p : Polynomial ℝ) :
    ∃ C : ℝ, ∀ x ∈ Set.Icc (-1 : ℝ) 1, ‖p.eval x‖ ≤ C := by
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    p.continuous.continuousOn
  exact ⟨C, hC⟩
lemma integrable_V_piece (n j : ℕ) :
    Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)) mu := by
  obtain ⟨C, hC⟩ := Y7Parseval.exists_bound_phi n
  have hVj : MemLp (fun x : ℝ => RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)
      2 mu := Y7Parseval.memLp_V_phi j
  have hint : Integrable (fun x : ℝ => RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x) mu :=
    hVj.integrable (by norm_num)
  have hdom : Integrable (fun x : ℝ => C *
      ‖RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x‖) mu :=
    hint.norm.const_mul C
  refine Integrable.mono' hdom ?_ ?_
  · apply Measurable.aestronglyMeasurable
    exact Measurable.mul (Polynomial.continuous (Y7Legendre.phi n)).measurable
      (Measurable.mul Y7Parseval.measurable_rescaledPotential
        (Polynomial.continuous (Y7Legendre.phi j)).measurable)
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := Set.Ioo_subset_Icc_self hx
    have h1 : ‖(Y7Legendre.phi n).eval x‖ ≤ C := hC x hx'
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
lemma integrable_phi_mul_poly (n : ℕ) (p : Polynomial ℝ) :
    Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x * p.eval x) mu := by
  obtain ⟨C1, hC1⟩ := Y7Parseval.exists_bound_phi n
  obtain ⟨C2, hC2⟩ := exists_bound_poly p
  refine Integrable.of_bound ?_ (C1 * C2) ?_
  · apply Measurable.aestronglyMeasurable
    exact Measurable.mul (Polynomial.continuous (Y7Legendre.phi n)).measurable
      (Polynomial.continuous p).measurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := Set.Ioo_subset_Icc_self hx
    rw [norm_mul]
    exact mul_le_mul (hC1 x hx') (hC2 x hx') (norm_nonneg _) (le_trans (norm_nonneg _) (hC1 x hx'))
lemma integrable_gamma_piece (a : ℝ) (n j : ℕ) :
    Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x * (Y7K2.gammaActionPhi a j).eval x) mu :=
  integrable_phi_mul_poly n _
noncomputable def sPoly (a : ℝ) : Polynomial ℝ :=
  ∑ d ∈ Finset.range 100,
    Polynomial.C ((a / 2) ^ (2 * d + 1) / (((2 * d + 1).factorial : ℕ) : ℝ)) *
      Polynomial.X ^ (2 * d + 1)
lemma sPoly_eval (a : ℝ) (x : ℝ) :
    (sPoly a).eval x = Y7Chain.sinhTaylorFun a x 100 := by
  unfold sPoly Y7Chain.sinhTaylorFun
  rw [Polynomial.eval_finsetSum]
  apply Finset.sum_congr rfl
  intro d hd
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  rw [show (a * x / 2) ^ (2 * d + 1) = (a / 2) ^ (2 * d + 1) * x ^ (2 * d + 1) from by
    rw [show a * x / 2 = (a / 2) * x from by ring, mul_pow]]
  rw [div_mul_eq_mul_div]
lemma integrable_polar_piece (a : ℝ) (n j : ℕ) :
    Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100)) mu := by
  rw [show (fun x : ℝ => (Y7Legendre.phi n).eval x *
        (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100))
      = fun x : ℝ => (Y7Legendre.phi n).eval x *
          ((Polynomial.C (2 * a * Y7ModelOne.polarMomentModel a j) * sPoly a).eval x) from by
    funext x
    simp only [Polynomial.eval_mul, Polynomial.eval_C]
    rw [sPoly_eval a x]]
  exact integrable_phi_mul_poly n _
lemma integrable_shift_piece {a : ℝ} (ha : 0 < a) (n j : ℕ) :
    Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x * Y7K2.shiftAction a j x) mu := by
  obtain ⟨C1, hC1⟩ := Y7Parseval.exists_bound_phi n
  obtain ⟨C2, hC2⟩ := Y7Parseval.exists_bound_shiftAction ha j
  refine Integrable.of_bound ?_ (C1 * C2) ?_
  · apply Measurable.aestronglyMeasurable
    exact Measurable.mul (Polynomial.continuous (Y7Legendre.phi n)).measurable
      (Y7Parseval.measurable_shiftAction a j)
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
    rw [norm_mul]
    exact mul_le_mul (hC1 x (Set.Ioo_subset_Icc_self hx)) (hC2 x hx) (norm_nonneg _)
      (le_trans (norm_nonneg _) (hC1 x (Set.Ioo_subset_Icc_self hx)))
lemma integral_K0Action {a : ℝ} (ha : 0 < a) (n j : ℕ) :
    (∫ x in Set.Ioo (-1 : ℝ) 1, (Y7Legendre.phi n).eval x * Y7K2.K0Action a j x)
      = Y7KPP.modelM a n j
        - ((if n = j then Y7Matrix.harmonicR n else 0)
            + RHLean.c0 a * (if n = j then 1 else 0)) := by
  have hA : Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)) mu := integrable_V_piece n j
  have hB : Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      (Y7K2.gammaActionPhi a j).eval x) mu := integrable_gamma_piece a n j
  have hC : Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100)) mu :=
    integrable_polar_piece a n j
  have hD : Integrable (fun x : ℝ => (Y7Legendre.phi n).eval x *
      Y7K2.shiftAction a j x) mu := integrable_shift_piece ha n j
  have hAB : Integrable (fun x : ℝ =>
      (Y7Legendre.phi n).eval x * (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)
        - (Y7Legendre.phi n).eval x * (Y7K2.gammaActionPhi a j).eval x) mu := hA.sub hB
  have hABC : Integrable (fun x : ℝ =>
      (Y7Legendre.phi n).eval x * (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)
        - (Y7Legendre.phi n).eval x * (Y7K2.gammaActionPhi a j).eval x
        - (Y7Legendre.phi n).eval x *
            (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100)) mu :=
    hAB.sub hC
  have hpt : ∀ x : ℝ, (Y7Legendre.phi n).eval x * Y7K2.K0Action a j x
      = (Y7Legendre.phi n).eval x * (RHLean.rescaledPotential x * (Y7Legendre.phi j).eval x)
        - (Y7Legendre.phi n).eval x * (Y7K2.gammaActionPhi a j).eval x
        - (Y7Legendre.phi n).eval x *
            (2 * a * Y7ModelOne.polarMomentModel a j * Y7Chain.sinhTaylorFun a x 100)
        - (Y7Legendre.phi n).eval x * Y7K2.shiftAction a j x := by
    intro x
    unfold Y7K2.K0Action
    ring
  simp_rw [hpt]
  rw [integral_sub hABC hD, integral_sub hAB hC, integral_sub hA hB]
  rw [Y7MatElem.integral_V_part, Y7MatElem.integral_gamma_part,
    Y7MatElem.integral_polar_part, Y7MatElem.integral_shift_part ha]
  unfold Y7KPP.modelM
  ring
