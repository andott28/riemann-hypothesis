            ((if x < 1 - RHLean.shiftLengthRescaled a k then
                (Y7Legendre.phi j).eval (x + RHLean.shiftLengthRescaled a k) else 0)
              + (if -1 + RHLean.shiftLengthRescaled a k < x then
                (Y7Legendre.phi j).eval (x - RHLean.shiftLengthRescaled a k) else 0)))‖
