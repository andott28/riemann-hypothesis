        have hx' : x ∈ Set.Icc (-1 : ℝ) 1 := Set.Ioo_subset_Icc_self hx
        have h1 : ‖(Y7Legendre.phi n).eval x‖ ≤ Bn := hBn x ⟨hx'.1, le_trans hx'.2 (by norm_num)⟩
